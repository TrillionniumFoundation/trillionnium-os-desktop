// AF_UNIX persistent-owner cycles return ELOOP; graph exhaustion returns ENOBUFS.
// A rejected datagram reconnection preserves the old peer.
struct sockaddr = {
    sa_family = AF_INET | AF_UNIX | AF_NETLINK | AF_VSOCK,
    ..
};

// Connect to a peer socket
connect(
    sockfd, addr = <sockaddr>, addrlen
);
