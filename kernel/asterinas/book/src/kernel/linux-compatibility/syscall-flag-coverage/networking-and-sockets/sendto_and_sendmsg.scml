struct sockaddr = {
    sa_family = AF_INET | AF_UNIX | AF_NETLINK | AF_VSOCK,
    ..
};

struct msg_hdr = {
    msg_name = <sockaddr>,
    msg_control = NULL,
    ..
};

// AF_UNIX SCM_RIGHTS accepts acyclic ownership only (ELOOP on a cycle).
// At most 253 descriptors; graph exhaustion returns ENOBUFS.
struct unix_rights_cmsg = {
    cmsg_level = SOL_SOCKET,
    cmsg_type = SCM_RIGHTS,
    ..
};

// A connected UNIX socket may have no destination address.
struct msg_hdr = {
    msg_control = [ <unix_rights_cmsg> ],
    ..
};

// UNIX datagram/seqpacket queues also have a 128-message limit, including
// empty messages; a nonblocking full queue returns EAGAIN.
struct mmsg_hdr = {
    hdr = <msg_hdr>,
    msg_len
};

// Send message on a socket
sendto(
    sockfd, buf, len,
    flags = 0,
    dest_addr = <sockaddr>,
    addrlen
);

// Ancillary input vector allocation failure returns ENOMEM before publication.
// Send message using scatter-gather buffers and ancillary data
sendmsg(
    sockfd,
    msg = <msg_hdr>,
    flags = 0
);


// Send multiple messages on a socket
sendmmsg(
    sockfd,
    mmsgs = [ <mmsg_hdr> ],
    mmsg_count,
    flags = 0
);
