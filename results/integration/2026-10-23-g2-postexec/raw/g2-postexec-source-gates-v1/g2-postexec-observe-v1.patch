+    assert_error(admit(&binding, &expected, &sibling_fd), Errno::EPERM);
+    assert_error(binding.with_recipient(&expected, ObserveLaunchNonce(0), &recipient, |_, _, _| Ok(())), Errno::EPERM);
+}
