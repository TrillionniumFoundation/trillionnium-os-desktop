+#[test]
+fn query_loss_or_deadline_never_reconnects_or_submits() {
+    for reply in [Reply::Lost, Reply::Stall] {
+        let (attempt, _) = perform(reply, None);
+        assert!(matches!(
+            attempt.status(),
