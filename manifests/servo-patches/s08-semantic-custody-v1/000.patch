+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/. */
+
+//! Versioned, bounded semantic expectations for retained accessibility actions.
+//! A digest compares metadata; it grants no node, document, or action authority.
+
+use accesskit::{Action, Node, NodeId, Role, TreeId};
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+pub const ACCESSIBILITY_SEMANTIC_VERSION: u16 = 1;
+pub const MAX_ACCESSIBILITY_NAME_BYTES: usize = 1024;
+/// Includes the retained target itself; ancestry is leaf-to-root without graft nodes.
+pub const MAX_ACCESSIBILITY_ANCESTRY: usize = 16;
+const STATE_MASK: u8 = 0x3f;
+
+/// Fixed-size IPC expectation, made from one actual retained tree observation.
+/// Raw names and variable-size ancestry never enter this IPC payload.
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+#[serde(deny_unknown_fields)]
+pub struct AccessibilitySemanticExpectation {
+    version: u16,
+    tree_id: TreeId,
+    node_id: NodeId,
+    epoch: u32,
+    role: Role,
+    name_present: bool,
+    name_bytes: u16,
+    ancestry_depth: u8,
+    state: u8,
+    accessible_name_sha256: [u8; 32],
+    structural_fingerprint: [u8; 32],
+}
+
+impl AccessibilitySemanticExpectation {
+    pub fn tree_id(&self) -> TreeId {
+        self.tree_id
+    }
+    pub fn node_id(&self) -> NodeId {
+        self.node_id
+    }
+    pub fn epoch(&self) -> u32 {
+        self.epoch
+    }
+    pub fn role(&self) -> Role {
+        self.role
+    }
+    pub fn accessible_name_sha256(&self) -> [u8; 32] {
+        self.accessible_name_sha256
+    }
+    pub fn structural_fingerprint(&self) -> [u8; 32] {
+        self.structural_fingerprint
+    }
+
+    pub fn is_well_formed(&self) -> bool {
+        self.version == ACCESSIBILITY_SEMANTIC_VERSION
+            && self.tree_id != TreeId::ROOT
+            && usize::from(self.name_bytes) <= MAX_ACCESSIBILITY_NAME_BYTES
+            && (self.name_present || self.name_bytes == 0)
+            && (1..=MAX_ACCESSIBILITY_ANCESTRY).contains(&usize::from(self.ancestry_depth))
+            && self.state & !STATE_MASK == 0
+    }
+}
+
+/// Incrementally hashes a bounded retained leaf-to-root chain without cloning DOM strings
+/// or AccessKit child lists. Both the consumer observation and layout use this encoder.
+pub struct AccessibilitySemanticBuilder {
+    digest: Sha256,
+    expectation: AccessibilitySemanticExpectation,
+    ids: [NodeId; MAX_ACCESSIBILITY_ANCESTRY],
+    refused: bool,
+}
+
+impl AccessibilitySemanticBuilder {
+    pub fn new(tree_id: TreeId, epoch: u32) -> Self {
+        let mut digest = Sha256::new();
+        digest.update(b"trillionnium.accesskit.semantic\0");
+        digest.update(ACCESSIBILITY_SEMANTIC_VERSION.to_be_bytes());
+        digest.update(tree_id.0.as_bytes());
+        digest.update(epoch.to_be_bytes());
+        Self {
+            digest,
+            expectation: AccessibilitySemanticExpectation {
+                version: ACCESSIBILITY_SEMANTIC_VERSION,
+                tree_id,
+                node_id: NodeId(0),
+                epoch,
+                role: Role::Unknown,
+                name_present: false,
+                name_bytes: 0,
+                ancestry_depth: 0,
+                state: 0,
+                accessible_name_sha256: [0; 32],
+                structural_fingerprint: [0; 32],
+            },
+            ids: [NodeId(0); MAX_ACCESSIBILITY_ANCESTRY],
+            refused: tree_id == TreeId::ROOT,
+        }
+    }
+
+    /// Refuses before hashing a too-large name, repeated node, or excessive depth.
+    /// UTF-8 is hashed exactly as AccessKit stores it, without normalization or truncation.
+    pub fn push(&mut self, id: NodeId, node: &Node) -> bool {
+        let depth = usize::from(self.expectation.ancestry_depth);
+        let label = node.label();
+        let name = label.unwrap_or("").as_bytes();
+        if self.refused
+            || depth == MAX_ACCESSIBILITY_ANCESTRY
+            || name.len() > MAX_ACCESSIBILITY_NAME_BYTES
+            || self.ids[..depth].contains(&id)
+        {
+            self.refused = true;
+            return false;
+        }
+        let state = u8::from(node.is_hidden())
+            | (u8::from(node.is_disabled()) << 1)
+            | (u8::from(node.is_read_only()) << 2)
+            | (u8::from(node.is_busy()) << 3)
+            | (u8::from(node.supports_action(Action::Click)) << 4)
+            | (u8::from(node.bounds().is_some()) << 5);
+        self.digest.update(id.0.to_be_bytes());
+        self.digest
+            .update([node.role() as u8, state, u8::from(label.is_some())]);
+        self.digest.update((name.len() as u16).to_be_bytes());
+        self.digest.update(name);
+        self.ids[depth] = id;
+        self.expectation.ancestry_depth += 1;
+        if depth == 0 {
+            self.expectation.node_id = id;
+            self.expectation.role = node.role();
+            self.expectation.name_present = label.is_some();
+            self.expectation.name_bytes = name.len() as u16;
+            self.expectation.state = state;
+            let mut name_digest = Sha256::new();
+            name_digest.update(b"trillionnium.accesskit.name\0");
+            name_digest.update(ACCESSIBILITY_SEMANTIC_VERSION.to_be_bytes());
+            name_digest.update([u8::from(label.is_some())]);
+            name_digest.update((name.len() as u16).to_be_bytes());
+            name_digest.update(name);
+            self.expectation.accessible_name_sha256 = name_digest.finalize().into();
+        }
+        true
+    }
+
+    pub fn finish(mut self) -> Option<AccessibilitySemanticExpectation> {
+        if self.refused || !self.expectation.is_well_formed() {
+            return None;
+        }
+        self.digest.update([self.expectation.ancestry_depth]);
+        self.expectation.structural_fingerprint = self.digest.finalize().into();
+        Some(self.expectation)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tree() -> TreeId {
+        TreeId(accesskit::Uuid::from_u128(1))
+    }
+    fn button(name: &str) -> Node {
+        let mut node = Node::new(Role::Button);
+        node.set_label(name);
+        node.add_action(Action::Click);
+        node.set_bounds(accesskit::Rect::new(1., 2., 3., 4.));
+        node
+    }
+    fn observe(node: &Node) -> AccessibilitySemanticExpectation {
+        let mut builder = AccessibilitySemanticBuilder::new(tree(), 7);
+        assert!(builder.push(NodeId(17), node));
+        assert!(builder.push(NodeId(19), &Node::new(Role::RootWebArea)));
+        builder.finish().unwrap()
+    }
+
+    #[test]
+    fn metadata_changes_same_node_are_detected() {
+        let original = observe(&button("Action target"));
+        for changed in [
+            {
+                let mut n = button("Action target");
+                n.set_role(Role::Heading);
+                n
+            },
+            button("Changed target"),
+            {
+                let mut n = button("Action target");
+                n.set_disabled();
+                n
+            },
+            {
+                let mut n = button("Action target");
+                n.set_hidden();
+                n
+            },
+            {
+                let mut n = button("Action target");
+                n.remove_action(Action::Click);
+                n
+            },
+            {
+                let mut n = button("Action target");
+                n.clear_bounds();
+                n
+            },
+        ] {
+            assert_ne!(original, observe(&changed));
+            assert_eq!(original.node_id(), observe(&changed).node_id());
+        }
+        assert_eq!(original, observe(&button("Action target")));
+    }
+
+    #[test]
+    fn raw_utf8_presence_and_length_are_unambiguous() {
+        assert_ne!(observe(&button("é")), observe(&button("e\u{301}")));
+        assert_ne!(observe(&button("a\0b")), observe(&button("a")));
+        let mut absent = button("");
+        absent.clear_label();
+        assert_ne!(
+            observe(&absent).accessible_name_sha256(),
+            observe(&button("")).accessible_name_sha256()
+        );
+        let digest = observe(&button("Action target")).accessible_name_sha256();
+        assert_eq!(
+            digest,
+            [
+                0xa4, 0x0b, 0x12, 0x7b, 0xee, 0x12, 0x72, 0xbe, 0x9c, 0x97, 0xee, 0xb1, 0x2d, 0xe9,
+                0x69, 0x7b, 0x59, 0x7d, 0x73, 0x6d, 0x86, 0x03, 0x74, 0x3f, 0x63, 0x05, 0x14, 0x11,
+                0x6b, 0x0d, 0x12, 0x27
+            ]
+        );
+    }
+
+    #[test]
+    fn tree_epoch_identity_and_complete_ancestry_are_bound() {
+        let node = button("Action target");
+        let original = observe(&node);
+        for (tree_id, epoch, target, parent) in [
+            (
+                TreeId(accesskit::Uuid::from_u128(2)),
+                7,
+                NodeId(17),
+                NodeId(19),
+            ),
+            (tree(), 8, NodeId(17), NodeId(19)),
+            (tree(), 7, NodeId(18), NodeId(19)),
+            (tree(), 7, NodeId(17), NodeId(20)),
+        ] {
+            let mut b = AccessibilitySemanticBuilder::new(tree_id, epoch);
+            assert!(b.push(target, &node));
+            assert!(b.push(parent, &Node::new(Role::RootWebArea)));
+            assert_ne!(original, b.finish().unwrap());
+        }
+        let mut b = AccessibilitySemanticBuilder::new(tree(), 7);
+        assert!(b.push(NodeId(17), &node));
+        assert!(b.push(NodeId(18), &Node::new(Role::GenericContainer)));
+        assert!(b.push(NodeId(19), &Node::new(Role::RootWebArea)));
+        assert_ne!(original, b.finish().unwrap());
+    }
+
+    #[test]
+    fn exact_name_byte_bound_is_fail_closed_and_sticky() {
+        assert!(observe(&button(&"é".repeat(MAX_ACCESSIBILITY_NAME_BYTES / 2))).is_well_formed());
+        let mut b = AccessibilitySemanticBuilder::new(tree(), 7);
+        assert!(!b.push(
+            NodeId(17),
+            &button(&"é".repeat(MAX_ACCESSIBILITY_NAME_BYTES / 2 + 1))
+        ));
+        assert!(!b.push(NodeId(18), &button("small")));
+        assert!(b.finish().is_none());
+    }
+
+    #[test]
+    fn depth_cycle_empty_and_graft_root_refuse() {
+        let mut bounded = AccessibilitySemanticBuilder::new(tree(), 7);
+        for i in 0..MAX_ACCESSIBILITY_ANCESTRY {
+            assert!(bounded.push(NodeId(i as u64), &button("x")));
+        }
+        assert!(bounded.finish().is_some());
+        let mut overflow = AccessibilitySemanticBuilder::new(tree(), 7);
+        for i in 0..MAX_ACCESSIBILITY_ANCESTRY {
+            assert!(overflow.push(NodeId(i as u64), &button("x")));
+        }
+        assert!(!overflow.push(NodeId(99), &button("x")));
+        assert!(overflow.finish().is_none());
+        let mut cycle = AccessibilitySemanticBuilder::new(tree(), 7);
+        assert!(cycle.push(NodeId(17), &button("x")));
+        assert!(!cycle.push(NodeId(17), &button("x")));
+        assert!(cycle.finish().is_none());
+        assert!(
+            AccessibilitySemanticBuilder::new(tree(), 7)
+                .finish()
+                .is_none()
+        );
+        assert!(
+            AccessibilitySemanticBuilder::new(TreeId::ROOT, 7)
+                .finish()
+                .is_none()
+        );
+    }
+
+    #[test]
+    fn wire_shape_types_arrays_and_versions_are_closed() {
+        let original = observe(&button("Action target"));
+        let encoded = serde_json::to_value(original).unwrap();
+        assert_eq!(
+            serde_json::from_value::<AccessibilitySemanticExpectation>(encoded.clone()).unwrap(),
+            original
+        );
+        for (key, value) in [
+            ("version", serde_json::json!(true)),
+            ("epoch", serde_json::json!(7.0)),
+            ("state", serde_json::json!(-1)),
+            ("ancestry_depth", serde_json::json!(true)),
+            ("name_present", serde_json::json!(1)),
+            ("accessible_name_sha256", serde_json::json!(vec![0; 31])),
+        ] {
+            let mut altered = encoded.clone();
+            altered[key] = value;
+            assert!(serde_json::from_value::<AccessibilitySemanticExpectation>(altered).is_err());
+        }
+        let mut extra = encoded.clone();
+        extra["caller_verified"] = serde_json::json!(true);
+        assert!(serde_json::from_value::<AccessibilitySemanticExpectation>(extra).is_err());
+        for (key, value) in [
+            ("version", 2),
+            ("ancestry_depth", 0),
+            ("ancestry_depth", 17),
+            ("name_bytes", 1025),
+            ("state", 64),
+        ] {
+            let mut altered = encoded.clone();
+            altered[key] = serde_json::json!(value);
+            assert!(
+                !serde_json::from_value::<AccessibilitySemanticExpectation>(altered)
+                    .unwrap()
+                    .is_well_formed()
+            );
+        }
+    }
+}
