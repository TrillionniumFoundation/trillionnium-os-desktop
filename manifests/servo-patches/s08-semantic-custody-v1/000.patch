+    /// Hash actual retained AccessKit data and complete leaf-to-root ancestry.
+    /// Refuse over-budget or damaged chains; never search another node by label or coordinates.
+    pub(crate) fn semantic_expectation_for_id(
+        &self,
+        node_id: NodeId,
+    ) -> Option<servo_base::accessibility_semantics::AccessibilitySemanticExpectation> {
+        use servo_base::accessibility_semantics::{AccessibilitySemanticBuilder, MAX_ACCESSIBILITY_ANCESTRY};
+        let mut builder = AccessibilitySemanticBuilder::new(self.tree_id, self.embedder_epoch.0);
+        let mut current = self.nodes.get(&node_id)?.clone();
+        for _ in 0..MAX_ACCESSIBILITY_ANCESTRY {
+            let node = current.borrow();
+            if !builder.push(node.id, &node.accesskit_node) { return None; }
+            let parent = node.parent();
+            if parent.is_none() {
+                if self.root_node.as_ref()?.borrow().id != node.id { return None; }
+                return builder.finish();
+            }
+            drop(node);
+            current = parent?;
+            if !self.nodes.contains_key(&current.borrow().id) { return None; }
+        }
+        None
     }
 
