+#[test]
+fn test_retained_accessibility_dropped_callback_does_not_duplicate_dispatch() {
+    let url = r#"data:text/html,<!DOCTYPE html>
+        <button onclick='let count=document.getElementById("count");
+                         count.textContent="Callback click count 1"'>
+          Callback target
+        </button>
+        <h1 id='count'>Callback click count 0</h1>"#;
+    let (servo_test, delegate, webview, mut tree) = build_webview_and_tree(url);
+    let button = find_labeled_node(&tree, Role::Button, "Callback target");
+    let (callback, receiver) =
+        GenericCallback::new_blocking().expect("blocking callback must be constructible");
+    drop(receiver);
+
+    webview.perform_accessibility_action(
+        action_request(button, Action::Click, None),
+        callback,
+    );
+
+    apply_updates(
+        &mut tree,
+        wait_for_min_updates(&servo_test, delegate.clone(), 1),
+    );
+    let count = find_labeled_node(&tree, Role::Heading, "Callback click count 1");
+    assert_eq!(count.label().as_deref(), Some("Callback click count 1"));
+}
+
+fn action_request(
+    node: accesskit_consumer::Node<'_>,
+    action: Action,
+    data: Option<ActionData>,
+) -> ActionRequest {
+    let (target_node, target_tree) = node.locate();
+    ActionRequest {
+        action,
+        target_tree,
+        target_node,
+        data,
+    }
+}
+
+fn perform_retained_action(
+    servo_test: &ServoTest,
+    webview: &servo::WebView,
+    request: ActionRequest,
+) -> AccessibilityActionResult {
+    let responses = Arc::new(Mutex::new(Vec::new()));
+    let callback_responses = responses.clone();
+    let callback = GenericCallback::new(move |result| {
+        callback_responses
+            .lock()
+            .expect("response mutex must not be poisoned")
+            .push(result.expect("retained action callback transport must succeed"));
+    })
+    .expect("retained action callback must be constructible");
+
+    webview.perform_accessibility_action(request, callback);
+    let pending_responses = responses.clone();
+    servo_test.spin(move || {
+        pending_responses
+            .lock()
+            .expect("response mutex must not be poisoned")
+            .is_empty()
+    });
+
+    for _ in 0..8 {
+        servo_test.servo.spin_event_loop();
+    }
+
+    let responses = responses
+        .lock()
+        .expect("response mutex must not be poisoned");
+    assert_eq!(
+        responses.len(),
+        1,
+        "one request must complete exactly one callback"
+    );
+    responses[0]
+}
+
+fn apply_updates(tree: &mut accesskit_consumer::Tree, updates: Vec<TreeUpdate>) {
+    for update in updates {
+        tree.update_and_process_changes(update, &mut NoOpChangeHandler);
+    }
+}
+
+fn find_labeled_node<'tree>(
+    tree: &'tree accesskit_consumer::Tree,
+    role: Role,
+    label: &str,
+) -> accesskit_consumer::Node<'tree> {
+    find_optional_labeled_node(tree, role, label)
+        .unwrap_or_else(|| panic!("tree should contain {role:?} with label {label:?}"))
+}
+
+fn find_optional_labeled_node<'tree>(
+    tree: &'tree accesskit_consumer::Tree,
+    role: Role,
+    label: &str,
+) -> Option<accesskit_consumer::Node<'tree>> {
+    let root = assert_tree_structure_and_get_root_web_area(tree);
+    find_first_matching_node(root, |node| {
+        node.role() == role && node.label().as_deref() == Some(label)
+    })
+}
