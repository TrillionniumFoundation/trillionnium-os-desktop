+#[test]
+fn test_retained_accessibility_rejects_replaced_node_identity() {
+    let url = r#"data:text/html,<!DOCTYPE html>
+        <button id='target'>Original target</button>
+        <button onclick='let target=document.getElementById("target");
+                         let replacement=document.createElement("button");
+                         replacement.id="target";
+                         replacement.textContent="Replacement target";
+                         target.replaceWith(replacement)'>
+          Replace target
+        </button>"#;
+    let (servo_test, delegate, webview, mut tree) = build_webview_and_tree(url);
+    let original = find_labeled_node(&tree, Role::Button, "Original target");
+    let original_location = original.locate();
+    let original_request = action_request(original, Action::Click, None);
+    let replacer = find_labeled_node(&tree, Role::Button, "Replace target");
+
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(replacer, Action::Click, None),
+        ),
+        AccessibilityActionResult::Dispatched
+    );
+    assert_eq!(
+        perform_retained_action(&servo_test, &webview, original_request),
+        AccessibilityActionResult::StaleNode
+    );
+
+    apply_updates(
+        &mut tree,
+        wait_for_min_updates(&servo_test, delegate.clone(), 1),
+    );
+    let replacement = find_labeled_node(&tree, Role::Button, "Replacement target");
+    assert_ne!(
+        replacement.locate(),
+        original_location,
+        "replacing a DOM element must not recycle its retained action identity"
+    );
+}
