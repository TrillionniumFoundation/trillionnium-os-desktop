+// The action path must not fall back to the legacy opaque_node_for_id lookup.
+#[test]
+fn test_retained_accessibility_click_dispatches_exactly_once() {
+    let url = r#"data:text/html,<!DOCTYPE html>
+        <button onclick='let count=document.getElementById("count");
+                         let next=Number(count.dataset.value||"0")+1;
+                         count.dataset.value=String(next);
+                         count.textContent="Click count "+next'>
+          Action target
+        </button>
+        <h1 id='count' data-value='0'>Click count 0</h1>"#;
+    let (servo_test, delegate, webview, mut tree) = build_webview_and_tree(url);
+    let button = find_labeled_node(&tree, Role::Button, "Action target");
+    assert!(button.data().supports_action(Action::Click));
+
+    let result = perform_retained_action(
+        &servo_test,
+        &webview,
+        action_request(button, Action::Click, None),
+    );
+    assert_eq!(result, AccessibilityActionResult::Dispatched);
+
+    apply_updates(
+        &mut tree,
+        wait_for_min_updates(&servo_test, delegate.clone(), 1),
+    );
+    let count = find_labeled_node(&tree, Role::Heading, "Click count 1");
+    assert_eq!(count.label().as_deref(), Some("Click count 1"));
+    assert!(
+        find_optional_labeled_node(&tree, Role::Heading, "Click count 2").is_none(),
+        "one retained action must not dispatch twice"
+    );
+}
