+#[test]
+fn test_retained_accessibility_rejects_unadvertised_and_unsupported_requests() {
+    let url = r#"data:text/html,<!DOCTYPE html>
+        <h1>Not clickable</h1>
+        <button>Supported target</button>"#;
+    let (servo_test, _delegate, webview, tree) = build_webview_and_tree(url);
+    let plain = find_labeled_node(&tree, Role::Heading, "Not clickable");
+    let button = find_labeled_node(&tree, Role::Button, "Supported target");
+    assert!(!plain.data().supports_action(Action::Click));
+    assert!(button.data().supports_action(Action::Click));
+
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(plain, Action::Click, None),
+        ),
+        AccessibilityActionResult::ActionNotAdvertised
+    );
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(button, Action::Focus, None),
+        ),
+        AccessibilityActionResult::UnsupportedAction
+    );
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(
+                button,
+                Action::Click,
+                Some(ActionData::Value("unexpected".into())),
+            ),
+        ),
+        AccessibilityActionResult::UnsupportedAction
+    );
+}
