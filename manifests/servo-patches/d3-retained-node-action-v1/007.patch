+#[test]
+fn test_retained_accessibility_rejects_inactive_and_stale_tree() {
+    let url = "data:text/html,<!DOCTYPE html><button>Old target</button>";
+    let (servo_test, _delegate, webview, tree) = build_webview_and_tree(url);
+    let target = find_labeled_node(&tree, Role::Button, "Old target");
+    let request = action_request(target, Action::Click, None);
+
+    webview.set_accessibility_active(false);
+    assert_eq!(
+        perform_retained_action(&servo_test, &webview, request.clone()),
+        AccessibilityActionResult::AccessibilityInactive
+    );
+
+    webview.set_accessibility_active(true);
+    let new_url =
+        Url::parse("data:text/html,<!DOCTYPE html><button>New target</button>")
+            .expect("valid fixed data URL");
+    let load_webview = webview.clone();
+    webview.load(new_url.clone());
+    servo_test.spin(move || {
+        load_webview.url() != Some(new_url.clone()) ||
+            load_webview.load_status() != LoadStatus::Complete
+    });
+    assert_eq!(
+        perform_retained_action(&servo_test, &webview, request),
+        AccessibilityActionResult::StaleTree
+    );
+}
