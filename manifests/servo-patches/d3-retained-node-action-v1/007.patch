+#[test]
+fn test_retained_accessibility_rejects_disabled_hidden_and_non_element_targets() {
+    let url = r#"data:text/html,<!DOCTYPE html>
+        <button id='disabled-target' disabled>Disabled target</button>
+        <button id='hidden-target' style='display:contents'>Hidden target</button>
+        <p>Text child</p>"#;
+    let (servo_test, _delegate, webview, tree) = build_webview_and_tree(url);
+    let disabled_target = find_labeled_node(&tree, Role::Button, "Disabled target");
+    let hidden_target = find_labeled_node(&tree, Role::Button, "Hidden target");
+    let root = assert_tree_structure_and_get_root_web_area(&tree);
+    let text_node = find_first_matching_node(root, |node| {
+        node.role() == Role::TextRun && node.value().as_deref() == Some("Text child")
+    })
+    .expect("document should contain the paragraph text-run node");
+
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(disabled_target, Action::Click, None),
+        ),
+        AccessibilityActionResult::TargetDisabled
+    );
+
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(hidden_target, Action::Click, None),
+        ),
+        AccessibilityActionResult::TargetNotRendered
+    );
+
+    assert_eq!(
+        perform_retained_action(
+            &servo_test,
+            &webview,
+            action_request(text_node, Action::Click, None),
+        ),
+        AccessibilityActionResult::TargetNotElement
+    );
+}
