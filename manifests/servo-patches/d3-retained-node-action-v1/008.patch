+            request,
+            response,
+        );
+        if let Err(SendError(message)) = self.try_send(message) {
+            warn!("Sending accessibility action to constellation failed.");
+            let EmbedderToConstellationMessage::PerformAccessibilityAction(
+                _,
+                _,
+                response,
+            ) = message
+            else {
+                unreachable!("accessibility send path returned a different message");
+            };
+            let _ = response.send(AccessibilityActionResult::ConstellationDisconnected);
+        }
+    }
