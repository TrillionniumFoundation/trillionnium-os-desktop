+    /// Perform one retained-node accessibility action and return a typed terminal result.
+    ///
+    /// The initial supported scope is a click action with no action data. Servo rejects stale
+    /// trees, stale nodes, inactive documents, disabled targets, and all unsupported actions.
+    pub fn perform_accessibility_action(
