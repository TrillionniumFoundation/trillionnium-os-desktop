+
+/// Terminal result for one retained accessibility-node action request.
+///
+/// `Dispatched` means that script synchronously revalidated the current retained node and
+/// dispatched one click event. It does not claim that page script completed an external effect.
+#[derive(Clone, Copy, Debug, Deserialize, Eq, PartialEq, Serialize)]
+pub enum AccessibilityActionResult {
+    /// One supported action was dispatched to the retained DOM node.
+    Dispatched,
+    /// Accessibility is disabled or inactive for the selected webview/document.
+    AccessibilityInactive,
+    /// The webview no longer exists.
+    StaleWebView,
+    /// The selected document is missing, inactive, or no longer belongs to the webview.
+    StaleDocument,
+    /// The requested AccessKit tree is not the active top-level document tree.
+    StaleTree,
+    /// The requested AccessKit node is not retained in the current tree.
+    StaleNode,
+    /// The exact retained AccessKit node does not advertise the requested action.
+    ActionNotAdvertised,
+    /// The action type or its action data is outside the initial click-only scope.
+    UnsupportedAction,
+    /// The retained accessibility node does not resolve to a DOM element.
+    TargetNotElement,
+    /// The resolved element is disabled.
+    TargetDisabled,
+    /// The resolved element is not connected or has no current CSS layout box.
+    TargetNotRendered,
 }

