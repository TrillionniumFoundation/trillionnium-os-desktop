+/// Result of resolving an AccessKit action target against one retained document tree.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum AccessibilityNodeAddressResult {
+    /// The node exists in the current retained tree. `action_advertised` is copied from that
+    /// exact retained AccessKit node and must be checked again before dispatch.
+    Resolved {
+        /// DOM address retained for this exact accessibility node.
+        address: UntrustedNodeAddress,
+        /// Whether the exact retained node advertised the requested action.
+        action_advertised: bool,
+    },
+    /// The tree or embedder epoch is no longer current.
+    StaleTree,
+    /// The node is not present in the current retained tree or has no DOM identity.
+    StaleNode,
+}
+
 pub trait Layout {
     /// Get a reference to this Layout's Stylo `Device` used to handle media queries and
     /// resolve font metrics.
@@ -417,6 +434,16 @@ pub trait Layout {
     /// This should be called by the embedder when accessibility is requested by the user.
     fn set_accessibility_active(&self, enabled: bool, epoch: Epoch);
 
+    /// Resolve a retained accessibility node to its DOM address only when the tree identity and
+    /// embedder epoch still match the caller's active-document snapshot.
+    fn accessibility_node_address(
+        &self,
+        tree_id: accesskit::TreeId,
+        node_id: accesskit::NodeId,
+        action: accesskit::Action,
+        epoch: Epoch,
+    ) -> AccessibilityNodeAddressResult;
+
     /// Returns whether accessibility is active for this Layout.
     fn accessibility_active(&self) -> bool;
 
