+    #[expect(unsafe_code)]
+    fn perform_accessibility_action(
+        &self,
+        cx: &mut JSContext,
+        webview_id: WebViewId,
+        pipeline_id: PipelineId,
+        epoch: Epoch,
+        request: accesskit::ActionRequest,
+        response: generic_channel::GenericCallback<AccessibilityActionResult>,
+    ) {
+        let respond = |result| {
+            if let Err(error) = response.send(result) {
+                warn!("Could not return accessibility action result: {error:?}");
+            }
+        };
+
+        if !pref!(accessibility_enabled) {
+            respond(AcessibilityActionResult::AccessibilityInactive);
+            return;
+        }
+        if request.target_tree == accesskit::TreeId::ROOT ||
+            request.target_tree != accesskit::TreeId::from(pipeline_id)
+        {
+            respond(AccessibilityActionResult::StaleTree);
+            return;
+        }
+        if request.action != accesskit::Action::Click || request.data.is_some() {
+            respond(AccessibilityActionResult::UnsupportedAction);
+            return;
+        }
+        let Some(document) = self.documents.borrow().find_document(pipeline_id) else {
+            respond(AccessibilityActionResult::StaleDocument);
+            return;
+        };
+        if document.webview_id() != webview_id || !document.is_fully_active() {
+            respond(AccessibilityActionResult::StaleDocument);
+            return;
+        }
+        let window = document.window();
+        if !window.layout().accessibility_active() {
+            respond(AccessibilityActionResult::AccessibilityInactive);
+            return;
+        }
+
+        // Update and query the retained tree inside this script task. Page script cannot interleave
+        // between the node lookup and dispatch below.
+        window.reflow(cx, ReflowGoal::UpdateTheRendering);
+        let (address, action_advertised, has_accessible_bounds) =
+            match window.layout().accessibility_node_address(
+                request.target_tree,
+                request.target_node,
+                request.action,
+                epoch,
+             ) {
+                layout_api::AccessibilityNodeAddressResult::Resolved {
+                    address,
+                    action_advertised,
+                    has_accessible_bounds,
+                } => (address, action_advertised, has_accessible_bounds),
+                layout_api::AccessibilityNodeAddressResult::StaleTree => {
+                    respond(AccessibilityActionResult::StaleTree);
+                    return;
+                },
+                layout_api::AccessibilityNodeAddressResult::StaleNode => {
+                    respond(AccessibilityActionResult::StaleNode);
+                    return;
+                },
+            };
+        let node = unsafe { crate::dom::node::from_untrusted_node_address(address) };
+        if !node.is_connected() || node.owner_doc().webview_id() != webview_id {
+            respond(AccessibilityActionResult::TargetNotRendered);
+            return;
+        }
+        let Some(element) = node.downcast::<Element>() else {
+            respond(AccessibilityActionResult::TargetNotElement);
+            return;
+        };
+        if !has_accessible_bounds {
+            respond(AccessibilityActionResult::TargetNotRendered);
+            return;
+        }
+        if element.is_actually_disabled() {
+            respond(AccessibilityActionResult::TargetDisabled);
+            return;
+        }
+        if !element.has_css_layout_box() {
+            respond(AccessibilityActionResult::TargetNotRendered);
+            return;
+        }
+        if !action_advertised {
+            respond(AccessibilityActionResult::ActionNotAdvertised);
+            return;
+        }
+
+        node.fire_synthetic_pointer_event_not_trusted(cx, atom!("click"));
+        respond(AccessibilityActionResult::Dispatched);
+    }
