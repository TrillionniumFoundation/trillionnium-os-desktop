+    fn perform_accessibility_action(
+        &mut self,
+        webview_id: WebViewId,
+        request: accesskit::ActionRequest,
+        response: GenericCallback<AccessibilityActionResult>,
+    ) {
+        let reject = |result| {
+            if let Err(error) = response.send(result) {
+                warn!("Could not return accessibility action result: {error:?}");
+            }
+        };
+
+        if !pref!(accessibility_enabled) {
+            reject(AccessibilityActionResult::AccessibilityInactive);
+            return;
+        }
+        let Some(webview) = self.webviews.get(&webview_id) else {
+            reject(AccessibilityActionResult::StaleWebView);
+            return;
+        };
+        if !webview.accessibility_active {
+            reject(AccessibilityActionResult::AccessibilityInactive);
+            return;
+        }
+        let Some(pipeline_id) = webview.active_top_level_pipeline_id else {
+            reject(AccessibilityActionResult::StaleDocument);
+            return;
+        };
+        if request.target_tree == TreeId::ROOT || request.target_tree != TreeId::from(pipeline_id) {
+            reject(AccessibilityActionResult::StaleTree);
+            return;
+        }
+        if request.action != Action::Click || request.data.is_some() {
+            reject(AccessibilityActionResult::UnsupportedAction);
+            return;
+        }
+        let epoch = webview.active_top_level_pipeline_epoch;
+        let message = ScriptThreadMessage::PerformAccessibilityAction(
+            webview_id,
+            pipeline_id,
+            epoch,
+            request,
+            response.clone(),
+        );
+        let send_result = self
+            .pipelines
+            .get(&pipeline_id)
+            .ok_or(SendError::Disconnected)
+            .and_then(|pipeline| pipeline.event_loop.send(message));
+        if let Err(error) = send_result {
+            self.handle_send_error(pipeline_id, error);
+            reject(AccessibilityActionResult::StaleDocument);
+        }
+    }
+
     fn forward_input_event(
         &mut self,
         webview_id: WebViewId,
