diff --git a/components/layout/layout_impl.rs b/components/layout/layout_impl.rs
index fbca832253bc14a3f3f6d9328db0b04b556d7c76..3340f65a9aacc7e876f1c70f727f64a6eed27b8c 100644
--- a/components/layout/layout_impl.rs
+++ b/components/layout/layout_impl.rs
@@ -753,6 +753,35 @@ impl Layout for LayoutThread {
         *accessibility_tree = Some(AccessibilityTree::new(self.id.into(), epoch));
     }

+    fn accessibility_node_address(
+        &self,
+        tree_id: accesskit::TreeId,
+        node_id: accesskit::NodeId,
+        action: accesskit::Action,
+        epoch: Epoch,
+    ) -> layout_api::AccessibilityNodeAddressResult {
+        if tree_id != self.id.into() {
+            return layout_api::AccessibilityNodeAddressResult::StaleTree;
+        }
+        let accessibility_tree = self.accessibility_tree.borrow();
+        let Some(accessibility_tree) = accessibility_tree.as_ref() else {
+            return layout_api::AccessibilityNodeAddressResult::StaleNode;
+        };
+        if accessibility_tree.embedder_epoch() != epoch {
+            return layout_api::AccessibilityNodeAddressResult::StaleTree;
+        }
+        let Some((opaque_node, action_advertised, has_accessible_bounds)) =
+            accessibility_tree.action_target_for_id(node_id, action)
+        else {
+            return layout_api::AccessibilityNodeAddressResult::StaleNode;
+        };
+        layout_api::AccessibilityNodeAddressResult::Resolved {
+            address: UntrustedNodeAddress(opaque_node.0 as *const c_void),
+            action_advertised,
+            has_accessible_bounds,
+        }
+    }
+
     fn accessibility_active(&self) -> bool {
         self.accessibility_active.get()
     }
