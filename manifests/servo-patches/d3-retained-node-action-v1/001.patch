+    ) -> Option<UntrustedNodeAddress> {
+        if tree_id != self.id.into() {
+            return None;
+        }
+        let accessibility_tree = self.accessibility_tree.borrow();
+        let accessibility_tree = accessibility_tree.as_ref()?;
+        if accessibility_tree.embedder_epoch() != epoch {
+            return None;
+        }
+        let opaque_node = accessibility_tree.opaque_node_for_id(node_id)?;
+        Some(UntrustedNodeAddress(opaque_node.0 as *const c_void))
+    }
+
     fn accessibility_active(&self) -> bool {
         self.accessibility_active.get()
     }
