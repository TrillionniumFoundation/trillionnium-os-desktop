{
  "schema": "trillionnium.desktop.servo-api-requirements.v2",
  "servo_commit": "670ae8a70801b162e186f81cbb5bdd2d59c39108",
  "checkout_must_be_clean": true,
  "required_inputs": [
    "Cargo.lock",
    "Cargo.toml",
    "rust-toolchain.toml",
    "components/servo/Cargo.toml",
    "components/servo/lib.rs",
    "components/servo/webview.rs",
    "components/servo/webview_delegate.rs",
    "components/servo/examples/winit_minimal.rs",
    "ports/servoshell/Cargo.toml"
  ],
  "required_public_exports": [
    "Servo",
    "ServoBuilder",
    "ServoDelegate",
    "WebView",
    "WebViewBuilder",
    "WebViewDelegate",
    "RenderingContext",
    "WindowRenderingContext",
    "EventLoopWaker",
    "InputEvent",
    "CompositionEvent",
    "ClipboardDelegate",
    "CreateNewWebViewRequest",
    "NavigationRequest",
    "InputMethodControl",
    "EmbedderControl",
    "WebResourceLoad"
  ],
  "required_webview_methods": [
    "focus",
    "blur",
    "resize",
    "load",
    "notify_input_event",
    "paint",
    "take_screenshot",
    "set_accessibility_active"
  ],
  "required_delegate_callbacks": [
    "notify_url_changed",
    "notify_load_status_changed",
    "notify_new_frame_ready",
    "notify_input_event_handled",
    "notify_crashed",
    "request_navigation",
    "request_create_new",
    "notify_accessibility_tree_update"
  ],
  "required_compile_targets": [
    "servo example winit_minimal",
    "servo example trillionnium_embedder_probe",
    "servoshell binary"
  ],
  "product_constraints": {
    "single_logical_content_webview": true,
    "popup_requests_interceptable": true,
    "navigation_requests_interceptable": true,
    "screenshot_callback_available": true,
    "accessibility_updates_available": true,
    "production_webdriver_listener_allowed": false,
    "external_navigation_performed_by_gate": false
  },
  "claim_ceiling": "compile_compatibility_only"
}
