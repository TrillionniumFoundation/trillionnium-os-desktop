<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <!-- This product uses the AOSP SOFTWARE KeyMint implementation. These
         exclusions take precedence over the default HAL's hardware feature XML
         and other inherited feature declarations. -->
    <unavailable-feature name="android.hardware.hardware_keystore" />
    <unavailable-feature name="android.hardware.strongbox_keystore" />
    <unavailable-feature name="android.hardware.device_unique_attestation" />
    <unavailable-feature name="android.hardware.keystore.single_use_key" />
    <unavailable-feature name="android.hardware.keystore.limited_use_key" />
</permissions>
