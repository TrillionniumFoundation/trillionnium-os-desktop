+TEST_F(VirtualCameraProviderTest, ExactRemovalCannotRetireSameNameReplacement) {
+  auto original = mCameraProvider->createCamera(
+      mInputConfig, kCameraId, kDefaultDeviceId);
+  ASSERT_NE(original, nullptr);
+  ASSERT_TRUE(mCameraProvider->removeCamera(original));
+  std::shared_ptr<
+      ::aidl::android::hardware::camera::device::ICameraDeviceSession> session;
+  auto opened = original->open(nullptr, &session);
+  EXPECT_FALSE(opened.isOk());
+  EXPECT_EQ(opened.getServiceSpecificError(),
+            static_cast<int32_t>(Status::CAMERA_DISCONNECTED));
+  EXPECT_EQ(session, nullptr);
+  auto replacement = mCameraProvider->createCamera(
+      mInputConfig, kCameraId, kDefaultDeviceId);
+  ASSERT_NE(replacement, nullptr);
+  EXPECT_FALSE(mCameraProvider->removeCamera(original));
+  EXPECT_EQ(mCameraProvider->getCamera(replacement->getCameraName()), replacement);
+  EXPECT_TRUE(mCameraProvider->removeCamera(replacement));
+}
+
+TEST_F(VirtualCameraProviderTest, RemovalNotificationPrecedesNameReuse) {
+  ASSERT_TRUE(mCameraProvider->setCallback(mMockCameraProviderCallback).isOk());
+  auto original = mCameraProvider->createCamera(
+      mInputConfig, kCameraId, kDefaultDeviceId);
+  ASSERT_NE(original, nullptr);
+  std::promise<void> entered, release;
+  auto enteredFuture = entered.get_future();
+  auto releaseFuture = release.get_future();
+  EXPECT_CALL(*mMockCameraProviderCallback,
+              cameraDeviceStatusChange(_, CameraDeviceStatus::NOT_PRESENT))
+      .WillOnce([&](const std::string&, CameraDeviceStatus) {
+        entered.set_value();
+        releaseFuture.wait();
+        return ndk::ScopedAStatus::ok();
+      });
+  bool removed = false;
+  std::thread retire([&] { removed = mCameraProvider->removeCamera(original); });
+  const auto observed = enteredFuture.wait_for(std::chrono::seconds(5));
+  EXPECT_EQ(observed, std::future_status::ready);
+  if (observed == std::future_status::ready) {
+    EXPECT_EQ(mCameraProvider->createCamera(
+                  mInputConfig, kCameraId, kDefaultDeviceId), nullptr);
+    EXPECT_FALSE(mCameraProvider->removeCamera(original));
+  }
+  release.set_value();
+  retire.join();
+  EXPECT_TRUE(removed);
+  auto replacement = mCameraProvider->createCamera(
+      mInputConfig, kCameraId, kDefaultDeviceId);
+  EXPECT_NE(replacement, nullptr);
+}
