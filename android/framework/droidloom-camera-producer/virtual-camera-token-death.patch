+struct VirtualCameraService::TokenRegistration {
+  ::ndk::SpAIBinder token;
+  std::shared_ptr<TokenDeathCookie> cookie;
+  std::atomic<bool> dead{false};
+  // Accessed only while the service mLock is held.
+  std::shared_ptr<VirtualCameraDevice> camera;
+};
+
+struct VirtualCameraService::TokenDeathCookie {
+  std::weak_ptr<VirtualCameraService> service;
+  std::weak_ptr<TokenRegistration> registration;
+  // NDK guarantees onUnlinked exactly once, including failed link attempts, and
+  // only after pending onBinderDied. Never free the cookie after unlink returns.
+  std::shared_ptr<TokenDeathCookie> binderLifetime;
+};
+
+void VirtualCameraService::tokenUnlinked(void* opaque) {
+  auto* cookie = static_cast<TokenDeathCookie*>(opaque);
+  auto finalLease = std::move(cookie->binderLifetime);
+}
+
+void VirtualCameraService::tokenDied(void* opaque) {
+  auto* cookie = static_cast<TokenDeathCookie*>(opaque);
+  auto service = cookie->service.lock();
+  auto registration = cookie->registration.lock();
+  if (registration) registration->dead.store(true, std::memory_order_release);
+  if (service && registration) {
+    service->retireToken(registration, false);
+  }
+}
+
+void VirtualCameraService::retireToken(
+    const std::shared_ptr<TokenRegistration>& registration, bool unlink) {
+  std::shared_ptr<VirtualCameraDevice> camera;
+  {
+    std::lock_guard lock(mLock);
+    auto it = mTokenRegistrations.find(registration->token);
+    if (it != mTokenRegistrations.end() && it->second == registration) {
+      camera = std::move(registration->camera);
+      mTokenRegistrations.erase(it);
+    }
+  }
+  if (unlink && registration->cookie) {
+    // The held registration keeps the cookie address unique while this call
+    // races the death callback. Neither callback can target a newer registration.
+    AIBinder_unlinkToDeath(registration->token.get(), mTokenDeathRecipient.get(),
+                          registration->cookie.get());
+  }
+  if (camera != nullptr) {
+    // Removal uses the held original object, not a reusable device name, and
+    // unconditionally retires its session even when stream-close flags are off.
+    mVirtualCameraProvider->removeCamera(camera);
+  }
+}
