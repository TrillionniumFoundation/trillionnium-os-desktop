; Public host control is entered only by the two fixed installed clients.
; A normal shell/session does not receive broker IPC. UID authentication and
; typed per-request authorization remain the daemon's responsibility.
(type droidloom_public_control_client)
(type droidloom_public_control_client_exec)
(roletype system_r droidloom_public_control_client)
(roletype object_r droidloom_public_control_client_exec)
(typeattributeset p4_linux_native_processes (droidloom_public_control_client))
(typeattributeset p4_linux_native_session_processes (droidloom_public_control_client))
(typeattributeset p4_linux_native_executables (droidloom_public_control_client_exec))
(call p4_ubuntu_user_service (droidloom_public_control_client droidloom_public_control_client_exec))
(typetransition p4_linux_user_session_t droidloom_public_control_client_exec process droidloom_public_control_client)
(allow p4_linux_user_session_t droidloom_public_control_client_exec (file (getattr open read execute map)))
(allow p4_linux_user_session_t droidloom_public_control_client (process (transition siginh rlimitinh)))
(allow p4_linux_user_session_t droidloom_public_control_client (process2 (nnp_transition)))
(allow droidloom_public_control_client p4_linux_user_session_t (fd (use)))
; Return fixed CLI results through inherited caller stdout/stderr pipes.
; The client neither opens caller FIFO paths nor reads arbitrary caller input.
(allow droidloom_public_control_client p4_linux_user_session_t (fifo_file (getattr write)))
(neverallow droidloom_public_control_client p4_linux_user_session_t (fifo_file (open read append create setattr map execute relabelfrom relabelto)))
(allow droidloom_public_control_client p4_linux_user_session_t (process (sigchld)))
(allow droidloom_public_control_client droidloom_public_control_client_exec (file (execute_no_trans)))
; The launcher verifies the pinned public cell specification before a request.
(allow droidloom_public_control_client p4_linux_mac_release_input_t (file (getattr open read)))
(neverallow p4_linux_user_session_t droidloom_public_control_client_exec (file (execute_no_trans)))

; The ordinary systemd-tmpfiles-setup unit creates the exact preinstalled
; directory entry. The broker owns only control.sock and verifies its labels.
; The service executor retains its original no-write rule on the /run root.
(type droidloom_public_control_dir)
(type droidloom_public_control_socket)
(roletype object_r droidloom_public_control_dir)
(roletype object_r droidloom_public_control_socket)
(typeattributeset p4_linux_data (droidloom_public_control_dir droidloom_public_control_socket))
(allow droidloom_public_control_dir tmpfs (filesystem (associate)))
(allow droidloom_public_control_socket tmpfs (filesystem (associate)))
(typetransition p4_linux_setup_t p4_linux_run_t dir "droidloom" droidloom_public_control_dir)
(allow p4_linux_setup_t p4_linux_run_t (dir (getattr search write add_name)))
(allow p4_linux_setup_t droidloom_public_control_dir (dir (getattr search open read create setattr)))
; Stock tmpfiles uses the single-SELinux native fscreate API and consults
; the normal installed file_contexts. It never writes proc attributes/memory.
(typeattributeset p4_native_selinux_query_clients (p4_linux_setup_t))
(allow p4_linux_setup_t kernel (security (check_context compute_create)))
(allow p4_linux_setup_t self (process (setfscreate)))
(neverallow p4_linux_setup_t self (file (write append)))
(neverallow p4_linux_setup_t droidloom_public_control_dir (dir (relabelfrom relabelto mounton)))
(allow init_t droidloom_public_control_dir (dir (getattr search)))
(allow p4_linux_service_executor_t droidloom_public_control_dir (dir (getattr search open read setattr ioctl)))
(allowx p4_linux_service_executor_t droidloom_public_control_dir (ioctl dir (0x581f)))
(neverallowx p4_linux_service_executor_t droidloom_public_control_dir (ioctl dir (not (0x581f))))
(allow droidloom_broker droidloom_public_control_dir (dir (getattr search open read write add_name remove_name)))
(typetransition droidloom_broker droidloom_public_control_dir sock_file "control.sock" droidloom_public_control_socket)
(allow droidloom_broker droidloom_public_control_socket (sock_file (create getattr setattr write unlink)))
(allow droidloom_broker self (unix_stream_socket (create bind listen accept getattr read write getopt setopt shutdown)))
(neverallow droidloom_broker droidloom_public_control_dir (dir (create rmdir rename relabelto relabelfrom mounton)))
(neverallow droidloom_broker droidloom_public_control_socket (sock_file (relabelfrom relabelto)))

(typeattribute droidloom_public_control_peers)
(typeattributeset droidloom_public_control_peers (droidloom_public_control_client droidloom_package_helper))
(allow droidloom_public_control_peers droidloom_public_control_dir (dir (getattr search)))
(allow droidloom_public_control_peers droidloom_public_control_socket (sock_file (getattr write)))
(allow droidloom_public_control_peers droidloom_broker (unix_stream_socket (connectto)))
(allow droidloom_broker droidloom_public_control_peers (unix_stream_socket (read write)))
(neverallow droidloom_public_control_peers droidloom_public_control_dir (dir (write create add_name remove_name rmdir rename relabelfrom relabelto mounton)))
(neverallow droidloom_public_control_peers droidloom_public_control_socket (sock_file (create unlink link rename setattr relabelfrom relabelto)))
(neverallow p4_linux_user_session_t droidloom_broker (unix_stream_socket (connectto)))
(typeattribute droidloom_without_public_control)
(typeattributeset droidloom_without_public_control (not (or (droidloom_broker) (droidloom_public_control_peers))))
(neverallow droidloom_without_public_control droidloom_public_control_socket (sock_file (write)))

; Public APK input is a distinct, package-owned drop directory. It is not a
; home directory, private account state, product storage or a temporary tree.
; The normal host archive installs only the empty root. Stock tmpfiles creates
; the one selected host-UID directory, with numeric DAC owner 1000:1000.
(type droidloom_public_apk_root)
(type droidloom_public_apk_dir)
(type droidloom_public_apk_input)
(roletype object_r droidloom_public_apk_root)
(roletype object_r droidloom_public_apk_dir)
(roletype object_r droidloom_public_apk_input)
(typeattributeset p4_linux_data (droidloom_public_apk_root droidloom_public_apk_dir droidloom_public_apk_input))
(allow droidloom_public_apk_root labeledfs (filesystem (associate)))
(allow droidloom_public_apk_dir labeledfs (filesystem (associate)))
(allow droidloom_public_apk_input labeledfs (filesystem (associate)))
(typetransition p4_linux_setup_t droidloom_public_apk_root dir "u1000" droidloom_public_apk_dir)
(allow p4_linux_setup_t droidloom_public_apk_root (dir (getattr search open read write add_name)))
(allow p4_linux_setup_t droidloom_public_apk_dir (dir (getattr search open read create setattr)))
; Ownership/mode maintenance is limited by the typed directory setattr grants.
(allow p4_linux_setup_t self (capability (chown fowner)))
(allow p4_linux_user_session_t droidloom_public_apk_root (dir (getattr search)))
(allow p4_linux_user_session_t droidloom_public_apk_dir (dir (getattr search open read write add_name remove_name)))
(typetransition p4_linux_user_session_t droidloom_public_apk_dir file droidloom_public_apk_input)
(allow p4_linux_user_session_t droidloom_public_apk_input (file (create getattr open read write append setattr unlink)))
(allow droidloom_public_control_client droidloom_public_apk_root (dir (getattr search)))
(allow droidloom_public_control_client droidloom_public_apk_dir (dir (getattr search)))
(allow droidloom_public_control_client droidloom_public_apk_input (file (getattr open read)))
(neverallow droidloom_public_control_client droidloom_public_apk_input (file (write append create setattr unlink rename relabelfrom relabelto map execute execute_no_trans entrypoint)))
(neverallow droidloom_broker droidloom_public_apk_input (file (getattr open read write append create setattr unlink rename map execute)))
(neverallow p4_linux_user_session_t droidloom_public_apk_root (dir (write add_name remove_name create rmdir rename relabelfrom relabelto)))
(neverallow p4_linux_user_session_t droidloom_public_apk_dir (dir (create rmdir rename reparent relabelfrom relabelto)))
(neverallow domain droidloom_public_apk_input (file (open read write append map execute execute_no_trans entrypoint)))
(neverallow p4_linux_procs droidloom_public_apk_input (file (map execute execute_no_trans entrypoint)))

; Linux 6.18 uses FS_USE_TRANS without a name for an anonymous shmem inode.
; Only the fixed installed public client creates this pure-data transport type.
; Its source-owned memfd name, NOEXEC seal, four immutable seals, read-only
; description, complete segment hashes and actual context are checked in Rust.
; The broker never receives the user's original file, nor an O_RDWR descriptor.
(type droidloom_apk_payload)
(roletype object_r droidloom_apk_payload)
(typeattributeset p4_all_board_owned (droidloom_apk_payload))
(allow droidloom_apk_payload tmpfs (filesystem (associate)))
(typetransition droidloom_public_control_client tmpfs file droidloom_apk_payload)
(typetransition droidloom_public_control_client tmpfs memfd_file droidloom_apk_payload)
(allow droidloom_public_control_client droidloom_apk_payload (file (create getattr open read write setattr)))
(allow droidloom_public_control_client droidloom_apk_payload (memfd_file (create getattr open read write setattr)))
(allow droidloom_broker droidloom_public_control_client (fd (use)))
(allow droidloom_broker droidloom_apk_payload (file (getattr read)))
(allow droidloom_broker droidloom_apk_payload (memfd_file (getattr read)))
(allow droidloom_broker tmpfs (filesystem (getattr)))
(neverallow droidloom_broker p4_linux_user_session_t (fd (use)))
(neverallow droidloom_broker droidloom_apk_payload (file (open write append create setattr unlink rename map execute execute_no_trans entrypoint relabelfrom relabelto)))
(neverallow droidloom_broker droidloom_apk_payload (memfd_file (open write append create setattr map execute execute_no_trans entrypoint relabelfrom relabelto)))
(neverallow p4_linux_procs droidloom_apk_payload (file (map execute execute_no_trans entrypoint)))
(neverallow p4_linux_procs droidloom_apk_payload (memfd_file (map execute execute_no_trans entrypoint)))
(neverallow domain droidloom_apk_payload (file (getattr open read write append map execute execute_no_trans entrypoint)))
(neverallow domain droidloom_apk_payload (memfd_file (getattr open read write append map execute execute_no_trans entrypoint)))
