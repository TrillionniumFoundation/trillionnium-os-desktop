; Fixed returned-working-copy qualification actors. They remain Linux subjects,
; outside both Android's domain and the broad native-process IPC groups.
; Runtime admission still requires the actual source-owned Main, PIDFD, cgroup,
; original deadline, selected bytes and complete per-case observations.
(type p4_linux_working_qualification_t)
(type p4_linux_working_privateprep_t)
(type p4_linux_working_application_t)
(type p4_linux_working_return_t)
(roletype system_r p4_linux_working_qualification_t)
(roletype system_r p4_linux_working_privateprep_t)
(roletype system_r p4_linux_working_application_t)
(roletype system_r p4_linux_working_return_t)
(typeattribute p4_working_actors)
(typeattribute p4_working_clients)
(typeattribute p4_working_children)
(typeattributeset p4_working_clients
 (p4_linux_working_qualification_t p4_linux_working_privateprep_t p4_linux_working_application_t))
(typeattributeset p4_working_children
 (p4_linux_working_privateprep_t p4_linux_working_application_t))
(typeattributeset p4_working_actors (p4_working_clients p4_linux_working_return_t))
(typeattributeset p4_linux_procs (p4_working_actors))

(type p4_linux_working_config_t)
(type p4_linux_working_unit_t)
(type p4_linux_working_parent_t)
(type p4_linux_working_evidence_t)
(type p4_linux_working_output_root_t)
(type p4_linux_working_plan_t)
(type p4_linux_working_journal_t)
(type p4_linux_working_comparison_t)
(type p4_linux_working_current_dir_t)
(type p4_linux_working_current_t)
(type p4_linux_working_current_lock_t)
(type p4_linux_native_leaf_source_t)
(type p4_linux_native_leaf_layout_t)
(type p4_linux_native_leaf_release_t)
(type p4_linux_working_cgroup_t)
(type p4_linux_working_limits_t)
(type p4_linux_working_watchdog_t)
(type p4_linux_working_apk_dir_t)
(type p4_linux_working_apk_input_t)
(typeattribute p4_working_disk_types)
(typeattributeset p4_working_disk_types
 (p4_linux_working_config_t p4_linux_working_unit_t p4_linux_working_parent_t
  p4_linux_working_evidence_t p4_linux_working_output_root_t
  p4_linux_working_plan_t p4_linux_working_journal_t
  p4_linux_working_current_dir_t p4_linux_working_current_t p4_linux_working_current_lock_t
  p4_linux_native_leaf_source_t p4_linux_native_leaf_layout_t p4_linux_native_leaf_release_t
  p4_linux_working_apk_dir_t p4_linux_working_apk_input_t))
(typeattribute p4_working_data)
(typeattributeset p4_working_data
 (p4_working_disk_types p4_linux_working_comparison_t p4_linux_working_cgroup_t
  p4_linux_working_limits_t p4_linux_working_watchdog_t))
(roletype object_r p4_linux_working_config_t)
(roletype object_r p4_linux_working_unit_t)
(roletype object_r p4_linux_working_parent_t)
(roletype object_r p4_linux_working_evidence_t)
(roletype object_r p4_linux_working_output_root_t)
(roletype object_r p4_linux_working_plan_t)
(roletype object_r p4_linux_working_journal_t)
(roletype object_r p4_linux_working_comparison_t)
(roletype object_r p4_linux_working_current_dir_t)
(roletype object_r p4_linux_working_current_t)
(roletype object_r p4_linux_working_current_lock_t)
(roletype object_r p4_linux_native_leaf_source_t)
(roletype object_r p4_linux_native_leaf_layout_t)
(roletype object_r p4_linux_native_leaf_release_t)
(roletype object_r p4_linux_working_cgroup_t)
(roletype object_r p4_linux_working_limits_t)
(roletype object_r p4_linux_working_watchdog_t)
(roletype object_r p4_linux_working_apk_dir_t)
(roletype object_r p4_linux_working_apk_input_t)
(typeattributeset p4_linux_data (p4_working_data))
(allow p4_working_disk_types labeledfs (filesystem (associate)))
(allow p4_linux_working_comparison_t tmpfs (filesystem (associate)))
(allow p4_linux_working_watchdog_t device (filesystem (associate)))

; The independent EMPTY diagnostic has one exact root-private APK. These two
; objects are not ordinary working inputs and inherit no generic Linux data
; readers. The normal manager only tests existence; the fixed preparation
; client holds and hashes the complete original file without writing it.
(type p4_linux_empty_meituan_dir_t)
(type p4_linux_empty_meituan_apk_t)
(roletype object_r p4_linux_empty_meituan_dir_t)
(roletype object_r p4_linux_empty_meituan_apk_t)
(typeattributeset p4_all_board_owned (p4_linux_empty_meituan_dir_t p4_linux_empty_meituan_apk_t))
(allow p4_linux_empty_meituan_dir_t labeledfs (filesystem (associate)))
(allow p4_linux_empty_meituan_apk_t labeledfs (filesystem (associate)))
(allow init_t p4_linux_working_output_root_t (dir (getattr search)))
(allow init_t p4_linux_empty_meituan_dir_t (dir (getattr search)))
(allow init_t p4_linux_empty_meituan_apk_t (file (getattr)))
(allow p4_linux_working_privateprep_t p4_linux_empty_meituan_dir_t (dir (getattr search)))
(allow p4_linux_working_privateprep_t p4_linux_empty_meituan_apk_t (file (getattr open read)))

; Both programs are existing release ELFs. Explicit unit SELinuxContext chooses
; the new parent/return roles. Do not add competing default type transitions
; to either the public applications ELF or the old original-return ELF.
(allow init_t p4_linux_working_unit_t (file (getattr open read map)))
(allow p4_linux_service_executor_t p4_linux_working_unit_t (file (getattr open read)))
(allow p4_linux_service_executor_t droidloom_public_control_client_exec (file (getattr open read execute map)))
(allow p4_linux_service_executor_t p4_linux_working_qualification_t (process (transition siginh rlimitinh)))
(allow p4_linux_service_executor_t p4_linux_working_return_t (process (transition siginh rlimitinh)))
; Only a source-owned explicit unit context selects the diagnostic client.
; The public CLI keeps its old default transition. Runtime identity checks
; additionally require the exact unit, argv and installed original ELF.
(allow p4_linux_service_executor_t p4_linux_working_privateprep_t (process (transition siginh rlimitinh)))
(allow p4_linux_working_qualification_t droidloom_public_control_client_exec (file (getattr open read execute map entrypoint)))
(allow p4_linux_working_return_t p4_linux_once_return_exec_t (file (getattr open read execute map entrypoint)))
(auditallow p4_linux_service_executor_t p4_linux_working_qualification_t (process (transition)))
(auditallow p4_linux_service_executor_t p4_linux_working_return_t (process (transition)))
(auditallow p4_linux_service_executor_t p4_linux_working_privateprep_t (process (transition)))

; The fixed parent closes its only watchdog FD before either onexec transition.
; The exact argv, same installed ELF and two pending LSM attributes are checked
; again by the child. No caller-selectable domain or immediate dyntransition.
(allow p4_linux_working_qualification_t self (process (setexec)))
(allow p4_linux_working_qualification_t self (file (write)))
(allow p4_linux_working_qualification_t p4_working_children (process (transition siginh rlimitinh)))
(allow p4_working_children droidloom_public_control_client_exec (file (getattr open read execute map entrypoint execute_no_trans)))
(allow p4_working_children p4_linux_working_qualification_t (process (sigchld)))
(allow p4_linux_working_qualification_t p4_working_children (process (getattr signull signal sigkill)))
(auditallow p4_linux_working_qualification_t p4_working_children (process (transition)))

; The ordinary selected 6.18 shmem transition uses the creating task, not the
; memfd name. A separately execed, empty-capability child therefore creates
; only the empty non-executable APK inode. It inherits the preparation AA
; profile, one original seqpacket description and the already-EOF read pipe.
; The parent reaps this child before copying any APK bytes. No original APK,
; comparison inode, namespace handle or public broker socket enters the child.
(type p4_linux_working_payload_birth_t)
(roletype system_r p4_linux_working_payload_birth_t)
(typeattributeset p4_all_board_owned (p4_linux_working_payload_birth_t))
(allow p4_linux_working_privateprep_t self (process (setexec)))
(allow p4_linux_working_privateprep_t p4_linux_working_payload_birth_t (process (transition siginh rlimitinh getattr sigkill)))
(allow p4_linux_working_privateprep_t p4_linux_working_payload_birth_t (process2 (nnp_transition)))
(auditallow p4_linux_working_privateprep_t p4_linux_working_payload_birth_t (process (transition)))
(allow p4_linux_working_payload_birth_t p4_linux_working_privateprep_t (process (sigchld)))
(allow p4_linux_working_payload_birth_t self (process (getattr getcap)))
(allow p4_linux_working_payload_birth_t p4_linux_working_privateprep_t (fd (use)))
(allow p4_linux_working_payload_birth_t p4_linux_working_privateprep_t (fifo_file (getattr read)))
(allow p4_linux_working_payload_birth_t p4_linux_working_privateprep_t (unix_stream_socket (getattr getopt read write)))
(allow p4_linux_working_payload_birth_t droidloom_public_control_client_exec (file (getattr open read execute map entrypoint)))
(allow p4_linux_working_payload_birth_t p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_working_payload_birth_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_working_payload_birth_t p4_linux_console_ld_cache_native_config_t (file (getattr open read map)))
(allow p4_linux_working_payload_birth_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_working_payload_birth_t p4_linux_etc_dir_t (dir (getattr search)))
(allow p4_linux_working_payload_birth_t p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_linux_working_payload_birth_t proc (dir (getattr search)))
(allow p4_linux_working_payload_birth_t proc (lnk_file (getattr read)))
(allow p4_linux_working_payload_birth_t proc (filesystem (getattr)))
(allow p4_linux_working_payload_birth_t self (dir (getattr search)))
(allow p4_linux_working_payload_birth_t self (file (getattr open read)))
(allow p4_linux_working_payload_birth_t self (lnk_file (getattr read)))
(allow p4_linux_working_payload_birth_t tmpfs (filesystem (getattr)))
; PIDFD_GET_INFO is the fixed mask-3 identity query, not a namespace ioctl.
(allow p4_linux_working_privateprep_t p4_kernel_pid_handle_t (file (getattr ioctl)))
(allowx p4_linux_working_privateprep_t p4_kernel_pid_handle_t (ioctl file (0xff0b)))
(neverallowx p4_linux_working_privateprep_t p4_kernel_pid_handle_t (ioctl file (not (0xff0b))))
(allow p4_linux_working_payload_birth_t p4_kernel_pid_handle_t (file (getattr ioctl)))
(allowx p4_linux_working_payload_birth_t p4_kernel_pid_handle_t (ioctl file (0xff0b)))
(neverallowx p4_linux_working_payload_birth_t p4_kernel_pid_handle_t (ioctl file (not (0xff0b))))
; memfd_create reaches shmem_file_setup/alloc_file without a normal open or
; create hook. Only the actual empty-inode metadata is read by this child.
(typetransition p4_linux_working_payload_birth_t tmpfs file droidloom_apk_payload)
(typetransition p4_linux_working_payload_birth_t tmpfs memfd_file droidloom_apk_payload)
(allow p4_linux_working_payload_birth_t droidloom_apk_payload (file (getattr)))
(allow p4_linux_working_payload_birth_t droidloom_apk_payload (memfd_file (getattr)))
; SCM_RIGHTS checks the RW description even while empty. After actual reap,
; preparation copies and reads back the original bytes, seals the inode and
; reopens only its held numeric descriptor read-only for the normal receiver.
(allow p4_linux_working_privateprep_t p4_linux_working_payload_birth_t (fd (use)))
(allow p4_linux_working_privateprep_t droidloom_apk_payload (file (getattr open read write)))
(allow p4_linux_working_privateprep_t droidloom_apk_payload (memfd_file (getattr open read write)))

; This role is intentionally outside p4_linux_procs, p4_working_actors and
; p4_handle_owner. The normal verifier checks every incoming/outgoing vector,
; including the exact independently reviewed normal loader/rootdir aliases.
(typeattribute p4_working_payload_not_prep)
(typeattributeset p4_working_payload_not_prep (not (p4_linux_working_privateprep_t)))
(typeattribute p4_working_payload_not_birth)
(typeattributeset p4_working_payload_not_birth (not (p4_linux_working_payload_birth_t)))
(typeattribute p4_working_payload_other_entries)
(typeattributeset p4_working_payload_other_entries (not (or (droidloom_public_control_client_exec) (p4_linux_observed_client_exec_t))))
(typeattribute p4_working_payload_other_handles)
(typeattributeset p4_working_payload_other_handles (not (p4_kernel_pid_handle_t)))
(typeattribute p4_working_payload_other_memfds)
(typeattributeset p4_working_payload_other_memfds (not (droidloom_apk_payload)))
(neverallow p4_working_payload_not_prep p4_linux_working_payload_birth_t (process (transition dyntransition)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (process (not (getattr getcap sigchld))))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (process2 (all)))
(neverallow p4_linux_working_payload_birth_t self (capability (all)))
(neverallow p4_linux_working_payload_birth_t self (capability2 (all)))
(neverallow p4_linux_working_payload_birth_t self (cap_userns (all)))
(neverallow p4_linux_working_payload_birth_t self (cap2_userns (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (file (not (getattr open read execute map entrypoint ioctl))))
(neverallow p4_linux_working_payload_birth_t p4_working_payload_other_entries (file (entrypoint)))
(neverallow p4_linux_working_payload_birth_t p4_working_payload_other_handles (file (ioctl)))
(neverallowx p4_linux_working_payload_birth_t p4_working_payload_other_handles (ioctl file (range 0x0000 0xffff)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (memfd_file (not (getattr))))
(neverallow p4_linux_working_payload_birth_t p4_working_payload_other_memfds (memfd_file (all)))
(neverallow p4_linux_working_payload_birth_t droidloom_apk_payload (file (not (getattr))))
(neverallow p4_linux_working_payload_birth_t p4_linux_working_comparison_t (file (all)))
(neverallow p4_linux_working_payload_birth_t p4_linux_working_apk_input_t (file (all)))
(neverallow p4_linux_working_payload_birth_t p4_kernel_ns_handle_t (file (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (dir (not (getattr search))))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (lnk_file (not (getattr read))))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (filesystem (not (getattr))))
(neverallow p4_linux_working_payload_birth_t p4_working_payload_not_prep (fd (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (fifo_file (not (getattr read))))
(neverallow p4_linux_working_payload_birth_t p4_working_payload_not_prep (fifo_file (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (unix_stream_socket (not (getattr getopt read write))))
(neverallow p4_linux_working_payload_birth_t p4_working_payload_not_prep (unix_stream_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (unix_dgram_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (chr_file (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (blk_file (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (sock_file (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (binder (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (security (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (service (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (dbus (all)))
(neverallow p4_working_all_types p4_linux_working_payload_birth_t (dbus (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (tcp_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (udp_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (rawip_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (packet_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (netlink_route_socket (all)))
(neverallow p4_linux_working_payload_birth_t p4_working_all_types (netlink_kobject_uevent_socket (all)))

(macro p4_working_base ((type subject))
 (allow subject self (process (fork getattr getcap setcap getpgid setpgid getsession getsched sigchld)))
 (allow subject self (dir (getattr search open read)))
 (allow subject self (file (getattr open read)))
 (allow subject self (lnk_file (getattr read)))
 (allow subject self (fd (use)))
 (allow subject self (fifo_file (getattr read write)))
 (allow subject p4_linux_rootdir_t (dir (getattr search)))
 (allow subject p4_linux_etc_dir_t (dir (getattr search)))
 (allow subject p4_linux_product_store_t (dir (getattr search)))
 (allow subject p4_linux_var_lib_t (dir (getattr search)))
 (allow subject p4_linux_run_t (dir (getattr search)))
 (allow subject p4_linux_runtime_lib_t (file (getattr open read execute map)))
 (allow subject p4_linux_elf_interpreter_t (file (getattr open read execute map)))
 (allow subject p4_linux_usrmerge_link_t (lnk_file (getattr read)))
 (allow subject p4_linux_standardio_t (chr_file (getattr open read write)))
 (allow subject null_device (chr_file (getattr open read write)))
 (allow subject p4_linux_working_config_t (dir (getattr search)))
 (allow subject p4_linux_working_config_t (file (getattr open read)))
 (allow subject p4_linux_working_unit_t (file (getattr open read)))
 (allow subject p4_linux_once_config_t (dir (getattr search)))
 (allow subject p4_linux_once_parent_t (dir (getattr search)))
 (allow subject p4_linux_working_parent_t (dir (getattr search)))
 (allow subject droidloom_package_config_parents (dir (getattr search)))
 (allow subject p4_linux_mac_release_input_t (file (getattr open read)))
 (allow subject p4_linux_early_handoff_dir_t (dir (getattr search)))
 (allow subject p4_linux_host_mount_identity_t (file (getattr open read)))
 (allow subject p4_linux_native_dev_root_t (dir (getattr search)))
 (allow subject p4_linux_root_uuid_link_t (lnk_file (getattr read)))
 (allow subject p4_linux_root_block_t (blk_file (getattr)))
 (allow subject labeledfs (filesystem (getattr)))
 (allow subject tmpfs (filesystem (getattr)))
 (allow subject proc (filesystem (getattr)))
 (allow subject sysfs (filesystem (getattr)))
 (allow subject proc (dir (getattr search)))
 (allow subject proc (lnk_file (getattr read)))
 (allow subject proc (file (getattr open read)))
 (allow subject proc_random (dir (getattr search)))
 (allow subject proc_random (file (getattr open read)))
 (allow subject proc_cmdline (file (getattr open read)))
 (allow subject selinuxfs (dir (getattr search)))
 (allow subject selinuxfs (file (getattr open read)))
 (allow subject sysfs (dir (getattr search open read)))
 (allow subject sysfs (file (getattr open read)))
 (allow subject device (dir (getattr search)))
 (typeattributeset p4_handle_owner (subject))
 (allowx subject p4_kernel_ns_handle_t (ioctl file (0xb703)))
 (neverallowx subject p4_kernel_ns_handle_t (ioctl file (not (0xb703))))
)
(call p4_working_base (p4_linux_working_qualification_t))
(call p4_working_base (p4_linux_working_privateprep_t))
(call p4_working_base (p4_linux_working_application_t))
(call p4_working_base (p4_linux_working_return_t))
(typeattributeset p4_native_boot_commandline_readers (p4_working_actors))
(typeattributeset p4_native_public_directory_traversers (p4_working_actors))

; Read-mode proc checks are not ptrace attach. The selected kernel tests
; FILE__READ / AA_PTRACE_READ for these exact peers; attach tests PROCESS__PTRACE
; and remains forbidden. The initial-namespace peer and nested Main user
; namespace require the corresponding two capability classes.
(typeattribute p4_working_main_proc_peers)
(typeattributeset p4_working_main_proc_peers (droidloom_broker init system_server))
(typeattribute p4_working_proc_peers)
(typeattributeset p4_working_proc_peers (p4_working_main_proc_peers init_t p4_working_clients))
(allow p4_working_clients p4_working_proc_peers (dir (getattr search)))
(allow p4_working_clients p4_working_proc_peers (file (getattr open read)))
(allow p4_working_clients p4_working_proc_peers (lnk_file (getattr read)))
; The normal broker authenticates only the actual physical NativeUi caller.
; SO_PEERSEC is AppArmor on this route; both named current attributes and the
; fixed installed applications ELF are separately read through the held peer.
(allow droidloom_broker p4_linux_working_application_t (dir (getattr search)))
(allow droidloom_broker p4_linux_working_application_t (file (getattr open read)))
(allow droidloom_broker p4_linux_working_application_t (lnk_file (getattr read)))
(neverallow droidloom_broker p4_linux_working_application_t (process (ptrace signal sigkill sigstop)))
; Normal installation authenticates the independent preparation caller as
; well. Read-mode proc observations and the fixed public-client ELF body do
; not permit ptrace attach, mutation or executing the client's program.
(allow droidloom_broker p4_linux_working_privateprep_t (dir (getattr search)))
(allow droidloom_broker p4_linux_working_privateprep_t (file (getattr open read)))
(allow droidloom_broker p4_linux_working_privateprep_t (lnk_file (getattr read)))
(neverallow droidloom_broker p4_linux_working_privateprep_t (process (ptrace signal sigkill sigstop)))

; Fixed CURRENT/lock I/O uses a joined thread-local fsuid/fsgid scope.
; No DAC bypass or ownership change: new CURRENT is born as its exact owner.
(allow p4_linux_working_qualification_t self (capability (setuid setgid sys_ptrace)))
(allow p4_working_children self (capability (setuid setgid sys_ptrace)))
(allow p4_working_clients self (cap_userns (sys_ptrace)))
(neverallow p4_linux_working_qualification_t self (capability (not (setuid setgid sys_ptrace))))
(neverallow p4_working_children self (capability (not (setuid setgid sys_ptrace))))
(neverallow p4_working_clients self (cap_userns (not (sys_ptrace))))

; Actual held root and the four CE/DE directories are metadata, not private
; file bodies. The final package directories have O_PATH only, not read/search.
(typeattribute p4_working_android_traversal)
(typeattributeset p4_working_android_traversal
 (rootfs system_file system_data_root_file system_data_file))
(allow p4_working_clients p4_working_android_traversal (dir (getattr search)))
(allow p4_working_clients app_data_file (dir (getattr)))
(allow p4_working_clients zygote_exec (file (getattr)))
(allow p4_working_clients init_exec (file (getattr)))
; No app_data_file body or mlstrustedsubject grant: Camera mode/private-body
; observations need their separate real factory, not this metadata role.

; Public control preserves the original authenticated broker and socket owner.
; No host subject executes an Android command, calls Binder, creates a listener
; at the control name, or receives arbitrary guest descriptions.
(typeattributeset droidloom_public_control_peers (p4_working_clients))
(allow p4_working_clients self (unix_stream_socket (create connect getattr read write getopt setopt shutdown)))
(allow p4_working_clients self (unix_dgram_socket (create connect getattr read write sendto getopt setopt shutdown)))
(allow p4_working_clients droidloom_broker (fd (use)))
(allow p4_working_clients droidloom_broker (unix_stream_socket (getattr read write getopt shutdown)))
(allow p4_working_clients p4_working_clients (fd (use)))
(allow p4_working_clients p4_working_clients (unix_stream_socket (getattr read write getopt setopt shutdown)))
(allow p4_working_clients p4_working_clients (unix_dgram_socket (getattr read write sendto getopt setopt shutdown)))
(allow p4_working_clients p4_working_clients (fifo_file (getattr read write)))
