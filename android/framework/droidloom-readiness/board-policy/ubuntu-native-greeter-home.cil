; Fresh root-owned 0700 inodes use the same fixed parent for atomic exchange.
; The final fresh root alone is chowned after validation; old objects are not.
(typetransition p4_linux_gdm_t p4_linux_greeter_seat_parent_t dir ".config-handoff" p4_linux_greeter_seat_data_t)
(typetransition p4_linux_gdm_t p4_linux_greeter_seat_parent_t dir ".state-handoff" p4_linux_greeter_seat_data_t)
(allow p4_linux_gdm_t p4_linux_greeter_seat_data_t (dir (rename)))
(allow p4_linux_gdm_t p4_linux_greeter_seat_data_t (lnk_file (create write)))
(neverallow p4_linux_gdm_t p4_linux_greeter_seat_data_t (dir (reparent)))
(typetransition p4_linux_gdm_t p4_linux_greeter_home_t dir "environment.d" p4_linux_greeter_environment_t)
; environment.d is created below the held .config directory, which retains
; the home type. The named transition applies only to this fixed leaf.
(allow p4_linux_gdm_worker_t p4_greeter_private_data (dir (getattr search)))
(allow p4_native_home_readers p4_greeter_private_data (dir (getattr search open read)))
(allow p4_native_home_readers p4_greeter_private_data (file (getattr open read map lock)))
(allow p4_native_home_readers p4_greeter_private_data (lnk_file (getattr read)))
; These are the same normal per-user configuration/cache actors as ordinary
; native HOME. They gain no access to the daemon's runtime or other GDM state.
(call p4_native_user_data (p4_native_home_writers p4_linux_greeter_home_t))
(call p4_native_user_data (p4_native_home_writers p4_linux_greeter_seat_data_t))
