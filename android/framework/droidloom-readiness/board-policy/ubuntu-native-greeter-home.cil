; GDM 50.1 dynamic greeter homes, kept distinct from GDM daemon runtime.
; Normal dynamic UID DAC (0700 / 0600) still separates each greeter.
; No credential, MAC-management, executable-data or generic gdm_run grant.
(typeattribute p4_greeter_private_objects)
(type p4_linux_greeter_home_parent_t)
(roletype object_r p4_linux_greeter_home_parent_t)
(type p4_linux_greeter_home_t)
(roletype object_r p4_linux_greeter_home_t)
(type p4_linux_greeter_environment_t)
(roletype object_r p4_linux_greeter_environment_t)
(type p4_linux_greeter_seat_parent_t)
(roletype object_r p4_linux_greeter_seat_parent_t)
(type p4_linux_greeter_seat_data_t)
(roletype object_r p4_linux_greeter_seat_data_t)
(typeattributeset p4_greeter_private_objects (p4_linux_greeter_home_parent_t p4_linux_greeter_home_t p4_linux_greeter_environment_t p4_linux_greeter_seat_parent_t p4_linux_greeter_seat_data_t))
(typeattributeset p4_linux_data (p4_greeter_private_objects))
(typeattribute p4_greeter_private_data)
(typeattributeset p4_greeter_private_data (p4_linux_greeter_home_t p4_linux_greeter_seat_data_t))
(typeattribute p4_greeter_path_users)
(typeattributeset p4_greeter_path_users (p4_native_home_readers p4_linux_gdm_worker_t))
(allow p4_linux_greeter_home_parent_t tmpfs (filesystem (associate)))
(allow p4_linux_greeter_home_t tmpfs (filesystem (associate)))
(allow p4_linux_greeter_environment_t tmpfs (filesystem (associate)))
(allow p4_linux_greeter_seat_parent_t labeledfs (filesystem (associate)))
(allow p4_linux_greeter_seat_data_t labeledfs (filesystem (associate)))
