(call p4_ubuntu_state (p4_linux_rtkit_t p4_linux_rtkit_state_t p4_linux_rtkit_run_t))
(type p4_linux_bluetooth_state_t)
(type p4_linux_bluetooth_run_t)
(call p4_ubuntu_state (p4_linux_bluetooth_t p4_linux_bluetooth_state_t p4_linux_bluetooth_run_t))
