; Ubuntu's real system services and desktop are Linux members of the joined
; policy. These identities never inherit Android's domain/file_type attributes.
; Original Android assertions and the Linux/Android IPC and file guards remain.
; Readable public code, mutable service state, and session data have separate
; types. This is the initial native policy: runtime acceptance requires a real
; enforcing cold boot and the original distribution units.

(typeattribute p4_linux_native_processes)
(typeattribute p4_linux_native_system_services)
(typeattribute p4_linux_native_session_processes)
(typeattribute p4_linux_native_executables)
(typeattribute p4_linux_native_state)
(typeattribute p4_linux_native_runtime)
(typeattribute p4_linux_native_public_files)

