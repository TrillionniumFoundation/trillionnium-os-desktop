; Common operations are local to the subject or immutable public Linux inputs.
(allow p4_linux_native_processes self (process (fork sigchld getattr getcap getsched getsession)))
(allow p4_linux_native_processes self (dir (getattr search open read)))
(allow p4_linux_native_processes self (file (getattr open read)))
(allow p4_linux_native_processes self (lnk_file (getattr read)))
(allow p4_linux_native_processes self (fd (use)))
(allow p4_linux_native_processes self (fifo_file (getattr open read write)))
(allow p4_linux_native_processes self (unix_stream_socket (create getattr read write bind listen accept connect getopt setopt shutdown)))
(allow p4_linux_native_processes self (unix_dgram_socket (create getattr read write bind connect sendto getopt setopt shutdown)))
(allow p4_linux_native_processes p4_linux_rootdir_t (dir (getattr search open read)))
(allow p4_linux_native_processes p4_linux_etc_dir_t (dir (getattr search open read)))
(allow p4_linux_native_processes p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_native_processes p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_native_processes p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_linux_native_processes p4_linux_public_accounts_t (file (getattr open read)))
(allow p4_linux_native_processes p4_linux_machine_id_t (file (getattr open read)))
(allow p4_linux_native_processes p4_linux_distribution_info_t (file (getattr open read)))
(allow p4_linux_native_processes p4_linux_standardio_t (chr_file (getattr open read write)))
(allow p4_linux_native_processes p4_linux_console_t (chr_file (getattr read write)))
(allow p4_linux_native_processes init_t (fd (use)))
(allow p4_linux_native_processes p4_linux_service_executor_t (fd (use)))
(allow p4_linux_native_processes init_t (process (sigchld)))
(allow init_t p4_linux_native_processes (process (getattr signull signal sigkill sigstop getsched)))
(allow p4_linux_native_processes p4_linux_run_t (dir (getattr search)))
(allow p4_linux_native_processes p4_linux_systemd_run_t (dir (getattr search)))
(allow p4_linux_native_processes p4_linux_journal_runtime_t (dir (getattr search)))
(allow p4_linux_native_processes p4_linux_systemd_notify_t (sock_file (write)))
(allow p4_linux_native_processes p4_linux_journal_native_socket_t (sock_file (write)))
(allow p4_linux_native_processes p4_linux_journal_socket_t (sock_file (write)))
(allow p4_linux_native_processes init_t (unix_dgram_socket (read write sendto)))
(allow p4_linux_native_processes init_t (unix_stream_socket (read write)))
(allow p4_linux_native_processes p4_linux_journald_t (unix_stream_socket (connectto read write)))
(allow p4_linux_native_processes labeledfs (filesystem (getattr)))
(allow p4_linux_native_processes tmpfs (filesystem (getattr)))

; Exact native entrypoints. The executor cannot remain in its own role on exec.
(macro p4_ubuntu_system_service ((type subject) (type executable))
    (typetransition p4_linux_service_executor_t executable process subject)
    (allow init_t executable (file (getattr open read execute map)))
    (allow p4_linux_service_executor_t executable (file (getattr open read execute map)))
    (allow p4_linux_service_executor_t subject (process (transition siginh rlimitinh)))
    (allow p4_linux_service_executor_t subject (process2 (nnp_transition)))
    (allow subject executable (file (getattr open read execute map entrypoint)))
    (auditallow p4_linux_service_executor_t subject (process (transition))))
(call p4_ubuntu_system_service (p4_linux_setup_t p4_linux_setup_exec_t))
(call p4_ubuntu_system_service (p4_linux_dbus_t p4_linux_dbus_exec_t))
(call p4_ubuntu_system_service (p4_linux_network_manager_t p4_linux_network_manager_exec_t))
(call p4_ubuntu_system_service (p4_linux_wpa_t p4_linux_wpa_exec_t))
(call p4_ubuntu_system_service (p4_linux_resolved_t p4_linux_resolved_exec_t))
(call p4_ubuntu_system_service (p4_linux_logind_t p4_linux_logind_exec_t))
(call p4_ubuntu_system_service (p4_linux_accounts_t p4_linux_accounts_exec_t))
(call p4_ubuntu_system_service (p4_linux_polkit_t p4_linux_polkit_exec_t))
(call p4_ubuntu_system_service (p4_linux_rtkit_t p4_linux_rtkit_exec_t))
(call p4_ubuntu_system_service (p4_linux_bluetooth_t p4_linux_bluetooth_exec_t))
(call p4_ubuntu_system_service (p4_linux_gdm_t p4_linux_gdm_exec_t))
(call p4_ubuntu_system_service (p4_linux_gdm_worker_t p4_linux_gdm_worker_exec_t))
(call p4_ubuntu_system_service (p4_linux_sshd_t p4_linux_sshd_exec_t))
(call p4_ubuntu_system_service (p4_linux_snapd_t p4_linux_snapd_exec_t))
(call p4_ubuntu_system_service (p4_linux_apparmor_updater_t p4_linux_apparmor_updater_exec_t))
(call p4_ubuntu_system_service (p4_linux_module_loader_t p4_linux_module_loader_exec_t))
(call p4_ubuntu_system_service (p4_linux_sysctl_t p4_linux_sysctl_exec_t))

; Generators are original PID 1 helpers, before a service invocation exists.
(typetransition init_t p4_linux_generator_exec_t process p4_linux_generator_t)
(allow init_t p4_linux_generator_exec_t (file (getattr open read execute map)))
(allow init_t p4_linux_generator_t (process (transition siginh rlimitinh)))
(allow p4_linux_generator_t p4_linux_generator_exec_t (file (getattr open read execute map entrypoint)))
(allow p4_linux_generator_t p4_linux_native_bin_t (file (getattr open read execute execute_no_trans map)))

; user@.service uses the same immutable systemd ELF with a distinct Linux SID.
; Only the system executor reaches this type; its executor has a separate SID.
(typetransition p4_linux_service_executor_t init_exec_t process p4_linux_user_manager_t)
(allow p4_linux_service_executor_t init_exec_t (file (getattr open read execute map)))
(allow p4_linux_service_executor_t p4_linux_user_manager_t (process (transition siginh rlimitinh)))
(allow p4_linux_service_executor_t p4_linux_user_manager_t (process2 (nnp_transition)))
(allow p4_linux_user_manager_t init_exec_t (file (getattr open read execute map entrypoint execute_no_trans)))
(typetransition p4_linux_user_manager_t p4_linux_systemd_executor_t process p4_linux_user_executor_t)
(allow p4_linux_user_manager_t p4_linux_systemd_executor_t (file (getattr open read execute map)))
(allow p4_linux_user_manager_t p4_linux_user_executor_t (process (transition getattr signull signal sigkill siginh rlimitinh)))
(allow p4_linux_user_executor_t p4_linux_systemd_executor_t (file (getattr open read execute map entrypoint)))
(allow p4_linux_user_executor_t p4_linux_user_manager_t (fd (use)))
(allow p4_linux_user_executor_t p4_linux_user_manager_t (process (sigchld)))
(allow p4_linux_user_executor_t p4_linux_user_manager_t (unix_dgram_socket (read write sendto)))
(allow p4_linux_user_executor_t self (process (setexec setcap)))
; The same native LSM exec API used by the production library keeps self
; procattr and process memory writes forbidden for both executor identities.
(neverallow p4_linux_user_executor_t self (file (write append)))
(allow p4_linux_user_executor_t p4_linux_systemd_memfd_t (file (getattr open read write)))
(allow p4_linux_user_executor_t p4_linux_board_selinux_config_t (file (getattr open read)))
(allow p4_linux_user_executor_t p4_linux_apparmor_enabled_t (file (getattr open read)))
(allow p4_linux_user_executor_t selinuxfs (filesystem (getattr)))
(neverallow p4_linux_user_executor_t p4_all_board_owned (file (execute_no_trans)))
(neverallow p4_linux_user_executor_t p4_linux_service_executor_t (process (transition dyntransition ptrace)))
(neverallow p4_linux_user_executor_t p4_linux_mac_roles (process (transition dyntransition ptrace)))

(macro p4_ubuntu_user_service ((type subject) (type executable))
    (typetransition p4_linux_user_executor_t executable process subject)
    (allow p4_linux_user_executor_t executable (file (getattr open read execute map)))
    (allow p4_linux_user_executor_t subject (process (transition siginh rlimitinh)))
    (allow p4_linux_user_executor_t subject (process2 (nnp_transition)))
    (allow subject executable (file (getattr open read execute map entrypoint)))
    (allow subject p4_linux_user_executor_t (fd (use)))
    (allow subject p4_linux_user_manager_t (fd (use)))
    (allow subject p4_linux_user_manager_t (process (sigchld)))
    (allow p4_linux_user_manager_t subject (process (getattr signull signal sigkill sigstop))))
(call p4_ubuntu_user_service (p4_linux_user_dbus_t p4_linux_dbus_exec_t))
(call p4_ubuntu_user_service (p4_linux_user_session_t p4_linux_native_bin_t))
(call p4_ubuntu_user_service (p4_linux_compositor_t p4_linux_compositor_exec_t))
(call p4_ubuntu_user_service (p4_linux_audio_t p4_linux_audio_exec_t))
(call p4_ubuntu_user_service (p4_linux_desktop_portal_t p4_linux_desktop_portal_exec_t))
(call p4_ubuntu_user_service (droidloom_presenter droidloom_presenter_exec))
; An interactive launch of the same measured ELF also receives the isolated
; presenter identity. No user-session-wide Android or broker IPC is granted.
(typetransition p4_linux_user_session_t droidloom_presenter_exec process droidloom_presenter)
(allow p4_linux_user_session_t droidloom_presenter_exec (file (getattr open read execute map)))
(allow p4_linux_user_session_t droidloom_presenter (process (transition siginh rlimitinh)))
(allow p4_linux_user_session_t droidloom_presenter (process2 (nnp_transition)))
(allow droidloom_presenter p4_linux_user_session_t (fd (use)))
(allow droidloom_presenter p4_linux_user_session_t (process (sigchld)))
(neverallow p4_linux_user_session_t droidloom_presenter_exec (file (execute_no_trans)))

; Ordinary shell helpers retain the selected service or session identity.
(allow p4_linux_setup_t p4_linux_native_bin_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_gdm_t p4_linux_native_bin_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_gdm_worker_t p4_linux_native_bin_t (file (getattr open read execute map)))
(allow p4_linux_user_session_t p4_linux_native_bin_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_user_session_t self (process (signal signull sigkill sigstop)))
(typetransition p4_linux_gdm_t p4_linux_gdm_worker_exec_t process p4_linux_gdm_worker_t)
(allow p4_linux_gdm_t p4_linux_gdm_worker_exec_t (file (getattr open read execute map)))
(allow p4_linux_gdm_t p4_linux_gdm_worker_t (process (transition siginh rlimitinh signal signull)))
(allow p4_linux_gdm_worker_t p4_linux_gdm_t (fd (use)))
(typetransition p4_linux_gdm_worker_t p4_linux_native_bin_t process p4_linux_user_session_t)
(typetransition p4_linux_sshd_t p4_linux_native_bin_t process p4_linux_user_session_t)
(allow p4_linux_gdm_worker_t p4_linux_user_session_t (process (transition siginh rlimitinh)))
(allow p4_linux_sshd_t p4_linux_native_bin_t (file (getattr open read execute map)))
(allow p4_linux_sshd_t p4_linux_user_session_t (process (transition siginh rlimitinh)))
(allow p4_linux_user_session_t p4_linux_gdm_worker_t (fd (use)))
(allow p4_linux_user_session_t p4_linux_sshd_t (fd (use)))

