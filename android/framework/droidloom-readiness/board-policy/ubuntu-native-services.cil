(typeattributeset p4_linux_data (p4_linux_user_run_t))
(roletype object_r p4_linux_auth_data_t)
(typeattributeset p4_linux_data (p4_linux_auth_data_t))
(roletype object_r p4_linux_product_store_t)
(typeattributeset p4_linux_data (p4_linux_product_store_t))
(roletype object_r p4_linux_kernel_modules_t)
(typeattributeset p4_linux_data (p4_linux_kernel_modules_t))

(typeattributeset p4_linux_native_public_files (p4_linux_native_data_t p4_linux_native_config_t))
(allow p4_linux_native_processes p4_linux_native_public_files (dir (getattr search open read)))
(allow p4_linux_native_processes p4_linux_native_public_files (file (getattr open read map)))
(allow p4_linux_native_processes p4_linux_native_public_files (lnk_file (getattr read)))
(allow init_t p4_linux_native_public_files (dir (getattr search open read)))
(allow init_t p4_linux_native_public_files (file (getattr open read map)))
(allow init_t p4_linux_native_public_files (lnk_file (getattr read)))
(allow p4_linux_service_executor_t p4_linux_native_public_files (dir (getattr search open read)))
(allow p4_linux_service_executor_t p4_linux_native_public_files (file (getattr open read)))
(allow p4_linux_service_executor_t p4_linux_native_public_files (lnk_file (getattr read)))
(allow p4_linux_native_processes p4_linux_var_lib_t (dir (getattr search)))
(allow p4_linux_native_processes p4_linux_var_cache_t (dir (getattr search)))
(allow p4_linux_native_processes p4_linux_var_spool_t (dir (getattr search)))

; Services prepare only their typed state and runtime subtrees. They receive no
; generic write permission on /usr, /etc, another service, or product storage.
(macro p4_ubuntu_state ((type subject) (type state) (type runtime))
    (roletype object_r state)
    (roletype object_r runtime)
    (typeattributeset p4_linux_native_state (state))
    (typeattributeset p4_linux_native_runtime (runtime))
    (typeattributeset p4_linux_data (state runtime))
    (allow state labeledfs (filesystem (associate)))
    (allow runtime tmpfs (filesystem (associate)))
    (allow subject state (dir (getattr search open read create write add_name remove_name setattr rename reparent rmdir)))
    (allow subject state (file (getattr open read write append create setattr lock map rename unlink)))
    (allow subject state (lnk_file (getattr read create write setattr rename unlink)))
    (allow subject runtime (dir (getattr search open read create write add_name remove_name setattr rename reparent rmdir)))
    (allow subject runtime (file (getattr open read write append create setattr lock map rename unlink)))
    (allow subject runtime (sock_file (getattr create setattr write unlink)))
    (allow subject runtime (fifo_file (getattr create open read write setattr unlink)))
    (typetransition subject state dir state)
    (typetransition subject state file state)
    (typetransition subject runtime dir runtime)
    (typetransition subject runtime file runtime)
    (typetransition subject runtime sock_file runtime))
(type p4_linux_setup_state_t)
(type p4_linux_setup_run_t)
(call p4_ubuntu_state (p4_linux_setup_t p4_linux_setup_state_t p4_linux_setup_run_t))
(type p4_linux_dbus_state_t)
(type p4_linux_dbus_run_t)
(call p4_ubuntu_state (p4_linux_dbus_t p4_linux_dbus_state_t p4_linux_dbus_run_t))
