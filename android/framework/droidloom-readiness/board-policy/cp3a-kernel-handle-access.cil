(allow vendor_init p4_cp3a_handle_objects (dir (getattr relabelfrom relabelto)))
(allow system_server p4_cp3a_handle_objects (dir (ioctl read getattr lock open watch watch_reads search)))
(allow vold p4_cp3a_handle_objects (dir (ioctl read getattr setattr lock relabelfrom open watch watch_reads search)))
(allow init p4_cp3a_handle_objects (dir (ioctl read write create getattr setattr lock relabelfrom relabelto rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow installd p4_cp3a_handle_objects (dir (ioctl read write getattr lock relabelfrom open watch watch_reads add_name remove_name search rmdir)))
(allow derive_classpath p4_cp3a_handle_objects (dir (search)))
(allow kernel p4_cp3a_handle_objects (dir (search)))
(allow vold_prepare_subdirs p4_cp3a_handle_objects (dir (search)))
(allow vendor_init p4_cp3a_handle_objects (file (getattr relabelfrom relabelto)))
(allow system_server p4_cp3a_handle_objects (file (ioctl read getattr lock map open watch watch_reads)))
(allow vold p4_cp3a_handle_objects (file (ioctl read getattr setattr lock relabelfrom map open watch watch_reads)))
(allow installd p4_cp3a_handle_objects (file (ioctl read getattr setattr lock relabelfrom map unlink rename open watch watch_reads)))
(allow init p4_cp3a_handle_objects (file (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink rename open watch watch_reads)))
(allow dex2oat p4_cp3a_handle_objects (file (read map)))
(allow init p4_cp3a_handle_objects (filesystem (mount remount unmount getattr relabelfrom associate quotamod quotaget watch)))
(allow vendor_init p4_cp3a_handle_objects (lnk_file (getattr relabelfrom relabelto)))
(allow installd p4_cp3a_handle_objects (lnk_file (getattr setattr relabelfrom unlink rename)))
(allow init p4_cp3a_handle_objects (lnk_file (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink rename open watch watch_reads)))
(allowx p4_cp3a_handle_ioctl_domains p4_cp3a_handle_objects (ioctl dir (((range 0x5450 0x5451)))))
(allowx vold p4_cp3a_handle_objects (ioctl dir ((0x5879))))
(allowx init p4_cp3a_handle_objects (ioctl dir ((0x6613 0x6615))))
(allowx p4_cp3a_handle_ioctl_domains p4_cp3a_handle_objects (ioctl file (((range 0xf501 0xf502) 0xf505 (range 0xf50c 0xf50e)))))
