; Fixed PM session installation and the source-bound Java catalog.
; Native factory case 5/6 select these roles from closed enums, never a client
; supplied label. The original cmd/app_process bytes and complete argv are
; verified before exec, with the same original PIDFD/TRACEEXEC/waitid owner.
(type droidloom_install)
(type droidloom_catalog_read)
(type droidloom_appops_read)
(type droidloom_account_read)
(roletype r droidloom_install)
(roletype r droidloom_catalog_read)
(roletype r droidloom_appops_read)
(roletype r droidloom_account_read)
(typeattribute p4_additional_application_queries)
(typeattributeset p4_additional_application_queries
 (droidloom_install droidloom_catalog_read droidloom_appops_read droidloom_account_read))
(typeattributeset domain (p4_additional_application_queries))
(typeattributeset coredomain (p4_additional_application_queries))
(typeattributeset p4_fixed_query_processes (p4_additional_application_queries))
(typeattributeset p4_closed_runtime_queries (p4_additional_application_queries))
(typeattributeset p4_closed_cmd_queries (droidloom_install))

; Installation is delegated to original PackageManager. APK bytes arrive on
; the independent query_io-origin input pipe; no Android role receives a
; broker-origin APK descriptor or gains direct application-data writes.
(allow droidloom_install package_service (service_manager (find)))
(allow droidloom_install droidloom_query_io (fifo_file (getattr read write)))
(neverallow droidloom_install activity_service (service_manager (find)))
(neverallow droidloom_install droidloom_provider_exec (file (entrypoint)))

; The normal four-image cohort pins the sole ApplicationCatalog JAR under
; /system/system_ext/framework. It retains its original droidloom_input_bridge_jar label.
; Catalog renders only public package labels/icons and does not contact a
; provider or execute writable code.
(allow droidloom_catalog_read droidloom_provider_exec (file (getattr open read map execute entrypoint)))
(allow droidloom_catalog_read package_service (service_manager (find)))
(allow kernel droidloom_input_bridge_jar (file (getattr open read)))
(allow droidloom_catalog_read droidloom_input_bridge_jar (file (getattr open read map)))
(neverallow droidloom_catalog_read droidloom_input_bridge_jar (file (execute execute_no_trans entrypoint write append create unlink link rename setattr relabelto relabelfrom)))
(allow droidloom_catalog_read dalvik_prop (file (getattr open read map)))
(allow droidloom_catalog_read apk_data_file (file (getattr open read map)))
(neverallow droidloom_catalog_read activity_service (service_manager (find)))
(neverallow droidloom_catalog_read droidloom_query_exec (file (entrypoint)))
(neverallow droidloom_catalog_read droidloom_provider_jar (file (open read map execute entrypoint)))
(neverallow droidloom_catalog_read appdomain (binder (call transfer)))
(neverallow droidloom_catalog_read appdomain (fd (use)))
(neverallow p4_additional_application_queries service_manager_type (service_manager (add)))
(neverallow p4_additional_application_queries property_type (property_service (set)))

; -Xint/-Xusejit:false keeps ART's anonymous bookkeeping nonexecutable.
(type droidloom_catalog_tmpfs)
(roletype object_r droidloom_catalog_tmpfs)
(typeattributeset file_type (droidloom_catalog_tmpfs))
(typeattributeset p4_all_board_owned (droidloom_catalog_tmpfs))
(allow droidloom_catalog_tmpfs tmpfs (filesystem (associate)))
(typetransition droidloom_catalog_read tmpfs file droidloom_catalog_tmpfs)
(typetransition droidloom_catalog_read tmpfs memfd_file droidloom_catalog_tmpfs)
(allow droidloom_catalog_read droidloom_catalog_tmpfs (file (create getattr open read write map)))
(allow droidloom_catalog_read droidloom_catalog_tmpfs (memfd_file (create getattr open read write map)))
(neverallow droidloom_catalog_read self (process (execmem)))
(neverallow droidloom_catalog_read droidloom_catalog_tmpfs (file (execute execute_no_trans entrypoint)))
(neverallow droidloom_catalog_read droidloom_catalog_tmpfs (memfd_file (execute)))

; Fixed native factory case 8: selected-package AppOps modes from the same
; sealed normal InputBridge JAR. Guest UID remains 2000. No shell command,
; account service, historical access log or mutation is exposed by its producer.
(allow droidloom_appops_read droidloom_provider_exec (file (getattr open read map execute entrypoint)))
(allow droidloom_appops_read package_service (service_manager (find)))
(allow droidloom_appops_read appops_service (service_manager (find)))
(allow droidloom_appops_read droidloom_input_bridge_jar (file (getattr open read map)))
(allow droidloom_appops_read dalvik_prop (file (getattr open read map)))
(allow droidloom_appops_read apk_data_file (file (getattr open read map)))
(neverallow droidloom_appops_read activity_service (service_manager (find)))
(neverallow droidloom_appops_read account_service (service_manager (find)))
(neverallow droidloom_appops_read droidloom_query_exec (file (entrypoint)))
(neverallow droidloom_appops_read droidloom_provider_jar (file (open read map execute entrypoint)))
(neverallow droidloom_appops_read droidloom_input_bridge_jar (file (execute execute_no_trans entrypoint write append create unlink link rename setattr relabelto relabelfrom)))
(neverallow droidloom_appops_read appdomain (binder (call transfer)))
(neverallow droidloom_appops_read appdomain (fd (use)))

; Interpreted ART bookkeeping has no executable writable mapping.
(type droidloom_appops_tmpfs)
(roletype object_r droidloom_appops_tmpfs)
(typeattributeset file_type (droidloom_appops_tmpfs))
(typeattributeset p4_all_board_owned (droidloom_appops_tmpfs))
(allow droidloom_appops_tmpfs tmpfs (filesystem (associate)))
(typetransition droidloom_appops_read tmpfs file droidloom_appops_tmpfs)
(typetransition droidloom_appops_read tmpfs memfd_file droidloom_appops_tmpfs)
(allow droidloom_appops_read droidloom_appops_tmpfs (file (create getattr open read write map)))
(allow droidloom_appops_read droidloom_appops_tmpfs (memfd_file (create getattr open read write map)))
(neverallow droidloom_appops_read self (process (execmem)))
(neverallow droidloom_appops_read droidloom_appops_tmpfs (file (execute execute_no_trans entrypoint)))
(neverallow droidloom_appops_read droidloom_appops_tmpfs (memfd_file (execute)))

; Fixed native factory case 9 is an independently admitted system-UID (1000)
; account comparator. Old roles keep UID 2000. It never retries a denied old
; operation and never receives an APK/caller FD, argv key or account selector.
; The separately retired query_io creator supplies its private stdin pipe.
; Account names/types stay inside this Java process and become keyed tokens.
(allow droidloom_account_read droidloom_provider_exec (file (getattr open read map execute entrypoint)))
(allow droidloom_account_read package_service (service_manager (find)))
(allow droidloom_account_read account_service (service_manager (find)))
(allow droidloom_account_read droidloom_query_io (fifo_file (getattr read)))
(allow droidloom_account_read droidloom_input_bridge_jar (file (getattr open read map)))
(allow droidloom_account_read dalvik_prop (file (getattr open read map)))
(allow droidloom_account_read apk_data_file (file (getattr open read map)))
(neverallow droidloom_account_read activity_service (service_manager (find)))
(neverallow droidloom_account_read appops_service (service_manager (find)))
(neverallow droidloom_account_read droidloom_query_exec (file (entrypoint)))
(neverallow droidloom_account_read droidloom_provider_jar (file (open read map execute entrypoint)))
(neverallow droidloom_account_read droidloom_input_bridge_jar (file (execute execute_no_trans entrypoint write append create unlink link rename setattr relabelto relabelfrom)))
(neverallow droidloom_account_read appdomain (binder (call transfer)))
(neverallow droidloom_account_read appdomain (fd (use)))
(type droidloom_account_tmpfs)
(roletype object_r droidloom_account_tmpfs)
(typeattributeset file_type (droidloom_account_tmpfs))
(typeattributeset p4_all_board_owned (droidloom_account_tmpfs))
(allow droidloom_account_tmpfs tmpfs (filesystem (associate)))
(typetransition droidloom_account_read tmpfs file droidloom_account_tmpfs)
(typetransition droidloom_account_read tmpfs memfd_file droidloom_account_tmpfs)
(allow droidloom_account_read droidloom_account_tmpfs (file (create getattr open read write map)))
(allow droidloom_account_read droidloom_account_tmpfs (memfd_file (create getattr open read write map)))
(neverallow droidloom_account_read self (process (execmem)))
(neverallow droidloom_account_read droidloom_account_tmpfs (file (execute execute_no_trans entrypoint)))
(neverallow droidloom_account_read droidloom_account_tmpfs (memfd_file (execute)))
