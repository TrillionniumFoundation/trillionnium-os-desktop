; Fixed original logcat/dumpsys and PackageManager UID diagnostics.
; The factory alone selects this zero-cap Android role, shell UID 2000 and
; log-reader primary GID 1007. No supplementary groups, shell, write command,
; security/kernel buffer or arbitrary Binder service is accepted by source.
(type droidloom_diagnostics_exec)
(roletype object_r droidloom_diagnostics_exec)
(typeattributeset file_type (droidloom_diagnostics_exec))
(typeattributeset exec_type (droidloom_diagnostics_exec))
(typeattributeset system_file_type (droidloom_diagnostics_exec))
(typeattributeset p4_fixed_query_copies (droidloom_diagnostics_exec))
(typeattributeset p4_fixed_metadata_executables (droidloom_diagnostics_exec))
(typeattributeset p4_broker_query_original_files (logcat_exec))
; Whole source bytes are independently pinned; no original logcat inode is changed.
(allow kernel logcat_exec (file (getattr open read)))
(allow kernel droidloom_diagnostics_exec (file (getattr open read execute map)))
(allow droidloom_query_birth droidloom_diagnostics_exec (file (getattr open read execute map)))
(type droidloom_diagnostics_read)
(roletype r droidloom_diagnostics_read)
(typeattributeset domain (droidloom_diagnostics_read))
(typeattributeset coredomain (droidloom_diagnostics_read))
(typeattributeset p4_fixed_query_processes (droidloom_diagnostics_read))
(typeattributeset p4_fixed_metadata_tasks (droidloom_diagnostics_read))
(allow droidloom_query_birth droidloom_diagnostics_read (process (transition)))
(allow droidloom_query_birth droidloom_diagnostics_read (process2 (nnp_transition nosuid_transition)))
(allow kernel droidloom_diagnostics_read (process (getattr ptrace sigkill sigstop)))
(allow droidloom_diagnostics_read droidloom_query_exec (file (getattr open read map execute entrypoint)))
(allow droidloom_diagnostics_read kernel (fd (use)))
(allow droidloom_diagnostics_read kernel (process (sigchld)))
(allow droidloom_diagnostics_read droidloom_query_io (fd (use)))
(allow droidloom_diagnostics_read droidloom_query_io (fifo_file (getattr write)))
(allow droidloom_diagnostics_read null_device (chr_file (getattr read)))
(allow droidloom_diagnostics_read self (process (fork sigchld getcap)))
(allow droidloom_diagnostics_read self (dir (getattr search)))
(allow droidloom_diagnostics_read self (file (getattr open read)))
(allow droidloom_diagnostics_read self (lnk_file (getattr read)))
(allow droidloom_diagnostics_read proc (dir (getattr search)))
(allow droidloom_diagnostics_read proc (lnk_file (getattr read)))
(allow droidloom_diagnostics_read device (dir (getattr search)))
(allow droidloom_diagnostics_read p4_linux_query_mount_t (dir (getattr search)))
(allow droidloom_diagnostics_read droidloom_query_tmpfs_t (dir (getattr search)))
(allow droidloom_diagnostics_read droidloom_query_tmpfs_t (filesystem (getattr)))
(allow droidloom_diagnostics_read labeledfs (filesystem (getattr)))
(allow droidloom_diagnostics_read rootfs (dir (getattr search)))
(allow droidloom_diagnostics_read system_file (dir (getattr search)))
(allow droidloom_diagnostics_read system_lib_file (dir (getattr search)))
(allow droidloom_diagnostics_read system_linker_exec (dir (getattr search)))
(allow droidloom_diagnostics_read apex_mnt_dir (dir (getattr search)))
(allow droidloom_diagnostics_read linkerconfig_file (dir (getattr search)))
(allow droidloom_diagnostics_read rootfs (lnk_file (getattr read)))
(allow droidloom_diagnostics_read system_file (lnk_file (getattr read)))
(allow droidloom_diagnostics_read apex_mnt_dir (lnk_file (getattr read)))
(allow droidloom_diagnostics_read system_file (file (getattr open read map execute)))
(allow droidloom_diagnostics_read system_lib_file (file (getattr open read map execute)))
(allow droidloom_diagnostics_read system_linker_exec (file (getattr open read map execute)))
(allow droidloom_diagnostics_read linkerconfig_file (file (getattr open read map)))
(allow droidloom_diagnostics_read apex_info_file (file (getattr open read)))
(allow droidloom_diagnostics_read properties_device (dir (getattr search)))
(allow droidloom_diagnostics_read properties_serial (file (getattr open read map)))
(allow droidloom_diagnostics_read default_prop (file (getattr open read map)))
(allow droidloom_diagnostics_read exported_default_prop (file (getattr open read map)))
(allow droidloom_diagnostics_read servicemanager_prop (file (getattr open read map)))
(allow droidloom_diagnostics_read binder_device (chr_file (getattr open read write map ioctl)))
(allow droidloom_diagnostics_read servicemanager (binder (call transfer)))
(allow servicemanager droidloom_diagnostics_read (binder (transfer)))
(allow droidloom_diagnostics_read system_server (binder (call transfer)))
(allow system_server droidloom_diagnostics_read (binder (call transfer)))
(allow droidloom_diagnostics_read package_service (service_manager (find)))
(allow droidloom_diagnostics_read activity_service (service_manager (find)))
(typeattribute p4_diagnostics_other_services)
; Original domain defaults retain stats lookup; only the fixed PackageManager
; UID lookup and ActivityManager exit-info service are added here.
(typeattributeset p4_diagnostics_other_services (and (service_manager_type) (not (or (or (package_service) (activity_service)) (binder_stats_consumer_service)))))
(neverallow droidloom_diagnostics_read p4_diagnostics_other_services (service_manager (find)))
(neverallow droidloom_diagnostics_read service_manager_type (service_manager (add)))
(neverallow droidloom_diagnostics_read property_type (property_service (set)))
(neverallow droidloom_diagnostics_read droidloom_provider_exec (file (entrypoint)))
(neverallow droidloom_diagnostics_read apk_data_file (file (open read map write append)))
(neverallow droidloom_diagnostics_read app_data_file (file (open read map write append)))
(neverallow droidloom_diagnostics_read privapp_data_file (file (open read map write append)))
(neverallow droidloom_diagnostics_read system_app_data_file (file (open read map write append)))
(neverallow droidloom_diagnostics_read appdomain (binder (call transfer)))
(neverallow droidloom_diagnostics_read appdomain (fd (use)))
(neverallow droidloom_diagnostics_read p4_linux_data (file (entrypoint execute)))
(neverallow droidloom_diagnostics_read droidloom_query_tmpfs_t (dir (open read write add_name remove_name mounton setattr relabelfrom relabelto)))
(neverallow droidloom_broker droidloom_diagnostics_read (process (transition dyntransition ptrace signal sigkill sigstop)))

(allow droidloom_diagnostics_read droidloom_diagnostics_exec (file (getattr open read map execute entrypoint)))
; liblog opens only /dev/socket/logdr with SOCK_SEQPACKET. The source-owned
; filter denies socketpair/listeners/datagrams/Internet sockets, while AppArmor
; fixes the pathname. Original domain.te write_logd inheritance is preserved
; in SELinux, but has no permitted transport or device path in this intersection.
(allow droidloom_diagnostics_read logdr_socket (sock_file (write)))
(allow droidloom_diagnostics_read logd (unix_stream_socket (connectto)))
(allow droidloom_diagnostics_read logd_prop (file (getattr open read map)))
(allow droidloom_diagnostics_read log_tag_prop (file (getattr open read map)))
; The stock optional second event-tag map remains denied by original logd.te.
(neverallow droidloom_diagnostics_read logd_socket (sock_file (write)))
(neverallow droidloom_diagnostics_read logcat_exec (file (entrypoint execute_no_trans)))
(neverallow droidloom_diagnostics_read misc_logd_file (file (open read map write append create)))
(neverallow droidloom_diagnostics_read runtime_event_log_tags_file (file (open read map write append create unlink link rename setattr relabelfrom relabelto)))
