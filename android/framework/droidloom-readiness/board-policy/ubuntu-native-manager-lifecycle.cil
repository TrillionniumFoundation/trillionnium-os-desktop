(neverallow p4_native_other_shutdown_callers p4_linux_systemd_shutdown_exec_t (file (execute execute_no_trans entrypoint)))
(allow init_t self (capability (kill sys_boot)))
; Policy management, broad DAC bypass and task inspection are independent
; authorities, not prerequisites for normal directed signals or poweroff.
(neverallow init_t self (capability (dac_override dac_read_search sys_ptrace)))
(neverallow init_t self (capability2 (mac_admin mac_override)))
(neverallow init_t kernel (security (load_policy setenforce setbool setsecparam setcheckreqprot read_policy)))

; Stock PID 1 opens the existing native root and configuration directories
; with O_RDONLY|O_DIRECTORY while discovering mounts and startup metadata.
; Their existing label remains immutable; no regular-file authority is added.
(allow init_t p4_linux_rootdir_t (dir (open read)))
(neverallow init_t p4_linux_rootdir_t (dir (create write add_name remove_name setattr rename reparent rmdir relabelfrom relabelto)))

; The fixed native generators parse the same original kernel command line
