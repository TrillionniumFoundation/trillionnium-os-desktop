(allow p4_linux_generator_t proc (dir (search)))
(allow p4_linux_generator_t proc_cmdline (file (getattr open read)))
(neverallow p4_linux_generator_t proc_cmdline (file (create write append unlink link rename setattr relabelfrom relabelto map execute execute_no_trans entrypoint ioctl mounton)))

