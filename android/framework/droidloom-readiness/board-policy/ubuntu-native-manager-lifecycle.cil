(neverallow p4_linux_procs p4_native_credential_unit_dirs (file (create open read write append unlink execute execute_no_trans entrypoint)))
(neverallow p4_linux_procs p4_native_credential_unit_dirs (lnk_file (create read write unlink)))

; Unit retirement unmounts and removes only these known empty unit roots.
; PID 1 never creates, relabels, or populates credential directories.
(allow init_t p4_linux_credentials_root_t (dir (getattr search write remove_name)))
(allow init_t p4_native_credential_unit_dirs (dir (getattr search open read rmdir)))
(neverallow p4_without_native_credential_retire p4_native_credential_unit_dirs (dir (rmdir)))
