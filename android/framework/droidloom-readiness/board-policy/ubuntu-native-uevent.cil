; Normal coldplug relabels only held regular uevent inodes. The six types and
; their Android AV/ioctl/MLS contracts are mechanically derived from the exact
; original policy. They are shared sysfs objects, not Linux-private data.
(type p4_linux_uevent_label_t)
(type p4_linux_uevent_label_exec_t)
(roletype system_r p4_linux_uevent_label_t)
(roletype object_r p4_linux_uevent_label_exec_t)
(typeattributeset p4_linux_procs (p4_linux_uevent_label_t))
(typeattributeset p4_linux_data (p4_linux_uevent_label_exec_t))
(typeattributeset p4_handle_owner (p4_linux_uevent_label_t))
(call p4_ubuntu_system_service (p4_linux_uevent_label_t p4_linux_uevent_label_exec_t))
(allow init_t p4_linux_uevent_label_t (process (getattr signull signal sigkill sigstop)))
(allow p4_linux_uevent_label_t init_t (process (sigchld)))
(allow p4_linux_uevent_label_t self (process (getattr getcap setcap)))
(allow p4_linux_uevent_label_t self (fd (use)))
(allow p4_linux_uevent_label_t p4_linux_service_executor_t (fd (use)))
; The original executor hands off an O_RDWR stdout/stderr stream. Exec checks
; both inherited access modes. There is no socket/path creation or connection.
(allow p4_linux_uevent_label_t p4_linux_service_executor_t (unix_stream_socket (getattr read write)))
; The executor also supplies /dev/null when no journal stream is available.
; Preserve these inherited standard descriptors across secure exec without
; allowing the helper to open devices or disable secure execution.
(allow p4_linux_uevent_label_t p4_linux_standardio_t (chr_file (read write)))

(allow p4_linux_uevent_label_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_uevent_label_t p4_linux_etc_dir_t (dir (getattr search)))
(allow p4_linux_uevent_label_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_uevent_label_t p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_uevent_label_t p4_linux_host_config_t (file (getattr open read)))
(allow p4_linux_uevent_label_t p4_linux_usrmerge_link_t (lnk_file (getattr read)))
; Only self-constructed /proc/self/fd/N links resolve an already held O_PATH
; descriptor for the kernel xattrat pathname branch. No proc file body is read.
(allow p4_linux_uevent_label_t proc (dir (getattr search)))
(allow p4_linux_uevent_label_t proc (lnk_file (getattr read)))
(allow p4_linux_uevent_label_t self (dir (getattr search)))
(allow p4_linux_uevent_label_t self (lnk_file (getattr read)))
(allow p4_linux_uevent_label_t p4_linux_run_t (dir (getattr search)))
(allow p4_linux_uevent_label_t p4_linux_early_handoff_dir_t (dir (getattr search)))
(allowx p4_linux_uevent_label_t p4_kernel_ns_handle_t (ioctl file (0xb703)))
(neverallowx p4_linux_uevent_label_t p4_kernel_ns_handle_t (ioctl file (not (0xb703))))

; The helper walks the original writable sysfs mount but opens directories
; only. The Rust map, fixed roots and exact basename bind all relabel requests.
(allow p4_linux_uevent_label_t sysfs (filesystem (getattr)))
(allow p4_linux_uevent_label_t sysfs_type (dir (getattr search open read)))
(allow p4_linux_uevent_label_t sysfs_type (file (getattr)))
(allow p4_linux_uevent_label_t sysfs_type (lnk_file (getattr)))
(allow p4_linux_uevent_label_t p4_native_uevent_sources (file (relabelfrom)))
(allow p4_linux_uevent_label_t p4_native_uevent_objects (file (getattr relabelfrom relabelto)))
; Normal udev triggers only the checked aliases. Generic sysfs writes stay
; forbidden. All existing native readers are derived from the current link.
(allow p4_linux_udev_t p4_native_uevent_objects (file (getattr open read write)))

(typeattribute p4_uevent_all_types)
(typeattributeset p4_uevent_all_types (all))
(typeattribute p4_uevent_not_helper)
(typeattributeset p4_uevent_not_helper (and (p4_linux_procs) (not (p4_linux_uevent_label_t))))
(typeattribute p4_uevent_not_executor)
(typeattributeset p4_uevent_not_executor (not (p4_linux_service_executor_t)))
(typeattribute p4_uevent_not_writer)
(typeattributeset p4_uevent_not_writer (and (p4_linux_procs) (not (p4_linux_udev_t))))
(typeattribute p4_uevent_not_objects)
(typeattributeset p4_uevent_not_objects (and (all) (not (p4_native_uevent_objects))))
(typeattribute p4_uevent_not_relabel_sources)
(typeattributeset p4_uevent_not_relabel_sources (and (all) (not (or (p4_native_uevent_sources) (p4_native_uevent_objects)))))
(typeattribute p4_uevent_nonboard_not_sources)
(typeattributeset p4_uevent_nonboard_not_sources (and (p4_all_nonboard) (not (p4_native_uevent_sources))))
(typeattribute p4_uevent_nonboard_not_directories)
(typeattributeset p4_uevent_nonboard_not_directories (and (p4_all_nonboard) (not (or (sysfs_type) (proc)))))
(typeattribute p4_uevent_nonboard_not_sysfs)
(typeattributeset p4_uevent_nonboard_not_sysfs (and (p4_all_nonboard) (not (sysfs_type))))
(typeattribute p4_uevent_foreign_proc_roles)
(typeattributeset p4_uevent_foreign_proc_roles (and (or (p4_linux_procs) (or (domain) (kernel))) (not (p4_linux_uevent_label_t))))

(neverallow p4_uevent_not_executor p4_linux_uevent_label_t (process (transition dyntransition)))
(neverallow p4_linux_procs p4_linux_uevent_label_exec_t (file (create write append setattr unlink link rename relabelfrom relabelto execute_no_trans)))
(neverallow p4_uevent_not_writer p4_native_uevent_objects (file (write)))
(neverallow p4_uevent_not_helper p4_native_uevent_objects (file (relabelfrom relabelto)))
(neverallow p4_linux_procs p4_native_uevent_objects (file (append create setattr unlink link rename map execute execute_no_trans entrypoint mounton)))
(neverallow p4_linux_procs p4_native_uevent_objects (dir (create write add_name remove_name rmdir setattr mounton relabelfrom relabelto)))
(neverallow p4_linux_uevent_label_t p4_uevent_not_objects (file (relabelto)))
(neverallow p4_linux_uevent_label_t p4_uevent_not_relabel_sources (file (relabelfrom)))
(neverallow p4_linux_uevent_label_t p4_uevent_all_types (dir (create write add_name remove_name rmdir setattr mounton relabelfrom relabelto)))
(neverallow p4_linux_uevent_label_t p4_uevent_all_types (file (create write append setattr unlink link rename execute_no_trans)))
(neverallow p4_linux_uevent_label_t sysfs_type (file (open read ioctl map execute entrypoint)))
(neverallow p4_linux_uevent_label_t p4_native_uevent_objects (file (open read ioctl map execute entrypoint)))
(neverallow p4_linux_uevent_label_t p4_uevent_nonboard_not_directories (dir (search)))
(neverallow p4_linux_uevent_label_t p4_uevent_nonboard_not_sysfs (dir (open read)))
(neverallow p4_linux_uevent_label_t p4_uevent_foreign_proc_roles (dir (getattr open read search)))
(neverallow p4_linux_uevent_label_t p4_uevent_foreign_proc_roles (file (getattr open read)))
(neverallow p4_linux_uevent_label_t p4_uevent_foreign_proc_roles (lnk_file (getattr read)))
(neverallow p4_linux_uevent_label_t self (file (open read)))
(neverallow p4_linux_uevent_label_t proc (file (open read)))
(neverallow p4_linux_uevent_label_t p4_uevent_all_types (unix_stream_socket (create connect connectto bind listen accept)))
(neverallow p4_linux_uevent_label_t p4_uevent_all_types (unix_dgram_socket (create connect bind sendto)))
(neverallow p4_linux_uevent_label_t self (process (fork dyntransition setexec setcurrent setfscreate setsockcreate setkeycreate)))
(neverallow p4_linux_uevent_label_t self (capability (all)))
(neverallow p4_linux_uevent_label_t self (capability2 (all)))
(neverallow p4_linux_uevent_label_t self (cap_userns (all)))
(neverallow p4_linux_uevent_label_t self (cap2_userns (all)))
(neverallow p4_linux_uevent_label_t kernel (security (load_policy setenforce setbool setsecparam setcheckreqprot read_policy)))
