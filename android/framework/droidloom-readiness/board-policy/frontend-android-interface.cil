; The input adapter is a platform Java/Binder service in system_ext.
; Its dedicated domain is entered only by the selected Android init service.
; It is neither a Linux role nor a generic app/shell/vendor exception.
(type droidloom_input_bridge)
(type droidloom_task_launcher)
(roletype r droidloom_input_bridge)
(roletype r droidloom_task_launcher)
(typeattributeset domain (droidloom_input_bridge droidloom_task_launcher))
(typeattributeset coredomain (droidloom_input_bridge droidloom_task_launcher))
(type droidloom_input_bridge_exec)
(type droidloom_input_bridge_jar)
(type droidloom_task_launcher_exec)
(roletype object_r droidloom_input_bridge_exec)
(roletype object_r droidloom_input_bridge_jar)
(roletype object_r droidloom_task_launcher_exec)
(typeattributeset file_type (droidloom_input_bridge_exec droidloom_input_bridge_jar droidloom_task_launcher_exec))
(typeattributeset exec_type (droidloom_input_bridge_exec droidloom_task_launcher_exec))
(typeattributeset system_file_type (droidloom_input_bridge_exec droidloom_input_bridge_jar droidloom_task_launcher_exec))

; init uses the fixed app_process64 command and fixed CLASSPATH in its selected
; read-only RC. No blanket transition on zygote_exec is installed.
(allow init droidloom_input_bridge (process (transition)))
(allow droidloom_input_bridge zygote_exec (file (getattr open read map execute entrypoint execute_no_trans)))
(allow droidloom_input_bridge init (process (sigchld)))
(allow droidloom_input_bridge self (process (fork execmem)))
(allow droidloom_input_bridge droidloom_input_bridge_jar (file (getattr open read map)))
(neverallow droidloom_input_bridge droidloom_input_bridge_jar (file (write append create unlink link rename setattr relabelto relabelfrom execute execute_no_trans)))

; Only this selected adapter may invoke its platform task helper.
(typetransition droidloom_input_bridge droidloom_task_launcher_exec process droidloom_task_launcher)
(allow droidloom_input_bridge droidloom_task_launcher (process (transition signal sigkill sigchld)))
(allow droidloom_task_launcher droidloom_input_bridge (process (sigchld)))
(allow droidloom_input_bridge droidloom_task_launcher_exec (file (getattr open read map execute)))
(allow droidloom_task_launcher droidloom_task_launcher_exec (file (getattr open read map execute entrypoint)))
(allow droidloom_task_launcher droidloom_input_bridge (fd (use)))
(allow droidloom_task_launcher droidloom_input_bridge (fifo_file (read write getattr)))
(allow droidloom_task_launcher shell_exec (file (getattr open read map execute execute_no_trans)))
(allow droidloom_task_launcher system_file (file (getattr open read map execute execute_no_trans)))
(allow droidloom_task_launcher self (process (fork)))
; Task helper uses Android's existing activity command and task-control ABI.
(allow droidloom_task_launcher activity_service (service_manager (find)))
(allow droidloom_task_launcher activity_task_service (service_manager (find)))

; The adapter observes tasks, resolves the installed SystemUI/IME UID, and routes
; input through the existing platform services. It cannot publish a service.
(typeattribute droidloom_frontend_android_platform_clients)
(typeattributeset droidloom_frontend_android_platform_clients (droidloom_input_bridge droidloom_task_launcher))
(allow droidloom_frontend_android_platform_clients binder_device (chr_file (getattr open read write map ioctl)))
(allow droidloom_frontend_android_platform_clients servicemanager (binder (call transfer)))
(allow servicemanager droidloom_frontend_android_platform_clients (binder (transfer)))
(allow droidloom_frontend_android_platform_clients system_server (binder (call transfer)))
(allow system_server droidloom_input_bridge (binder (call transfer)))
(allow droidloom_input_bridge activity_task_service (service_manager (find)))
(allow droidloom_input_bridge package_service (service_manager (find)))
(allow droidloom_input_bridge inputflinger_service (service_manager (find)))
(allow droidloom_input_bridge surfaceflinger_service (service_manager (find)))
(allow droidloom_input_bridge inputflinger (binder (call transfer)))
(allow droidloom_input_bridge surfaceflinger (binder (call transfer)))
(allow droidloom_frontend_android_platform_clients servicemanager_prop (file (getattr open read map)))

; The core/vendor boundary is the selected Composer's frozen Binder extension.
; Only the two exact core roles may obtain its already-opened record channel.
; No new pathname socket connection crosses the Treble boundary.
(typeattributeset halclientdomain (droidloom_input_bridge droidloom_task_launcher))
(typeattributeset hal_graphics_composer_client (droidloom_input_bridge droidloom_task_launcher))
(allow droidloom_frontend_android_platform_clients hal_graphics_composer_service (service_manager (find)))
(allow droidloom_frontend_android_platform_clients hal_graphics_composer_default (binder (call transfer)))
(allow hal_graphics_composer_default droidloom_frontend_android_platform_clients (binder (transfer)))
(allow droidloom_frontend_android_platform_clients hal_graphics_composer_default (fd (use)))
(allow hal_graphics_composer_default droidloom_frontend_android_platform_clients (fd (use)))
; The proof channel is metadata-only on the receiver: no read/write permission.
(allow hal_graphics_composer_default droidloom_frontend_android_platform_clients (unix_stream_socket (getattr getopt)))
(allow droidloom_task_launcher self (unix_stream_socket (create read write getattr getopt shutdown)))
; Only the selected role's own unnamed socketpair can supply its proof label.
(neverallow droidloom_frontend_android_platform_clients self (process (setsockcreate)))
(typeattribute droidloom_other_proof_creators)
(typeattributeset droidloom_other_proof_creators (and (domain) (not (or (init) (or (kernel) (or (droidloom_input_bridge) (droidloom_task_launcher)))))))
(neverallow droidloom_other_proof_creators droidloom_frontend_android_platform_clients (unix_stream_socket (create)))
(allow droidloom_frontend_android_platform_clients hal_graphics_composer_default (unix_stream_socket (read write getattr getopt shutdown)))
(allow droidloom_input_bridge init (fd (use)))
(allow droidloom_input_bridge self (unix_stream_socket (create bind listen accept connect read write getattr getopt setopt shutdown)))
(allow system_app droidloom_input_bridge (unix_stream_socket (connectto)))
(allow platform_app droidloom_input_bridge (unix_stream_socket (connectto)))

; Fixed Linux-owned filesystem socket types. These are not generic runtime data.
(type droidloom_frontend_dir)
(type droidloom_frontend_android_dir)
(type droidloom_frontend_mount)
(type droidloom_frontend_control_socket)
(type droidloom_frontend_denial_socket)
(type droidloom_frontend_stream_socket)
(roletype object_r droidloom_frontend_dir)
(roletype object_r droidloom_frontend_android_dir)
(roletype object_r droidloom_frontend_mount)
(roletype object_r droidloom_frontend_control_socket)
(roletype object_r droidloom_frontend_denial_socket)
(roletype object_r droidloom_frontend_stream_socket)
(typeattributeset p4_linux_data (droidloom_frontend_dir droidloom_frontend_android_dir droidloom_frontend_mount droidloom_frontend_control_socket droidloom_frontend_denial_socket droidloom_frontend_stream_socket))
(allow droidloom_frontend_dir tmpfs (filesystem (associate)))
(allow droidloom_frontend_android_dir tmpfs (filesystem (associate)))
(allow droidloom_frontend_mount tmpfs (filesystem (associate)))
(allow droidloom_frontend_control_socket tmpfs (filesystem (associate)))
(allow droidloom_frontend_denial_socket tmpfs (filesystem (associate)))
(allow droidloom_frontend_stream_socket tmpfs (filesystem (associate)))
(typetransition droidloom_broker p4_linux_run_t dir "droidloom-frontend" droidloom_frontend_dir)
(typetransition droidloom_broker droidloom_frontend_dir sock_file droidloom_frontend_control_socket)
(typetransition droidloom_broker droidloom_frontend_android_dir sock_file "denial" droidloom_frontend_denial_socket)
(typetransition droidloom_broker droidloom_frontend_android_dir sock_file "clipboard" droidloom_frontend_stream_socket)
(typetransition droidloom_broker droidloom_frontend_android_dir sock_file "text-input" droidloom_frontend_stream_socket)
(typetransition droidloom_broker droidloom_frontend_android_dir sock_file "notifications" droidloom_frontend_stream_socket)
(allow droidloom_broker p4_linux_run_t (dir (write add_name remove_name)))
(allow droidloom_broker droidloom_frontend_dir (dir (create getattr open search read write add_name remove_name rmdir setattr)))
(typetransition droidloom_broker droidloom_frontend_dir dir "android" droidloom_frontend_android_dir)
(typetransition droidloom_broker p4_linux_private_socket_parent_t dir "droidloom-frontend" droidloom_frontend_mount)
(allow droidloom_broker droidloom_frontend_android_dir (dir (create getattr open search read write add_name remove_name rmdir setattr)))
(allow droidloom_broker droidloom_frontend_mount (dir (create open getattr read search setattr mounton)))
(neverallow droidloom_broker droidloom_frontend_mount (dir (relabelfrom relabelto)))
(neverallow p4_android_userspace droidloom_frontend_mount (dir (relabelfrom relabelto mounton write add_name remove_name)))
(allow droidloom_broker droidloom_frontend_control_socket (sock_file (create getattr setattr unlink)))
(allow droidloom_broker droidloom_frontend_denial_socket (sock_file (create getattr setattr unlink)))
(allow droidloom_broker droidloom_frontend_stream_socket (sock_file (create getattr setattr unlink)))
(allow droidloom_broker self (unix_stream_socket (create bind listen accept read write getattr getopt shutdown)))
(allow hal_graphics_composer_default droidloom_frontend_android_dir (dir (search)))
(allow droidloom_input_bridge droidloom_frontend_android_dir (dir (search)))
(allow hal_graphics_composer_default droidloom_frontend_denial_socket (sock_file (write)))
(allow droidloom_input_bridge droidloom_frontend_stream_socket (sock_file (getattr write)))
(allow hal_graphics_composer_default droidloom_broker (unix_stream_socket (connectto)))
(allow droidloom_input_bridge droidloom_broker (unix_stream_socket (connectto)))

; Neither adapter can manage Linux, relabel objects, or modify/read other Linux
; files. Original board assertions also reject Binder and inherited Linux FDs.
(neverallow droidloom_frontend_android_platform_clients p4_linux_procs (process (transition dyntransition ptrace signal setexec setcurrent)))
(neverallow droidloom_frontend_android_platform_clients p4_linux_procs (binder (call transfer impersonate)))
(neverallow droidloom_frontend_android_platform_clients p4_linux_procs (fd (use)))
(neverallow droidloom_frontend_android_platform_clients kernel (security (load_policy setenforce setbool setsecparam)))
(neverallow droidloom_frontend_android_platform_clients self (capability (sys_admin sys_ptrace dac_override dac_read_search)))
(neverallow droidloom_frontend_android_platform_clients service_manager_type (service_manager (add)))
(neverallow droidloom_input_bridge droidloom_frontend_control_socket (sock_file (write)))
(neverallow droidloom_task_launcher droidloom_frontend_stream_socket (sock_file (write)))
(neverallow droidloom_frontend_android_platform_clients p4_linux_readiness_dir_t (dir (read open write add_name remove_name relabelfrom relabelto)))

(neverallow droidloom_frontend_android_platform_clients self (capability2 (mac_admin)))

(neverallow p4_android_userspace droidloom_frontend_android_dir (dir (read open write add_name remove_name mounton relabelfrom relabelto)))
