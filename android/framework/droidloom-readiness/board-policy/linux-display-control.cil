(neverallow droidloom_display_control droidloom_query_tmpfs_t (dir (open read write add_name remove_name mounton setattr relabelfrom relabelto)))
(neverallow droidloom_broker droidloom_display_control (process (transition dyntransition ptrace signal sigkill sigstop)))
