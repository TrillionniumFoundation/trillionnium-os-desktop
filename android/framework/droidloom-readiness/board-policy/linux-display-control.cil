; Fixed stock cmd window density control for the original early owner.
; Only the factory selects this literal pending role; public callers supply an
; integer, not argv, an executable, a display identifier or a process identity.
(type droidloom_display_control)
(roletype r droidloom_display_control)
(typeattributeset domain (droidloom_display_control))
(typeattributeset coredomain (droidloom_display_control))
(typeattributeset p4_fixed_query_processes (droidloom_display_control))
(typeattributeset p4_fixed_metadata_tasks (droidloom_display_control))
(allow droidloom_query_birth droidloom_display_control (process (transition)))
(allow droidloom_query_birth droidloom_display_control (process2 (nnp_transition nosuid_transition)))
(allow kernel droidloom_display_control (process (getattr ptrace sigkill sigstop)))
(allow droidloom_display_control droidloom_query_exec (file (getattr open read map execute entrypoint)))
(allow droidloom_display_control kernel (fd (use)))
(allow droidloom_display_control kernel (process (sigchld)))
(allow droidloom_display_control droidloom_query_io (fd (use)))
(allow droidloom_display_control droidloom_query_io (fifo_file (getattr write)))
(allow droidloom_display_control null_device (chr_file (getattr read)))
(allow droidloom_display_control self (process (fork sigchld getcap)))
(allow droidloom_display_control self (dir (getattr search)))
(allow droidloom_display_control self (file (getattr open read)))
(allow droidloom_display_control self (lnk_file (getattr read)))
(allow droidloom_display_control proc (dir (getattr search)))
(allow droidloom_display_control proc (lnk_file (getattr read)))
(allow droidloom_display_control device (dir (getattr search)))
(allow droidloom_display_control p4_linux_query_mount_t (dir (getattr search)))
(allow droidloom_display_control droidloom_query_tmpfs_t (dir (getattr search)))
(allow droidloom_display_control droidloom_query_tmpfs_t (filesystem (getattr)))
(allow droidloom_display_control labeledfs (filesystem (getattr)))
(allow droidloom_display_control rootfs (dir (getattr search)))
(allow droidloom_display_control system_file (dir (getattr search)))
(allow droidloom_display_control system_lib_file (dir (getattr search)))
