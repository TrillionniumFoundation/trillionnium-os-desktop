(allow droidloom_display_control linkerconfig_file (file (getattr open read map)))
(allow droidloom_display_control apex_info_file (file (getattr open read)))
(allow droidloom_display_control properties_device (dir (getattr search)))
(allow droidloom_display_control properties_serial (file (getattr open read map)))
(allow droidloom_display_control default_prop (file (getattr open read map)))
(allow droidloom_display_control exported_default_prop (file (getattr open read map)))
(allow droidloom_display_control servicemanager_prop (file (getattr open read map)))
