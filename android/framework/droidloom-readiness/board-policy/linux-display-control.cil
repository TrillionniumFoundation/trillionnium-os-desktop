(allow system_server droidloom_display_control (binder (call transfer)))
(allow droidloom_display_control window_service (service_manager (find)))
(typeattribute p4_display_other_services)
; Original domain.te:368 grants every applicable Android domain stats lookup.
; Preserve that inherited rule; this component adds only window lookup.
(typeattributeset p4_display_other_services (and (service_manager_type) (not (or (window_service) (binder_stats_consumer_service)))))
(neverallow droidloom_display_control p4_display_other_services (service_manager (find)))
(neverallow droidloom_display_control service_manager_type (service_manager (add)))
(neverallow droidloom_display_control property_type (property_service (set)))
(neverallow droidloom_display_control droidloom_provider_exec (file (entrypoint)))
