
; The kernel supports SELinux labels on kernfs cgroups. Existing Android
; labeling defaults and all original neverallows stay in the joined policy.
(policycap cgroup_seclabel)
(typeattribute p4_cgroup_original_types)
(typeattributeset p4_cgroup_original_types (cgroup cgroup_v2 cgroup_app))
(typeattribute p4_non_kernel_cgroup_actor)
(typeattributeset p4_non_kernel_cgroup_actor (not (kernel)))
(neverallow p4_non_kernel_cgroup_actor p4_cgroup_original_types (dir (relabelfrom relabelto)))
(neverallow p4_non_kernel_cgroup_actor p4_cgroup_original_types (file (relabelfrom relabelto)))
(neverallow p4_non_kernel_cgroup_actor p4_cgroup_original_types (lnk_file (relabelfrom relabelto)))
(type p4_linux_cgroup_root_t)
(type p4_linux_cgroup_init_scope_t)
(type p4_linux_cgroup_init_tasks_t)
(roletype object_r p4_linux_cgroup_root_t)
(roletype object_r p4_linux_cgroup_init_scope_t)
(roletype object_r p4_linux_cgroup_init_tasks_t)
(typeattribute p4_linux_init_cgroup_inodes)
(typeattributeset p4_linux_init_cgroup_inodes (p4_linux_cgroup_root_t p4_linux_cgroup_init_scope_t p4_linux_cgroup_init_tasks_t))
(typeattributeset p4_linux_data (p4_linux_init_cgroup_inodes))
(allow kernel cgroup_v2 (dir (relabelfrom getattr)))
(allow kernel cgroup_v2 (file (relabelfrom getattr)))
(allow kernel p4_linux_cgroup_root_t (dir (getattr relabelto)))
(allow kernel p4_linux_cgroup_init_scope_t (dir (getattr relabelto)))
(allow kernel p4_linux_cgroup_init_tasks_t (file (getattr relabelto)))
(allow p4_linux_init_cgroup_inodes cgroup_v2 (filesystem (associate)))
(allow init_t p4_linux_cgroup_root_t (dir (getattr search)))
(allow init_t p4_linux_cgroup_init_scope_t (dir (getattr search)))
(allow init_t p4_linux_cgroup_init_tasks_t (file (getattr open write)))
(neverallow p4_non_kernel_cgroup_actor p4_linux_init_cgroup_inodes (dir (relabelfrom relabelto mounton)))
(neverallow p4_non_kernel_cgroup_actor p4_linux_init_cgroup_inodes (file (relabelfrom relabelto mounton)))


; This file contains only the names of controllers supported at the real root.
(type p4_linux_cgroup_controller_list_t)
(roletype object_r p4_linux_cgroup_controller_list_t)
(typeattributeset p4_linux_init_cgroup_inodes (p4_linux_cgroup_controller_list_t))
(allow kernel p4_linux_cgroup_controller_list_t (file (getattr relabelto)))
(allow init_t p4_linux_cgroup_controller_list_t (file (getattr open read)))
(neverallow p4_non_kernel_cgroup_actor p4_linux_cgroup_controller_list_t (file (write append setattr)))
