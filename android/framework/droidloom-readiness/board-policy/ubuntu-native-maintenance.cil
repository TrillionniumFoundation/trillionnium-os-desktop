(allow p4_linux_user_session_t p4_linux_sudo_t (process (getattr signull signal sigkill sigstop)))

; Stock sudo-rs changes the selected credentials and owns its original
; monitor/child. These capabilities do not authorize any executable target.
(allow p4_linux_sudo_t self (capability (chown fowner setuid setgid kill audit_write)))
(allow p4_linux_sudo_t self (process (setpgid getpgid setrlimit getrlimit signal signull sigkill sigstop)))
(allow p4_linux_sudo_t p4_linux_auth_data_t (file (getattr open read)))
(allow p4_linux_sudo_t p4_linux_run_t (dir (write add_name)))
(typetransition p4_linux_sudo_t p4_linux_run_t dir "sudo-rs" p4_linux_sudo_run_t)
(typetransition p4_linux_sudo_t p4_linux_sudo_run_t dir p4_linux_sudo_run_t)
(typetransition p4_linux_sudo_t p4_linux_sudo_run_t file p4_linux_sudo_run_t)
(allow p4_linux_sudo_t p4_linux_sudo_run_t (dir (create getattr search open read write add_name remove_name setattr rmdir)))
(allow p4_linux_sudo_t p4_linux_sudo_run_t (file (create getattr open read write lock setattr unlink)))
(allow p4_linux_sudo_t self (netlink_audit_socket (create read write nlmsg)))
(allowx p4_linux_sudo_t self (nlmsg netlink_audit_socket (0x44c 0x44d 0x44f 0x450 0x451 0x452 0x454 0x455 0x456)))
(neverallowx p4_linux_sudo_t self (nlmsg netlink_audit_socket (not (0x44c 0x44d 0x44f 0x450 0x451 0x452 0x454 0x455 0x456))))
(neverallow p4_linux_sudo_t self (netlink_audit_socket (not (create read write nlmsg))))
; The unchanged use_pty implementation owns only its newly allocated slave.
(typetransition p4_linux_sudo_t devpts chr_file p4_linux_sudo_pty_t)
(allow p4_linux_sudo_t devpts (dir (getattr search open read)))
(allow p4_linux_sudo_t devpts (chr_file (getattr open read write ioctl)))
(allow p4_linux_sudo_t p4_linux_sudo_pty_t (chr_file (create getattr open read write ioctl setattr)))
(allowx p4_linux_sudo_t devpts (ioctl chr_file (0x5401 0x5402 0x5403 0x5404 0x540e 0x540f 0x5410 0x5413 0x5414 0x541b 0x5430 0x5431 0x5441)))
(allowx p4_linux_sudo_t p4_linux_sudo_pty_t (ioctl chr_file (0x5401 0x5402 0x5403 0x5404 0x540e 0x540f 0x5410 0x5413 0x5414 0x541b 0x5430 0x5431 0x5441)))

(typetransition p4_linux_sudo_t p4_linux_maintenance_exec_t process p4_linux_maintenance_t)
(allow p4_linux_sudo_t p4_linux_maintenance_exec_t (file (getattr open read execute map)))
