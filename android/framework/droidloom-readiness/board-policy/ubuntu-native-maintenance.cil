; Preserve the stock manager's exact immutable unit load. Only this dedicated
; target can be started by the fixed orderly rollback command.
(allow init_t p4_linux_maintenance_reboot_unit_t (file (getattr open read map)))
(neverallow p4_linux_maintenance_t p4_maintenance_status_units (service (stop reload kill load enable disable)))
(neverallow p4_linux_maintenance_t p4_native_dbus_all_types (dbus (acquire_svc)))

; journalctl's existing executor transition is a flush-only client and remains
; unchanged. Only this fixed parent can create the distinct read-only reader.
(typetransition p4_linux_maintenance_t p4_linux_journalctl_exec_t process p4_linux_maintenance_journal_t)
(allow p4_linux_maintenance_t p4_linux_journalctl_exec_t (file (getattr open read execute map)))
