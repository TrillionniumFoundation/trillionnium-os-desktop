; Stock sudo authenticates against the unchanged Ubuntu sudoers/PAM stack.
; Automatic SELinux transitions, not sudo-rs RBAC support, select the fixed
; maintenance entry. No generic privileged shell or live package writer exists.
(type p4_linux_sudo_t)
(type p4_linux_sudo_exec_t)
(type p4_linux_sudo_run_t)
(type p4_linux_sudo_pty_t)
(type p4_linux_maintenance_t)
