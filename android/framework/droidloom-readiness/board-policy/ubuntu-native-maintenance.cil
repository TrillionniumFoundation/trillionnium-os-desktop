(allow p4_linux_maintenance_t devpts (chr_file (getattr write)))
; The parent remains root. Only its fixed user-manager query subprocess drops
; irreversibly to native UID/GID 1000; KILL retires that original child on timeout.
(allow p4_linux_maintenance_t self (capability (setuid setgid kill)))
(allow p4_linux_maintenance_t self (process (getpgid setpgid signal signull sigkill)))
(allow p4_linux_maintenance_t p4_linux_maintenance_script_t (file (getattr open read)))
(allow p4_linux_maintenance_t p4_linux_native_bin_t (file (getattr open read execute execute_no_trans map)))
