(allow p4_linux_maintenance_t p4_linux_user_manager_t (unix_stream_socket (connectto)))
(allow p4_linux_maintenance_t p4_linux_user_dbus_t (dbus (send_msg)))
(allow p4_linux_maintenance_t p4_linux_user_manager_t (dbus (send_msg)))
(allow p4_linux_user_manager_t p4_linux_maintenance_t (dbus (send_msg)))
