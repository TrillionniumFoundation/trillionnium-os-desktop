(allow p4_linux_maintenance_t p4_linux_sudo_t (unix_stream_socket (getattr read write)))
(allow p4_linux_maintenance_t p4_linux_user_session_t (fd (use)))
(allow p4_linux_maintenance_t p4_linux_user_session_t (fifo_file (getattr read write)))
(allow p4_linux_maintenance_t p4_linux_sshd_t (fd (use)))
