(neverallow p4_linux_maintenance_t p4_linux_maintenance_grubenv_t (file (create append setattr unlink rename link execute execute_no_trans entrypoint relabelto relabelfrom)))

; System and user-manager status use the original manager connection.
; No bus name ownership or other native-service peer is added.
(allow p4_linux_maintenance_t droidloom_manager_private_socket (sock_file (getattr write)))
(allow p4_linux_maintenance_t init_t (unix_stream_socket (connectto)))
(allow init_t p4_linux_maintenance_t (unix_stream_socket (getattr read write)))
(allow p4_linux_maintenance_t p4_linux_user_run_t (dir (getattr search)))
