(type p4_linux_maintenance_state_t)
(type p4_linux_maintenance_grubenv_t)
(type p4_linux_maintenance_grubcfg_t)
(type p4_linux_maintenance_reboot_unit_t)
(type p4_linux_maintenance_journal_t)
