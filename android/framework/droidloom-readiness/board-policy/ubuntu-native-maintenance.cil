(allow p4_linux_maintenance_journal_t p4_linux_journalctl_exec_t (file (getattr open read execute map entrypoint)))
(allow p4_linux_maintenance_journal_t p4_linux_maintenance_t (process (sigchld)))
(allow p4_linux_maintenance_journal_t p4_linux_maintenance_t (fd (use)))
(allow p4_linux_maintenance_journal_t p4_linux_maintenance_t (fifo_file (getattr read write)))
(allow p4_linux_maintenance_journal_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_maintenance_journal_t p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_maintenance_journal_t p4_linux_public_accounts_t (file (getattr open read)))
(allow p4_linux_maintenance_journal_t p4_linux_machine_id_t (file (getattr open read)))
(allow p4_linux_maintenance_journal_t p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_linux_maintenance_journal_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_maintenance_journal_t p4_linux_etc_dir_t (dir (getattr search)))
(allow p4_linux_maintenance_journal_t p4_linux_run_t (dir (getattr search)))
(allow p4_linux_maintenance_journal_t p4_linux_log_root_t (dir (getattr search)))
(allow p4_linux_maintenance_journal_t p4_linux_journal_store_t (dir (getattr search open read)))
(allow p4_linux_maintenance_journal_t p4_linux_journal_machine_t (dir (getattr search open read)))
(allow p4_linux_maintenance_journal_t p4_linux_journal_database_t (file (getattr open read map lock)))
; The same normal journalctl --boot reads a not-yet-flushed failed boot from
; /run/log/journal. Only this existing read-only child can inspect its records.
(allow p4_linux_maintenance_journal_t p4_linux_volatile_log_root_t (dir (getattr search)))
(allow p4_linux_maintenance_journal_t p4_linux_volatile_journal_store_t (dir (getattr search open read)))
(allow p4_linux_maintenance_journal_t p4_linux_volatile_journal_machine_t (dir (getattr search open read)))
(allow p4_linux_maintenance_journal_t p4_linux_volatile_journal_database_t (file (getattr open read map lock)))
(allow p4_linux_maintenance_journal_t p4_linux_standardio_t (chr_file (getattr read write)))
(allow p4_linux_maintenance_journal_t labeledfs (filesystem (getattr)))
(allow p4_linux_maintenance_journal_t tmpfs (filesystem (getattr)))
(allow p4_linux_maintenance_journal_t self (dir (getattr search open read)))
(allow p4_linux_maintenance_journal_t self (file (getattr open read)))
(allow p4_linux_maintenance_journal_t self (lnk_file (getattr read)))
(allow p4_linux_maintenance_journal_t self (fd (use)))
(allow p4_linux_maintenance_journal_t self (process (getattr getcap)))

; Explicit public kernel metadata partition. It leaves all original genfs
; labels and every Android access decision untouched; no proc write or arbitrary
; Android process inspection is granted.
(typeattribute p4_maintenance_nonboard_files)
(typeattributeset p4_maintenance_nonboard_files (selinuxfs proc_random))
(typeattribute p4_maintenance_nonboard_dirs)
(typeattributeset p4_maintenance_nonboard_dirs (proc proc_random sysfs selinuxfs device devpts))
(typeattribute p4_nonboard_without_maintenance_files)
(typeattributeset p4_nonboard_without_maintenance_files (and (p4_all_nonboard) (not (p4_maintenance_nonboard_files))))
(typeattribute p4_nonboard_without_maintenance_dirs)
(typeattributeset p4_nonboard_without_maintenance_dirs (and (p4_all_nonboard) (not (p4_maintenance_nonboard_dirs))))
