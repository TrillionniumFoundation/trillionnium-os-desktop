; The early board owns the empty original tmpfs root. The Linux resource service
; creates only the fixed socket and private query mountpoint directories there.
(type p4_linux_private_dev_root_t)
(type p4_linux_private_socket_parent_t)
(type p4_linux_readiness_mount_t)
(type p4_linux_query_mount_t)
(roletype object_r p4_linux_query_mount_t)
(typeattributeset p4_linux_data (p4_linux_query_mount_t))
(allow p4_linux_query_mount_t tmpfs (filesystem (associate)))
(roletype object_r p4_linux_private_dev_root_t)
(roletype object_r p4_linux_private_socket_parent_t)
(roletype object_r p4_linux_readiness_mount_t)
(typeattributeset p4_linux_data (p4_linux_private_dev_root_t p4_linux_private_socket_parent_t p4_linux_readiness_mount_t))

(allow kernel p4_linux_private_dev_root_t (dir (getattr relabelto)))
(allow p4_linux_private_dev_root_t tmpfs (filesystem (associate)))
(allow p4_linux_private_socket_parent_t tmpfs (filesystem (associate)))
(allow p4_linux_readiness_mount_t tmpfs (filesystem (associate)))

(typetransition droidloom_broker p4_linux_private_dev_root_t dir "socket" p4_linux_private_socket_parent_t)
(typetransition droidloom_broker p4_linux_private_dev_root_t dir "droidloom-query" p4_linux_query_mount_t)
(allow droidloom_broker p4_linux_query_mount_t (dir (create open getattr read search setattr mounton)))
(neverallow domain p4_linux_query_mount_t (dir (mounton relabelfrom relabelto write add_name remove_name)))
(neverallow droidloom_broker p4_linux_query_mount_t (dir (relabelfrom relabelto)))
(typetransition droidloom_broker p4_linux_private_socket_parent_t dir "droidloom" p4_linux_readiness_mount_t)
(allow droidloom_broker p4_linux_run_t (dir (getattr search)))
(allow droidloom_broker p4_linux_early_handoff_dir_t (dir (getattr search)))
(allow droidloom_broker p4_linux_readiness_dir_t (dir (open getattr read search)))
(allow droidloom_broker p4_linux_private_dev_root_t (dir (open getattr read search write add_name)))
(allow droidloom_broker p4_linux_private_socket_parent_t (dir (create open getattr read search setattr write add_name)))
(allow droidloom_broker p4_linux_readiness_mount_t (dir (create open getattr read search setattr mounton)))

(neverallow droidloom_broker tmpfs (dir (mounton relabelfrom relabelto)))
(neverallow droidloom_broker p4_linux_readiness_dir_t (dir (write add_name remove_name mounton relabelto relabelfrom)))
(neverallow droidloom_broker p4_linux_readiness_mount_t (dir (relabelfrom relabelto)))
(neverallow droidloom_container_entry_t p4_linux_readiness_mount_t (dir (mounton relabelfrom relabelto)))
(neverallow droidloom_readiness p4_linux_readiness_mount_t (dir (read open write add_name remove_name mounton relabelto relabelfrom)))

; The pinned directories become the original Android /dev and /dev/socket when the
; kernel starts the selected init. That init performs its native restorecon on
; both. Linux does not receive access to their Android device or socket types.
(allow init p4_linux_private_dev_root_t (dir (search getattr relabelfrom)))
(allow init p4_linux_private_socket_parent_t (dir (search getattr relabelfrom)))
(typeattribute p4_android_other_than_device_init)
(typeattributeset p4_android_other_than_device_init (and (domain) (not (or (init) (kernel)))))
(neverallow p4_android_other_than_device_init p4_linux_private_dev_root_t (dir (relabelfrom relabelto mounton add_name remove_name)))
(neverallow p4_android_other_than_device_init p4_linux_private_socket_parent_t (dir (relabelfrom relabelto mounton add_name remove_name)))
(neverallow init p4_linux_private_dev_root_t (dir (relabelto mounton add_name remove_name)))
(neverallow init p4_linux_private_socket_parent_t (dir (relabelto mounton add_name remove_name)))
