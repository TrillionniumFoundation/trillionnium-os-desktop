;; Linux owns this pair of native kernel interfaces. The supervisor opens its own descriptions.
(type p4_kernel_ns_handle_t)
(roletype object_r p4_kernel_ns_handle_t)
(type p4_kernel_pid_handle_t)
(roletype object_r p4_kernel_pid_handle_t)
(genfscon nsfs "/" (u object_r p4_kernel_ns_handle_t ((s0) (s0))))
(genfscon pidfs "/" (u object_r p4_kernel_pid_handle_t ((s0) (s0))))

(typeattribute p4_handle_owner)
(typeattribute p4_not_handle_owner)
(typeattributeset p4_not_handle_owner (and (p4_linux_procs) (not (p4_handle_owner))))
(neverallow p4_not_handle_owner p4_kernel_ns_handle_t (file (open read ioctl)))
(neverallow p4_not_handle_owner p4_kernel_ns_handle_t (filesystem (getattr)))
(neverallow p4_not_handle_owner p4_kernel_pid_handle_t (filesystem (getattr)))
(neverallow p4_linux_procs p4_kernel_ns_handle_t (file (map execute execute_no_trans entrypoint write append unlink create link rename relabelfrom relabelto)))
(typeattribute p4_previous_namespace_ioctl_roles)
(typeattributeset p4_previous_namespace_ioctl_roles (and (p4_linux_procs) (not (or (droidloom_broker) (droidloom_policy_loader)))))
(neverallowx p4_previous_namespace_ioctl_roles p4_kernel_ns_handle_t (ioctl file (not (0xb703 0xb709))))
(allow p4_handle_owner p4_kernel_ns_handle_t (file (getattr open read ioctl)))
(allowx droidloom_container_entry_t p4_kernel_ns_handle_t (ioctl file (0xb703 0xb709)))
(allow p4_handle_owner p4_kernel_ns_handle_t (filesystem (getattr)))
(allow p4_handle_owner p4_kernel_pid_handle_t (filesystem (getattr)))
(typeattributeset p4_handle_owner (droidloom_container_entry_t droidloom_broker droidloom_policy_loader))
(allowx droidloom_broker p4_kernel_ns_handle_t (ioctl file (0xb701 0xb703 0xb709 0xb70d)))
(neverallowx droidloom_broker p4_kernel_ns_handle_t (ioctl file (not (0xb701 0xb703 0xb709 0xb70d))))
(allowx droidloom_policy_loader p4_kernel_ns_handle_t (ioctl file (0xb703 0xb70d)))
(neverallowx droidloom_policy_loader p4_kernel_ns_handle_t (ioctl file (not (0xb703 0xb70d))))
(allow droidloom_broker p4_kernel_pid_handle_t (file (getattr ioctl)))
(allowx droidloom_broker p4_kernel_pid_handle_t (ioctl file (0xff0b)))
(neverallowx droidloom_broker p4_kernel_pid_handle_t (ioctl file (not (0xff0b))))
