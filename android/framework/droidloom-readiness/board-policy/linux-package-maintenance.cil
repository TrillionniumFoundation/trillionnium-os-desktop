(neverallow droidloom_package_helper droidloom_package_early_units (file (getattr open read write append create setattr unlink link rename relabelto relabelfrom execute execute_no_trans entrypoint map)))
(neverallow droidloom_broker droidloom_package_early_unit_file (service (start stop reload kill load enable disable)))
(neverallow p4_instance_host_readers droidloom_package_early_unit_file (service (start stop reload kill load enable disable)))

; Observe only the six fixed cgroup.events inodes. No task membership,
; controller changes or foreign native service contents can be opened.
(type droidloom_package_cgroup_events)
(roletype object_r droidloom_package_cgroup_events)
