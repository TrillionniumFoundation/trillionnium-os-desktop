(typeattribute droidloom_package_early_units)
(typeattributeset droidloom_package_early_units (p4_linux_factory_unit_file_t droidloom_package_early_unit_file))
; Preserve the original manager's effective read-only generic-unit access.
(allow init_t droidloom_package_early_unit_file (file (getattr open read map)))
(allow droidloom_package_helper droidloom_package_early_units (service (status stop)))
