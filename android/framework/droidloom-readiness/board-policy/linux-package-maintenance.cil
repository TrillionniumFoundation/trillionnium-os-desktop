; Package maintenance has one immutable, installed entrypoint. The native
; package hooks inherit the logged-in host session identity through sudo/pacman;
; this automatic exec transition preserves the real UID/GID. It grants no root
; credentials. The helper still requires root, the exact installed ELF, the EX
; setup lock, the original live broker and the loaded policy/board witnesses.
(type droidloom_package_helper)
(type droidloom_package_helper_exec)
(roletype r droidloom_package_helper)
(roletype object_r droidloom_package_helper_exec)
(typeattributeset p4_linux_procs (droidloom_package_helper))
(typeattributeset p4_linux_mac_roles (droidloom_package_helper))
(typeattributeset p4_linux_data (droidloom_package_helper_exec))
(allow droidloom_package_helper_exec labeledfs (filesystem (associate)))
(roletransition system_r droidloom_package_helper_exec process r)
(typetransition p4_linux_user_session_t droidloom_package_helper_exec process droidloom_package_helper)
(allow p4_linux_user_session_t droidloom_package_helper_exec (file (getattr open read execute map)))
(allow p4_linux_user_session_t droidloom_package_helper (process (transition siginh rlimitinh)))
(allow droidloom_package_helper droidloom_package_helper_exec (file (getattr open read execute map entrypoint)))
(allow droidloom_package_helper p4_linux_user_session_t (fd (use)))
(allow droidloom_package_helper p4_linux_user_session_t (process (sigchld)))
(neverallow p4_linux_user_session_t droidloom_package_helper_exec (file (execute_no_trans)))
(auditallow p4_linux_user_session_t droidloom_package_helper (process (transition)))

