; The original configuration directory is preinstalled. Named creation can
; produce only the setup lock and durable maintenance fence. Other files keep
; the directory type and cannot be created by this helper. There is no fence
; unlink, rename, relabel or resume permission.
(type droidloom_package_config_dir)
(type droidloom_package_selection_dir)
(type droidloom_package_fence)
