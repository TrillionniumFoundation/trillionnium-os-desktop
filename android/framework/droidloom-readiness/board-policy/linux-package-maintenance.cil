(genfscon cgroup2 "/system.slice/droidloomd.service/cgroup.events" (u object_r droidloom_package_cgroup_events ((s0) (s0))))
(genfscon cgroup2 "/system.slice/droidloom-instance-factory.service/cgroup.events" (u object_r droidloom_package_cgroup_events ((s0) (s0))))
(genfscon cgroup2 "/system.slice/droidloom-instance-launcher.service/cgroup.events" (u object_r droidloom_package_cgroup_events ((s0) (s0))))
(genfscon cgroup2 "/system.slice/droidloom-early-observer.service/cgroup.events" (u object_r droidloom_package_cgroup_events ((s0) (s0))))
