; The ordinary Ubuntu system manager selects the broker context explicitly on
; the shared daemon ELF. Observer invocations keep the existing default type
; transition on that same ELF. Neither worker can enter the other role.
(type droidloom_broker)
(type droidloom_policy_loader)
(roletype r droidloom_broker)
(roletype r droidloom_policy_loader)
(typeattributeset p4_linux_procs (droidloom_broker droidloom_policy_loader))
(type droidloom_policy_loader_exec)
(type p4_linux_systemd_run_t)
(type p4_linux_manager_socket_initial_t)
(type droidloom_manager_private_socket)
(roletype object_r droidloom_policy_loader_exec)
(roletype object_r p4_linux_systemd_run_t)
(roletype object_r p4_linux_manager_socket_initial_t)
(roletype object_r droidloom_manager_private_socket)
(typeattributeset p4_linux_data (droidloom_policy_loader_exec p4_linux_systemd_run_t p4_linux_manager_socket_initial_t droidloom_manager_private_socket))

(roleallow system_r r)
(roletransition system_r droidloom_policy_loader_exec process r)
(typetransition init_t droidloom_policy_loader_exec process droidloom_policy_loader)
(allow init_t self (process (setexec)))
(allow init_t droidloom_broker (process (transition getattr signull signal sigkill sigstop)))
(allow init_t droidloom_policy_loader (process (transition getattr signull signal sigkill sigstop)))
(allow init_t droidloom_broker (process2 (nnp_transition)))
(allow init_t droidloom_policy_loader (process2 (nnp_transition)))
(allow init_t droidloom_container_entry_t (process2 (nnp_transition)))
(allow init_t droidloom_policy_loader_exec (file (getattr open read execute map)))
(allow droidloom_broker droidloom_container_entry_exec_t (file (getattr open read execute execute_no_trans map entrypoint)))
(allow droidloom_policy_loader droidloom_policy_loader_exec (file (getattr open read execute map entrypoint)))
(allow droidloom_policy_loader init_exec_t (file (getattr open read)))
(allow droidloom_broker p4_linux_rootdir_t (dir (getattr search)))
(allow droidloom_policy_loader p4_linux_rootdir_t (dir (getattr search)))
(allow droidloom_broker p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow droidloom_policy_loader p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow droidloom_broker init_t (fd (use)))
(allow droidloom_policy_loader init_t (fd (use)))
; The original systemd-executor opens the selected ELF before entering the loader domain.
(allow droidloom_policy_loader p4_linux_service_executor_t (fd (use)))
; Keep the normal systemd-provided null standard streams across secure exec.
(allow droidloom_policy_loader p4_linux_standardio_t (chr_file (read write)))
(allow init_t droidloom_broker (fd (use)))
(allow droidloom_broker init_t (process (getattr sigchld)))
(allow droidloom_policy_loader init_t (process (getattr sigchld)))
(auditallow init_t droidloom_broker (process (transition)))
(auditallow init_t droidloom_policy_loader (process (transition)))

; The manager creates its own named server in its typed runtime directory.
; Only the original loader can seal that dedicated socket inode.
(typetransition init_t p4_linux_run_t dir "systemd" p4_linux_systemd_run_t)
(allow init_t p4_linux_run_t (dir (write add_name)))
(allow init_t p4_linux_systemd_run_t (dir (getattr open search read create write add_name remove_name)))
(allow p4_linux_systemd_run_t tmpfs (filesystem (associate)))
(typetransition init_t p4_linux_systemd_run_t sock_file "private" p4_linux_manager_socket_initial_t)
(allow init_t p4_linux_manager_socket_initial_t (sock_file (create getattr setattr unlink)))
(allow init_t self (unix_stream_socket (create bind listen accept read write getattr getopt setopt shutdown)))
(allow p4_linux_manager_socket_initial_t tmpfs (filesystem (associate)))
(allow droidloom_manager_private_socket tmpfs (filesystem (associate)))
(allow droidloom_broker p4_linux_run_t (dir (getattr search)))
(allow droidloom_policy_loader p4_linux_run_t (dir (getattr search)))
(allow droidloom_broker p4_linux_systemd_run_t (dir (getattr search)))
(allow droidloom_policy_loader p4_linux_systemd_run_t (dir (getattr search)))
(allow droidloom_broker self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow droidloom_policy_loader self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow droidloom_broker init_t (unix_stream_socket (connectto)))
(allow droidloom_policy_loader init_t (unix_stream_socket (connectto)))
(allow droidloom_broker droidloom_manager_private_socket (sock_file (getattr write)))
(allow droidloom_policy_loader p4_linux_manager_socket_initial_t (sock_file (getattr write relabelfrom)))
(allow droidloom_policy_loader droidloom_manager_private_socket (sock_file (getattr write relabelto)))
(neverallow droidloom_broker droidloom_manager_private_socket (sock_file (relabelto relabelfrom)))
(neverallow droidloom_policy_loader self (process (setfscreate)))
(neverallow droidloom_broker droidloom_policy_loader_exec (file (entrypoint execute execute_no_trans)))
(neverallow droidloom_broker droidloom_policy_loader (process (transition dyntransition ptrace)))
(neverallow droidloom_policy_loader droidloom_broker (process (transition dyntransition ptrace)))
(neverallow droidloom_container_entry_t droidloom_broker (process (transition dyntransition ptrace)))

; The selinuxfs transaction files accept a query via write(2) and return its
; result via read(2). The kernel checks the security class for each operation.
; The selected AppArmor profiles further restrict each role to fixed ABI paths.
(allow p4_linux_mac_roles proc (dir (getattr search)))
; Current-task proc magic links retain the stock filesystem symlink type.
; This resolves the link only; target object and ptrace checks remain required.
(allow p4_linux_mac_roles proc (lnk_file (read)))
(allow p4_linux_mac_roles sysfs (dir (getattr search)))
(allow p4_linux_mac_roles selinuxfs (dir (getattr search read open)))
(allow p4_linux_mac_roles selinuxfs (file (getattr read open map write)))
(allow p4_linux_mac_roles selinuxfs (filesystem (getattr)))
(allow p4_linux_mac_roles kernel (security (compute_av compute_create check_context read_policy)))
(neverallow p4_linux_mac_roles kernel (security (load_policy setenforce setbool setsecparam setcheckreqprot)))
(allow droidloom_broker self (file (getattr open read)))
(allow droidloom_broker self (dir (getattr search)))
(allow droidloom_broker self (lnk_file (getattr read)))
(allow droidloom_policy_loader self (file (getattr open read)))
(allow droidloom_policy_loader self (dir (getattr search)))
(allow droidloom_policy_loader self (lnk_file (getattr read)))

; Only early PID 1 publishes this same-boot observation. The two roles
; consume a read-only mount and can never change its label, data or ownership.
(type p4_linux_apparmor_epoch_t)
(roletype object_r p4_linux_apparmor_epoch_t)
(typeattributeset p4_linux_data (p4_linux_apparmor_epoch_t))
(allow p4_linux_apparmor_epoch_t tmpfs (filesystem (associate)))
(type p4_linux_policy_epoch_dir_t)
(roletype object_r p4_linux_policy_epoch_dir_t)
(typeattributeset p4_linux_data (p4_linux_policy_epoch_dir_t))
(allow p4_linux_policy_epoch_dir_t tmpfs (filesystem (associate)))
(allow kernel p4_linux_policy_epoch_dir_t (dir (search getattr relabelto write add_name)))
(allow p4_linux_mac_roles p4_linux_policy_epoch_dir_t (dir (getattr search)))
; PID 1 evaluates the calibration unit ConditionPathExists with access(F_OK).
(allow init_t p4_linux_early_handoff_dir_t (dir (search)))
(allow init_t p4_linux_policy_epoch_dir_t (dir (search)))
(neverallow p4_linux_procs p4_linux_policy_epoch_dir_t (dir (write add_name remove_name mounton relabelto relabelfrom)))
(typetransition kernel p4_linux_policy_epoch_dir_t file "apparmor-epoch" p4_linux_apparmor_epoch_t)
(allow kernel p4_linux_apparmor_epoch_t (file (create open getattr read write)))
(neverallow p4_linux_procs p4_linux_apparmor_epoch_t (file (mounton)))
(allow p4_linux_mac_roles p4_linux_early_handoff_dir_t (dir (getattr search)))
(allow p4_linux_mac_roles p4_linux_apparmor_epoch_t (file (getattr open read)))
(neverallow p4_linux_procs p4_linux_apparmor_epoch_t (file (append create write link unlink rename setattr relabelto relabelfrom)))

; Preserve the stock Linux and Android labels on shared kernel metadata.
; AppArmor further limits reads of these original classes to the selected
; /proc boot ID, /sys/kernel/notes and securityfs LSM list.
(typeattribute p4_linux_mac_fixed_kernel_read)
(typeattributeset p4_linux_mac_fixed_kernel_read (p4_linux_registered_lsms_t sysfs_kernel_notes proc_random))
(allow p4_linux_mac_roles p4_linux_mac_fixed_kernel_read (file (getattr open read)))
(allow p4_linux_mac_roles proc_random (dir (getattr search)))
(allow p4_linux_mac_roles securityfs (dir (getattr search)))
; The original AppArmor namespace magic link keeps the stock securityfs type.
(allow p4_linux_mac_roles securityfs (lnk_file (read)))
(allow p4_linux_mac_roles securityfs (filesystem (getattr)))
(allow p4_linux_mac_roles proc (filesystem (getattr)))
(allow p4_linux_mac_roles sysfs (filesystem (getattr)))
(allow p4_linux_mac_roles tmpfs (filesystem (getattr)))
(allow droidloom_policy_loader self (dir (open read)))
(allow droidloom_broker self (dir (open read)))

; The AppArmor namespace magic link selects a kernel-internal superblock.
; Late roles inspect original object identities. Only the three fixed root-namespace
; raw-load revision counters have a separate read-only type. Their birth paths
; follow the admitted empty-namespace 165 Ubuntu + four board-profile load order.
(type p4_linux_apparmor_handle_t)
(type p4_linux_apparmor_state_t)
(roletype object_r p4_linux_apparmor_handle_t)
(roletype object_r p4_linux_apparmor_state_t)
(typeattributeset p4_linux_data (p4_linux_apparmor_handle_t p4_linux_apparmor_state_t))
(genfscon apparmorfs "/" (u object_r p4_linux_apparmor_handle_t ((s0) (s0))))
(type p4_linux_apparmor_revision_t)
(roletype object_r p4_linux_apparmor_revision_t)
(typeattributeset p4_linux_data (p4_linux_apparmor_revision_t))
(genfscon apparmorfs "/raw_data/164/revision" (u object_r p4_linux_apparmor_revision_t ((s0) (s0))))
(genfscon apparmorfs "/raw_data/165/revision" (u object_r p4_linux_apparmor_revision_t ((s0) (s0))))
(genfscon apparmorfs "/raw_data/166/revision" (u object_r p4_linux_apparmor_revision_t ((s0) (s0))))
(allow p4_linux_mac_roles p4_linux_apparmor_revision_t (file (getattr open read)))
(neverallow p4_linux_other_than_mac p4_linux_apparmor_revision_t (file (open read)))
(neverallow p4_nonboard_user p4_linux_apparmor_revision_t (file (open read)))
(neverallow p4_linux_procs p4_linux_apparmor_revision_t (file (create append write link unlink rename setattr relabelto relabelfrom map execute execute_no_trans entrypoint mounton)))
(genfscon securityfs "/apparmor" (u object_r p4_linux_apparmor_state_t ((s0) (s0))))
; The distribution executor uses a separate read-only type for the sysfs enabled bit.
(allow p4_linux_mac_roles p4_linux_apparmor_handle_t (filesystem (getattr)))
(allow p4_linux_mac_roles p4_linux_apparmor_handle_t (dir (getattr search)))
(allow p4_linux_mac_roles p4_linux_apparmor_handle_t (lnk_file (read)))
(allow p4_linux_mac_roles p4_linux_apparmor_state_t (dir (getattr search open read)))
(allow p4_linux_mac_roles p4_linux_apparmor_state_t (lnk_file (getattr read)))
(allow p4_linux_mac_roles p4_linux_apparmor_state_t (file (getattr open read)))
(neverallow p4_linux_mac_roles p4_linux_apparmor_handle_t (file (open read write map execute)))
(neverallow p4_linux_mac_roles p4_linux_apparmor_state_t (file (write append execute map)))
