; Software Surface::lockCanvas still imports graphics buffers. This is the
; original full-Treble hal_client_domain contract, without the passthrough
; hal_graphics_allocator attribute (which would grant direct heap/capability use).
(typeattributeset halclientdomain (droidloom_camera_producer))
(typeattributeset hal_graphics_allocator_client (droidloom_camera_producer))
(allow droidloom_camera_producer hal_graphics_allocator (memfd_file (getattr read write map)))
(allow hal_graphics_allocator droidloom_camera_producer (memfd_file (getattr read write map)))
