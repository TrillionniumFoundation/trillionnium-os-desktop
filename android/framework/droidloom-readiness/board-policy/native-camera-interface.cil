; Separate boot evidence for the added profile; the original three raw counters
; and their DLAAREV3 packet remain unchanged. The producer checks this birth
; against the sole ordered board-profile input (loader birth 164 plus offset).
(typetransition kernel p4_linux_policy_epoch_dir_t file "camera-apparmor-epoch" p4_linux_apparmor_epoch_t)
(type p4_linux_camera_apparmor_revision_t)
(roletype object_r p4_linux_camera_apparmor_revision_t)
(typeattributeset p4_linux_data (p4_linux_camera_apparmor_revision_t))
(genfscon apparmorfs "/raw_data/170/revision" (u object_r p4_linux_camera_apparmor_revision_t ((s0) (s0))))
(allow droidloom_broker p4_linux_camera_apparmor_revision_t (file (getattr open read)))
(typeattribute p4_camera_revision_nonreaders)
(typeattributeset p4_camera_revision_nonreaders (and (all) (not (or droidloom_broker kernel))))
(neverallow p4_camera_revision_nonreaders p4_linux_camera_apparmor_revision_t (file (open read)))
(neverallow p4_linux_procs p4_linux_camera_apparmor_revision_t (file (create append write link unlink rename setattr relabelto relabelfrom map execute execute_no_trans entrypoint mounton)))
