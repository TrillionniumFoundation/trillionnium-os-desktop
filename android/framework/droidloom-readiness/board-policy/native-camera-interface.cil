(allow droidloom_camera_capture droidloom_broker (fifo_file (getattr read)))
(allow droidloom_camera_capture droidloom_broker (unix_stream_socket (accept getattr getopt setopt read write shutdown)))
(allow droidloom_camera_capture self (unix_stream_socket (create getattr getopt setopt read write shutdown)))
(allow droidloom_broker droidloom_camera_capture (fd (use)))
(allow droidloom_broker droidloom_camera_capture (unix_stream_socket (getattr getopt)))
; The bootstrap returns a socket newly created after the fixed image exec.
; Its native peer PIDFD and both LSM labels authenticate the actual child.
(neverallow droidloom_camera_capture self (process (fork ptrace setexec setcurrent dyntransition setfscreate setsockcreate setkeycreate)))
(neverallow droidloom_camera_capture self (capability (all)))
(neverallow droidloom_camera_capture self (capability2 (all)))
(neverallow droidloom_camera_capture self (cap_userns (all)))
(neverallow droidloom_camera_capture self (cap2_userns (all)))
(neverallow droidloom_camera_capture kernel (security (load_policy setenforce setbool setsecparam setcheckreqprot read_policy)))
(neverallow droidloom_camera_capture p4_linux_data (file (create write append setattr unlink link rename relabelfrom relabelto)))
(neverallow droidloom_camera_capture p4_linux_data (dir (create write add_name remove_name rmdir mounton relabelfrom relabelto)))
(neverallow droidloom_camera_capture p4_all_board_owned (binder (call transfer impersonate set_context_mgr)))

; Fixed root-owned devtmpfs video nodes, distinct from every Android device.
(type p4_linux_uvc_device_t)
(type p4_linux_uvc_dir_t)
(roletype object_r p4_linux_uvc_device_t)
(roletype object_r p4_linux_uvc_dir_t)
(typeattributeset p4_native_hardware_nodes (p4_linux_uvc_device_t))
(typeattributeset p4_linux_data (p4_linux_uvc_dir_t))
(allow p4_linux_uvc_dir_t device (filesystem (associate)))
(allow p4_linux_udev_t p4_linux_uvc_dir_t (dir (getattr search open read create write add_name remove_name rmdir setattr relabelfrom relabelto)))
(allow p4_linux_udev_t p4_linux_uvc_dir_t (lnk_file (create getattr read setattr unlink)))
(typetransition p4_linux_udev_t p4_linux_native_dev_root_t dir "v4l" p4_linux_uvc_dir_t)
(typetransition p4_linux_udev_t p4_linux_uvc_dir_t dir "by-id" p4_linux_uvc_dir_t)
(typetransition p4_linux_udev_t p4_linux_uvc_dir_t dir "by-path" p4_linux_uvc_dir_t)
(typetransition p4_linux_udev_t p4_linux_uvc_dir_t lnk_file p4_linux_uvc_dir_t)
(allow droidloom_camera_capture p4_linux_uvc_dir_t (dir (getattr search)))
(allow droidloom_camera_capture p4_linux_uvc_dir_t (lnk_file (getattr read)))
(allow droidloom_camera_capture p4_linux_uvc_device_t (chr_file (getattr open read write ioctl map)))
(allowx droidloom_camera_capture p4_linux_uvc_device_t (ioctl chr_file (0x5600 0x5602 0x564a 0x564b 0x5605 0x5616 0x5608 0x5609 0x560f 0x5611 0x5612 0x5613)))
(neverallowx droidloom_camera_capture p4_linux_uvc_device_t (ioctl chr_file (not (0x5600 0x5602 0x564a 0x564b 0x5605 0x5616 0x5608 0x5609 0x560f 0x5611 0x5612 0x5613))))
; Stock v4l_id opens only for QUERYCAP before creating the exact by-id alias.
(allow p4_linux_udev_t p4_linux_uvc_device_t (chr_file (open read ioctl)))
(allowx p4_linux_udev_t p4_linux_uvc_device_t (ioctl chr_file (0x5600)))
(neverallowx p4_linux_udev_t p4_linux_uvc_device_t (ioctl chr_file (not (0x5600))))
(neverallow p4_linux_udev_t p4_linux_uvc_device_t (chr_file (write map)))
(neverallow droidloom_camera_capture device (chr_file (open read write ioctl map)))
(neverallow droidloom_camera_capture p4_linux_drm_card_t (chr_file (open read write ioctl map)))
(neverallow droidloom_camera_capture p4_linux_drm_render_t (chr_file (open read write ioctl map)))
(neverallow droidloom_camera_capture p4_linux_input_event_t (chr_file (open read write ioctl map)))

; Android connects only by stream bytes. No Linux-origin descriptor crosses
; into Android, including the inherited listener's broker file description.
(type droidloom_camera_socket)
(roletype object_r droidloom_camera_socket)
(typeattributeset p4_linux_data (droidloom_camera_socket))
(allow droidloom_camera_socket tmpfs (filesystem (associate)))
(typetransition droidloom_broker droidloom_frontend_android_dir sock_file "camera" droidloom_camera_socket)
(allow droidloom_broker droidloom_camera_socket (sock_file (create getattr setattr unlink)))

