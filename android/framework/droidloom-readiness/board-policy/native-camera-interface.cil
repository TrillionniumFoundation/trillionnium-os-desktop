(allow droidloom_camera_capture p4_linux_elf_interpreter_t (file (getattr open read map execute)))
(allow droidloom_camera_capture p4_linux_host_config_t (file (getattr open read)))
(allow droidloom_camera_capture p4_linux_rootdir_t (dir (getattr search)))
