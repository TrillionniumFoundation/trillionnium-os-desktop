(allow droidloom_broker droidloom_camera_capture (process (transition getattr sigkill)))
(allow droidloom_broker droidloom_camera_capture (process2 (nnp_transition nosuid_transition)))
(allow droidloom_camera_capture droidloom_broker (process (getattr sigchld)))
(allow droidloom_camera_capture droidloom_container_entry_exec_t (file (getattr open read map execute entrypoint)))
