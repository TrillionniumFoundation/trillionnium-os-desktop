(allow droidloom_camera_capture self (process (getattr getcap)))
(allow droidloom_camera_capture self (dir (getattr search)))
(allow droidloom_camera_capture self (lnk_file (getattr read)))
(allow droidloom_camera_capture proc (dir (getattr search)))
(allow droidloom_camera_capture proc (lnk_file (getattr read)))
(allow droidloom_camera_capture p4_kernel_ns_handle_t (file (getattr open read ioctl)))
(allowx droidloom_camera_capture p4_kernel_ns_handle_t (ioctl file (0xb703)))
(neverallowx droidloom_camera_capture p4_kernel_ns_handle_t (ioctl file (not (0xb703))))
