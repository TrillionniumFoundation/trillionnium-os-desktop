; The original-machine qualification has one fixed return entry. It can read
; the actual boot witnesses and record its own bounded observations. It does
; not install packages, label files, select a boot, open a watchdog, or acquire
; maintenance capabilities. Only exec of the existing pinned C maintenance
; entry crosses into that entry's already closed three-capability domain.
(type p4_linux_once_return_t)
(type p4_linux_once_return_exec_t)
(type p4_linux_once_config_t)
(type p4_linux_once_parent_t)
(type p4_linux_once_evidence_t)
(type p4_linux_once_unit_t)
(type p4_linux_host_mount_identity_t)
(roletype system_r p4_linux_once_return_t)
(roletype object_r p4_linux_once_return_exec_t)
(roletype object_r p4_linux_once_config_t)
(roletype object_r p4_linux_once_parent_t)
(roletype object_r p4_linux_once_evidence_t)
(roletype object_r p4_linux_once_unit_t)
(roletype object_r p4_linux_host_mount_identity_t)
(typeattributeset p4_linux_procs (p4_linux_once_return_t))
(typeattribute p4_once_immutable_files)
(typeattributeset p4_once_immutable_files
 (p4_linux_once_return_exec_t p4_linux_once_config_t p4_linux_once_unit_t
  p4_linux_host_mount_identity_t))
(typeattributeset p4_linux_data
 (p4_once_immutable_files p4_linux_once_parent_t p4_linux_once_evidence_t))
(allow p4_linux_once_return_exec_t labeledfs (filesystem (associate)))
(allow p4_linux_once_config_t labeledfs (filesystem (associate)))
(allow p4_linux_once_parent_t labeledfs (filesystem (associate)))
(allow p4_linux_once_evidence_t labeledfs (filesystem (associate)))
(allow p4_linux_once_unit_t labeledfs (filesystem (associate)))
(allow p4_linux_host_mount_identity_t tmpfs (filesystem (associate)))

; The global PID 1 holds its own mount namespace before first load. tmpfs is
; fs_use_trans: the bounded identity file is created AFTER load under this
; exact named transition, then checked and made 0400. No raw pre-load xattr is
; treated as an actual SID, and no self-MNT bind cycle is created.
(typetransition kernel p4_linux_early_handoff_dir_t file "host-mount-identity.json" p4_linux_host_mount_identity_t)
(allow kernel p4_linux_host_mount_identity_t (file (create getattr open read write setattr)))
(allow kernel p4_kernel_ns_handle_t (file (getattr)))
(allow kernel p4_kernel_ns_handle_t (filesystem (getattr)))
(typeattribute p4_once_not_kernel)
(typeattributeset p4_once_not_kernel (not (kernel)))
(neverallow p4_once_not_kernel p4_linux_host_mount_identity_t (file (create write append setattr unlink rename link relabelto relabelfrom)))
(neverallow kernel p4_linux_host_mount_identity_t (file (append map execute execute_no_trans entrypoint ioctl unlink rename link relabelto relabelfrom)))

(call p4_ubuntu_system_service (p4_linux_once_return_t p4_linux_once_return_exec_t))
(allow init_t p4_linux_once_return_t (process (getattr signull signal sigkill sigstop)))
(allow p4_linux_once_return_t init_t (process (sigchld)))
(allow init_t p4_linux_once_unit_t (file (getattr open read map)))
(allow p4_linux_once_return_t p4_linux_service_executor_t (fd (use)))
(allow p4_linux_once_return_t self (process (fork getattr getcap setcap sigchld)))
(allow p4_linux_once_return_t self (fd (use)))
(allow p4_linux_once_return_t self (dir (getattr search)))
(allow p4_linux_once_return_t self (file (getattr open read)))
(allow p4_linux_once_return_t self (lnk_file (getattr read)))
; std::process's exec-error pipe is local to this parent/child pair.
(allow p4_linux_once_return_t self (fifo_file (getattr read write)))

(allow p4_linux_once_return_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_etc_dir_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_product_store_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_once_parent_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_once_config_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_once_config_t (file (getattr open read)))
; The normal joined FC gives cell.json/selected.json the MAC input type.
; Reading these fixed pins does not join the general selected-release reader
; group or authorize the other files in the normal product store.
(allow p4_linux_once_return_t droidloom_package_config_parents (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_mac_release_input_t (file (getattr open read)))
(allow p4_linux_once_return_t p4_linux_maintenance_config_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_maintenance_config_t (file (getattr open read)))
(allow p4_linux_once_return_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_once_return_t p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_once_return_t p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_linux_once_return_t p4_linux_run_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_early_handoff_dir_t (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_host_mount_identity_t (file (getattr open read)))
(typeattributeset p4_handle_owner (p4_linux_once_return_t))
(allowx p4_linux_once_return_t p4_kernel_ns_handle_t (ioctl file (0xb703)))
(neverallowx p4_linux_once_return_t p4_kernel_ns_handle_t (ioctl file (not (0xb703))))
(allow p4_linux_once_return_t labeledfs (filesystem (getattr)))
(allow p4_linux_once_return_t tmpfs (filesystem (getattr)))
(allow p4_linux_once_return_t proc (filesystem (getattr)))
(allow p4_linux_once_return_t sysfs (filesystem (getattr)))
; The normal FINISH constructor, not a guessed by-uuid FC, identifies the
; actual root block device and its one UUID link. Metadata only is consumed.
(allow p4_linux_once_return_t p4_linux_native_dev_root_t (dir (getattr search)))
(allow p4_linux_once_return_t device (dir (getattr search)))
(allow p4_linux_once_return_t p4_linux_root_uuid_link_t (lnk_file (getattr read)))
(allow p4_linux_once_return_t p4_linux_root_block_t (blk_file (getattr)))
(allow p4_linux_once_return_t p4_linux_standardio_t (chr_file (getattr open read write)))
(allow p4_linux_once_return_t null_device (chr_file (getattr open read write)))

; SELinux keeps an explicit, closed public-kernel metadata set. The same
; source-owned AppArmor entry further restricts proc to self, boot_id,
; osrelease and cmdline, and sysfs to the original software-watchdog files.
(typeattribute p4_once_public_files)
(typeattributeset p4_once_public_files (proc proc_random proc_cmdline selinuxfs sysfs p4_kernel_ns_handle_t))
(typeattribute p4_once_public_directories)
(typeattributeset p4_once_public_directories (proc proc_random sysfs selinuxfs device))
(typeattribute p4_once_other_nonboard_files)
(typeattributeset p4_once_other_nonboard_files (and (p4_all_nonboard) (not (p4_once_public_files))))
(typeattribute p4_once_other_nonboard_directories)
(typeattributeset p4_once_other_nonboard_directories (and (p4_all_nonboard) (not (p4_once_public_directories))))
(allow p4_linux_once_return_t proc (dir (getattr search)))
(allow p4_linux_once_return_t proc (lnk_file (getattr read)))
(allow p4_linux_once_return_t proc (file (getattr open read)))
(allow p4_linux_once_return_t proc_random (dir (getattr search)))
(allow p4_linux_once_return_t proc_random (file (getattr open read)))
(allow p4_linux_once_return_t selinuxfs (dir (getattr search)))
(allow p4_linux_once_return_t selinuxfs (file (getattr open read)))
(allow p4_linux_once_return_t sysfs (dir (getattr search open read)))
(allow p4_linux_once_return_t sysfs (file (getattr open read)))
(typeattributeset p4_native_boot_commandline_readers (p4_linux_once_return_t))
(typeattributeset p4_native_public_directory_traversers (p4_linux_once_return_t))
(neverallow p4_linux_once_return_t p4_once_other_nonboard_files (file (open read)))
(neverallow p4_linux_once_return_t p4_once_other_nonboard_directories (dir (search open read)))

; Only the prepared evidence directory is writable. No new directory, link,
; replacement, unlinked output or caller-chosen output path is authorized.
(typetransition p4_linux_once_return_t p4_linux_once_evidence_t file p4_linux_once_evidence_t)
(allow p4_linux_once_return_t p4_linux_once_evidence_t (dir (getattr search open read write add_name)))
(allow p4_linux_once_return_t p4_linux_once_evidence_t (file (getattr open read write create setattr lock)))
(typetransition p4_linux_once_return_t p4_linux_maintenance_exec_t process p4_linux_maintenance_t)
(allow p4_linux_once_return_t p4_linux_maintenance_exec_t (file (getattr open read execute map)))
(allow p4_linux_once_return_t p4_linux_maintenance_t (process (transition siginh rlimitinh)))
(allow p4_linux_once_return_t p4_linux_maintenance_t (process2 (nnp_transition)))
(allow p4_linux_maintenance_t p4_linux_once_return_t (process (sigchld)))
(allow p4_linux_maintenance_t p4_linux_once_return_t (fd (use)))
(allow p4_linux_maintenance_t p4_linux_once_return_t (fifo_file (getattr read write)))
; Maintenance inherits the already opened O_RDWR output, never a pathname
; grant to create, open or replace evidence. Its existing source pins remain.
(allow p4_linux_maintenance_t p4_linux_once_evidence_t (file (getattr read write)))

(typeattribute p4_once_all_types)
(typeattributeset p4_once_all_types (all))
(typeattribute p4_once_not_executor)
(typeattributeset p4_once_not_executor (not (p4_linux_service_executor_t)))
(typeattribute p4_once_not_evidence)
(typeattributeset p4_once_not_evidence (not (p4_linux_once_evidence_t)))
(typeattribute p4_once_not_creator)
(typeattributeset p4_once_not_creator (not (p4_linux_once_return_t)))
(typeattribute p4_once_not_output_writer)
(typeattributeset p4_once_not_output_writer (not (or (p4_linux_once_return_t) (p4_linux_maintenance_t))))
(typeattribute p4_once_foreign_processes)
(typeattributeset p4_once_foreign_processes (and (or (p4_linux_procs) (or (domain) (kernel))) (not (p4_linux_once_return_t))))
(typeattribute p4_once_not_maintenance)
(typeattributeset p4_once_not_maintenance (not (p4_linux_maintenance_t)))
(typeattribute p4_once_not_stdio)
(typeattributeset p4_once_not_stdio (not (or (p4_linux_standardio_t) (null_device))))
(neverallow p4_once_not_executor p4_linux_once_return_t (process (transition dyntransition)))
(neverallow p4_linux_once_return_t p4_once_not_maintenance (process (transition)))
(neverallow p4_linux_once_return_t p4_once_all_types (process (dyntransition ptrace setcurrent setexec setfscreate setkeycreate setsockcreate signal sigkill sigstop)))
(neverallow p4_linux_once_return_t self (capability (all)))
(neverallow p4_linux_once_return_t self (capability2 (all)))
(neverallow p4_linux_once_return_t self (cap_userns (all)))
(neverallow p4_linux_once_return_t self (cap2_userns (all)))
(neverallow p4_linux_once_return_t kernel (security (all)))
(neverallow p4_linux_once_return_t p4_once_foreign_processes (dir (open read search)))
(neverallow p4_linux_once_return_t p4_once_foreign_processes (file (getattr open read)))
(neverallow p4_linux_once_return_t p4_once_foreign_processes (lnk_file (getattr read)))
(neverallow p4_linux_once_return_t p4_once_all_types (file (execute_no_trans unlink link rename append relabelfrom relabelto mounton)))
(neverallow p4_linux_once_return_t p4_once_not_evidence (file (create write setattr)))
(neverallow p4_linux_once_return_t p4_once_all_types (dir (create remove_name rmdir setattr mounton relabelfrom relabelto)))
(neverallow p4_linux_once_return_t p4_once_not_evidence (dir (write add_name)))
(neverallow p4_linux_once_return_t p4_once_not_stdio (chr_file (open read write append ioctl map)))
(neverallow p4_linux_once_return_t p4_once_all_types (blk_file (open read write append ioctl map)))
(neverallow p4_linux_once_return_t p4_once_all_types (unix_stream_socket (create connect connectto bind listen accept)))
(neverallow p4_linux_once_return_t p4_once_all_types (unix_dgram_socket (create connect bind sendto)))
(neverallow p4_once_not_creator p4_linux_once_evidence_t (file (create setattr unlink link rename append)))
(neverallow p4_once_not_output_writer p4_linux_once_evidence_t (file (write)))
(neverallow p4_linux_procs p4_once_immutable_files (file (create write append setattr unlink link rename relabelto relabelfrom execute_no_trans)))
