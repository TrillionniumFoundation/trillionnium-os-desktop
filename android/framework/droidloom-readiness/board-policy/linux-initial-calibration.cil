; The release package pre-installs this exact private StateDirectory on Ubuntu ext4.
(type p4_linux_mac_calibration_dir_t)
(type p4_linux_mac_capture_t)
(type p4_linux_mac_release_input_t)
(type p4_linux_mac_setup_lock_t)
(roletype object_r p4_linux_mac_calibration_dir_t)
(roletype object_r p4_linux_mac_capture_t)
(roletype object_r p4_linux_mac_release_input_t)
(roletype object_r p4_linux_mac_setup_lock_t)
(typeattributeset p4_linux_data (p4_linux_mac_calibration_dir_t p4_linux_mac_capture_t p4_linux_mac_release_input_t p4_linux_mac_setup_lock_t))
(allow p4_linux_mac_calibration_dir_t labeledfs (filesystem (associate)))
(allow p4_linux_mac_capture_t labeledfs (filesystem (associate)))
(allow p4_linux_mac_release_input_t labeledfs (filesystem (associate)))
(allow p4_linux_mac_setup_lock_t labeledfs (filesystem (associate)))
; Ubuntu 259.9 opens StandardOutput= in the confined service executor before exec.
; Only the named regular output is assigned the writable capture type.
(typetransition p4_linux_service_executor_t p4_linux_mac_calibration_dir_t file "capture.pending" p4_linux_mac_capture_t)
(allow init_t p4_linux_mac_calibration_dir_t (dir (getattr search)))
; Original Ubuntu path_chown_recursive opens this preinstalled unit directory with O_DIRECTORY to verify ownership.
(allow p4_linux_service_executor_t p4_linux_mac_calibration_dir_t (dir (getattr open read search write add_name)))
(allow p4_linux_service_executor_t p4_linux_mac_capture_t (file (getattr create open write setattr)))
(neverallow p4_linux_service_executor_t p4_linux_mac_capture_t (file (read append link unlink rename relabelto relabelfrom)))
(neverallow p4_linux_service_executor_t p4_linux_mac_calibration_dir_t (file (create open write append)))
(allow droidloom_policy_loader p4_linux_mac_capture_t (file (getattr write)))
(neverallow droidloom_policy_loader p4_linux_mac_capture_t (file (open read create append unlink link rename setattr relabelto relabelfrom)))
(neverallow droidloom_policy_loader p4_linux_mac_calibration_dir_t (dir (write add_name remove_name)))

; The loader hashes only the root-selected public platform media and configuration.
(typeattribute p4_linux_selected_release_readers)
(typeattributeset p4_linux_selected_release_readers (p4_linux_early_t droidloom_broker droidloom_policy_loader droidloom_container_entry_t))
(allow p4_linux_selected_release_readers p4_linux_mac_release_input_t (file (getattr open read)))
(allow init_t p4_linux_mac_release_input_t (file (getattr)))
(allow p4_linux_mac_roles p4_linux_mac_setup_lock_t (file (getattr open read lock)))
(neverallow droidloom_policy_loader p4_linux_mac_release_input_t (file (write append create unlink link rename setattr relabelto relabelfrom)))
(neverallow droidloom_policy_loader p4_linux_mac_setup_lock_t (file (write append create unlink link rename setattr relabelto relabelfrom)))
