; Same-source production activation consumes one live Complete and validates a
; genuinely fresh ordinary boot. These two roles inherit no native/working/domain
; authority. The fixed normal tools retain the role and have AppArmor path guards.
(type p4_linux_production_commit_t)
(roletype system_r p4_linux_production_commit_t)
(type p4_linux_production_verify_t)
(roletype system_r p4_linux_production_verify_t)
(type p4_linux_production_config_t)
(roletype object_r p4_linux_production_config_t)
(type p4_linux_production_record_dir_t)
(roletype object_r p4_linux_production_record_dir_t)
(type p4_linux_production_record_t)
(roletype object_r p4_linux_production_record_t)
(type p4_linux_production_activation_t)
(roletype object_r p4_linux_production_activation_t)
(type p4_linux_production_verify_unit_t)
(roletype object_r p4_linux_production_verify_unit_t)
(typeattribute p4_production_commit_actors)
(typeattributeset p4_production_commit_actors (p4_linux_production_commit_t p4_linux_production_verify_t))
(typeattributeset p4_all_board_owned (p4_linux_production_commit_t p4_linux_production_verify_t p4_linux_production_config_t p4_linux_production_record_dir_t p4_linux_production_record_t p4_linux_production_activation_t p4_linux_production_verify_unit_t))
(typeattributeset droidloom_public_control_peers (p4_linux_production_verify_t))

