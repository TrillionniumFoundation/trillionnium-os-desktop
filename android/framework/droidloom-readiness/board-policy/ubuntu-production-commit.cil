; Only the actual working parent may select live commit, and only the sealed
; manager executor selects the fixed normal verification/fallback unit.
(typeattribute p4_production_all_types)
(typeattributeset p4_production_all_types (all))
(typeattribute p4_production_not_parent)
(typeattributeset p4_production_not_parent (not (p4_linux_working_qualification_t)))
(typeattribute p4_production_not_executor)
(typeattributeset p4_production_not_executor (not (p4_linux_service_executor_t)))
(typeattribute p4_production_not_commit)
(typeattributeset p4_production_not_commit (not (p4_linux_production_commit_t)))
(typeattribute p4_production_not_verify)
(typeattributeset p4_production_not_verify (not (p4_linux_production_verify_t)))
(typeattribute p4_production_other_entries)
(typeattributeset p4_production_other_entries (not (droidloom_public_control_client_exec p4_linux_observed_client_exec_t)))
(typeattribute p4_production_other_file_ioctls)
(typeattributeset p4_production_other_file_ioctls (not (p4_kernel_ns_handle_t p4_kernel_pid_handle_t p4_linux_maintenance_grubenv_t)))
(typeattribute p4_production_other_service_mutation)
(typeattributeset p4_production_other_service_mutation (not (p4_linux_maintenance_reboot_unit_t)))
(typeattribute p4_production_other_device_bodies)
(typeattributeset p4_production_other_device_bodies (not (null_device)))
