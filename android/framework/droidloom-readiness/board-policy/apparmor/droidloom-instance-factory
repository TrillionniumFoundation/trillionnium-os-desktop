abi <abi/5.0>,
#include <tunables/global>
profile droidloom-instance-factory /usr/lib/droidloom/production/current/droidloomd flags=(attach_disconnected) {
  / r,
  /{etc,proc,sys,run,usr,usr/lib,var,var/lib,sys/fs}/ r,
  /etc/ld.so.cache r,
  /etc/systemd/{,system/} r,
  /etc/systemd/system/droidloom-instance-factory.service r,
  /{,usr/}lib{,64}/ld-linux-x86-64.so.2 mr,
  /{,usr/}lib/x86_64-linux-gnu/{ld-linux-x86-64.so.2,lib*.so*} mr,
  /usr/lib/droidloom/{,production/,production/current/} r,
  /usr/lib/droidloom/production/current/droidloomd mr,
  /etc/droidloom/{,production/,cohorts/,runtime-cohorts/} r,
  /etc/droidloom/{cell.json,container-launcher.json,production/selected.json,cohorts/*.json,runtime-cohorts/*.json} r,
  /etc/droidloom/setup.lock rk,
  /var/lib/droidloom/{,cohorts/,cohorts/*/,cohorts/*/images/,cohorts/*/board/} r,
  /var/lib/droidloom/cohorts/*/{images,board}/*.img r,
  /run/systemd/{,private,notify} rw,
  /run/droidloom-early/{,readiness/,kernel-policy/} r,
  /run/droidloom-early/ rw,
  /run/droidloom-early/instance-factory.sock rw,
  /run/droidloom-early/host-{pidns,userns,cgroupns} r,
  /run/droidloom-early/{factory.pending,factory.json} rw,
  /run/droidloom-early/startup.lock rk,
  /run/droidloom-early/{generation.pending,generation.json,resources.pending,resources.json,release,pidfd,pidns,mntns,userns,cgroupns-creation} rw,
  /run/droidloom-early/readiness/shutdown-request rw,
  /run/droidloom-early/kernel-policy/apparmor-epoch r,
  /run/droidloom-container/{,readiness.sock} r,
  /run/droidloom-early-slot/{,rootfs/} rw,
  /run/droidloom-early/private-dev/{,__properties__/} rw,
  /run/droidloom-early/private-dev/{null,random,urandom,zero,full,tty,fuse} rw,
  /dev/{,null,urandom,console} r,
  /dev/{null,console} w,
  /run/droidloom-early/loop-dev/{,loop-control,loop[0-9]*} rw,
  mount fstype=tmpfs -> /run/droidloom-early/loop-dev/,
  /sys/fs/selinux/{,enforce} r,
  @{PROC}/sys/kernel/random/boot_id r,
  @{PROC}/[0-9]*/{,status,stat,cgroup,mountinfo,exe,root/,attr/,attr/selinux/,attr/selinux/current,attr/apparmor/current} r,
  @{PROC}/[0-9]*/{ns/,ns/{pid,mnt,user,cgroup,ipc,net,uts},fd/,fd/[0-9]*,fdinfo/,fdinfo/[0-9]*} r,
  @{PROC}/[0-9]*/{uid_map,gid_map} rw,
  owner @{PROC}/[0-9]*/fd/[0-9]* rw,
  capability chown,
  capability fowner,
  capability setgid,
  capability setuid,
  capability sys_admin,
  capability sys_chroot,
  capability mknod,
  userns,
  ptrace (read, readby, trace, tracedby) peer=droidloom-instance-factory,
  ptrace (trace) peer=droidloom-production-android,
  change_profile -> droidloom-production-android,
  change_profile -> droidloom-native-hardware-label,
  signal (send) set=(kill) peer=droidloom-production-android,
  ptrace (read, readby) peer=droidloom-production-broker,
  ptrace (read, readby) peer=droidloom-instance-launcher,
  ptrace (read) peer=unconfined,
  signal (receive) peer=unconfined,
  signal (send, receive) peer=droidloom-instance-factory,
  deny unix (bind, listen, accept) addr="@**",
  deny unix (connect, send, receive) peer=(addr="@**"),
  network (create) unix seqpacket,
  unix (create, bind, listen, accept, send, receive, getattr, getopt, setopt, shutdown) type=seqpacket,
  network (create) unix stream,
  network (create) unix dgram,
  unix (create, connect, send, receive, getattr, getopt, setopt, shutdown) type=stream,
  unix (create, connect, send, receive, getattr, getopt, setopt) type=dgram,
  mount options=(rprivate) -> /,
  mount fstype=tmpfs -> /run/droidloom-early-slot/,
  mount fstype=tmpfs -> /run/droidloom-early/private-dev/,
  mount fstype=ext4 /proc/[0-9]*/fd/[0-9]* -> /**,
  mount options=(bind) /proc/[0-9]*/fd/[0-9]* -> /run/droidloom-early/{pidfd,pidns,mntns,userns,cgroupns-creation},
  mount options=(ro,bind,remount,nosuid,nodev,noexec) -> /run/droidloom-early/{pidfd,pidns,mntns,userns,cgroupns-creation},
  umount /run/droidloom-early/{pidfd,pidns,mntns,userns,cgroupns-creation},
  mount options=(bind) -> /run/droidloom-early/private-dev/{zero,full,tty,fuse},
  umount /run/droidloom-early/private-dev/{zero,full,tty,fuse},
  pivot_root /run/droidloom-early-slot/rootfs/,
  /run/droidloom-early-slot/rootfs/{,system/,system/bin/} r,
  /run/droidloom-early-slot/rootfs/system/bin/init r,
  /{system/,system/bin/} r,
  # This exact immutable/hash-verified ELF is the only exit from the creator.
  # Android retains its original SELinux init domain and original AppArmor
  # unconfined state. No broker or arbitrary host executable gets Ux.
  /system/bin/init rUx,
  # Fixed copied query bytes and their same original source. Birth has no
  # Binder pathname; its final CURRENT transition precedes NNP and exec.
  /system/bin/{cmd,toybox,toolbox,app_process64} r,
  /{system,run/droidloom-early-slot/rootfs/system}/framework/content.jar r,
  /{system,run/droidloom-early-slot/rootfs/system}/system_ext/framework/droidloom-input-bridge.jar r,
  /dev/droidloom-query/{,cmd,toybox,app_process64,content.jar} r,
  /run/droidloom-early-slot/rootfs/system/bin/{cmd,toybox,toolbox,app_process64} r,
  /run/droidloom-early-slot/rootfs/dev/{,droidloom-query/,droidloom-query/cmd,droidloom-query/toybox,droidloom-query/app_process64,droidloom-query/content.jar} r,
  /sys/fs/cgroup/{,system.slice/,system.slice/droidloom-production.service/,system.slice/droidloom-production.service/cell-u1000/} r,
  /sys/fs/cgroup/system.slice/droidloom-production.service/cell-u1000/application-read/{,cgroup.type,cgroup.subtree_control,cgroup.procs,memory.max,memory.high,memory.swap.max,pids.max,cpu.max} r,
  /sys/fs/cgroup/system.slice/droidloom-instance-factory.service/ r,
  /sys/fs/cgroup/system.slice/droidloom-instance-factory.service/cgroup.procs rw,
  /sys/fs/cgroup/system.slice/droidloom-production.service/cell-u1000/payload/ r,
  /sys/fs/cgroup/system.slice/droidloom-production.service/cell-u1000/payload/cgroup.procs rw,
  owner @{PROC}/[0-9]*/ns/pid_for_children r,
  # Fixed original CP3A ART input leaves for Contacts and Catalog.
  # The factory holds and rechecks each source-pinned read-only JAR;
  # intermediate components use O_PATH and expose no directory listing.
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.art/javalib/core-oj.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.art/javalib/core-libart.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.art/javalib/okhttp.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.art/javalib/bouncycastle.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.art/javalib/apache-xml.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/framework.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/framework-graphics.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/framework-location.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/ext.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/telephony-common.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/voip-common.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/ims-common.jar r,
  /{,run/droidloom-early-slot/rootfs/}system/framework/framework-ondeviceintelligence-platform.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.i18n/javalib/core-icu4j.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.adservices/javalib/framework-adservices.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.adservices/javalib/framework-sdksandbox.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.appsearch/javalib/framework-appsearch.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.bt/javalib/framework-bluetooth.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.configinfrastructure/javalib/framework-configinfrastructure.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.conscrypt/javalib/conscrypt.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.conscrypt/javalib/framework-conscrypt-nsc.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.crashrecovery/javalib/framework-crashrecovery.jar r,
