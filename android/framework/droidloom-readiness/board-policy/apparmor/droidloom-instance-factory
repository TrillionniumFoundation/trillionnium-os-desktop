abi <abi/5.0>,
#include <tunables/global>
profile droidloom-instance-factory /usr/lib/droidloom/production/current/droidloomd flags=(attach_disconnected) {
  / r,
  /{etc,proc,sys,run,usr,usr/lib,var,var/lib,sys/fs}/ r,
  /etc/ld.so.cache r,
  /{,usr/}lib{,64}/ld-linux-x86-64.so.2 mr,
  /{,usr/}lib/x86_64-linux-gnu/{ld-linux-x86-64.so.2,lib*.so*} mr,
  /usr/lib/droidloom/{,production/,production/current/} r,
  /usr/lib/droidloom/production/current/droidloomd mr,
  /etc/droidloom/{,production/,cohorts/,runtime-cohorts/} r,
  /etc/droidloom/{cell.json,container-launcher.json,production/selected.json,cohorts/*.json,runtime-cohorts/*.json} r,
  /etc/droidloom/setup.lock rk,
  /var/lib/droidloom/{,cohorts/,cohorts/*/,cohorts/*/images/,cohorts/*/board/} r,
  /var/lib/droidloom/cohorts/*/{images,board}/*.img r,
  /run/systemd/{,private,notify} rw,
  /run/droidloom-early/{,readiness/,kernel-policy/} r,
  /run/droidloom-early/ rw,
  /run/droidloom-early/instance-factory.sock rw,
  /run/droidloom-early/startup.lock rk,
  /run/droidloom-early/{generation.pending,generation.json,resources.pending,resources.json,release,pidfd,pidns,mntns,userns,cgroupns-creation} rw,
  /run/droidloom-early/readiness/shutdown-request rw,
  /run/droidloom-early/kernel-policy/apparmor-epoch r,
  /run/droidloom-container/{,readiness.sock} r,
  /run/droidloom-early-slot/{,rootfs/} rw,
  /run/droidloom-early/private-dev/{,__properties__/} rw,
  /run/droidloom-early/private-dev/{null,random,urandom,zero,full,tty,fuse} rw,
  /dev/{,null,urandom,console} r,
  /dev/{null,console} w,
  /run/droidloom-early/loop-dev/{,loop-control,loop[0-9]*} rw,
  mount fstype=tmpfs -> /run/droidloom-early/loop-dev/,
  /sys/fs/selinux/{,enforce} r,
  @{PROC}/sys/kernel/random/boot_id r,
  @{PROC}/[0-9]*/{,status,stat,cgroup,mountinfo,exe,root/,attr/,attr/selinux/,attr/selinux/current,attr/apparmor/current} r,
  @{PROC}/[0-9]*/{ns/,ns/{pid,mnt,user,cgroup,ipc,net,uts},fd/,fd/[0-9]*,fdinfo/,fdinfo/[0-9]*} r,
  @{PROC}/[0-9]*/{uid_map,gid_map} rw,
  owner @{PROC}/[0-9]*/fd/[0-9]* rw,
  capability chown,
  capability fowner,
  capability setgid,
  capability setuid,
  capability sys_admin,
  capability mknod,
  userns,
  ptrace (read, readby) peer=droidloom-instance-factory,
  ptrace (read, readby) peer=droidloom-production-broker,
  ptrace (read, readby) peer=droidloom-instance-launcher,
  ptrace (read) peer=unconfined,
  signal (receive) peer=unconfined,
  signal (send, receive) peer=droidloom-instance-factory,
  deny unix (bind, listen, accept) addr="@**",
  deny unix (connect, send, receive) peer=(addr="@**"),
  network (create) unix seqpacket,
  unix (create, bind, listen, accept, send, receive, getattr, getopt, setopt, shutdown) type=seqpacket,
  network (create) unix stream,
  network (create) unix dgram,
  unix (create, connect, send, receive, getattr, getopt, setopt, shutdown) type=stream,
  unix (create, connect, send, receive, getattr, getopt, setopt) type=dgram,
  mount options=(rprivate) -> /,
  mount fstype=tmpfs -> /run/droidloom-early-slot/,
  mount fstype=tmpfs -> /run/droidloom-early/private-dev/,
  mount fstype=ext4 /proc/[0-9]*/fd/[0-9]* -> /**,
  mount options=(bind) /proc/[0-9]*/fd/[0-9]* -> /run/droidloom-early/{pidfd,pidns,mntns,userns,cgroupns-creation},
  mount options=(ro,bind,remount,nosuid,nodev,noexec) -> /run/droidloom-early/{pidfd,pidns,mntns,userns,cgroupns-creation},
  umount /run/droidloom-early/{pidfd,pidns,mntns,userns,cgroupns-creation},
  mount options=(bind) -> /run/droidloom-early/private-dev/{zero,full,tty,fuse},
  umount /run/droidloom-early/private-dev/{zero,full,tty,fuse},
  pivot_root /run/droidloom-early-slot/rootfs/,
  /run/droidloom-early-slot/rootfs/{,system/,system/bin/} r,
  /run/droidloom-early-slot/rootfs/system/bin/init r,
  /{system/,system/bin/} r,
  # This exact immutable/hash-verified ELF is the only exit from the creator.
  # Android retains its original SELinux init domain and original AppArmor
  # unconfined state. No broker or arbitrary host executable gets Ux.
  /system/bin/init rUx,
}
