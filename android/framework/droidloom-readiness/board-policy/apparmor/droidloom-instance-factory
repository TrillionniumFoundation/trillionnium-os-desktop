  /{,run/droidloom-early-slot/rootfs/}apex/com.android.npumanager/javalib/framework-npumanager.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.ondevicepersonalization/javalib/framework-ondevicepersonalization.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.os.statsd/javalib/framework-statsd.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.permission/javalib/framework-permission.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.permission/javalib/framework-permission-s.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.profiling/javalib/framework-anomaly-detector.jar r,
  /{,run/droidloom-early-slot/rootfs/}apex/com.android.profiling/javalib/framework-profiling.jar r,
