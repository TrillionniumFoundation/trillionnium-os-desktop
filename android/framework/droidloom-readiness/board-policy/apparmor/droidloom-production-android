abi <abi/4.0>,
#include <tunables/global>
# Factory-owned queries enter this exact profile before no-new-privileges.
# The legacy application worker retains its existing broker stack.
# Kernel-created Android init keeps its original Android SELinux transition.
profile droidloom-production-android {
  /{,system/,system/bin/,system/lib64/,apex/} r,
  /system/bin/{linker64,app_process64} mrix,
  /apex/com.android.runtime/bin/linker64 mrix,
  /system/lib64/**.so mr,
  /apex/*/lib64/**.so mr,
  /dev/{null,zero,urandom} r,
  /dev/null w,
  /dev/{binder,hwbinder,vndbinder} rw,
  @{PROC}/[0-9]*/{status,attr/current,attr/apparmor/current,attr/selinux/current} r,
  signal (receive) peer=droidloom-production-broker,
  ptrace (readby, tracedby) peer=droidloom-production-broker,
  ptrace (readby, tracedby) peer=droidloom-instance-factory,
  signal (receive) set=(kill) peer=droidloom-instance-factory,
  /dev/socket/droidloom/shutdown-request r,
  # The four selected immutable roles and their ordinary Android loader inputs.
  /{dev/droidloom-query,.droidloom-query}/ r,
  /{dev/droidloom-query,.droidloom-query}/{cmd,toybox,app_process64} mrix,
  /{dev/droidloom-query,.droidloom-query}/content.jar r,
  /system/bin/{cmd,toybox,app_process64} r,
  /system/framework/content.jar r,
  /system/bin/linker64 mrix,
  /apex/com.android.runtime/bin/linker64 mrix,
  /system/lib64/**.so mr,
  /apex/*/lib64/**.so mr,
  /linkerconfig/{,ld.config.txt,apex.libraries.config.txt} r,
  /system/etc/{,ld.config.txt,ld.config.*.txt,public.libraries.txt} r,
  /apex/{,apex-info-list.xml} r,
  /dev/__properties__/{,**} r,
  /dev/{binder,hwbinder,vndbinder} rw,
  /data/app/**.apk r,
  /{system,product,system_ext,vendor}/{app,priv-app}/**.apk r,
}
