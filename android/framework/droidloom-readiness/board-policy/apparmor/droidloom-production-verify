# The fixed normal-boot verifier and its fixed fallback share one actor.
# History is read only; ACTIVE.json is the sole fresh activation record.
profile droidloom-production-verify flags=(attach_disconnected.path=/.droidloom-production-objects) {
  capability sys_ptrace,
  / r,
  /{etc,run,usr,usr/bin,usr/lib,proc,dev,sys,var,var/lib,boot}/ r,
  /etc/ld.so.cache r,
  /{,usr/}lib{,64}/ld-linux-x86-64.so.2 mr,
  /{,usr/}lib/x86_64-linux-gnu/{ld-linux-x86-64.so.2,lib*.so*} mr,
  /usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-259.so mr,
  /usr/bin/droidloom-applications mr,
  /usr/bin/{grub-editenv,systemctl} rix,
  /usr/bin/journalctl r,
  /etc/droidloom/{,production/,qualification/} r,
  /etc/droidloom/{cell.json,production/selected.json,qualification/working-return.json} r,
  /etc/droidloom/{production-commit.json,production-grub-prefix.cfg} r,
  /boot/{grub/,droidloom/,droidloom/production/} r,
  /boot/grub/{grub.cfg,custom.cfg} r,
  /boot/grub/grubenv rw,
  /boot/droidloom/production/@{droidloom_production_candidate}/{,initrd.img} r,
  /run/droidloom-early/ r,
  /run/droidloom-early/host-{userns,pidns} r,
  /run/droidloom-early/host-mount-identity.json r,
  /proc/cmdline r,
  /proc/sys/kernel/{osrelease,random/boot_id} r,
  owner /proc/{self,thread-self,[0-9]*}/ r,
  owner /proc/{self,thread-self,[0-9]*}/{stat,status,cgroup,cmdline,exe} r,
  owner /proc/{self,thread-self,[0-9]*}/fd/{,[0-9]*} r,
  owner /proc/{self,thread-self,[0-9]*}/fdinfo/{,[0-9]*} r,
  owner /proc/{self,thread-self,[0-9]*}/ns/{,user,mnt,pid} r,
  /{user,pid,mnt}:[0-9]* r,
  /.droidloom-production-objects/{,user:[0-9]*,pid:[0-9]*,mnt:[0-9]*} r,
  /sys/{,fs/,fs/selinux/,fs/selinux/enforce} r,
  /dev/{,disk/,disk/by-uuid/} r,
  /dev/disk/by-uuid/01c27223-3933-481e-9836-7bd0ef1be8c9 r,
  /dev/null rw,
  /var/lib/droidloom/{,qualification/} r,
  /var/lib/droidloom/qualification/production-commit-@{droidloom_production_candidate}/ rw,
  /run/systemd/{,private} rw,
  # Only normal PID1 and inherited service stdio; no public listener.
  unix (create, getattr, getopt, setopt, shutdown) type=stream,
  unix (connect, send, receive) type=stream peer=(label=unconfined),
  unix (send, receive) type=stream peer=(label=droidloom-ubuntu-journald),
  deny unix (bind, listen, accept) addr="@**",
  deny unix (connect, send, receive) peer=(addr="@**"),
  deny /proc/[0-9]*/{mem,maps,environ} rw,
  deny ptrace (trace, tracedby),
  signal (receive) peer=unconfined,
  /proc/[0-9]*/{stat,status,cgroup,cmdline,exe} r,
  ptrace (read) peer=droidloom-production-broker,
  ptrace (read, readby) peer=droidloom-production-verify,
  /usr/lib/droidloom/{,production/,production/current/} r,
  /usr/lib/droidloom/production/current/droidloomd r,
  /run/droidloom/ r,
  /run/droidloom/control.sock rw,
  unix (connect, send, receive) type=stream peer=(label=droidloom-production-broker),
  /usr/lib/systemd/{,system/} r,
  /usr/lib/systemd/system/droidloom-production-verify{,-return}.service r,
  /var/lib/droidloom/qualification/production-commit-@{droidloom_production_candidate}/{PLAN.json,SUMMARY.json,MAIN.json,STDERR.log,COMMIT.json,TRIAL.json,REQUEST.json} r,
  /var/lib/droidloom/qualification/production-commit-@{droidloom_production_candidate}/ACTIVE.json rw,
  /usr/bin/journalctl ix,
  /etc/{machine-id,passwd,group,nsswitch.conf,os-release} r,
  /usr/lib/os-release r,
  /{run,var}/log/ r,
  /{run,var}/log/journal/ r,
  /{run,var}/log/journal/@{droidloom_production_machine}/ r,
  /run/log/journal/@{droidloom_production_machine}/system.journal rmk,
  /run/log/journal/@{droidloom_production_machine}/system@@{droidloom_production_machine}-@{droidloom_production_hex16}-@{droidloom_production_hex16}.journal rmk,
  /run/log/journal/@{droidloom_production_machine}/system@@{droidloom_production_hex16}-@{droidloom_production_hex16}.journal~ rmk,
  /var/log/journal/@{droidloom_production_machine}/{system,user-@{droidloom_production_uid}}.journal rmk,
  /var/log/journal/@{droidloom_production_machine}/{system,user-@{droidloom_production_uid}}@@{droidloom_production_machine}-@{droidloom_production_hex16}-@{droidloom_production_hex16}.journal rmk,
  /var/log/journal/@{droidloom_production_machine}/{system,user-@{droidloom_production_uid}}@@{droidloom_production_hex16}-@{droidloom_production_hex16}.journal~ rmk,
  signal (send, receive) peer=droidloom-production-verify,
}
