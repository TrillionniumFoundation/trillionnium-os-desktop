abi <abi/5.0>,
#include <tunables/global>
profile droidloom-production-broker flags=(attach_disconnected.path=/.droidloom-kernel-apparmorfs) {
  # The consumer authenticates the sealed original AAFS objects before reading.
  # Only three synthetic paths gain read access; the object gate rejects aliases.
  /.droidloom-kernel-apparmorfs/raw_data/{164,165,166}/revision r,
  # Dynamic loader and NSS inputs used by the packaged Ubuntu executables.
  /etc/ld.so.cache r,
  /{,usr/}lib{,64}/ld-linux-x86-64.so.2 mr,
  /{,usr/}lib/x86_64-linux-gnu/{ld-linux-x86-64.so.2,lib*.so*} mr,
  /dev/{null,urandom} r,
  /dev/null w,
  /etc/{passwd,group,nsswitch.conf,subuid,subgid} r,
  / r,
  /{etc,proc,sys,run,usr,usr/lib,sys/fs,sys/kernel,sys/kernel/security}/ r,
  /etc/droidloom/{,host-mac/} r,
  /etc/droidloom/host-mac/{contract.json,derivation.json,policy.bin,policy-export.bin,manager-label.json} r,
  /run/droidloom-early/{,kernel-policy/,kernel-policy/apparmor-epoch} r,
  /sys/kernel/notes r,
  /sys/module/apparmor/parameters/enabled r,
  @{PROC}/sys/kernel/{osrelease,random/boot_id} r,
  /sys/kernel/security/lsm r,
  /sys/kernel/security/apparmor/{,policy/,policy/profiles/} r,
  /sys/kernel/security/apparmor/{.ns_name,.ns_level,.ns_stacked,.stacked,.policy,revision,profiles} r,
  /sys/kernel/security/apparmor/policy/profiles/droidloom-{production-broker,production-android,policy-loader}.[0-9]*/{,name,mode,sha256} r,
  /sys/fs/selinux/{,class/,class/**,policy,enforce,policyvers,status,mls,policy_capabilities/*} r,
  /sys/fs/selinux/{access,context,create} rw,
  @{PROC}/[0-9]*/{,status,stat,cgroup,mountinfo,uid_map,gid_map,setgroups,exe,cmdline,root/,attr/current,attr/apparmor/current,attr/selinux/current} r,
  owner @{PROC}/[0-9]*/task/[0-9]*/{,status,stat,attr/,attr/{current,apparmor/,selinux/,apparmor/current,selinux/current},ns/,ns/{user,pid},fdinfo/,fdinfo/[0-9]*} r,
  @{PROC}/[0-9]*/{ns/,ns/{user,mnt,pid,ipc,cgroup,net,uts},fdinfo/,fdinfo/[0-9]*} r,
  /usr/lib/droidloom/{,production/,production/current/} r,
  /usr/lib/systemd/systemd r,
  /usr/lib/droidloom/production/current/droidloomd mrix,
  capability chown,
  capability dac_override,
  capability dac_read_search,
  capability fowner,
  capability setgid,
  capability setuid,
  capability sys_admin,
  capability mknod,
  userns,
  ptrace (read, readby) peer=droidloom-production-broker,
  ptrace (read) peer=unconfined,
  signal (receive) peer=unconfined,
  signal (send, receive) peer=droidloom-production-broker,
  signal (send) set=(term,kill,cont) peer=unconfined,
  change_profile -> &droidloom-production-android,
  @{PROC}/[0-9]*/attr/{apparmor/current,selinux/exec} w,
  /etc/droidloom/{cell.json,production/,production/selected.json,cohorts/,cohorts/*.json,runtime-cohorts/,runtime-cohorts/*.json} r,
  /run/{droidloom/,droidloom-early/,droidloom-container/} r,
  /run/droidloom/{control.sock,} rw,
  /run/droidloom-early/{generation.json,resources.json,mntns,pidns,userns,readiness/} r,
  /run/droidloom-early/{release,cgroupns-creation} w,
  /run/droidloom-early/readiness/{droidloom_readiness,} rw,
  /run/droidloom-container/** rw,
  /run/systemd/{,system/} r,
  /run/systemd/{private,notify} rw,
  # Runtime endpoints have package-owned filesystem names or are unnamed socketpairs.
  deny unix (bind, listen, accept) addr="@**",
  deny unix (connect, send, receive) peer=(addr="@**"),
  network (create) unix stream,
  network (create) unix seqpacket,
  network (create) unix dgram,
  unix (create, getattr, getopt, setopt, shutdown) type=stream,
  unix (create, getattr, getopt, setopt, shutdown) type=seqpacket,
  unix (connect, send, receive) type=seqpacket peer=(label=droidloom-production-broker),
  unix (create, getattr, getopt, setopt) type=dgram,
  @{PROC}/meminfo r,
  /var/{,lib/,lib/droidloom/} r,
  /var/lib/droidloom/{cohorts/,runtime-cohorts/,cohorts/*/,cohorts/*/images/,runtime-cohorts/*/,runtime-cohorts/*/images/} r,
  /var/lib/droidloom/{cohorts,runtime-cohorts}/*/images/*.img r,
  /var/lib/droidloom/{users/,users/[0-9]*/,users/[0-9]*/data/,identity-reservations/} r,
  /var/lib/droidloom/identity-reservations/** rk,
  /var/lib/droidloom/users/[0-9]*/data/data.img rwk,
  /dev/{,loop-control,loop[0-9]*} r,
  /dev/{loop-control,loop[0-9]*} w,
  /dev/{zero,full,random,tty} r,
  /sys/{class/,class/block/,block/,devices/,devices/virtual/,devices/virtual/block/} r,
  /sys/devices/virtual/block/loop[0-9]*/{,dev,ro,size,loop/,loop/backing_file,loop/offset,loop/sizelimit} r,
  /sys/fs/cgroup/{,cgroup.controllers,cgroup.subtree_control,system.slice/,system.slice/cgroup.controllers} r,
  /sys/fs/cgroup/system.slice/droidloom-production.service/{,**/} rw,
  /sys/fs/cgroup/system.slice/droidloom-production.service/{,**/}{cgroup.*,cpu.*,cpuset.*,io.*,memory.*,pids.*} r,
  /sys/fs/cgroup/system.slice/droidloom-production.service/{,**/}{cgroup.procs,cgroup.subtree_control,cpuset.cpus,cpuset.mems} w,
  mount options=(bind) /run/droidloom-early/readiness/ -> /dev/socket/droidloom/,
  mount options=(bind) /sys/fs/cgroup/system.slice/droidloom-production.service/payload/ -> /sys/fs/cgroup/,
  umount /run/droidloom-early/rootfs/,
  /run/droidloom-early/readiness/shutdown-request rw,
}
