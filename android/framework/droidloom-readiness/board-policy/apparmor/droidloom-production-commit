@{droidloom_production_candidate}=[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]

# The only entry is the live Complete parent's fixed onexec transition.
# Four readonly inherited files remain the original captured inodes.
profile droidloom-production-commit flags=(attach_disconnected.path=/.droidloom-production-objects) {
  capability sys_ptrace,
  / r,
  /{etc,run,usr,usr/bin,usr/lib,proc,dev,sys,var,var/lib,boot}/ r,
  /etc/ld.so.cache r,
  /{,usr/}lib{,64}/ld-linux-x86-64.so.2 mr,
  /{,usr/}lib/x86_64-linux-gnu/{ld-linux-x86-64.so.2,lib*.so*} mr,
  /usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-259.so mr,
  /usr/bin/droidloom-applications mr,
  /usr/bin/{grub-editenv,systemctl} rix,
  /usr/bin/journalctl r,
  /etc/droidloom/{,production/,qualification/} r,
  /etc/droidloom/{cell.json,production/selected.json,qualification/working-return.json} r,
  /etc/droidloom/{production-commit.json,production-grub-prefix.cfg} r,
  /boot/{grub/,droidloom/,droidloom/production/} r,
  /boot/grub/{grub.cfg,custom.cfg} r,
  /boot/grub/grubenv rw,
  /boot/droidloom/production/@{droidloom_production_candidate}/{,initrd.img} r,
  /run/droidloom-early/ r,
  /run/droidloom-early/host-{userns,pidns} r,
  /run/droidloom-early/host-mount-identity.json r,
  /proc/cmdline r,
  /proc/sys/kernel/{osrelease,random/boot_id} r,
  owner /proc/{self,thread-self,[0-9]*}/ r,
  owner /proc/{self,thread-self,[0-9]*}/{stat,status,cgroup,cmdline,exe} r,
  owner /proc/{self,thread-self,[0-9]*}/fd/{,[0-9]*} r,
  owner /proc/{self,thread-self,[0-9]*}/fdinfo/{,[0-9]*} r,
  owner /proc/{self,thread-self,[0-9]*}/ns/{,user,mnt,pid} r,
  /{user,pid,mnt}:[0-9]* r,
  /.droidloom-production-objects/{,user:[0-9]*,pid:[0-9]*,mnt:[0-9]*} r,
  /sys/{,fs/,fs/selinux/,fs/selinux/enforce} r,
  /dev/{,disk/,disk/by-uuid/} r,
  /dev/disk/by-uuid/01c27223-3933-481e-9836-7bd0ef1be8c9 r,
  /dev/null rw,
  /var/lib/droidloom/{,qualification/} r,
  /var/lib/droidloom/qualification/production-commit-@{droidloom_production_candidate}/ rw,
  /run/systemd/{,private} rw,
  # Only normal PID1 and inherited service stdio; no public listener.
  unix (create, getattr, getopt, setopt, shutdown) type=stream,
  unix (connect, send, receive) type=stream peer=(label=unconfined),
  unix (send, receive) type=stream peer=(label=droidloom-ubuntu-journald),
  deny unix (bind, listen, accept) addr="@**",
  deny unix (connect, send, receive) peer=(addr="@**"),
  deny /proc/[0-9]*/{mem,maps,environ} rw,
  deny ptrace (trace, tracedby),
  signal (receive) peer=unconfined,
  /proc/[0-9]*/{stat,status,cgroup,cmdline,exe} r,
  ptrace (read, readby) peer=droidloom-working-qualification,
  ptrace (read) peer=droidloom-production-commit,
  ptrace (readby) peer=droidloom-production-commit,
  /var/lib/droidloom-qualification/ r,
  /var/lib/droidloom-qualification/physical-@{droidloom_production_candidate}/ r,
  /var/lib/droidloom-qualification/physical-@{droidloom_production_candidate}/{PLAN.json,applications.stdout,applications.stderr,MAIN-BINDING.json} r,
  /var/lib/droidloom/qualification/production-commit-@{droidloom_production_candidate}/{PLAN.json,SUMMARY.json,MAIN.json,STDERR.log,COMMIT.json,TRIAL.json,REQUEST.json} rw,
  unix (getattr, getopt, setopt, shutdown) type=seqpacket,
  unix (send, receive) type=seqpacket peer=(label=droidloom-working-qualification),
  unix (create, getattr, getopt, setopt, shutdown) type=dgram,
  /run/systemd/journal/ r,
  /run/systemd/journal/socket w,
  unix (send) type=dgram peer=(label=droidloom-ubuntu-journald),
  signal (send, receive) peer=droidloom-production-commit,
  signal (send) set=(chld) peer=droidloom-working-qualification,
  signal (receive) peer=droidloom-working-qualification,
}
