abi <abi/5.0>,
#include <tunables/global>
# The sole parent keeps the already armed Software watchdog. Its children
# close that FD before the two fixed onexec transitions and have no node grant.
profile droidloom-working-qualification flags=(attach_disconnected.path=/.droidloom-working-objects) {
  # Fixed 0/1000 filesystem-credential scope; no DAC override.
  capability setuid,
  capability setgid,
  capability sys_ptrace,
  / r,
  /{etc,run,usr,usr/bin,usr/lib,proc,dev,sys,var,var/lib}/ r,
  /etc/ld.so.cache r,
  /{,usr/}lib{,64}/ld-linux-x86-64.so.2 mr,
  /{,usr/}lib/x86_64-linux-gnu/{ld-linux-x86-64.so.2,lib*.so*} mr,
  /usr/lib/x86_64-linux-gnu/systemd/libsystemd-shared-259.so mr,
  /usr/lib/droidloom/{,production/,production/current/} r,
  /usr/bin/droidloom-applications mr,
  /usr/lib/droidloom/production/current/droidloomd r,
  /usr/bin/droidloom-wayland r,
  /usr/lib/systemd/systemd r,
  /usr/lib/systemd/{,system/} r,
  /usr/lib/systemd/system/droidloom-working-qualification{,-return}.service r,
  /etc/{passwd,group,machine-id,nsswitch.conf,os-release} r,
  /usr/lib/os-release r,
  /etc/droidloom/{,production/,qualification/} r,
  /etc/droidloom/{cell.json,production/selected.json,qualification/working-return.json} r,
  /run/droidloom-early/ r,
  /run/droidloom-early/host-{userns,pidns} r,
  /run/droidloom-early/host-mount-identity.json r,
  /proc/cmdline r,
  /proc/sys/kernel/{osrelease,random/boot_id} r,
  owner /proc/{self,thread-self,[0-9]*}/ r,
  owner /proc/{self,thread-self,[0-9]*}/{stat,status,cgroup,cmdline,uid_map,gid_map,setgroups,mountinfo,exe} r,
  owner /proc/{self,thread-self,[0-9]*}/fd/{,[0-9]*} r,
  owner /proc/{self,thread-self,[0-9]*}/ns/{,user,mnt,pid,pid_for_children,net,ipc,uts,cgroup} r,
  owner /proc/{self,thread-self,[0-9]*}/attr/{,selinux/,apparmor/,selinux/current,apparmor/current,current} r,
  owner /proc/[0-9]*/task/[0-9]*/{,stat,status,attr/,attr/selinux/,attr/apparmor/,attr/selinux/current,attr/apparmor/current} r,
  /{user,pid,mnt,net,ipc,uts,cgroup}:[0-9]* r,
  /.droidloom-working-objects/{,user:[0-9]*,pid:[0-9]*,mnt:[0-9]*,net:[0-9]*,ipc:[0-9]*,uts:[0-9]*,cgroup:[0-9]*} r,
  /sys/{,fs/,fs/selinux/,fs/selinux/enforce} r,
  /sys/module/{,apparmor/,apparmor/parameters/,apparmor/parameters/enabled} r,
  /sys/devices/{,virtual/,virtual/watchdog/,virtual/watchdog/watchdog[0-9]*/} r,
  /sys/devices/virtual/watchdog/watchdog[0-9]*/{identity,state,nowayout,timeout,dev} r,
  /dev/{,disk/,disk/by-uuid/} r,
  /dev/disk/by-uuid/* r,
  /dev/null rw,
  /sys/fs/cgroup/{,system.slice/} r,
  /sys/fs/cgroup/system.slice/droidloom-working-qualification{,-return}.service/ r,
  /sys/fs/cgroup/system.slice/droidloom-working-qualification{,-return}.service/{cgroup.events,cgroup.procs,cgroup.type,cpu.max,cpuset.cpus.effective,cpuset.mems.effective,memory.current,memory.max,memory.swap.max,pids.current,pids.max} r,
  /var/lib/droidloom/{,qualification/,qualification/working-qualification-[0-9a-f]*/} r,
  /var/lib/droidloom/qualification/working-qualification-[0-9a-f]*/runtime-evidence/ r,
  /var/lib/droidloom/qualification/working-qualification-[0-9a-f]*/runtime-evidence/{OWNER-START.json,OWNER-FAILURE.json,PREPARATION-OWNER-RESULT.json,PREPARATION.stdout,PREPARATION.stderr,PHYSICAL-OWNER-RESULT.json} r,
  # Read-mode metadata of the actual broker and opaque Main only.
  # The matching SELinux rule names only those concrete process types.
  /proc/[0-9]*/{stat,status,cgroup,cmdline,uid_map,gid_map,setgroups,mountinfo,exe,root/} r,
  /proc/[0-9]*/ns/{,user,mnt,pid,pid_for_children,net,ipc,uts,cgroup} r,
  /proc/[0-9]*/attr/{,current,selinux/,apparmor/,selinux/current,apparmor/current} r,
  deny /proc/[0-9]*/{mem,maps,environ} rw,
  deny ptrace (trace, tracedby),
  ptrace (read) peer=unconfined,
  ptrace (read) peer=droidloom-production-broker,
  ptrace (read) peer=droidloom-production-android,
  ptrace (read) peer=droidloom-working-qualification,
  ptrace (read) peer=droidloom-working-privateprep,
  ptrace (read) peer=droidloom-working-application,
  ptrace (readby) peer=droidloom-working-qualification,
  ptrace (readby) peer=droidloom-working-privateprep,
  ptrace (readby) peer=droidloom-working-application,

  /run/droidloom/ r,
  /run/droidloom/control.sock rw,
  deny unix (bind, listen, accept) addr="@**",
  deny unix (connect, send, receive) peer=(addr="@**"),
  unix (create, getattr, getopt, setopt, shutdown) type=stream,
  unix (create, getattr, getopt, setopt, shutdown) type=seqpacket,
  unix (connect, send, receive) type=seqpacket peer=(label=droidloom-working-qualification),
  unix (connect, send, receive) type=seqpacket peer=(label=droidloom-working-privateprep),
  unix (connect, send, receive) type=seqpacket peer=(label=droidloom-working-application),
  unix (create, getattr, getopt, setopt, shutdown) type=dgram,
  unix (connect, send, receive) type=dgram peer=(label=droidloom-working-privateprep),
  unix (connect, send, receive) type=dgram peer=(label=droidloom-working-application),
  # Sealed comparison memfds have this disconnected kernel path. SELinux
  # separately forbids execute/map and every unrelated anonymous body.
  /.droidloom-working-objects/ rw,

  /usr/libexec/{,droidloom/,droidloom/native-application-leaves/,droidloom/native-application-leaves/cohorts/} r,
  /usr/libexec/droidloom/native-application-leaves/cohorts/cp3a-20261126-apps-r2/{,**/} r,
  /usr/libexec/droidloom/native-application-leaves/cohorts/cp3a-20261126-apps-r2/** r,
  /etc/droidloom/native-application-leaves/{,catalogs/,current-preimages/,releases/} r,
  /etc/droidloom/native-application-leaves/{catalogs,current-preimages,releases}/{.layout,[0-9a-f]*.json} r,
  /home/{,alex/,alex/work/,alex/work/pocket4-android-final/} r,
  /home/alex/work/pocket4-android-final/CONTINUATION_CURRENT.json r,
  /var/lib/droidloom-qualification/ r,
  /var/lib/droidloom-qualification/physical-[0-9a-f]*/{,PLAN.json} r,
  # Only the four held package directory metadata paths, never their bodies.
  /{,.droidloom-working-objects/}data/{,user/,user_de/,system_ce/,system_de/} r,
  /{,.droidloom-working-objects/}data/{user,user_de,system_ce,system_de}/0/{,*/} r,

  /usr/bin/droidloom-applications ix,
  change_profile /usr/bin/droidloom-applications -> droidloom-working-privateprep,
  change_profile /usr/bin/droidloom-applications -> droidloom-working-application,
  owner /proc/{self,thread-self,[0-9]*}/attr/{selinux/exec,apparmor/exec} rw,
  owner /proc/[0-9]*/task/[0-9]*/attr/{selinux/exec,apparmor/exec} rw,
  /sys/fs/cgroup/system.slice/droidloom-working-qualification.service/{cpu.max,memory.max} w,
  /dev/watchdog{[0-9],[0-9][0-9],[0-9][0-9][0-9]} w,
  /run/systemd/{,private} rw,
  /var/lib/droidloom/qualification/working-qualification-[0-9a-f]*/runtime-evidence/ w,
  /var/lib/droidloom/qualification/working-qualification-[0-9a-f]*/runtime-evidence/{OWNER-START.json,OWNER-FAILURE.json,PREPARATION-OWNER-RESULT.json,PREPARATION.stdout,PREPARATION.stderr,PHYSICAL-OWNER-RESULT.json} wk,
  /var/lib/droidloom-qualification/ w,
  /var/lib/droidloom-qualification/physical-[0-9a-f]*/ rw,
  /var/lib/droidloom-qualification/physical-[0-9a-f]*/PLAN.json wk,
  /home/alex/work/pocket4-android-final/ rw,
  /home/alex/work/pocket4-android-final/{.CONTINUATION_CURRENT.lock,.qpr1-kernel-control-8b88.lock} rk,
  /home/alex/work/pocket4-android-final/{CONTINUATION_CURRENT.json,.working-native-source-[0-9]*-[0-9a-f]*.new} rwk,
  /etc/droidloom/native-application-leaves/{catalogs,current-preimages,releases}/ w,
  /etc/droidloom/native-application-leaves/{catalogs,current-preimages,releases}/[0-9a-f]*.json w,
  signal (receive) peer=unconfined,
  signal (send, receive) peer=droidloom-working-qualification,
  signal (send) peer=droidloom-working-privateprep,
  signal (send) peer=droidloom-working-application,
  # BEGIN fixed production Complete handoff (closed by verify_production_commit.py)
  /etc/droidloom/production-commit.json r,
  change_profile /usr/bin/droidloom-applications -> droidloom-production-commit,
  ptrace (read, readby) peer=droidloom-production-commit,
  unix (send, receive) type=seqpacket peer=(label=droidloom-production-commit),
  signal (send, receive) peer=droidloom-production-commit,
  /var/lib/droidloom-qualification/physical-[0-9a-f]*/{applications.stdout,applications.stderr,MAIN-BINDING.json} rw,
  # END fixed production Complete handoff
}
