(type droidloom_shutdown)
(roletype r droidloom_shutdown)
(typeattributeset domain (droidloom_shutdown))
(typeattributeset coredomain (droidloom_shutdown))
(type droidloom_shutdown_exec)
(roletype object_r droidloom_shutdown_exec)
(typeattributeset file_type (droidloom_shutdown_exec))
(typeattributeset exec_type (droidloom_shutdown_exec))
(typeattributeset system_file_type (droidloom_shutdown_exec))
(typetransition init droidloom_shutdown_exec process droidloom_shutdown)
(allow init droidloom_shutdown (process (transition)))
(allow init droidloom_shutdown_exec (file (read open execute map getattr)))
(allow droidloom_shutdown droidloom_shutdown_exec (file (entrypoint execute open read getattr map)))
(allow droidloom_shutdown init (process (sigchld)))

(type droidloom_shutdown_request_prop)
(roletype object_r droidloom_shutdown_request_prop)
(typeattributeset property_type (droidloom_shutdown_request_prop))
(typeattributeset system_property_type (droidloom_shutdown_request_prop))
(typeattributeset system_internal_property_type (droidloom_shutdown_request_prop))
(allow droidloom_shutdown property_socket (sock_file (write)))
(allow droidloom_shutdown init (unix_stream_socket (connectto)))
(allow droidloom_shutdown droidloom_shutdown_request_prop (property_service (set)))
(allow droidloom_shutdown droidloom_shutdown_request_prop (file (getattr open read map)))

(typeattribute droidloom_shutdown_other_props)
(typeattributeset droidloom_shutdown_other_props (and (property_type) (not (droidloom_shutdown_request_prop))))
(neverallow droidloom_shutdown droidloom_shutdown_other_props (property_service (set)))
(neverallow droidloom_shutdown property_type (file (create write append relabelfrom relabelto)))
(typeattribute droidloom_shutdown_protected_processes)
(typeattributeset droidloom_shutdown_protected_processes (init zygote servicemanager system_server kernel p4_linux_procs))
(neverallow droidloom_shutdown droidloom_shutdown_protected_processes (process (transition dyntransition ptrace signal setcurrent setexec)))
(neverallow droidloom_shutdown self (capability (sys_admin sys_boot sys_ptrace dac_override)))
(neverallow droidloom_readiness droidloom_shutdown_request_prop (property_service (set)))
(neverallow untrusted_app_all droidloom_shutdown_request_prop (property_service (set)))
(neverallow p4_linux_procs droidloom_shutdown_request_prop (property_service (set)))

(type p4_android_shutdown_request_t)
(roletype object_r p4_android_shutdown_request_t)
(typeattributeset p4_linux_data (p4_android_shutdown_request_t))
(allow p4_android_shutdown_request_t tmpfs (filesystem (associate)))
(typetransition kernel p4_linux_readiness_dir_t file "shutdown-request" p4_android_shutdown_request_t)
(allow kernel p4_linux_readiness_dir_t (dir (search write add_name)))
(allow kernel p4_android_shutdown_request_t (file (create open getattr read write setattr)))
(allow droidloom_broker p4_android_shutdown_request_t (file (open getattr read write)))
(allow droidloom_shutdown p4_linux_readiness_dir_t (dir (search)))
(allow droidloom_shutdown p4_android_shutdown_request_t (file (open getattr read watch)))
(allow droidloom_shutdown tmpfs (filesystem (getattr)))
(typeattribute p4_shutdown_readonly_roles)
(typeattributeset p4_shutdown_readonly_roles (not (or (droidloom_broker) (kernel))))
(neverallow p4_shutdown_readonly_roles p4_android_shutdown_request_t (file (create write append setattr unlink link rename relabelfrom relabelto)))
(neverallow droidloom_broker p4_android_shutdown_request_t (file (create append setattr unlink rename link relabelfrom relabelto)))
(neverallow droidloom_shutdown p4_linux_readiness_dir_t (dir (open read add_name remove_name write mounton relabelfrom relabelto)))
(neverallow droidloom_shutdown droidloom_readiness_socket (sock_file (write)))

(typeattribute p4_linux_nonstop_data)
(typeattributeset p4_linux_nonstop_data (and (p4_linux_data) (not (p4_android_shutdown_request_t))))
(typeattribute p4_other_stop_readers)
(typeattribute p4_allowed_stop_readers)
(typeattributeset p4_allowed_stop_readers (kernel droidloom_broker droidloom_shutdown))
(typeattributeset p4_other_stop_readers (not (p4_allowed_stop_readers)))
(neverallow p4_other_stop_readers p4_android_shutdown_request_t (file (open read watch)))
