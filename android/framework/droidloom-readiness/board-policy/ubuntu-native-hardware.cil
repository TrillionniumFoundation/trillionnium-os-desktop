; Native graphics and evdev are distinct from Android's original device types.
; The original logind controller/seat protocol still owns card/input FDs.
(type p4_linux_drm_dir_t)
(type p4_linux_drm_card_t)
(type p4_linux_drm_render_t)
(type p4_linux_input_dir_t)
(type p4_linux_input_event_t)
(typeattribute p4_native_hardware_dirs)
(typeattribute p4_native_hardware_nodes)
(typeattributeset p4_native_hardware_dirs (p4_linux_drm_dir_t p4_linux_input_dir_t))
(typeattributeset p4_native_hardware_nodes (p4_linux_drm_card_t p4_linux_drm_render_t p4_linux_input_event_t))
(typeattributeset p4_linux_data (p4_native_hardware_dirs p4_native_hardware_nodes))
(roletype object_r p4_linux_drm_dir_t)
(roletype object_r p4_linux_drm_card_t)
(roletype object_r p4_linux_drm_render_t)
(roletype object_r p4_linux_input_dir_t)
(roletype object_r p4_linux_input_event_t)
(allow p4_native_hardware_dirs device (filesystem (associate)))
(allow p4_native_hardware_nodes device (filesystem (associate)))

; A fixed first udev PROGRAM labels only held, checked devtmpfs inodes before
; input_id/keyboard builtins run. It cannot open any hardware device body.
; Other droidloomd modes fail closed in this automatic entry role.
(type p4_linux_hardware_label_t)
(roletype system_r p4_linux_hardware_label_t)
(typeattributeset p4_linux_procs (p4_linux_hardware_label_t))
(typeattributeset p4_native_device_directory_relabelers (p4_linux_hardware_label_t))
(typetransition p4_linux_udev_t droidloom_container_entry_exec_t process p4_linux_hardware_label_t)
(allow p4_linux_udev_t droidloom_container_entry_exec_t (file (getattr open read execute map)))
(allow p4_linux_udev_t p4_linux_hardware_label_t (process (transition getattr signal sigkill)))
(allow p4_linux_hardware_label_t p4_linux_udev_t (process (sigchld)))
(allow p4_linux_hardware_label_t droidloom_container_entry_exec_t (file (getattr open read execute map entrypoint)))
(allow p4_linux_hardware_label_t self (process (getattr getcap setcap)))
(allow p4_linux_hardware_label_t self (fd (use)))
(allow p4_linux_hardware_label_t p4_linux_udev_t (fd (use)))
(allow p4_linux_hardware_label_t p4_linux_service_executor_t (fd (use)))
(allow p4_linux_hardware_label_t p4_linux_udev_t (fifo_file (getattr read write)))
(allow p4_linux_hardware_label_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_hardware_label_t p4_linux_etc_dir_t (dir (getattr search)))
(allow p4_linux_hardware_label_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_hardware_label_t p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_hardware_label_t p4_linux_host_config_t (file (getattr open read)))
(allow p4_linux_hardware_label_t p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_linux_hardware_label_t p4_linux_standardio_t (chr_file (getattr read write)))
(allow p4_linux_hardware_label_t null_device (chr_file (getattr read write)))
(allow p4_linux_hardware_label_t p4_linux_run_t (dir (getattr search)))
(allow p4_linux_hardware_label_t p4_linux_early_handoff_dir_t (dir (getattr search)))
(allow p4_linux_hardware_label_t p4_kernel_ns_handle_t (file (getattr open read ioctl)))
(allowx p4_linux_hardware_label_t p4_kernel_ns_handle_t (ioctl file (0xb703)))
(allow p4_linux_hardware_label_t p4_kernel_ns_handle_t (filesystem (getattr)))
(allow p4_linux_hardware_label_t p4_linux_native_dev_root_t (dir (getattr search)))
(allow p4_linux_hardware_label_t device (filesystem (getattr)))
(allow p4_linux_hardware_label_t device (dir (getattr search relabelfrom)))
(allow p4_linux_hardware_label_t device (chr_file (getattr relabelfrom)))
(allow p4_linux_hardware_label_t p4_native_hardware_dirs (dir (getattr search relabelto relabelfrom)))
(allow p4_linux_hardware_label_t p4_native_hardware_nodes (chr_file (getattr relabelto relabelfrom)))
; Concurrent hotplug PROGRAMs may label the same parent. A repeated write may
; retain the same type, but the helper may not convert one hardware type into
; another. The original generic device type is the only initial source.
(validatetrans dir (or (neq t3 p4_linux_hardware_label_t) (or (eq t1 device) (eq t1 t2))))
(validatetrans chr_file (or (neq t3 p4_linux_hardware_label_t) (or (eq t1 device) (eq t1 t2))))

(typeattribute p4_native_hardware_all_types)
(typeattributeset p4_native_hardware_all_types (all))
(typeattribute p4_native_hardware_not_dirs)
(typeattributeset p4_native_hardware_not_dirs (and (all) (not (p4_native_hardware_dirs))))
(typeattribute p4_native_hardware_not_nodes)
(typeattributeset p4_native_hardware_not_nodes (and (all) (not (p4_native_hardware_nodes))))
(neverallow p4_linux_hardware_label_t p4_native_hardware_not_dirs (dir (relabelto)))
(neverallow p4_linux_hardware_label_t p4_native_hardware_not_nodes (chr_file (relabelto)))
(neverallow p4_linux_hardware_label_t p4_native_hardware_all_types (dir (write create add_name remove_name rmdir mounton setattr)))
(neverallow p4_linux_hardware_label_t p4_native_hardware_all_types (file (create write append setattr unlink link rename relabelto relabelfrom execute_no_trans)))
(neverallow p4_linux_hardware_label_t p4_native_hardware_nodes (chr_file (open read write append ioctl map create setattr unlink)))
(neverallow p4_linux_hardware_label_t device (chr_file (open read write append ioctl map create setattr unlink)))
(neverallow p4_linux_hardware_label_t self (process (fork dyntransition setcurrent setexec setfscreate setsockcreate setkeycreate)))
(neverallow p4_linux_hardware_label_t self (capability (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap linux_immutable net_bind_service net_broadcast net_admin net_raw ipc_lock ipc_owner sys_module sys_rawio sys_chroot sys_ptrace sys_pacct sys_admin sys_boot sys_nice sys_resource sys_time sys_tty_config mknod lease audit_write audit_control setfcap)))
(neverallow p4_linux_hardware_label_t self (capability2 (mac_override mac_admin syslog wake_alarm block_suspend audit_read perfmon bpf checkpoint_restore)))
(neverallow p4_linux_hardware_label_t self (cap_userns (chown dac_override dac_read_search fowner fsetid kill setgid setuid setpcap linux_immutable net_bind_service net_broadcast net_admin net_raw ipc_lock ipc_owner sys_module sys_rawio sys_chroot sys_ptrace sys_pacct sys_admin sys_boot sys_nice sys_resource sys_time sys_tty_config mknod lease audit_write audit_control setfcap)))
(neverallow p4_linux_hardware_label_t kernel (security (load_policy setenforce setbool setsecparam setcheckreqprot read_policy)))

; Native libdrm and logind discover only read-only sysfs and udev metadata.
(typeattributeset p4_native_sysfs_readers (p4_linux_logind_t p4_linux_compositor_t p4_linux_user_session_t droidloom_presenter))
(typeattribute p4_native_hardware_discovery)
(typeattributeset p4_native_hardware_discovery (p4_linux_logind_t p4_linux_compositor_t p4_linux_user_session_t droidloom_presenter))
(allow p4_native_hardware_discovery p4_native_hardware_dirs (dir (getattr search open read)))
(allow p4_native_hardware_discovery p4_native_hardware_dirs (lnk_file (getattr read)))
(allow p4_native_hardware_discovery p4_native_hardware_nodes (chr_file (getattr)))
(allow p4_linux_udev_t p4_native_hardware_dirs (dir (getattr search open read create write add_name remove_name rmdir setattr relabelfrom relabelto)))
(allow p4_linux_udev_t p4_native_hardware_dirs (lnk_file (create getattr read setattr unlink)))
(allow p4_linux_udev_t p4_native_hardware_nodes (chr_file (getattr setattr relabelfrom relabelto)))
(typeattribute p4_native_seat_metadata_readers)
(typeattributeset p4_native_seat_metadata_readers (p4_linux_logind_t p4_linux_compositor_t))
(allow p4_native_seat_metadata_readers p4_linux_udev_run_t (dir (getattr search)))
(allow p4_native_seat_metadata_readers p4_linux_udev_state_t (dir (getattr search open read)))
(allow p4_native_seat_metadata_readers p4_linux_udev_state_t (file (getattr open read)))
(allow p4_native_seat_metadata_readers p4_linux_udev_state_t (lnk_file (getattr read)))

; Original kernel devtmpfs workers use actual vfs_mknod/mkdir/unlink/rmdir.
; The common native /dev root must permit the original metadata operations.
(allow kernel p4_linux_native_dev_root_t (dir (write add_name remove_name)))
(allow kernel p4_native_hardware_dirs (dir (getattr search write add_name remove_name rmdir)))
(allow kernel p4_native_hardware_nodes (chr_file (getattr setattr unlink)))
(neverallow kernel p4_native_hardware_nodes (chr_file (open read write append ioctl map)))

; Stock TakeDevice keeps its session-controller and actual seat membership
; checks. The DBus relay can receive its O_RDWR FDs, but cannot open devices,
; map them, issue ioctls, or choose another device on the caller's behalf.
(allow p4_linux_logind_t p4_linux_drm_card_t (chr_file (getattr open read write ioctl)))
(allowx p4_linux_logind_t p4_linux_drm_card_t (ioctl chr_file (0x641e 0x641f)))
(allow p4_linux_logind_t p4_linux_input_event_t (chr_file (getattr open read write ioctl)))
(allowx p4_linux_logind_t p4_linux_input_event_t (ioctl chr_file (0x4506 0x4518 0x451b 0x4520 0x4521 0x4525 0x4591 0x4593)))
(allow p4_linux_dbus_t p4_linux_logind_t (fd (use)))
(allow p4_linux_compositor_t p4_linux_logind_t (fd (use)))
(allow p4_linux_dbus_t p4_linux_drm_card_t (chr_file (getattr read write)))
(allow p4_linux_dbus_t p4_linux_input_event_t (chr_file (getattr read write)))
(neverallow p4_linux_dbus_t p4_native_hardware_nodes (chr_file (open ioctl map)))
(allow p4_linux_compositor_t p4_linux_drm_card_t (chr_file (getattr read write ioctl map)))
(allow p4_linux_compositor_t p4_linux_input_event_t (chr_file (getattr read write ioctl)))
(neverallow p4_linux_compositor_t p4_linux_drm_card_t (chr_file (open)))
(neverallow p4_linux_compositor_t p4_linux_input_event_t (chr_file (open map)))

; Public render nodes expose the kernel's render-allowed GEM/PRIME/syncobj and
; selected AMDGPU/virtio command sets. No KMS/master/control-node operation.
(typeattribute p4_native_render_clients)
(typeattributeset p4_native_render_clients (p4_linux_compositor_t p4_linux_user_session_t droidloom_presenter))
(allow p4_native_render_clients p4_linux_drm_render_t (chr_file (getattr open read write ioctl map)))
(allowx p4_native_render_clients p4_linux_drm_render_t (ioctl chr_file (0x6400 0x6409 0x640c 0x642d 0x642e (range 0x6440 0x644b) (range 0x6450 0x6454) (range 0x6456 0x6459) (range 0x64bf 0x64c5) (range 0x64ca 0x64cd) 0x64cf 0x64d1)))
(neverallowx p4_native_render_clients p4_linux_drm_render_t (ioctl chr_file (not (0x6400 0x6409 0x640c 0x642d 0x642e (range 0x6440 0x644b) (range 0x6450 0x6454) (range 0x6456 0x6459) (range 0x64bf 0x64c5) (range 0x64ca 0x64cd) 0x64cf 0x64d1))))
(allowx p4_linux_compositor_t p4_linux_drm_card_t (ioctl chr_file (0x6400 0x6409 0x640c 0x640d 0x6411 0x641f 0x642d 0x642e 0x643a 0x643b 0x643c (range 0x6440 0x644b) (range 0x6450 0x6454) (range 0x6456 0x6459) (range 0x64a0 0x64a7) (range 0x64aa 0x64d1))))
(neverallowx p4_linux_compositor_t p4_linux_drm_card_t (ioctl chr_file (0x641e 0x6455)))
(allowx p4_linux_compositor_t p4_linux_input_event_t (ioctl chr_file (0x4501 0x4502 0x4503 0x4506 0x4507 0x4508 0x4509 0x450a 0x4518 0x4519 0x451b (range 0x4520 0x457f) 0x45a0)))
(neverallowx p4_linux_compositor_t p4_linux_input_event_t (ioctl chr_file (0x4504 0x4590 0x4591 0x4593 (range 0x45c0 0x45ff))))

; Actual stock input_id and keyboard builtins run after the fixed PROGRAM.
; These are input capability probes and immutable hardware key/axis quirks,
; never a generic input injector or virtual/uinput device creator.
(allow p4_linux_udev_t p4_linux_input_event_t (chr_file (open read write ioctl)))
(allowx p4_linux_udev_t p4_linux_input_event_t (ioctl chr_file (0x4501 0x4502 0x4504 0x4506 0x4507 0x4508 0x4509 (range 0x4520 0x457f) (range 0x45c0 0x45ff))))
(neverallow p4_linux_udev_t p4_linux_drm_card_t (chr_file (open read write ioctl map)))
(neverallow p4_linux_udev_t p4_linux_drm_render_t (chr_file (open read write ioctl map)))
(neverallow p4_linux_user_session_t p4_linux_drm_card_t (chr_file (open read write ioctl map)))
(neverallow p4_linux_user_session_t p4_linux_input_event_t (chr_file (open read write ioctl map)))
(neverallow droidloom_presenter p4_linux_drm_card_t (chr_file (open read write ioctl map)))
(neverallow droidloom_presenter p4_linux_input_event_t (chr_file (open read write ioctl map)))
(neverallow droidloom_broker p4_native_hardware_nodes (chr_file (open read write ioctl map)))
(neverallow droidloom_public_control_client p4_native_hardware_nodes (chr_file (open read write ioctl map)))
(neverallow p4_android_userspace p4_native_hardware_nodes (chr_file (open read write ioctl map)))
