(typetransition init_t p4_linux_udev_exec_t process p4_linux_udev_t)
(neverallow init_t p4_linux_udev_t (process (transition dyntransition)))
(typetransition init_t p4_linux_dbus_exec_t process p4_linux_dbus_t)
(neverallow init_t p4_linux_dbus_t (process (transition dyntransition)))
(typetransition init_t p4_linux_sshd_exec_t process p4_linux_sshd_t)
(neverallow init_t p4_linux_sshd_t (process (transition dyntransition)))
(typetransition init_t p4_linux_snapd_exec_t process p4_linux_snapd_t)
(neverallow init_t p4_linux_snapd_t (process (transition dyntransition)))
(typetransition init_t p4_linux_resolved_exec_t process p4_linux_resolved_t)
(neverallow init_t p4_linux_resolved_t (process (transition dyntransition)))
(typetransition init_t p4_linux_logind_exec_t process p4_linux_logind_t)
(neverallow init_t p4_linux_logind_t (process (transition dyntransition)))

