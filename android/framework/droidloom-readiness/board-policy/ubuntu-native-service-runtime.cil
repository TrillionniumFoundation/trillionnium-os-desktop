(typeattribute p4_native_sysfs_readers)
(typeattributeset p4_native_sysfs_readers (p4_native_module_readers))
(typeattribute p4_nonboard_without_native_sysfs)
(typeattributeset p4_nonboard_without_native_sysfs (and (p4_all_nonboard) (not (sysfs_type))))
