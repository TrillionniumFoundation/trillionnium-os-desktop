(neverallow p4_linux_journalctl_t self (lnk_file (not (read))))
(allow p4_linux_journalctl_t p4_linux_journal_catalog_dir_t (dir (getattr open read search write add_name remove_name)))
(typetransition p4_linux_journalctl_t p4_linux_journal_catalog_dir_t file p4_linux_journal_catalog_file_t)
(allow p4_linux_journalctl_t p4_linux_journal_catalog_file_t (file (getattr open read write create setattr rename unlink)))
(allow p4_linux_journal_catalog_dir_t labeledfs (filesystem (associate)))
(allow p4_linux_journal_catalog_file_t labeledfs (filesystem (associate)))
(neverallow p4_linux_journalctl_t p4_linux_journal_catalog_dir_t (dir (not (getattr open read search write add_name remove_name))))
(neverallow p4_linux_journalctl_t p4_linux_journal_catalog_file_t (file (not (getattr open read write create setattr rename unlink))))

; Dedicated unchanged systemd-update-done. Its normal label lookup uses the
; final /etc/.updated or /var/.updated path before creating the random temp.
; lsm_set_self_attr(FSCREATE) selects the final file type; no compute_create or
; check_context request is made with the normal nonvalidating raw lookup.
; External normal source readback binds systemd/libselinux/selected-kernel
; bytes. The permanent verifier independently checks every raw role vector.
