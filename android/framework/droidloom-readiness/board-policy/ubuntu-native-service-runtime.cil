(neverallow p4_native_system_journal_consumers p4_linux_service_executor_t (unix_stream_socket (create connectto bind listen accept)))

; The kernel's original modprobe usermode-helper invokes the same immutable
; native kmod entrypoint. It receives no module-file or private-data permission
; in kernel SID; the normal file-backed loading role performs the work.
(roletransition r p4_linux_module_loader_exec_t process system_r)
(typetransition kernel p4_linux_module_loader_exec_t process p4_linux_module_loader_t)
(allow kernel p4_linux_module_loader_exec_t (file (getattr open read map execute)))
(allow kernel p4_linux_module_loader_t (process (transition)))
(allow p4_linux_module_loader_t kernel (process (sigchld)))
; Kernel-created devtmpfs hardware nodes are assigned their rule-selected DAC
; owner and mode by stock udev. No device-body I/O or private typed node is added.
(allow p4_linux_udev_t device (chr_file (getattr setattr)))
(allow p4_linux_udev_t device (blk_file (getattr setattr)))

