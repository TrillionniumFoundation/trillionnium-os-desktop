(neverallow p4_linux_journald_t kernel (system (syslog_mod syslog_console)))
(neverallow p4_linux_journald_t self (capability (sys_ptrace audit_control)))

; The stock socket unit computes the service label before it creates a socket.
; This type transition supplies only that computation.  PID 1 still may not
; execute the journal directly: the actual service transition is executor-only.
(typetransition init_t p4_linux_journald_exec_t process p4_linux_journald_t)
(neverallow init_t p4_linux_journald_t (process (transition dyntransition)))
(allow init_t kernel (security (compute_create)))
(allow init_t self (process (setsockcreate)))
(allow init_t p4_linux_journald_t (unix_stream_socket (create getattr bind listen read write getopt setopt shutdown)))
(allow init_t p4_linux_journald_t (unix_dgram_socket (create getattr bind read write getopt setopt)))
(allow p4_linux_journald_t self (unix_stream_socket (getattr read write accept listen getopt setopt shutdown)))
(allow p4_linux_journald_t self (unix_dgram_socket (getattr read write getopt setopt)))
; Stdout is created by the original executor before the final service exec.
; The socket-inode and connectto gates remain specific to the journal, while
; the original prohibition on connecting to manager/init sockets is retained.
(allow p4_linux_service_executor_t self (unix_stream_socket (create getattr connect read write getopt setopt shutdown)))
(allow p4_linux_service_executor_t p4_linux_journal_socket_t (sock_file (getattr write)))
(allow p4_linux_service_executor_t p4_linux_journald_t (unix_stream_socket (connectto read write getattr)))
(typeattribute p4_native_system_journal_consumers)
(typeattributeset p4_native_system_journal_consumers (p4_linux_native_system_services p4_linux_user_manager_t p4_linux_journald_t p4_linux_udev_t))
