; Public inputs for the original native kernel module loaders.  Only the
; admitted kernel cohort's signed .ko leaves receive this public type.  Indexes,
; configuration and every other release retain p4_linux_kernel_modules_t.
; system_dlkm_file_type is the original policy's semantic class for public
; loadable kernel modules.  It is deliberately not Linux private data: original
; Android init retains its original read-only system_dlkm permissions, while
; mount namespaces keep the host cohort outside the Android filesystem view.
(type p4_shared_kernel_module_t)
(roletype object_r p4_shared_kernel_module_t)
(typeattributeset file_type (p4_shared_kernel_module_t))
(typeattributeset system_dlkm_file_type (p4_shared_kernel_module_t))
(typeattribute p4_native_module_readers)
(typeattributeset p4_native_module_readers (p4_linux_module_loader_t p4_linux_udev_t))
(typeattribute p4_linux_without_native_module_readers)
(typeattributeset p4_linux_without_native_module_readers (and (p4_linux_procs) (not (p4_native_module_readers))))
(typeattribute p4_android_files_without_shared_kernel_modules)
(typeattributeset p4_android_files_without_shared_kernel_modules (and (p4_android_only_files) (not (p4_shared_kernel_module_t))))
