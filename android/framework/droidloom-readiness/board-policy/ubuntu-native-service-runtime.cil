; udev applies the original rule-selected ownership and mode to device nodes.
; It still cannot administer a mount namespace or bypass DAC checks.
(allow p4_linux_udev_t self (capability (chown fowner)))
; The journal's stock /dev/kmsg reader needs SYSLOG and the read-only syslog
; decision; opening the original char device O_RDWR also checks inode write.
; Clearing the ring, console controls and audit policy changes remain denied.
(allow p4_linux_journald_t self (capability2 (syslog)))
(allow p4_linux_journald_t kernel (system (syslog_read)))
