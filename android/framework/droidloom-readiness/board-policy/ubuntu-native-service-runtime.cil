(typeattribute p4_native_sysfs_nonmodule_directory_readers)
(typeattributeset p4_native_sysfs_nonmodule_directory_readers (and (and (p4_linux_nonmac_without_native_selinux_queries) (p4_native_sysfs_readers)) (not (p4_native_module_readers))))
(neverallow p4_native_sysfs_nonmodule_file_readers p4_nonboard_without_native_sysfs_or_cmdline (file (open read)))
(neverallow p4_native_sysfs_nonmodule_directory_readers p4_nonboard_without_native_sysfs (dir (open read)))
; libkmod first inspects public /sys/module and /proc/modules.  No sysfs store,
; module parameter mutation or device-body read is granted by these rules.
(typeattribute p4_native_module_kernel_inputs)
(typeattributeset p4_native_module_kernel_inputs (sysfs_type proc_modules p4_shared_kernel_module_t))
