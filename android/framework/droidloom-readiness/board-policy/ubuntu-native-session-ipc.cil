; Native Wayland and PipeWire endpoints are distinct from the Android frontend,
; the system/session buses, and every Droidloom control socket.
(type p4_linux_wayland_socket_t)
(type p4_linux_pipewire_socket_t)
(type p4_linux_pipewire_manager_socket_t)
(roletype object_r p4_linux_wayland_socket_t)
(roletype object_r p4_linux_pipewire_socket_t)
(roletype object_r p4_linux_pipewire_manager_socket_t)
(typeattribute p4_native_desktop_socket_inodes)
(typeattributeset p4_native_desktop_socket_inodes (p4_linux_wayland_socket_t p4_linux_pipewire_socket_t p4_linux_pipewire_manager_socket_t))
(typeattributeset p4_linux_data (p4_native_desktop_socket_inodes))
(allow p4_native_desktop_socket_inodes tmpfs (filesystem (associate)))

(typeattribute p4_native_wayland_clients)
(typeattributeset p4_native_wayland_clients (p4_linux_user_session_t p4_linux_desktop_portal_t droidloom_presenter))
(typeattribute p4_native_wayland_participants)
(typeattributeset p4_native_wayland_participants (p4_native_wayland_clients p4_linux_compositor_t))
(allow p4_native_wayland_participants p4_linux_user_run_t (dir (getattr search)))
(allow p4_linux_compositor_t p4_linux_wayland_socket_t (sock_file (create getattr setattr write unlink)))
(allow p4_native_wayland_participants p4_linux_wayland_socket_t (sock_file (getattr write)))
(allow p4_native_wayland_participants p4_linux_compositor_t (unix_stream_socket (connectto)))
(allow droidloom_presenter self (unix_stream_socket (create getattr read write connect getopt setopt shutdown)))
; Data-offer pipes can retain the original client's f_cred while forwarded by
; the compositor. fd use alone grants no underlying home-file read permission.
(allow p4_native_wayland_participants p4_native_wayland_participants (fd (use)))
(allow p4_native_wayland_participants p4_native_wayland_participants (fifo_file (getattr read write)))

; The admitted stock 1.24.0 auto-listener tries display numbers 0 through 32.
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-0" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-1" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-2" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-3" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-4" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-5" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-6" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-7" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-8" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-9" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-10" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-11" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-12" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-13" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-14" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-15" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-16" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-17" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-18" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-19" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-20" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-21" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-22" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-23" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-24" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-25" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-26" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-27" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-28" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-29" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-30" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-31" p4_linux_wayland_socket_t)
(typetransition p4_linux_compositor_t p4_linux_user_run_t sock_file "wayland-32" p4_linux_wayland_socket_t)

(typeattribute p4_native_pipewire_publishers)
(typeattributeset p4_native_pipewire_publishers (p4_linux_user_manager_t p4_linux_audio_t))
(typeattribute p4_native_pipewire_clients)
(typeattributeset p4_native_pipewire_clients (p4_linux_user_session_t p4_linux_compositor_t p4_linux_desktop_portal_t p4_linux_audio_t))
(typetransition p4_native_pipewire_publishers p4_linux_user_run_t sock_file "pipewire-0" p4_linux_pipewire_socket_t)
(typetransition p4_native_pipewire_publishers p4_linux_user_run_t sock_file "pipewire-0-manager" p4_linux_pipewire_manager_socket_t)
(allow p4_native_pipewire_publishers p4_linux_pipewire_socket_t (sock_file (create getattr setattr write unlink)))
(allow p4_native_pipewire_publishers p4_linux_pipewire_manager_socket_t (sock_file (create getattr setattr write unlink)))
(allow p4_native_pipewire_clients p4_linux_pipewire_socket_t (sock_file (getattr write)))
; The manager endpoint remains confined to the actual audio/manager actors.
(allow p4_linux_audio_t p4_linux_pipewire_manager_socket_t (sock_file (getattr write)))
(allow p4_native_pipewire_clients p4_linux_audio_t (unix_stream_socket (connectto)))
; The stock pipewire.socket descriptor retains its original user-manager SID.
(allow p4_native_pipewire_clients p4_linux_user_manager_t (unix_stream_socket (connectto)))
(allow p4_linux_audio_t p4_linux_user_manager_t (unix_stream_socket (getattr read write listen accept getopt setopt shutdown)))
(allow p4_linux_audio_t p4_linux_user_manager_t (fd (use)))
(allow p4_native_pipewire_clients p4_linux_audio_t (fd (use)))
(allow p4_linux_audio_t p4_native_pipewire_clients (fd (use)))

; Keyboard maps and PipeWire protocol memory use dedicated native memory
; inodes. This is not access to the original generic tmpfs or Android memory.
(type p4_linux_native_ipc_memfd_t)
(roletype object_r p4_linux_native_ipc_memfd_t)
(typeattributeset p4_linux_data (p4_linux_native_ipc_memfd_t))
(typeattribute p4_native_ipc_memory_creators)
(typeattributeset p4_native_ipc_memory_creators (p4_linux_compositor_t p4_linux_audio_t p4_linux_user_session_t p4_linux_desktop_portal_t droidloom_presenter))
(typeattribute p4_native_ipc_memory_readers)
(typeattributeset p4_native_ipc_memory_readers (p4_native_ipc_memory_creators droidloom_presenter))
(typeattribute p4_native_ipc_memory_nonreaders)
(typeattributeset p4_native_ipc_memory_nonreaders (and (all) (not (p4_native_ipc_memory_readers))))
(typetransition p4_native_ipc_memory_creators tmpfs file p4_linux_native_ipc_memfd_t)
(typetransition p4_native_ipc_memory_creators tmpfs memfd_file p4_linux_native_ipc_memfd_t)
(allow p4_linux_native_ipc_memfd_t tmpfs (filesystem (associate)))
(allow p4_native_ipc_memory_creators p4_linux_native_ipc_memfd_t (file (create getattr open read write map lock)))
(allow p4_native_ipc_memory_creators p4_linux_native_ipc_memfd_t (memfd_file (create getattr open read write map lock)))
(allow p4_native_ipc_memory_readers p4_linux_native_ipc_memfd_t (file (getattr read write map)))
(allow p4_native_ipc_memory_readers p4_linux_native_ipc_memfd_t (memfd_file (getattr read write map)))
(neverallow p4_native_ipc_memory_nonreaders p4_linux_native_ipc_memfd_t (file (open read write append create map execute execute_no_trans entrypoint relabelto relabelfrom)))
(neverallow p4_native_ipc_memory_nonreaders p4_linux_native_ipc_memfd_t (memfd_file (open read write append create map execute relabelto relabelfrom)))
(neverallow p4_linux_procs p4_linux_native_ipc_memfd_t (file (execute execute_no_trans entrypoint relabelto relabelfrom)))
(neverallow p4_linux_procs p4_linux_native_ipc_memfd_t (memfd_file (execute relabelto relabelfrom)))

; Ordinary original service-manager cleanup can unlink these named sockets,
; with the same exact runtime-directory boundaries as the storage component.
(allow init_t p4_native_desktop_socket_inodes (sock_file (getattr unlink)))
(allow p4_native_runtime_directory_maintainers p4_native_desktop_socket_inodes (sock_file (getattr unlink)))
(neverallow p4_android_userspace p4_native_desktop_socket_inodes (sock_file (create getattr write setattr unlink rename relabelto relabelfrom)))
(neverallow droidloom_broker p4_native_desktop_socket_inodes (sock_file (create getattr write setattr unlink rename relabelto relabelfrom)))
(neverallow droidloom_public_control_client p4_native_desktop_socket_inodes (sock_file (create getattr write setattr unlink rename relabelto relabelfrom)))
(neverallow p4_native_wayland_clients p4_linux_wayland_socket_t (sock_file (create setattr unlink rename relabelto relabelfrom)))
