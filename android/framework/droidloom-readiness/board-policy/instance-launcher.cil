; The ordinary service is only an authenticated START/retirement proxy.
; The factory remains the original boot kernel lineage. It is born before
; Linux PID 1 leaves that lineage and is constrained by its exact AppArmor
; executable attachment. Stock kernel -> init authorization stays unchanged.
(type droidloom_instance_launcher)
(roletype r droidloom_instance_launcher)
(typeattributeset p4_all_board_owned (droidloom_instance_launcher))
(allow init_t droidloom_instance_launcher (process (transition getattr signull signal sigkill sigstop)))
(allow init_t droidloom_instance_launcher (process2 (nnp_transition)))
(allow droidloom_instance_launcher droidloom_container_entry_exec_t (file (getattr open read execute map entrypoint)))
(allow droidloom_instance_launcher init_t (fd (use)))
(allow droidloom_instance_launcher p4_linux_service_executor_t (fd (use)))
(allow droidloom_instance_launcher init_t (process (getattr sigchld)))
(allow droidloom_instance_launcher self (process (getattr getcap sigchld)))
(neverallow droidloom_instance_launcher self (process (fork dyntransition setcurrent setexec setfscreate)))
(neverallow droidloom_instance_launcher self (capability (sys_admin sys_ptrace mknod setuid setgid dac_override dac_read_search)))
(neverallow droidloom_instance_launcher self (cap_userns (sys_admin sys_ptrace mknod setuid setgid dac_override dac_read_search)))
(neverallow droidloom_instance_launcher domain (process (transition dyntransition ptrace signal sigkill sigstop setexec setcurrent)))
(neverallow p4_android_userspace droidloom_instance_launcher (process (transition dyntransition ptrace signal setexec setcurrent)))
(neverallow p4_android_userspace droidloom_instance_launcher (binder (call transfer impersonate)))
(neverallow droidloom_instance_launcher domain (binder (call transfer impersonate set_context_mgr)))
(neverallow droidloom_instance_launcher property_type (property_service (set)))
(neverallow droidloom_instance_launcher kernel (security (load_policy setenforce setbool setsecparam setcheckreqprot)))

; The exact published host manager and read-only immutable selection.
(typeattribute p4_instance_host_readers)
(typeattributeset p4_instance_host_readers (kernel droidloom_instance_launcher))
(allow p4_instance_host_readers p4_linux_rootdir_t (dir (getattr search open read)))
(allow p4_instance_host_readers p4_linux_etc_dir_t (dir (getattr search open read)))
(allow p4_instance_host_readers p4_linux_host_config_t (file (getattr open read)))
(allow p4_instance_host_readers p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_instance_host_readers p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_instance_host_readers p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_instance_host_readers p4_linux_standardio_t (chr_file (getattr open read write)))
(allow p4_instance_host_readers p4_linux_mac_setup_lock_t (file (getattr open read lock)))
(allow kernel droidloom_container_entry_exec_t (file (getattr open read map)))
(neverallow p4_instance_host_readers p4_linux_host_config_t (file (write append create unlink rename setattr relabelto relabelfrom)))
(allow p4_instance_host_readers selinuxfs (dir (getattr search)))
(allow p4_instance_host_readers selinuxfs (file (getattr open read)))
(allow p4_instance_host_readers proc (dir (getattr search open read)))
(allow p4_instance_host_readers proc (lnk_file (getattr read)))
(allow p4_instance_host_readers proc_random (dir (getattr search)))
(allow p4_instance_host_readers proc_random (file (getattr open read)))
(allow p4_instance_host_readers self (dir (getattr search open read)))
(allow p4_instance_host_readers self (file (getattr open read write)))
(allow p4_instance_host_readers self (lnk_file (getattr read)))
(allow p4_instance_host_readers init_t (dir (getattr search)))
(allow p4_instance_host_readers init_t (file (getattr open read)))
(allow p4_instance_host_readers init_t (lnk_file (getattr read)))
(allow p4_instance_host_readers droidloom_broker (dir (getattr search)))
(allow p4_instance_host_readers droidloom_broker (file (getattr open read)))
(allow p4_instance_host_readers droidloom_broker (lnk_file (getattr read)))
(allow p4_instance_host_readers droidloom_broker (process (getattr)))
(allow kernel droidloom_instance_launcher (dir (getattr search)))
(allow kernel droidloom_instance_launcher (file (getattr open read)))
(allow kernel droidloom_instance_launcher (lnk_file (getattr read)))
(allow kernel droidloom_instance_launcher (process (getattr)))
(allow droidloom_instance_launcher kernel (dir (getattr search)))
(allow droidloom_instance_launcher kernel (file (getattr open read)))
(allow droidloom_instance_launcher kernel (lnk_file (getattr read)))
(allow droidloom_instance_launcher kernel (process (getattr)))
(allow p4_instance_host_readers sysfs (dir (getattr search)))
(allow p4_instance_host_readers proc (filesystem (getattr)))
(allow p4_instance_host_readers tmpfs (filesystem (getattr)))

; Original native system manager and its fixed named notification endpoint.
(allow p4_instance_host_readers p4_linux_run_t (dir (getattr search)))
(allow p4_instance_host_readers p4_linux_systemd_run_t (dir (getattr search)))
(allow p4_instance_host_readers droidloom_manager_private_socket (sock_file (getattr write)))
(allow droidloom_instance_launcher p4_linux_systemd_notify_t (sock_file (getattr write)))
(allow p4_instance_host_readers self (unix_stream_socket (create connect read write getattr getopt setopt shutdown)))
(allow droidloom_instance_launcher self (unix_dgram_socket (create connect read write getattr getopt setopt shutdown)))
(allow p4_instance_host_readers init_t (unix_stream_socket (connectto)))
(allow droidloom_instance_launcher init_t (unix_dgram_socket (sendto)))

; The factory's sole fixed root-private endpoint. Its peer must be the actual
; original launcher invocation, published ELF and enforced role, with native
; SO_PEERPIDFD custody. Its only input is an eight-byte fixed START operation.
(type p4_instance_factory_socket_t)
(roletype object_r p4_instance_factory_socket_t)
(typeattributeset p4_linux_data (p4_instance_factory_socket_t))
(allow p4_instance_factory_socket_t tmpfs (filesystem (associate)))
(typetransition kernel p4_linux_early_handoff_dir_t sock_file "instance-factory.sock" p4_instance_factory_socket_t)
(allow kernel p4_instance_factory_socket_t (sock_file (create getattr setattr read write unlink)))
(allow kernel self (unix_stream_socket (create bind listen accept read write getattr getopt setopt shutdown)))
(allow droidloom_instance_launcher p4_instance_factory_socket_t (sock_file (getattr write)))
(allow droidloom_instance_launcher kernel (unix_stream_socket (connectto)))
(allow droidloom_instance_launcher kernel (fd (use)))
(neverallow droidloom_instance_launcher p4_instance_factory_socket_t (sock_file (create setattr unlink rename relabelto relabelfrom)))

; Kernel-created per-generation records. Only normal original owner retirement
; and actual original PIDFD death let the factory remove this exact generation.
(type p4_linux_instance_record_t)
(type p4_linux_instance_lock_t)
(type p4_linux_instance_slot_t)
(roletype object_r p4_linux_instance_record_t)
(roletype object_r p4_linux_instance_lock_t)
(roletype object_r p4_linux_instance_slot_t)
(typeattributeset p4_linux_data (p4_linux_instance_record_t p4_linux_instance_lock_t p4_linux_instance_slot_t))
(allow p4_linux_instance_record_t tmpfs (filesystem (associate)))
(allow p4_linux_instance_lock_t tmpfs (filesystem (associate)))
(allow p4_linux_instance_slot_t tmpfs (filesystem (associate)))
; startup.lock is born before the first policy load. Original tmpfs uses
; fsuse trans: first-policy inode initialization gives it the tmpfs SID.
; The boot owner relabels its held, root-owned 0400 regular lock once.
(allow kernel tmpfs (file (relabelfrom)))
(allow kernel p4_linux_instance_lock_t (file (getattr relabelto open read lock)))
(allow kernel p4_linux_instance_slot_t (dir (getattr relabelto open read search mounton)))
(typetransition kernel p4_linux_early_handoff_dir_t file p4_linux_instance_record_t)
(typetransition kernel p4_linux_early_handoff_dir_t fifo_file "release" p4_linux_instance_record_t)
(allow kernel p4_linux_early_handoff_dir_t (dir (getattr open read search write add_name remove_name)))
(allow kernel p4_linux_instance_record_t (file (create open getattr read write setattr unlink rename mounton)))
(allow kernel p4_linux_instance_record_t (fifo_file (create open getattr read write setattr unlink)))
(allow droidloom_instance_launcher p4_linux_early_handoff_dir_t (dir (getattr search)))
(allow droidloom_instance_launcher p4_linux_instance_record_t (file (getattr)))
(allow droidloom_instance_launcher p4_linux_instance_record_t (fifo_file (getattr)))
(neverallow droidloom_instance_launcher p4_linux_instance_record_t (file (create open read write append setattr unlink rename mounton relabelto relabelfrom)))
(neverallow droidloom_instance_launcher p4_linux_early_handoff_dir_t (dir (write add_name remove_name relabelto relabelfrom mounton)))
(allow droidloom_broker p4_linux_instance_record_t (file (getattr open read)))
(allow droidloom_broker p4_linux_instance_record_t (fifo_file (getattr open write)))
(allow droidloom_container_entry_t p4_linux_instance_record_t (file (getattr open read)))
(allow droidloom_policy_loader p4_linux_instance_record_t (file (getattr open read)))
(allow kernel p4_linux_readiness_dir_t (dir (getattr search)))
(allow kernel droidloom_readiness_socket (sock_file (getattr)))
(allow p4_instance_host_readers p4_linux_policy_epoch_dir_t (dir (getattr search)))
(allow p4_instance_host_readers p4_linux_apparmor_epoch_t (file (getattr open read)))

; Descriptors are opened by the original child itself and returned only over
; its inherited private socketpair. No cross-userns proc/ptrace exception exists.
(allow p4_instance_host_readers p4_kernel_ns_handle_t (file (getattr open read ioctl)))
(allowx p4_instance_host_readers p4_kernel_ns_handle_t (ioctl file (0xb701 0xb703 0xb709)))
(allow p4_instance_host_readers p4_kernel_ns_handle_t (filesystem (getattr)))
(allow p4_instance_host_readers p4_kernel_pid_handle_t (file (getattr open read ioctl)))
(allowx p4_instance_host_readers p4_kernel_pid_handle_t (ioctl file (0xff0b)))
(allow p4_instance_host_readers p4_kernel_pid_handle_t (filesystem (getattr)))
(allow kernel p4_kernel_ns_handle_t (filesystem (mount remount unmount)))
(allow kernel p4_kernel_pid_handle_t (filesystem (mount remount unmount)))
(neverallowx droidloom_instance_launcher p4_kernel_ns_handle_t (ioctl file (not (0xb701 0xb703 0xb709))))
(neverallowx droidloom_instance_launcher p4_kernel_pid_handle_t (ioctl file (not (0xff0b))))
(neverallow droidloom_instance_launcher p4_kernel_ns_handle_t (file (write append create unlink link rename relabelto relabelfrom map execute execute_no_trans entrypoint)))
(neverallow droidloom_instance_launcher p4_kernel_pid_handle_t (file (write append create unlink link rename relabelto relabelfrom map execute execute_no_trans entrypoint)))

; The boot-born factory creates fresh namespaces and their exact original
; private device template. All permissions remain subject to Android's original
; assertions and the factory's fixed AppArmor paths, devices and exec target.
(allow kernel self (process (fork getattr getcap setcap sigchld signal sigkill)))
(allow kernel self (capability (chown fowner setgid setuid sys_admin mknod)))
(allow kernel self (cap_userns (chown fowner setgid setuid sys_admin mknod)))
(allow kernel self (fifo_file (read write getattr ioctl)))
(allow kernel tmpfs (filesystem (mount remount unmount)))
(allow kernel labeledfs (filesystem (getattr mount unmount)))
(allow kernel tmpfs (dir (getattr open read search create setattr write add_name remove_name mounton relabelfrom)))
(allow kernel tmpfs (file (create getattr open read write setattr unlink mounton)))
(allow kernel tmpfs (fifo_file (create getattr open read write)))
(allow kernel tmpfs (chr_file (create getattr setattr)))
(allow kernel device (dir (getattr open read search)))
(allow kernel device (chr_file (getattr)))
(allow kernel loop_control_device (chr_file (create getattr open read write ioctl)))
(allowx kernel loop_control_device (ioctl chr_file (0x4c82)))
(allow kernel loop_device (blk_file (create getattr open read write ioctl unlink)))
(allowx kernel loop_device (ioctl blk_file (0x4c05 0x4c0a)))
(allow kernel zero_device (chr_file (getattr)))
(allow kernel null_device (chr_file (getattr open read write)))
(allow kernel tty_device (chr_file (getattr)))
(allow kernel fuse_device (chr_file (getattr)))
(allow kernel rootfs (dir (getattr open read search)))
(allow kernel system_file (dir (getattr open read search)))

; Private tmpfs device node names use original Android object types at creation.
; The host /dev/loop* inode labels and owners are never changed.
(type p4_linux_factory_devices_t)
(roletype object_r p4_linux_factory_devices_t)
(typeattributeset p4_linux_data (p4_linux_factory_devices_t))
(allow p4_linux_factory_devices_t tmpfs (filesystem (associate)))
(allow kernel p4_linux_early_handoff_dir_t (dir (create mounton)))
(allow kernel p4_linux_factory_devices_t (dir (getattr open read search write add_name remove_name relabelto)))
(typetransition kernel p4_linux_factory_devices_t chr_file "loop-control" loop_control_device)
(typetransition kernel p4_linux_factory_devices_t blk_file loop_device)
