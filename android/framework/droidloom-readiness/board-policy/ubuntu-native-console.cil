(neverallow p4_linux_console_setup_t self (process (setexec setcurrent dyntransition ptrace)))
(neverallow p4_linux_console_setup_t self (tcp_socket (create)))
(neverallow p4_linux_console_setup_t self (udp_socket (create)))
(neverallow p4_linux_console_setup_t self (rawip_socket (create)))
(neverallow p4_linux_console_setup_t self (packet_socket (create)))
(neverallow p4_linux_console_setup_t self (netlink_route_socket (create)))
(neverallow p4_linux_console_setup_t self (netlink_kobject_uevent_socket (create)))
; Fixed public proc-fd traversal and device-directory enumeration only.
(typeattribute p4_console_nonboard_without_device)
(typeattributeset p4_console_nonboard_without_device (and (p4_all_nonboard) (not (device))))
(neverallow p4_linux_console_setup_t p4_console_nonboard_without_device (dir (open read)))
