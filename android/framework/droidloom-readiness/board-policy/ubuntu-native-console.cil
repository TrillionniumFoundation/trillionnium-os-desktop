; Normal Ubuntu console-setup 1.237ubuntu3.1, kbd 2.7.1-2ubuntu2.
; Exact package inodes and all hardlink aliases are bound by native-console-setup.json.
; The dedicated role never joins p4_linux_native_processes.
(type p4_linux_console_setup_t)
(roletype system_r p4_linux_console_setup_t)
(typeattributeset p4_linux_procs (p4_linux_console_setup_t))
(typeattributeset p4_native_dev_root_traversers (p4_linux_console_setup_t))
(typeattributeset p4_native_self_fd_metadata_readers (p4_linux_console_setup_t))
(type p4_linux_console_helper_native_bin_t)
(roletype object_r p4_linux_console_helper_native_bin_t)
(typeattributeset p4_linux_data (p4_linux_console_helper_native_bin_t))
(typeattributeset p4_linux_native_executables (p4_linux_console_helper_native_bin_t))
; Binfmt opens this one normal dash ELF while the old executor still owns
; current credentials. Script entrypoint selection remains the role authority.
(type p4_linux_console_interpreter_native_bin_t)
(roletype object_r p4_linux_console_interpreter_native_bin_t)
(typeattributeset p4_linux_data (p4_linux_console_interpreter_native_bin_t))
(typeattributeset p4_linux_native_executables (p4_linux_console_interpreter_native_bin_t))
(neverallow p4_linux_service_executor_t p4_linux_console_interpreter_native_bin_t (file (execute_no_trans entrypoint write append)))
(neverallow p4_linux_udev_t p4_linux_console_interpreter_native_bin_t (file (execute_no_trans entrypoint write append)))
(type p4_linux_console_vtrgb_native_bin_t)
(roletype object_r p4_linux_console_vtrgb_native_bin_t)
(typeattributeset p4_linux_data (p4_linux_console_vtrgb_native_bin_t))
(typeattributeset p4_linux_native_executables (p4_linux_console_vtrgb_native_bin_t))
(type p4_linux_console_cache_exec_native_config_t)
(roletype object_r p4_linux_console_cache_exec_native_config_t)
(typeattributeset p4_linux_data (p4_linux_console_cache_exec_native_config_t))
(typeattributeset p4_linux_native_public_files (p4_linux_console_cache_exec_native_config_t))
(type p4_linux_console_cache_native_config_t)
(roletype object_r p4_linux_console_cache_native_config_t)
(typeattributeset p4_linux_data (p4_linux_console_cache_native_config_t))
(typeattributeset p4_linux_native_public_files (p4_linux_console_cache_native_config_t))
(type p4_linux_console_config_native_config_t)
(roletype object_r p4_linux_console_config_native_config_t)
(typeattributeset p4_linux_data (p4_linux_console_config_native_config_t))
(typeattributeset p4_linux_native_public_files (p4_linux_console_config_native_config_t))
; Loader cache and locale bytes are read-only mapped data, not executables.
(type p4_linux_console_ld_cache_native_config_t)
(roletype object_r p4_linux_console_ld_cache_native_config_t)
(typeattributeset p4_linux_data (p4_linux_console_ld_cache_native_config_t))
(typeattributeset p4_linux_native_public_files (p4_linux_console_ld_cache_native_config_t))
(type p4_linux_console_locale_runtime_lib_t)
(roletype object_r p4_linux_console_locale_runtime_lib_t)
(typeattributeset p4_linux_data (p4_linux_console_locale_runtime_lib_t))
(type p4_linux_console_public_native_config_t)
(roletype object_r p4_linux_console_public_native_config_t)
(typeattributeset p4_linux_data (p4_linux_console_public_native_config_t))
(typeattributeset p4_linux_native_public_files (p4_linux_console_public_native_config_t))
(type p4_linux_console_public_native_data_t)
(roletype object_r p4_linux_console_public_native_data_t)
(typeattributeset p4_linux_data (p4_linux_console_public_native_data_t))
(typeattributeset p4_linux_native_public_files (p4_linux_console_public_native_data_t))
(type p4_linux_console_cache_dir_t)
(roletype object_r p4_linux_console_cache_dir_t)
(typeattributeset p4_linux_data (p4_linux_console_cache_dir_t))
(type p4_linux_console_entry_runtime_lib_t)
(roletype object_r p4_linux_console_entry_runtime_lib_t)
(typeattributeset p4_linux_data (p4_linux_console_entry_runtime_lib_t))
(type p4_linux_console_library_runtime_lib_t)
(roletype object_r p4_linux_console_library_runtime_lib_t)
(typeattributeset p4_linux_data (p4_linux_console_library_runtime_lib_t))
(type p4_linux_console_public_runtime_lib_t)
(roletype object_r p4_linux_console_public_runtime_lib_t)
(typeattributeset p4_linux_data (p4_linux_console_public_runtime_lib_t))
(type p4_linux_console_run_t)
(roletype object_r p4_linux_console_run_t)
(typeattributeset p4_linux_data (p4_linux_console_run_t))
(allow p4_linux_console_run_t tmpfs (filesystem (associate)))
(type p4_linux_console_tmp_t)
(roletype object_r p4_linux_console_tmp_t)
(typeattributeset p4_linux_data (p4_linux_console_tmp_t))
(allow p4_linux_console_tmp_t tmpfs (filesystem (associate)))
; The fixed 65 Linux devtmpfs nodes are labelled in FINISH, after the
; board self-exec has entered early_t and checked the current first-load
; epoch and original namespaces. FS_USE_TRANS devtmpfs cannot consume a
; pre-policy raw xattr. No kernel-domain generic-device relabel is added.
(type p4_linux_console_vt_t)
(roletype object_r p4_linux_console_vt_t)
(typeattributeset p4_linux_data (p4_linux_console_vt_t))
(allow p4_linux_console_vt_t device (filesystem (associate)))
(allow p4_linux_early_t p4_linux_console_vt_t (chr_file (getattr relabelto)))
(allow p4_linux_early_t device (chr_file (getattr relabelfrom)))
(neverallow p4_linux_early_t device (chr_file (open read write append ioctl map setattr create unlink link rename relabelto)))
(neverallow p4_linux_early_t p4_linux_console_vt_t (chr_file (open read write append ioctl map setattr create unlink link rename relabelfrom)))
; The fixed original random/urandom pair is relabelled by the same enforcing
; FINISH stage before systemd can start any entropy consumer. Only the label
; and its mandatory devtmpfs association change; no device body is opened.
(allow p4_linux_early_t random_device (chr_file (getattr relabelto)))
(neverallow p4_linux_early_t random_device (chr_file (not (getattr relabelto))))
(allow random_device device (filesystem (associate)))
(neverallow random_device device (filesystem (not (associate))))
; ProtectKernelLogs needs the original devtmpfs kmsg inode's proper label.
; FINISH opens that fixed inode after its own early-role transition; kmsg
; is not overmounted and no device FD crosses exec or opens a log body.
(allow p4_linux_early_t kmsg_device (chr_file (getattr relabelto)))
(neverallow p4_linux_early_t kmsg_device (chr_file (not (getattr relabelto))))
(allow kmsg_device device (filesystem (associate)))
(neverallow kmsg_device device (filesystem (not (associate))))
; O_PATH admits /dev and /proc/1/fd; the sole magic links are this original
; PID 1's own held numeric FDs. All other proc bodies remain inaccessible.
(allow p4_linux_early_t device (dir (getattr search)))
(allow p4_linux_early_t p4_linux_native_dev_root_t (dir (getattr search)))
(allow p4_linux_early_t proc (dir (search)))
(allow p4_linux_early_t self (dir (getattr search)))
(allow p4_linux_early_t self (lnk_file (read)))
(allow p4_linux_early_t device (filesystem (getattr)))
(allow p4_linux_early_t proc (filesystem (getattr)))
(allow p4_linux_early_t tmpfs (filesystem (getattr)))
; Read the normal publisher's immutable packet and actual SELinux status.
; SELinux security-class query/load/enforcement operations stay prohibited.
(allow p4_linux_early_t p4_linux_run_t (dir (search)))
(allow p4_linux_early_t p4_linux_early_handoff_dir_t (dir (getattr search open read)))
(allow p4_linux_early_t p4_linux_policy_epoch_dir_t (dir (getattr search open read)))
(allow p4_linux_early_t p4_linux_apparmor_epoch_t (file (getattr open read)))
(allow p4_linux_early_t sysfs (dir (search)))
(allow p4_linux_early_t selinuxfs (dir (search)))
(allow p4_linux_early_t selinuxfs (filesystem (getattr)))
(allow p4_linux_early_t selinuxfs (file (getattr open read)))
(neverallow p4_linux_early_t selinuxfs (file (write append map ioctl setattr relabelfrom relabelto execute execute_no_trans entrypoint)))
(neverallow p4_linux_early_t kernel (security (all)))
; The same public nsfs witnesses already bind normal hardware helpers.
(typeattributeset p4_handle_owner (p4_linux_early_t))
(allowx p4_linux_early_t p4_kernel_ns_handle_t (ioctl file (0xb703)))
(neverallowx p4_linux_early_t p4_kernel_ns_handle_t (ioctl file (not (0xb703))))
; normal udev-node applies the exact distro mode/group and restorecon label.
(allow p4_linux_udev_t p4_linux_console_vt_t (chr_file (getattr setattr relabelfrom relabelto)))
; logind session_prepare_vt / vt_restore / vt_release and positive chvt.
(allow p4_linux_logind_t p4_linux_console_vt_t (chr_file (getattr open read write setattr ioctl)))
(allowx p4_linux_logind_t p4_linux_console_vt_t (ioctl chr_file (0x4b3a 0x4b45 0x542a 0x5602 0x5603 0x5605 0x5606)))
(neverallowx p4_linux_logind_t p4_linux_console_vt_t (ioctl chr_file (not (0x4b3a 0x4b45 0x542a 0x5602 0x5603 0x5605 0x5606))))
; PID 1's normal terminal reset and winsize readback, plus its console lock.
; TCGETS2, TCSETS2, TIOCGWINSZ, TIOCNXCL, KDSKBMODE and TCFLSH only.
(allow init_t p4_linux_console_t (chr_file (lock ioctl)))
(allowx init_t p4_linux_console_t (ioctl chr_file (0x4b45 0x540b 0x540d 0x5413 0x542a 0x542b)))
(neverallowx init_t p4_linux_console_t (ioctl chr_file (not (0x4b45 0x540b 0x540d 0x5413 0x542a 0x542b))))
(allow init_t p4_linux_console_vt_t (chr_file (getattr open read write lock ioctl)))
(allowx init_t p4_linux_console_vt_t (ioctl chr_file (0x4b45 0x540b 0x540d 0x5413 0x542a 0x542b)))
(neverallowx init_t p4_linux_console_vt_t (ioctl chr_file (not (0x4b45 0x540b 0x540d 0x5413 0x542a 0x542b))))
; The executor only probes its inherited/selected terminal with isatty here.
(allow p4_linux_service_executor_t p4_linux_console_t (chr_file (read ioctl)))
(allowx p4_linux_service_executor_t p4_linux_console_t (ioctl chr_file (0x542a)))
(neverallowx p4_linux_service_executor_t p4_linux_console_t (ioctl chr_file (not (0x542a))))
(allow p4_linux_service_executor_t p4_linux_console_vt_t (chr_file (getattr open read write ioctl)))
(allowx p4_linux_service_executor_t p4_linux_console_vt_t (ioctl chr_file (0x542a)))
(neverallowx p4_linux_service_executor_t p4_linux_console_vt_t (ioctl chr_file (not (0x542a))))
(call p4_ubuntu_system_service (p4_linux_console_setup_t p4_linux_console_entry_runtime_lib_t))
(call p4_ubuntu_system_service (p4_linux_console_setup_t p4_linux_console_vtrgb_native_bin_t))
; The distribution udev rule executes only the generated font/terminal cache type.
(typetransition p4_linux_udev_t p4_linux_console_cache_exec_native_config_t process p4_linux_console_setup_t)
(allow p4_linux_udev_t p4_linux_console_cache_exec_native_config_t (file (getattr open read execute map)))
(allow p4_linux_udev_t p4_linux_console_setup_t (process (transition siginh rlimitinh getattr signull signal sigkill)))
(allow p4_linux_udev_t p4_linux_console_setup_t (process2 (nnp_transition)))
(allow p4_linux_console_setup_t p4_linux_console_cache_exec_native_config_t (file (entrypoint)))
(allow init_t p4_linux_console_setup_t (process (getattr signull signal sigkill sigstop)))
(allow p4_linux_console_setup_t init_t (process (sigchld)))
(allow p4_linux_console_setup_t p4_linux_service_executor_t (process (sigchld)))
(allow p4_linux_console_setup_t p4_linux_udev_t (process (sigchld)))
(allow p4_linux_console_setup_t self (process (fork getattr getcap setcap sigchld signal)))
(allow p4_linux_console_setup_t self (fd (use)))
(allow p4_linux_console_setup_t p4_linux_service_executor_t (fd (use)))
(allow p4_linux_console_setup_t p4_linux_udev_t (fd (use)))
(allow p4_linux_console_setup_t p4_linux_service_executor_t (unix_stream_socket (getattr read write)))
(allow p4_linux_console_setup_t p4_linux_udev_t (fifo_file (getattr write)))
(allow p4_linux_console_setup_t self (fifo_file (getattr open read write create)))
(allow p4_linux_console_setup_t self (dir (getattr search)))
(allow p4_linux_console_setup_t self (lnk_file (getattr read)))
(allow p4_linux_console_setup_t proc (dir (getattr search)))
(allow p4_linux_console_setup_t proc (lnk_file (getattr read)))
(allow p4_linux_console_setup_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_console_setup_t p4_linux_etc_dir_t (dir (getattr search)))
(allow p4_linux_console_setup_t p4_linux_usrmerge_link_t (lnk_file (getattr read)))
(allow p4_linux_console_setup_t p4_linux_elf_interpreter_t (file (getattr open read execute map)))
(allow p4_linux_console_setup_t p4_linux_console_helper_native_bin_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_console_setup_t p4_linux_console_interpreter_native_bin_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_console_setup_t p4_linux_console_ld_cache_native_config_t (file (getattr open read map)))
(allow p4_linux_console_setup_t p4_linux_console_locale_runtime_lib_t (file (getattr open read map)))
(neverallow p4_linux_console_setup_t p4_linux_console_ld_cache_native_config_t (file (execute execute_no_trans entrypoint write append)))
(neverallow p4_linux_console_setup_t p4_linux_console_locale_runtime_lib_t (file (execute execute_no_trans entrypoint write append)))
(allow p4_linux_console_setup_t p4_linux_console_vtrgb_native_bin_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_console_setup_t p4_linux_console_cache_exec_native_config_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_console_setup_t p4_linux_console_cache_native_config_t (file (getattr open read)))
(allow p4_linux_console_setup_t p4_linux_console_config_native_config_t (file (getattr open read)))
(allow p4_linux_console_setup_t p4_linux_console_public_native_config_t (file (getattr open read)))
(allow p4_linux_console_setup_t p4_linux_console_public_native_data_t (file (getattr open read)))
(allow p4_linux_console_setup_t p4_linux_console_entry_runtime_lib_t (file (getattr open read execute execute_no_trans map)))
(allow p4_linux_console_setup_t p4_linux_console_library_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_console_setup_t p4_linux_console_public_runtime_lib_t (file (getattr open read)))
(allow p4_linux_console_setup_t p4_linux_console_cache_native_config_t (file (create write append setattr unlink)))
(allow p4_linux_console_setup_t p4_linux_console_cache_exec_native_config_t (file (create write append setattr unlink)))
(allow p4_linux_console_setup_t p4_linux_console_cache_dir_t (dir (getattr search open read write add_name remove_name)))
(typetransition p4_linux_console_setup_t p4_linux_console_cache_dir_t file "cached_setup_keyboard.sh" p4_linux_console_cache_exec_native_config_t)
(typetransition p4_linux_console_setup_t p4_linux_console_cache_dir_t file "cached_setup_font.sh" p4_linux_console_cache_exec_native_config_t)
(typetransition p4_linux_console_setup_t p4_linux_console_cache_dir_t file "cached_setup_terminal.sh" p4_linux_console_cache_exec_native_config_t)
(typetransition p4_linux_console_setup_t p4_linux_console_cache_dir_t file "cached_UTF-8_del.kmap.gz" p4_linux_console_cache_native_config_t)
(typetransition p4_linux_console_setup_t p4_linux_console_cache_dir_t file "cached_Uni2-Fixed16.psf.gz" p4_linux_console_cache_native_config_t)
(typetransition p4_linux_console_setup_t p4_linux_console_cache_dir_t file "cached_rwtest" p4_linux_console_cache_native_config_t)
; Only this directory name can be created under the fresh native /run.
(typetransition p4_linux_console_setup_t p4_linux_run_t dir "console-setup" p4_linux_console_run_t)
(allow p4_linux_console_setup_t p4_linux_run_t (dir (getattr search write add_name)))
(allow p4_linux_console_setup_t p4_linux_console_run_t (dir (getattr search open read create write add_name remove_name)))
(allow p4_linux_console_setup_t p4_linux_console_run_t (file (getattr open read create write setattr unlink)))
(typetransition p4_linux_console_setup_t p4_linux_console_run_t file "boot_completed" p4_linux_console_run_t)
(typetransition p4_linux_console_setup_t p4_linux_console_run_t file "font-loaded" p4_linux_console_run_t)
(typetransition p4_linux_console_setup_t p4_linux_console_run_t file "keymap_loaded" p4_linux_console_run_t)
(allow p4_linux_udev_t p4_linux_console_run_t (dir (getattr search)))
(allow p4_linux_udev_t p4_linux_console_run_t (file (getattr)))
; setupcon first tries /run/tmpkbd.XXXXXX; that normal attempt stays denied.
; Its existing /tmp fallback creates a private non-executable temporary type.
(typetransition p4_linux_console_setup_t p4_linux_tmp_t file p4_linux_console_tmp_t)
(allow p4_linux_console_setup_t p4_linux_tmp_t (dir (getattr search write add_name remove_name)))
(allow p4_linux_console_setup_t p4_linux_console_tmp_t (file (getattr open read write create setattr unlink)))
(allow p4_linux_console_setup_t device (dir (getattr search open read)))
(allow p4_linux_console_setup_t device (chr_file (getattr)))
; Preserve inherited normal /dev/null FDs through the role transition.
; glibc isatty probes only TCGETS2; the null driver returns normal ENOTTY.
(allow p4_linux_console_setup_t p4_linux_standardio_t (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t p4_linux_standardio_t (ioctl chr_file (0x542a)))
(neverallowx p4_linux_console_setup_t p4_linux_standardio_t (ioctl chr_file (not (0x542a))))
(allow p4_linux_console_setup_t null_device (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t null_device (ioctl chr_file (0x542a)))
(neverallowx p4_linux_console_setup_t null_device (ioctl chr_file (not (0x542a))))
(allow p4_linux_console_setup_t random_device (chr_file (getattr open read)))
; Normal glibc 2.43 isatty/tcgetattr issue TCGETS2 (0x802c542a; low 16 bits).
; The selected normal stty -a readback likewise issues TCGETS2, not TCGETS.
(allow p4_linux_console_setup_t tty_device (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t tty_device (ioctl chr_file (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a)))
(neverallowx p4_linux_console_setup_t tty_device (ioctl chr_file (not (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a))))
(allow p4_linux_console_setup_t owntty_device (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t owntty_device (ioctl chr_file (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a)))
(neverallowx p4_linux_console_setup_t owntty_device (ioctl chr_file (not (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a))))
(allow p4_linux_console_setup_t console_device (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t console_device (ioctl chr_file (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a)))
(neverallowx p4_linux_console_setup_t console_device (ioctl chr_file (not (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a))))
(allow p4_linux_console_setup_t p4_linux_console_t (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t p4_linux_console_t (ioctl chr_file (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a)))
(neverallowx p4_linux_console_setup_t p4_linux_console_t (ioctl chr_file (not (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a))))
(allow p4_linux_console_setup_t p4_linux_console_vt_t (chr_file (getattr open read write ioctl)))
(allowx p4_linux_console_setup_t p4_linux_console_vt_t (ioctl chr_file (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a)))
(neverallowx p4_linux_console_setup_t p4_linux_console_vt_t (ioctl chr_file (not (0x4b33 0x4b3b 0x4b44 0x4b45 0x4b47 0x4b49 0x4b66 0x4b67 0x4b68 0x4b71 0x4b72 0x4bfb 0x5413 0x542a))))
