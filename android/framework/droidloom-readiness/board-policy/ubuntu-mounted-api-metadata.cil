; Host traversal is limited to the original proc and sysfs directories, and
; only the selected parent can enter the executor. Invoked service binaries
; must receive a distinct, allowed domain before the kernel will execute them.
(typeattribute p4_nonboard_except_executor_abi_dirs)
(typeattributeset p4_nonboard_except_executor_abi_dirs (and (p4_all_nonboard) (not (or (proc) (or (sysfs) (device))))))
