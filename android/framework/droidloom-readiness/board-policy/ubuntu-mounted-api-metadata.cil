(allow p4_linux_journald_t p4_linux_journal_credentials_t (dir (getattr search open read)))
(neverallow p4_linux_procs p4_linux_credentials_root_t (dir (create rmdir rename relabelfrom relabelto mounton)))
(neverallow p4_linux_journald_t p4_linux_journal_credentials_t (dir (create setattr write add_name remove_name rmdir rename relabelfrom relabelto mounton)))

; Original Ubuntu setup_credentials_plain_dir moves the private journal unit
