(allow p4_linux_service_executor_t p4_linux_systemd_memfd_t (file (ioctl)))
(allowx p4_linux_service_executor_t p4_linux_systemd_memfd_t (ioctl file (0x542a)))
(allow p4_linux_service_executor_t p4_linux_console_t (chr_file (getattr open write)))

; Original Ubuntu systemd passes the execution time over its preconnected
; AF_UNIX socketpair. Both socket endpoint labels belong to PID 1.
(allow init_t self (unix_dgram_socket (sendto)))

; systemd consults these kernel interfaces before it applies SELinuxContext=
