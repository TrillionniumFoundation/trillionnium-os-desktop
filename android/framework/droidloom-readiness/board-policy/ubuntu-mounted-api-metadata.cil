; The distribution's service manager forks its own helper before that helper
; execs a unit with the policy-configured Linux service identity.
(allow init_t self (process (fork sigchld)))

; The original Ubuntu systemd-executor is a short-lived trusted process. It
; consumes a sealed invocation from Ubuntu PID 1, places its own PID into an
; ordinary unit cgroup, and switches to the selected service's own domain.
(type p4_linux_service_executor_t)
(roletype system_r p4_linux_service_executor_t)
(typeattributeset p4_linux_procs (p4_linux_service_executor_t))
