(allow p4_linux_udev_t p4_linux_udev_exec_t (file (getattr open read execute map entrypoint)))
(allow p4_linux_udev_t init_t (process (sigchld)))
(allow init_t p4_linux_udev_t (process (getattr signull signal sigkill sigstop)))
(allow p4_linux_udev_t init_t (fd (use)))
(allow p4_linux_udev_t p4_linux_service_executor_t (fd (use)))
(allow p4_linux_udev_t p4_linux_standardio_t (chr_file (getattr read write)))
(allow p4_linux_udev_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_udev_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_udev_t p4_linux_host_config_t (file (getattr open read map)))
(auditallow p4_linux_service_executor_t p4_linux_udev_t (process (transition)))
(neverallow p4_linux_procs p4_linux_udev_exec_t (file (create write append setattr relabelto relabelfrom execute_no_trans)))
(neverallow p4_linux_procs p4_linux_udev_alias_t (lnk_file (create write unlink rename setattr relabelto relabelfrom)))
(neverallow p4_linux_udev_t p4_all_board_owned (file (execute_no_trans)))
(neverallow p4_linux_udev_t droidloom_broker (process (transition dyntransition ptrace)))
(neverallow p4_linux_udev_t droidloom_policy_loader (process (transition dyntransition ptrace)))

; The original Ubuntu executor narrows its own inherited capability bounding set
; before exec. The stock journal's NoNewPrivileges and CapabilityBoundingSet
; remain in the original service configuration.
(allow p4_linux_service_executor_t self (capability (setpcap)))
(allow p4_linux_service_executor_t self (process (setcap)))
(auditallow p4_linux_service_executor_t self (capability (setpcap)))
(neverallow p4_linux_service_executor_t p4_android_userspace (process (setcap)))
(neverallow p4_linux_journald_t p4_linux_service_executor_t (process (setcap)))

; The real initramfs already made /run/udev before policy load. The board pins
; just that root-owned directory on the same /run mount, without walking its children.
(type p4_linux_udev_run_t)
(type p4_linux_udev_listener_t)
(type p4_linux_udev_rules_t)
(type p4_linux_udev_state_t)
(roletype object_r p4_linux_udev_run_t)
(roletype object_r p4_linux_udev_listener_t)
(roletype object_r p4_linux_udev_rules_t)
(roletype object_r p4_linux_udev_state_t)
(typeattributeset p4_linux_data (p4_linux_udev_run_t p4_linux_udev_listener_t p4_linux_udev_rules_t p4_linux_udev_state_t))
(allow kernel p4_linux_udev_run_t (dir (getattr relabelto)))
(allow p4_linux_udev_run_t tmpfs (filesystem (associate)))
(allow p4_linux_udev_listener_t tmpfs (filesystem (associate)))
(allow p4_linux_udev_state_t tmpfs (filesystem (associate)))
(allow init_t p4_linux_udev_run_t (dir (getattr search open write add_name remove_name)))
(typetransition init_t p4_linux_udev_run_t sock_file "control" p4_linux_udev_listener_t)
(typetransition init_t p4_linux_udev_run_t sock_file "io.systemd.Udev" p4_linux_udev_listener_t)
(allow init_t p4_linux_udev_listener_t (sock_file (create getattr setattr unlink)))
; Linux checks both access modes when passing an O_RDWR netlink socket across exec.
; Tag the original manager's kobject socket, leaving other netlink socket classes untouched.
(type p4_linux_udev_netlink_t)
(roletype object_r p4_linux_udev_netlink_t)
(roletype system_r p4_linux_udev_netlink_t)
(typeattributeset p4_linux_data (p4_linux_udev_netlink_t))
(typetransition init_t init_t netlink_kobject_uevent_socket p4_linux_udev_netlink_t)
(allow init_t p4_linux_udev_netlink_t (netlink_kobject_uevent_socket (create bind getattr getopt setopt read write)))
(allow p4_linux_service_executor_t p4_linux_udev_netlink_t (netlink_kobject_uevent_socket (getattr read write)))
(allow p4_linux_service_executor_t init_t (unix_stream_socket (getattr read write)))
(neverallow p4_linux_service_executor_t init_t (unix_stream_socket (connectto accept)))
(allow p4_linux_udev_t p4_linux_udev_netlink_t (netlink_kobject_uevent_socket (getattr getopt setopt read write)))
(neverallow p4_android_userspace p4_linux_udev_netlink_t (netlink_kobject_uevent_socket (create bind read write sendto)))
(neverallow p4_linux_service_executor_t p4_linux_udev_netlink_t (netlink_kobject_uevent_socket (create bind sendto)))
(neverallow p4_linux_udev_t self (capability (sys_admin)))
; Stock worker_spawn creates its own MONITOR_GROUP_NONE endpoint before forking.
(type p4_linux_udev_worker_netlink_t)
(roletype object_r p4_linux_udev_worker_netlink_t)
(roletype system_r p4_linux_udev_worker_netlink_t)
(typeattributeset p4_linux_data (p4_linux_udev_worker_netlink_t))
(typetransition p4_linux_udev_t p4_linux_udev_t netlink_kobject_uevent_socket p4_linux_udev_worker_netlink_t)
(allow p4_linux_udev_t p4_linux_udev_worker_netlink_t (netlink_kobject_uevent_socket (create bind getattr getopt setopt read write)))
(allow p4_linux_udev_t self (process (fork sigchld)))
(allow p4_linux_udev_t sysfs (filesystem (getattr)))
(allow p4_linux_udev_t sysfs (file (getattr)))
(neverallow p4_linux_udev_t sysfs (file (open read write append map execute)))
(neverallow p4_android_userspace p4_linux_udev_worker_netlink_t (netlink_kobject_uevent_socket (create bind read write sendto)))
(allow p4_linux_udev_t init_t (unix_stream_socket (getattr getopt setopt read write accept listen)))
; Original udev workers register their own abstract notification endpoint.
(allow p4_linux_udev_t self (unix_dgram_socket (create bind connect write read getattr getopt setopt)))
(allow p4_linux_udev_t init_t (unix_dgram_socket (sendto)))
(allow p4_linux_udev_t p4_linux_systemd_notify_t (sock_file (write)))
(allow p4_linux_udev_t p4_linux_systemd_run_t (dir (getattr search)))
(allow p4_linux_udev_t p4_linux_run_t (dir (getattr search)))
(allow p4_linux_udev_t p4_linux_udev_run_t (dir (getattr search open read write add_name remove_name)))
(typetransition p4_linux_udev_t p4_linux_udev_run_t dir p4_linux_udev_state_t)
(typetransition p4_linux_udev_t p4_linux_udev_run_t file p4_linux_udev_state_t)
(allow p4_linux_udev_t p4_linux_udev_state_t (dir (create getattr open read search write add_name remove_name rmdir)))
(allow p4_linux_udev_t p4_linux_udev_state_t (file (create getattr open read write rename unlink)))
(allow p4_linux_udev_t p4_linux_udev_rules_t (dir (getattr search open read)))
(allow p4_linux_udev_t p4_linux_udev_rules_t (file (getattr open read map)))
(allow p4_linux_udev_t proc (dir (getattr search)))
(allow p4_linux_udev_t sysfs (dir (getattr search)))
(allow p4_linux_udev_t device (dir (getattr search)))
(allow p4_linux_udev_t self (process (getsched)))
(neverallow p4_linux_udev_t p4_linux_udev_listener_t (sock_file (create relabelto relabelfrom unlink setattr)))
(neverallow p4_linux_udev_t p4_linux_udev_rules_t (file (write append execute create unlink)))
(neverallow p4_linux_udev_t init_t (netlink_kobject_uevent_socket (write sendto)))
(neverallow p4_android_userspace p4_linux_udev_listener_t (sock_file (open read write create setattr unlink relabelto relabelfrom)))
