(allow p4_linux_service_executor_t init_t (unix_dgram_socket (read write)))
(allow p4_linux_service_executor_t device (dir (getattr search)))
(allow init_t p4_linux_service_executor_t (dir (getattr search)))
(allow init_t p4_linux_service_executor_t (process (siginh rlimitinh)))
(allow p4_linux_service_executor_t self (process (signal)))
(allow p4_linux_service_executor_t p4_linux_standardio_t (chr_file (ioctl)))
(allowx p4_linux_service_executor_t p4_linux_standardio_t (ioctl chr_file (0x542a)))
(neverallow p4_linux_service_executor_t device (chr_file (open read write ioctl map)))
(allow p4_linux_service_executor_t p4_linux_elf_interpreter_t (file (getattr map read open execute)))
(allow p4_linux_service_executor_t p4_linux_cgroup_root_t (dir (search getattr)))
