; The real Ubuntu manager identifies kernel mounts prepared by the board.
(allow init_t cgroup_v2 (dir (getattr)))
(allow init_t devpts (dir (getattr)))
(allow init_t securityfs (dir (getattr)))
(allow init_t sysfs (filesystem (getattr)))
; Linux TCGETS2 on the physical-numbered, Linux-private console.
(allow init_t p4_linux_console_t (chr_file (ioctl)))
(allowx init_t p4_linux_console_t (ioctl chr_file (0x542a)))
(neverallowx init_t p4_linux_console_t (ioctl chr_file (not (0x542a))))

; The original Ubuntu shared-memory mount is created before global policy load.
; The manager can identify this Linux-only root without modifying its contents.
(type p4_linux_shm_root_t)
(roletype object_r p4_linux_shm_root_t)
(typeattributeset p4_linux_data (p4_linux_shm_root_t))
(allow kernel p4_linux_shm_root_t (dir (getattr relabelto)))
(allow p4_linux_shm_root_t tmpfs (filesystem (associate)))
(allow init_t p4_linux_shm_root_t (dir (getattr)))
(neverallow p4_linux_procs p4_linux_shm_root_t (dir (relabelfrom relabelto mounton)))

; PID 1 gathers its own file descriptors and reads its immutable distro configuration.
(allow init_t self (dir (open read)))
(type p4_linux_systemd_config_t)
(roletype object_r p4_linux_systemd_config_t)
(typeattributeset p4_linux_data (p4_linux_systemd_config_t))
(allow init_t p4_linux_systemd_config_t (file (getattr open read)))
(neverallow p4_linux_procs p4_linux_systemd_config_t (file (write append setattr relabelto relabelfrom create execute entrypoint)))
; fstatfs on the original, already mounted Linux unified hierarchy.
(allow init_t cgroup_v2 (filesystem (getattr)))

; The timezone event source observes entries directly under the host /etc.
(type p4_linux_etc_dir_t)
(roletype object_r p4_linux_etc_dir_t)
(typeattributeset p4_linux_data (p4_linux_etc_dir_t))
(allow p4_linux_procs p4_linux_etc_dir_t (dir (getattr search)))
(allow kernel p4_linux_etc_dir_t (dir (getattr search)))
(allow init_t p4_linux_etc_dir_t (dir (read watch)))
(neverallow p4_linux_procs p4_linux_etc_dir_t (dir (write add_name remove_name relabelfrom relabelto)))

; Only the distribution manager executes the original immutable systemd helper.
(type p4_linux_systemd_executor_t)
(roletype object_r p4_linux_systemd_executor_t)
(typeattributeset p4_linux_data (p4_linux_systemd_executor_t))
(allow init_t p4_linux_systemd_executor_t (file (getattr open read execute map execute_no_trans)))
(neverallow p4_linux_procs p4_linux_systemd_executor_t (file (write append setattr create relabelto relabelfrom entrypoint)))
