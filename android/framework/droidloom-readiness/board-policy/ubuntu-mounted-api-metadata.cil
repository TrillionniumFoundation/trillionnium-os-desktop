; The real Ubuntu manager identifies kernel mounts prepared by the board.
(allow init_t cgroup_v2 (dir (getattr)))
(allow init_t devpts (dir (getattr)))
(allow init_t securityfs (dir (getattr)))
(allow init_t sysfs (filesystem (getattr)))
; Linux TCGETS2 on the physical-numbered, Linux-private console.
(allow init_t p4_linux_console_t (chr_file (ioctl)))
(allowx init_t p4_linux_console_t (ioctl chr_file (0x542a)))
(neverallowx init_t p4_linux_console_t (ioctl chr_file (not (0x542a))))

; The original Ubuntu shared-memory mount is created before global policy load.
; The manager can identify this Linux-only root without modifying its contents.
(type p4_linux_shm_root_t)
(roletype object_r p4_linux_shm_root_t)
(typeattributeset p4_linux_data (p4_linux_shm_root_t))
(allow kernel p4_linux_shm_root_t (dir (getattr relabelto)))
(allow p4_linux_shm_root_t tmpfs (filesystem (associate)))
(allow init_t p4_linux_shm_root_t (dir (getattr)))
(neverallow p4_linux_procs p4_linux_shm_root_t (dir (relabelfrom relabelto mounton)))

; PID 1 gathers its own file descriptors and reads its immutable distro configuration.
(allow init_t self (dir (open read)))
(type p4_linux_systemd_config_t)
(roletype object_r p4_linux_systemd_config_t)
(typeattributeset p4_linux_data (p4_linux_systemd_config_t))
(allow init_t p4_linux_systemd_config_t (file (getattr open read)))
(neverallow p4_linux_procs p4_linux_systemd_config_t (file (write append setattr relabelto relabelfrom create execute entrypoint)))
; fstatfs on the original, already mounted Linux unified hierarchy.
(allow init_t cgroup_v2 (filesystem (getattr)))

; The timezone event source observes entries directly under the host /etc.
(type p4_linux_etc_dir_t)
(roletype object_r p4_linux_etc_dir_t)
(typeattributeset p4_linux_data (p4_linux_etc_dir_t))
(allow p4_linux_procs p4_linux_etc_dir_t (dir (getattr search)))
(allow kernel p4_linux_etc_dir_t (dir (getattr search)))
(allow init_t p4_linux_etc_dir_t (dir (read watch)))
(neverallow p4_linux_procs p4_linux_etc_dir_t (dir (write add_name remove_name relabelfrom relabelto)))

; Only the distribution manager executes the original immutable systemd helper.
(type p4_linux_systemd_executor_t)
(roletype object_r p4_linux_systemd_executor_t)
(typeattributeset p4_linux_data (p4_linux_systemd_executor_t))
(allow init_t p4_linux_systemd_executor_t (file (getattr open read execute map)))
(neverallow p4_linux_procs p4_linux_systemd_executor_t (file (write append setattr create relabelto relabelfrom)))
(neverallow p4_linux_other_than_executor p4_linux_systemd_executor_t (file (entrypoint)))

; The original system manager searches only its distribution and local unit directories.
(type p4_linux_unit_directory_t)
(type p4_linux_unit_file_t)
(roletype object_r p4_linux_unit_directory_t)
(roletype object_r p4_linux_unit_file_t)
(typeattributeset p4_linux_data (p4_linux_unit_directory_t p4_linux_unit_file_t))
(allow init_t p4_linux_unit_directory_t (dir (getattr search open read watch)))
(allow init_t p4_linux_unit_file_t (file (getattr open read map)))
(allow init_t p4_linux_unit_file_t (lnk_file (getattr read)))
(neverallow p4_linux_procs p4_linux_unit_directory_t (dir (write create add_name remove_name relabelto relabelfrom)))
(neverallow p4_linux_procs p4_linux_unit_file_t (file (write append setattr create relabelto relabelfrom entrypoint)))

; PID 1 owns its notification endpoint. Only the selected early observer uses sd_notify.
(type p4_linux_systemd_notify_t)
(roletype object_r p4_linux_systemd_notify_t)
(typeattributeset p4_linux_data (p4_linux_systemd_notify_t))
(typetransition init_t p4_linux_systemd_run_t sock_file "notify" p4_linux_systemd_notify_t)
(allow p4_linux_systemd_notify_t tmpfs (filesystem (associate)))
(allow init_t self (unix_dgram_socket (create bind read getattr getopt setopt shutdown)))
(allow init_t p4_linux_systemd_notify_t (sock_file (create getattr setattr unlink)))
(allow droidloom_container_entry_t self (unix_dgram_socket (create write getattr getopt setopt)))
(allow droidloom_container_entry_t p4_linux_systemd_notify_t (sock_file (write)))
(allow droidloom_container_entry_t init_t (unix_dgram_socket (sendto)))
(neverallow p4_android_userspace p4_linux_systemd_notify_t (sock_file (open read write create setattr unlink relabelto relabelfrom)))

; Ubuntu initializes its machine-id once, and owns no associated Android identity.
(type p4_linux_machine_id_t)
(roletype object_r p4_linux_machine_id_t)
(typeattributeset p4_linux_data (p4_linux_machine_id_t))
(allow init_t p4_linux_machine_id_t (file (getattr open read write lock)))
(neverallow p4_linux_procs p4_linux_machine_id_t (file (create unlink rename relabelfrom relabelto entrypoint execute)))

; The distribution's service manager forks its own helper before that helper
; execs a unit with the policy-configured Linux service identity.
(allow init_t self (process (fork sigchld)))

; The original Ubuntu systemd-executor is a short-lived trusted process. It
; consumes a sealed invocation from Ubuntu PID 1, places its own PID into an
; ordinary unit cgroup, and switches to the selected service's own domain.
(type p4_linux_service_executor_t)
(roletype system_r p4_linux_service_executor_t)
(typeattributeset p4_linux_procs (p4_linux_service_executor_t))
(typeattribute p4_linux_other_than_executor)
(typeattributeset p4_linux_other_than_executor (and (p4_linux_procs) (not (p4_linux_service_executor_t))))
(typetransition init_t p4_linux_systemd_executor_t process p4_linux_service_executor_t)
(allow init_t p4_linux_service_executor_t (process (transition getattr signull signal sigkill)))
(allow p4_linux_service_executor_t p4_linux_systemd_executor_t (file (entrypoint open read getattr execute map)))
(allow p4_linux_service_executor_t init_t (process (sigchld)))
(allow p4_linux_service_executor_t init_t (fd (use)))
(allow p4_linux_service_executor_t p4_linux_rootdir_t (dir (getattr search)))
(allow p4_linux_service_executor_t p4_linux_runtime_lib_t (file (getattr open read execute map)))
(allow p4_linux_service_executor_t p4_linux_host_config_t (file (getattr open read map)))
(allow p4_linux_service_executor_t p4_linux_systemd_memfd_t (file (getattr open read)))
(allow p4_linux_service_executor_t p4_linux_elf_interpreter_t (file (getattr map read open execute)))
(allow p4_linux_service_executor_t p4_linux_cgroup_root_t (dir (search getattr)))
(allow p4_linux_service_executor_t p4_linux_system_slice_t (dir (search getattr)))
(allow p4_linux_service_executor_t p4_linux_unit_cgroup_t (dir (search getattr open)))
(allow p4_linux_service_executor_t p4_linux_unit_cgroup_t (file (getattr open write)))
(allow p4_linux_service_executor_t sysfs (dir (getattr search)))
(allow p4_linux_service_executor_t proc (dir (getattr search)))
(allow p4_linux_service_executor_t proc (lnk_file (getattr read)))
(allow p4_linux_service_executor_t self (dir (getattr open read search)))
(allow p4_linux_service_executor_t self (file (open read getattr)))
(allow p4_linux_service_executor_t self (lnk_file (getattr read)))
(allow p4_linux_service_executor_t p4_linux_standardio_t (chr_file (getattr open read write)))
(allow p4_linux_service_executor_t self (process (setexec getcap)))
(allow p4_linux_service_executor_t droidloom_broker (process (transition)))
(allow p4_linux_service_executor_t droidloom_policy_loader (process (transition)))
(allow p4_linux_service_executor_t droidloom_container_entry_t (process (transition)))
(allow p4_linux_service_executor_t droidloom_broker (process2 (nnp_transition)))
(allow p4_linux_service_executor_t droidloom_policy_loader (process2 (nnp_transition)))
(allow p4_linux_service_executor_t droidloom_container_entry_t (process2 (nnp_transition)))
(allow p4_linux_service_executor_t droidloom_container_entry_exec_t (file (getattr open read execute map)))
(allow p4_linux_service_executor_t droidloom_policy_loader_exec (file (getattr open read execute map)))
(typetransition p4_linux_service_executor_t droidloom_container_entry_exec_t process droidloom_container_entry_t)
(typetransition p4_linux_service_executor_t droidloom_policy_loader_exec process droidloom_policy_loader)
(auditallow init_t p4_linux_service_executor_t (process (transition)))
(auditallow p4_linux_service_executor_t droidloom_broker (process (transition)))
(neverallow p4_linux_service_executor_t cgroup_v2 (file (write append create unlink relabelfrom relabelto)))
(neverallow p4_linux_service_executor_t cgroup_app (file (write append create unlink relabelfrom relabelto)))

; Host traversal is limited to the original proc and sysfs directories, and
; only the selected parent can enter the executor. Invoked service binaries
; must receive a distinct, allowed domain before the kernel will execute them.
(typeattribute p4_nonboard_except_executor_abi_dirs)
(typeattributeset p4_nonboard_except_executor_abi_dirs (and (p4_all_nonboard) (not (or (proc) (sysfs)))))
(neverallow p4_linux_service_executor_t p4_nonboard_except_executor_abi_dirs (dir (search)))
(typeattribute p4_not_ubuntu_pid1)
(typeattributeset p4_not_ubuntu_pid1 (not (init_t)))
(neverallow p4_not_ubuntu_pid1 p4_linux_service_executor_t (process (transition dyntransition)))
(neverallow p4_linux_service_executor_t p4_all_board_owned (file (execute_no_trans)))
