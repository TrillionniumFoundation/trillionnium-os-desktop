; Normal libselinux 3.9 init.c checks the mounted selinuxfs with statfs/statvfs.
; This constructor is metadata-only; it is not a native query client and cannot
; read/write selinuxfs files or issue a security-server request.
(typeattribute p4_native_selinux_metadata_clients)
