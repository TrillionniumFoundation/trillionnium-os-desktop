; Normal libc-bin 2.43-2ubuntu2.7, ldconfig.service ExecStart=ldconfig -X.
; The exact static PIE scans ELF headers as data. It neither executes a helper
; nor updates library symlinks. Main cache publication is temp+fsync+rename.
(type p4_linux_ldconfig_t)
(roletype system_r p4_linux_ldconfig_t)
(typeattributeset p4_linux_procs (p4_linux_ldconfig_t))
(type p4_linux_ldconfig_exec_t)
(type p4_linux_ldconfig_config_t)
(type p4_linux_ldconfig_config_dir_t)
(type p4_linux_ldconfig_aux_dir_t)
(type p4_linux_ldconfig_aux_t)
(roletype object_r p4_linux_ldconfig_exec_t)
(roletype object_r p4_linux_ldconfig_config_t)
(roletype object_r p4_linux_ldconfig_config_dir_t)
(roletype object_r p4_linux_ldconfig_aux_dir_t)
(roletype object_r p4_linux_ldconfig_aux_t)
(typeattributeset p4_linux_data (p4_linux_ldconfig_exec_t p4_linux_ldconfig_config_t p4_linux_ldconfig_config_dir_t p4_linux_ldconfig_aux_dir_t p4_linux_ldconfig_aux_t))
(call p4_ubuntu_system_service (p4_linux_ldconfig_t p4_linux_ldconfig_exec_t))
(allow init_t p4_linux_ldconfig_t (process (getattr signull signal sigkill sigstop)))
(allow init_t p4_linux_ldconfig_t (dir (getattr search)))
(allow p4_linux_ldconfig_t init_t (process (sigchld)))
(allow p4_linux_ldconfig_t p4_linux_service_executor_t (process (sigchld)))
(allow p4_linux_ldconfig_t p4_linux_service_executor_t (fd (use)))
(allow p4_linux_ldconfig_t p4_linux_service_executor_t (unix_stream_socket (getattr read write)))
(allow p4_linux_ldconfig_t p4_linux_standardio_t (chr_file (getattr read write)))
; glob/readdir scan only data; no runtime library or interpreter is executed.
(allow p4_linux_ldconfig_t p4_linux_rootdir_t (dir (getattr open read search)))
(allow p4_linux_ldconfig_t p4_linux_ldconfig_config_dir_t (dir (getattr open read search)))
(allow p4_linux_ldconfig_t p4_linux_ldconfig_config_t (file (getattr open read)))
(allow p4_linux_ldconfig_t p4_linux_runtime_lib_t (file (getattr open read map)))
(allow p4_linux_ldconfig_t p4_linux_elf_interpreter_t (file (getattr open read map)))
; The console preserver isolates this new cache writer; preserve its exact
; public runtime-library data view explicitly across those existing aliases.
(allow p4_linux_ldconfig_t p4_linux_console_entry_runtime_lib_t (file (getattr open read map)))
(allow p4_linux_ldconfig_t p4_linux_console_library_runtime_lib_t (file (getattr open read map)))
(allow p4_linux_ldconfig_t p4_linux_console_public_runtime_lib_t (file (getattr open read map)))
(allow p4_linux_ldconfig_t p4_linux_console_locale_runtime_lib_t (file (getattr open read map)))
(allow p4_linux_ldconfig_t p4_linux_console_cache_dir_t (dir (getattr open read search)))
; Only the fixed normal temporary basename can acquire the cache file type.
; Directory add/remove alone gives no body/unlink rights on account files.
(allow p4_linux_ldconfig_t p4_linux_sysusers_etc_root_t (dir (getattr search write add_name remove_name)))
(typetransition p4_linux_ldconfig_t p4_linux_sysusers_etc_root_t file "ld.so.cache~" p4_linux_console_ld_cache_native_config_t)
(allow p4_linux_ldconfig_t p4_linux_console_ld_cache_native_config_t (file (getattr open create write setattr rename unlink)))
; Auxiliary cache failure is a normal fallback, but its complete fixed
; temp+fdatasync+rename cleanup lifecycle remains usable.
(allow p4_linux_ldconfig_t p4_linux_var_cache_t (dir (getattr search write add_name)))
(typetransition p4_linux_ldconfig_t p4_linux_var_cache_t dir "ldconfig" p4_linux_ldconfig_aux_dir_t)
(allow p4_linux_ldconfig_t p4_linux_ldconfig_aux_dir_t (dir (getattr search create write add_name remove_name)))
(typetransition p4_linux_ldconfig_t p4_linux_ldconfig_aux_dir_t file "aux-cache" p4_linux_ldconfig_aux_t)
(typetransition p4_linux_ldconfig_t p4_linux_ldconfig_aux_dir_t file "aux-cache~" p4_linux_ldconfig_aux_t)
(allow p4_linux_ldconfig_t p4_linux_ldconfig_aux_t (file (getattr open read map create write rename unlink)))
; may_create requires the new SID to associate with the ext4 labeledfs SID.
; Keep the existing cache label; no unrelated filesystem or body is admitted.
(allow p4_linux_console_ld_cache_native_config_t labeledfs (filesystem (associate)))
(allow p4_linux_ldconfig_aux_dir_t labeledfs (filesystem (associate)))
(allow p4_linux_ldconfig_aux_t labeledfs (filesystem (associate)))
(typeattribute p4_ldconfig_all_types)
(typeattributeset p4_ldconfig_all_types (all))
(typeattribute p4_ldconfig_other_entries)
(typeattributeset p4_ldconfig_other_entries (not (p4_linux_ldconfig_exec_t)))
(typeattribute p4_ldconfig_other_writable_files)
(typeattributeset p4_ldconfig_other_writable_files (not (or (p4_linux_console_ld_cache_native_config_t) (p4_linux_ldconfig_aux_t))))
(typeattribute p4_ldconfig_other_writable_dirs)
(typeattributeset p4_ldconfig_other_writable_dirs (not (or (p4_linux_sysusers_etc_root_t) (or (p4_linux_var_cache_t) (p4_linux_ldconfig_aux_dir_t)))))
(typeattribute p4_ldconfig_other_sources)
(typeattributeset p4_ldconfig_other_sources (not (p4_linux_service_executor_t)))
(neverallow p4_ldconfig_other_sources p4_linux_ldconfig_t (process (transition dyntransition)))
(neverallow p4_linux_service_executor_t p4_linux_ldconfig_t (process (dyntransition)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_other_entries (file (execute entrypoint)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (file (execute_no_trans append link ioctl execmod relabelfrom relabelto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_other_writable_files (file (write create setattr unlink rename)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_other_writable_dirs (dir (write add_name remove_name create setattr rmdir mounton relabelfrom relabelto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (dir (setattr rmdir mounton relabelfrom relabelto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (lnk_file (create write setattr unlink rename relabelfrom relabelto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (blk_file (all)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (chr_file (open append ioctl map create setattr unlink rename relabelfrom relabelto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (filesystem (mount remount unmount relabelfrom relabelto)))
(neverallow p4_linux_ldconfig_t self (capability (all)))
(neverallow p4_linux_ldconfig_t self (capability2 (all)))
(neverallow p4_linux_ldconfig_t self (cap_userns (all)))
(neverallow p4_linux_ldconfig_t self (cap2_userns (all)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (process (fork transition setexec setcurrent dyntransition ptrace)))
(neverallow p4_linux_ldconfig_t kernel (security (all)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (unix_stream_socket (create bind listen accept connect connectto sendto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (unix_dgram_socket (create bind connect sendto)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (tcp_socket (all)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (udp_socket (all)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (rawip_socket (all)))
(neverallow p4_linux_ldconfig_t p4_ldconfig_all_types (packet_socket (all)))

(typeattribute p4_ldconfig_other_filesystems)
(typeattributeset p4_ldconfig_other_filesystems (not (labeledfs)))
(neverallow p4_linux_console_ld_cache_native_config_t p4_ldconfig_other_filesystems (filesystem (all)))
(neverallow p4_linux_console_ld_cache_native_config_t labeledfs (filesystem (not (associate))))
(neverallow p4_linux_ldconfig_aux_dir_t p4_ldconfig_other_filesystems (filesystem (all)))
(neverallow p4_linux_ldconfig_aux_dir_t labeledfs (filesystem (not (associate))))
(neverallow p4_linux_ldconfig_aux_t p4_ldconfig_other_filesystems (filesystem (all)))
(neverallow p4_linux_ldconfig_aux_t labeledfs (filesystem (not (associate))))
