on init
    start droidloom_readiness
    start droidloom_shutdown

service droidloom_readiness /system_ext/bin/droidloom-readiness
    class core
    user nobody
    group nobody
    restart_period 5

service droidloom_shutdown /system_ext/bin/droidloom-shutdown
    class core
    user nobody
    group nobody
    oneshot

on property:sys.droidloom.shutdown_request=shutdown
    setprop sys.powerctl shutdown

on post-fs && property:sys.droidloom.shutdown_request=shutdown
    setprop sys.powerctl shutdown
