    "successful_closed_response": false
  },
  "qualification": {
    "consumer_module": "experiments/servo-product-owner/src/native_owner.rs",
    "connected_target": "experiments/servo-product-owner/src/connected_tests.rs",
    "source_preparation": "tools/prepare_native_product_owner.py",
    "source_validator": "tools/validate_native_product_owner.py",
    "workflow": ".github/workflows/g2-native-product-owner.yml",
