{
  "schema": "trillionnium.desktop.semantic-resolver.v1",
  "status": "SOURCE_CONTRACT_NO_SERVO_PROMOTION",
  "purpose": "Resolve and act on one current semantic node as one bounded engine-owned operation.",
  "request_binding": {
    "required": [
      "session_id",
      "session_generation",
      "document_generation",
      "semantic_snapshot_revision",
      "mutation_epoch",
      "frame_id",
      "semantic_id",
      "role",
      "accessible_name",
      "structural_fingerprint",
      "action"
    ],
    "caller_fields_are_claims_not_resolution_results": [
      "frame_id",
      "semantic_id",
      "role",
      "accessible_name",
      "structural_fingerprint"
    ]
  },
  "atomicity": {
    "engine_owned": true,
    "single_bounded_operation": true,
    "resolve_retain_revalidate_act_without_yield": true,
    "generic_act_forwarding_forbidden": true,
    "revalidate_immediately_before_action": [
      "session_generation",
      "document_generation",
      "semantic_snapshot_revision",
      "mutation_epoch",
      "frame_id",
      "semantic_id",
      "role",
      "accessible_name",
      "structural_fingerprint"
    ],
    "at_most_one_action": true
  },
  "resolution": {
    "scope": "current_page_owner_current_frame_current_semantic_snapshot",
    "unique_match_required": true,
    "cross_frame_fallback_forbidden": true,
    "retargeting_forbidden": true,
    "material_drift_forbidden": true
  },
  "role_action_policy": {
    "button": ["click", "focus"],
    "link": ["click", "focus"],
    "textbox": ["focus", "set_value", "insert_text"],
    "checkbox": ["click", "set_checked", "focus"],
    "radio": ["click", "set_checked", "focus"],
    "combobox": ["focus", "set_value", "select_option"],
    "option": ["click", "select_option"],
    "slider": ["focus", "set_value"],
    "generic": ["focus"]
  },
  "fail_closed_errors": [
    "session_mismatch",
    "stale_session_generation",
    "stale_document_generation",
    "stale_semantic_snapshot",
    "stale_mutation_epoch",
    "target_not_found",
    "ambiguous_target",
    "frame_mismatch",
    "role_drift",
    "accessible_name_drift",
    "structural_drift",
    "mutation_race",
    "unsupported_action",
    "cancelled",
    "deadline_exceeded"
  ],
  "claim_ceiling": [
    "engine-neutral contract and independent reference only",
    "no Servo DOM or accessibility-tree adapter",
    "no BrowserActor product dispatch promotion",
    "no production AgentPort activation",
    "no external effects"
  ]
}
