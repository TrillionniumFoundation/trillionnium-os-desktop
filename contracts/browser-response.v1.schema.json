{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trillionnium.org/desktop/browser-response.v1.schema.json",
  "title": "TrillionniumOS Desktop canonical Browser API response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "ok"],
  "properties": {
    "protocol": {"const": "trillionnium.desktop.browser-api.v1"},
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "maxLength": 128
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "maxLength": 128
    },
    "session_generation": {"type": "integer", "minimum": 1},
    "ok": {"type": "boolean"},
    "result": {"type": "object"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retry"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "minLength": 1, "maxLength": 1024},
        "retry": {"type": "string", "minLength": 1, "maxLength": 64},
        "details": {"type": "object"}
      }
    }
  },
  "dependentRequired": {
    "session_id": ["session_generation"],
    "session_generation": ["session_id"]
  },
  "allOf": [
    {
      "if": {"properties": {"ok": {"const": true}}, "required": ["ok"]},
      "then": {"required": ["result"], "not": {"required": ["error"]}},
      "else": {"required": ["error"], "not": {"required": ["result"]}}
    }
  ]
}
