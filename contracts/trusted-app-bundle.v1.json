{
  "schema": "trillionnium.desktop.trusted-app-bundle.v1",
  "work_package": "D5-01",
  "status": "SOURCE_CANDIDATE_BLOCKED_UPSTREAM_D4",
  "prerequisites": [
    "D0T-03",
    "D2I-01",
    "D3-01",
    "D4-01"
  ],
  "format": {
    "manifest_schema": "trillionnium.desktop.trusted-app-manifest.v1",
    "signature_algorithm": "Ed25519",
    "canonical_encoding": "UTF-8 canonical JSON with sorted keys and compact separators plus newline",
    "content_digest": "SHA-256",
    "content_root": "domain-separated binary Merkle tree",
    "offline_verification_required": true,
    "network_during_verification_allowed": false
  },
  "origin": {
    "scheme": "https",
    "host_suffix": ".trusted.invalid",
    "host_is_derived_from_app_id": true,
    "external_dns_resolution_allowed": false,
    "certificate_authority_is_product_internal": true,
    "product_internal_certificate_runtime_proven": false
  },
  "manifest_required_fields": [
    "schema",
    "app_id",
    "version",
    "publisher_id",
    "publisher_key_id",
    "entrypoint",
    "synthetic_origin",
    "content_root_sha256",
    "content",
    "csp",
    "storage",
    "service_worker",
    "permissions",
    "key_transition",
    "signature"
  ],
  "path_policy": {
    "absolute_paths_allowed": false,
    "parent_traversal_allowed": false,
    "backslash_allowed": false,
    "empty_component_allowed": false,
    "symlink_allowed": false,
    "duplicate_normalized_path_allowed": false,
    "maximum_path_bytes": 512,
    "maximum_file_count": 4096,
    "maximum_file_bytes": 67108864,
    "maximum_bundle_bytes": 536870912
  },
  "csp": {
    "required_directives": {
      "default-src": [
        "'none'"
      ],
      "script-src": [
        "'self'"
      ],
      "style-src": [
        "'self'"
      ],
      "img-src": [
        "'self'",
        "data:"
      ],
      "font-src": [
        "'self'"
      ],
      "connect-src": [
        "'none'"
      ],
      "media-src": [
        "'none'"
      ],
      "object-src": [
        "'none'"
      ],
      "frame-src": [
        "'none'"
      ],
      "worker-src": [
        "'self'"
      ],
      "manifest-src": [
        "'self'"
      ],
      "base-uri": [
        "'none'"
      ],
      "form-action": [
        "'none'"
      ]
    },
    "unsafe_inline_script_allowed": false,
    "unsafe_eval_allowed": false,
    "external_origin_allowed": false,
    "wildcard_allowed": false
  },
  "storage": {
    "partition_key_fields": [
      "app_id",
      "publisher_id"
    ],
    "cross_app_storage_allowed": false,
    "cross_publisher_storage_allowed": false,
    "version_upgrade_may_preserve_partition": true,
    "rollback_may_open_newer_partition": false
  },
  "service_worker": {
    "default_enabled": false,
    "script_must_be_signed_content": true,
    "scope_must_remain_under_synthetic_origin": true,
    "network_fetch_allowed": false,
    "update_source": "signed bundle only",
    "rollback_to_older_worker_allowed": false
  },
  "publisher_rotation": {
    "cross_signature_required_when_key_changes": true,
    "transition_binds_from_key": true,
    "transition_binds_to_key": true,
    "transition_binds_to_public_key_digest": true,
    "transition_binds_minimum_version": true,
    "revoked_predecessor_may_authorize_new_transition": false
  },
  "revocation": {
    "publisher_key_revocation_supported": true,
    "bundle_digest_revocation_supported": true,
    "revocation_epoch_monotonic": true,
    "offline_revocation_snapshot_required": true,
    "fail_closed_on_unknown_snapshot": true
  },
  "anti_downgrade": {
    "highest_accepted_version_persisted": true,
    "lower_version_rejected": true,
    "same_version_different_content_rejected": true,
    "same_version_same_content_is_idempotent": true,
    "publisher_change_without_valid_transition_rejected": true
  },
  "trust_indicator": {
    "visible": true,
    "receipt_bound": true,
    "fields": [
      "app_id",
      "version",
      "publisher_id",
      "publisher_key_id",
      "content_root_sha256",
      "synthetic_origin",
      "revocation_epoch",
      "trust_state"
    ]
  },
  "required_corpus": [
    "rfc8032_signature_vectors",
    "valid_offline_bundle",
    "content_byte_tamper_rejected",
    "manifest_tamper_rejected",
    "signature_tamper_rejected",
    "missing_content_rejected",
    "extra_content_rejected",
    "path_traversal_rejected",
    "symlink_rejected",
    "content_root_order_independent",
    "csp_wildcard_rejected",
    "csp_external_origin_rejected",
    "unsafe_eval_rejected",
    "synthetic_origin_mismatch_rejected",
    "lower_version_rejected",
    "same_version_different_content_rejected",
    "revoked_key_rejected",
    "revoked_bundle_rejected",
    "stale_revocation_snapshot_rejected",
    "unauthorized_key_rotation_rejected",
    "valid_cross_signed_key_rotation",
    "service_worker_out_of_scope_rejected",
    "service_worker_unsigned_script_rejected",
    "trust_indicator_receipt_tamper_rejected"
  ],
  "claim_ceiling": {
    "offline_reference_verifier": true,
    "real_product_trusted_origin_integrated": false,
    "production_publisher_key_enrolled": false,
    "production_signing_key_custody_proven": false,
    "native_trusted_chrome_integrated": false,
    "browser_storage_partition_integrated": false,
    "service_worker_runtime_integrated": false,
    "revocation_distribution_integrated": false,
    "external_effects_enabled": false,
    "hardware_qualified": false,
    "release_ready": false
  }
}
