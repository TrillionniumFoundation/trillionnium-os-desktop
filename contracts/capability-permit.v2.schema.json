{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trillionnium.org/desktop/capability-permit.v2.schema.json",
  "title": "D6 audience-bound capability permit v2 (source candidate)",
  "description": "Distinct from the historical v1 string-subject/Unix-millisecond contract. Signature, byte bounds, portal resources, lifetime, canonicalization and runtime identity require semantic validation. Schema conformance grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "permit_id",
    "issuer_id",
    "issuer_key_id",
    "subject",
    "audience",
    "resource",
    "actions",
    "issued_at_epoch",
    "not_before_epoch",
    "expires_at_epoch",
    "nonce",
    "maximum_uses",
    "constraints",
    "signature"
  ],
  "properties": {
    "permit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issuer_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "issuer_key_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "schema": {
      "const": "trillionnium.desktop.capability-permit.v2"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskflow_principal",
        "mechanism_uid",
        "mechanism_unit",
        "session_id",
        "page_owner_id"
      ],
      "properties": {
        "taskflow_principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mechanism_uid": {
          "type": "integer",
          "minimum": 0
        },
        "mechanism_unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "page_owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "resource": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "handle_id",
            "maximum_bytes"
          ],
          "properties": {
            "kind": {
              "const": "opaque_file_handle"
            },
            "handle_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maximum_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "channel_id",
            "maximum_text_bytes"
          ],
          "properties": {
            "kind": {
              "const": "notification_channel"
            },
            "channel_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maximum_text_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "stream_id",
            "maximum_duration_ms",
            "maximum_gain_millibel"
          ],
          "properties": {
            "kind": {
              "const": "audio_stream"
            },
            "stream_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maximum_duration_ms": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_gain_millibel": {
              "type": "integer"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "origins",
            "resolver_id",
            "proxy_id",
            "contexts",
            "methods",
            "maximum_redirects",
            "maximum_dns_ttl_seconds",
            "maximum_request_bytes",
            "maximum_response_bytes"
          ],
          "properties": {
            "kind": {
              "const": "exact_origin_set"
            },
            "origins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "resolver_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "proxy_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "contexts": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "top_level",
                  "iframe",
                  "worker",
                  "service_worker",
                  "prefetch",
                  "websocket",
                  "download"
                ]
              }
            },
            "methods": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z]+$"
              }
            },
            "maximum_redirects": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "maximum_dns_ttl_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_request_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_response_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
      }
    },
    "maximum_uses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1024
    },
    "constraints": {
      "type": "object"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value_base64"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "value_base64": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88
        }
      }
    },
    "issued_at_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "not_before_epoch": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at_epoch": {
      "type": "integer",
      "minimum": 0
    }
  }
}
