    "identifier_utf8_bytes_maximum": 128,
    "select_utf8_bytes_maximum": 65536,
    "text_utf8_bytes_maximum": 131072,
    "url_utf8_bytes_maximum": 8192,
    "wait_text_utf8_bytes_maximum": 65536
  },
  "units": "UTF-8 bytes",
