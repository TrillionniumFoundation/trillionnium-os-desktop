{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trillionnium.org/desktop/capability-permit.v1.schema.json",
  "title": "TrillionniumOS Desktop capability permit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "permit_id",
    "issuer",
    "subject",
    "audience",
    "operation",
    "resource",
    "issued_unix_ms",
    "expires_unix_ms",
    "nonce",
    "policy_revision",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "trillionnium.desktop.capability-permit.v1"
    },
    "permit_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "issuer": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "subject": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z0-9_.:-]{1,128}$"
    },
    "resource": {
      "type": "object",
      "maxProperties": 16
    },
    "issued_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "expires_unix_ms": {
      "type": "integer",
      "minimum": 0
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "value"
      ],
      "properties": {
        "algorithm": {
          "enum": [
            "ed25519"
          ]
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._:-]{1,128}$"
        },
        "value": {
          "type": "string",
          "minLength": 64,
          "maxLength": 256
        }
      }
    }
  }
}
