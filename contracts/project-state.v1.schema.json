{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "active_plan": {"type": "string"},
    "active_plan_revision": {"type": "string"},
    "evidence_binding_policy": {"type": "object"},
    "integrated_completed_work_packages": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "integrated_implementation_stage": {"type": "string"},
    "not_claimed": {"items": {"type": "string"}, "type": "array", "uniqueItems": true},
    "product": {"const": "TrillionniumOS Desktop"},
