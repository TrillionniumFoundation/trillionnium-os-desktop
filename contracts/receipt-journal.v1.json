{
  "schema": "trillionnium.desktop.receipt-journal-contract.v1",
  "status": "SOURCE_CANDIDATE_NO_BROWSER_DISPATCH",
  "owner": "hepta-session-core::receipt_journal",
  "receipt_envelope_schema": {
    "path": "contracts/receipt.v1.schema.json",
    "sha256": "8610d2e9dd8ccc72b9803b2a51704aa282ccd96f50d19ac33074060e8cfc0eed",
    "version_policy": "active_2026-08-29-d6_plus_historical_2026-08-28-d5_only"
  },
  "format": {
    "byte_order": "big_endian",
    "segment_magic_ascii": "HPTJRNL1",
    "record_magic_ascii": "HPTREC01",
    "version": 1,
    "segment_header_bytes": 148,
    "record_prefix_bytes": 208,
    "record_digest_bytes": 32,
    "maximum_record_payload_bytes": 65536,
    "maximum_segment_bytes": 67108864,
    "digest": "sha256"
  },
  "chain": {
    "sequence": "strictly_monotonic_across_segments",
    "record_digest": "sha256(record_prefix || canonical_payload)",
    "record_link": "previous_record_sha256",
    "segment_link": "previous_segment_sha256",
    "first_segment_requires_zero_predecessors": true,
    "rotation_requires_quiescent_no_unresolved_receipts": true
  },
  "lifecycle": {
    "states": [
      "requested",
      "dispatched",
      "completed",
      "indeterminate",
      "interrupted"
    ],
    "transitions": [
      "none->requested",
      "requested->dispatched",
      "requested->interrupted",
      "dispatched->completed",
      "dispatched->indeterminate",
      "dispatched->interrupted"
    ],
    "terminal_states": [
      "completed",
      "indeterminate",
      "interrupted"
    ]
  },
  "durability": {
    "single_writer": "atomic_writer_lease_bound_to_boot_id_pid_and_proc_start_time",
    "file_mode": "0600",
    "append": "write_all_then_sync_data_before_in_memory_commit",
    "create_and_export": "sync_file_then_sync_parent_directory",
    "failed_append": "writer_poisoned_until_reopen_and_recovery",
    "torn_tail": "typed_and_repairable_only_to_last_complete_record",
    "midstream_corruption": "hard_failure_never_auto_repaired",
    "storage_full": "typed_storage_full_never_completion"
  },
  "effect_recovery": {
    "potential_external_effect": "never_automatic",
    "local_interaction_after_dispatch": "never_automatic",
    "observation_after_dispatch": "caller_may_reobserve_only",
    "journal_executes_or_replays_operations": false
  },
  "privacy": {
    "classes": [
      "public",
      "internal",
      "sensitive",
      "secret_redacted"
    ],
    "secret_redacted_persists_detail": false,
    "redacted_export_includes_sensitive_detail": false,
    "retention_deletes_unexported_segments": false
  },
  "exports": {
    "public_receipt_envelope": "export_redacted_jsonl",
    "public_receipt_envelope_schema": "contracts/receipt.v1.schema.json",
    "public_receipt_envelope_lifecycle": "requested_and_dispatched_are_aggregated_into_one_terminal_envelope",
    "public_receipt_envelope_unresolved": "fail_closed_until_interrupted_or_indeterminate_terminal_record",
    "forensic_lifecycle_export": "export_journal_redacted_jsonl"
  },
  "claim_ceiling": {
    "browser_actor_bound": false,
    "servo_called": false,
    "agent_listener_enabled": false,
    "external_effect_authorized": false,
    "automatic_replay_available": false,
    "product_ready": false
  }
}
