{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifacts": {"items": {"type": "object"}, "type": "array"},
    "base_sha": {"pattern": "^[0-9a-f]{40}$", "type": ["string", "null"]},
    "candidate_head_sha": {"pattern": "^[0-9a-f]{40}$", "type": ["string", "null"]},
    "claim_ceiling": {"type": "object"},
    "commands": {"items": {"type": "object"}, "type": "array"},
    "evidence_tier": {"type": "string"},
    "gate_id": {"maxLength": 128, "minLength": 1, "type": "string"},
    "input_digests": {"additionalProperties": {"type": "string"}, "type": "object"},
    "integrated_main_sha": {"pattern": "^[0-9a-f]{40}$", "type": ["string", "null"]},
    "package_id": {"maxLength": 128, "minLength": 1, "type": "string"},
    "recorded_at": {"type": "string"},
    "repository": {"const": "TrillionniumFoundation/trillionnium-os-desktop"},
    "runner": {"type": "object"},
    "schema": {"const": "trillionnium.desktop.gate-evidence.v1"},
    "status": {"type": "string"},
    "tested_merge_sha": {"pattern": "^[0-9a-f]{40}$", "type": ["string", "null"]},
    "tree_sha": {"pattern": "^[0-9a-f]{40}$", "type": ["string", "null"]},
    "workflow_path": {"type": "string"},
    "workflow_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]}
  },
  "required": [
    "schema",
    "gate_id",
    "package_id",
    "status",
    "evidence_tier",
    "repository",
    "base_sha",
    "candidate_head_sha",
    "tested_merge_sha",
    "integrated_main_sha",
    "tree_sha",
    "workflow_path",
    "workflow_sha256",
    "input_digests",
    "runner",
    "commands",
    "artifacts",
    "claim_ceiling",
    "recorded_at"
  ],
  "title": "TrillionniumOS Desktop gate evidence envelope",
  "type": "object"
}
