{
  "schema": "trillionnium.desktop.workspace-composition.v1",
  "status": "SOURCE_IMPLEMENTED_RUNTIME_PENDING",
  "trusted_chrome": {
    "owner": "native_or_compositor_layer",
    "origin": "https://shell.system.hepta.invalid",
    "visible_for_entire_session": true,
    "shares_dom_with_external_content": false,
    "replaceable_by_external_navigation": false
  },
  "content": {
    "logical_surface_count": 1,
    "owner": "one_PageOwner",
    "runtime": "servo",
    "popup_new_window_policy": "deny",
    "navigation_policy": "reuse_existing_content_surface",
    "old_frame_reuse_after_crash": false
  },
  "input": {
    "pointer_owner": "explicit_hit_test",
    "keyboard_owner": "explicit_focus",
    "ime_owner": "content_only_while_content_has_keyboard_focus",
    "content_crash_returns_keyboard_to": "trusted_chrome"
  },
  "recovery": {
    "trusted_chrome_survives_content_crash": true,
    "crash_placeholder": true,
    "new_session_generation_required": true,
    "new_frame_required_after_recovery": true
  },
  "source_gate": {
    "rust_crate": "crates/hepta-workspace-composition",
    "listener_created": false,
    "servo_started": false,
    "window_created": false,
    "frame_rendered": false
  },
  "runtime_exit_gate": [
    "native_window_created",
    "trusted_chrome_visible",
    "exactly_one_servo_content_surface_visible",
    "local_fixture_first_frame",
    "pointer_keyboard_ime_forwarded",
    "popup_denied",
    "content_crash_preserves_trusted_chrome"
  ]
}
