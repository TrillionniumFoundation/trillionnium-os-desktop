{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.hepta.invalid/browser-wire.v1.schema.json",
  "title": "TrillionniumOS Desktop canonical Browser API wire envelope",
  "type": "object",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "request_id",
        "timeout_ms",
        "operation"
      ],
      "properties": {
        "protocol": {
          "const": "trillionnium.desktop.browser-api.v1"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "session_generation": {
          "type": "integer",
          "minimum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120000
        },
        "operation": {
          "type": "object",
          "required": [
            "method",
            "params"
          ],
          "properties": {
            "method": {
              "enum": [
                "session.create",
                "page.navigate",
                "page.observe",
                "page.act",
                "page.wait",
                "page.extract",
                "session.snapshot",
                "session.close"
              ]
            },
            "params": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "request_id",
        "ok"
      ],
      "properties": {
        "protocol": {
          "const": "trillionnium.desktop.browser-api.v1"
        },
        "request_id": {
          "$ref": "#/$defs/identifier"
        },
        "session_id": {
          "$ref": "#/$defs/identifier"
        },
        "session_generation": {
          "type": "integer",
          "minimum": 1
        },
        "ok": {
          "type": "boolean"
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
