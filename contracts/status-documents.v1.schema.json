{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trillionnium.desktop.status-documents.v1",
  "title": "TrillionniumOS Desktop status-document registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "project_state",
    "contract",
    "documents",
    "integrated_state"
  ],
  "properties": {
    "schema": {
      "const": "trillionnium.desktop.status-documents.v1"
    },
    "project_state": {
      "const": "manifests/project-state.v1.json"
    },
    "contract": {
      "const": "contracts/status-documents.v1.schema.json"
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_entry",
        "integrated",
        "candidate",
        "non_claims",
        "decomposition"
      ],
      "properties": {
        "repository_entry": {
          "$ref": "#/$defs/repository_entry"
        },
        "integrated": {
          "$ref": "#/$defs/integrated"
        },
        "candidate": {
          "$ref": "#/$defs/candidate"
        },
        "non_claims": {
          "$ref": "#/$defs/non_claims"
        },
        "decomposition": {
          "$ref": "#/$defs/decomposition"
        }
      }
    },
    "integrated_state": {
      "$ref": "#/$defs/integrated_state"
    }
  },
  "$defs": {
    "repository_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope"
      ],
      "properties": {
        "path": {
          "const": "README.md"
        },
        "scope": {
          "const": "repository_entry"
        }
      }
    },
    "integrated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope"
      ],
      "properties": {
        "path": {
          "const": "docs/CURRENT_STATE.md"
        },
        "scope": {
          "const": "integrated_main"
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope"
      ],
      "properties": {
        "path": {
          "const": "docs/CANDIDATE_STATUS.md"
        },
        "scope": {
          "const": "candidate_snapshot_and_live_api"
        }
      }
    },
    "non_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope"
      ],
      "properties": {
        "path": {
          "const": "docs/NON_CLAIMS.md"
        },
        "scope": {
          "const": "not_claimed"
        }
      }
    },
    "decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "scope"
      ],
      "properties": {
        "path": {
          "const": "docs/plan/PR73_DECOMPOSITION.md"
        },
        "scope": {
          "const": "planning_only"
        }
      }
    },
    "integrated_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "updated",
        "repository_mode",
        "workspace_members",
        "capabilities",
        "governance_observation",
        "frozen_candidate",
        "next_work"
      ],
      "properties": {
        "schema": {
          "const": "trillionnium.desktop.integrated-state.v1"
        },
        "updated": {
          "type": "string",
          "format": "date"
        },
        "repository_mode": {
          "const": "FULL_PRODUCT_REPOSITORY"
        },
        "workspace_members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "apps/hepta-browserd",
              "apps/hepta-agent-portd",
              "crates/hepta-agent-transport",
              "crates/hepta-browser-codec",
              "crates/hepta-agent-port",
              "crates/hepta-peer-attestation",
              "crates/trillionnium-contract-core",
              "crates/hepta-browser-contracts",
              "crates/hepta-session-core",
              "crates/hepta-workspace-composition"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "product_boundary_and_dependency_locks",
              "bounded_contract_primitives",
              "authenticated_connected_unix_framing",
              "canonical_bounded_browser_api",
              "exactly_one_request_agent_port",
              "local_linux_peer_identity",
              "durable_non_replaying_receipts",
              "deterministic_workspace_composition",
              "default_disabled_agent_port",
              "bounded_servo_compile_qualification"
            ]
          }
        },
        "governance_observation": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/governance_observation"
            }
          ]
        },
        "frozen_candidate": {
          "$ref": "#/$defs/frozen_candidate"
        },
        "next_work": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "issue",
                  "target_branch"
                ],
                "properties": {
                  "type": {
                    "const": "enable_repository_protection"
                  },
                  "issue": {
                    "const": 76
                  },
                  "target_branch": {
                    "const": "main"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "issue",
                  "target_pull_request"
                ],
                "properties": {
                  "type": {
                    "const": "decompose_frozen_pull_request"
                  },
                  "issue": {
                    "const": 78
                  },
                  "target_pull_request": {
                    "const": 73
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "issue",
                  "target_set"
                ],
                "properties": {
                  "type": {
                    "const": "qualify_successor_pull_requests"
                  },
                  "issue": {
                    "const": 78
                  },
                  "target_set": {
                    "const": "bounded_successor_pull_requests"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "issue",
                  "target_component"
                ],
                "properties": {
                  "type": {
                    "const": "complete_runtime_vertical_slice"
                  },
                  "issue": {
                    "const": 86
                  },
                  "target_component": {
                    "const": "agentport_browseractor_servo_receipts"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "issue",
                  "target_environment"
                ],
                "properties": {
                  "type": {
                    "const": "qualify_installed_qemu_image"
                  },
                  "issue": {
                    "const": 88
                  },
                  "target_environment": {
                    "const": "exact_installed_qemu_image"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "governance_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "repository",
        "branch",
        "observed_at",
        "observed_main_sha",
        "branch_protected",
        "required_status_checks",
        "validity",
        "invalidation",
        "tracking_issue"
      ],
      "properties": {
        "kind": {
          "const": "github_repository_settings_snapshot"
        },
        "source": {
          "const": "github_rest_api"
        },
        "repository": {
          "const": "TrillionniumFoundation/trillionnium-os-desktop"
        },
        "branch": {
          "const": "main"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "observed_main_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "branch_protected": {
          "type": "boolean"
        },
        "required_status_checks": {
          "enum": [
            "enabled",
            "disabled"
          ]
        },
        "validity": {
          "const": "snapshot_only"
        },
        "invalidation": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "enum": [
              "main_ref_change",
              "repository_settings_change"
            ]
          }
        },
        "tracking_issue": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "frozen_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "pull_request",
        "state",
        "decomposition_issue",
        "merge_policy"
      ],
      "properties": {
        "kind": {
          "const": "pull_request"
        },
        "pull_request": {
          "const": 73
        },
        "state": {
          "const": "draft_frozen"
        },
        "decomposition_issue": {
          "const": 78
        },
        "merge_policy": {
          "const": "never_merge_as_one_unit"
        }
      }
    }
  }
}
