    "input": "systemd_accepted_socket_on_stdin",
    "bind_or_listen_authority": false,
    "requests_per_process": 1,
    "runtime_ceiling_seconds": 25,
    "restart": "no",
    "user": "hepta-browserd",
    "group": "hepta-browserd",
    "supplementary_group": "hepta-agent",
