{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.trillionnium.org/desktop/d1-qemu-acceptance.v1.schema.json",
  "title": "TrillionniumOS Desktop D1 QEMU acceptance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "machine",
    "acceleration",
    "memory_mib",
    "vcpus",
    "network",
    "direct_kernel_boot",
    "qemu_exit_status",
    "serial_pass_marker",
    "guest_acceptance_sha256",
    "serial_log_sha256",
    "wayland_info_sha256",
    "package_lock_sha256",
    "pre_boot_image_sha256",
    "post_boot_image_sha256",
    "clean_poweroff",
    "claims"
  ],
  "properties": {
    "schema": {
      "const": "trillionnium.desktop.d1-qemu-boot-result.v1"
    },
    "status": {
      "const": "PASS_QEMU_BOOT_AND_HEADLESS_WAYLAND"
    },
    "machine": {
      "const": "q35"
    },
    "acceleration": {
      "const": "tcg"
    },
    "memory_mib": {
      "const": 2048
    },
    "vcpus": {
      "const": 2
    },
    "network": {
      "const": "none"
    },
    "direct_kernel_boot": {
      "const": true
    },
    "qemu_exit_status": {
      "const": 0
    },
    "serial_pass_marker": {
      "const": true
    },
    "guest_acceptance_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "serial_log_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "wayland_info_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "package_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "pre_boot_image_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "post_boot_image_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "clean_poweroff": {
      "const": true
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "systemd_booted",
        "udev_active",
        "dbus_active",
        "logind_active",
        "headless_wayland_active",
        "servo_started",
        "visible_window_created",
        "network_enabled",
        "secure_boot_qualified"
      ],
      "properties": {
        "systemd_booted": { "const": true },
        "udev_active": { "const": true },
        "dbus_active": { "const": true },
        "logind_active": { "const": true },
        "headless_wayland_active": { "const": true },
        "servo_started": { "const": false },
        "visible_window_created": { "const": false },
        "network_enabled": { "const": false },
        "secure_boot_qualified": { "const": false }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
