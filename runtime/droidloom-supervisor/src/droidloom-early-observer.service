[Unit]
Description=Observe the kernel-started Droidloom Android instance
After=local-fs.target droidloom-manager-label.service
Requires=droidloom-manager-label.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/lib/droidloom/production/current/droidloomd --observe-early-container
AppArmorProfile=droidloom-production-broker
NoNewPrivileges=yes
RuntimeDirectory=droidloom-container
RuntimeDirectoryMode=0755
UMask=0077
TimeoutStartSec=255s
TimeoutStopSec=15s
Restart=no

[Install]
WantedBy=multi-user.target
