[Unit]
ConditionKernelCommandLine=init=/usr/lib/droidloom/production/current/droidloom-board-init
Description=Droidloom original Android namespace launcher
Requires=droidloom-manager-label.service droidloom-instance-factory.service
BindsTo=droidloom-instance-factory.service
After=local-fs.target droidloom-manager-label.service droidloom-instance-factory.service
PartOf=droidloom-production.service
ConditionPathIsDirectory=/run/droidloom-early

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
ExecStart=/usr/lib/droidloom/production/current/droidloomd --launch-early-instance
WorkingDirectory=/
UMask=0077
Restart=no
KillMode=process
TimeoutStartSec=240s
TimeoutStopSec=30s
SendSIGKILL=no
SELinuxContext=u:r:droidloom_instance_launcher:s0
AppArmorProfile=droidloom-instance-launcher
# Only the original boot factory creates namespaces. This ordinary client
# keeps no-new-privileges and cannot execute another domain.
NoNewPrivileges=yes
PrivateMounts=no
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
CPUQuota=200%
MemoryMax=2147483648
MemorySwapMax=0
TasksMax=128
