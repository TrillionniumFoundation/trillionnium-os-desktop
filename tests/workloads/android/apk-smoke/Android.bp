// Compiled against the selected AOSP tree; no Play Services or device secrets.
android_app {
    name: "A08Smoke",
    srcs: ["app/src/main/java/**/*.java"],
    manifest: "app/src/main/AndroidManifest.xml",
    resource_dirs: ["app/src/main/res"],
    sdk_version: "current",
    min_sdk_version: "28",
    optimize: { enabled: false },
}

// Separate, unmodified x86_64-native APK workload; NOT a DEX-only pass.
cc_library_shared {
    name: "liba08jni",
    srcs: ["native-smoke/jni/a08jni.c"],
    sdk_version: "current",
    stl: "none",
    compile_multilib: "64",
}

android_app {
    name: "A08NativeSmoke",
    srcs: ["native-smoke/app/src/main/java/**/*.java"],
    manifest: "native-smoke/app/src/main/AndroidManifest.xml",
    resource_dirs: ["native-smoke/app/src/main/res"],
    sdk_version: "current",
    min_sdk_version: "28",
    jni_libs: ["liba08jni"],
    use_embedded_native_libs: true,
    optimize: { enabled: false },
}
