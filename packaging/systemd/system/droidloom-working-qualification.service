[Unit]
Description=Droidloom owned working-copy qualification
Requires=droidloom-container-entry.service
After=droidloom-container-entry.service
ConditionKernelCommandLine=droidloom.working
OnSuccess=droidloom-working-qualification-return.service
OnFailure=droidloom-working-qualification-return.service
OnSuccessJobMode=replace
OnFailureJobMode=replace

[Service]
Type=exec
User=root
Group=root
AppArmorProfile=droidloom-working-qualification
ExecStart=/usr/bin/droidloom-applications --owned-working-qualification
Restart=no
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStopFailureMode=terminate
TimeoutStopSec=180s
RuntimeMaxSec=165477s
CPUQuota=200%
CPUQuotaPeriodSec=100ms
CPUAffinity=20 21
MemoryAccounting=yes
MemoryMax=2147483648
MemorySwapMax=0
TasksAccounting=yes
TasksMax=64
LimitCORE=0
LimitNOFILE=32768
UMask=0077
WorkingDirectory=/
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
Environment=LANG=C.UTF-8
StandardOutput=journal
StandardError=journal

