[Unit]
Description=Collect the controlled candidate and request its original boot
DefaultDependencies=no
ConditionKernelCommandLine=droidloom.once
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=exec
ExecStart=/usr/lib/droidloom/production/current/droidloom-original-once-return __original-once-return
User=root
Group=root
UMask=0077
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_KILL
AmbientCapabilities=
NoNewPrivileges=no
StandardInput=null
StandardOutput=null
StandardError=null
KillMode=control-group
TimeoutStartSec=30
TimeoutStopSec=90
Restart=no
