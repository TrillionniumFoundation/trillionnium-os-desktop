[Unit]
Description=TrillionniumOS Desktop persistent D3 development AgentPort session
Documentation=https://github.com/TrillionniumFoundation/trillionnium-os-desktop
ConditionPathExists=/etc/hepta/enable-agent-port-development
ConditionFileIsExecutable=/usr/libexec/hepta-agent
Requires=hepta-browserd-agent-development.socket
After=hepta-browserd-agent-development.socket
Conflicts=hepta-browserd-agent.socket

[Service]
Type=exec
User=hepta-browserd
Group=hepta-browserd
SupplementaryGroups=hepta-agent
ExecStart=/usr/libexec/hepta-agent-port-development-sessiond --profile development
EnvironmentFile=-/etc/hepta/agent-port-development.conf
Restart=no
TimeoutStopSec=2s
UMask=0077
StateDirectory=hepta-browserd
StateDirectoryMode=0700

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadOnlyPaths=/usr/libexec/hepta-agent
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=default
ProcSubset=all
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service pidfd_open
SystemCallFilter=~@mount @raw-io @reboot @swap @privileged @resources @obsolete @debug
DevicePolicy=closed
ReadWritePaths=/run/hepta/browserd /var/lib/hepta-browserd

# Optional complete-chain restart is administrator configured, never inferred.
# HEPTA_D3_RECEIPT_PREDECESSORS: ordered colon-separated archived journal paths.
# Paths must stay under /var/lib/hepta-browserd/development; omit for segment one.
# See docs/architecture/D3_JOURNAL_CHAIN_RECOVERY.md. No marker is enabled here.

# Opt-in alternative: HEPTA_D3_RECEIPT_STORE selects a fresh managed directory.
# Do not combine with either legacy journal variable. No default is enabled.
# Closed inventory, idle rotation and failures: docs/architecture/MANAGED_RECEIPT_STORE.md.
