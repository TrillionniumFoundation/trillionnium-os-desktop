[Unit]
Description=TrillionniumOS Desktop local AgentPort socket
Documentation=https://github.com/TrillionniumFoundation/trillionnium-os-desktop
ConditionPathExists=/etc/hepta/enable-agent-port

[Socket]
ListenStream=/run/hepta/browserd/agent.sock
SocketUser=hepta-browserd
SocketGroup=hepta-agent
SocketMode=0660
DirectoryMode=0750
Accept=yes
Backlog=8
MaxConnections=8
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
