#!/bin/sh
# Qualification-only external content-process fault injector.
#
# The headed runtime publishes an identity-bound arm marker.  This helper is
# the sole process allowed to deliver SIGKILL in the integrated image; the
# runtime itself only observes the receipt and the resulting topology.
set -eu
umask 077

receipt_tmp=
proof_tmp=
cleanup_temporary_outputs() {
  [ -z "${receipt_tmp:-}" ] || rm -f -- "$receipt_tmp"
  [ -z "${proof_tmp:-}" ] || rm -f -- "$proof_tmp"
}
trap cleanup_temporary_outputs EXIT

unit=trillionnium-d2i-runtime.service
state_dir=/var/lib/trillionnium-d2i
ready="$state_dir/content-crash-ready"
identity="$state_dir/content-process-identity.json"
receipt="$state_dir/content-sigkill-sent.json"
proof="$state_dir/content-process-crash-proof.json"
diagnostics="$state_dir/content-crash-proof-diagnostics.txt"

fail() {
  reason=$1
  printf 'TRILLIONNIUM_D2I_CONTENT_CRASH_PROOF_FAIL:%s\n' "$reason" >&2
  {
    printf 'reason=%s\n' "$reason"
    if [ -n "${candidate_pids:-}" ]; then
      printf 'runtime_pid=%s expected_pid=%s expected_start=%s runtime_exe=%s matching_pids=%s\n' \
        "${runtime_main_pid:-unknown}" "${expected_pid:-unknown}" \
        "${expected_start:-unknown}" "${runtime_exe:-unknown}" "$candidate_pids"
    fi
    systemctl --no-pager --full status "$unit" || true
    journalctl --no-pager -u "$unit" -n 160 || true
  } >"$diagnostics" 2>&1 || true
  # Stop the qualification VM on a failed fault-injection proof so a broken
  # image cannot continue emitting misleading post-fault evidence.
  systemctl poweroff --no-block || systemctl poweroff --force --no-block || true
  exit 1
}

proc_start_time() {
  # Parse after the final `)` so spaces or `)` inside Linux's comm field do
  # not shift the identity fields.  The tail starts at field 3, therefore
  # starttime (field 22 in the full record) is field 20 here.
  IFS= read -r stat_line <"/proc/$1/stat" 2>/dev/null || return 1
  case "$stat_line" in
    *") "*) ;;
    *) return 1 ;;
  esac
  stat_tail=${stat_line##*) }
  printf '%s\n' "$stat_tail" | awk '
    NF >= 20 && $20 ~ /^[1-9][0-9]*$/ { print $20; found = 1 }
    END { exit(found ? 0 : 1) }
  '
}

proc_candidate_pids() {
  # Enumerate /proc and bind candidates by direct PPID.  The optional
  # /proc/<pid>/task/<pid>/children file is not present on every hosted
  # kernel, while direct PPID is the topology proof used by the Rust runtime.
  runtime_pid=$1
  runtime_executable=$2
  for proc_dir in /proc/[0-9]*; do
    pid=${proc_dir##*/}
    [ "$pid" != "$runtime_pid" ] || continue
    [ -r "$proc_dir/stat" ] || continue
    stat_line=$(cat "$proc_dir/stat" 2>/dev/null || true)
    [ -n "$stat_line" ] || continue
    # Strip through the final ')' (the comm field may itself contain ')') and
    # then read state and PPID from the remaining procfs fields.
    stat_tail=${stat_line##*) }
    # shellcheck disable=SC2086 # procfs fields are intentionally split.
    set -- $stat_tail
    [ "${2:-}" = "$runtime_pid" ] || continue
    [ "${1:-}" != Z ] || continue
    candidate_executable=$(readlink -f "$proc_dir/exe" 2>/dev/null || true)
    [ "$candidate_executable" = "$runtime_executable" ] || continue
    [ -r "$proc_dir/cmdline" ] || continue
    candidate_args=$(tr '\000' '\n' <"$proc_dir/cmdline" 2>/dev/null || true)
    printf '%s\n' "$candidate_args" | grep -Fx -- '--content-process' >/dev/null || continue
    printf '%s\n' "$pid"
  done
}

runtime_main_pid=
for _ in $(seq 1 180); do
  runtime_main_pid=$(systemctl show --property MainPID --value "$unit" 2>/dev/null || true)
  case "$runtime_main_pid" in
    ''|0) sleep 1 ;;
    *[!0-9]*) fail runtime_main_pid_not_numeric ;;
    *) [ -d "/proc/$runtime_main_pid" ] && break; sleep 1 ;;
  esac
done
if [ -n "$runtime_main_pid" ] \
  && [ "$runtime_main_pid" != 0 ] \
  && [ -d "/proc/$runtime_main_pid" ]; then
  :
else
  fail runtime_main_pid_missing
fi

for _ in $(seq 1 240); do
  if [ -s "$ready" ] && [ -s "$identity" ]; then
    break
  fi
  runtime_state=$(systemctl show --property ActiveState --value "$unit" 2>/dev/null || true)
  case "$runtime_state" in
    failed|inactive|deactivating) fail runtime_exited_before_arm ;;
  esac
  sleep 1
done
[ -s "$ready" ] || fail external_crash_arm_timeout
[ -s "$identity" ] || fail external_crash_identity_missing

identity_json=$(tr -d '\n' <"$identity")
printf '%s' "$identity_json" \
  | grep -Eq '^\{"generation":1,"pid":[1-9][0-9]*,"start_time":[1-9][0-9]*\}$' \
  || fail external_crash_identity_malformed
generation=$(printf '%s' "$identity_json" \
  | sed -n 's/.*"generation"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
expected_pid=$(printf '%s' "$identity_json" \
  | sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
expected_start=$(printf '%s' "$identity_json" \
  | sed -n 's/.*"start_time"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
[ -n "$generation" ] || fail external_crash_identity_malformed
[ -n "$expected_pid" ] || fail external_crash_pid_missing
[ -n "$expected_start" ] || fail external_crash_start_time_missing
[ "$generation" = 1 ] || fail external_crash_generation_not_one
case "$expected_pid:$expected_start" in
  *[!0-9:]*|:*) fail external_crash_identity_not_numeric ;;
esac

# The runtime must expose exactly one direct content child. Validate the
# persisted pre-fault topology as well as the live /proc scan so an
# intermediate broker/launcher cannot be hidden behind a claimed PID.
pre_fault="$state_dir/process-topology-pre-fault.json"
post_termination="$state_dir/process-topology-post-termination.json"
[ -s "$pre_fault" ] || fail pre_fault_topology_missing
grep -Eq '"active_process_count"[[:space:]]*:[[:space:]]*1' "$pre_fault" \
  || fail pre_fault_topology_count_not_one
grep -Eq '"embedder_pid"[[:space:]]*:[[:space:]]*'"$runtime_main_pid" "$pre_fault" \
  || fail pre_fault_embedder_pid_mismatch
pre_rows=$(grep -Ec '"parent_pid"[[:space:]]*:' "$pre_fault" || true)
[ "$pre_rows" = 1 ] || fail pre_fault_topology_row_count_changed
grep -Eq '"parent_pid"[[:space:]]*:[[:space:]]*'"$runtime_main_pid"',"pid"[[:space:]]*:[[:space:]]*'"$expected_pid" "$pre_fault" \
  || fail pre_fault_process_is_not_direct_child

candidate_count=0
matching_count=0
candidate_cmdline=
runtime_exe=$(readlink -f "/proc/$runtime_main_pid/exe" 2>/dev/null || true)
[ -n "$runtime_exe" ] || fail runtime_executable_missing
candidate_pids=$(proc_candidate_pids "$runtime_main_pid" "$runtime_exe")
for pid in $candidate_pids; do
  matching_count=$((matching_count + 1))
  [ "$pid" = "$expected_pid" ] || continue
  candidate_count=$((candidate_count + 1))
  candidate_cmdline=$(tr '\000' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
done
if [ "$matching_count" = 1 ] && [ "$candidate_count" = 1 ]; then
  :
else
  fail external_crash_target_not_unique
fi
current_start=$(proc_start_time "$expected_pid" 2>/dev/null || true)
[ "$current_start" = "$expected_start" ] \
  || fail external_crash_target_identity_changed

# Deliver exactly one signal from this helper.  The runtime has no kill path;
# it will begin observation only after this receipt is atomically published.
kill -KILL "$expected_pid" || fail external_sigkill_dispatch_failed
receipt_tmp=$(mktemp "$state_dir/.content-sigkill-sent.XXXXXX") \
  || fail external_sigkill_receipt_temp_failed
printf '{"generation":1,"pid":%s,"signal":"SIGKILL","start_time":%s}\n' \
  "$expected_pid" "$expected_start" >"$receipt_tmp" \
  || fail external_sigkill_receipt_write_failed
chmod 0644 "$receipt_tmp" || fail external_sigkill_receipt_mode_failed
[ ! -L "$receipt" ] || fail external_sigkill_receipt_symlinked
mv -f -- "$receipt_tmp" "$receipt" || fail external_sigkill_receipt_publish_failed
receipt_tmp=
if [ ! -f "$receipt" ] || [ -L "$receipt" ]; then
  fail external_sigkill_receipt_publish_invalid
fi

killed_disappeared=false
for _ in $(seq 1 120); do
  if [ ! -e "/proc/$expected_pid/stat" ]; then
    killed_disappeared=true
    break
  fi
  sleep 1
done
[ "$killed_disappeared" = true ] || fail killed_content_process_still_present
[ -d "/proc/$runtime_main_pid" ] || fail runtime_main_process_died

for _ in $(seq 1 120); do
  [ -s "$post_termination" ] && break
  sleep 1
done
[ -s "$post_termination" ] || fail post_termination_topology_missing
grep -Eq '"active_process_count"[[:space:]]*:[[:space:]]*0' "$post_termination" \
  || fail post_termination_topology_not_empty
grep -Eq '"embedder_pid"[[:space:]]*:[[:space:]]*'"$runtime_main_pid" "$post_termination" \
  || fail post_termination_embedder_pid_mismatch
post_term_rows=$(grep -Ec '"parent_pid"[[:space:]]*:' "$post_termination" || true)
[ "$post_term_rows" = 0 ] || fail post_termination_has_content_process

runtime_result=
for _ in $(seq 1 240); do
  for candidate in "$state_dir/runtime-result.json" "$state_dir/runtime-ready.json"; do
    if [ -s "$candidate" ] \
      && grep -Eq '"status"[[:space:]]*:[[:space:]]*"PASS_HEADED_LOCAL_FIXTURE_ONLY"' "$candidate" \
      && grep -Eq '"recovery_generation"[[:space:]]*:[[:space:]]*2' "$candidate" \
      && grep -Eq '"signal_sent"[[:space:]]*:[[:space:]]*true' "$candidate"; then
      runtime_result=$candidate
      break
    fi
  done
  [ -n "$runtime_result" ] && break
  sleep 1
done
[ -n "$runtime_result" ] || fail runtime_recovery_evidence_missing

post_recovery="$state_dir/process-topology-post-recovery.json"
[ -s "$post_recovery" ] || fail replacement_topology_missing
replacement_rows=$(grep -Ec '"parent_pid"[[:space:]]*:' "$post_recovery" || true)
[ "$replacement_rows" = 1 ] || fail replacement_process_not_unique
replacement_line=$(grep '"parent_pid"[[:space:]]*:' "$post_recovery" | head -n1)
replacement_pid=$(printf '%s' "$replacement_line" \
  | sed -n 's/.*"pid"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
replacement_start=$(printf '%s' "$replacement_line" \
  | sed -n 's/.*"start_time"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p')
[ -n "$replacement_pid" ] || fail replacement_process_id_missing
[ -n "$replacement_start" ] || fail replacement_start_time_missing
[ "$replacement_pid" != "$expected_pid" ] \
  || fail replacement_reused_killed_pid
grep -Eq '"active_process_count"[[:space:]]*:[[:space:]]*1' "$post_recovery" \
  || fail post_recovery_topology_count_not_one
grep -Eq '"embedder_pid"[[:space:]]*:[[:space:]]*'"$runtime_main_pid" "$post_recovery" \
  || fail post_recovery_embedder_pid_mismatch
grep -Eq '"parent_pid"[[:space:]]*:[[:space:]]*'"$runtime_main_pid"',"pid"[[:space:]]*:[[:space:]]*'"$replacement_pid" "$post_recovery" \
  || fail post_recovery_process_is_not_direct_child

callback=$(sed -n \
  's/.*"servo_pipeline_panic_callback_observed"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' \
  "$runtime_result" | head -n1)
callback=${callback:-false}
runtime_sha=$(sha256sum "$runtime_result" | awk '{print $1}')
cmdline_sha=$(printf '%s' "$candidate_cmdline" | sha256sum | awk '{print $1}')

proof_tmp=$(mktemp "$state_dir/.content-process-crash-proof.XXXXXX") \
  || fail proof_temp_failed
cat >"$proof_tmp" <<EOF
{
  "schema": "trillionnium.desktop.d2i-content-process-crash-proof.v2",
  "status": "PASS_EXTERNAL_CONTENT_PROCESS_TERMINATION_AND_RECOVERY",
  "runtime_unit": "$unit",
  "runtime_main_pid": $runtime_main_pid,
  "runtime_main_survived": true,
  "killed_content_pid": $expected_pid,
  "killed_content_start_time_ticks": $expected_start,
  "killed_content_cmdline_sha256": "$cmdline_sha",
  "sigkill_delivered": true,
  "killed_pid_disappeared": true,
  "replacement_content_pid": $replacement_pid,
  "replacement_content_start_time_ticks": $replacement_start,
  "replacement_pid_distinct": true,
  "zero_process_intermediate_topology": true,
  "pre_fault_direct_child": true,
  "post_termination_active_content_processes": 0,
  "post_recovery_active_content_processes": 1,
  "post_recovery_direct_child": true,
  "runtime_result_sha256": "$runtime_sha",
  "runtime_generation_after_recovery": 2,
  "crash_callback_observed": $callback,
  "trusted_chrome_visible_after_crash": true,
  "injector_count": 1,
  "runtime_internal_injector": false,
  "claim_ceiling_actual_content_crash": false
}
EOF
grep -Eq '"status"[[:space:]]*:[[:space:]]*"PASS_EXTERNAL_CONTENT_PROCESS_TERMINATION_AND_RECOVERY"' \
  "$proof_tmp" || fail proof_json_invalid
chmod 0644 "$proof_tmp"
[ ! -L "$proof" ] || fail proof_destination_symlinked
mv -f -- "$proof_tmp" "$proof" || fail proof_publish_failed
proof_tmp=
if [ ! -f "$proof" ] || [ -L "$proof" ]; then
  fail proof_publish_invalid
fi
sync "$proof"

printf 'TRILLIONNIUM_D2I_CONTENT_CRASH_PROOF_BEGIN\n'
cat "$proof"
printf 'TRILLIONNIUM_D2I_CONTENT_CRASH_PROOF_END\n'
