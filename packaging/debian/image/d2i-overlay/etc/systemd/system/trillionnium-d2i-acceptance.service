[Unit]
Description=TrillionniumOS D2I installed-image acceptance
Requires=trillionnium-d2i-runtime.service
After=trillionnium-d2i-runtime.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/trillionnium-d2i-acceptance
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=30s
RemainAfterExit=yes

[Install]
WantedBy=trillionnium-d2i-acceptance.target
