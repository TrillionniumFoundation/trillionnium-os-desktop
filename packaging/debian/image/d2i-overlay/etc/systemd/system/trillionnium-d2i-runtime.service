[Unit]
Description=TrillionniumOS D2I headed Servo workspace qualification
Requires=trillionnium-d1-wayland.service
After=trillionnium-d1-wayland.service
ConditionPathExists=/usr/libexec/hepta-workspace-runtime

[Service]
# Keep the embedder process supervised while the external injector and
# acceptance unit consume its evidence.  A oneshot runtime would not expose a
# MainPID until it exited, forcing the injector to race a completed process.
Type=simple
User=hepta-desktop
Group=hepta-desktop
StateDirectory=trillionnium-d2i
StateDirectoryMode=0700
RuntimeDirectory=hepta-desktop
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/hepta-desktop
Environment=HOME=/run/hepta-desktop
Environment=XDG_CACHE_HOME=/run/hepta-desktop/cache
Environment=XDG_CONFIG_HOME=/run/hepta-desktop/config
Environment=WAYLAND_DISPLAY=wayland-0
Environment=WINIT_UNIX_BACKEND=wayland
# The D2I guest runs under QEMU TCG.  LLVMpipe JIT workers can bind generated
# machine code to the synthetic CPU feature surface and have crashed before the
# runtime can arm its evidence protocol.  Keep this qualification deterministic
# and architecture-neutral by selecting Mesa's interpreter renderer explicitly.
Environment=LIBGL_ALWAYS_SOFTWARE=1
Environment=GALLIUM_DRIVER=softpipe
Environment=DRAW_USE_LLVM=0
Environment=HEPTA_D0A02_OUTPUT=/var/lib/trillionnium-d2i
Environment=HEPTA_D2I_HOLD_AFTER_RESULT=1
ExecStartPre=/usr/bin/mkdir -p /run/hepta-desktop/cache /run/hepta-desktop/config
ExecStart=/usr/libexec/hepta-workspace-runtime
TimeoutStartSec=300s
RemainAfterExit=no
StandardOutput=journal+console
StandardError=journal+console
KillMode=control-group
Restart=no
NoNewPrivileges=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# The headed qualification fixture serves its deterministic page on the
# loopback-only HTTP origin 127.0.0.1.  PrivateNetwork=yes keeps that origin
# isolated from every external interface; AF_UNIX remains required for the
# Wayland display.  Do not copy this qualification-only allowance to the
# production AgentPort units.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=trillionnium-d2i-acceptance.target
