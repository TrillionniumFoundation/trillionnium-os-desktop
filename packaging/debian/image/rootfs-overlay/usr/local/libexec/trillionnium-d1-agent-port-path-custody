#!/bin/bash
set -euo pipefail

socket=/run/hepta/browserd/agent.sock
socket_directory=/run/hepta/browserd
marker=/etc/hepta/enable-agent-port
forged=/run/hepta/browserd/browserd-forged-entry
unit=hepta-browserd-agent.socket

fail() {
  printf 'TRILLIONNIUM_D1_PATH_CUSTODY_FAIL:%s\n' "$1"
  exit 1
}

cleanup() {
  systemctl stop "$unit" >/dev/null 2>&1 || true
  rm -f "$marker" "$forged"
}
trap cleanup EXIT

[[ ! -e "$marker" ]] || fail marker_preexisted
install -d -m 0755 /etc/hepta
: > "$marker"
systemctl start "$unit" || fail socket_activation_failed
for _ in $(seq 1 80); do
  [[ -S "$socket" ]] && break
  sleep 0.25
done
[[ -S "$socket" ]] || fail socket_missing

socket_identity=$(stat -c '%U:%G:%a' "$socket")
[[ "$socket_identity" == hepta-browserd:hepta-agent:660 ]] \
  || fail "socket_identity:$socket_identity"
directory_identity=$(stat -c '%U:%G:%a' "$socket_directory")
[[ "$directory_identity" == root:hepta-agent-socket:750 ]] \
  || fail "directory_identity:$directory_identity"

if id -Gn hepta-browserd | tr ' ' '\n' | grep -Fxq hepta-agent-socket; then
  fail browser_service_in_directory_custody_group
fi
id -Gn hepta-agent | tr ' ' '\n' | grep -Fxq hepta-agent-socket \
  || fail agent_client_missing_directory_custody_group

run_denied() {
  local probe=$1
  shift
  if systemd-run \
    --wait \
    --pipe \
    --quiet \
    --collect \
    --unit="trillionnium-d1-path-custody-${probe}" \
    --property=User=hepta-browserd \
    --property=Group=hepta-browserd \
    /bin/sh -eu -c "$*" >/dev/null 2>&1; then
    fail "browser_service_path_probe_succeeded:$probe"
  fi
}

run_denied create ": > '$forged'"
[[ ! -e "$forged" ]] || fail browser_service_created_directory_entry
run_denied chmod "chmod 0777 '$socket'"
[[ "$(stat -c '%a' "$socket")" == 660 ]] || fail socket_mode_changed
run_denied unlink "rm -f '$socket'"
[[ -S "$socket" ]] || fail socket_path_removed
run_denied rename "mv '$socket' '$socket.moved'"
[[ -S "$socket" && ! -e "$socket.moved" ]] || fail socket_path_renamed

systemctl stop "$unit" || fail socket_stop_failed
rm -f "$marker"
[[ ! -S "$socket" ]] || fail socket_remained_after_stop
[[ ! -e "$marker" ]] || fail marker_remained
trap - EXIT
printf '%s\n' TRILLIONNIUM_D1_PATH_CUSTODY_PASS
