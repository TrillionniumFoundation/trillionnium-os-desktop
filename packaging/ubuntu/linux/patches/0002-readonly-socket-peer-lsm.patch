+/**
+ * security_socket_getpeersec_stream_lsm() - Read a selected peer label
+ * @sock: held socket whose original peer security state is queried
+ * @optval: versioned input header and output context
+ * @optlen: input capacity and output required size, including the header
+ * @len: maximum size of the complete output buffer
+ *
+ * The regular security_socket_getsockopt() hook has already checked all
+ * active LSMs. Select only the representation supplied by one original
+ * peer hook, without modifying the socket or namespace provider.
+ */
+int security_socket_getpeersec_stream_lsm(struct socket *sock, sockptr_t optval,
+					sockptr_t optlen, unsigned int len)
+{
+	struct p4_lsm_peersec req;
+	struct lsm_static_call *scall;
+	sockptr_t context = optval;
+	u32 context_len = 0, total_len;
+	int error;
+
+	static_assert(sizeof(req) == 32);
+	error = copy_safe_from_sockptr(&req, sizeof(req), optval, len);
+	if (error)
+		return error;
+	if (req.size != sizeof(req) || req.version != P4_LSM_PEERSEC_ABI ||
+	    req.flags || req.reserved || req.context_len || req.reserved2 ||
+	    (req.lsm_id != LSM_ID_SELINUX && req.lsm_id != LSM_ID_APPARMOR))
+		return -EINVAL;
+
+	if (sockptr_is_kernel(context))
+		context.kernel += sizeof(req);
+	else
+		context.user += sizeof(req);
+
+	error = -EOPNOTSUPP;
+	lsm_for_each_hook(scall, socket_getpeersec_stream) {
+		if (req.lsm_id != scall->hl->lsmid->id)
+			continue;
+		error = scall->hl->hook.socket_getpeersec_stream(sock, context,
+				KERNEL_SOCKPTR(&context_len), len - sizeof(req));
+		break;
+	}
+	/* Reserve ENOPROTOOPT for kernels that do not implement this option. */
+	if (error == -ENOPROTOOPT)
+		return -EOPNOTSUPP;
+	if (error && error != -ERANGE)
+		return error;
+	if (!context_len || context_len > INT_MAX - sizeof(req) ||
+	    (!error && context_len > len - sizeof(req)) ||
+	    (error == -ERANGE && context_len <= len - sizeof(req)))
+		return -EPROTO;
+
+	req.context_len = context_len;
+	total_len = sizeof(req) + context_len;
+	if (copy_to_sockptr(optval, &req, sizeof(req)) ||
+	    copy_to_sockptr(optlen, &total_len, sizeof(total_len)))
+		return -EFAULT;
+	return error;
+}
