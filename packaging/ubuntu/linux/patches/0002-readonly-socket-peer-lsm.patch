+/*
+ * Pocket4 private SOL_SOCKET option. Each request selects only the label
+ * representation returned by the original peer hook for this same socket.
+ * It never changes the socket/netns provider or any LSM access decision.
+ * The high private value does not allocate a generic SO_* number.
+ */
+#define P4_SO_PEERSEC_LSM 0x50340001
+#define P4_LSM_PEERSEC_ABI 1U
+
+/*
+ * Input: size=sizeof(header), version=1, SELinux or AppArmor lsm_id, and
+ * zero flags/reserved/context_len/reserved2. optlen includes header and
+ * context capacity. Output, on success or ERANGE: context_len is the
+ * original provider's required byte length and optlen is header+context_len.
+ * The original hook determines whether the context includes a trailing NUL.
+ * No context is copied on ERANGE. Unknown options return ENOPROTOOPT;
+ * an active option without the requested peer provider returns EOPNOTSUPP.
+ */
+struct p4_lsm_peersec {
+	__u32 size;
+	__u32 version;
+	__u64 lsm_id;
+	__u32 flags;
+	__u32 reserved;
+	__u32 context_len;
+	__u32 reserved2;
+	__u8 context[];
+};
+
 #endif /* _UAPI_LINUX_P4_LSM_CONTEXT_H */
