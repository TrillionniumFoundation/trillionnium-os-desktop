+/* A new native credential filesystem needs its final root inode label before
+ * fd_reopen(O_RDONLY). The generic tmpfs directory remains unreadable to the
+ * sealed executor. These are the same ten immutable unit/path/type bindings as
+ * the normal file_contexts; no environment or caller-provided label is used. */
+static int p4_credentials_rootcontext(const char *unit, const char *cred_dir, const char **ret_context) {
+        _cleanup_freecon_ char *current = NULL;
+        _cleanup_free_ char *expected_path = NULL;
+        const char *context = NULL;
+        int r;
+
+        assert(unit);
+        assert(cred_dir);
+        assert(ret_context);
+        *ret_context = NULL;
+
+        if (!mac_selinux_use())
+                return 0;
+        r = mac_selinux_get_our_label(&current);
+        if (r < 0)
+                return r;
+        if (!streq(current, "u:system_r:p4_linux_service_executor_t:s0"))
+                return 0;
+
+        if (streq(unit, "systemd-journald.service"))
+                context = "u:object_r:p4_linux_journal_credentials_t:s0";
+        else if (STR_IN_SET(unit, "systemd-firstboot.service", "systemd-sysusers.service",
+                           "systemd-tmpfiles-clean.service", "systemd-tmpfiles-setup-dev-early.service",
+                           "systemd-tmpfiles-setup-dev.service", "systemd-tmpfiles-setup.service"))
+                context = "u:object_r:p4_linux_setup_credentials_t:s0";
+        else if (streq(unit, "systemd-udev-load-credentials.service"))
+                context = "u:object_r:p4_linux_udev_credentials_t:s0";
+        else if (streq(unit, "systemd-resolved.service"))
+                context = "u:object_r:p4_linux_resolved_credentials_t:s0";
+        else if (streq(unit, "systemd-sysctl.service"))
+                context = "u:object_r:p4_linux_sysctl_credentials_t:s0";
+        else
+                return -EOPNOTSUPP;
+
+        expected_path = path_join("/run/credentials", unit);
+        if (!expected_path)
+                return -ENOMEM;
+        if (!streq(cred_dir, expected_path))
+                return -EINVAL;
+
+        *ret_context = context;
+        return 1;
+}
+
+static int p4_credentials_verify_rootcontext(int fd, const char *context) {
+        char actual[128];
+        ssize_t n;
+        size_t expected;
+
+        assert(fd >= 0);
+        assert(context);
+        expected = strlen(context) + 1;
+        if (expected > sizeof(actual))
+                return -E2BIG;
+        n = fgetxattr(fd, "security.selinux", actual, sizeof(actual));
+        if (n < 0)
+                return -errno;
+        if ((size_t) n != expected || memcmp(actual, context, expected) != 0)
+                return -ESTALE;
+        return 0;
+}
