Description: Write fixed greeter environment with scoped filesystem credentials
 Keep the complete private GFile replacement and close under the original
 allocated dynamic user. Restore thread-local filesystem IDs and capabilities
 on every return path without DAC override or process-wide credential changes.
Author: Codex <codex@openai.com>
Forwarded: no
Last-Update: 2026-11-24

--- /dev/null
+++ gdm3-50.1/common/gdm-environment-file.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: LGPL-2.0-or-later */
+#include "config.h"
+#include "gdm-environment-file.h"
+#include "gdm-file-utils.h"
+
+#include <errno.h>
+#include <linux/capability.h>
+#include <string.h>
+#include <sys/fsuid.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static gboolean
+read_capabilities (struct __user_cap_data_struct state[2], GError **error)
+{
+        struct __user_cap_header_struct header = {
+                .version = _LINUX_CAPABILITY_VERSION_3,
+                .pid = 0,
+        };
+
+        memset (state, 0, 2 * sizeof (*state));
+        if (syscall (SYS_capget, &header, state) == 0)
+                return TRUE;
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (errno),
+                     "Cannot observe environment writer credentials: %s",
+                     g_strerror (errno));
+        return FALSE;
+}
+
+static gboolean
+write_environment (const char *home,
+                   uid_t uid,
+                   gid_t gid,
+                   GHashTable *environment,
+                   GError **error)
+{
+        g_autofree char *config_dir = g_build_filename (home, ".config", NULL);
+        g_autofree char *environment_dir = NULL;
+        g_autofree char *environment_conf = NULL;
+        g_autoptr(GFile) file = NULL;
+        g_autoptr(GFileOutputStream) file_stream = NULL;
+        g_autoptr(GDataOutputStream) data_stream = NULL;
+        GHashTableIter iter;
+        gpointer key, value;
+
+        if (!gdm_ensure_dir (config_dir, uid, gid, 0700, FALSE, error))
+                return FALSE;
+        environment_dir = g_build_filename (config_dir, "environment.d", NULL);
+        if (!gdm_ensure_dir (environment_dir, uid, gid, 0700, FALSE, error))
+                return FALSE;
+
+        environment_conf = g_build_filename (environment_dir, "gdm.conf", NULL);
+        file = g_file_new_for_path (environment_conf);
+        file_stream = g_file_replace (file, NULL, FALSE,
+                                      G_FILE_CREATE_REPLACE_DESTINATION |
+                                      G_FILE_CREATE_PRIVATE,
+                                      NULL, error);
+        if (!file_stream)
+                return FALSE;
+        data_stream = g_data_output_stream_new (G_OUTPUT_STREAM (file_stream));
+        g_filter_output_stream_set_close_base_stream (G_FILTER_OUTPUT_STREAM (data_stream), TRUE);
+        g_hash_table_iter_init (&iter, environment);
+        while (g_hash_table_iter_next (&iter, &key, &value)) {
+                g_autofree char *line = g_strdup_printf ("%s=%s\n",
+                                                         (char *) key,
+                                                         (char *) value);
+                if (!g_data_output_stream_put_string (data_stream, line, NULL, error))
+                        return FALSE;
+        }
+
+        /* GFile replacement publishes on close. It must complete while the
+         * writer still owns the dynamic user's filesystem identity. */
+        return g_output_stream_close (G_OUTPUT_STREAM (data_stream), NULL, error);
+}
+
+gboolean
+gdm_write_dynamic_environment (const char *home,
+                               uid_t uid,
+                               gid_t gid,
+                               GHashTable *environment,
+                               GError **error)
+{
+        struct __user_cap_data_struct before[2], after[2];
+        uid_t original_fsuid;
+        gid_t original_fsgid;
+        gboolean result = FALSE;
+
+        g_return_val_if_fail (error == NULL || *error == NULL, FALSE);
+        if (home == NULL || !g_path_is_absolute (home) || environment == NULL ||
+            uid < GREETER_UID_MIN || uid > GREETER_UID_MAX || uid == 0 ||
+            gid != (gid_t) 65534) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                                     "Invalid GDM dynamic environment identity");
+                return FALSE;
+        }
+
+        original_fsuid = setfsuid ((uid_t) -1);
+        original_fsgid = setfsgid ((gid_t) -1);
+        if (getuid () != 0 || geteuid () != 0 ||
+            original_fsuid != 0 || original_fsgid != 0) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                                     "GDM environment writer lacks its original root identity");
+                return FALSE;
+        }
+        if (!read_capabilities (before, error))
+                return FALSE;
+
+        /* Linux filesystem IDs are local to this calling thread. The varlink
+         * worker and other GDM threads keep their original identities.
+         * No process-wide seteuid(), arbitrary account lookup or DAC override
+         * is used. The caller supplies its own allocated greeter UID. */
+        setfsgid (gid);
+        if ((gid_t) setfsgid ((gid_t) -1) != gid) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                                     "Cannot enter the dynamic user's filesystem group");
+                goto restore;
+        }
+        setfsuid (uid);
+        if ((uid_t) setfsuid ((uid_t) -1) != uid) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED,
+                                     "Cannot enter the dynamic user's filesystem user");
+                goto restore;
+        }
+
+        result = write_environment (home, uid, gid, environment, error);
+
+restore:
+        /* Restore on every path, including an unsuccessful partial entry.
+         * Continuing with an unproven credential state is never permissible. */
+        setfsuid (original_fsuid);
+        if ((uid_t) setfsuid ((uid_t) -1) != original_fsuid)
+                g_error ("Cannot restore GDM filesystem user after environment write");
+        setfsgid (original_fsgid);
+        if ((gid_t) setfsgid ((gid_t) -1) != original_fsgid)
+                g_error ("Cannot restore GDM filesystem group after environment write");
+        if (!read_capabilities (after, NULL) ||
+            memcmp (before, after, sizeof before) != 0)
+                g_error ("GDM capability state changed across environment write");
+        return result;
+}
