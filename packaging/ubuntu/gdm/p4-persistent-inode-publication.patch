+
+typedef struct {
+        int fd;
+        int parent;
+        uid_t parent_owner;
+        char *name;
+        struct stat before;
+} Source;
+
+typedef struct {
+        uid_t owner;
+        gid_t owner_group;
+        uid_t next_owner;
+        GPtrArray *sources;
+        guint entries;
+        guint64 bytes;
+        gint64 deadline;
+        int new_root;
+        int stage;
+        int publication_parent;
+        const char *retired_name;
+} Copy;
+
+typedef struct {
+        DIR *directory;
+        GPtrArray *names;
+        gint64 deadline;
+} Names;
+
+static gboolean
+in_owner (uid_t owner, GdmDynamicFsCallback callback, gpointer data, GError **error)
+{
+        return owner == 0 ? callback (data, error) :
+               gdm_with_dynamic_fs_identity (owner, FILE_GID, callback, data, error);
+}
+
+static void
+source_free (gpointer data)
+{
+        Source *source = data;
+        close (source->fd);
+        g_free (source->name);
+        g_free (source);
+}
+
+/* Reads may update atime; none of the operations below change source ctime,
+ * mtime, ownership, mode, size, link count or its held inode identity. */
+static gboolean
+same_stat (const struct stat *a, const struct stat *b, gboolean moved_root)
+{
+        return a->st_dev == b->st_dev && a->st_ino == b->st_ino &&
+               a->st_uid == b->st_uid && a->st_gid == b->st_gid &&
+               a->st_mode == b->st_mode && a->st_nlink == b->st_nlink &&
+               a->st_size == b->st_size &&
+               a->st_mtim.tv_sec == b->st_mtim.tv_sec &&
+               a->st_mtim.tv_nsec == b->st_mtim.tv_nsec &&
+               (moved_root || (a->st_ctim.tv_sec == b->st_ctim.tv_sec &&
+                               a->st_ctim.tv_nsec == b->st_ctim.tv_nsec));
+}
+
+static gboolean
+read_names (gpointer data, GError **error)
+{
+        Names *call = data;
+        struct dirent *entry;
+        while (TRUE) {
+                errno = 0;
+                entry = readdir (call->directory);
+                if (!entry) {
+                        if (errno) return fail_errno (error, "read source directory");
+                        return TRUE;
+                }
+                if (!strcmp (entry->d_name, ".") || !strcmp (entry->d_name, "..")) continue;
+                if (!require (safe_name (entry->d_name) && call->names->len < MAX_ENTRIES &&
+                              g_get_monotonic_time () < call->deadline,
+                              error, "GDM source directory exceeds its read bound")) return FALSE;
+                g_ptr_array_add (call->names, g_strdup (entry->d_name));
+        }
+}
+
+static GPtrArray *
+directory_names (int fd, uid_t owner, gint64 deadline, GError **error)
+{
+        int readable = open_child (fd, ".", owner, O_RDONLY | O_DIRECTORY, error);
+        Names call = { .names = g_ptr_array_new_with_free_func (g_free), .deadline = deadline };
+        gboolean ok = FALSE;
+        if (readable >= 0) {
+                call.directory = fdopendir (readable);
+                if (!call.directory) { fail_errno (error, "open source stream"); close (readable); }
+                else { ok = in_owner (owner, read_names, &call, error); closedir (call.directory); }
+        }
+        if (!ok) { g_ptr_array_unref (call.names); return NULL; }
+        return call.names;
+}
+
+typedef struct {
+        int source;
+        int target;
+        off_t size;
+        gint64 deadline;
+        char digest[65];
+} Body;
+
+static gboolean
+copy_body (gpointer data, GError **error)
+{
+        Body *call = data;
+        g_autoptr(GChecksum) digest = g_checksum_new (G_CHECKSUM_SHA256);
+        unsigned char buffer[65536];
+        off_t offset = 0;
+        while (offset < call->size) {
+                ssize_t n;
+                if (!require (g_get_monotonic_time () < call->deadline, error,
+                              "GDM source copy deadline expired")) return FALSE;
+                do { n = pread (call->source, buffer, MIN ((off_t) sizeof buffer, call->size - offset), offset); }
+                while (n < 0 && errno == EINTR);
+                if (n < 0) return fail_errno (error, "read held source bytes");
+                if (!require (n > 0, error, "GDM held source was truncated")) return FALSE;
+                g_checksum_update (digest, buffer, n);
+                ssize_t done = 0;
+                while (done < n) {
+                        ssize_t w = pwrite (call->target, buffer + done, n - done, offset + done);
+                        if (w < 0 && errno == EINTR) continue;
+                        if (w < 0) return fail_errno (error, "write new private inode");
+                        if (!require (w > 0, error, "GDM private copy made no progress")) return FALSE;
+                        done += w;
+                }
+                offset += n;
+        }
+        ssize_t end;
+        do { end = pread (call->source, buffer, 1, offset); } while (end < 0 && errno == EINTR);
+        if (end < 0) return fail_errno (error, "read held source end");
+        if (!require (end == 0, error, "GDM held source grew during copy")) return FALSE;
+        g_strlcpy (call->digest, g_checksum_get_string (digest), sizeof call->digest);
+        return TRUE;
+}
+
+static gboolean
+verify_body (Body *body, GError **error)
+{
+        g_autoptr(GChecksum) digest = g_checksum_new (G_CHECKSUM_SHA256);
+        unsigned char buffer[65536];
+        off_t offset = 0;
+        while (offset < body->size) {
+                ssize_t n;
+                if (!require (g_get_monotonic_time () < body->deadline, error,
+                              "GDM private readback deadline expired")) return FALSE;
+                do { n = pread (body->target, buffer, MIN ((off_t) sizeof buffer, body->size - offset), offset); }
+                while (n < 0 && errno == EINTR);
+                if (n < 0) return fail_errno (error, "read new private inode");
+                if (!require (n > 0, error, "GDM private copy readback is truncated")) return FALSE;
+                g_checksum_update (digest, buffer, n);
+                offset += n;
+        }
+        struct stat st;
+        if (fstat (body->target, &st) < 0) return fail_errno (error, "stat private readback");
+        return require (st.st_size == body->size &&
+                        !strcmp (body->digest, g_checksum_get_string (digest)),
+                        error, "GDM new inode does not contain the complete source bytes");
+}
+
+typedef struct { int fd; char target[4097]; ssize_t length; } Link;
+static gboolean
+read_link (gpointer data, GError **error)
+{
+        Link *link = data;
+        link->length = readlinkat (link->fd, "", link->target, sizeof link->target - 1);
+        if (link->length < 0) return fail_errno (error, "read held symbolic link");
+        if (!require (link->length > 0 && link->length < (ssize_t) sizeof link->target - 1,
+                      error, "GDM symbolic link target exceeds its bound")) return FALSE;
+        link->target[link->length] = 0;
+        return TRUE;
+}
+
+static gboolean
+copy_node (int parent, const char *name, uid_t parent_owner,
+           int destination, const char *new_name, Copy *copy, guint depth,
+           GError **error)
+{
+        int path = -1, fresh = -1;
+        Source *source = NULL;
+        struct stat before, now;
+        gboolean ok = FALSE;
+        if (!require (depth <= MAX_DEPTH && copy->entries++ < MAX_ENTRIES &&
+                      g_get_monotonic_time () < copy->deadline,
+                      error, "GDM private copy traversal limit exceeded")) return FALSE;
+        path = open_child (parent, name, parent_owner, O_PATH, error);
+        if (path < 0) return FALSE;
+        if (fstat (path, &before) < 0) { fail_errno (error, "stat held source"); goto out; }
+        if (!require (before.st_uid == copy->owner && before.st_gid == copy->owner_group &&
+                      !(before.st_mode & (S_ISUID | S_ISGID)) &&
+                      (S_ISDIR (before.st_mode) || S_ISREG (before.st_mode) || S_ISLNK (before.st_mode)) &&
+                      (S_ISDIR (before.st_mode) || before.st_nlink == 1),
+                      error, "GDM source owner, kind, privilege bits or link count differs")) goto out;
+        source = g_new0 (Source, 1);
+        source->fd = path; path = -1;
+        source->parent = parent; source->parent_owner = parent_owner;
+        source->name = g_strdup (name); source->before = before;
+        g_ptr_array_add (copy->sources, source);
+
+        if (S_ISDIR (before.st_mode)) {
+                g_autoptr(GPtrArray) names = directory_names (source->fd, copy->owner, copy->deadline, error);
+                if (!names) goto out;
+                if (depth == 0) {
+                        fresh = fcntl (copy->stage, F_DUPFD_CLOEXEC, 3);
+                        if (fresh < 0) fail_errno (error, "retain new private root");
+                } else {
+                        if (mkdirat (destination, new_name, 0700) < 0) { fail_errno (error, "create new private directory"); goto out; }
+                        fresh = open_child (destination, new_name, 0, O_RDONLY | O_DIRECTORY, error);
+                }
+                if (fresh < 0) goto out;
+                for (guint i = 0; i < names->len; i++) {
+                        const char *child = g_ptr_array_index (names, i);
+                        if (!copy_node (source->fd, child, copy->owner, fresh, child, copy, depth + 1, error)) goto out;
+                }
+                if (fsync (fresh) < 0) { fail_errno (error, "sync new private directory"); goto out; }
+        } else if (S_ISREG (before.st_mode)) {
+                Body body = { .size = before.st_size, .deadline = copy->deadline };
+                if (!require (before.st_size >= 0 && before.st_size <= MAX_FILE_BYTES &&
+                              copy->bytes + before.st_size <= MAX_COPY_BYTES,
+                              error, "GDM retained settings exceed their byte bound")) goto out;
+                copy->bytes += before.st_size;
+                int readable = open_child (parent, name, copy->owner, O_RDONLY | O_NONBLOCK, error);
+                if (readable < 0) goto out;
+                gboolean same = fstat (readable, &now) == 0 && same_stat (&before, &now, FALSE);
+                if (!same) { close (readable); require (FALSE, error, "GDM source changed while acquiring read access"); goto out; }
+                close (source->fd); source->fd = readable;
+                fresh = openat (destination, new_name, O_CREAT | O_EXCL | O_RDWR | O_CLOEXEC | O_NOFOLLOW, 0600);
+                if (fresh < 0) { fail_errno (error, "create new private file"); goto out; }
+                body.source = source->fd; body.target = fresh;
+                if (!in_owner (copy->owner, copy_body, &body, error) || !verify_body (&body, error)) goto out;
+                if (fsync (fresh) < 0) { fail_errno (error, "sync new private file"); goto out; }
+        } else {
+                Link link = { .fd = source->fd };
+                if (!in_owner (copy->owner, read_link, &link, error)) goto out;
+                if (symlinkat (link.target, destination, new_name) < 0) { fail_errno (error, "copy symbolic link without following"); goto out; }
+                fresh = open_child (destination, new_name, 0, O_PATH, error);
+                if (fresh < 0) goto out;
+        }
+        if (fstat (source->fd, &now) < 0) { fail_errno (error, "restat held source"); goto out; }
+        if (!require (same_stat (&before, &now, FALSE), error, "GDM source changed during its copy")) goto out;
+        /* Only these new, unreachable inodes are changed. Their sole parent
+         * chain is under the held root:root 0700 handoff directory. */
+        if (!S_ISLNK (before.st_mode) &&
+            !chmod_held (fresh, depth == 0 ? 0700 : (before.st_mode & 0777), error)) goto out;
+        /* The top new directory stays root:root 0700 until after the atomic
+         * same-parent exchange. This closes access while children are owned
+         * by the next UID, without needing DAC override for a .. update. */
+        if (depth != 0 && !chown_held (fresh, copy->next_owner, FILE_GID, error)) goto out;
+        if (depth == 0) {
+                copy->new_root = fcntl (fresh, F_DUPFD_CLOEXEC, 3);
+                if (copy->new_root < 0) { fail_errno (error, "retain new private root"); goto out; }
+        }
+        ok = TRUE;
+out:
+        if (path >= 0) close (path);
+        if (fresh >= 0) close (fresh);
+        return ok;
+}
+
+static gboolean
+sources_unchanged (Copy *copy, gboolean exchanged, GError **error)
+{
+        for (guint i = 0; i < copy->sources->len; i++) {
+                Source *source = g_ptr_array_index (copy->sources, i);
+                struct stat now;
+                if (!require (g_get_monotonic_time () < copy->deadline, error,
+                              "GDM source validation deadline expired")) return FALSE;
+                if (fstat (source->fd, &now) < 0) return fail_errno (error, "revalidate held source");
+                if (!require (same_stat (&source->before, &now, exchanged && i == 0),
+                              error, "GDM source changed before publication completed")) return FALSE;
+                if (!same_entry (exchanged && i == 0 ? copy->publication_parent : source->parent,
+                                 exchanged && i == 0 ? copy->retired_name : source->name,
+                                 source->fd, source->parent_owner, error)) return FALSE;
+        }
+        return TRUE;
+}
+
+/* This cleanup is used only for newly created inodes that have never been
+ * published or lent to an untrusted process. It is never used on old data. */
+static gboolean
+discard_unpublished (int fd, Copy *copy, guint depth, GError **error)
+{
+        struct stat st;
+        if (!require (depth <= MAX_DEPTH && copy->entries++ < 2 * MAX_ENTRIES &&
+                      g_get_monotonic_time () < copy->deadline,
+                      error, "GDM unpublished cleanup bound exceeded")) return FALSE;
+        if (fstat (fd, &st) < 0) return fail_errno (error, "stat unpublished copy");
+        if (!require (S_ISDIR (st.st_mode) && (st.st_uid == 0 || st.st_uid == copy->next_owner),
+                      error, "GDM unpublished copy lost its private owner")) return FALSE;
+        if (!chmod_held (fd, 0700, error)) return FALSE;
+        g_autoptr(GPtrArray) names = directory_names (fd, st.st_uid, copy->deadline, error);
+        if (!names) return FALSE;
+        for (guint i = 0; i < names->len; i++) {
+                const char *name = g_ptr_array_index (names, i);
+                int child = open_child (fd, name, st.st_uid, O_PATH, error);
+                struct stat item;
+                if (child < 0) return FALSE;
+                gboolean ok = fstat (child, &item) == 0;
+                if (!ok) fail_errno (error, "stat unpublished child");
+                if (ok) ok = require ((item.st_uid == 0 || item.st_uid == copy->next_owner) &&
+                                     (S_ISDIR (item.st_mode) || S_ISREG (item.st_mode) || S_ISLNK (item.st_mode)),
+                                     error, "GDM unpublished child lost its private identity");
+                if (ok && S_ISDIR (item.st_mode)) ok = discard_unpublished (child, copy, depth + 1, error);
+                if (ok) ok = same_entry (fd, name, child, st.st_uid, error);
+                if (ok) {
+                        Relative call = { .parent = fd, .name = name, .remove = TRUE,
+                                          .directory = S_ISDIR (item.st_mode) };
+                        ok = as_owner (st.st_uid, &call, error);
+                }
+                close (child);
+                if (!ok) return FALSE;
+        }
+        return TRUE;
+}
+
+static gboolean
+copy_publish_tree_at (int parent, const char *name, uid_t uid, gid_t gid, GError **error)
+{
+        g_autofree char *stage_name = NULL;
+        struct stat parent_stat, old_stat, stage_stat;
+        int old = -1, stage = -1;
+        gboolean result = FALSE, published = FALSE, stage_created = FALSE;
+        Copy copy = { .next_owner = uid, .deadline = g_get_monotonic_time () + MAX_USECS,
+                      .new_root = -1, .stage = -1 };
+        copy.sources = g_ptr_array_new_with_free_func (source_free);
+        if (!root_identity (error) ||
+            !require (name && (!strcmp (name, "config") || !strcmp (name, "state")) &&
+                      uid >= GREETER_UID_MIN && uid <= GREETER_UID_MAX && gid == FILE_GID,
+                      error, "Invalid fixed GDM persistent publication")) goto out;
+        if (fstat (parent, &parent_stat) < 0) { fail_errno (error, "stat publication parent"); goto out; }
+        if (!require (S_ISDIR (parent_stat.st_mode) && parent_stat.st_uid == 0 && parent_stat.st_gid == 0 &&
+                      !(parent_stat.st_mode & (0022 | S_ISUID | S_ISGID)),
+                      error, "GDM publication parent is not fixed root-controlled storage")) goto out;
+        old = open_child (parent, name, 0, O_PATH | O_DIRECTORY, error);
+        if (old < 0) goto out;
+        if (fstat (old, &old_stat) < 0) { fail_errno (error, "stat original persistent root"); goto out; }
+        if (!require (gdm_dynamic_data_owner (old_stat.st_uid) &&
+                      (old_stat.st_gid == FILE_GID || old_stat.st_uid == 0 ||
+                       old_stat.st_uid < GREETER_UID_MIN || old_stat.st_uid > GREETER_UID_MAX),
+                      error, "GDM persistent source has an unexpected owner or group")) goto out;
+        copy.owner = old_stat.st_uid; copy.owner_group = old_stat.st_gid;
+        stage_name = g_strdup_printf (".%s-handoff", name);
+        /* Exclusive creation is also the per-fixed-directory publication lock.
+         * A retained failed handoff is an error, never treated as stale data. */
+        if (mkdirat (parent, stage_name, 0700) < 0) { fail_errno (error, "create exclusive handoff"); goto out; }
+        stage_created = TRUE;
+        stage = open_child (parent, stage_name, 0, O_RDONLY | O_DIRECTORY, error);
+        if (stage < 0) goto out;
+        if (fstat (stage, &stage_stat) < 0) { fail_errno (error, "stat private handoff"); goto out; }
+        if (!require (stage_stat.st_uid == 0 && stage_stat.st_gid == 0 &&
+                      (stage_stat.st_mode & 07777) == 0700 && stage_stat.st_nlink == 2,
+                      error, "GDM handoff is not a fresh root:root 0700 directory")) goto out;
+        copy.stage = stage;
+        copy.publication_parent = parent;
+        copy.retired_name = stage_name;
+        if (!same_entry (parent, name, old, 0, error) ||
+            !copy_node (parent, name, 0, parent, stage_name, &copy, 0, error) ||
+            !same_entry (parent, name, old, 0, error) ||
+            !sources_unchanged (&copy, FALSE, error) ||
+            !same_entry (parent, stage_name, stage, 0, error)) goto out;
+        if (fsync (stage) < 0) { fail_errno (error, "sync handoff before publication"); goto out; }
+        if (renameat2 (parent, stage_name, parent, name, RENAME_EXCHANGE) < 0) {
+                fail_errno (error, "exchange fixed persistent roots"); goto out;
+        }
+        published = TRUE;
+        if (!same_entry (parent, name, copy.new_root, 0, error) ||
+            !same_entry (parent, stage_name, old, 0, error) ||
+            !sources_unchanged (&copy, TRUE, error)) {
+                /* Revert only the exact two roots we actually exchanged. The
+                 * new root remains root:root 0700 throughout this window.
+                 * Preserve it unchanged on failure, without deleting either
+                 * root merely because a path operation reported failure. */
+                if (same_entry (parent, name, copy.new_root, 0, NULL) &&
+                    same_entry (parent, stage_name, old, 0, NULL) &&
+                    renameat2 (parent, stage_name, parent, name, RENAME_EXCHANGE) == 0) {
+                        if (!same_entry (parent, name, old, 0, NULL) ||
+                            !same_entry (parent, stage_name, copy.new_root, 0, NULL))
+                                g_warning ("GDM failed publication rollback identity could not be proven");
+                } else g_warning ("GDM failed publication roots retained without an unproven rollback");
+                goto out;
+        }
+        /* Only the new root is handed to the next UID. Its fixed parent is
+         * root-controlled, directory hard links are impossible, and its
+         * contents were never reachable by the old owner while prepared. */
+        if (fstat (copy.new_root, &stage_stat) < 0) { fail_errno (error, "stat new published root"); goto out; }
+        if (!require (stage_stat.st_uid == 0 && stage_stat.st_gid == 0 &&
+                      (stage_stat.st_mode & 07777) == 0700,
+                      error, "New GDM root lost its private preparation identity") ||
+            !chown_held (copy.new_root, uid, FILE_GID, error) ||
+            !same_entry (parent, name, copy.new_root, 0, error)) goto out;
