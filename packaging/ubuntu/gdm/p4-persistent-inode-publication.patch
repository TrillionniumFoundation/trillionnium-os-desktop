+static gboolean
+sync_parent (int path, GError **error)
+{
+        int fd = open_child (path, ".", 0, O_RDONLY | O_DIRECTORY, error);
+        struct stat a, b;
+        if (fd < 0) return FALSE;
+        gboolean ok = fstat (path, &a) == 0 && fstat (fd, &b) == 0 &&
+                      a.st_dev == b.st_dev && a.st_ino == b.st_ino;
+        if (!ok) require (FALSE, error, "GDM sync parent differs from its held directory");
+        else if (fsync (fd) < 0) { fail_errno (error, "sync held publication parent"); ok = FALSE; }
+        close (fd);
+        return ok;
+}
