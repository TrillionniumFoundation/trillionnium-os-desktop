 Reuse the scoped filesystem identity for bounded no-follow directory walks,
 preserve ordinary file bytes, and retain failed-retirement UID/name custody.
Author: ChatGPT <chatgpt@openai.com>
Forwarded: not-needed

diff --git a/common/gdm-dynamic-files.c b/common/gdm-dynamic-files.c
new file mode 100644
index 0000000..ce3ab3f
--- /dev/null
+++ b/common/gdm-dynamic-files.c
@@ -0,0 +1,413 @@
+/* SPDX-License-Identifier: LGPL-2.0-or-later */
+#include "config.h"
+#include "gdm-dynamic-files.h"
+#include "gdm-environment-file.h"
+
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <linux/openat2.h>
+#include <string.h>
+#include <sys/fsuid.h>
+#include <sys/stat.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+#define FILE_GID ((gid_t) 65534)
+#define MAX_ENTRIES 32768
+#define MAX_DEPTH 64
+#define MAX_USECS (30 * G_USEC_PER_SEC)
+
+typedef struct {
+        uid_t uid;
+        gid_t gid;
+        gboolean remove;
+        guint entries;
+        gint64 deadline;
+} Walk;
+
+typedef struct {
+        int parent;
+        const char *name;
+        int flags;
+        int fd;
+        gboolean remove;
+        gboolean directory;
+} Relative;
+
+static gboolean
+fail_errno (GError **error, const char *operation)
+{
+        int saved = errno;
+        g_set_error (error, G_IO_ERROR, g_io_error_from_errno (saved),
+                     "GDM private directory %s: %s", operation, g_strerror (saved));
+        return FALSE;
+}
+
+static gboolean
+require (gboolean condition, GError **error, const char *message)
+{
+        if (!condition)
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_PERMISSION_DENIED, message);
+        return condition;
+}
+
+static gboolean
+root_identity (GError **error)
+{
+        return require (getuid () == 0 && geteuid () == 0 &&
+                        (uid_t) setfsuid ((uid_t) -1) == 0 &&
+                        (gid_t) setfsgid ((gid_t) -1) == 0,
+                        error, "GDM private directory requires its original root filesystem identity");
+}
+
+static gboolean
+safe_name (const char *name)
+{
+        return name && *name && strcmp (name, ".") != 0 && strcmp (name, "..") != 0 &&
+               strchr (name, '/') == NULL && strlen (name) <= 255;
+}
+
+static gboolean
+relative_operation (gpointer data, GError **error)
+{
+        Relative *call = data;
+        if (call->remove) {
+                if (unlinkat (call->parent, call->name,
+                              call->directory ? AT_REMOVEDIR : 0) < 0)
+                        return fail_errno (error, "unlink");
+        } else {
+                struct open_how how = {
+                        .flags = call->flags | O_CLOEXEC | O_NOFOLLOW,
+                        .resolve = RESOLVE_BENEATH | RESOLVE_NO_MAGICLINKS |
+                                   RESOLVE_NO_SYMLINKS | RESOLVE_NO_XDEV,
+                };
+                call->fd = syscall (SYS_openat2, call->parent, call->name, &how, sizeof how);
+                if (call->fd < 0)
+                        return fail_errno (error, "open held child");
+        }
+        return TRUE;
+}
+
+static gboolean
+as_owner (uid_t owner, Relative *call, GError **error)
+{
+        if (owner == 0)
+                return relative_operation (call, error);
+        return gdm_with_dynamic_fs_identity (owner, FILE_GID,
+                                             relative_operation, call, error);
+}
+
+static int
+open_child (int parent, const char *name, uid_t owner, int flags, GError **error)
+{
+        Relative call = { .parent = parent, .name = name, .flags = flags, .fd = -1 };
+        return as_owner (owner, &call, error) ? call.fd : -1;
+}
+
+static gboolean
+chmod_held (int fd, mode_t mode, GError **error)
+{
+        if (syscall (SYS_fchmodat2, fd, "", mode, AT_EMPTY_PATH) < 0)
+                return fail_errno (error, "chmod held directory");
+        return TRUE;
+}
+
+static gboolean
+chown_held (int fd, uid_t uid, gid_t gid, GError **error)
+{
+        if (fchownat (fd, "", uid, gid, AT_EMPTY_PATH | AT_SYMLINK_NOFOLLOW) < 0)
+                return fail_errno (error, "chown held object");
+        return TRUE;
+}
+
+static gboolean
+same_entry (int parent, const char *name, int fd, uid_t owner, GError **error)
+{
+        struct stat held, visible;
+        int other = open_child (parent, name, owner, O_PATH, error);
+        gboolean same;
+        if (other < 0)
+                return FALSE;
+        same = fstat (fd, &held) == 0 && fstat (other, &visible) == 0 &&
+               held.st_dev == visible.st_dev && held.st_ino == visible.st_ino &&
+               (held.st_mode & S_IFMT) == (visible.st_mode & S_IFMT);
+        close (other);
+        return require (same, error, "GDM private directory entry changed during operation");
+}
+
+static gboolean
+walk_directory (int fd, Walk *walk, guint depth, GError **error)
+{
+        struct stat original;
+        DIR *directory = NULL;
+        struct dirent *entry;
+        gboolean result = FALSE;
+        int readable = -1;
+        mode_t mode;
+
+        if (!require (depth <= MAX_DEPTH && walk->entries++ < MAX_ENTRIES &&
+                      g_get_monotonic_time () < walk->deadline,
+                      error, "GDM private directory traversal limit exceeded"))
+                return FALSE;
+        if (fstat (fd, &original) < 0)
+                return fail_errno (error, "stat held directory");
+        if (!require (S_ISDIR (original.st_mode) && gdm_dynamic_data_owner (original.st_uid) &&
+                      (!walk->remove || original.st_uid == walk->uid),
+                      error, "GDM private directory has an unexpected owner or kind"))
+                return FALSE;
+        mode = original.st_mode & 07777;
+        /* FOWNER changes only this held, no-follow inode. Never add group or
+         * other access; a mode-000 directory is traversed as its actual owner. */
+        if (!chmod_held (fd, mode | 0700, error))
+                return FALSE;
+        readable = open_child (fd, ".", original.st_uid, O_RDONLY | O_DIRECTORY, error);
+        if (readable < 0)
+                goto out;
+        directory = fdopendir (readable);
+        if (!directory) {
+                fail_errno (error, "enumerate held directory");
+                close (readable);
+                goto out;
+        }
+        while (TRUE) {
+                struct stat child;
+                int child_fd;
+                gboolean child_ok;
+                Relative remove;
+                errno = 0;
+                entry = readdir (directory);
+                if (!entry) {
+                        if (errno) {
+                                fail_errno (error, "read held directory");
+                                goto out;
+                        }
+                        break;
+                }
+                if (strcmp (entry->d_name, ".") == 0 || strcmp (entry->d_name, "..") == 0)
+                        continue;
+                if (!require (safe_name (entry->d_name) && walk->entries++ < MAX_ENTRIES &&
+                              g_get_monotonic_time () < walk->deadline,
+                              error, "GDM private directory entry limit exceeded"))
+                        goto out;
+                child_fd = open_child (fd, entry->d_name, original.st_uid, O_PATH, error);
+                if (child_fd < 0)
+                        goto out;
+                child_ok = fstat (child_fd, &child) == 0;
+                if (!child_ok)
+                        fail_errno (error, "stat held child");
+                if (child_ok)
+                        child_ok = require (gdm_dynamic_data_owner (child.st_uid) &&
+                                   (!walk->remove || child.st_uid == walk->uid) &&
+                                   !(child.st_mode & (S_ISUID | S_ISGID)) &&
+                                   (S_ISDIR (child.st_mode) || S_ISREG (child.st_mode) ||
+                                    S_ISLNK (child.st_mode) || (walk->remove &&
+                                    (S_ISFIFO (child.st_mode) || S_ISSOCK (child.st_mode)))),
+                                   error, "GDM private child has an unexpected owner, kind or privilege bits");
+                if (child_ok && S_ISDIR (child.st_mode))
+                        child_ok = walk_directory (child_fd, walk, depth + 1, error);
+                else if (child_ok && !walk->remove) {
+                        child_ok = require (child.st_nlink == 1, error,
+                                            "GDM private data ownership transfer rejects hard links");
+                        if (child_ok)
+                                child_ok = chown_held (child_fd, walk->uid, walk->gid, error);
+                }
+                if (child_ok)
+                        child_ok = same_entry (fd, entry->d_name, child_fd, original.st_uid, error);
+                if (child_ok && walk->remove) {
+                        remove = (Relative) { .parent = fd, .name = entry->d_name,
+                                              .remove = TRUE, .directory = S_ISDIR (child.st_mode) };
+                        child_ok = as_owner (original.st_uid, &remove, error);
+                }
+                close (child_fd);
+                if (!child_ok)
+                        goto out;
+        }
+        if (!walk->remove && !chown_held (fd, walk->uid, walk->gid, error))
+                goto out;
+        result = TRUE;
+out:
+        if (directory)
+                closedir (directory);
+        /* Restore the exact directory mode even after a partial traversal.
+         * Metadata transfer remains incremental, as stock recursive chown is;
+         * an error never claims completion or releases a dynamic UID. */
+        if (!chmod_held (fd, mode, NULL))
+                g_error ("Cannot restore private GDM directory mode");
+        return result;
+}
+
+gboolean
+gdm_dynamic_tree_at (int parent_fd, const char *name, uid_t uid, gid_t gid,
+                     gboolean remove, GError **error)
+{
+        struct stat parent, before;
+        int fd = -1;
+        gboolean result = FALSE;
+        Walk walk = { uid, gid, remove, 0, g_get_monotonic_time () + MAX_USECS };
+        if (!root_identity (error) || !require (safe_name (name) &&
+            uid >= GREETER_UID_MIN && uid <= GREETER_UID_MAX && gid == FILE_GID,
+            error, "Invalid GDM dynamic directory identity"))
+                return FALSE;
+        if (fstat (parent_fd, &parent) < 0)
+                return fail_errno (error, "stat fixed parent");
+        if (!require (S_ISDIR (parent.st_mode) && parent.st_uid == 0 &&
+                      (parent.st_mode & 0022) == 0,
+                      error, "GDM dynamic directory parent is not root-controlled"))
+                return FALSE;
+        fd = open_child (parent_fd, name, 0, O_PATH | O_DIRECTORY, error);
+        if (fd < 0)
+                return FALSE;
+        if (fstat (fd, &before) < 0) {
+                fail_errno (error, "stat dynamic root");
+                goto out;
+        }
+        if (!require (before.st_gid == FILE_GID || (!remove &&
+                      (before.st_uid == 0 || (gdm_dynamic_data_owner (before.st_uid) &&
+                       (before.st_uid < GREETER_UID_MIN || before.st_uid > GREETER_UID_MAX)))),
+                      error, "GDM dynamic root has an unexpected filesystem group"))
+                goto out;
+        if (!walk_directory (fd, &walk, 0, error) ||
+            !same_entry (parent_fd, name, fd, 0, error))
+                goto out;
+        if (remove) {
+                /* The home parent belongs to root, not the retiring user. */
+                Relative unlink_root = { .parent = parent_fd, .name = name,
+                                         .remove = TRUE, .directory = TRUE };
+                result = relative_operation (&unlink_root, error);
+        } else {
+                result = chmod_held (fd, 0700, error);
+        }
+out:
+        close (fd);
+        if (!root_identity (NULL))
+                g_error ("GDM private directory lost its original filesystem identity");
+        return result;
+}
+
+/* Fixed parent walk: no symlink components, no path argument from a client.
+ * The selected /run may be a different mount, so NO_XDEV starts only below
+ * the resulting private root and remains enforced for every child. */
+static int
+fixed_parent (const char *path, GError **error)
+{
+        g_auto(GStrv) parts = g_strsplit (path, "/", -1);
+        int current = open ("/", O_PATH | O_DIRECTORY | O_CLOEXEC);
+        if (current < 0) { fail_errno (error, "open root"); return -1; }
+        for (guint i = 0; parts[i]; i++) {
+                int next;
+                struct stat value;
+                if (!*parts[i]) continue;
+                if (!safe_name (parts[i])) { close (current); require (FALSE, error, "Invalid fixed GDM component"); return -1; }
+                next = openat (current, parts[i], O_PATH | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+                close (current);
+                if (next < 0) { fail_errno (error, "open fixed parent"); return -1; }
+                if (fstat (next, &value) < 0 || !S_ISDIR (value.st_mode) || value.st_uid != 0 || (value.st_mode & 0022)) {
+                        close (next); require (FALSE, error, "GDM fixed parent is not an ordinary root-controlled directory"); return -1;
+                }
+                current = next;
+        }
+        return current;
+}
+
+static gboolean
+home_parts (const char *home, const char **name, GError **error)
+{
+        size_t prefix = strlen (GDM_DYN_HOME_DIR);
+        return require (home && g_str_has_prefix (home, GDM_DYN_HOME_DIR "/") &&
+                        safe_name (home + prefix + 1) && (*name = home + prefix + 1),
+                        error, "Dynamic GDM home is outside its fixed parent");
+}
+
+gboolean
+gdm_create_dynamic_home_at (int parent, const char *name, uid_t uid, gid_t gid, GError **error)
+{
+        struct stat st;
+        int fd = -1;
+        gboolean result;
+        if (!root_identity (error) || !require (safe_name (name) &&
+            uid >= GREETER_UID_MIN && uid <= GREETER_UID_MAX && gid == FILE_GID,
+            error, "Invalid new GDM home identity")) return FALSE;
+        if (fstat (parent, &st) < 0) return fail_errno (error, "stat home parent");
+        if (!require (S_ISDIR (st.st_mode) && st.st_uid == 0 && !(st.st_mode & 0022),
+                      error, "GDM home parent is not root-controlled")) return FALSE;
+        if (mkdirat (parent, name, 0700) < 0) return fail_errno (error, "create exclusive dynamic home");
+        fd = open_child (parent, name, 0, O_PATH | O_DIRECTORY, error);
+        result = fd >= 0 && chown_held (fd, uid, gid, error) && chmod_held (fd, 0700, error);
+        if (fd >= 0) close (fd);
+        if (!result && unlinkat (parent, name, AT_REMOVEDIR) < 0)
+                g_warning ("Failed to remove newly-created empty GDM home after setup failure");
+        return result;
+}
+
+gboolean
+gdm_create_dynamic_home (const char *home, uid_t uid, gid_t gid, GError **error)
+{
+        const char *name = NULL;
+        int parent = -1;
+        gboolean result;
+        if (!root_identity (error) || !home_parts (home, &name, error) ||
+            !require (uid >= GREETER_UID_MIN && uid <= GREETER_UID_MAX && gid == FILE_GID,
+                      error, "Invalid new GDM home identity")) return FALSE;
+        {
+                g_autofree char *ancestor = g_path_get_dirname (GDM_DYN_HOME_DIR);
+                g_autofree char *leaf = g_path_get_basename (GDM_DYN_HOME_DIR);
+                int base = fixed_parent (ancestor, error);
+                if (base < 0) return FALSE;
+                if (mkdirat (base, leaf, 0755) < 0 && errno != EEXIST) {
+                        fail_errno (error, "create fixed home parent"); close (base); return FALSE;
+                }
+                close (base);
+        }
+        parent = fixed_parent (GDM_DYN_HOME_DIR, error);
+        if (parent < 0) return FALSE;
+        result = gdm_create_dynamic_home_at (parent, name, uid, gid, error);
+        close (parent);
+        return result;
+}
+
+gboolean
+gdm_remove_dynamic_home (const char *home, uid_t uid, gid_t gid, GError **error)
+{
+        const char *name = NULL;
+        int parent;
+        gboolean result;
+        if (!root_identity (error) || !home_parts (home, &name, error)) return FALSE;
+        parent = fixed_parent (GDM_DYN_HOME_DIR, error);
+        if (parent < 0) return FALSE;
+        result = gdm_dynamic_tree_at (parent, name, uid, gid, TRUE, error);
+        close (parent);
+        return result;
+}
+
+gboolean
+gdm_prepare_dynamic_persist (const char *path, uid_t uid, gid_t gid, GError **error)
+{
+        g_autofree char *parent_path = g_path_get_dirname (path);
+        g_autofree char *name = g_path_get_basename (path);
+        const char *seat;
+        int base;
+        int parent;
+        gboolean result;
+        if (!root_identity (error) ||
+            !require (g_str_has_prefix (parent_path, GDM_WORKING_DIR "/"),
+                      error, "Persistent GDM data is outside the fixed GDM state root")) return FALSE;
+        seat = parent_path + strlen (GDM_WORKING_DIR) + 1;
+        if (!require (safe_name (seat) &&
+                      (strcmp (name, "config") == 0 || strcmp (name, "state") == 0),
+                      error, "Persistent GDM data is outside a fixed seat directory")) return FALSE;
+        base = fixed_parent (GDM_WORKING_DIR, error);
+        if (base < 0) return FALSE;
+        if (mkdirat (base, seat, 0755) < 0 && errno != EEXIST) {
+                fail_errno (error, "create fixed seat parent"); close (base); return FALSE;
+        }
+        close (base);
+        parent = fixed_parent (parent_path, error);
+        if (parent < 0) return FALSE;
+        if (mkdirat (parent, name, 0700) < 0 && errno != EEXIST) {
+                fail_errno (error, "create private seat data"); close (parent); return FALSE;
+        }
+        result = gdm_dynamic_tree_at (parent, name, uid, gid, FALSE, error);
+        close (parent);
+        return result;
+}
