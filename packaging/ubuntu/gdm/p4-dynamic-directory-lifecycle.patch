+typedef struct {
+        const char *home;
+        uid_t uid;
+        gid_t gid;
+        GHashTable *environment;
+} EnvironmentWrite;
+
+static gboolean
+write_environment_scoped (gpointer data, GError **error)
+{
+        EnvironmentWrite *write = data;
+        return write_environment (write->home, write->uid, write->gid,
+                                  write->environment, error);
+}
+
+gboolean
+gdm_write_dynamic_environment (const char *home,
+                               uid_t uid,
+                               gid_t gid,
+                               GHashTable *environment,
+                               GError **error)
+{
+        EnvironmentWrite write = { home, uid, gid, environment };
+        if (home == NULL || !g_path_is_absolute (home) || environment == NULL ||
+            uid < GREETER_UID_MIN || uid > GREETER_UID_MAX || gid != (gid_t) 65534) {
+                g_set_error_literal (error, G_IO_ERROR, G_IO_ERROR_INVALID_ARGUMENT,
+                                     "Invalid GDM dynamic environment identity");
+                return FALSE;
+        }
+        return gdm_with_dynamic_fs_identity (uid, gid, write_environment_scoped,
+                                             &write, error);
+}
