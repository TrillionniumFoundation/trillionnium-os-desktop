+/*
+ * Select only SELinux exec, keycreate, fscreate and sockcreate on stacked-LSM
+ * kernels. The native interface performs the same per-attribute and target checks,
+ * without requiring write access to a task's procfs file class.
+ * Only kernels without this operation fall back to the original procattr ABI.
+ */
+static int setprocattr_native(const char *context, const char *attr)
+{
+#if defined(__NR_lsm_set_self_attr) && defined(LSM_ATTR_EXEC) && \
+    defined(LSM_ATTR_KEYCREATE) && defined(LSM_ATTR_FSCREATE) && \
+    defined(LSM_ATTR_SOCKCREATE) && defined(LSM_ID_SELINUX)
+	struct lsm_ctx *ctx;
+	unsigned int native_attr;
+	size_t length = context ? strlen(context) : 0;
+	size_t total;
+	int ret, saved_errno;
+
+	if (!strcmp(attr, "exec"))
+		native_attr = LSM_ATTR_EXEC;
+	else if (!strcmp(attr, "keycreate"))
+		native_attr = LSM_ATTR_KEYCREATE;
+	else if (!strcmp(attr, "fscreate"))
+		native_attr = LSM_ATTR_FSCREATE;
+	else if (!strcmp(attr, "sockcreate"))
+		native_attr = LSM_ATTR_SOCKCREATE;
+	else {
+		errno = EINVAL;
+		return -1;
+	}
+
+	if (length > UINT32_MAX - sizeof(*ctx) - 1) {
+		errno = E2BIG;
+		return -1;
+	}
+	total = sizeof(*ctx) + length + 1;
+	ctx = calloc(1, total);
+	if (!ctx)
+		return -1;
+	ctx->id = LSM_ID_SELINUX;
+	ctx->len = total;
+	ctx->ctx_len = length + 1;
+	if (context)
+		memcpy(ctx->ctx, context, length + 1);
+
+	do {
+		ret = syscall(__NR_lsm_set_self_attr, native_attr, ctx,
+			      (uint32_t)total, 0);
+	} while (ret < 0 && errno == EINTR);
+	if (ret > 0) {
+		errno = EPROTO;
+		ret = -1;
+	}
+	saved_errno = errno;
+	free(ctx);
+	errno = saved_errno;
+	return ret;
+#else
+	(void)context;
+	(void)attr;
+	errno = ENOSYS;
+	return -1;
+#endif
+}
