+/*
+ * Select the SELinux exec attribute explicitly on stacked-LSM kernels.
+ * The native interface performs the same SELinux setexec and exec-transition
+ * checks, without requiring write access to a task's procfs file class.
+ * Only kernels without this operation fall back to the original procattr ABI.
+ */
+static int setexecattr_native(const char *context)
+{
+#if defined(__NR_lsm_set_self_attr) && defined(LSM_ATTR_EXEC) && defined(LSM_ID_SELINUX)
+	struct lsm_ctx *ctx;
+	size_t length = context ? strlen(context) : 0;
+	size_t total;
+	int ret, saved_errno;
+
+	if (length > UINT32_MAX - sizeof(*ctx) - 1) {
+		errno = E2BIG;
+		return -1;
+	}
+	total = sizeof(*ctx) + length + 1;
+	ctx = calloc(1, total);
+	if (!ctx)
+		return -1;
+	ctx->id = LSM_ID_SELINUX;
+	ctx->len = total;
+	ctx->ctx_len = length + 1;
+	if (context)
+		memcpy(ctx->ctx, context, length + 1);
+
+	do {
+		ret = syscall(__NR_lsm_set_self_attr, LSM_ATTR_EXEC, ctx,
+			      (uint32_t)total, 0);
+	} while (ret < 0 && errno == EINTR);
+	saved_errno = errno;
+	free(ctx);
+	errno = saved_errno;
+	return ret;
+#else
+	(void)context;
+	errno = ENOSYS;
+	return -1;
+#endif
+}
