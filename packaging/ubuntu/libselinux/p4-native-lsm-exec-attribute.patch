+/*
+ * Read only the current thread's SELinux fscreate attribute. LSM_FLAG_SINGLE
+ * prevents a stacked LSM's context from being mistaken for SELinux. An unset
+ * fscreate SID is a valid record with ctx_len == 0, not a missing LSM record.
+ */
+static int getfscreate_native(char **context)
+{
+#if defined(__NR_lsm_get_self_attr) && defined(LSM_ATTR_FSCREATE) && \
+    defined(LSM_FLAG_SINGLE) && defined(LSM_ID_SELINUX)
+	struct lsm_ctx *ctx;
+	uint32_t capacity, size;
+	int ret, saved_errno;
+	char *value = NULL;
+
+	if (selinux_page_size > UINT32_MAX - sizeof(*ctx) - sizeof(uint64_t)) {
+		errno = E2BIG;
+		return -1;
+	}
+	/* The original procattr reader accepts at most one page of context.
+	 * Leave room for the native header and its kernel alignment padding. */
+	capacity = selinux_page_size + sizeof(*ctx) + sizeof(uint64_t) - 1;
+	ctx = calloc(1, capacity);
+	if (!ctx)
+		return -1;
+	do {
+		memset(ctx, 0, capacity);
+		ctx->id = LSM_ID_SELINUX;
+		size = capacity;
+		ret = syscall(__NR_lsm_get_self_attr, LSM_ATTR_FSCREATE, ctx,
+			      &size, LSM_FLAG_SINGLE);
+	} while (ret < 0 && errno == EINTR);
+	if (ret < 0)
+		goto out;
+	if (ret != 1 || size < sizeof(*ctx) || size > capacity ||
+	    ctx->id != LSM_ID_SELINUX || ctx->flags != 0 ||
+	    ctx->len != size || ctx->ctx_len > size - sizeof(*ctx)) {
+		errno = EPROTO;
+		ret = -1;
+		goto out;
+	}
+	/* Kernel records include only the exact zeroed alignment padding. */
+	size_t used = sizeof(*ctx) + ctx->ctx_len;
+	if (size != ((used + 7U) & ~(size_t)7U)) {
+		errno = EPROTO;
+		ret = -1;
+		goto out;
+	}
+	for (size_t i = used; i < size; i++) {
+		if (((const unsigned char *)ctx)[i] != 0) {
+			errno = EPROTO;
+			ret = -1;
+			goto out;
+		}
+	}
+	if (ctx->ctx_len) {
+		if (ctx->ctx[ctx->ctx_len - 1] != '\0' ||
+		    memchr(ctx->ctx, '\0', ctx->ctx_len - 1)) {
+			errno = EPROTO;
+			ret = -1;
+			goto out;
+		}
+		value = strdup((const char *)ctx->ctx);
+		if (!value) {
+			ret = -1;
+			goto out;
+		}
+	}
+	*context = value;
+	ret = 0;
+out:
+	saved_errno = errno;
+	free(ctx);
+	errno = saved_errno;
+	return ret;
+#else
+	(void)context;
+	errno = ENOSYS;
+	return -1;
+#endif
+}
