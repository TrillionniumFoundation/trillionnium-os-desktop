    {
      "line_1based": 46,
      "text": "      --show-versioncode: also show the version code"
    },
    {
      "line_1based": 47,
      "text": "      --apex-only: only show APEX packages"
    },
    {
      "line_1based": 48,
      "text": "      --factory-only: only show system packages excluding updates"
    },
    {
      "line_1based": 49,
      "text": "      --uid UID: filter to only show packages with the given UID"
    },
    {
      "line_1based": 50,
      "text": "      --user USER_ID: only list packages belonging to the given user"
    },
    {
      "line_1based": 51,
