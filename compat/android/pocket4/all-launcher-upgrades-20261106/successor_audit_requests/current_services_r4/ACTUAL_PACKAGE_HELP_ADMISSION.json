    {
      "line_1based": 34,
      "text": "    Prints all packages; optionally only those whose name contains"
    },
    {
      "line_1based": 35,
      "text": "    the text in FILTER.  Options are:"
    },
    {
      "line_1based": 45,
      "text": "      -u: also include uninstalled packages"
