+    try:
+        row["stdout"] = write(prefix + ".stdout", raw)
+        row["stderr"] = write(prefix + ".stderr", stderr)
+        row["stream_artifacts_complete"] = True
+    except BaseException as error:
+        row["stream_artifact_error"] = safe_error(error)
+        raise
+
