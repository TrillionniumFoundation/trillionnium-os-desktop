"python - <<'PY'\nfrom pathlib import Path\nimport urllib.request,concurrent.futures,json,hashlib\nr=Path('/workspace/scratch/265e5bca485a/pocket4_eight_apps/framework_provider_repair/normal06');dest=r/'reference/upstream-tree'\nitems=[[\"platform/frameworks/libs/systemui\",\"11e04f60f563aed48e4ec080bd7bde06bae1b2f3\",\"ace/src/com\",\"systemui-ace-src-com\"],[\"platform/packages/apps/PersonalContext\",\"025cc78a5a242ab434161d462e8d67e327db64d3\",\"src/main\",\"personalcontext-src-main\"],[\"platform/packages/apps/PersonalContext\",\"025cc78a5a242ab434161d462e8d67e327db64d3\",\"src/com\",\"personalcontext-src-com\"],[\"platform/packages/apps/Settings\",\"213829fb67f5e070029e0513a088f31bc8f5c1ed\",\"aconfig\",\"settings-aconfig\"],[\"platform/platform_testing\",\"6abefd291d50dee240ed2b22572d273175f070da\",\"libraries/health\",\"platform-testing-health\"],[\"platform/frameworks/base\",\"94b4c163b7dfe5ce3607f7bb8456f9573f7de57d\",\"core/java/android/hardware/devicestate/feature\",\"frameworks-base-devicestate-feature\"],[\"platform/prebuilts/tools\",\"b157d1c3bff39161f34ccc44dffbe9568f3bece2\",\"common\",\"prebuilts-tools-common\"]]\ndef one(item):\n repo,commit,path,label=item;url=f'https://android.googlesource.com/{repo}/+/{commit}/{path}?format=JSON'\n try:\n  with urllib.request.urlopen(url,timeout=25) as f:raw=f.read(1048577);status=f.status\n  assert len(raw)<=1048576;j=json.loads(raw.split(b'\\n',1)[1]);p=dest/(label+'.raw.json')\n  if p.exists():assert p.read_bytes()==raw\n  else:p.write_bytes(raw)\n  meta={'repository':repo,'commit':commit,'path':path,'url':url,'status':status,'bytes':len(raw),'sha256':hashlib.sha256(raw).hexdigest(),'TLS':'urllib default verified'};mp=p.with_suffix('.source.json');b=(json.dumps(meta,indent=2)+'\\n').encode()\n  if mp.exists():assert mp.read_bytes()==b\n  else:mp.write_bytes(b)\n  return {**meta,'entries':[{'name':e['name'],'type':e['type']} for e in j['entries']]}\n except Exception as e:return {'path':path,'url':url,'error':str(e)}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:\n for result in pool.map(one,items):print(json.dumps(result))\nPY"
