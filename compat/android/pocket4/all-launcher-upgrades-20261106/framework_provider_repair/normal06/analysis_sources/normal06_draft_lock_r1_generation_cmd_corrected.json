atform/'+project,'commit':pin,'purpose':'Exact original Android 17 superproject gitlink for captured normal06 SystemUI dependency providers; source-only candidate, not build-qualified'}\n  new['projects'].append(addition);entry.update({'change':'add_exact_superproject_project','new_project_entry':addition,'gitlink_evidence':gitlinks[project],'selection_note':'Full fixed-commit project selected in this draft; child-module graph and footprint are not yet qualified. No unrestricted repo sync.'})\n changes.append(entry)\nassert new['links']==old['links'] and new['superproject']==old['superproject'] and new['policy']==old['policy']\nfor a,b in zip(old['projects'],new['projects']):\n assert a['path']==b['path'] and a['commit']==b['commit'] and a['name']==b['name']\n if a!=b:\n  assert b['sparse_paths'][:len(a['sparse_paths'])]==a['sparse_paths'];temp=dict(b);temp['sparse_paths']=a['sparse_paths'];assert temp==a\nout=r/'candidate-lock-r1';out.mkdir(exist_ok=True);body=(json.dumps(new,indent=2)+'\\n').encode();lockname='m2-role-ingress-provider3-source-lock.draft.json';(out/lockname).write_bytes(body)\ndiff=''.join(difflib.unified_diff(oldbytes.decode().splitlines(keepends=True),body.decode().splitlines(keepends=True),fromfile='provider2-original-225-project-lock.json',tofile=lockname,n=3));(out/'source-lock.diff').write_text(diff)\nevidence={'schema':'pocket4-normal06-source-lock-draft-delta-v1','state':'DRAFT_INCOMPLETE_EXTERNAL_CLOSURE_NOT_EXECUTABLE','original_lock':{'path':str(oldpath),'bytes':len(oldbytes),'sha256':h(oldbytes),'project_count':len(old['projects']),'link_count':len(old['links'])},'draft_lock':{'name':lockname,'bytes':len(body),'sha256':h(body),'project_count':len(new['projects']),'link_count':len(new['links'])},'diff':{'bytes':len(diff.encode()),'sha256':h(diff.encode())},'changes':changes,'actual_configuration_reference':'actual-product-and-patched-source-proof.json','mandatory_open_work':['Resolve remaining exact-name provider and generated-variant qu