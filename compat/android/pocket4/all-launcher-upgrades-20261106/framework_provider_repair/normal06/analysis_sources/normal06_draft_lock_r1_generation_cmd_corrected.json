"python - <<'PY'\nfrom pathlib import Path\nimport json,hashlib,difflib,collections\nr=Path('/workspace/scratch/265e5bca485a/pocket4_eight_apps/framework_provider_repair/normal06');oldpath=r.parent/'normal05/source-r2/actual-provider-source-lock.json';oldbytes=oldpath.read_bytes();old=json.loads(oldbytes);oldmap={p['path']:p for p in old['projects']};graph=json.load(open(r/'unconditional-direct-source-closure-r4.json'));nodes={n['key']:n for n in graph['nodes']};by_file=collections.defaultdict(list)\nfor n in graph['nodes']:by_file[n['canonical_file']].append(n)\ndef h(b):return hashlib.sha256(b).hexdigest()\ngitlinks={}\nfor filename,prefix in [('superproject-external.raw.json','external'),('superproject-packages-apps.raw.json','packages/apps'),('superproject-frameworks-opt-net.raw.json','frameworks/opt/net'),('superproject-frameworks-opt.raw.json','frameworks/opt'),('superproject-prebuilts.raw.json','prebuilts'),('superproject-root.raw.json',''),('superproject-frameworks-libs.raw.json','frameworks/libs')]:\n p=r/'reference/upstream-tree'/filename;raw=p.read_bytes();j=json.loads(raw.split(b'\\n',1)[1]);meta=json.loads(p.with_suffix('.source.json').read_text()) if p.with_suffix('.source.json').exists() else json.loads((p.parent/(filename.replace('.raw.json','.source.json'))).read_text())\n assert meta['url'].startswith('https://android.googlesource.com/platform/superproject/+/28f0bbddc24d56c8ec5a8df5342ac7a292184039/') and h(raw)==meta['sha256']\n assert meta.get('commit','28f0bbddc24d56c8ec5a8df5342ac7a292184039')=='28f0bbddc24d56c8ec5a8df5342ac7a292184039'\n for e in j['entries']:\n  if e['type']=='commit':gitlinks[(prefix+'/' if prefix else '')+e['name']]={'commit':e['id'],'raw_tree':str(p.relative_to(r)),'raw_tree_sha256':h(raw),'gitlink_entry':e}\nuses=collections.defaultdict(list)\nfor e in graph['resolved_edges']:\n for k in e['provider_candidates']:uses[k].append({x:e[x] for x in ['consumer','property','condition','dependency']})\nneeded=collections.defaultd