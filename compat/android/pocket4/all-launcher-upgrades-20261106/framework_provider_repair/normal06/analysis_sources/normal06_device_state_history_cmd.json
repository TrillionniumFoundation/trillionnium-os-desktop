"python - <<'PY'\nfrom pathlib import Path\nimport urllib.request,concurrent.futures,json,hashlib\nr=Path('/workspace/scratch/265e5bca485a/pocket4_eight_apps/framework_provider_repair/normal06/reference/upstream-history');r.mkdir(exist_ok=True)\nitems=[('framework-device-state-feature','https://android.googlesource.com/platform/frameworks/base/+log/94b4c163b7dfe5ce3607f7bb8456f9573f7de57d/core/java/android/hardware/devicestate/feature/Android.bp?format=JSON&n=10'),('framework-aconfig-flags','https://android.googlesource.com/platform/frameworks/base/+log/94b4c163b7dfe5ce3607f7bb8456f9573f7de57d/AconfigFlags.bp?format=JSON&n=10')]\ndef one(item):\n label,url=item\n try:\n  with urllib.request.urlopen(url,timeout=25) as f:b=f.read(1048577);status=f.status\n  assert len(b)<=1048576;j=json.loads(b.split(b'\\n',1)[1]);p=r/(label+'.raw.json');assert not p.exists();p.write_bytes(b)\n  meta={'url':url,'status':status,'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest(),'TLS':'urllib default verified'};p.with_suffix('.source.json').write_text(json.dumps(meta,indent=2)+'\\n');return {**meta,'commits':[{k:e.get(k) for k in ['commit','tree','parents','message']} for e in j.get('log',[])]}\n except Exception as e:return {'url':url,'error':str(e)}\nwith concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:\n out=list(pool.map(one,items));(r/'history-index-r1.json').write_text(json.dumps(out,indent=2)+'\\n');print(json.dumps(out))\nPY"
