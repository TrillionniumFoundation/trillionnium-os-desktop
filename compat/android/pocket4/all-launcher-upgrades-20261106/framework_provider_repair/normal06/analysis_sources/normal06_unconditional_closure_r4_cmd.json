"python - <<'PY'\nfrom pathlib import Path\nimport json,re,hashlib,collections\nr=Path('/workspace/scratch/265e5bca485a/pocket4_eight_apps/framework_provider_repair/normal06'); actual=set((r/'reference/normal05-actual-graph/Android.bp.list').read_text().splitlines()); lock=json.loads((r.parent/'normal05/source-r2/actual-provider-source-lock.json').read_text()); projects={p['path']:p for p in lock['projects']}\ndef clean(t):return re.sub(r'\"(?:\\\\.|[^\"\\\\])*\"|//[^\\n]*|/\\*[\\s\\S]*?\\*/',lambda m:m.group(0) if m.group(0).startswith('\"') else ''.join('\\n' if c=='\\n' else ' ' for c in m.group(0)),t)\ndef modblocks(t):\n c=clean(t)\n for m in re.finditer(r'(?m)^([A-Za-z_][A-Za-z0-9_]*)\\s*\\{',c):\n  end=c.find('\\n}',m.end());assert end>=0\n  b=c[m.start():end+2];nm=re.search(r'(?m)^\\s*name:\\s*\"([^\"\\n]+)\"',b)\n  if nm:yield m.group(1),nm.group(1),b,m.start(),end+2\nfields={'defaults','libs','static_libs','plugins','exported_plugins','kotlin_plugins','uses_libs','optional_uses_libs','jni_libs','shared_libs','header_libs','whole_static_libs','required','target_required','host_required','tools','flags_packages','extra_check_modules','associates','aconfig_declarations','imports','export_header_lib_headers','runtime_libs'}\ndef edges(body):\n out=[]\n for m in re.finditer(r'(?m)^    ([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*\\[([^\\]]*)\\]',body,re.S):\n  prop,val=m.group(1),m.group(2)\n  for d in re.findall(r'\"([^\"\\n]+)\"',val):\n   if prop in fields:out.append({'property':prop,'dependency':d,'condition':'top_level_literal_array'})\n   elif d.startswith(':') and not d.startswith(':__'):out.append({'property':prop,'dependency':d[1:].split('{',1)[0],'condition':'top_level_literal_array_module_reference'})\n for m in re.finditer(r'(?m)^    ([A-Za-z_][A-Za-z0-9_]*)\\s*:\\s*\"([^\"\\n]+)\"',body):\n  prop,d=m.group(1),m.group(2)\n  if prop in {'base','instrumentation_for','aconfig_declarations'}:out.append({'property':prop,'dependency':d,'condition':'top_level_scalar'})\n  elif d.startswith(':') and not d.startswith(':__'):out.append({'property':prop,'dependency':d[1:].split('{',1)[0],'condition':'top_level_scalar_module_reference'})\n return list({(e['property'],e['dependency']):e for e in out}.values())\nfiles=[]\nfor p in sorted((r/'reference/upstream/packages/SystemUI').rglob('Android.bp')):files.append((p,'frameworks/base/packages/SystemUI/'+p.relative_to(r/'reference/upstream/packages/SystemUI').as_posix()))\nfor p in sorted((r/'reference/closure-providers').rglob('*')):\n if p.is_file() and p.name.endswith('.bp'):files.append((p,p.relative_to(r/'reference/closure-providers').as_posix()))\nfiles += [(r/'reference/upstream-go/WindowManager-Shell.Android.bp','frameworks/base/libs/WindowManager/Shell/Android.bp'),(r/'reference/upstream-go/frameworks-libs-systemui.Android.bp','frameworks/libs/systemui/Android.bp')]\nnodes={};names=collections.defaultdict(list)\nfor p,canonical in files:\n text=p.read_text();file_sha=hashlib.sha256(text.encode()).hexdigest()\n for kind,name,body,start,end in modblocks(text):\n  key=canonical+'#'+kind+':'+name\n  assert key not in nodes,key\n  project=next((x for x in sorted(projects,key=len,reverse=True) if canonical.startswith(x+'/')),None)\n  node={'key':key,'name':name,'kind':kind,'canonical_file':canonical,'source_file':str(p.relative_to(r)),'source_file_sha256':file_sha,'line':text.count('\\n',0,start)+1,'body_bytes':len(text[start:end].encode()),'body_sha256':hashlib.sha256(text[start:end].encode()).hexdigest(),'current_project':project,'file_present_in_actual_bp_list':canonical in actual,'edges':edges(body),'conditional_expression_present':bool(re.search(r'\\b(select\\s*\\(|product_variables\\s*:|soong_config_variables\\s*:|target\\s*:|arch\\s*:)',body)),'module_enabled_literal':re.findall(r'(?m)^    enabled:\\s*(true|false)',body),'host_supported_literal':re.findall(r'(?m)^    host_supported:\\s*(true|false)',body),'device_supported_literal':re.findall(r'(?m)^    device_supported:\\s*(true|false)',body)}\n  nodes[key]=node;names[name].append(key)\nselected=set()\nfor f in ['reference/SystemUI.candidate-r2-projection.bp','reference/WindowManager-Shell.candidate-r2-projection.bp']:\n canonical='frameworks/base/packages/SystemUI/Android.bp' if 'SystemUI.' in f else 'frameworks/base/libs/WindowManager/Shell/Android.bp'\n for kind,name,body,_,_ in modblocks((r/f).read_text()):\n  if kind in ['package','license']:continue\n  selected.add(canonical+'#'+kind+':'+name)\nstarts=[k for k,n in nodes.items() if n['canonical_file'].startswith('frameworks/base/packages/SystemUI/') and (n['canonical_file']!='frameworks/base/packages/SystemUI/Android.bp' or k in selected) and n['kind'] not in ['license','package']]+list(selected)\n# Root framework included .bp files are parsed through the observed parent Android.bp build list.\nimported={'frameworks/base/AconfigFlags.bp','frameworks/base/ProtoLibraries.bp','frameworks/base/TestProtoLibraries.bp','frameworks/base/Ravenwood.bp'}\ndef resolve(name):\n bare=name.rsplit(':',1)[-1] if name.startswith('//') else name\n found=names.get(bare,[])\n if name.startswith('//'):\n  prefix=name[2:].split(':',1)[0]+'/'\n  found=[k for k in found if nodes[k]['canonical_file'].startswith(prefix)]\n if not found:return []\n current=[k for k in found if nodes[k]['file_present_in_actual_bp_list'] or nodes[k]['canonical_file'] in imported or k in selected]\n return current or found\nseen=set();todo=list(starts);unresolved={};resolution=[]\nwhile todo:\n k=todo.pop()\n if k in seen:continue\n seen.add(k);n=nodes[k]\n for e in n['edges']:\n  found=resolve(e['dependency'])\n  ref={'consumer':k,'property':e['property'],'condition':e['condition']}\n  if found:\n   resolution.append({**ref,'dependency':e['dependency'],'provider_candidates':found,'selection_note':'prefer already-loaded exact-name declaration; source/prebuilt variant preference not evaluated' if len(found)>1 else 'single captured declaration; effective variant not evaluated'});todo.extend(found)\n  else:unresolved.setdefault(e['dependency'],[]).append(ref)\nclosure=[nodes[k] for k in sorted(seen)]\nnew_files=sorted({n['canonical_file'] for n in closure if not n['file_present_in_actual_bp_list'] and n['canonical_file'] not in imported and n['key'] not in selected})\nsource_conditions=[{k:n[k] for k in ['key','source_file','line','conditional_expression_present','module_enabled_literal']} for n in closure if n['canonical_file'].startswith('frameworks/base/packages/SystemUI/') and n['conditional_expression_present']]\nout={'schema':'pocket4-normal06-unconditional-source-closure-r4','purpose':'Offline source analysis only; not a Soong evaluator or build acceptance','actual_product_config_pin':{'path':'reference/normal05-vars-and-patches/soong.droidloom_x86_64.variables','sha256':'3cbecee50fbfbe52483834f3396a04501f2f9a63422d9f77df6012434d848e65','Debuggable':True,'SYSTEMUI_OPTIMIZE_JAVA':'true','Allow_missing_dependencies':False},'original_lock_sha256':hashlib.sha256((r.parent/'normal05/source-r2/actual-provider-source-lock.json').read_bytes()).hexdigest(),'original_project_count':len(projects),'actual_normal05_bp_files':len(actual),'source_files_examined':len(files),'captured_named_declarations':len(nodes),'start_count':len(set(starts)),'unconditional_reachable_declarations':len(closure),'nodes':closure,'resolved_edges':resolution,'unresolved_names_and_consumers':dict(sorted(unresolved.items())),'new_or_not_directly_listed_provider_files':new_files,'systemui_condition_bearing_modules':source_conditions,'limitations':['Conditional nested fields and select branches are not included in this required-edge graph; they need actual product configuration.','Unresolved means provider has not been captured or is generated; it is not by itself proof of missing project.','Already-loaded file presence does not independently prove projection-retained module or effective variant.','Prebuilt/source same-name coexistence is allowed by Soong prebuilt_ semantics; variant preference is not simulated.','Newly selected file may define additional enabled modules; complete root/file fidelity and their dependencies require review.'],'full_dependency_closure_qualified':False,'source_lock_sealed':False,'new_build_submitted':False,'production_ready':False}\np=r/'unconditional-direct-source-closure-r4.json';b=(json.dumps(out,ensure_ascii=False,indent=2)+'\\n').encode();p.write_bytes(b)\nprint(json.dumps({'path':str(p),'bytes':len(b),'sha256':hashlib.sha256(b).hexdigest(),'nodes':len(closure),'unresolved_count':len(unresolved),'unresolved_sample':list(sorted(unresolved))[:20],'new_files_count':len(new_files),'systemui_condition_bearing_modules':source_conditions}))\nPY"
