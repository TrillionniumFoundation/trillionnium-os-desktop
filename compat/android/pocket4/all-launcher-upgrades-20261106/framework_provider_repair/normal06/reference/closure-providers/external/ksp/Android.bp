package {
    default_visibility: [":__subpackages__"],
    default_applicable_licenses: ["external_ksp_license"],
}

license {
    name: "external_ksp_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

java_import_host {
    name: "kotlin_symbol_processing_api",
    visibility: [
        "//external/dagger2",
        "//frameworks/libs/systemui/MutableDagger",
        "//build/soong/cmd/kotlinc_incremental",
    ],
    jars: [
        "com/google/devtools/ksp/symbol-processing-api/2.2.20-2.0.2/symbol-processing-api-2.2.20-2.0.2.jar",
    ],
}

java_import_host {
    name: "ksp-common-deps",
    visibility: ["//build/soong/cmd/kotlinc_incremental"],
    jars: [
        "com/google/devtools/ksp/symbol-processing-common-deps/2.2.20-2.0.2/symbol-processing-common-deps-2.2.20-2.0.2.jar",
    ],
}

java_import_host {
    name: "ksp-cmdline",
    visibility: ["//build/soong/cmd/kotlinc_incremental"],
    jars: [
        "com/google/devtools/ksp/symbol-processing-cmdline/2.2.20-2.0.2/symbol-processing-cmdline-2.2.20-2.0.2.jar",
    ],
}

java_import_host {
    name: "ksp-aa-embeddable",
    visibility: ["//build/soong/cmd/kotlinc_incremental"],
    jars: [
        "com/google/devtools/ksp/symbol-processing-aa-embeddable/2.2.20-2.0.2/symbol-processing-aa-embeddable-2.2.20-2.0.2.jar",
    ],
}
