+            .position(|p| p["path"] == "external/python/pyee").unwrap();
+        assert_eq!(good["projects"][index]["commit"], "d67e4b09ff002069a025bfb232836eecab6dab52");
+        assert_eq!(good["projects"][index]["name"], "platform/external/python/pyee");
