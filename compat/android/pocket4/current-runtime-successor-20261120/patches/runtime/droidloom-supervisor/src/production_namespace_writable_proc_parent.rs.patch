+    fn root_mask_records(kind: u32) -> (MountRecord, MountRecord, MountRecord, Node) {
+        let proc = mount_records(PROC.as_bytes()).unwrap().remove(&9).unwrap();
+        let root = mount_records(
+            b"1 1 0:1 / / rw,nosuid,nodev - tmpfs owned-root rw,size=16384k,mode=755\n",
+        )
+        .unwrap()
+        .remove(&1)
+        .unwrap();
+        let node = Node { device: root.device, inode: 73 };
+        let record = MountRecord {
+            id: 10,
+            parent: proc.id,
+            device: node.device,
+            root: if kind == libc::S_IFREG {
+                "/.droidloom-proc-mask-file"
+            } else {
+                "/.droidloom-proc-mask-directory"
+            }
+            .into(),
+            target: "/proc/kcore".into(),
+            flags: ["ro", "nosuid", "nodev", "noexec"].map(str::to_owned).into(),
+            filesystem: "tmpfs".into(),
+            source: root.source.clone(),
+            options: root.options.clone(),
+        };
+        (record, proc, root, node)
+    }
