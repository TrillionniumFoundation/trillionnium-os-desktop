+    #[test]
+    fn production_runtime_proc_masks_require_owned_root_projection_for_both_inode_kinds() {
+        for kind in [libc::S_IFREG, libc::S_IFDIR] {
+            let (record, proc, root, node) = root_mask_records(kind);
+            assert!(mask_projection_matches(&record, &proc, &root, node, kind));
+            let mut metadata = root.clone();
+            metadata.target = "/metadata".into();
+            metadata.device = libc::makedev(0, 2);
+            metadata.source = "metadata".into();
+            assert!(!mask_projection_matches(&record, &proc, &metadata, node, kind));
+            let mut old = record.clone();
+            old.root = if kind == libc::S_IFREG { "/proc-mask-file" } else { "/proc-mask-directory" }.into();
+            assert!(!mask_projection_matches(&old, &proc, &root, node, kind));
+            assert!(!mask_projection_matches(&record, &proc, &root, node, libc::S_IFLNK));
+        }
+    }
+
+    #[test]
+    fn production_runtime_proc_root_masks_reject_projection_identity_or_flag_changes() {
+        let (record, proc, root, node) = root_mask_records(libc::S_IFREG);
+        let changes: [fn(&mut MountRecord); 9] = [
+            |r| r.parent += 1,
+            |r| r.device += 1,
+            |r| r.root.push_str("-alias"),
+            |r| r.filesystem = "ext4".into(),
+            |r| r.source = "foreign-tmpfs".into(),
+            |r| r.options = "rw,size=16777216".into(),
+            |r| { r.flags.remove("ro"); },
+            |r| { r.flags.remove("noexec"); },
+            |r| { r.flags.insert("rw".into()); },
+        ];
+        for change in changes {
+            let mut changed = record.clone();
+            change(&mut changed);
+            assert!(!mask_projection_matches(&changed, &proc, &root, node, libc::S_IFREG));
+        }
+        let mut different_root = root.clone();
+        different_root.device += 1;
+        assert!(!mask_projection_matches(&record, &proc, &different_root, node, libc::S_IFREG));
+        different_root = root;
+        different_root.flags.remove("rw");
+        different_root.flags.insert("ro".into());
+        assert!(!mask_projection_matches(&record, &proc, &different_root, node, libc::S_IFREG));
+    }
