+    #[test]
+    fn production_runtime_proc_root_mask_name_collisions_preserve_existing_inodes() {
+        for name in [".droidloom-proc-mask-file", ".droidloom-proc-mask-directory"] {
+            for kind in [libc::S_IFREG, libc::S_IFDIR, libc::S_IFLNK] {
+                let temp = tempfile::tempdir().unwrap();
+                let root = OpenOptions::new()
+                    .read(true)
+                    .custom_flags(libc::O_PATH | libc::O_DIRECTORY | libc::O_CLOEXEC | libc::O_NOFOLLOW)
+                    .open(temp.path())
+                    .unwrap();
+                assert!(mask_names_absent(&root).is_ok());
+                let collision = temp.path().join(name);
+                match kind {
+                    libc::S_IFREG => std::fs::write(&collision, b"existing inode").unwrap(),
+                    libc::S_IFDIR => std::fs::create_dir(&collision).unwrap(),
+                    libc::S_IFLNK => std::os::unix::fs::symlink("missing-target", &collision).unwrap(),
+                    _ => unreachable!(),
+                }
+                let before = std::fs::symlink_metadata(&collision).unwrap();
+                assert!(matches!(mask_names_absent(&root), Err(NamespaceError::Rejected(_))));
+                let after = std::fs::symlink_metadata(&collision).unwrap();
+                assert_eq!((after.dev(), after.ino(), after.mode(), after.len()),
+                    (before.dev(), before.ino(), before.mode(), before.len()));
+                if kind == libc::S_IFREG {
+                    assert_eq!(std::fs::read(&collision).unwrap(), b"existing inode");
+                } else if kind == libc::S_IFLNK {
+                    assert_eq!(std::fs::read_link(&collision).unwrap(), std::path::Path::new("missing-target"));
+                }
+            }
+        }
+    }
