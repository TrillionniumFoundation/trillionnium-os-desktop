+fn mask_projection_matches(
+    record: &MountRecord,
+    proc: &MountRecord,
+    root: &MountRecord,
+    expected: Node,
+    kind: u32,
+) -> bool {
+    let name = match kind {
+        libc::S_IFREG => "/.droidloom-proc-mask-file",
+        libc::S_IFDIR => "/.droidloom-proc-mask-directory",
+        _ => return false,
+    };
+    root.root == "/"
+        && root.target == "/"
+        && root.filesystem == "tmpfs"
+        && flags(&root.flags, &["rw", "nosuid", "nodev"], &["ro"])
+        && expected.device == root.device
+        && record.parent == proc.id
+        && record.device == expected.device
+        && record.root == name
+        && record.filesystem == "tmpfs"
+        && record.source == root.source
+        && record.options == root.options
+        && flags(&record.flags, &["ro", "nosuid", "nodev", "noexec"], &["rw"])
+}
