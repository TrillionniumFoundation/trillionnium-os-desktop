+    #[test]
+    fn backing_path_replacement_never_rebinds_or_reclaims_the_reservation() {
+        for name in ["data.img", "metadata.img"] {
+            let f = Fixture::new();
+            let authority = f.authority().unwrap();
+            let lease = f.reserve(&authority, &cohort()).unwrap();
+            let record = f.root.path().join("registry/u1000.json");
+            let original_record = fs::read(&record).unwrap();
+            let path = f.root.path().join("backings").join(name);
+            let body = fs::read(&path).unwrap();
+            fs::rename(&path, path.with_extension("saved")).unwrap();
+            fs::write(&path, &body).unwrap();
+            fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+            assert!(lease.revalidate_for_broker().is_err());
+            drop(lease);
+            assert!(matches!(
+                f.reserve(&authority, &cohort()),
+                Err(IdentityError::BindingConflict)
+            ));
+            assert_eq!(fs::read(&record).unwrap(), original_record);
+            assert_eq!(fs::read(&path).unwrap(), body);
+        }
+    }
+
+    #[test]
+    fn backing_parent_replacement_is_rejected_with_original_inodes_still_held() {
+        let f = Fixture::new();
+        let lease = f.reserve(&f.authority().unwrap(), &cohort()).unwrap();
+        let record = f.root.path().join("registry/u1000.json");
+        let original_record = fs::read(&record).unwrap();
+        let parent = f.root.path().join("backings");
+        let saved = f.root.path().join("held-original-backings");
+        fs::rename(&parent, &saved).unwrap();
+        fs::create_dir(&parent).unwrap();
+        fs::set_permissions(&parent, fs::Permissions::from_mode(0o700)).unwrap();
+        for name in ["data.img", "metadata.img"] {
+            fs::copy(saved.join(name), parent.join(name)).unwrap();
+        }
+        assert!(matches!(
+            lease.revalidate_for_broker(),
+            Err(IdentityError::AuthorityChanged)
+        ));
+        assert_eq!(fs::read(&record).unwrap(), original_record);
+        assert!(saved.join("data.img").is_file());
+        assert!(saved.join("metadata.img").is_file());
+    }
+
+    #[test]
+    fn backing_aliases_fail_before_any_registry_write() {
+        for alias in ["hardlink", "symlink", "extra-hardlink"] {
+            let f = Fixture::new();
+            let parent = f.root.path().join("backings");
+            let data = parent.join("data.img");
+            let metadata = parent.join("metadata.img");
+            match alias {
+                "hardlink" => {
+                    fs::remove_file(&metadata).unwrap();
+                    fs::hard_link(&data, &metadata).unwrap();
+                }
+                "symlink" => {
+                    fs::remove_file(&metadata).unwrap();
+                    symlink(&data, &metadata).unwrap();
+                }
+                _ => fs::hard_link(&data, parent.join("extra-name")).unwrap(),
+            }
+            assert!(matches!(
+                f.reserve(&f.authority().unwrap(), &cohort()),
+                Err(IdentityError::UnsafeCustody(_))
+            ));
+            assert!(!f.root.path().join("registry").exists());
+        }
+    }
+
+    #[test]
+    fn backing_size_or_access_changes_fail_without_rewriting_the_record() {
+        for name in ["data.img", "metadata.img"] {
+            for change in ["size", "mode"] {
+                let f = Fixture::new();
+                let lease = f.reserve(&f.authority().unwrap(), &cohort()).unwrap();
+                let record = f.root.path().join("registry/u1000.json");
+                let original_record = fs::read(&record).unwrap();
+                let path = f.root.path().join("backings").join(name);
+                if change == "size" {
+                    let file = OpenOptions::new().write(true).open(&path).unwrap();
+                    file.set_len(file.metadata().unwrap().len() + 1).unwrap();
+                } else {
+                    fs::set_permissions(&path, fs::Permissions::from_mode(0o660)).unwrap();
+                }
+                assert!(lease.revalidate_for_broker().is_err());
+                assert_eq!(fs::read(&record).unwrap(), original_record);
+            }
+        }
+    }
+
+    #[test]
+    fn backing_content_and_time_changes_do_not_replace_stable_identity() {
+        let f = Fixture::new();
+        let lease = f.reserve(&f.authority().unwrap(), &cohort()).unwrap();
+        let record = f.root.path().join("registry/u1000.json");
+        let original_record = fs::read(&record).unwrap();
+        for name in ["data.img", "metadata.img"] {
+            let path = f.root.path().join("backings").join(name);
+            let mut file = OpenOptions::new().write(true).open(&path).unwrap();
+            let before = file.metadata().unwrap();
+            file.write_all(&vec![0x5a; before.len() as usize]).unwrap();
+            file.set_modified(std::time::UNIX_EPOCH + std::time::Duration::from_secs(123))
+                .unwrap();
+            let after = file.metadata().unwrap();
+            assert_eq!(
+                (before.dev(), before.ino(), before.len()),
+                (after.dev(), after.ino(), after.len())
+            );
+            assert_ne!(
+                (before.mtime(), before.mtime_nsec()),
+                (after.mtime(), after.mtime_nsec())
+            );
+            lease.revalidate_for_broker().unwrap();
+            // An O_PATH handle still identifies a protected backing. This
+            // cannot become an admissible public artifact after body writes.
+            let parent =
+                trusted_directory(&f.root.path().join("backings"), f.owner, false).unwrap();
+            let held = open_at(&parent, name, libc::O_PATH, 0).unwrap();
+            assert!(matches!(
+                lease.broker_reject_backing_body(&held),
+                Err(IdentityError::UnsafeCustody(_))
+            ));
+        }
+        assert_eq!(fs::read(&record).unwrap(), original_record);
+    }
