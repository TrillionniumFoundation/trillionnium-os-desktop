  "example_test": {
    "package": "droidloom-source",
    "target": "frozen_pair_recipe",
    "tests": [
      "tests::appended_providers_do_not_allow_duplicates_escapes_or_337_cones",
      "tests::bounded_extension_preserves_the_history_and_edits_only_native_profile",
      "tests::complete_plan_keeps_project_capacity_and_root_link_checks",
      "tests::current645_recipe_renders_the_real_profile_without_a_delta",
      "tests::existing_exact_extension_is_retained",
      "tests::frozen_bytes_reject_whitespace_drift_wrong_sha_and_over_budget",
      "tests::monotonicity_rejects_header_project_revision_and_sparse_loss",
      "tests::original_superproject_mapping_rejects_name_commit_and_payload_drift",
      "tests::stale_or_repeated_patch_anchors_are_rejected"
    ]
  }
