package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_desktop_connectivity",
}

rust_defaults {
    name: "libueventd_deps_defaults",
    edition: "2021",
    rustlibs: [
        "libfutures",
        "libfutures_channel",
        "libinotify",
        "liblibc",
        "liblog_rust",
        "librtnetlink",
        "libthiserror",
        "libtokio",
        "libtokio_stream",
        "libasync_stream",
        "libnetlink_sys",
        "libkobject_uevent",
        "libenv_logger",
        "libtempfile",
    ],
    proc_macros: [
        "libasync_trait",
    ],
}

rust_defaults {
    name: "libueventd_defaults",
    defaults: ["libueventd_deps_defaults"],
    crate_name: "ueventd",
    srcs: [
        "src/lib.rs",
    ],
}

rust_library {
    name: "libueventd",
    defaults: ["libueventd_defaults"],
    host_supported: true,
    product_available: true,
    vendor_available: true,
}

rust_test_host {
    name: "libueventd_test",
    defaults: ["libueventd_defaults"],
    rustlibs: [
        "libmockall",
    ],
    test_suites: ["general-tests"],
    test_options: {
        unit_test: true,
    },
}

rust_binary {
    name: "iflist",
    defaults: ["libueventd_deps_defaults"],
    host_supported: true,
    rustlibs: [
        "libenv_logger",
        "libueventd",
    ],
    srcs: [
        "examples/iflist.rs",
    ],
}

rust_binary {
    name: "ifmonitor",
    defaults: ["libueventd_deps_defaults"],
    host_supported: true,
    rustlibs: [
        "libenv_logger",
        "libueventd",
    ],
    srcs: [
        "examples/ifmonitor.rs",
    ],
}

rust_binary {
    name: "kuevent_monitor",
    defaults: ["libueventd_deps_defaults"],
    host_supported: true,
    rustlibs: [
        "libenv_logger",
        "libueventd",
    ],
    srcs: [
        "examples/kuevent_monitor.rs",
    ],
}

rust_binary {
    name: "sysfs_monitor",
    defaults: ["libueventd_deps_defaults"],
    host_supported: true,
    rustlibs: [
        "libenv_logger",
        "libueventd",
    ],
    srcs: [
        "examples/sysfs_monitor.rs",
    ],
}

rust_binary {
    name: "ueventd_devlist",
    defaults: ["libueventd_deps_defaults"],
    host_supported: true,
    rustlibs: [
        "libenv_logger",
        "libueventd",
    ],
    srcs: [
        "examples/devlist.rs",
    ],
}
