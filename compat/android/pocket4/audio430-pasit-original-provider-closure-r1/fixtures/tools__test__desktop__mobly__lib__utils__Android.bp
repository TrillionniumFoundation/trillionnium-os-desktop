package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_library_host {
    name: "py-desktop-utils",
    srcs: [
        "*.py",
    ],
    exclude_srcs: ["*_test.py"],
    libs: [
        "py-chromiumos-config-lsnexus",
    ],
    pkg_path: "lib/utils",
}

python_test_host {
    name: "retry_test",
    team: "trendy_team_desktop_peripherals",
    srcs: [
        "retry_test.py",
    ],
    test_options: {
        unit_test: true,
    },
    libs: [
        "libprotobuf-python",
        "py-desktop-utils",
    ],
}

python_test_host {
    name: "functools_test",
    team: "trendy_team_desktop_peripherals",
    srcs: [
        "functools_test.py",
    ],
    test_options: {
        unit_test: true,
    },
    libs: [
        "libprotobuf-python",
        "py-desktop-utils",
    ],
}

python_test_host {
    name: "managed_process_test",
    team: "trendy_team_desktop_peripherals",
    srcs: [
        "managed_process_test.py",
    ],
    test_options: {
        unit_test: true,
    },
    libs: [
        "libprotobuf-python",
        "py-desktop-utils",
        "mobly",
    ],
}

python_test_host {
    name: "process_monitor_test",
    team: "trendy_team_desktop_peripherals",
    srcs: [
        "process_monitor_test.py",
    ],
    test_options: {
        unit_test: true,
    },
    libs: [
        "libprotobuf-python",
        "py-desktop-utils",
        "mobly",
    ],
}
