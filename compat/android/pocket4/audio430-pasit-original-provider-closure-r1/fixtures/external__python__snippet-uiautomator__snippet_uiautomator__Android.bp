python_library_host {
    name: "py-snippet-uiautomator",
    srcs: ["*.py"],
    libs: ["mobly"],
    pkg_path: "snippet_uiautomator",
}

android_test {
    name: "snippet-uiautomator",
    static_libs: [
        "snippet-uiautomator-lib",
    ],
    manifest: "android/app/src/main/AndroidManifest.xml",
    sdk_version: "current",
}

android_library {
    name: "snippet-uiautomator-lib",
    srcs: [
        "android/app/src/main/**/*.java",
    ],
    manifest: "android/app/src/main/AndroidManifest.xml",
    static_libs: [
        "androidx.test.runner",
        "androidx.test.uiautomator_uiautomator",
        "auto_value_annotations",
        "checker-qual",
        "mobly-snippet-lib",
        "guava",
    ],
    plugins: ["auto_value_plugin"],
    sdk_version: "current",
    min_sdk_version: "30",
}
