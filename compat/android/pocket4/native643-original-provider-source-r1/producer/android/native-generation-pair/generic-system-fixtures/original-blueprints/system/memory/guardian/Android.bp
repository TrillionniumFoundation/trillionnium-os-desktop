package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "pmgd_defaults",
    crate_root: "src/main.rs",
    srcs: ["heap_dump.cfg"],
    rustlibs: [
        "libanyhow",
        "libatrace_rust",
        "libinotify",
        "liblibc",
        "liblog_rust",
        "liblogger",
        "libnix",
        "libpmgd_flags_rust",
        "libprocessgroup_rust",
        "libregex",
        "librustutils",
        "libthiserror",
        "librand",
        "libserde",
        "libserde_json",
        "libstatslog_rust",
        "libpmgd_statslog",
    ],
}

rust_library {
    name: "libpmgd_statslog",
    srcs: [
        "src/statslog_wrapper.rs",
    ],
    crate_name: "pmgd_statslog",
    rustlibs: [
        "libstatslog_rust_header",
        "libstatspull_bindgen",
    ],
}

aconfig_declarations {
    name: "pmgd_flags",
    package: "android.memory.guardian.flags",
    container: "system",
    srcs: ["flags.aconfig"],
}

rust_aconfig_library {
    name: "libpmgd_flags_rust",
    crate_name: "pmgd_flags",
    aconfig_declarations: "pmgd_flags",
}

rust_binary {
    name: "pmg_daemon",
    defaults: ["pmgd_defaults"],
    stem: "pmgd",
    init_rc: ["pmgd.rc"],
}

rust_test {
    name: "pmgd_unit_tests",
    defaults: ["pmgd_defaults"],
    test_suites: ["general-tests"],
    auto_gen_config: true,
    rustlibs: [
        "libtempfile",
        "libmockall",
    ],
}
