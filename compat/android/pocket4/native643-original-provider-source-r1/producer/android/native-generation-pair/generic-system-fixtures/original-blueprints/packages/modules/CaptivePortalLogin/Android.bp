package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "CaptivePortalLoginDefaults",
    sdk_version: "module_current",
    min_sdk_version: "31",
    target_sdk_version: "37", // Keep in sync with CaptivePortalLoginTests
    lint: {
        strict_updatability_linting: true,
    },
    optimize: {
        ignore_warnings: false,
    },
}

android_library {
    name: "CaptivePortalLoginLib",
    defaults: ["CaptivePortalLoginDefaults"],
    srcs: [
        "src/**/*.java",
        ":statslog-captiveportallogin-java-gen",
    ],
    static_libs: [
        "androidx.annotation_annotation",
        "androidx.appcompat_appcompat",
        "androidx.browser_browser",
        "androidx.legacy_legacy-support-core-ui",
        "captiveportal-lib",
        "com.android.captiveportallogin.flags.flags-aconfig-java",
        "metrics-constants-protos",
        "modules-utils-build",
        "net-utils-connectivity-apks",
    ],
    libs: [
        "framework-configinfrastructure.stubs.module_lib",
        "framework-connectivity.stubs.module_lib",
        "framework-mediaprovider.stubs.module_lib",
        "framework-statsd.stubs.module_lib",
        "framework-wifi.stubs.module_lib",
    ],
    manifest: "AndroidManifest.xml",
}

filegroup {
    name: "CaptivePortalLoginJarJarExcludes",
    srcs: ["jarjar-excludes.txt"],
}

java_genrule {
    name: "CaptivePortalLoginJarJarRules",
    tool_files: [
        ":CaptivePortalLoginLib{.jar}",
        ":CaptivePortalLoginJarJarExcludes",
    ],
    tools: [
        "jarjar-rules-generator",
    ],
    out: ["CaptivePortalLoginJarJarRules.txt"],
    cmd: "$(location jarjar-rules-generator) " +
        "$(location :CaptivePortalLoginLib{.jar}) " +
        "--excludes $(location :CaptivePortalLoginJarJarExcludes) " +
        "--prefix com.android.captiveportallogin " +
        "--output $(out)",
    visibility: [
        "//packages/modules/CaptivePortalLogin:__subpackages__",
    ],
}

android_app {
    name: "CaptivePortalLogin",
    defaults: ["CaptivePortalLoginDefaults"],
    static_libs: ["CaptivePortalLoginLib"],
    jarjar_rules: ":CaptivePortalLoginJarJarRules",
    certificate: "networkstack",
    updatable: true,
    licenses: [
        "Android-Apache-2.0",
        "opensourcerequest",
    ],
}

android_library {
    name: "CaptivePortalLoginTestLib",
    defaults: ["CaptivePortalLoginDefaults"],
    static_libs: [
        "CaptivePortalLoginLib",
    ],
    lint: {
        strict_updatability_linting: true,
    },
}

genrule {
    name: "statslog-captiveportallogin-java-gen",
    tools: ["stats-log-api-gen"],
    cmd: "$(location stats-log-api-gen) --java $(out) --module captive_portal_login" +
        " --javaPackage com.android.os.corenetworking.captiveportallogin --javaClass CaptivePortalLoginStatsLog" +
        " --minApiLevel 30",
    out: ["com/android/os/corenetworking/captiveportallogin/CaptivePortalLoginStatsLog.java"],
}

aconfig_declarations {
    name: "captiveportallogin.flags",
    package: "com.android.captiveportallogin.flags",
    container: "CaptivePortalLogin",
    srcs: ["flags.aconfig"],
}

java_aconfig_library {
    name: "com.android.captiveportallogin.flags.flags-aconfig-java",
    aconfig_declarations: "captiveportallogin.flags",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    min_sdk_version: "31",
}
