+fn raw_directory_identity(fd: RawFd, expected: Identity) -> io::Result<()> {
+    let mut metadata = std::mem::MaybeUninit::<libc::stat>::uninit();
+    if unsafe { libc::fstat(fd, metadata.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let metadata = unsafe { metadata.assume_init() };
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };
+    if metadata.st_dev as u64 != expected.device || metadata.st_ino as u64 != expected.inode
+        || metadata.st_mode & libc::S_IFMT != libc::S_IFDIR
+        || metadata.st_uid != 0 || metadata.st_gid != 0 || metadata.st_mode & 0o022 != 0
+        || flags < 0 || flags & libc::FD_CLOEXEC == 0
+    {
+        return Err(error("bootstrap held directory identity or CLOEXEC changed before init"));
+    }
+    Ok(())
+}
+fn raw_procs(fd: RawFd, bytes: &mut [u8; 33]) -> io::Result<usize> {
+    let input = unsafe { libc::openat(fd, c"cgroup.procs".as_ptr(),
+        libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC) };
+    if input < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let result = (|| {
+        let mut used = 0;
+        let mut interruptions = 0;
+        loop {
+            if used == bytes.len() {
+                return Err(error("bootstrap membership exceeds final-exec bound"));
+            }
+            let count = unsafe { libc::read(input, bytes[used..].as_mut_ptr().cast(), bytes.len() - used) };
+            if count < 0 {
+                let error = io::Error::last_os_error();
+                if error.kind() == io::ErrorKind::Interrupted && interruptions < 8 {
+                    interruptions += 1;
+                    continue;
+                }
+                return Err(error);
+            }
+            if count == 0 {
+                return Ok(used);
+            }
+            used += count as usize;
+        }
+    })();
+    let closed = unsafe { libc::close(input) };
+    match result {
+        Err(error) => Err(error),
+        Ok(_) if closed != 0 => Err(io::Error::last_os_error()),
+        Ok(value) => Ok(value),
+    }
+}
+/// Final callback after CPU-placement callbacks. Fixed-size stack buffers and
+/// libc descriptor syscalls only on success; no new capability is inherited.
+pub(crate) fn validate_bootstrap_before_exec(domain: RawFd, domain_id: Identity,
+                                             leaf: RawFd, leaf_id: Identity) -> io::Result<()> {
+    raw_directory_identity(domain, domain_id)?;
+    raw_directory_identity(leaf, leaf_id)?;
+    let mut root_procs = [0u8; 33];
+    let mut leaf_procs = [0u8; 33];
+    if raw_procs(domain, &mut root_procs)? != 0 {
+        return Err(error("Android root regained an internal process before init exec"));
+    }
+    let length = raw_procs(leaf, &mut leaf_procs)?;
+    if !exact_pid_bytes(&leaf_procs[..length], unsafe { libc::getpid() }) {
+        return Err(error("entry left its exact bootstrap leaf before init exec"));
+    }
+    Ok(())
+}
+fn owned_directory(file: &File) -> io::Result<()> {
+    let m = file.metadata()?;
+    if !m.is_dir() || m.uid() != 0 || m.gid() != 0 || m.mode() & 0o022 != 0 {
+        return Err(error("private bootstrap directory owner/type/mode differs"));
+    }
+    Ok(())
