+/// Keep the stock Android target on the original synthetic sys tmpfs. A
+/// pre-mounted cgroup2 at this path would make Android's real mount fail.
+fn native_mount_target(root: &File) -> io::Result<File> {
+    let sys = beneath(root, "sys", libc::O_RDONLY | libc::O_DIRECTORY)?;
+    let target = beneath(root, "sys/fs/cgroup", libc::O_RDONLY | libc::O_DIRECTORY)?;
+    owned_directory(&sys)?;
+    owned_directory(&target)?;
+    filesystem(&sys, TMPFS_MAGIC)?;
+    filesystem(&target, TMPFS_MAGIC)?;
+    if Identity::of(&sys)?.device != Identity::of(&target)?.device {
+        return Err(error("native cgroup target is not the original private sys tmpfs"));
+    }
+    Ok(target)
+}
