+fn require_bootstrap_membership(root_procs: &str, leaf_procs: &str, pid: libc::pid_t) -> io::Result<()> {
+    if pid <= 0 || !root_procs.is_empty() || leaf_procs != format!("{pid}\n") {
+        return Err(error("bootstrap requires empty Android root and the exact init in its leaf"));
+    }
+    Ok(())
