+/// Capture only the host-precreated leaf beneath the inherited domain. This
+/// capability is CLOEXEC and is never transferred to Android or its apps.
+pub(crate) fn open_bootstrap(domain: &File) -> io::Result<File> {
+    root_directory(domain)?;
+    let leaf = at(domain.as_raw_fd(), BOOTSTRAP_LEAF,
+                  libc::O_RDONLY | libc::O_DIRECTORY, 0)?;
+    root_directory(&leaf)?;
