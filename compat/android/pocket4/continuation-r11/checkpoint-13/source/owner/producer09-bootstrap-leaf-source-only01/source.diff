+        || read_name(&leaf, "cgroup.type")? != "domain\n"
+        || !read_name(&leaf, "cgroup.subtree_control")?.trim().is_empty()
+    {
+        return Err(error("bootstrap leaf type/filesystem/controllers differ"));
+    }
+    empty_descendant(&leaf)?;
+    Ok(leaf)
+}
+fn validate_bootstrap_descriptor(domain: &File, leaf: &File, expected: Identity,
+                                 policy: &PressureRelaySpec) -> io::Result<()> {
+    root_directory(domain)?;
+    root_directory(leaf)?;
+    limits(domain, policy)?;
+    let named_leaf = at(domain.as_raw_fd(), BOOTSTRAP_LEAF,
+                        libc::O_RDONLY | libc::O_DIRECTORY, 0)?;
+    filesystem(&named_leaf, CGROUP2_MAGIC)?;
+    if Identity::of(leaf)? != expected || Identity::of(&named_leaf)? != expected
+        || expected.device != Identity::of(domain)?.device
+        || read_name(leaf, "cgroup.type")? != "domain\n"
+        || !read_name(leaf, "cgroup.subtree_control")?.trim().is_empty()
+    {
+        return Err(error("held bootstrap leaf identity or controller policy changed"));
+    }
+    Ok(())
+}
+/// This is intentionally after the private cgroup namespace has been sealed
+/// at android and its mounted root identity checked. Only "0" is migrated.
+pub(crate) fn enter_bootstrap(domain: &File, leaf: &File, expected: Identity,
+                             policy: &PressureRelaySpec) -> io::Result<()> {
+    validate_bootstrap_descriptor(domain, leaf, expected, policy)?;
+    let pid = unsafe { libc::getpid() };
+    if read_name(domain, "cgroup.procs")? != format!("{pid}\n") {
+        return Err(error("entry is not the sole current Android-root process"));
+    }
+    empty_descendant(leaf)?;
+    write_name(leaf, "cgroup.procs", "0\n")?;
+    validate_entry_bootstrap(domain, leaf, expected, policy)
+}
+pub(crate) fn validate_entry_bootstrap(domain: &File, leaf: &File, expected: Identity,
+                                     policy: &PressureRelaySpec) -> io::Result<()> {
+    validate_bootstrap_descriptor(domain, leaf, expected, policy)?;
+    require_bootstrap_membership(
+        &read_name(domain, "cgroup.procs")?, &read_name(leaf, "cgroup.procs")?,
+        unsafe { libc::getpid() },
+    )
+}
+fn exact_pid_bytes(bytes: &[u8], expected: libc::pid_t) -> bool {
+    if expected <= 0 || bytes.len() < 2 || bytes.last() != Some(&b'\n') || bytes[0] == b'0' {
+        return false;
+    }
+    let mut value = 0u32;
+    for byte in &bytes[..bytes.len() - 1] {
+        if !byte.is_ascii_digit() {
+            return false;
+        }
+        let Some(next) = value.checked_mul(10).and_then(|x| x.checked_add(u32::from(*byte - b'0'))) else {
+            return false;
+        };
+        value = next;
+    }
+    value == expected as u32
+}
+fn raw_directory_identity(fd: RawFd, expected: Identity) -> io::Result<()> {
+    let mut metadata = std::mem::MaybeUninit::<libc::stat>::uninit();
+    if unsafe { libc::fstat(fd, metadata.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let metadata = unsafe { metadata.assume_init() };
+    let flags = unsafe { libc::fcntl(fd, libc::F_GETFD) };
+    if metadata.st_dev as u64 != expected.device || metadata.st_ino as u64 != expected.inode
+        || metadata.st_mode & libc::S_IFMT != libc::S_IFDIR
+        || metadata.st_uid != 0 || metadata.st_gid != 0 || metadata.st_mode & 0o022 != 0
+        || flags < 0 || flags & libc::FD_CLOEXEC == 0
+    {
+        return Err(error("bootstrap held directory identity or CLOEXEC changed before init"));
+    }
+    Ok(())
+}
+fn raw_procs(fd: RawFd, bytes: &mut [u8; 33]) -> io::Result<usize> {
+    let input = unsafe { libc::openat(fd, c"cgroup.procs".as_ptr(),
+        libc::O_RDONLY | libc::O_NOFOLLOW | libc::O_CLOEXEC) };
+    if input < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let result = (|| {
+        let mut used = 0;
+        let mut interruptions = 0;
+        loop {
+            if used == bytes.len() {
+                return Err(error("bootstrap membership exceeds final-exec bound"));
+            }
+            let count = unsafe { libc::read(input, bytes[used..].as_mut_ptr().cast(), bytes.len() - used) };
+            if count < 0 {
+                let error = io::Error::last_os_error();
+                if error.kind() == io::ErrorKind::Interrupted && interruptions < 8 {
+                    interruptions += 1;
+                    continue;
+                }
+                return Err(error);
+            }
+            if count == 0 {
+                return Ok(used);
+            }
+            used += count as usize;
+        }
+    })();
+    let closed = unsafe { libc::close(input) };
+    match result {
+        Err(error) => Err(error),
+        Ok(_) if closed != 0 => Err(io::Error::last_os_error()),
+        Ok(value) => Ok(value),
+    }
+}
+/// Final callback after CPU-placement callbacks. Fixed-size stack buffers and
+/// libc descriptor syscalls only on success; no new capability is inherited.
+pub(crate) fn validate_bootstrap_before_exec(domain: RawFd, domain_id: Identity,
+                                             leaf: RawFd, leaf_id: Identity) -> io::Result<()> {
+    raw_directory_identity(domain, domain_id)?;
+    raw_directory_identity(leaf, leaf_id)?;
+    let mut root_procs = [0u8; 33];
+    let mut leaf_procs = [0u8; 33];
+    if raw_procs(domain, &mut root_procs)? != 0 {
+        return Err(error("Android root regained an internal process before init exec"));
+    }
+    let length = raw_procs(leaf, &mut leaf_procs)?;
+    if !exact_pid_bytes(&leaf_procs[..length], unsafe { libc::getpid() }) {
+        return Err(error("entry left its exact bootstrap leaf before init exec"));
+    }
+    Ok(())
+}
