+void Runtime::BlockSignals() {
+  SignalSet signals;
+  signals.Add(SIGPIPE);
+  // SIGQUIT is used to dump the runtime's state (including stack traces).
+  signals.Add(SIGQUIT);
+  // SIGUSR1 is used to initiate a GC.
+  signals.Add(SIGUSR1);
+  signals.Block();
+}
