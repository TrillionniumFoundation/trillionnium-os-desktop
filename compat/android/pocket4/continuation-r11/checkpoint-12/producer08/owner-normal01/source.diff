 def hex64(value):
     return isinstance(value, str) and len(value) == 64 and value != '0' * 64 and all(c in '0123456789abcdef' for c in value)
+
+
+def qualify_init_v2(detail, generation_nonce):
+    """Observe the actual ABI2 handshake; these bytes grant no authority."""
+    need(hex64(generation_nonce), 'init actual generation nonce invalid')
+    records = [(1, detail['init_hello']['init']['hello_wire_hex'])] + [
+        (kind, detail[event]['wire_hex']) for kind, event in
+        ((2, 'init_project_sent'), (3, 'init_projected_accepted'),
+         (4, 'init_commit_sent'), (5, 'init_done_accepted'))]
+    decoded = []
+    for kind, text in records:
+        need(isinstance(text, str) and len(text) == 256 and
+             all(char in '0123456789abcdef' for char in text), 'init protocol wire is not exact hex')
+        wire = bytes.fromhex(text)
+        need(wire[:8] == b'P4IBV2!!' and int.from_bytes(wire[8:12], 'little') == 2 and
+             int.from_bytes(wire[12:16], 'little') == kind and
+             wire[16:48].hex() == generation_nonce, 'init ABI2/phase/actual nonce differs')
+        decoded.append(wire)
+    project = decoded[1]
+    need(all(wire[:12] == project[:12] and wire[16:] == project[16:] for wire in decoded[2:]),
+         'init PROJECTED/COMMIT/DONE changed the exact projection permit')
+    need(project[76:] == bytes(52) and int.from_bytes(project[72:76], 'little') == 0o600,
+         'init projection reserved fields or mode differ')
+    endpoint = detail['broker_ready']['status']['endpoint']
+    need(int.from_bytes(project[48:56], 'little') == endpoint['device'] and
+         int.from_bytes(project[56:64], 'little') == endpoint['inode'] and
+         int.from_bytes(project[64:68], 'little') == 1069 and int.from_bytes(project[68:72], 'little') == 1069,
+         'init projection differs from actual READY endpoint/role')
+    return True
 
 
