+fn lmkd_rc(original: &str, uid: u32, gid: u32) -> io::Result<String> {
+    // Transform the actual held/hash-verified image RC; do not reconstruct its
+    // service policy or property actions from an incomplete hardcoded template.
+    // Unsupported layouts are rejected before any image preparation effects.
+    if original.is_empty() || original.len() > 65536 || !original.ends_with('\n')
+        || original.contains('\0') || original.contains('\r') || original.contains("DROIDLOOM_")
+    {
+        return Err(error("original lmkd.rc text/layout is unsupported"));
+    }
+    let lines: Vec<_> = original.split_inclusive('\n').collect();
+    let required = [
+        "service lmkd /system/bin/lmkd\n",
+        "    user lmkd\n",
+        "    group lmkd system readproc\n",
+        "    critical\n",
+        "    task_profiles ServiceCapacityLow\n",
+        "    exec_background /system/bin/lmkd --reinit\n",
+        "    exec_background /system/bin/lmkd --boot_completed\n",
+    ];
+    if required.iter().any(|line| lines.iter().filter(|actual| **actual == *line).count() != 1)
+        || lines.iter().filter(|line| line.split_whitespace().next() == Some("service")).count() != 1
+        || lines.iter().filter(|line| !line.trim_start().starts_with('#')
+            && line.contains("/system/bin/lmkd")).count() != 3
+    {
+        return Err(error("original lmkd service/helper command contract differs"));
+    }
+    let service = lines.iter().position(|line| *line == required[0]).expect("checked service");
+    let end = lines[service + 1..].iter().position(|line| {
+        let trimmed = line.trim();
+        !trimmed.is_empty() && !trimmed.starts_with('#')
+            && !line.starts_with(' ') && !line.starts_with('\t')
+    }).map_or(lines.len(), |offset| service + 1 + offset);
+    let options = &lines[service + 1..end];
+    if required[1..5].iter().any(|line| !options.contains(line))
+        || options.iter().any(|line| line.trim_start().starts_with("stdio_to_kmsg"))
+    {
+        return Err(error("required lmkd options are outside the original service"));
+    }
+    let mut generated = String::with_capacity(original.len() + 256);
+    for line in lines {
+        match line {
+            "service lmkd /system/bin/lmkd\n" =>
+                generated.push_str(&format!("service lmkd {}\n", init_peer::LMKD)),
+            "    user lmkd\n" => generated.push_str(&format!("    user {uid}\n")),
+            "    group lmkd system readproc\n" =>
+                generated.push_str(&format!("    group {gid} system readproc\n")),
+            "    task_profiles ServiceCapacityLow\n" => {
+                generated.push_str(line);
+                generated.push_str(concat!(
+                    "    stdio_to_kmsg\n",
+                    "    setenv DROIDLOOM_CELL 1\n",
+                    "    setenv DROIDLOOM_LMKD_CGROUP /sys/fs/cgroup\n",
+                    "    setenv DROIDLOOM_LMKD_PRESSURE relay-required\n",
+                ));
+            }
+            "    exec_background /system/bin/lmkd --reinit\n" =>
+                generated.push_str(&format!("    exec_background {} --reinit\n", init_peer::LMKD)),
+            "    exec_background /system/bin/lmkd --boot_completed\n" =>
+                generated.push_str(&format!("    exec_background {} --boot_completed\n", init_peer::LMKD)),
+            _ => generated.push_str(line),
+        }
+    }
+    Ok(generated)
 }
 
