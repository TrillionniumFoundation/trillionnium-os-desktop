+def execution_view_record(value, started, deadline):
+    """Closed metadata-only failure payload; never a successful source proof."""
+    fields = {'schema', 'scope', 'before_ns', 'after_ns', 'deadline_ns', 'root',
+        'root_matches_held', 'helper', 'interpreter_path', 'interpreter',
+        'interpreter_fd_opened', 'interpreter_fd_closed',
+        'interpreter_named_matches_held', 'complete', 'first_error', 'close_error'}
+    need(type(value) is dict and set(value) == fields and type(value['schema']) is int and
+         value['schema'] == 1 and value['scope'] == 'child-owned-root-before-one-held-ELF-exec' and
+         value['interpreter_path'] == '/system/bin/linker64' and value['deadline_ns'] == deadline and
+         type(value['deadline_ns']) is int and integer(value['before_ns']) and
+         integer(value['after_ns']) and started <= value['before_ns'] <= value['after_ns'],
+         'SDK_EXEC_VIEW_RECORD')
+    for key in ('root_matches_held', 'interpreter_fd_opened', 'interpreter_fd_closed',
+                'interpreter_named_matches_held', 'complete'):
+        need(type(value[key]) is bool, 'SDK_EXEC_VIEW_BOOLEAN')
+    if value['root'] is not None:
+        need(type(value['root']) is dict and set(value['root']) == {'device', 'inode'} and
+             all(integer(x, 1) for x in value['root'].values()), 'SDK_EXEC_VIEW_ROOT_RECORD')
+    meta_fields = {'device', 'inode', 'mode', 'uid', 'gid', 'nlink', 'bytes', 'mtime_ns', 'ctime_ns'}
+    for key, maximum in (('helper', HELPER_BYTES), ('interpreter', LIBRARY_BYTES)):
+        row = value[key]
+        if row is None:
+            continue
+        need(type(row) is dict and set(row) == {'metadata', 'bytes', 'sha256', 'elf'} and
+             integer(row['bytes'], 1, maximum) and hex_string(row['sha256'], 64),
+             'SDK_EXEC_VIEW_SOURCE_RECORD')
+        meta = row['metadata']
+        need(type(meta) is dict and set(meta) == meta_fields and
+             all(integer(x) for x in meta.values()) and meta['bytes'] == row['bytes'],
+             'SDK_EXEC_VIEW_METADATA_RECORD')
+        elf = row['elf']
+        need(type(elf) is dict and set(elf) == {'class', 'machine', 'type', 'build_id', 'interpreter'} and
+             type(elf['class']) is int and elf['class'] == 64 and
+             type(elf['machine']) is int and elf['machine'] == 62 and
+             type(elf['type']) is int and elf['type'] in (2, 3) and
+             isinstance(elf['build_id'], str) and 8 <= len(elf['build_id']) <= 128 and
+             len(elf['build_id']) % 2 == 0 and hex_string(elf['build_id'], len(elf['build_id'])) and
+             elf['interpreter'] in (None, '/system/bin/linker64'), 'SDK_EXEC_VIEW_ELF_RECORD')
+    stages = {'deadline', 'root_identity', 'held_helper', 'interpreter_open',
+              'interpreter_metadata', 'interpreter_source', 'interpreter_named', 'interpreter_close'}
+    for key in ('first_error', 'close_error'):
+        row = value[key]
+        if row is None:
+            continue
+        need(type(row) is dict and set(row) == ({'stage', 'type', 'errno'} if key == 'first_error'
+             else {'type', 'errno'}) and isinstance(row['type'], str) and
+             1 <= len(row['type']) <= 64 and all(c.isalnum() or c == '_' for c in row['type']) and
+             (row['errno'] is None or integer(row['errno'], 0, (1 << 31) - 1)),
+             'SDK_EXEC_VIEW_ERROR_RECORD')
+        if key == 'first_error':
+            need(row['stage'] in stages, 'SDK_EXEC_VIEW_ERROR_STAGE')
+    need(not value['interpreter_fd_closed'] or value['interpreter_fd_opened'],
+         'SDK_EXEC_VIEW_CLOSE_WITHOUT_OPEN')
+    if value['complete']:
+        need(value['after_ns'] < deadline and value['root_matches_held'] and
+             value['helper'] is not None and value['interpreter'] is not None and
+             value['helper']['bytes'] == HELPER_BYTES and value['helper']['sha256'] == HELPER_SHA256 and
+             value['helper']['elf']['type'] == 3 and
+             value['helper']['elf']['interpreter'] == '/system/bin/linker64' and
+             value['interpreter_fd_opened'] and value['interpreter_fd_closed'] and
+             value['interpreter_named_matches_held'] and value['first_error'] is None and
+             value['close_error'] is None, 'SDK_EXEC_VIEW_INCOMPLETE_CLAIM')
+    else:
+        need(value['first_error'] is not None, 'SDK_EXEC_VIEW_MISSING_FAILURE')
+    return value
+
