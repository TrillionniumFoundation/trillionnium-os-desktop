+def child_execution_view(view, helper_fd, expected_helper, expected_root, deadline):
+    """One fixed PT_INTERP observation in the already-chrooted child.
+
+    This neither executes a loader nor authorizes property reads. A successful
+    exec still requires the original READY/three-library/getter qualification.
+    """
+    view.update(schema=1, scope='child-owned-root-before-one-held-ELF-exec',
+        before_ns=time.monotonic_ns(), after_ns=None, deadline_ns=deadline,
+        root=None, root_matches_held=False, helper=None,
+        interpreter_path='/system/bin/linker64', interpreter=None,
+        interpreter_fd_opened=False, interpreter_fd_closed=False,
+        interpreter_named_matches_held=False, complete=False,
+        first_error=None, close_error=None)
+    descriptor = None
+    primary = None
+    stage = 'deadline'
+    def check():
+        need(time.monotonic_ns() < deadline, 'SDK_EXEC_VIEW_DEADLINE')
+    def source(fd, maximum):
+        check()
+        before = metadata(fd)
+        need(stat.S_ISREG(before['mode']) and 0 < before['bytes'] <= maximum,
+             'SDK_EXEC_VIEW_FILE_BOUND')
+        raw = bytearray()
+        while len(raw) < before['bytes']:
+            check()
+            part = os.pread(fd, min(65536, before['bytes'] - len(raw)), len(raw))
+            need(part, 'SDK_EXEC_VIEW_FILE_TRUNCATED')
+            raw.extend(part)
+        check()
+        need(os.pread(fd, 1, len(raw)) == b'' and metadata(fd) == before,
+             'SDK_EXEC_VIEW_FILE_CHANGED')
+        summary = elf_summary(bytes(raw))
+        return {'metadata': before, 'bytes': len(raw),
+                'sha256': hashlib.sha256(raw).hexdigest(),
+                'elf': {key: summary[key] for key in
+                        ('class', 'machine', 'type', 'build_id', 'interpreter')}}
+    try:
+        check()
+        stage = 'root_identity'
+        current = os.stat('/')
+        view['root'] = {'device': current.st_dev, 'inode': current.st_ino}
+        need(view['root'] == expected_root, 'SDK_EXEC_VIEW_ROOT_CHANGED')
+        view['root_matches_held'] = True
+        stage = 'held_helper'
+        check()
+        need(metadata(helper_fd) == expected_helper and
+             fcntl.fcntl(helper_fd, fcntl.F_GETFL) & os.O_ACCMODE == os.O_RDONLY and
+             not os.get_inheritable(helper_fd), 'SDK_EXEC_VIEW_HELD_HELPER_CHANGED')
+        view['helper'] = source(helper_fd, HELPER_BYTES)
+        need(view['helper']['bytes'] == HELPER_BYTES and
+             view['helper']['sha256'] == HELPER_SHA256 and
+             view['helper']['elf']['type'] == 3 and
+             view['helper']['elf']['interpreter'] == view['interpreter_path'],
+             'SDK_EXEC_VIEW_HELPER_SOURCE')
+        stage = 'interpreter_open'
+        check()
+        # Ordinary Android aliases resolve within this child's already-bound
+        # chroot. O_NONBLOCK prevents a changed FIFO from blocking before fstat.
+        descriptor = os.open(view['interpreter_path'],
+                             os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK)
+        view['interpreter_fd_opened'] = True
+        stage = 'interpreter_metadata'
+        check()
+        current = metadata(descriptor)
+        need(stat.S_ISREG(current['mode']) and current['uid'] == current['gid'] == 0 and
+             current['nlink'] == 1 and not current['mode'] & 0o7022 and
+             current['mode'] & 0o111 and 0 < current['bytes'] <= LIBRARY_BYTES and
+             not os.get_inheritable(descriptor) and
+             fcntl.fcntl(descriptor, fcntl.F_GETFL) & os.O_ACCMODE == os.O_RDONLY,
+             'SDK_EXEC_VIEW_INTERPRETER_METADATA')
+        stage = 'interpreter_source'
+        view['interpreter'] = source(descriptor, LIBRARY_BYTES)
+        stage = 'interpreter_named'
+        check()
+        named = os.stat(view['interpreter_path'])
+        held = metadata(descriptor)
+        need(held == view['interpreter']['metadata'] and
+             (named.st_dev, named.st_ino, named.st_mode, named.st_uid, named.st_gid,
+              named.st_nlink, named.st_size, named.st_mtime_ns, named.st_ctime_ns) ==
+             (held['device'], held['inode'], held['mode'], held['uid'], held['gid'],
+              held['nlink'], held['bytes'], held['mtime_ns'], held['ctime_ns']),
+             'SDK_EXEC_VIEW_INTERPRETER_NAME_CHANGED')
+        view['interpreter_named_matches_held'] = True
+        stage = 'root_identity'
+        check()
+        current = os.stat('/')
+        need({'device': current.st_dev, 'inode': current.st_ino} == expected_root,
+             'SDK_EXEC_VIEW_ROOT_CHANGED')
+        stage = 'deadline'
+        check()
+    except BaseException as error:
+        primary = error
+    finally:
+        if descriptor is not None:
+            try:
+                os.close(descriptor)
+                view['interpreter_fd_closed'] = True
+            except BaseException as error:
+                view['close_error'] = {'type': type(error).__name__,
+                                       'errno': getattr(error, 'errno', None)}
+                if primary is None:
+                    primary = error
+                    stage = 'interpreter_close'
+                else:
+                    primary.add_note('child interpreter FD close: ' + type(error).__name__)
+        view['after_ns'] = time.monotonic_ns()
+    if primary is None and view['after_ns'] >= deadline:
+        primary = RuntimeError('SDK_EXEC_VIEW_DEADLINE')
+        stage = 'deadline'
+    if primary is not None:
+        view['first_error'] = {'stage': stage, 'type': type(primary).__name__,
+                               'errno': getattr(primary, 'errno', None)}
+        raise primary
+    view['complete'] = True
+
