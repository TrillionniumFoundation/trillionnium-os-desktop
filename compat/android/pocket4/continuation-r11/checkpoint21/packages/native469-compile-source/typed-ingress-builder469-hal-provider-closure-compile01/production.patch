+fn validate_hal_provider_lock_extension(previous: &Value, expanded: &Value) -> Result<()> {
+    let mut expected = previous.clone();
+    let projects = expected.get_mut("projects").and_then(Value::as_array_mut)
+        .ok_or("previous provider lock lacks projects")?;
+    let indices: Vec<_> = projects.iter().enumerate()
+        .filter(|(_, project)| project.get("path").and_then(Value::as_str) == Some("packages/services/Car"))
+        .map(|(index, _)| index).collect();
+    if indices.len() != 1 {
+        return fail("HAL provider closure requires the exact existing Car project");
+    }
+    let paths = projects[indices[0]].get_mut("sparse_paths").and_then(Value::as_array_mut)
+        .ok_or("Car provider lock lacks sparse paths")?;
+    for addition in HAL_CAR_SOURCE_ADDITIONS {
+        let value = Value::String((*addition).to_owned());
+        if paths.contains(&value) {
+            return fail("HAL provider closure repeats an existing Car source path");
+        }
+        paths.push(value);
+    }
+    if paths.len() > 256 {
+        return fail("HAL provider closure exceeds the existing sparse path bound");
+    }
+    let addition: Value = serde_json::from_str(HAL_NEURAL_PROJECT_JSON)?;
+    let path = addition.get("path").and_then(Value::as_str)
+        .ok_or("HAL NeuralNetworks project lacks a path")?;
+    if projects.iter().any(|project| project.get("path").and_then(Value::as_str) == Some(path)) {
+        return fail("HAL provider closure replaces an existing project");
+    }
+    projects.push(addition);
+    if &expected != expanded {
+        return fail("HAL provider closure changed the prior provider lock or fixed source additions");
+    }
+    Ok(())
+}
