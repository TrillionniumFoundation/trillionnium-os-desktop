+def read_frozen_evidence(name, pin):
+    raw = (SOURCE / 'references' / name).read_bytes()
+    assert len(raw) == pin['bytes'] and sha(raw) == pin['sha256']
+    return raw, json.loads(raw)
+
+
+def packet_member_pins(name, expected_sha):
+    raw = (SOURCE / 'references' / name).read_bytes()
+    assert sha(raw) == expected_sha
+    packet = json.loads(raw)
+    pins = {}
+    for label, row in packet['members'].items():
+        body = row['text'].encode('utf-8')
+        assert len(body) == row['bytes'] and sha(body) == row['sha256']
+        pins[label] = {'bytes': row['bytes'], 'sha256': row['sha256']}
+    return pins
+
