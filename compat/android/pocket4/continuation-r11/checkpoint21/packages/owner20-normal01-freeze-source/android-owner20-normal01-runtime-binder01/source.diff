+def validate_control_terminal(status, receipt, stdout):
+    # The running control's pending-exit marker is closed only by this
+    # independently received authoritative terminal, not by its own JSON.
+    assert status['job_id'] == receipt['job_id']
+    assert status['state'] == 'succeeded' and status['exit_code'] == 0
+    assert status['output_complete'] is True and status['output_durable'] is True
+    assert status['terminal_publication_confirmed'] is True
+    assert status['audit_recorded'] is True
+    assert status['timed_out'] is False and status['cancelled'] is False and status['automatic_retry'] is False
+    assert status['log_bytes']['stdout'] == {'seen': len(stdout), 'stored': len(stdout)}
+    assert status['log_bytes']['stderr'] == {'seen': 0, 'stored': 0}
+    assert all(status[field][stream] is value for field, value in
+               (('log_synced', True), ('log_truncated', False), ('log_errors', None))
+               for stream in ('stdout', 'stderr'))
+    return True
+
