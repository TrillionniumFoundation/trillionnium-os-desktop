+                        "namespace FD differs from held proc identity: " + name)
+                self.namespaces[name] = fd
+            self.root_fd = self._own(os.open("root", os.O_PATH | os.O_DIRECTORY | os.O_CLOEXEC,
+                                            dir_fd=self.proc_fd))
