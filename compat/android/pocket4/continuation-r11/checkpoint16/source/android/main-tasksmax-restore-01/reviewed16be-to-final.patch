+def close_owned(fds):
+    """Attempt every close; an active primary exception remains primary."""
+    primary = sys.exception()
+    new_error = None
+    for fd in fds:
+        if fd is not None:
+            try:
+                os.close(fd)
+            except Exception as error:
+                if primary is not None:
+                    primary.add_note('secondary owned FD close error: ' + repr(error))
+                elif new_error is None:
+                    new_error = error
+                    new_error.add_note('owned FD close did not report success')
+                else:
+                    new_error.add_note('secondary owned FD close error: ' + repr(error))
+    if new_error is not None:
+        raise new_error
 
 
