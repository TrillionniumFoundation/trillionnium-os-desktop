+    fn observation_owned_child() -> (RelativeIoChild, ProcessPin) {
+        use std::process::{Command, Stdio};
+        let child = RelativeIoChild(Command::new("/bin/cat").stdin(Stdio::piped())
+            .stdout(Stdio::null()).stderr(Stdio::null()).spawn().unwrap());
+        let pid = child.0.id() as libc::pid_t;
