+    /// Preserve the original failed capture, then sample this same held pidfd
+    /// once without waiting. A ready result is later death evidence; zero is
+    /// only not-ready at this observation, never a successful identity check or
+    /// proof that the process was alive at the earlier failing namespace open.
+    fn observe_capture_failure(&self, cause: Error) -> Error {
+        let mut p = libc::pollfd { fd: self.pidfd.as_raw_fd(), events: libc::POLLIN, revents: 0 };
+        let poll_result = unsafe { libc::poll(&mut p, 1, 0) };
+        let poll_errno = if poll_result < 0 { io::Error::last_os_error().raw_os_error() } else { None };
+        let mut stat: libc::stat = unsafe { zeroed() };
+        let pidfd = if unsafe { libc::fstat(self.pidfd.as_raw_fd(), &mut stat) } == 0 {
+            Some(FileId { device: stat.st_dev as u64, inode: stat.st_ino as u64 })
+        } else { None };
+        Error::LifecycleCapture { cause: Box::new(cause), pid: self.pid, birth: self.start,
+            pidfd, proc_dir: FileId::of(&self.proc_dir).ok(), poll_result,
+            poll_revents: p.revents, poll_errno }
+    }
