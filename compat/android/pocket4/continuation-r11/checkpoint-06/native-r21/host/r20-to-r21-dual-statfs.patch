+int FstatfsKernel(int fd, KernelStatfs* result, const Configuration& config) {
+  const int incoming_errno = errno;
+  KernelStatfs actual{};
+  if (syscall(SYS_fstatfs, static_cast<long>(fd), &actual) < 0) return -1;
+  if (actual.f_type != TMPFS_MAGIC) {
+    // Keep the complete first raw observation. It cannot be our tmpfs-backed
+    // snapshot, even when the fd is closed or reused immediately afterwards.
+    *result = actual;
+    errno = incoming_errno;
+    return 0;
+  }
+  MetadataRequest request{&config, MetadataOperation::kKernelStatfs};
+  if (ReadOwnedMetadata(fd, &request) < 0) return -1;
+  *result = request.kernel_filesystem;
+  errno = incoming_errno;
+  return 0;
+}
+
+int FstatfsForGuest(int fd, void* guest_result, const Configuration& config) {
+  KernelStatfs value{};
+  if (FstatfsKernel(fd, &value, config) < 0) return -1;
+  return CopyToCaller(&value, guest_result, sizeof(value));
 }
 
