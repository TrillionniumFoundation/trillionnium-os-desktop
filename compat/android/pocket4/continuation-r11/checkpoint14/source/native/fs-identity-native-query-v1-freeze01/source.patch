+// This installs a complete app-zygote base filter with only the two native
+// identity-query forms admitted. It neither installs a UID/GID range nor
+// authenticates an app generation, and cannot override an existing deny filter.
+bool set_droidloom_app_zygote_seccomp_filter_v1() {
+    return InstallFilterWithFsQueryOption(FilterType::APP_ZYGOTE, true);
