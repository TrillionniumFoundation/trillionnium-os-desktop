+bool Reader::IsProcessKillFd(int target_fd, uint32_t uid, int32_t pid) const {
+    if (!opened_ || root_fd_ < 0 || target_fd < 0 || pid <= 0) return false;
+    char relative[96];
+    const int length = snprintf(relative, sizeof(relative), "uid_%u/pid_%d/cgroup.kill", uid, pid);
+    if (length <= 0 || static_cast<size_t>(length) >= sizeof(relative)) return false;
+    struct open_how how{};
+    how.flags = O_PATH | O_CLOEXEC;
+    how.resolve = RESOLVE_BENEATH | RESOLVE_NO_SYMLINKS | RESOLVE_NO_XDEV;
+    const int expected = static_cast<int>(syscall(SYS_openat2, root_fd_, relative, &how, sizeof(how)));
+    if (expected < 0) return false;  // no path-based or legacy fallback
+    struct stat actual{}, bound{};
+    struct statfs filesystem{};
+    const bool matches = !fstat(target_fd, &actual) && !fstat(expected, &bound) &&
+            S_ISREG(actual.st_mode) && S_ISREG(bound.st_mode) &&
+            actual.st_dev == bound.st_dev && actual.st_ino == bound.st_ino &&
+            !fstatfs(expected, &filesystem) && filesystem.f_type == CGROUP2_SUPER_MAGIC;
+    close(expected);
+    return matches;
+}
