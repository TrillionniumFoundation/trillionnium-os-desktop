+bool Reader::ReadScoped(Snapshot* snapshot, ScopeIdentity* identity, int64_t window_ms) {
+    struct stat before{}, after{};
+    Snapshot current{};
+    if (!snapshot || !identity || root_fd_ < 0 || fstat(root_fd_, &before) ||
+        !S_ISDIR(before.st_mode)) {
+        error_ = EINVAL;
+        ClearHighEvidence();
+        return false;
+    }
+    if (!Read(&current, window_ms)) return false;
+    if (fstat(root_fd_, &after) || before.st_dev != after.st_dev || before.st_ino != after.st_ino) {
+        error_ = ESTALE;
+        ClearHighEvidence();
+        return false;
+    }
+    *identity = {static_cast<uint64_t>(after.st_dev), static_cast<uint64_t>(after.st_ino)};
+    *snapshot = current;
+    return true;
+}
