+        return false;
+    }
+    adopted_once_ = true;
+    fd_ = fd;
+    scope_ = s;
+    config_ = c;
+    peer_ = peer;
+    int type = 0, domain = 0;
+    int descriptor_flags = fd_ < 0 ? -1 : fcntl(fd_, F_GETFD);
+    int status_flags = fd_ < 0 ? -1 : fcntl(fd_, F_GETFL);
