+        !SocketInt(fd_, SO_TYPE, &type) || type != SOCK_SEQPACKET ||
+        !SocketInt(fd_, SO_DOMAIN, &domain) || domain != AF_UNIX ||
+        !ReadCredentials(fd_, &actual) || !(actual == peer_)) {
+        Revoke();
