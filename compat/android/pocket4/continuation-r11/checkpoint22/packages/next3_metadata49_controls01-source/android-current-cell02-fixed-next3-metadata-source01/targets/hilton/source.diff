+def directory_identity(fd):
+    value=os.fstat(fd)
+    need(stat.S_ISDIR(value.st_mode),'FIXED_TARGET_DATA_DIRECTORY_REQUIRED')
+    return {'device':value.st_dev,'inode':value.st_ino,'mode':value.st_mode,
