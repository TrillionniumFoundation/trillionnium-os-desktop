+    #[test]
+    fn retirement_pending_absence_and_live_creation_share_one_capacity_bound() {
+        let (client, mut server) = pair(true, true);
+        for value in 1..=u64::from(MAX_TASK_OBJECTS) {
+            retire(&client, &mut server, TaskObjectId(100_000+value), RetirementNonce(value));
+        }
+        let extra = TaskObjectId(999_999);
+        client.send_android(&AndroidMessage::CreateTask {
+            object: extra, display: AndroidDisplayId(extra.0),
+            package: "org.example.retirement".into(),
+        }, &[]).unwrap();
+        assert!(matches!(server.receive_action(), Err(EndpointError::TaskLimit)));
+        assert!(server.tasks.is_empty());
+        assert_eq!(server.retirements.len(), MAX_TASK_OBJECTS as usize);
+        no_receipt(&client);
+        // This explicit engine hook is an endpoint-API seam, not a GPU proof.
+        server.complete_retirement(TaskObjectId(100_001), RetirementNonce(1)).unwrap();
+        receipt(&client, TaskObjectId(100_001), RetirementNonce(1));
+        create(&client, &mut server, extra);
+        assert_eq!(server.tasks.len()+server.retirements.len(), MAX_TASK_OBJECTS as usize);
