+    /// Complete an exact retirement after the engine has removed its resources.
+    ///
+    /// The engine must bind this call to the same endpoint generation and its
+    /// exact object/nonce callback. Receiving RetireTask alone never calls this.
+    /// The endpoint independently requires every accepted frame to be released.
+    ///
+    /// # Errors
+    /// Rejects a foreign/replayed tuple, outstanding frames, or any send error.
+    /// A failed send remains pending and is never automatically retried.
+    pub fn complete_retirement(
+        &mut self,
+        object: TaskObjectId,
+        nonce: RetirementNonce,
+    ) -> Result<(), EndpointError> {
+        if !self.retirement_receipts {
+            return Err(EndpointError::RetirementUnsupported);
+        }
+        let pending = self.retirements.get(&object)
+            .ok_or(EndpointError::RetirementMismatch { object, nonce })?;
+        if pending.nonce != nonce || pending.engine_completed
+            || pending.acknowledgement_attempted
+        {
+            return Err(EndpointError::RetirementMismatch { object, nonce });
+        }
+        if let Some(task) = self.tasks.get(&object) {
+            if !task.retiring || !task.pending.is_empty()
+                || task.state.in_flight_count() != 0
+            {
+                return Err(EndpointError::TaskBusy(object));
+            }
+        }
+        let pending = self.retirements.get_mut(&object)
+            .ok_or(EndpointError::RetirementMismatch { object, nonce })?;
+        pending.engine_completed = true;
+        pending.acknowledgement_attempted = true;
+        self.socket.send_denial(&DenialMessage::TaskRetired { object, nonce })?;
+        self.tasks.remove(&object);
+        self.retirements.remove(&object);
+        Ok(())
+    }
