+/// Keep the exact Child as the kernel unshare owner on the relay path.
+/// The historical compatibility wrapper forks again and closes all four
+/// capability FDs. It remains part of the legacy None path only.
+fn development_namespace_command(
+    namespace: &str,
+    entry: &Path,
+    spec_path: &Path,
+    relay_required: bool,
+) -> std::process::Command {
+    let mut command = droidloom_cpu_placement::command(
+        if relay_required { "/usr/bin/ip" } else { "ip" });
+    command.args(["netns", "exec", namespace,
+        if relay_required { "/usr/bin/unshare" } else { "unshare" }]);
+    command.args([
+        "--mount", "--pid", "--mount-proc", "--ipc", "--uts", "--fork", "--kill-child=TERM",
+    ]);
+    if !relay_required {
+        // The paired legacy shim implements this unsupported util-linux flag.
+        command.arg("--forward-signals");
+    }
+    command.arg("--propagation=private")
+        .arg(entry).arg("development-enter").arg("--spec").arg(spec_path);
+    command
 }
 
