+ class SignatureOnlyTask:
+  # This seam binds the real production signature; it does not execute held I/O.
+  @staticmethod
+  def open_task_context(*args,**kwargs):
+   bound=signature.bind(*args,**kwargs)
+   expected={'ref':q.ref,'util':q.util,'context':context,'source_manifest':SOURCE_MANIFEST,
+    'source_verify':verify,'flow_root':FLOW,'step':STEP,'transport':transport,'result':result,
+    'deadline':deadline,'phase':'launch','qa':q.qa,'inspect_plan':plans,'resolve':q.resolver.RESOLVE,
+    'expected_scope':scope,'install_source_manifest':q.resolver.INSTALL_SOURCE_SHA}
+   need(bound.arguments==expected and bound.arguments['inspect_plan'] is plans,
+    'CURRENT_READ_PRODUCTION_ROUTE_BINDING')
+   calls.append((args,kwargs));return sentinel
+ need(open_current_read_context(SignatureOnlyTask,q,context,transport,result,verify,deadline,scope,plans) is sentinel and
+  len(calls)==1,'ONE_CURRENT_READ_CONTEXT_CALL')
+ cases.append({'name':'production-read-route-binds-complete-plans-and-install-source','passed':True})
+ try:signature.bind(*calls[0][0])
