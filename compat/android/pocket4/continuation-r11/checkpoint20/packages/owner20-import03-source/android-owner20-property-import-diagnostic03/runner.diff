+def execute_module_statements(source, module_name, source_name, observed, result):
+    """Execute the same pinned module statements in order, never its controls."""
+    parsed = ast.parse(source, filename=source_name, mode='exec')
+    need(0 < len(parsed.body) <= 64, 'FIXED_TOP_LEVEL_STATEMENT_BOUND')
+    need(len(result['module_statement_observations']) + len(parsed.body) <= 80,
+         'FIXED_TOTAL_STATEMENT_BOUND')
+    allowed = (ast.Expr, ast.Import, ast.ImportFrom, ast.Assign,
+               ast.FunctionDef, ast.ClassDef, ast.If)
+    need(all(isinstance(node, allowed) for node in parsed.body),
+         'FIXED_TOP_LEVEL_STATEMENT_TYPE')
+    module = types.ModuleType(module_name)
+    module.__file__ = '<exact-owned-source>/' + source_name
+    previous = observed.sample('before_module', source_name)
+    for index, node in enumerate(parsed.body):
+        row = {'source': source_name, 'source_sha256': hashlib.sha256(source.encode()).hexdigest(),
+               'statement_index': index, 'node_type': type(node).__name__,
+               'line': node.lineno, 'end_line': node.end_lineno,
+               'before_fd_snapshot': previous, 'after_fd_snapshot': None,
+               'executed': False, 'fd_identity_unchanged': False}
+        if isinstance(node, ast.Import):
+            row['import_names'] = [item.name for item in node.names]
+        elif isinstance(node, ast.ImportFrom):
+            row['import_from'] = node.module
+            row['import_names'] = [item.name for item in node.names]
+            row['import_level'] = node.level
+        elif isinstance(node, (ast.FunctionDef, ast.ClassDef)):
+            row['definition_name'] = node.name
+        result['module_statement_observations'].append(row)
+        primary = None
+        try:
+            # No rewriting or preload. Existing line numbers, globals and order
+            # are preserved. Neither module's run/Capture entry is called.
+            piece = ast.Module(body=[node], type_ignores=[])
+            exec(compile(piece, source_name, 'exec', dont_inherit=True), module.__dict__)
+            row['executed'] = True
+        except BaseException as error:
+            primary = error
+            row['statement_error'] = {'type': type(error).__name__,
+                                      'error': repr(error)[:512]}
+        finally:
+            try:
+                after = observed.sample('after_module_statement', source_name)
+                row['after_fd_snapshot'] = after
+                row['fd_identity_unchanged'] = observed.equal(
+                    previous, after, 'module_statement', source_name + ':' + str(node.lineno))
+                if not row['fd_identity_unchanged']:
+                    # Attribute only to this statement boundary. A newly
+                    # observed descriptor is not thereby owned or safe to close.
+                    result['first_statement_discrepancy'] = dict(row)
+                    result['diagnostic_collection_complete'] = True
+                    change = RuntimeError('HOST_MODULE_STATEMENT_LIVE_FD_IDENTITY_CHANGED')
+                    if primary is None:
+                        primary = change
+                    else:
+                        primary.add_note(str(change))
+                previous = after
+            except BaseException as observation_error:
+                if primary is None:
+                    primary = observation_error
+                else:
+                    primary.add_note('statement FD observation: ' + repr(observation_error)[:160])
+        if primary is not None:
+            raise primary
+    return module
+
+
