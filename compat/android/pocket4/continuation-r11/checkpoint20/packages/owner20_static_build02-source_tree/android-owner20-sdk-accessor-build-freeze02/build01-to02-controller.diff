+HOST_LIFECYCLE_FIXTURE = r"""import os
+import sys
+import time
+
+mode = sys.argv[1]
+if mode == 'pidfd-failure':
+    time.sleep(30)
+    raise SystemExit(0)
+if mode not in ('timeout-descendant', 'escaped-descendant'):
+    raise SystemExit(2)
+read_end, write_end = os.pipe()
+child = os.fork()
+if child == 0:
+    os.close(read_end)
+    if mode == 'escaped-descendant':
+        os.setsid()
+    os.write(write_end, b'R')
+    os.close(write_end)
+    time.sleep(30)
+    os._exit(0)
+os.close(write_end)
+if os.read(read_end, 1) != b'R':
+    os._exit(3)
+os.close(read_end)
+print('READY %d %d' % (os.getpid(), child), flush=True)
+if mode == 'escaped-descendant':
+    os._exit(0)
+time.sleep(30)
+"""
+
+
