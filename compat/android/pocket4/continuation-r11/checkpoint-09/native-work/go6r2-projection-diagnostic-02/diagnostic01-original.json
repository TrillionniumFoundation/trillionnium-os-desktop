        },
        {
          "line": 265,
          "text": "// bootstrapEpochCleanup deletes files used by bootstrap during incremental builds across"
        },
        {
          "line": 266,
          "text": "// incompatible changes.  Incompatible changes are marked by incrementing the bootstrapEpoch"
        },
        {
          "line": 267,
          "text": "// constant.  A tree is considered out of date for the current epoch of the"
        },
        {
          "line": 268,
          "text": "// .soong.bootstrap.epoch.<epoch> file doesn't exist."
        },
        {
          "line": 507,
