          "line": 216,
          "text": "\tcommonArgs = append(commonArgs, \"-l\", filepath.Join(pb.config.FileListDir(), \"Android.bp.list\"))"
        },
        {
          "line": 217,
          "text": "\tinvocationEnv := make(map[string]string)"
        },
        {
          "line": 218,
          "text": "\t// Private leaf build on a 24 GiB desktop. env -i drops outer Go settings;"
        },
        {
          "line": 219,
          "text": "\t// give the analyzer the supported Go soft memory budget explicitly."
        },
        {
          "line": 220,
          "text": "\t// This changes collection frequency, not module or dependency validation."
        },
        {
          "line": 221,
          "text": "\tinvocationEnv[\"GOMEMLIMIT\"] = \"6GiB\""
        },
        {
          "line": 222,
          "text": "\tif pb.debugPort != \"\" {"
        },
        {
          "line": 223,
          "text": "\t\t//debug mode"
        },
        {
          "line": 224,
          "text": "\t\tcommonArgs = append(commonArgs, \"--delve_listen\", pb.debugPort,"
        },
        {
          "line": 225,
          "text": "\t\t\t\"--delve_path\", shared.ResolveDelveBinary())"
        },
        {
          "line": 226,
          "text": "\t\t// GODEBUG=asyncpreemptoff=1 disables the preemption of goroutines. This"
        },
        {
          "line": 227,
          "text": "\t\t// is useful because the preemption happens by sending SIGURG to the OS"
        },
        {
          "line": 228,
          "text": "\t\t// thread hosting the goroutine in question and each signal results in"
        },
        {
          "line": 229,
          "text": "\t\t// work that needs to be done by Delve; it uses ptrace to debug the Go"
        },
        {
          "line": 230,
          "text": "\t\t// process and the tracer process must deal with every signal (it is not"
        },
        {
          "line": 231,
          "text": "\t\t// possible to selectively ignore SIGURG). This makes debugging slower,"
        },
        {
          "line": 232,
          "text": "\t\t// sometimes by an order of magnitude depending on luck."
        },
        {
          "line": 233,
          "text": "\t\t// The original reason for adding async preemption to Go is here:"
        },
        {
          "line": 234,
          "text": "\t\t// https://github.com/golang/proposal/blob/master/design/24543-non-cooperative-preemption.md"
        },
        {
          "line": 235,
          "text": "\t\tinvocationEnv[\"GODEBUG\"] = \"asyncpreemptoff=1\""
        },
        {
          "line": 236,
          "text": "\t}"
        },
        {
          "line": 237,
          "text": ""
        },
        {
          "line": 238,
          "text": "\tvar allArgs []string"
        },
        {
          "line": 239,
          "text": "\tallArgs = append(allArgs, pb.specificArgs...)"
        },
