        },
        {
          "line": 512,
          "text": "// b/376466642: If the concurrency of updateSymlinks is unbounded, Go's runtime spawns a"
        },
        {
          "line": 513,
          "text": "// theoretically unbounded number of threads to handle blocking syscalls. This causes the runtime to"
        },
        {
          "line": 514,
          "text": "// panic due to hitting thread limits in rare cases. Limiting to GOMAXPROCS concurrent symlink"
        },
        {
          "line": 515,
          "text": "// updates should make this a non-issue."
        },
        {
          "line": 516,
          "text": "func newUpdateSemaphore() chan struct{} {"
        },
        {
          "line": 517,
          "text": "\tnumPermits := runtime.GOMAXPROCS(0)"
        },
        {
          "line": 518,
          "text": "\tc := make(chan struct{}, numPermits)"
        },
        {
          "line": 519,
          "text": "\tfor i := 0; i < numPermits; i++ {"
        },
        {
          "line": 520,
          "text": "\t\tc <- struct{}{}"
        },
        {
          "line": 521,
          "text": "\t}"
        },
        {
          "line": 522,
          "text": "\treturn c"
        },
        {
          "line": 523,
          "text": "}"
        },
