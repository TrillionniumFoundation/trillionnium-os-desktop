+fn materialized_lock_is_previous(value: &Value) -> Result<bool> {
+    match value.get("source_lock_sha256").and_then(Value::as_str) {
+        Some(SOURCE_LOCK_SHA) => Ok(false),
+        Some(PREVIOUS_SOURCE_LOCK_SHA) => Ok(true),
+        _ => fail("typed provider source workspace belongs to neither exact permitted typed lock"),
+    }
+}
