+    projected_hash = actual["files"][SOONG_SOURCE]
+    require(isinstance(projected_hash, str) and len(projected_hash) == 64 and
+            all(c in "0123456789abcdef" for c in projected_hash) and
+            projected_hash == old["files"][SOONG_SOURCE],
