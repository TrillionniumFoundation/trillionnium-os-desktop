+def go_builder_inventory(base):
+    require(len(base) == 449, "base builder inventory is not the pinned 449-file set")
+    row = base[GO_PATCH]
+    require(row["kind"] == "file" and row["sha256"] == GO_PATCH_PREIMAGE_SHA and
