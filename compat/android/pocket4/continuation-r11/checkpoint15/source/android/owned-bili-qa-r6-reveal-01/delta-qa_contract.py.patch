+# This source block is inserted verbatim into the new owned qa_contract.py.
+REVEAL_ACTIVITY=PACKAGE+'/com.bilibili.ship.theseus.detail.UnitedBizDetailsActivity'
+REVEAL_TITLE='7ff99f77d6b59f394c4c6c0ca167aded470663d4cef66215fcce841ed549afba'
+REVEAL_AUTHOR='3355707b07511199c7d280b9a77510b5e9b8698c7c7e4aedcf938805a3822d64'
+
