+def observe_target(fds, support, fd, before, operation, deadline):
+    sample = dict(complete=False, started_monotonic_ns=time.monotonic_ns())
+    operation['adjacent_observation'] = sample
+    try:
+        need(fd in fds.values and support.metadata(fd) == before, 'SAME_CONTENDER_OFD_HELD')
+        pid = os.getpid()
+        need(os.readlink('/proc/self') == str(pid), 'SELF_PROC_VIEW_GETPID_MATCH')
+        sample['collector_pid'] = pid
+        sample['kernel_release'] = os.uname().release
+        sample['flock_callable'] = dict(module=getattr(fcntl.flock, '__module__', None),
+                                        name=getattr(fcntl.flock, '__name__', None),
+                                        type=type(fcntl.flock).__name__)
+        raw, record = read_proc_record(fds, support, '/proc/' + str(pid) + '/fdinfo/' + str(fd),
+                                       FDINFO_MAX, deadline)
+        sample['own_fdinfo'] = record
+        sample['own_fdinfo']['parsed'] = parse_own_fdinfo(raw)
+        sample['own_fdinfo']['observed_monotonic_ns'] = time.monotonic_ns()
+        sample['table_read_attempted'] = True
+        raw, record = read_proc_record(fds, support, '/proc/locks', TABLE_MAX, deadline)
+        sample['table'] = record
+        sample['table']['parsed'] = parse_locks(raw)
+        sample['table']['observed_monotonic_ns'] = time.monotonic_ns()
+        raw, record = read_proc_record(fds, support, '/proc/' + str(pid) + '/mountinfo',
+                                       MOUNTINFO_MAX, deadline)
+        sample['mountinfo'] = record
+        sample['mountinfo']['selected'] = parse_selected_mount(raw, sample['own_fdinfo']['parsed']['fields']['mnt_id'])
+        # This is metadata of the collector's own namespace, not a process scan.
+        proc = open_fixed(fds, support, '/proc/' + str(pid), os.O_PATH | os.O_DIRECTORY, deadline)
+        try:
+            nsdir = fds.take(os.open('ns', os.O_PATH | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=proc))
