+def anonymous_once(fds, support, parent, operation, deadline):
+    fd = None
+    primary = None
+    try:
+        support.check_time(deadline)
+        operation['open_attempted'] = True
+        # Unlinked inode on the same held directory/filesystem. Never fallback.
+        fd = fds.take(os.open('.', os.O_TMPFILE | os.O_RDWR | os.O_CLOEXEC, 0o600, dir_fd=parent))
+        operation['opened'] = True
+        operation['held_before'] = support.metadata(fd)
+        before = operation['held_before']
+        need(stat.S_ISREG(before['mode']) and before['mode'] == LOCK_MODE and before['device'] == LOCK_DEV and
+             before['inode'] != LOCK_INO and (before['uid'], before['gid'], before['nlink']) == (0, 0, 0),
+             'ANONYMOUS_ROOT0600_UNLINKED_SAME_DEVICE_DISTINCT_INODE')
+        need(not os.get_inheritable(fd), 'ANONYMOUS_CLOEXEC')
+        support.check_time(deadline)
+        operation['exclusive_calls'] += 1
