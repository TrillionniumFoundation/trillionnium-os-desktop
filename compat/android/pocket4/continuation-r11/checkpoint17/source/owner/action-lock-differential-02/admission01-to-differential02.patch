+def parent_identity(value):
+    # Directory timestamps and link counts are recorded, not identity claims.
+    return tuple(value[name] for name in ('device', 'inode', 'mode', 'uid', 'gid'))
+
+
+def same_parent(fds, support, parent, before, deadline):
+    fd = open_fixed(fds, support, LOCK_PARENT, os.O_PATH | os.O_DIRECTORY, deadline)
+    try:
+        named = support.metadata(fd)
+        need(parent_identity(before) == parent_identity(support.metadata(parent)) == parent_identity(named),
+             'LOCK_PARENT_HELD_NAMED_IDENTITY_CHANGED')
+        return named
+    finally:
+        fds.close(fd)
+
+
+def read_proc_record(fds, support, path, maximum, deadline):
+    fd = open_fixed(fds, support, path, os.O_RDONLY | os.O_NONBLOCK, deadline)
+    try:
+        before = support.metadata(fd)
+        need(stat.S_ISREG(before['mode']) and before['device'] == PROC_DEV, 'FIXED_PROC_REGULAR_DEVICE')
+        raw = support.read_bounded(fd, maximum, deadline)
+        need(before == support.metadata(fd), 'HELD_PROC_SAMPLE_CHANGED')
+        return raw, dict(path=path, bytes=len(raw), sha256=sha(raw), metadata=before)
+    finally:
+        fds.close(fd)
+
+
+def parse_own_fdinfo(raw):
+    need(type(raw) is bytes and len(raw) <= FDINFO_MAX, 'OWN_FDINFO_BOUND')
+    lines = raw.splitlines()
+    need(0 < len(lines) <= 64, 'OWN_FDINFO_LINES')
+    values, locks = {}, []
+    for line in lines:
+        need(0 < len(line) <= LINE_MAX and b'\0' not in line, 'OWN_FDINFO_LINE')
+        name, separator, value = line.decode('ascii').partition(':')
+        need(separator == ':', 'OWN_FDINFO_KEY_VALUE')
+        value = value.strip()
+        if name == 'lock':
+            need(len(locks) < MATCH_MAX, 'OWN_FDINFO_LOCK_BOUND')
+            locks.append(value.encode('ascii'))
+        else:
+            need(name in ('pos', 'flags', 'mnt_id', 'ino') and name not in values, 'OWN_FDINFO_FIELDS')
+            need(re.fullmatch(r'[0-9]{1,24}', value), 'OWN_FDINFO_NUMBER')
+            values[name] = int(value, 8 if name == 'flags' else 10)
+    need(set(values) == {'pos', 'flags', 'mnt_id', 'ino'} and values['ino'] == LOCK_INO and
+         values['flags'] & os.O_ACCMODE == os.O_RDWR and values['mnt_id'] > 0, 'OWN_TARGET_FDINFO_IDENTITY')
+    parsed = parse_locks(b'\n'.join(locks))
+    need(len(parsed['matched_records']) == len(locks), 'OWN_FDINFO_LOCK_ROWS_MATCH_TARGET')
+    return dict(fields=values, matching_lock_records=parsed['matched_records'],
+                does_not_list_conflicting_other_OFD_locks=True)
+
