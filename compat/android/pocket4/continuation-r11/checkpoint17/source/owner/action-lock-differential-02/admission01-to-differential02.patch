+def validate_prior_admission(raw, prior):
+    need(type(raw) is bytes and len(raw) == PRIOR_ADMISSION_BYTES and sha(raw) == PRIOR_ADMISSION_SHA,
+         'EXACT_PRIOR_SINGLE_ADMISSION')
+    value = json.loads(raw)
+    op = value['lock_operation']
+    need(value['success'] is False and value['error']['phase'] == 'single_lock_admission' and
+         value['error']['errno'] == errno.EAGAIN and value['secondary_errors'] == [] and
+         value['owned_fds_closed'] is True and value['runtime_authorized'] is False,
+         'PRIOR_ADMISSION_ACTUAL_REFUSAL')
+    need(op['opened_existing'] is True and op['exclusive_calls'] == 1 and
+         op['exclusive_errno'] == errno.EAGAIN and op['acquired'] is False and op['unlock_calls'] == 0 and
+         op['close_attempted'] is True and op['close_confirmed'] is True, 'PRIOR_ONE_CALL_OWN_CLOSE')
+    need(value['lock_before'] == value['lock_after'] == value['lock_named_after'] and
+         value['inputs'] == value['final_inputs'] and value['boot_before'] == value['boot_after'] and
+         value['main_guard_before'] == value['main_guard_after'] == prior['Main_before_lock'],
+         'PRIOR_ALL_ORIGINAL_GUARDS')
+    exact_lock(value['lock_before'])
