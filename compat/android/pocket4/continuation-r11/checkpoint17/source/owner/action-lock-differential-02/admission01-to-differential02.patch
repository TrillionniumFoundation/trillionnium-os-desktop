+        parts = line.decode('ascii').split()
+        need(len(parts) >= 10, 'OWN_TARGET_MOUNTINFO_SHAPE')
+        need(len(selected) == 0 and parts.count('-') == 1, 'EXACT_ONE_TARGET_MOUNT')
+        separator = parts.index('-')
+        need(separator >= 6 and len(parts) == separator + 4 and
+             parts[2] == str(os.major(LOCK_DEV)) + ':' + str(os.minor(LOCK_DEV)),
+             'TARGET_MOUNT_DEVICE')
+        selected.append(dict(mount_id=mount_id, parent_id=int(parts[1]), device=parts[2],
+            root=parts[3], mountpoint=parts[4], mount_options=parts[5],
+            optional_fields=parts[6:separator], filesystem=parts[separator+1],
+            mount_source=parts[separator+2], super_options=parts[separator+3]))
