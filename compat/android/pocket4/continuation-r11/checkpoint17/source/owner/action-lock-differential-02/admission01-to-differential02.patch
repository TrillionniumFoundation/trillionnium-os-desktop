+def parse_locks(raw):
+    """Parse a bounded kernel table but return only the exact device/inode rows."""
+    need(type(raw) is bytes and len(raw) <= TABLE_MAX, 'LOCK_TABLE_BYTES_BOUND')
+    lines = raw.splitlines()
+    need(len(lines) <= TABLE_LINES_MAX, 'LOCK_TABLE_LINE_BOUND')
+    records = []
+    for number, line in enumerate(lines, 1):
+        need(0 < len(line) <= LINE_MAX and b'\0' not in line, 'LOCK_TABLE_LINE_FORMAT')
+        fields = line.decode('ascii', 'strict').split()
+        waiting = len(fields) > 1 and fields[1] == '->'
+        if waiting:
+            fields.pop(1)
+        need(len(fields) == 8 and re.fullmatch(r'[0-9]{1,20}:', fields[0]) is not None,
+             'LOCK_TABLE_FIELD_SHAPE')
+        need(all(re.fullmatch(r'[A-Z_]+', value) for value in fields[1:4]), 'LOCK_TABLE_TYPE_SHAPE')
+        need(re.fullmatch(r'-?[0-9]{1,10}', fields[4]) is not None, 'LOCK_TABLE_PID_SHAPE')
+        pid = int(fields[4])
+        need(-1 <= pid <= 2147483647, 'LOCK_TABLE_PID_BOUND')
+        match = re.fullmatch(r'([0-9a-fA-F]{1,16}):([0-9a-fA-F]{1,16}):([0-9]{1,20})', fields[5])
+        need(match is not None, 'LOCK_TABLE_DEVICE_SHAPE')
+        major, minor, inode = int(match[1], 16), int(match[2], 16), int(match[3])
+        need(inode <= 18446744073709551615, 'LOCK_TABLE_INODE_BOUND')
+        need(re.fullmatch(r'[0-9]{1,20}', fields[6]) is not None and
+             (fields[7] == 'EOF' or re.fullmatch(r'[0-9]{1,20}', fields[7]) is not None),
+             'LOCK_TABLE_RANGE_SHAPE')
+        if (major, minor, inode) != (os.major(LOCK_DEV), os.minor(LOCK_DEV), LOCK_INO):
+            continue
+        need(len(records) < MATCH_MAX, 'MATCHING_LOCK_RECORD_BOUND')
+        records.append(dict(record_id=int(fields[0][:-1]), waiting=waiting,
+                            kind=fields[1], mode=fields[2], access=fields[3],
+                            kernel_reported_pid=pid, device_major=major, device_minor=minor,
+                            inode=inode, range_start=fields[6], range_end=fields[7],
+                            raw_matching_line=line.decode('ascii')))
+    pids = sorted({r['kernel_reported_pid'] for r in records if r['kernel_reported_pid'] > 0})
+    need(len(pids) <= PID_MAX, 'MATCHING_POSITIVE_PID_BOUND')
+    return dict(bytes_read=len(raw), table_line_count=len(lines), matched_records=records,
+                matched_positive_pids=pids, complete=True)
+
