+def command_bytes(row, name):
+    part = row[name]
+    raw = base64.b64decode(part['base64'], validate=True)
+    need(len(raw) == part['bytes'] and hashlib.sha256(raw).hexdigest() == part['sha256'],
+         'owned command stream binding differs')
+    return raw
+
