+// The caller has already proved UID/GID 0 and the generation's private tmpfs.
+// Keep the actual mode operation separate so an ordinary owned-file control
+// can exercise the syscall and named-inode checks without inventing root proof.
+fn make_guest_searchable(parent: &File, name: &CStr, file: &File) -> io::Result<()> {
+    let before = file.metadata()?;
+    let named_before = domain::at(parent.as_raw_fd(), name, libc::O_RDONLY | libc::O_DIRECTORY, 0)?;
+    if !before.is_dir() || Identity::of(&named_before)? != Identity::of(file)? {
+        return Err(error("bootstrap guest directory changed before mode application"));
+    }
+    // Apply the explicit guest policy to the held inode, independently of the
+    // inherited process umask. Host package/data parents are never traversed
+    // or chmod'ed here. The payloads themselves remain pinned readonly binds.
+    if unsafe { libc::fchmod(file.as_raw_fd(), 0o755) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let after = file.metadata()?;
+    let named = domain::at(parent.as_raw_fd(), name, libc::O_RDONLY | libc::O_DIRECTORY, 0)?;
+    let named_metadata = named.metadata()?;
+    if after.dev() != before.dev() || after.ino() != before.ino()
+        || after.uid() != before.uid() || after.gid() != before.gid()
+        || after.mode() & 0o7777 != 0o755
+        || named_metadata.dev() != after.dev() || named_metadata.ino() != after.ino()
+        || named_metadata.uid() != after.uid() || named_metadata.gid() != after.gid()
+        || named_metadata.mode() & 0o7777 != 0o755
+    {
+        return Err(error("bootstrap guest directory changed during mode application"));
+    }
+    Ok(())
+}
