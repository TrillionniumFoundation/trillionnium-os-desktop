+fn bootstrap_directory(
+    root: &File,
+    parent: &File,
+    name: &str,
+    allow_existing: bool,
+) -> io::Result<File> {
+    // prepare_image is called only after mount_synthetic_system_root creates
+    // this generation's new tmpfs. Refuse an existing host/partition bind:
+    // changing its inode mode would also change the source outside the guest.
+    let root_metadata = root.metadata()?;
+    let mut filesystem: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::fstatfs(root.as_raw_fd(), &mut filesystem) } != 0 {
+        return Err(io::Error::last_os_error());
+    }
+    if filesystem.f_type != 0x0102_1994
+        || !root_metadata.is_dir()
+        || root_metadata.ino() != 1
+        || root_metadata.uid() != 0
+        || root_metadata.gid() != 0
+        || root_metadata.mode() & 0o7777 != 0o755
+    {
+        return Err(error("bootstrap root is not the owned synthetic tmpfs"));
+    }
+    let parent_metadata = parent.metadata()?;
+    if !parent_metadata.is_dir()
+        || parent_metadata.dev() != root_metadata.dev()
+        || parent_metadata.uid() != 0
+        || parent_metadata.gid() != 0
+        || parent_metadata.mode() & 0o7777 != 0o755
+    {
+        return Err(error("bootstrap parent is outside the owned guest tmpfs"));
+    }
+    let name = CString::new(name).map_err(|_| error("invalid fixed bootstrap directory"))?;
+    if name.as_bytes().is_empty() || name.as_bytes().contains(&b'/')
+        || name.as_bytes() == b"." || name.as_bytes() == b".."
+    {
+        return Err(error("bootstrap directory is not one fixed component"));
+    }
+    if unsafe { libc::mkdirat(parent.as_raw_fd(), name.as_ptr(), 0o755) } != 0 {
+        let first = io::Error::last_os_error();
+        if !allow_existing || first.kind() != io::ErrorKind::AlreadyExists {
+            return Err(first);
+        }
+    }
+    let file = domain::at(parent.as_raw_fd(), &name, libc::O_RDONLY | libc::O_DIRECTORY, 0)?;
+    let before = file.metadata()?;
+    if !before.is_dir()
+        || before.dev() != root_metadata.dev()
+        || before.ino() == root_metadata.ino()
+        || before.uid() != 0
+        || before.gid() != 0
+        || before.mode() & 0o7022 != 0
+        || before.mode() & 0o700 != 0o700
+    {
+        return Err(error("bootstrap directory is not exclusively owned guest storage"));
+    }
+    make_guest_searchable(parent, &name, &file)?;
+    if Identity::of(root)? != (Identity { device: root_metadata.dev(), inode: root_metadata.ino() })
+        || Identity::of(parent)? != (Identity { device: parent_metadata.dev(), inode: parent_metadata.ino() })
+    {
+        return Err(error("bootstrap guest parents changed during mode application"));
     }
