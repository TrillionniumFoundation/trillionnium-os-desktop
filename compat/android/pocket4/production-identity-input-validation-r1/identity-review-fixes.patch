+    }
+
+    fn arm_checked_inheritance(sealed: &SealedCellSpec, command: &mut Command) {
+        sealed.arm_child_inheritance(command);
+        let fd = sealed.file.as_raw_fd();
+        // SAFETY: the appended hook only queries kernel state. It also proves
+        // that the preceding ownership and FD hooks both remain installed.
+        unsafe {
+            command.pre_exec(move || {
+                let mut signal: libc::c_int = 0;
+                if libc::prctl(libc::PR_GET_PDEATHSIG, &mut signal as *mut libc::c_int) != 0
+                    || signal != libc::SIGKILL
+                    || libc::fcntl(fd, libc::F_GETFD) & libc::FD_CLOEXEC != 0
+                {
+                    return Err(io::Error::from_raw_os_error(libc::EINVAL));
+                }
+                Ok(())
+            });
+        }
+    }
+
+    fn wait_bounded(child: &mut Child) -> std::process::ExitStatus {
+        let deadline = Instant::now() + Duration::from_secs(3);
+        loop {
+            if let Some(status) = child.try_wait().unwrap() {
+                return status;
+            }
+            if Instant::now() >= deadline {
+                let kill = child.kill();
+                let reap = child.wait();
+                panic!("owned child exceeded deadline; kill={kill:?}; reap={reap:?}");
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
+
+    struct ReapChild(Option<Child>);
+
+    impl Drop for ReapChild {
+        fn drop(&mut self) {
+            if let Some(child) = self.0.as_mut() {
+                let _ = child.kill();
+                let _ = child.wait();
+            }
+        }
+    }
+
+    fn output_bounded(child: Child) -> Output {
+        let mut owned = ReapChild(Some(child));
+        let child = owned.0.as_mut().unwrap();
+        let status = wait_bounded(child);
+        let mut stdout = Vec::new();
+        let mut stderr = Vec::new();
+        child
+            .stdout
+            .take()
+            .unwrap()
+            .read_to_end(&mut stdout)
+            .unwrap();
+        child
+            .stderr
+            .take()
+            .unwrap()
+            .read_to_end(&mut stderr)
+            .unwrap();
+        Output {
+            status,
+            stdout,
+            stderr,
+        }
+    }
+
+    fn run_child(sealed: &SealedCellSpec, binding: &str, mode: &str) -> Output {
+        let mut command = child_command(binding, mode);
+        arm_checked_inheritance(sealed, &mut command);
+        output_bounded(command.spawn().unwrap())
+    }
