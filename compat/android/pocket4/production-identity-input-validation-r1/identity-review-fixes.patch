+    #[test]
+    fn fifo_authority_is_rejected_without_waiting_for_a_writer() {
+        let f = Fixture::new();
+        fs::remove_file(&f.paths.subuid).unwrap();
+        let fifo_name = CString::new(f.paths.subuid.as_os_str().as_encoded_bytes()).unwrap();
+        // SAFETY: a terminated path inside this exclusively owned fixture.
+        assert_eq!(unsafe { libc::mkfifo(fifo_name.as_ptr(), 0o600) }, 0);
+        let paths = f.paths.clone();
+        let (sender, receiver) = std::sync::mpsc::sync_channel(1);
+        let worker = std::thread::spawn(move || {
+            let result = IdentityAuthority::read_paths(
+                1000,
+                IdRange {
+                    start: 200_000,
+                    count: 100_000,
+                },
+                IdRange {
+                    start: 200_000,
+                    count: 100_000,
+                },
+                paths,
+            );
+            sender.send(result).unwrap();
+        });
+        let observed = receiver.recv_timeout(std::time::Duration::from_secs(1));
+        match observed {
+            Ok(result) => {
+                worker.join().unwrap();
+                assert!(matches!(result, Err(IdentityError::UnsafeCustody(_))));
+            }
+            Err(std::sync::mpsc::RecvTimeoutError::Timeout) => {
+                // Release a regressed blocking open before joining, so a
+                // failure does not leave a thread or fixture behind.
+                let writer = OpenOptions::new()
+                    .write(true)
+                    .custom_flags(libc::O_NONBLOCK)
+                    .open(&f.paths.subuid)
+                    .unwrap();
+                worker.join().unwrap();
+                drop(writer);
+                panic!("identity authority waited for a FIFO writer");
+            }
+            Err(std::sync::mpsc::RecvTimeoutError::Disconnected) => {
+                worker.join().unwrap();
+                panic!("identity authority reader exited without a result");
+            }
+        }
+        assert!(!f.root.path().join("registry").exists());
+    }
