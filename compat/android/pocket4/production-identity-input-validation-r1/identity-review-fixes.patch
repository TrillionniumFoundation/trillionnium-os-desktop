+        for (name, expected) in names.iter().zip(before) {
+            assert_eq!(
+                fs::read_link(format!("/proc/self/ns/{name}")).unwrap(),
+                expected
+            );
+        }
+        println!(
+            "sealed wrapper: actual ip -> unshare -> entry consumed; both owned owners reaped and init pidfds exited; parent namespaces unchanged; Android not started"
+        );
+    }
+}
