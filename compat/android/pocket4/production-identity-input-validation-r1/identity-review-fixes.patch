+    fn child_command(binding: &str, mode: &str) -> Command {
+        let mut command = Command::new(std::env::current_exe().unwrap());
+        command.args([
+            "--exact",
+            "sealed_spec::tests::inherited_child_probe",
+            "--ignored",
+            "--nocapture",
+            "--test-threads=1",
