@@ -0,0 +1,40 @@
+//! Explicit qualification probe: consumes sealed input, never enters Android.
+//! Compile against the exact reviewed droidloom-supervisor rlib with Rust 1.93.
+#![deny(unsafe_op_in_unsafe_fn)]
+
+use std::io::{Read, Write};
+use std::path::PathBuf;
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let arguments: Vec<_> = std::env::args().collect();
+    if arguments.len() != 4
+        || arguments[1] != "development-enter"
+        || arguments[2] != "--sealed-spec"
+    {
+        return Err("private sealed probe arguments required".into());
+    }
+    let fd: i32 = std::env::var("DROIDLOOM_SEALED_PROBE_FD")?.parse()?;
+    // SAFETY: this fresh executable has never adopted the inherited raw slot
+    // into a Rust owner. No other thread or handler can close or replace it.
+    let spec = unsafe { droidloom_supervisor::sealed_spec::consume_inherited_spec(&arguments[3])? };
+    if spec.render_node != PathBuf::from("/dev/dri/renderD128") {
+        return Err("the original admitted configuration was substituted".into());
+    }
+    match std::fs::symlink_metadata(format!("/proc/self/fd/{fd}")) {
+        Err(error) if error.raw_os_error() == Some(2) => {}
+        _ => return Err("the original inherited descriptor was not consumed".into()),
+    }
+    let proof = std::env::var_os("DROIDLOOM_SEALED_PROBE_PROOF").ok_or("proof path required")?;
+    std::fs::write(
+        proof,
+        b"SEALED_WRAPPER_CONSUMED;original_renderD128;original_fd_closed\n",
+    )?;
+    std::io::stdout().write_all(b"SEALED_WRAPPER_CONSUMED\n")?;
+    std::io::stdout().flush()?;
+    let mut release = [0u8; 1];
+    std::io::stdin().read_exact(&mut release)?;
+    if release != [b'x'] {
+        return Err("parent release marker differs".into());
+    }
+    Ok(())
+}
