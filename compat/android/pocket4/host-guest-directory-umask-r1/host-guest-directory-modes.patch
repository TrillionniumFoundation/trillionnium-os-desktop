+fn arm_android_first_stage_umask(command: &mut Command) {
+    // AOSP FirstStageMain clears umask before creating Android runtime files.
+    // We enter second stage directly, so restore that contract only at the
+    // final exec in the private namespace's PID 1. Host preparation retains
+    // its original restrictive umask, including all control and state files.
+    unsafe {
