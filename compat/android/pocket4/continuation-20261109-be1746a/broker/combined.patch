+fn spec_read_error(error: crate::CellSpecReadError) -> ControlError {
+    match error {
+        crate::CellSpecReadError::Io(source) => io_error("read cell specification", source),
+        crate::CellSpecReadError::Invalid(message) => ControlError::Invalid(message),
+        crate::CellSpecReadError::Json(source) => ControlError::Protocol(source),
+    }
+}
+
+fn open_spec_directory(path: &Path) -> Result<fs::File, ControlError> {
+    use std::os::unix::fs::OpenOptionsExt;
+    fs::OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_NONBLOCK)
+        .open(path)
+        .map_err(|source| io_error("open trusted specification directory", source))
+}
+
+fn directory_child_path(parent: &fs::File, name: &std::ffi::OsStr) -> PathBuf {
+    // The live File owns this descriptor throughout the open below. Only a
+    // single normal component is appended to the kernel's own procfd link.
+    Path::new("/proc/self/fd")
+        .join(parent.as_raw_fd().to_string())
+        .join(name)
+}
+
+fn open_absolute_spec_directory(path: &Path) -> Result<fs::File, ControlError> {
+    if !path.is_absolute() {
+        return Err(ControlError::Invalid(
+            "absolute trusted directory required".into(),
+        ));
+    }
+    let mut held = open_spec_directory(Path::new("/"))?;
+    for part in path.components() {
+        match part {
+            std::path::Component::RootDir => {}
+            std::path::Component::Normal(name) => {
+                held = open_spec_directory(&directory_child_path(&held, name))?;
+            }
+            _ => {
+                return Err(ControlError::Invalid(
+                    "non-canonical trusted directory".into(),
+                ));
+            }
+        }
+    }
+    Ok(held)
+}
+
+fn open_authorized_spec(
+    peer_uid: u32,
+    path: &Path,
+    spec_directory: &Path,
+) -> Result<crate::OpenedCellSpec, ControlError> {
+    if peer_uid == 0 {
+        return crate::OpenedCellSpec::open(path, false).map_err(spec_read_error);
+    }
+    use std::os::unix::ffi::OsStrExt;
+    if path.as_os_str().as_bytes().ends_with(b"/") {
+        return Err(ControlError::Invalid(
+            "a specification file is required".into(),
+        ));
+    }
+    let leaf = path
+        .file_name()
+        .ok_or_else(|| ControlError::Invalid("a specification file is required".into()))?;
+    let parent = path
+        .parent()
+        .filter(|value| !value.as_os_str().is_empty())
+        .unwrap_or(Path::new("."));
+    let canonical_parent = fs::canonicalize(parent)
+        .map_err(|source| io_error("resolve specification parent", source))?;
+    let canonical_directory = fs::canonicalize(spec_directory)
+        .map_err(|source| io_error("resolve trusted specification directory", source))?;
+    let relative = canonical_parent
+        .strip_prefix(&canonical_directory)
+        .map_err(|_| {
+            ControlError::Invalid(format!(
+                "non-root clients may use only root-owned, non-writable specifications below {}",
+                spec_directory.display()
+            ))
+        })?;
+    // Open the admitted directory once, then walk only relative held-directory
+    // descendants. Parent symlink aliases accepted by canonicalize retain their
+    // normal semantics; replacement symlinks after that point are refused.
+    let mut held = open_absolute_spec_directory(&canonical_directory)?;
+    for part in relative.components() {
+        let std::path::Component::Normal(name) = part else {
+            return Err(ControlError::Invalid(
+                "non-canonical specification parent".into(),
+            ));
+        };
+        held = open_spec_directory(&directory_child_path(&held, name))?;
+    }
+    let opened = crate::OpenedCellSpec::open(&directory_child_path(&held, leaf), true)
+        .map_err(spec_read_error)?;
+    let metadata = opened.metadata();
+    if metadata.uid() != 0 || metadata.mode() & 0o022 != 0 {
         return Err(ControlError::Invalid(format!(
-            "cell specification is {} bytes; maximum is {MAX_SPEC_BYTES}",
-            metadata.len()
+            "non-root clients may use only root-owned, non-writable specifications below {}",
+            spec_directory.display()
