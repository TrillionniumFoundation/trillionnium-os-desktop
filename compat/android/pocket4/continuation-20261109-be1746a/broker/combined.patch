+    #[cfg(test)]
+    GroupsSet = 10,
+    #[cfg(test)]
+    ClearGroups = 11,
+    #[cfg(test)]
+    GroupsCleared = 12,
+}
+
+#[derive(Clone, Copy)]
+#[repr(u32)]
+pub(super) enum Mode {
+    UserNamespace = 0,
+    #[cfg(test)]
+    ParkOnly = 1,
+    #[cfg(test)]
+    ExitBeforeCreated = 2,
+    #[cfg(test)]
+    WrongNonce = 3,
+    #[cfg(test)]
+    WithholdReady = 4,
+    #[cfg(test)]
+    GroupControl = 5,
+    #[cfg(test)]
+    SignalRestoreFailure = 6,
+    #[cfg(test)]
+    CreatorGoneBeforeArm = 7,
+    #[cfg(test)]
+    CreatorGoneBeforeRearm = 8,
+}
