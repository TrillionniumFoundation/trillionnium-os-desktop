+
+const REQUIRED_SEALS: i32 =
+    libc::F_SEAL_WRITE | libc::F_SEAL_GROW | libc::F_SEAL_SHRINK | libc::F_SEAL_SEAL;
+const MAX_BINDING_BYTES: usize = 1024;
+
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Binding {
+    version: u32,
+    fd: RawFd,
+    device: u64,
+    inode: u64,
+    bytes: u64,
+    sha256: String,
+}
+
+/// Own the only parent-side handle until the namespace launcher has spawned.
+pub(crate) struct SealedCellSpec {
+    file: File,
+    binding: Binding,
+}
+
+fn invalid(message: impl Into<String>) -> CellSpecReadError {
+    CellSpecReadError::Invalid(message.into())
+}
+
+fn fd_value(fd: RawFd, operation: i32) -> io::Result<i32> {
+    // SAFETY: fcntl queries operate on a numeric descriptor, return errors for
+    // invalid descriptors, and do not take a variadic pointer argument.
+    let value = unsafe { libc::fcntl(fd, operation) };
+    if value < 0 {
+        Err(io::Error::last_os_error())
+    } else {
+        Ok(value)
+    }
+}
+
+impl SealedCellSpec {
+    pub(crate) fn new(spec: &CellSpec) -> Result<Self, CellSpecReadError> {
+        spec.validate()
+            .map_err(|error| invalid(error.to_string()))?;
+        let bytes = serde_json::to_vec(spec)?;
+        if bytes.len() as u64 > MAX_CELL_SPEC_BYTES {
+            return Err(invalid("serialized cell specification exceeds maximum"));
+        }
+        // SAFETY: the C string is static and terminated. These flags create a
+        // new anonymous file with CLOEXEC and explicit seal support.
+        let fd = unsafe {
+            libc::memfd_create(
+                c"droidloom-cell-spec-v1".as_ptr(),
+                libc::MFD_CLOEXEC | libc::MFD_ALLOW_SEALING,
+            )
+        };
+        if fd < 0 {
+            return Err(io::Error::last_os_error().into());
+        }
+        // SAFETY: successful memfd_create returns a new owned descriptor.
+        let mut file = unsafe { File::from_raw_fd(fd) };
+        if file.as_raw_fd() < 3 {
+            // Reserve a non-stdio slot without ever making the parent inheritable.
+            // SAFETY: F_DUPFD_CLOEXEC duplicates this live file into a fresh slot.
+            let duplicate = unsafe { libc::fcntl(file.as_raw_fd(), libc::F_DUPFD_CLOEXEC, 3) };
+            if duplicate < 0 {
+                return Err(io::Error::last_os_error().into());
+            }
+            // SAFETY: the successful duplication returned a fresh descriptor.
+            file = unsafe { File::from_raw_fd(duplicate) };
+        }
+        file.set_permissions(Permissions::from_mode(0o600))?;
+        file.write_all(&bytes)?;
+        // SAFETY: F_ADD_SEALS takes an integer bitmask, not a pointer. WRITE
+        // must succeed; FUTURE_WRITE is not accepted as an equivalent.
+        if unsafe { libc::fcntl(file.as_raw_fd(), libc::F_ADD_SEALS, REQUIRED_SEALS) } < 0 {
+            return Err(io::Error::last_os_error().into());
+        }
+        if fd_value(file.as_raw_fd(), libc::F_GET_SEALS)? & REQUIRED_SEALS != REQUIRED_SEALS
+            || fd_value(file.as_raw_fd(), libc::F_GETFD)? & libc::FD_CLOEXEC == 0
+        {
+            return Err(invalid("sealed specification flags were not installed"));
+        }
+        let metadata = file.metadata()?;
+        let binding = Binding {
+            version: 1,
+            fd: file.as_raw_fd(),
+            device: metadata.dev(),
+            inode: metadata.ino(),
+            bytes: bytes.len() as u64,
+            sha256: format!("{:x}", Sha256::digest(&bytes)),
+        };
+        Ok(Self { file, binding })
+    }
+
+    pub(crate) fn argument(&self) -> Result<String, CellSpecReadError> {
+        Ok(serde_json::to_string(&self.binding)?)
+    }
+
+    pub(crate) fn arm_child_inheritance(&self, command: &mut Command) {
+        let fd = self.file.as_raw_fd();
+        let device = self.binding.device;
+        let inode = self.binding.inode;
+        let bytes = self.binding.bytes;
+        // SAFETY: this hook runs after fork and only makes async-signal-safe
+        // fcntl/fstat calls using stack values. The caller retains this File
+        // through spawn. pre_exec appends to existing ownership/PDEATHSIG hooks.
+        unsafe {
+            command.pre_exec(move || {
+                let flags = libc::fcntl(fd, libc::F_GETFD);
+                let seals = libc::fcntl(fd, libc::F_GET_SEALS);
+                let mut metadata = std::mem::MaybeUninit::<libc::stat>::uninit();
+                if flags < 0
+                    || flags & libc::FD_CLOEXEC == 0
+                    || seals < 0
+                    || seals & REQUIRED_SEALS != REQUIRED_SEALS
+                    || libc::fstat(fd, metadata.as_mut_ptr()) != 0
+                {
+                    return Err(io::Error::from_raw_os_error(libc::EINVAL));
+                }
+                let metadata = metadata.assume_init();
+                if metadata.st_dev != device
+                    || metadata.st_ino != inode
+                    || metadata.st_size < 0
+                    || metadata.st_size as u64 != bytes
+                {
+                    return Err(io::Error::from_raw_os_error(libc::EINVAL));
+                }
+                // This is the child's private descriptor table. The parent
+                // retains CLOEXEC throughout this operation.
+                if libc::fcntl(fd, libc::F_SETFD, flags & !libc::FD_CLOEXEC) < 0 {
+                    return Err(io::Error::last_os_error());
+                }
+                Ok(())
+            });
+        }
+    }
+}
+
+/// Consume the sealed descriptor inherited by the root-only private entry.
+///
+/// This is a process-bootstrap operation for development-enter. Successful
+/// consumption closes the descriptor named by the binding before Android init
+/// or its construction helpers can inherit it. The token does not itself grant
+/// authority: the receiving process must already have effective UID zero.
+///
+/// # Safety
+///
+/// The original inherited slot must be exclusively transferred to this
+/// bootstrap: it has no Rust owner and no other thread or handler may close,
+/// replace, or adopt that slot until this call finishes.
+/// On success ownership of that slot is consumed; on error it is unchanged.
+pub unsafe fn consume_inherited_spec(encoded: &str) -> Result<CellSpec, CellSpecReadError> {
+    // SAFETY: geteuid is a read-only, argument-free credential query.
+    if unsafe { libc::geteuid() } != 0 {
+        return Err(invalid(
+            "sealed cell specifications require a root namespace entry",
+        ));
+    }
+    if encoded.len() > MAX_BINDING_BYTES {
+        return Err(invalid("sealed specification binding exceeds maximum"));
+    }
+    let binding: Binding = serde_json::from_str(encoded)?;
+    if binding.version != 1
+        || binding.fd < 3
+        || binding.bytes == 0
+        || binding.bytes > MAX_CELL_SPEC_BYTES
+        || binding.sha256.len() != 64
+        || !binding
+            .sha256
+            .bytes()
+            .all(|byte| byte.is_ascii_digit() || (b'a'..=b'f').contains(&byte))
+    {
+        return Err(invalid("invalid sealed specification binding"));
+    }
+    if fd_value(binding.fd, libc::F_GETFD)? & libc::FD_CLOEXEC != 0 {
+        return Err(invalid(
+            "sealed specification descriptor was not inherited for exec",
+        ));
+    }
+    // SAFETY: duplication creates an independent owned CLOEXEC descriptor.
+    // Failure does not close or change the caller-selected original.
+    let duplicate = unsafe { libc::fcntl(binding.fd, libc::F_DUPFD_CLOEXEC, 3) };
+    if duplicate < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    // SAFETY: successful fcntl returned a new owned descriptor.
+    let file = unsafe { File::from_raw_fd(duplicate) };
+    let before = file.metadata()?;
+    if !before.is_file()
+        || before.uid() != 0
+        || before.mode() & 0o7777 != 0o600
+        || (before.dev(), before.ino(), before.len())
+            != (binding.device, binding.inode, binding.bytes)
+        || fd_value(file.as_raw_fd(), libc::F_GET_SEALS)? & REQUIRED_SEALS != REQUIRED_SEALS
+        || fd_value(file.as_raw_fd(), libc::F_GETFD)? & libc::FD_CLOEXEC == 0
+    {
+        return Err(invalid(
+            "inherited specification descriptor identity or seals differ",
+        ));
+    }
+    // pread never consumes the offset shared with the parent/launcher. All
+    // buffers and offsets are bounded even if the declared length is hostile.
+    let mut bytes = Vec::with_capacity(binding.bytes as usize + 1);
+    let mut buffer = [0u8; 8192];
+    loop {
+        let remaining = binding.bytes as usize + 1 - bytes.len();
+        if remaining == 0 {
+            break;
+        }
+        let width = remaining.min(buffer.len());
+        let count = file.read_at(&mut buffer[..width], bytes.len() as u64)?;
+        if count == 0 {
+            break;
+        }
+        bytes.extend_from_slice(&buffer[..count]);
+    }
+    if bytes.len() as u64 != binding.bytes
+        || format!("{:x}", Sha256::digest(&bytes)) != binding.sha256
+        || !crate::same_spec_metadata(&before, &file.metadata()?)
+    {
+        return Err(invalid(
+            "inherited specification content differs from its binding",
+        ));
+    }
+    let spec = crate::read_cell_spec(bytes.as_slice())?;
+    spec.validate()
+        .map_err(|error| invalid(error.to_string()))?;
+    // Recheck the named inherited slot before consuming it. This bootstrap
+    // receiver exclusively owns this slot; the separately owned duplicate remains live.
+    // SAFETY: fstat writes one initialized stat object for the original FD.
+    let mut original = std::mem::MaybeUninit::<libc::stat>::uninit();
+    if unsafe { libc::fstat(binding.fd, original.as_mut_ptr()) } != 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    // SAFETY: successful fstat initialized the complete object.
+    let original = unsafe { original.assume_init() };
+    if original.st_dev != before.dev() || original.st_ino != before.ino() {
+        return Err(invalid(
+            "inherited specification slot changed before consumption",
+        ));
+    }
+    // SAFETY: this private-entry protocol transfers ownership of the verified
+    // inherited slot to the bootstrap receiver. No Rust File owns that slot in
+    // this freshly exec'd process. Its duplicate is separately owned above.
+    drop(unsafe { File::from_raw_fd(binding.fd) });
+    Ok(spec)
+}
