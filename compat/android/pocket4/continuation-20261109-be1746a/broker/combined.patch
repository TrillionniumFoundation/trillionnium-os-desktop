+//! Immutable configuration handoff for the private development namespace entry.
+//!
+//! This protocol freezes an already authorized CellSpec. It creates no Android
+//! namespace, ID mapping, mount, account, or production runtime authority.
+
+use std::fs::{File, Permissions};
+use std::io::{self, Write};
+use std::os::fd::{AsRawFd, FromRawFd, RawFd};
+use std::os::unix::fs::{FileExt, MetadataExt, PermissionsExt};
+use std::os::unix::process::CommandExt;
