+/// Maximum bytes accepted for a cell specification, including JSON whitespace.
+pub const MAX_CELL_SPEC_BYTES: u64 = 1024 * 1024;
+
+/// A bounded specification read failed before any runtime activation.
+#[derive(Debug, Error)]
+pub enum CellSpecReadError {
+    /// A file operation failed.
+    #[error(transparent)]
+    Io(#[from] std::io::Error),
+    /// The input did not meet the regular-file, size, or stability contract.
+    #[error("{0}")]
+    Invalid(String),
+    /// The input was not a compatible JSON cell specification.
+    #[error(transparent)]
+    Json(#[from] serde_json::Error),
+}
+
+/// Read bounded JSON from an already selected stream.
+///
+/// This only decodes a CellSpec. File custody, peer authorization, and semantic
+/// validation remain the caller's responsibilities.
+pub fn read_cell_spec(reader: impl std::io::Read) -> Result<CellSpec, CellSpecReadError> {
+    use std::io::Read;
+    let mut bytes = Vec::new();
+    reader
+        .take(MAX_CELL_SPEC_BYTES + 1)
+        .read_to_end(&mut bytes)?;
+    if bytes.len() as u64 > MAX_CELL_SPEC_BYTES {
+        return Err(CellSpecReadError::Invalid(format!(
+            "cell specification exceeds maximum of {MAX_CELL_SPEC_BYTES} bytes"
+        )));
+    }
+    Ok(serde_json::from_slice(&bytes)?)
+}
+
+/// Open and read one regular, bounded, stable specification inode.
+///
+/// Ordinary symlink paths remain accepted. Daemon requests add their existing
+/// trusted-directory and root-ownership policy to the same held descriptor.
+pub fn load_cell_spec(path: &Path) -> Result<CellSpec, CellSpecReadError> {
+    OpenedCellSpec::open(path, false)?.read()
+}
+
+pub(crate) struct OpenedCellSpec {
+    file: std::fs::File,
+    metadata: std::fs::Metadata,
+}
+
+impl OpenedCellSpec {
+    pub(crate) fn open(path: &Path, no_follow: bool) -> Result<Self, CellSpecReadError> {
+        use std::os::unix::fs::OpenOptionsExt;
+        let file = std::fs::OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NONBLOCK | if no_follow { libc::O_NOFOLLOW } else { 0 })
+            .open(path)?;
+        let metadata = file.metadata()?;
+        if !metadata.is_file() {
+            return Err(CellSpecReadError::Invalid(
+                "cell specification must be a regular file".into(),
+            ));
+        }
+        if metadata.len() > MAX_CELL_SPEC_BYTES {
+            return Err(CellSpecReadError::Invalid(format!(
+                "cell specification is {} bytes; maximum is {MAX_CELL_SPEC_BYTES}",
+                metadata.len()
+            )));
+        }
+        Ok(Self { file, metadata })
+    }
+
+    pub(crate) fn metadata(&self) -> &std::fs::Metadata {
+        &self.metadata
+    }
+
+    pub(crate) fn read(mut self) -> Result<CellSpec, CellSpecReadError> {
+        if !same_spec_metadata(&self.metadata, &self.file.metadata()?) {
+            return Err(CellSpecReadError::Invalid(
+                "cell specification changed after it was opened".into(),
+            ));
+        }
+        let spec = read_cell_spec(&mut self.file)?;
+        if !same_spec_metadata(&self.metadata, &self.file.metadata()?) {
+            return Err(CellSpecReadError::Invalid(
+                "cell specification changed while it was read".into(),
+            ));
+        }
+        Ok(spec)
+    }
+}
+
+fn same_spec_metadata(left: &std::fs::Metadata, right: &std::fs::Metadata) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    left.dev() == right.dev()
+        && left.ino() == right.ino()
+        && left.mode() == right.mode()
+        && left.uid() == right.uid()
+        && left.gid() == right.gid()
+        && left.nlink() == right.nlink()
+        && left.len() == right.len()
+        && (left.mtime(), left.mtime_nsec()) == (right.mtime(), right.mtime_nsec())
+        && (left.ctime(), left.ctime_nsec()) == (right.ctime(), right.ctime_nsec())
