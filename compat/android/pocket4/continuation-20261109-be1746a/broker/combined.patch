+                "--ignored",
+                "--nocapture",
+                "--test-threads=1",
+            ])
+            .env("DROIDLOOM_SEALED_WRAPPER_DIR", directory.path())
+            .env("DROIDLOOM_SEALED_WRAPPER_PROBE", &probe)
+            .env("DROIDLOOM_SEALED_PARENT_MNT", &before[0])
+            .stdin(Stdio::piped());
+        arm_development_parent_death(&mut command);
+        let child = command.spawn().unwrap();
+        let mut owned = OwnedSealedNamespace { child, init: None };
+        owned.init =
+            Some(OwnedNamespaceChild::capture(&mut owned.child, Duration::from_secs(3)).unwrap());
+        owned.child.stdin.as_mut().unwrap().write_all(b"x").unwrap();
+        assert!(finish_sealed_namespace(&mut owned).success());
+        assert_eq!(
+            fs::read(directory.path().join("wrapper-retired")).unwrap(),
+            b"owned_wrapper_reaped;owned_init_pidfd_exited;private_netns_removed\n"
+        );
+        for (name, expected) in names.iter().zip(before) {
+            assert_eq!(
+                fs::read_link(format!("/proc/self/ns/{name}")).unwrap(),
+                expected
+            );
+        }
+        println!(
+            "sealed wrapper: actual ip -> unshare -> entry consumed; both owned owners reaped and init pidfds exited; parent namespaces unchanged; Android not started"
+        );
+    }
+}
