+    #[ignore = "requires actual root; checks actual creator death and reaps its child"]
+    fn sealed_root_creator_death_kills_and_reaps_inherited_child() {
+        assert_eq!(unsafe { libc::geteuid() }, 0);
+        let worker = std::thread::spawn(|| {
+            let sealed = SealedCellSpec::new(&spec()).unwrap();
+            let mut command = child_command(&sealed.argument().unwrap(), "wait");
+            arm_checked_inheritance(&sealed, &mut command);
+            let mut owned = ReapChild(Some(command.spawn().unwrap()));
+            let child = owned.0.as_mut().unwrap();
+            let stdout = child.stdout.take().unwrap();
+            let mut reader = BufReader::new(stdout);
+            let deadline = Instant::now() + Duration::from_secs(3);
+            loop {
+                let mut descriptor = libc::pollfd {
+                    fd: reader.get_ref().as_raw_fd(),
+                    events: libc::POLLIN,
+                    revents: 0,
+                };
+                let ready = if reader.buffer().is_empty() {
+                    unsafe { libc::poll(&mut descriptor, 1, 100) }
+                } else {
+                    1
+                };
+                if ready > 0 {
+                    let mut line = String::new();
+                    if reader.read_line(&mut line).unwrap() == 0 {
+                        let status = wait_bounded(child);
+                        panic!("child exited before ready: {status}");
+                    }
+                    if line.contains("SEALED_CONSUMED") {
+                        break;
+                    }
+                }
+                if Instant::now() >= deadline {
+                    let kill = child.kill();
+                    let reap = child.wait();
+                    panic!("child did not become ready: kill={kill:?}; reap={reap:?}");
+                }
+            }
+            // Linux ties PDEATHSIG to the creating thread. Returning this
+            // exact Child to the joining test lets that thread disappear while
+            // the test still owns and positively reaps the resulting process.
+            owned.0.take().unwrap()
+        });
+        let mut child = worker.join().unwrap();
+        let status = wait_bounded(&mut child);
+        assert_eq!(status.signal(), Some(libc::SIGKILL));
+    }
+}
