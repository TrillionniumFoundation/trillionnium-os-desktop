+            fd_value(fd, libc::F_GET_SEALS).unwrap() & REQUIRED_SEALS,
+            REQUIRED_SEALS
+        );
+        assert_ne!(fd_value(fd, libc::F_GETFD).unwrap() & libc::FD_CLOEXEC, 0);
+        assert_eq!(
