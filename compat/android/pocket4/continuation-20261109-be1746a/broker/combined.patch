+    #[test]
+    #[ignore = "requires root and owned private namespaces; consumes input without Android"]
+    fn sealed_root_real_namespace_wrapper_chain_consumes_and_retires() {
+        use std::io::Write;
+        use std::process::Stdio;
+        assert_eq!(unsafe { libc::geteuid() }, 0);
+        let probe = PathBuf::from(
+            std::env::var_os("DROIDLOOM_SEALED_WRAPPER_PROBE")
+                .expect("compile the pinned sealed-entry-probe.rs fixture first"),
+        );
+        assert!(probe.is_file());
+        let directory = tempfile::tempdir().unwrap();
+        let names = ["mnt", "net", "pid", "ipc", "uts", "cgroup"];
+        let before: Vec<_> = names
+            .iter()
+            .map(|name| fs::read_link(format!("/proc/self/ns/{name}")).unwrap())
+            .collect();
+        let mut command = Command::new("unshare");
+        command
+            .args(DEVELOPMENT_UNSHARE_ARGUMENTS)
+            .arg("--net")
+            .arg(std::env::current_exe().unwrap())
+            .args([
