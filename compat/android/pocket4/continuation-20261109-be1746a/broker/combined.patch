+    #[ignore = "private exec child; invoked only by the bounded parent controls"]
+    fn inherited_child_probe() {
+        let binding = std::env::var("DROIDLOOM_SEALED_TEST_BINDING").unwrap();
+        let mode = std::env::var("DROIDLOOM_SEALED_TEST_MODE").unwrap();
+        let raw: Binding = serde_json::from_str(&binding).unwrap();
+        if mode == "reject-nonroot" {
+            assert_ne!(
+                unsafe { libc::geteuid() },
+                0,
+                "non-root control must use real non-root"
+            );
+        } else {
+            assert_eq!(
+                unsafe { libc::geteuid() },
+                0,
+                "root receiver control must use real root"
+            );
+        }
+        // SAFETY: this probe is a fresh executable. Its selected inherited
+        // slot has no Rust owner, matching the private-entry contract.
+        let result = unsafe { consume_inherited_spec(&binding) };
+        if mode == "reject-nonroot" {
+            assert!(
+                result
+                    .unwrap_err()
+                    .to_string()
+                    .contains("root namespace entry")
+            );
+            println!("SEALED_NONROOT_REJECTED");
+            return;
+        }
+        if mode == "reject" {
+            assert!(result.is_err(), "untrusted descriptor/binding was accepted");
+            println!("SEALED_REJECTED");
+            return;
+        }
+        let actual = result.unwrap();
+        assert_eq!(
+            actual,
+            spec(),
+            "path replacement or inherited offset changed the admitted bytes"
+        );
+        assert_eq!(
+            fd_value(raw.fd, libc::F_GETFD).unwrap_err().raw_os_error(),
+            Some(libc::EBADF)
+        );
+        println!("SEALED_CONSUMED");
+        io::stdout().flush().unwrap();
+        if mode == "exit-23" {
+            std::process::exit(23);
+        }
+        if mode == "wait" {
+            let mut byte = [0u8; 1];
+            let _ = io::stdin().read_exact(&mut byte);
+        }
+    }
