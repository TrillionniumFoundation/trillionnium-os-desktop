+const MAGIC: u64 = 0x444c_4e53_4252_4b31;
+const CHILD_FD: RawFd = 3;
+const CREATOR_FD: RawFd = 4;
+// include/uapi/linux/pidfd.h: PIDFD_THREAD = O_EXCL (Linux >= 6.9).
+const PIDFD_THREAD: i32 = libc::O_EXCL;
+
+#[derive(Clone, Copy)]
+#[repr(u32)]
+pub(super) enum Phase {
+    Created = 1,
+    Enter = 2,
+    Ready = 3,
+    Go = 4,
+    Mapped = 5,
+    Stop = 6,
+    Failed = 7,
+    #[cfg(test)]
