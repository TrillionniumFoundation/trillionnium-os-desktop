+        spec.render_node = "/dev/dri/renderD128".into();
+        let source_path = directory.join("selected.json");
+        fs::write(&source_path, serde_json::to_vec(&spec).unwrap()).unwrap();
+        let sealed = SealedCellSpec::new(&crate::load_cell_spec(&source_path).unwrap()).unwrap();
+        let binding = sealed.argument().unwrap();
+        let value: serde_json::Value = serde_json::from_str(&binding).unwrap();
+        let descriptor = value["fd"].as_i64().unwrap();
+        spec.render_node = "/dev/dri/renderD129".into();
+        fs::write(&source_path, serde_json::to_vec(&spec).unwrap()).unwrap();
+        let proof = directory.join("entry-proof");
+        // Use the actual production command constructor, including its
