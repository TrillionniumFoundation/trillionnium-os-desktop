  "system_server_scope_original": [
    {
      "line": 395,
      "text": "\tapiScopeSystemServer = initApiScope(&apiScope{"
    },
    {
      "line": 396,
      "text": "\t\tname:    \"system-server\","
    },
    {
      "line": 397,
      "text": "\t\textends: apiScopePublic,"
    },
    {
      "line": 398,
      "text": ""
    },
    {
      "line": 399,
      "text": "\t\t// The system-server scope can access the module-lib scope."
    },
    {
      "line": 400,
      "text": "\t\t//"
    },
    {
      "line": 401,
      "text": "\t\t// A module that provides a system-server API is appended to the standard bootclasspath that is"
    },
    {
      "line": 402,
      "text": "\t\t// used by the system server. So, it should be able to access module-lib APIs provided by"
    },
    {
      "line": 403,
      "text": "\t\t// libraries on the bootclasspath."
    },
    {
      "line": 404,
      "text": "\t\tcanAccess: apiScopeModuleLib,"
    },
    {
      "line": 405,
      "text": ""
    },
    {
      "line": 406,
      "text": "\t\t// The system-server scope is disabled by default in legacy mode."
    },
    {
      "line": 407,
      "text": "\t\t//"
    },
    {
      "line": 408,
      "text": "\t\t// Enabling this would break existing usages."
    },
    {
      "line": 409,
      "text": "\t\tlegacyEnabledStatus: func(module *SdkLibrary) bool {"
    },
    {
      "line": 410,
      "text": "\t\t\treturn false"
    },
    {
      "line": 411,
      "text": "\t\t},"
    },
    {
      "line": 412,
      "text": "\t\tscopeSpecificProperties: func(module *SdkLibrary) *ApiScopeProperties {"
    },
    {
      "line": 413,
      "text": "\t\t\treturn &module.sdkLibraryProperties.System_server"
    },
    {
      "line": 414,
      "text": "\t\t},"
    },
    {
      "line": 415,
      "text": "\t\tapiFilePrefix: \"system-server-\","
    },
    {
      "line": 416,
      "text": "\t\tmoduleSuffix:  \".system_server\","
    },
    {
      "line": 417,
      "text": "\t\tsdkVersion:    \"system_server_current\","
    },
    {
      "line": 418,
      "text": "\t\tannotation:    \"android.annotation.SystemApi(client=android.annotation.SystemApi.Client.SYSTEM_SERVER)\","
    },
    {
      "line": 419,
      "text": "\t\textraArgs: []string{"
    },
    {
