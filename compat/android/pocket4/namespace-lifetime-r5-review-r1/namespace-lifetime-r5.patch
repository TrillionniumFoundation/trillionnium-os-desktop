+// Pure, bounded parsing only: comm can itself contain spaces, ')' and newlines.
+// These are proc stat fields 1, 3 and 9, not the similarly named status file.
+fn creator_stat_bytes_live(bytes: &[u8], creator_tid: u32) -> bool {
+    if bytes.last() != Some(&b'\n') {
+        return false;
+    }
+    let Some(space) = bytes.iter().position(|&byte| byte == b' ') else {
+        return false;
+    };
+    if decimal(&bytes[..space]) != Some(u64::from(creator_tid))
+        || bytes.get(space + 1) != Some(&b'(')
+    {
+        return false;
+    }
+    let Some(comm_end) = bytes.iter().rposition(|&byte| byte == b')') else {
+        return false;
+    };
+    if comm_end <= space + 1 {
+        return false;
+    }
+    let fields = &bytes[comm_end + 1..];
+    if fields.len() < 4 || fields[0] != b' ' || fields[2] != b' ' {
+        return false;
+    }
+    if !matches!(fields[1], b'R' | b'S' | b'D' | b'T' | b't' | b'P' | b'I') {
+        return false; // includes EXIT_ZOMBIE / EXIT_DEAD and unknown states
+    }
+    let mut fields = fields[3..].split(|&byte| byte == b' ');
+    for _ in 0..5 {
+        if !fields.next().is_some_and(|field| !field.is_empty()) {
+            return false;
+        }
+    }
+    let Some(flags) = fields.next().and_then(decimal) else {
+        return false;
+    };
+    flags & 0x0000_0004 == 0 // include/linux/sched.h: PF_EXITING
+}
