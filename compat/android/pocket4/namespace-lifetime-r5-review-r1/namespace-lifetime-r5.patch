+                Ok((packet, credentials)) => {
+                    assert!(packet.matches(self.nonce, self.pid));
+                    assert_eq!(packet.phase, wanted as u32);
+                    assert_eq!(packet.errno, 0);
+                    assert_eq!(credentials.pid, self.pid as i32);
+                    return;
+                }
+                Err(NamespaceError::Io(ref error)) if error.kind() == io::ErrorKind::WouldBlock => {
+                    assert!(
+                        Instant::now() < deadline,
+                        "creator probe protocol timed out"
+                    );
+                    std::thread::sleep(Duration::from_millis(2));
+                }
+                Err(error) => panic!("creator probe protocol failed: {error}"),
+            }
+        }
+    }
+
+    fn send(&self, phase: Phase) {
+        send_packet(
+            self.control.as_raw_fd(),
+            &Packet::new(self.nonce, phase, 0, self.parent_pid),
+        )
+        .unwrap();
+    }
+
+    fn reap(&mut self) -> Result<ChildExit> {
+        if self.reaped {
+            return Err(NamespaceError::Rejected("probe already reaped"));
+        }
+        if !wait_exited(&self.pidfd, Duration::from_secs(2))? {
+            signal_owned(&self.pidfd, libc::SIGKILL)?;
+            if !wait_exited(&self.pidfd, Duration::from_secs(2))? {
+                return Err(NamespaceError::RetirementUnproven);
+            }
+        }
+        let mut info: libc::siginfo_t = unsafe { std::mem::zeroed() };
+        if unsafe {
+            libc::waitid(
+                libc::P_PIDFD,
+                self.pidfd.as_raw_fd() as u32,
+                &mut info,
+                libc::WEXITED | libc::WNOHANG,
+            )
+        } != 0
+            || unsafe { info.si_pid() } != self.pid as i32
+        {
+            return Err(NamespaceError::RetirementUnproven);
+        }
+        self.reaped = true;
+        Ok(ChildExit {
+            pid: self.pid,
+            status: unsafe { info.si_status() },
+            reason: info.si_code,
+        })
+    }
+}
+
+impl Drop for CreatorProbe {
+    fn drop(&mut self) {
+        if !self.reaped {
+            let _ = signal_owned(&self.pidfd, libc::SIGKILL);
+            let _ = self.reap();
+        }
+    }
+}
+
+fn creator_death_case(mode: child::Mode, rearm: bool) {
+    let (created_tx, created_rx) = std::sync::mpsc::sync_channel(1);
+    let (release_tx, release_rx) = std::sync::mpsc::sync_channel(1);
+    let creator = std::thread::spawn(move || {
+        let spawned = child::spawn(mode);
+        if created_tx.send(spawned).is_ok() {
+            // This is the actual cloning thread. Keep it alive through the
+            // child's clear-PDEATH barrier in the rearm control.
+            let _ = release_rx.recv_timeout(Duration::from_secs(6));
+        }
+    });
+    let (pid, pidfd, control, parent_pid, creator_tid, nonce) = created_rx
+        .recv_timeout(Duration::from_secs(3))
+        .unwrap()
+        .unwrap();
+    let mut probe = CreatorProbe {
+        pid,
+        pidfd,
+        control,
+        parent_pid,
+        nonce,
+        reaped: false,
+    };
+    assert_ne!(creator_tid, unsafe { libc::syscall(libc::SYS_gettid) }
+        as i32);
+    assert_eq!(parent_pid, std::process::id());
+    // The creator is still alive and blocked on release_rx. Bind this exact
+    // kernel thread before releasing it, without a TID-reuse window.
+    let creator_raw = unsafe { libc::syscall(libc::SYS_pidfd_open, creator_tid, libc::O_EXCL) };
+    assert!(creator_raw >= 0, "opening live creator PIDFD_THREAD failed");
+    let creator_pidfd = unsafe { OwnedFd::from_raw_fd(creator_raw as i32) };
+    probe.receive(Phase::Created);
+    if rearm {
+        probe.send(Phase::Enter);
+        probe.receive(Phase::Parked);
+    }
+    release_tx.send(()).unwrap();
+    creator.join().unwrap();
+    // pthread join can wake before exit_notify publishes PIDFD_THREAD exit.
+    // Establish the kernel-dead-before-arm premise with the held descriptor.
+    let readable_after_join = pidfd_exited(&creator_pidfd).unwrap();
+    assert!(
+        wait_exited(&creator_pidfd, Duration::from_secs(2)).unwrap(),
+        "creator kernel task did not exit within the bounded wait"
+    );
+    eprintln!(
+        "creator-exit barrier rearm={rearm}: readable_after_join={readable_after_join}; held_thread_exit=true"
+    );
+    assert_eq!(std::process::id(), parent_pid);
+    probe.send(if rearm { Phase::Go } else { Phase::Enter });
+    let exit = probe.reap().unwrap();
+    assert_eq!(exit.reason, libc::CLD_EXITED);
+    assert_eq!(exit.status, 125); // held creator pidfd rejected; not sentinel 127
+}
+
+#[test]
+fn creator_thread_death_before_initial_arm_is_rejected_and_reaped() {
+    creator_death_case(child::Mode::CreatorGoneBeforeArm, false);
+}
+
+#[test]
+fn creator_thread_death_before_rearm_is_rejected_and_reaped() {
+    creator_death_case(child::Mode::CreatorGoneBeforeRearm, true);
+}
