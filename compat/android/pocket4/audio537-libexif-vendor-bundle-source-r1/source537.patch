+rust_defaults {
+    name: "zygote_executable_defaults",
+    defaults: ["zygote_defaults"],
+    host_supported: true,
+    rustlibs: [
+        "libanyhow",
+        "libclap",
+        "liblog_rust",
+        "libtracing",
+        "libzygote_core",
+    ],
