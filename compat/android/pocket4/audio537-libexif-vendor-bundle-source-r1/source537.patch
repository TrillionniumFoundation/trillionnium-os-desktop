+        "-Wno-unused-parameter",
+        "-Wno-unused-variable",
+        "-Dsecure_getenv=getenv",
+
+        "-DHAVE_CONFIG_H",
+        "-include config.h",
+
+        "-DDISTCONFDIR=\"/lib\"",
+        "-DMODULE_DIRECTORY=\"/lib/modules\"",
+        "-DSYSCONFDIR=\"/tmp\"",
+        "-UNDEBUG",
+    ],
+    target: {
+        glibc: {
+            cflags: ["-DHAVE_DECL_STRNDUPA"],
+        },
+    },
+}
+
+cc_library_static {
+    defaults: ["libkmod_cflags_common"],
