+    out: [
+        "trusty_desktop_vm_x86_64.bin",
+    ],
+    cmd: "PROJECT_NAME=desktop-x86_64; OUT_EXT=bin;" +
+        "DESKTOP_TRUSTY_BUILD_PARAMS_RS=" +
+        "$$(dirname $(locations :desktop_trusty_build_params_rs));" +
+        "MICRODROID_KERNEL_HASHES_RS=" +
+        "$$(dirname $(locations :microdroid_kernel_hashes_rs));" +
+        "PLATFORM_SECURITY_PATCH_TIMESTAMP_RS=" +
