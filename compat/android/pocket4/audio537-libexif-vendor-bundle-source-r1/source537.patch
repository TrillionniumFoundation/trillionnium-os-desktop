+        "-Werror",
+        "-Wno-missing-field-initializers",
+        "-Wno-unused-variable",
+        "-Wno-unused-function",
+        "-Wno-unused-parameter",
+        "-Wno-deprecated-declarations",
+        "-Wthread-safety",
+    ],
+    require_root: true,
+    min_sdk_version: "30",
+}
