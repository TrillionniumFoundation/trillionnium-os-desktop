diff --git a/tools/droidloom-update/tests/fixtures/audio-generic535-original/packages/modules/Uwb/ranging/service/Android.bp b/tools/droidloom-update/tests/fixtures/audio-generic535-original/packages/modules/Uwb/ranging/service/Android.bp
