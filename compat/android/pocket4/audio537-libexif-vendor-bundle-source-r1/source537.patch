+    // implementation detail of LL-NDK libraries
+    vendor_available: false,
+}
+
+cc_library_headers {
+    name: "libstatspull_headers",
+    export_include_dirs: ["include"],
+    apex_available: [
+        "com.android.uprobestats",
+        "//apex_available:platform",
+    ],
+    min_sdk_version: "30",
