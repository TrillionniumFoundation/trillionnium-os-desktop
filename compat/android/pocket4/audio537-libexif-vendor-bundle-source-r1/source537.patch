+func (c *config) PreviewApiLevels() []ApiLevel {
+	var levels []ApiLevel
+	i := 0
+	for _, codename := range c.PlatformVersionActiveCodenames() {
+		if codename == "REL" {
+			continue
+		}
+
+		levels = append(levels, ApiLevel{
+			value:     codename,
+			major:     i,
+			isPreview: true,
+		})
+		i++
+	}
+	return levels
+}
