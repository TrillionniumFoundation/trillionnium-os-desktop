+    multilib: {
+        first: {
+            // Extractor process runs only with the primary ABI.
+            jni_libs: [
+                "libbluetooth_jni",
+            ],
+        },
+    },
+
+    prebuilts: [
+        "audio_set_configurations_bfbs",
