+        "compile_dir=$$(dirname $${prefix_dir}); " +
+        "proto_files=(); " +
+        "proto_paths_args=\"\"; " +
+        "for f in \"$${in_files[@]}\"; do " +
+        "if [[ \"$${f##*.}\" == \"proto\" ]]; then " +
+        "proto_files+=(\"$${f}\"); " +
+        "proto_path_args+=\"--proto-path=$$(dirname $$(dirname $${f})) \"; " +
+        "fi; done; " +
