+}
+
+// To use the pw_thread facade, add it to the defaults list of the library or
+// binary that uses it, then include the pw_android_common_backends to the
+// defaults list, which adds the pw_thread_stl backend, or add include your
+// custom backend.
+cc_defaults {
+    name: "pw_thread",
+    defaults: [
+        "pw_android_cpp_version",
+    ],
+    header_libs: [
+        "pw_chrono",
+        "pw_thread_include_dirs",
+    ],
+    export_header_lib_headers: [
+        "pw_chrono",
+        "pw_thread_include_dirs",
+    ],
+    static_libs: [
+        "pw_function",
+        "pw_numeric",
+        "pw_preprocessor",
+        "pw_status",
+    ],
+    export_static_lib_headers: [
+        "pw_function",
+        "pw_numeric",
+        "pw_preprocessor",
+        "pw_status",
+    ],
+    srcs: [
+        ":pw_thread_src_files",
+    ],
+}
+
+// Do not include these since they are for the pw_thread cc_defaults. Depend on
+// the pw_thread facade instead.
+cc_library_headers {
+    name: "pw_thread_include_dirs",
+    defaults: [
+        "pw_android_common_target_support",
+    ],
+    export_include_dirs: [
+        "public",
+    ],
+}
+
+// Do not include these since they are for the pw_thread cc_defaults. Depend on
+// the pw_thread facade instead.
+filegroup {
+    name: "pw_thread_src_files",
+    srcs: [
+        "sleep.cc",
+        "yield.cc",
+    ],
+}
+
+cc_library_headers {
+    name: "pw_thread_iteration",
+    export_include_dirs: ["public"],
+}
+
+// Expose pw_thread/thread.proto
+filegroup {
+    name: "pw_thread_protos",
+    srcs: [
+        "pw_thread_protos/thread.proto",
+    ],
+}
+
+genrule {
+    name: "pw_thread_pwpb_proto_header",
+    defaults: ["pw_rpc_generate_pwpb_header_with_prefix_and_protobuf"],
+    srcs: [
+        ":pw_thread_protos",
+        ":pw_tokenizer_proto_options_proto",
+        ":libprotobuf-internal-protos",
+    ],
+    out: ["pw_thread_protos/thread.pwpb.h"],
+}
+
+genrule {
+    name: "pw_thread_pwpb_rpc_header",
+    defaults: ["pw_rpc_generate_rpc_pwpb_header_with_prefix_and_protobuf"],
+    srcs: [
+        ":pw_thread_protos",
+        ":pw_tokenizer_proto_options_proto",
+        ":libprotobuf-internal-protos",
+    ],
+    out: [
+        "pw_thread_protos/thread.rpc.pwpb.h",
+    ],
+}
