filegroup {
    name: "framework-npumanager-sources",
    srcs: [
        "java/android/npumanager/*.java",
        "java/android/npumanager/*.aidl",
    ],
    path: "java",
    visibility: [
        "//frameworks/base/api",
        "//packages/modules/npumanager:__subpackages__",
    ],
}

java_sdk_library {
    name: "framework-npumanager",
    permitted_packages: [
        "android.npumanager",
        "com.android.npumanager",
    ],
    srcs: [":framework-npumanager-sources"],
    defaults: ["framework-module-defaults"],
    apex_available: ["com.android.npumanager"],
    min_sdk_version: "36",
    impl_library_visibility: [
        "//packages/modules/NpuManager:__subpackages__",
        "//vendor:__subpackages__",
    ],
    static_libs: [
        "npumanager_aconfig_flags_lib",
    ],
    unsafe_ignore_missing_latest_api: true,
    jarjar_rules: "jarjar-rules.txt",

}

aidl_interface {
    name: "framework-npumanager-aidl",
    local_include_dir: "java",
    include_dirs: [
        "frameworks/native/aidl/binder",
    ],
    srcs: [
        "java/android/npumanager/*.aidl",
    ],
    unstable: true,
    defaults: ["framework-module-defaults"],
    backend: {
        rust: {
            enabled: true,
            apex_available: ["com.android.npumanager"],
            min_sdk_version: "36",
        },
        java: {
            enabled: false,
        },
        cpp: {
            enabled: false,
        },
        ndk: {
            enabled: false,
        },
    },
}
