package {
    default_applicable_licenses: [
        "external_chromiumos-config_license",
        "Android-Apache-2.0",
    ],
}

license {
    name: "external_chromiumos-config_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "legacy_restricted",
    ],
    license_text: [
        "LICENSE",
    ],
}

// Common tools for Protobuf and gRPC generation
PROTO_TOOLS = [
    "aprotoc",
    "protoc-gen-grpc-java-plugin",
    "soong_zip",
]

// 1. Define your sources in a filegroup
filegroup {
    name: "chromiumos-config-grpc-srcs",
    srcs: [
        "proto/chromiumos/test/api/bols/bols_service.proto",
        "proto/chromiumos/test/api/lsnexus/lsnexus_service.proto",
    ],
}

// 2. Updated Command:
//    - Keeps "-I external/protobuf/src" to resolve imports.
//    - Uses "$(in)" so that it compiles EVERYTHING in srcs (including timestamp.proto).
//      This ensures com.google.protobuf.Timestamp.java is generated and added to your jar.
SERVO_PROTO_CMD = "mkdir -p $(genDir)/gen && " +
    "$(location aprotoc) --java_opt=annotate_code=false " +
    "--plugin=protoc-gen-grpc-java=$(location protoc-gen-grpc-java-plugin) " +
    "--grpc-java_out=lite:$(genDir)/gen " +
    "--java_out=lite:$(genDir)/gen " +
    "-I external/chromiumos-config/proto " +
    "-I external/protobuf/src " +
    "$(in) && " +
    "$(location soong_zip) -o $(out) -C $(genDir)/gen -D $(genDir)/gen"

genrule {
    name: "chromiumos-config-grpc-gen",
    tools: [
        "aprotoc",
        "protoc-gen-grpc-java-plugin",
        "soong_zip",
    ],
    cmd: SERVO_PROTO_CMD,
    srcs: [
        // 3. Include your files AND the standard protobuf definitions
        ":chromiumos-config-grpc-srcs",
        ":libprotobuf-internal-protos",
    ],
    out: [
        "chromiumos_config_protos.srcjar",
    ],
}

java_library {
    name: "chromiumos-config-protos-java",
    host_supported: true,
    proto: {
        type: "lite",
        include_dirs: [
            "external/chromiumos-config/proto",
            "external/protobuf/src",
        ],
    },
    srcs: [
        ":chromiumos-config-grpc-gen",
    ],
    libs: ["javax_annotation-api_1.3.2"],
    target: {
        android: {
            static_libs: [
                "libprotobuf-java-lite",
                "grpc-java-protobuf-lite",
                "grpc-java-core-android",
                "grpc-java-stub",
                "grpc-java-context",
                "grpc-java-core",
                "grpc-java-core-internal",
                "grpc-java-core-util",
                "grpc-java-okhttp",
                "guava",
            ],
        },
        host: {
            static_libs: [
                "libprotobuf-java-lite",
                "grpc-java-protobuf-lite",
                "grpc-java-stub",
                "grpc-java-context",
                "grpc-java-core",
                "grpc-java-core-internal",
                "grpc-java-core-util",
                "grpc-java-netty",
                "guava",
            ],
        },
    },
}

java_library {
    name: "chromiumos-config-java-lib",
    host_supported: true,
    static_libs: ["chromiumos-config-protos-java"],
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
}
