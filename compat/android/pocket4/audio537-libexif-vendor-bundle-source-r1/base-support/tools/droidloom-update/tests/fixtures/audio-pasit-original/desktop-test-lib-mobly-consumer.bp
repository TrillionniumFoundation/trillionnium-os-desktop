package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

python_test_host {
    name: "DesktopTestLibTestsMobly",
    defaults: ["PASIT-defaults"],
    srcs: ["src/*.py"],
    main: "src/__main__.py",
    libs: [
        "mobly",
        "desktop-test-lib-mobly",
    ],
    device_common_data: [
        // module for the APK we are going to install on the device and run tests from
        ":DesktopTestLibTests",
    ],
    test_options: {
        unit_test: false,
        // This option is used to identify Mobly modules in ATest
        runner: "mobly",
        tags: ["mobly"],
    },
    test_suites: ["general-tests"],
}
