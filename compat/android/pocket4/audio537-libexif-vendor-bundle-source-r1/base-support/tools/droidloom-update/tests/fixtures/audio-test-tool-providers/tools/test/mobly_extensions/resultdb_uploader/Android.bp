package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

prebuilt_etc_host {
    name: "resultdb_uploader_exe",
    src: "prebuilt/resultdb_uploader",
    filename: "resultdb_uploader",
}

python_library_host {
    name: "resultdb_uploader_exe_python_wrapper",
    data: [":resultdb_uploader_exe"],
    pkg_path: "resultdb_uploader",
}

python_library_host {
    name: "resultdb_uploader_python_library",
    srcs: ["resultdb_uploader_wrapper.py"],
    libs: ["resultdb_uploader_exe_python_wrapper"],
    pkg_path: "resultdb_uploader",
}
