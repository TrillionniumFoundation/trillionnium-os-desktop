package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_defaults {
    name: "CtsStatsdAtomHostTest_defaults",
    defaults: ["cts_defaults"],
    test_suites: [
        "cts",
        "general-tests",
    ],
    libs: [
        "compatibility-host-util",
        "core_cts_test_resources",
        "cts-tradefed",
        "host-libprotobuf-java-full",
        "tradefed",
        "truth",
    ],
    static_libs: [
        "stats_flags_lib_host",
        "cts-statsd-atom-host-test-utils",
        "flag-junit-host",
        "truth-liteproto-extension",
        "truth-proto-extension",
    ],
    device_common_data: [
        ":CtsStatsdAtomApp",
    ],
    per_testcase_directory: true,
    enable_static_aconfig_pb: true,
}

java_test_host {
    name: "CtsTelecomAtomHostTestCases",
    team: "trendy_team_fwk_telecom",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: [
        "telecom/src/**/*.java",
    ],
    device_common_data: [
        ":CtsTelecomTestCases",
        ":CtsTelecomCujTestCases",
        ":TransactionalVoipAppMain",
        ":ManagedConnectionServiceApp",
    ],
    test_config: "configs/AndroidTestTelecom.xml",
}

java_test_host {
    name: "CtsStatsdAtomHostTestCases",
    team: "trendy_team_android_telemetry_client_infra",
    defaults: ["CtsStatsdAtomHostTest_defaults"],
    srcs: [
        "statsd/src/**/*.java",
        "express/src/**/*.java",
    ],

    static_libs: [
        "android.os.flags-aconfig-java-host",
    ],

    device_common_data: [
        ":CtsStatsdExpressLogHelper",
    ],
}

java_library_host {
    name: "cts-statsd-atom-host-test-utils",
    srcs: ["lib/src/**/*.java"],
    static_libs: [
        "platformprotos",
        "host-libprotobuf-java-full",
    ],
    libs: [
        "compatibility-host-util",
        "cts-tradefed",
        "tradefed",
        "truth",
    ],
}

test_module_config_host {
    name: "CtsStatsdAtomHostTestCases-kernel-presubmit-brightness",
    base: "CtsStatsdAtomHostTestCases",
    test_suites: ["general-tests"],
    include_filters: [
        "android.cts.statsdatom.display.DisplayBrightnessChangedStatsTests",
        "android.cts.statsdatom.statsd.UidAtomTests#testScreenBrightness",
        "android.cts.statsdatom.display.DisplayWakeReportedStatsTests",
    ],
}
