package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_desktop_peripherals",
}

python_library_host {
    name: "py-display-painter",
    srcs: [
        "*/*display_painter.py",
        "*display_painter.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-display-helper",
    srcs: [
        "display_helper.py",
    ],
    libs: [
        "mobly",
        "py-pasit-display",
        "py-test-policy",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-hid-helper",
    srcs: [
        "hid_helper.py",
    ],
    libs: [
        "mobly",
        "py-desktop-utils",
        "py-pasit-hid",
        "py-test-policy",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-display-camera-mapper",
    srcs: [
        "display_camera_mapper.py",
        "color_capturer.py",
    ],
    libs: [
        "mobly",
        "py-pasit-display",
        "py-display-painter",
        "py-passport",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-camera",
    srcs: [
        "*/*camera.py",
        "*camera.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-device",
    srcs: [
        "*/*device.py",
        "*device.py",
        "dut_state_manager.py",
        "*/snippet_tools.py",
        "*/base_user_tools.py",
        "*/android_user_tools.py",
        "*/base_ui_tools.py",
        "*/android_ui_tools.py",
        "*/dumpsys_battery_parser.py",
        "*/screen_recorder.py",
        "*/input_recorder.py",
        "*/adb_command_monitor.py",
        "*/process_monitor_group.py",
        "*/ui_watcher.py",
        "*/device_state_parser.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
        "py-desktop-utils",
        "py-snippet-uiautomator",
        "py-test-policy",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-display",
    srcs: [
        "*/*display.py",
        "*/*display_id.py",
        "*/dumpsys_display_parser.py",
        "*/dumpsys_surfaceflinger_parser.py",
        "*display.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-file",
    srcs: [
        "*/*file.py",
        "*file.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-hid",
    srcs: [
        "*/*hid.py",
        "*hid.py",
        "hid_emulator.py",
        "hid_keys.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-network",
    srcs: [
        "*/*network.py",
        "*network.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
        "py-desktop-utils",
        "py-passport",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-storage",
    srcs: [
        "*/*storage.py",
        "*storage.py",
    ],
    exclude_srcs: ["passport/*"],
    libs: [
        "mobly",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-pasit-test",
    srcs: [
        "*/*test.py",
        "*test.py",
        "pasit_test_config.py",
    ],
    exclude_srcs: [
        "passport/*",
        "pasit_lib_imports_test.py",
        "pasit_test_test.py",
    ],
    libs: [
        "mobly",
        "py-pasit-device",
        "py-passport",
        "py-test-policy",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-passport",
    srcs: ["passport/*.py"],
    exclude_srcs: ["passport/*_test.py"],
    libs: [
        "py-grpcio",
        "libprotobuf-python",
        "mobly",
        "py-chromiumos-config-passport",
        "py-desktop-utils",
    ],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-test-policy",
    srcs: ["test_policy.py"],
    pkg_path: "lib/pasit",
}

python_library_host {
    name: "py-peripheral-connector",
    srcs: ["peripheral_connector.py"],
    libs: [
        "py-passport",
    ],
    pkg_path: "lib/pasit",
}

python_test_host {
    name: "pasit_lib_imports_test",
    srcs: [
        "pasit_lib_imports_test.py",
    ],
    test_options: {
        unit_test: true,
    },
    libs: [
        "py-display-helper",
        "py-hid-helper",
        "py-display-camera-mapper",
        "py-display-painter",
        "py-pasit-camera",
        "py-pasit-device",
        "py-pasit-display",
        "py-pasit-file",
        "py-pasit-hid",
        "py-pasit-storage",
        "py-pasit-test",
        "py-passport",
    ],
}

python_test_host {
    name: "dumpsys_display_parser_test",
    team: "trendy_team_desktop_peripherals",
    main: "android/dumpsys_display_parser_test.py",
    srcs: [
        "android/dumpsys_display_parser_test.py",
    ],
    data: [
        "android/testdata/dumpsys_display_internal.txt",
        "android/testdata/dumpsys_display_external.txt",
        "android/testdata/dumpsys_display_lid_closed.txt",
    ],
