+    #[test]
+    fn production_readiness_torn_property_publication_is_retryable() {
+        let published = area();
+        let mut initial = published.clone();
+        // The name nodes already exist; the property leaf is not published.
+        // Bionic allocates the new leaf before publishing its offset.
+        set(&mut initial, 0, 172);
+        set(&mut initial, HEADER + 136 + 4, 0);
+        initial[HEADER + 172..].fill(0);
+        assert_eq!(parse(&initial).unwrap().value, BootProperty::Absent);
+        assert_eq!(parse(&published).unwrap().value, BootProperty::Complete);
+
+        let mut named = tempfile::NamedTempFile::new().unwrap();
+        named.write_all(&initial).unwrap();
+        let writer = named.as_file().try_clone().unwrap();
+        let metadata = named.as_file().metadata().unwrap();
+        let mut reads = 0;
+        let observed = read_boot_complete_with_snapshot(
+            named.as_file(),
+            metadata.uid(),
+            metadata.gid(),
+            |file, bytes| {
+                reads += 1;
+                if reads == 1 {
+                    // A read of shared property storage is not an atomic copy:
+                    // the old used-size can precede a newly published pointer.
+                    file.read_exact_at(&mut bytes[..HEADER], 0)?;
+                    writer.write_all_at(&published, 0)?;
+                    file.read_exact_at(&mut bytes[HEADER..], HEADER as u64)
+                } else {
+                    file.read_exact_at(bytes, 0)
+                }
+            },
+        );
+        assert!(
+            matches!(observed, Err(ReadinessError::Changed)),
+            "a concurrent valid publication must be retried, never admitted or rejected: {observed:?}"
+        );
+        assert_eq!(reads, 2, "a rejection permits only one bounded reread");
+        assert_eq!(
+            read_boot_complete(named.as_file(), metadata.uid(), metadata.gid()).unwrap(),
+            BootProperty::Complete
+        );
+    }
+
+    #[test]
+    fn production_readiness_stable_malformed_snapshot_stays_rejected() {
+        let mut invalid = area();
+        set(&mut invalid, HEADER + 16, u32::MAX);
+        let mut named = tempfile::NamedTempFile::new().unwrap();
+        named.write_all(&invalid).unwrap();
+        let metadata = named.as_file().metadata().unwrap();
+        let mut reads = 0;
+        let observed = read_boot_complete_with_snapshot(
+            named.as_file(),
+            metadata.uid(),
+            metadata.gid(),
+            |file, bytes| {
+                reads += 1;
+                file.read_exact_at(bytes, 0)
+            },
+        );
+        assert!(matches!(observed, Err(ReadinessError::Rejected(_))));
+        assert!((1..=2).contains(&reads), "malformed reads stay bounded");
+    }
