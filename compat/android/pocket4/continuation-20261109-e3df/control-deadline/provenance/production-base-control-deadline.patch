+fn request_read_budget(deadline: Instant) -> Result<Duration, ControlError> {
+    let remaining = deadline.saturating_duration_since(Instant::now());
+    if remaining.is_zero() {
+        return Err(io_error(
+            "read lifecycle request",
+            io::Error::new(
+                io::ErrorKind::TimedOut,
+                "lifecycle request deadline expired",
+            ),
+        ));
+    }
+    Ok(remaining)
+}
