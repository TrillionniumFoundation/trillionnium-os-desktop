+fn audio_keep_required_discovery(
+    source: &Path, relative: &str, mode: SoongDependencyMode,
+) -> Result<bool> {
+    if mode != SoongDependencyMode::AudioApexTargetClosure
+        || relative != "frameworks/base/packages/SettingsLib"
+    {
+        return Ok(false);
+    }
+    // The original SystemUI libraries link SettingsLib and its real children.
+    // Do not create an exclusion over that provider tree, and do not silently
+    // delete or adopt a foreign marker that could still hide it from Soong.
+    if hash(&source.join(relative).join("Android.bp"))?
+        != "a3190e923698e7e0b3847916b38fd85a23cb82491e4fae622a2e9286f45559fd"
+    {
+        return fail("audio original SettingsLib provider changed");
+    }
+    match fs::symlink_metadata(source.join(relative).join(".find-ignore")) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(true),
+        Ok(_) => fail("audio required SettingsLib provider is hidden by an existing discovery marker"),
+        Err(error) => Err(error.into()),
+    }
+}
