+//! Opt-in, bounded retries for ordinary Git fetch and checkout transport failures.
+use std::collections::BTreeMap;
+use std::ffi::{OsStr, OsString};
+use std::fs::{self, File, OpenOptions};
+use std::io::{self, Write};
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::os::unix::process::ExitStatusExt;
+use std::path::{Component, Path, PathBuf};
+use std::process::{Command, Output, Stdio};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+use serde_json::{Value, json};
+use sha2::{Digest, Sha256};
+
+use super::{SourceError, io_error};
+
+/// Optional transport policy for the ordinary materializer; the default is one attempt.
+#[derive(Default)]
+pub struct GitTransportRetry {
+    journal: Option<Journal>,
+    command_id: u64,
+}
+
+impl GitTransportRetry {
+    /// Open a create-only private journal when explicitly enabling three attempts.
+    ///
+    /// A journal may also be used with one attempt. It must be outside the output
+    /// and source staging trees, with an existing, real, privately owned parent.
+    ///
+    /// # Errors
+    /// Rejects unsupported limits, a missing retry journal, unsafe paths or I/O errors.
+    pub fn new(
+        attempts: u8,
+        journal_path: Option<&Path>,
+        destination: &Path,
+        lock_path: &Path,
+    ) -> Result<Self, SourceError> {
+        if attempts != 1 && attempts != 3 {
+            return Err(invalid("git transport attempts must be 1 or 3"));
+        }
+        let Some(path) = journal_path else {
+            return if attempts == 1 {
+                Ok(Self::default())
+            } else {
+                Err(invalid(
+                    "three git transport attempts require a new attempt journal",
+                ))
+            };
+        };
+        let mut journal = Journal::create(path, destination, attempts)?;
+        journal
+            .record(&json!({
+                "schema_version": 1, "event": "header", "process_id": std::process::id(),
+                "at_unix_ms": unix_ms(), "maximum_attempts": attempts,
+                "retry_operations": ["fetch", "checkout"], "backoff_ms": [1000, 3000],
+                "lock_sha256": super::sha256_file(lock_path)?,
+                "destination_hex": hex::encode(destination.as_os_str().as_bytes()),
+                "output_encoding": "hex", "environment_values_logged": false
+            }))
+            .map_err(|error| io_error("persist git attempt journal header", error))?;
+        File::open(path.parent().expect("validated journal parent"))
+            .and_then(|parent| parent.sync_all())
+            .map_err(|error| io_error("persist git attempt journal directory", error))?;
+        Ok(Self {
+            journal: Some(journal),
+            command_id: 0,
+        })
+    }
+
+    pub(super) fn run(
+        &mut self,
+        operation: Operation,
+        checkout: &Path,
+        args: &[&OsStr],
+    ) -> Result<(), SourceError> {
+        if args.first().copied() != Some(OsStr::new(operation.name())) {
+            return Err(invalid(
+                "transport retry operation does not match Git arguments",
+            ));
+        }
+        let Some(journal) = self.journal.as_mut() else {
+            return super::run_git(checkout, args);
+        };
+        self.command_id += 1;
+        let command = CommandSpec::git(checkout, args)
+            .map_err(|error| io_error("capture git command context", error))?;
+        execute(
+            self.command_id,
+            operation,
+            &command,
+            journal.attempts,
+            journal,
+            &mut RealRunner,
+            &mut |delay| std::thread::sleep(delay),
+        )
+        .map(drop)
+    }
+}
+
+#[derive(Clone, Copy)]
+pub(super) enum Operation {
+    Fetch,
+    Checkout,
+}
+impl Operation {
+    fn name(self) -> &'static str {
+        match self {
+            Self::Fetch => "fetch",
+            Self::Checkout => "checkout",
+        }
+    }
+}
+
+fn invalid(message: &str) -> SourceError {
+    SourceError::Invalid(vec![message.to_owned()])
+}
+
+struct Journal {
+    file: File,
+    attempts: u8,
+}
+impl Journal {
+    fn create(path: &Path, destination: &Path, attempts: u8) -> Result<Self, SourceError> {
+        if !path.is_absolute()
+            || path
+                .components()
+                .any(|c| matches!(c, Component::ParentDir | Component::CurDir))
+        {
+            return Err(invalid(
+                "attempt journal must be an absolute normalized path",
+            ));
+        }
+        if path.components().any(|c| {
+            c.as_os_str().as_bytes().starts_with(b".droidloom-project-")
+                || c.as_os_str().as_bytes().starts_with(b".droidloom-source-")
+        }) {
+            return Err(invalid(
+                "attempt journal must be outside temporary source staging",
+            ));
+        }
+        let parent = path
+            .parent()
+            .ok_or_else(|| invalid("attempt journal needs a parent"))?;
+        let meta = fs::symlink_metadata(parent).map_err(|e| io_error("stat journal parent", e))?;
+        let owner = fs::metadata("/proc/self")
+            .map_err(|e| io_error("stat journal owner", e))?
+            .uid();
+        if !meta.is_dir()
+            || meta.file_type().is_symlink()
+            || meta.mode() & 0o077 != 0
+            || meta.uid() != owner
+            || fs::canonicalize(parent).map_err(|e| io_error("resolve journal parent", e))?
+                != parent
+        {
+            return Err(invalid(
+                "attempt journal parent must be real, private and owned by the caller",
+            ));
+        }
+        let resolved_output = projected_path(destination)?;
+        if path.starts_with(&resolved_output) {
+            return Err(invalid(
+                "attempt journal must be outside the materialized output",
+            ));
+        }
+        let file = OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .mode(0o600)
+            .open(path)
+            .map_err(|e| io_error("create new git attempt journal", e))?;
+        let file_meta = file
+            .metadata()
+            .map_err(|e| io_error("stat new git attempt journal", e))?;
+        if !file_meta.is_file()
+            || file_meta.nlink() != 1
+            || file_meta.mode() & 0o777 != 0o600
+            || file_meta.uid() != owner
+        {
+            return Err(invalid("new attempt journal is not a private regular file"));
+        }
+        Ok(Self { file, attempts })
+    }
+}
+
+fn projected_path(path: &Path) -> Result<PathBuf, SourceError> {
+    let absolute = if path.is_absolute() {
+        path.to_owned()
+    } else {
+        std::env::current_dir()
+            .map_err(|e| io_error("resolve output working directory", e))?
+            .join(path)
+    };
+    if absolute
+        .components()
+        .any(|c| matches!(c, Component::ParentDir))
+    {
+        return Err(invalid(
+            "journaled materialization needs an output without parent traversal",
+        ));
+    }
+    let mut existing = absolute.as_path();
+    let mut missing = Vec::new();
+    loop {
+        match fs::canonicalize(existing) {
+            Ok(mut resolved) => {
+                for part in missing.iter().rev() {
+                    resolved.push(part);
+                }
+                return Ok(resolved);
+            }
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {
+                missing.push(
+                    existing
+                        .file_name()
+                        .ok_or_else(|| invalid("cannot resolve output"))?,
+                );
+                existing = existing
+                    .parent()
+                    .ok_or_else(|| invalid("cannot resolve output parent"))?;
+            }
+            Err(e) => return Err(io_error("resolve materialized output", e)),
+        }
+    }
+}
+
+trait AttemptLog {
+    fn record(&mut self, event: &Value) -> io::Result<()>;
+}
+impl AttemptLog for Journal {
+    fn record(&mut self, event: &Value) -> io::Result<()> {
+        let mut bytes = serde_json::to_vec(event).map_err(io::Error::other)?;
+        bytes.push(b'\n');
+        self.file.write_all(&bytes)?;
+        self.file.sync_all()
+    }
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+struct CommandSpec {
+    program: OsString,
+    args: Vec<OsString>,
+    cwd: PathBuf,
+    environment: BTreeMap<OsString, OsString>,
+}
+impl CommandSpec {
+    fn git(checkout: &Path, args: &[&OsStr]) -> io::Result<Self> {
+        let mut all_args = vec![OsString::from("-C"), checkout.as_os_str().to_owned()];
+        all_args.extend(args.iter().map(|arg| (*arg).to_owned()));
+        Ok(Self {
+            program: "git".into(),
+            args: all_args,
+            cwd: std::env::current_dir()?,
+            environment: std::env::vars_os().collect(),
+        })
+    }
+    fn environment_sha256(&self) -> String {
+        let mut hash = Sha256::new();
+        for (key, value) in &self.environment {
+            for bytes in [key.as_bytes(), value.as_bytes()] {
+                hash.update((bytes.len() as u64).to_le_bytes());
+                hash.update(bytes);
+            }
+        }
+        hex::encode(hash.finalize())
+    }
+}
+
+struct AttemptOutput {
+    child_pid: u32,
+    output: Output,
+}
+struct RunError {
+    stage: &'static str,
+    child_pid: Option<u32>,
+    source: io::Error,
+}
+trait Runner {
+    fn run(&mut self, command: &CommandSpec) -> Result<AttemptOutput, RunError>;
+}
+struct RealRunner;
+impl Runner for RealRunner {
+    fn run(&mut self, command: &CommandSpec) -> Result<AttemptOutput, RunError> {
+        let child = Command::new(&command.program)
+            .args(&command.args)
+            .current_dir(&command.cwd)
+            .env_clear()
+            .envs(&command.environment)
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::piped())
+            .spawn()
+            .map_err(|source| RunError {
+                stage: "spawn",
+                child_pid: None,
+                source,
+            })?;
+        let child_pid = child.id();
+        child
+            .wait_with_output()
+            .map(|output| AttemptOutput { child_pid, output })
+            .map_err(|source| RunError {
+                stage: "wait",
+                child_pid: Some(child_pid),
+                source,
+            })
+    }
+}
+
+/// Complete stderr is classified before the ordinary 4096-character error rendering.
+fn transient_transport(output: &Output) -> bool {
+    if output.status.code() != Some(128) || output.status.signal().is_some() {
+        return false;
+    }
+    let text = String::from_utf8_lossy(&output.stderr).to_ascii_lowercase();
+    let denied = [
+        "authentication failed",
+        "authorization failed",
+        "could not read username",
+        "could not read password",
+        "permission denied",
+        "access denied",
+        "proxy authentication required",
+        "http 401",
+        "http 403",
+        "http 407",
+        "returned error: 401",
+        "returned error: 403",
+        "returned error: 407",
+        "repository not found",
+        "returned error: 404",
+        "couldn't find remote ref",
+        "could not find remote ref",
+        "not our ref",
+        "unadvertised object",
+        "reference is not a tree",
+        "not a valid object",
+        "invalid object",
+        "bad object",
+        "bad tree object",
+        "corrupt",
+        "checksum mismatch",
+        "sha1 mismatch",
+        "sha-1 mismatch",
+        "sha256 mismatch",
+        "sha-256 mismatch",
+        "inflate: data stream error",
+        "inflate returned",
+        "invalid pack",
+        "did not receive expected object",
+        "no space left",
+        "disk quota exceeded",
+        "read-only file system",
+        "input/output error",
+        "too many open files",
+        "unable to create",
+        "cannot create",
+        "index.lock",
+        "shallow.lock",
+        "packed-refs.lock",
+        "another git process",
+        "dubious ownership",
+        "certificate",
+        "ssl peer",
+        "ssl routines",
+        "tls handshake",
+    ];
+    if denied.iter().any(|pattern| text.contains(pattern)) {
+        return false;
+    }
+    text.contains("curl 56 ")
+        && (text.contains("recv failure: connection timed out")
+            || text.contains("recv failure: connection reset by peer"))
+}
+
+fn unix_ms() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_millis()
+}
+
+fn execute(
+    command_id: u64,
+    operation: Operation,
+    command: &CommandSpec,
+    attempts: u8,
+    log: &mut impl AttemptLog,
+    runner: &mut impl Runner,
+    sleep: &mut impl FnMut(Duration),
+) -> Result<Output, SourceError> {
+    for attempt in 1..=attempts {
+        let start = Instant::now();
+        let started_at = unix_ms();
+        log.record(&json!({
+            "schema_version":1, "event":"attempt_start", "process_id":std::process::id(),
+            "command_id":command_id, "attempt":attempt, "operation":operation.name(),
+            "at_unix_ms":started_at,
+            "program_hex":hex::encode(command.program.as_bytes()),
+            "argv_hex":command.args.iter().map(|a| hex::encode(a.as_bytes())).collect::<Vec<_>>(),
+            "cwd_hex":hex::encode(command.cwd.as_os_str().as_bytes()),
+            "environment_sha256":command.environment_sha256(),
+        }))
+        .map_err(|e| io_error("persist git attempt start", e))?;
+        let result = match runner.run(command) {
+            Ok(result) => result,
+            Err(error) => {
+                log.record(&json!({
+                    "schema_version":1, "event":"execution_error", "process_id":std::process::id(),
+                    "command_id":command_id, "attempt":attempt, "stage":error.stage,
+                    "child_pid":error.child_pid, "at_unix_ms":unix_ms(),
+                    "elapsed_ms":start.elapsed().as_millis(), "retry":false,
+                    "io_error":error.source.to_string(), "raw_os_error":error.source.raw_os_error(),
+                }))
+                .map_err(|e| io_error("persist git execution error", e))?;
+                return Err(io_error(&format!("{} git", error.stage), error.source));
+            }
+        };
+        let output = result.output;
+        let transient = transient_transport(&output);
+        let retry = transient && attempt < attempts;
+        let delay_ms: u64 = if retry {
+            if attempt == 1 { 1000 } else { 3000 }
+        } else {
+            0
+        };
+        let decision = if output.status.success() {
+            "success"
+        } else if output.status.signal().is_some() {
+            "signal_no_retry"
+        } else if retry {
+            "transient_retry"
+        } else if transient {
+            "transient_exhausted"
+        } else {
+            "non_retryable"
+        };
+        log.record(&json!({
+            "schema_version":1, "event":"attempt_finish", "process_id":std::process::id(),
+            "command_id":command_id, "attempt":attempt, "operation":operation.name(),
+            "child_pid":result.child_pid, "started_at_unix_ms":started_at, "at_unix_ms":unix_ms(),
+            "elapsed_ms":start.elapsed().as_millis(), "exit_code":output.status.code(),
+            "signal":output.status.signal(), "status":output.status.to_string(),
+            "stdout_hex":hex::encode(&output.stdout), "stderr_hex":hex::encode(&output.stderr),
+            "decision":decision, "retry":retry, "backoff_ms":delay_ms,
+        }))
+        .map_err(|e| io_error("persist complete git attempt result", e))?;
+        if output.status.success() {
+            return Ok(output);
+        }
+        if !retry {
+            return Err(SourceError::Command {
+                program: "git".to_owned(),
+                status: output.status.to_string(),
+                stderr: String::from_utf8_lossy(&output.stderr)
+                    .chars()
+                    .take(4096)
+                    .collect(),
+            });
+        }
+        sleep(Duration::from_millis(delay_ms));
+    }
+    Err(invalid("invalid empty transport attempt budget"))
+}
