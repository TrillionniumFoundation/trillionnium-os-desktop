+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::cell::RefCell;
+    use std::collections::VecDeque;
+    use std::os::unix::fs::PermissionsExt;
+    use std::process::ExitStatus;
+    use std::rc::Rc;
+
+    const TRANSIENT: &str = "error: RPC failed; curl 56 Recv failure: Connection timed out\nerror: 9746 bytes of body are still expected\nfetch-pack: unexpected disconnect while reading sideband packet\nfatal: early EOF\nfatal: index-pack failed\nfatal: could not fetch 3a64e7ba5c593b3e17a90700021c82ac26475668 from promisor remote\n";
+    fn output(code: i32, stderr: &str) -> Output {
+        Output {
+            status: ExitStatus::from_raw(code << 8),
+            stdout: b"\x00full\xffstdout".to_vec(),
+            stderr: stderr.as_bytes().to_vec(),
+        }
+    }
+    #[test]
+    fn transport_classifier_parameterized() {
+        let cases = [
+            (output(128, TRANSIENT), true),
+            (
+                output(
+                    128,
+                    "error: RPC failed; curl 56 Recv failure: Connection reset by peer",
+                ),
+                true,
+            ),
+            (
+                output(128, "fatal: early EOF\nfatal: index-pack failed"),
+                false,
+            ),
+            (
+                output(128, "fatal: could not fetch object from promisor remote"),
+                false,
+            ),
+            (output(1, TRANSIENT), false),
+            (output(0, TRANSIENT), false),
+            (
+                Output {
+                    status: ExitStatus::from_raw(15),
+                    ..output(128, TRANSIENT)
+                },
+                false,
+            ),
+        ];
+        for (result, expected) in cases {
+            assert_eq!(transient_transport(&result), expected);
+        }
+        for denial in [
+            "Authentication failed",
+            "HTTP 403",
+            "The requested URL returned error: 401",
+            "repository not found",
+            "not our ref deadbeef",
+            "couldn't find remote ref pinned",
+            "object file is corrupt",
+            "pack checksum mismatch",
+            "No space left on device",
+            "Disk quota exceeded",
+            "Permission denied",
+            "Read-only file system",
+            "Input/output error",
+            "Unable to create index.lock",
+            "SSL certificate problem",
+            "detected dubious ownership",
+        ] {
+            let full = format!("{TRANSIENT}{}fatal: {denial}\n", "x".repeat(5000));
+            assert!(!transient_transport(&output(128, &full)), "{denial}");
+        }
+    }
+
+    struct MemoryLog {
+        events: Vec<Value>,
+        timeline: Rc<RefCell<Vec<String>>>,
+        fail_at: Option<usize>,
+    }
+    impl AttemptLog for MemoryLog {
+        fn record(&mut self, value: &Value) -> io::Result<()> {
+            if self.fail_at == Some(self.events.len()) {
+                return Err(io::Error::other("injected journal failure"));
+            }
+            self.timeline
+                .borrow_mut()
+                .push(value["event"].as_str().unwrap().to_owned());
+            self.events.push(value.clone());
+            Ok(())
+        }
+    }
+    struct ScriptedRunner {
+        results: VecDeque<Result<AttemptOutput, RunError>>,
+        seen: Vec<CommandSpec>,
+        timeline: Rc<RefCell<Vec<String>>>,
+    }
+    impl Runner for ScriptedRunner {
+        fn run(&mut self, command: &CommandSpec) -> Result<AttemptOutput, RunError> {
+            self.timeline.borrow_mut().push("run".into());
+            self.seen.push(command.clone());
+            self.results
+                .pop_front()
+                .expect("no unexpected fourth attempt")
+        }
+    }
+    #[test]
+    fn transport_retry_and_journal_parameterized() {
+        // Default API remains exactly one attempt, with no journal and no opt-in.
+        assert!(GitTransportRetry::default().journal.is_none());
+        let success = || output(0, "complete success output");
+        let transient = || output(128, TRANSIENT);
+        let signal = || Output {
+            status: ExitStatus::from_raw(15),
+            ..transient()
+        };
+        let scenarios = [
+            (
+                "success_after_transient",
+                3,
+                vec![transient(), success()],
+                None,
+                2,
+                true,
+                vec![1000],
+            ),
+            (
+                "exhausted",
+                3,
+                vec![transient(), transient(), transient()],
+                None,
+                3,
+                false,
+                vec![1000, 3000],
+            ),
+            (
+                "permanent_after_transient",
+                3,
+                vec![transient(), output(128, "Authentication failed")],
+                None,
+                2,
+                false,
+                vec![1000],
+            ),
+            ("signal", 3, vec![signal()], None, 1, false, vec![]),
+            (
+                "default_budget",
+                1,
+                vec![transient()],
+                None,
+                1,
+                false,
+                vec![],
+            ),
+            (
+                "start_log_failure",
+                3,
+                vec![transient()],
+                Some(0),
+                0,
+                false,
+                vec![],
+            ),
+            (
+                "finish_log_failure",
+                3,
+                vec![transient()],
+                Some(1),
+                1,
+                false,
+                vec![],
+            ),
+            (
+                "second_start_log_failure",
+                3,
+                vec![transient(), success()],
+                Some(2),
+                1,
+                false,
+                vec![1000],
+            ),
+        ];
+        let command = CommandSpec {
+            program: "git".into(),
+            args: vec![
+                "-C".into(),
+                "/fixed/checkout".into(),
+                "fetch".into(),
+                "--depth=1".into(),
+                "origin".into(),
+                "pinned".into(),
+            ],
+            cwd: "/fixed/cwd".into(),
+            environment: BTreeMap::from([
+                ("PATH".into(), "/fixed/bin".into()),
+                ("TEST_LITERAL".into(), "unchanged".into()),
+            ]),
+        };
+        for (name, attempts, outputs, fail_at, count, ok, expected_delays) in scenarios {
+            for operation in [Operation::Fetch, Operation::Checkout] {
+                let timeline = Rc::new(RefCell::new(Vec::new()));
+                let mut log = MemoryLog {
+                    events: Vec::new(),
+                    timeline: timeline.clone(),
+                    fail_at,
+                };
+                let mut runner = ScriptedRunner {
+                    results: outputs
+                        .iter()
+                        .enumerate()
+                        .map(|(i, o)| {
+                            Ok(AttemptOutput {
+                                child_pid: 4200 + i as u32,
+                                output: Output {
+                                    status: o.status,
+                                    stdout: o.stdout.clone(),
+                                    stderr: o.stderr.clone(),
+                                },
+                            })
+                        })
+                        .collect(),
+                    seen: Vec::new(),
+                    timeline: timeline.clone(),
+                };
+                let mut delays = Vec::new();
+                let result = execute(
+                    7,
+                    operation,
+                    &command,
+                    attempts,
+                    &mut log,
+                    &mut runner,
+                    &mut |d| {
+                        timeline.borrow_mut().push("sleep".into());
+                        delays.push(d.as_millis() as u64);
+                    },
+                );
+                assert_eq!(result.is_ok(), ok, "{name}");
+                assert_eq!(runner.seen.len(), count, "{name}");
+                assert!(runner.seen.iter().all(|seen| seen == &command), "{name}");
+                assert_eq!(delays, expected_delays, "{name}");
+                for event in log.events.iter().filter(|e| e["event"] == "attempt_finish") {
+                    let index = event["attempt"].as_u64().unwrap() as usize - 1;
+                    assert_eq!(
+                        hex::decode(event["stdout_hex"].as_str().unwrap()).unwrap(),
+                        outputs[index].stdout
+                    );
+                    assert_eq!(
+                        hex::decode(event["stderr_hex"].as_str().unwrap()).unwrap(),
+                        outputs[index].stderr
+                    );
+                    assert_eq!(event["child_pid"].as_u64().unwrap(), 4200 + index as u64);
+                }
+                let trace = timeline.borrow();
+                for (i, event) in trace.iter().enumerate() {
+                    if event == "run" {
+                        assert!(i > 0 && trace[i - 1] == "attempt_start");
+                    }
+                    if event == "sleep" {
+                        assert!(i > 0 && trace[i - 1] == "attempt_finish");
+                    }
+                }
+            }
+        }
+        for stage in ["spawn", "wait"] {
+            let timeline = Rc::new(RefCell::new(Vec::new()));
+            let mut log = MemoryLog {
+                events: Vec::new(),
+                timeline: timeline.clone(),
+                fail_at: None,
+            };
+            let mut runner = ScriptedRunner {
+                results: VecDeque::from([Err(RunError {
+                    stage,
+                    child_pid: None,
+                    source: io::Error::other("injected execution error"),
+                })]),
+                seen: Vec::new(),
+                timeline,
+            };
+            assert!(
+                execute(
+                    1,
+                    Operation::Fetch,
+                    &command,
+                    3,
+                    &mut log,
+                    &mut runner,
+                    &mut |_| panic!("execution I/O failure must not retry")
+                )
+                .is_err()
+            );
+            assert_eq!(runner.seen.len(), 1);
+            assert_eq!(log.events[1]["event"], "execution_error");
+        }
+        let temp = tempfile::tempdir().unwrap();
+        fs::set_permissions(temp.path(), fs::Permissions::from_mode(0o700)).unwrap();
+        let destination = temp.path().join("output");
+        let lock = temp.path().join("lock.json");
+        fs::write(&lock, b"exact test lock").unwrap();
+        assert!(GitTransportRetry::new(3, None, &destination, &lock).is_err());
+        assert!(GitTransportRetry::new(2, None, &destination, &lock).is_err());
+        let journal = temp.path().join("attempts.jsonl");
+        let mut policy = GitTransportRetry::new(3, Some(&journal), &destination, &lock).unwrap();
+        policy
+            .journal
+            .as_mut()
+            .unwrap()
+            .record(&json!({"event":"byte_integrity","hex":hex::encode(b"\0\xff")}))
+            .unwrap();
+        assert_eq!(fs::metadata(&journal).unwrap().mode() & 0o777, 0o600);
+        let original = fs::read(&journal).unwrap();
+        assert!(GitTransportRetry::new(3, Some(&journal), &destination, &lock).is_err());
+        assert_eq!(fs::read(&journal).unwrap(), original);
+        fs::create_dir(&destination).unwrap();
+        fs::set_permissions(&destination, fs::Permissions::from_mode(0o700)).unwrap();
+        assert!(
+            GitTransportRetry::new(
+                3,
+                Some(&destination.join("inside.jsonl")),
+                &destination,
+                &lock
+            )
+            .is_err()
+        );
+        let shared = temp.path().join("shared");
+        fs::create_dir(&shared).unwrap();
+        fs::set_permissions(&shared, fs::Permissions::from_mode(0o755)).unwrap();
+        assert!(
+            GitTransportRetry::new(3, Some(&shared.join("journal")), &destination, &lock).is_err()
+        );
+    }
+}
