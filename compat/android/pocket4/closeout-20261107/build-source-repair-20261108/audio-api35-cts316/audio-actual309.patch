+
+    srcs: [
+        "main/*/src/test/**/*.java",
+    ],
+    java_resource_dirs: ["main/*/src/test/resources"],
+
+    exclude_srcs: ["main/localespi/src/test/**/*.java"],
+    exclude_java_resource_dirs: ["main/localespi/src/test"],
+
+    static_libs: [
+        "gson",
+        "icu4j",
+        "icu4j-testdata",
+        "junit-params",
