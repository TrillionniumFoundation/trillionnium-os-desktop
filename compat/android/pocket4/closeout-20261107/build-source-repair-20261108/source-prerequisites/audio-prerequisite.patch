++// One synchronous input stream owns this object. The host writes real captured
++// PCM into a fixed shared block. Only an exact successful ACK authorizes copying
++// those bytes to the Android caller. Lost/invalid ACKs terminate this connection;
++// no samples, empty chunks, randomness or elapsed time stand in for microphone data.
++class DroidloomCaptureBridge {
++  public:
++    static constexpr uint32_t kMagic = 0x31435544;  // "DUC1", little endian.
++    static constexpr uint32_t kCapacity = 65536;
++    static constexpr uint32_t kRate = 48000;
++    static constexpr uint32_t kChannels = 1;
++    static constexpr uint32_t kFormatS16Le = 1;
++    static constexpr size_t kFrameBytes = 2;
++    static constexpr uint32_t kLatencyUnknown = UINT32_MAX;
++    enum class Op : uint32_t { Hello = 1, Start = 2, Read = 3, Pause = 4,
++                              Flush = 5, Drain = 6, Standby = 7, Status = 8 };
++
++    explicit DroidloomCaptureBridge(std::string socketPath) : mPath(std::move(socketPath)) {}
++    ~DroidloomCaptureBridge() { closeDescriptors(); }
++    DroidloomCaptureBridge(const DroidloomCaptureBridge&) = delete;
++    DroidloomCaptureBridge& operator=(const DroidloomCaptureBridge&) = delete;
++
++    int start() {
++        const auto deadline = Clock::now() + std::chrono::milliseconds(kTimeoutMs);
++        int status = connectIfNeeded(deadline);
++        if (status == 0) status = command(Op::Start, deadline);
++        if (status == 0) { mStarted = true; mDraining = false; }
++        return status;
++    }
++    int pause() { return command(Op::Pause); }
++    int drain() {
++        const int status = command(Op::Drain);
++        if (status == 0) mDraining = true;
++        return status;
++    }
++    int flush() { return retire(Op::Flush); }
++    int standby() { return retire(Op::Standby); }
++
++    int transfer(void* destination, size_t frames, size_t* received, int32_t* latencyMs) {
++        if (received == nullptr || latencyMs == nullptr) return -EINVAL;
++        *received = 0;
++        *latencyMs = -1;
++        if (mFailed) return -EPIPE;
++        if (frames == 0) return 0;
++        if (destination == nullptr || !mStarted || mSocket < 0) return fail(-EINVAL);
++        // A partial result is legal. One bounded request prevents an arbitrary
++        // client frame count from multiplying the absolute operation deadline.
++        const uint32_t chunk = static_cast<uint32_t>(
++                std::min(frames, static_cast<size_t>(kCapacity / kFrameBytes)));
++        uint32_t captured = 0;
++        const int status = exchange(Op::Read, chunk, -1, &captured);
++        if (status != 0) return status;
++        if (captured == 0 && !mDraining) return fail(-ENODATA);
++        if (captured != 0) std::memcpy(destination, mMemory, captured * kFrameBytes);
++        *received = captured;
++        *latencyMs = mLatencyUs == kLatencyUnknown ? -1
++                                                 : static_cast<int32_t>((mLatencyUs + 999ULL) / 1000);
++        if (mDraining) closeDescriptors();
++        return 0;
++    }
++
++    // Closing cancels this private record stream. Nothing is retained/replayed.
++    void shutdown() { closeDescriptors(); }
++
++  private:
++    using Clock = std::chrono::steady_clock;
++    using Packet = std::array<uint8_t, 32>;
++    static constexpr int kTimeoutMs = 1500;
++
++    static void put(Packet* packet, size_t word, uint32_t value) {
++        for (size_t i = 0; i < 4; ++i) (*packet)[word * 4 + i] = (value >> (i * 8)) & 255;
++    }
++    static uint32_t get(const Packet& packet, size_t word) {
++        uint32_t value = 0;
++        for (size_t i = 0; i < 4; ++i) value |= static_cast<uint32_t>(packet[word * 4 + i]) << (i * 8);
++        return value;
++    }
++
++    int waitFor(short events, Clock::time_point deadline) const {
++        for (;;) {
++            const auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - Clock::now());
++            if (remaining.count() <= 0) return -ETIMEDOUT;
++            pollfd descriptor{mSocket, events, 0};
++            const int result = poll(&descriptor, 1, static_cast<int>(remaining.count()));
++            if (result < 0 && errno == EINTR) continue;
++            if (result < 0) return -errno;
++            if (result == 0) return -ETIMEDOUT;
++            if (descriptor.revents & POLLNVAL) return -EBADF;
++            if (descriptor.revents & events) return 0;
++            if (descriptor.revents & (POLLERR | POLLHUP)) return -EPIPE;
++        }
++    }
++
++    int fail(int error) {
++        mFailed = true;
++        closeDescriptors();
++        return error;
++    }
++
++    int retire(Op op) {
++        if (mFailed) return -EPIPE;
++        if (mSocket < 0) return 0;
++        const int status = command(op);
++        closeDescriptors();
++        return status;
++    }
++
++    void closeDescriptors() {
++        if (mMemory != MAP_FAILED) munmap(mMemory, kCapacity);
++        mMemory = MAP_FAILED;
++        if (mMemoryFd >= 0) close(mMemoryFd);
++        mMemoryFd = -1;
++        if (mSocket >= 0) close(mSocket);
++        mSocket = -1;
++        mLatencyUs = kLatencyUnknown;
++        mStarted = false;
++        mDraining = false;
++    }
++
++    int connectIfNeeded(Clock::time_point deadline = Clock::time_point::max()) {
++        if (mFailed) return -EPIPE;
++        if (mSocket >= 0) return 0;
++        sockaddr_un address{};
++        if (mPath.empty() || mPath[0] != '/' || mPath.size() >= sizeof(address.sun_path)) return fail(-EINVAL);
++        address.sun_family = AF_UNIX;
++        std::memcpy(address.sun_path, mPath.c_str(), mPath.size() + 1);
++        mSocket = socket(AF_UNIX, SOCK_SEQPACKET | SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
++        if (mSocket < 0) return fail(-errno);
++        if (connect(mSocket, reinterpret_cast<const sockaddr*>(&address), sizeof(address)) != 0) {
++            if (errno != EINPROGRESS) return fail(-errno);
++            const int status = waitFor(POLLOUT, std::min(
++                    deadline, Clock::now() + std::chrono::milliseconds(kTimeoutMs)));
++            if (status != 0) return fail(status);
++            int socketError = 0;
++            socklen_t size = sizeof(socketError);
++            if (getsockopt(mSocket, SOL_SOCKET, SO_ERROR, &socketError, &size) != 0) return fail(-errno);
++            if (socketError != 0) return fail(-socketError);
++        }
++        mMemoryFd = static_cast<int>(syscall(SYS_memfd_create, "droidloom-pcm-input", MFD_CLOEXEC | MFD_ALLOW_SEALING));
++        if (mMemoryFd < 0) return fail(-errno);
++        if (ftruncate(mMemoryFd, kCapacity) != 0) return fail(-errno);
++        if (fcntl(mMemoryFd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_SEAL) != 0) return fail(-errno);
++        mMemory = mmap(nullptr, kCapacity, PROT_READ, MAP_SHARED, mMemoryFd, 0);
++        if (mMemory == MAP_FAILED) return fail(-errno);
++        mSequence = 0;
++        return exchange(Op::Hello, 0, mMemoryFd, nullptr, deadline);
++    }
++
++    int command(Op op, Clock::time_point deadline = Clock::time_point::max()) {
++        if (mFailed || mSocket < 0) return -EPIPE;
++        return exchange(op, 0, -1, nullptr, deadline);
++    }
++
++    int exchange(Op op, uint32_t frames, int descriptor, uint32_t* consumed,
++                 Clock::time_point outerDeadline = Clock::time_point::max()) {
++        if (mSequence == UINT32_MAX) return fail(-EOVERFLOW);
++        const uint32_t sequence = ++mSequence;
++        Packet request{};
++        put(&request, 0, kMagic); put(&request, 1, static_cast<uint32_t>(op));
++        put(&request, 2, sequence); put(&request, 3, frames);
++        put(&request, 4, kRate); put(&request, 5, kChannels);
++        put(&request, 6, kFormatS16Le); put(&request, 7, kCapacity);
++        iovec payload{request.data(), request.size()};
++        msghdr message{};
++        message.msg_iov = &payload; message.msg_iovlen = 1;
++        alignas(cmsghdr) std::array<uint8_t, CMSG_SPACE(sizeof(int))> control{};
++        if (descriptor >= 0) {
++            message.msg_control = control.data(); message.msg_controllen = control.size();
++            cmsghdr* cmsg = CMSG_FIRSTHDR(&message);
++            cmsg->cmsg_level = SOL_SOCKET; cmsg->cmsg_type = SCM_RIGHTS;
++            cmsg->cmsg_len = CMSG_LEN(sizeof(int));
++            std::memcpy(CMSG_DATA(cmsg), &descriptor, sizeof(descriptor));
++        }
++        const auto deadline = std::min(
++                outerDeadline, Clock::now() + std::chrono::milliseconds(kTimeoutMs));
++        for (;;) {
++            int status = waitFor(POLLOUT, deadline);
++            if (status != 0) return fail(status);
++            const ssize_t sent = sendmsg(mSocket, &message, MSG_NOSIGNAL);
++            if (sent < 0 && (errno == EINTR || errno == EAGAIN)) continue;
++            if (sent < 0) return fail(-errno);
++            if (sent != static_cast<ssize_t>(request.size())) return fail(-EPROTO);
++            break;
++        }
++        Packet reply{};
++        for (;;) {
++            const int status = waitFor(POLLIN, deadline);
++            if (status != 0) return fail(status);
++            iovec data{reply.data(), reply.size()};
++            msghdr response{};
++            response.msg_iov = &data;
++            response.msg_iovlen = 1;
++            // No ancillary buffer: unexpected SCM_RIGHTS are closed by Linux
++            // and indicated by MSG_CTRUNC, which makes the stream terminal.
++            const ssize_t received = recvmsg(mSocket, &response, MSG_TRUNC | MSG_CMSG_CLOEXEC);
++            if (response.msg_flags & (MSG_TRUNC | MSG_CTRUNC)) return fail(-EPROTO);
++            if (received < 0 && (errno == EINTR || errno == EAGAIN)) continue;
++            if (received < 0) return fail(-errno);
++            if (received == 0) {
++                // EOF and an empty record both leave capture unacknowledged.
++                return fail(-EPROTO);
++            }
++            if (received != static_cast<ssize_t>(reply.size())) return fail(-EPROTO);
++            break;
++        }
++        if (get(reply, 0) != kMagic || get(reply, 1) != static_cast<uint32_t>(op) ||
++            get(reply, 2) != sequence || get(reply, 7) != 0) return fail(-EPROTO);
++        const uint32_t error = get(reply, 3);
++        if (error != 0) return fail(error <= 4095 ? -static_cast<int>(error) : -EPROTO);
++        const uint32_t acknowledged = get(reply, 4);
++        if (acknowledged > frames || get(reply, 6) != 1) return fail(-EPROTO);
++        if (op != Op::Read && acknowledged != 0) return fail(-EPROTO);
++        if (consumed != nullptr) *consumed = acknowledged;
++        mLatencyUs = get(reply, 5);
++        return 0;
++    }
++
++    const std::string mPath;
++    int mSocket = -1;
++    int mMemoryFd = -1;
++    void* mMemory = MAP_FAILED;
++    uint32_t mSequence = 0;
++    uint32_t mLatencyUs = kLatencyUnknown;
++    bool mFailed = false;
++    bool mStarted = false;
++    bool mDraining = false;
++};
