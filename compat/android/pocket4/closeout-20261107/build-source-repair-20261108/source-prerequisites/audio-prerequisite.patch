++#pragma once
++
++#include <algorithm>
++#include <array>
++#include <cerrno>
++#include <chrono>
++#include <cstddef>
++#include <cstdint>
++#include <cstring>
++#include <fcntl.h>
++#include <limits>
++#include <linux/memfd.h>
++#include <poll.h>
