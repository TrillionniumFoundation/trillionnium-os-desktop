+    #[test]
+    fn geometry_checks_rotated_sources_and_bounds() {
+        let b = buffer();
+        let mut l = layer();
+        assert!(l.validate(800, 600, Some(&b)));
+        l.destination[0] = 1;
+        assert!(!l.validate(800, 600, Some(&b)));
+        l.destination[0] = 0;
+        l.transform = 1;
+        assert!(!l.validate(800, 600, Some(&b)));
+        l.source = [0, 0, 600 * 256, 800 * 256];
+        assert!(l.validate(800, 600, Some(&b)));
+        l.source[0] = u32::MAX;
+        assert!(!l.validate(800, 600, Some(&b)));
