+            let path = jar.path();
+            if path.extension().is_none_or(|e| e != "jar") {
+                continue;
+            }
+            let stem = path.file_stem().unwrap().to_str().ok_or("bad SDK name")?;
+            if !project_fallback_sdk_import(stem) {
+                continue;
+            }
