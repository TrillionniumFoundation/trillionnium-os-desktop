diff --git a/packaging/compat/lmkd.rc b/packaging/compat/lmkd.rc
new file mode 100644
index 0000000000000000000000000000000000000000..497e045597a05b659be3cd432aeecf38929d5966
--- /dev/null
+++ b/packaging/compat/lmkd.rc
@@ -0,0 +1,17 @@
+# Droidloom development-only first-pixels policy.
+#
+# The stock Android 17 lmkd exits in libmemevents while entering a shared-kernel
+# cell. ActivityManager synchronously waits for its control socket while holding
+# the global activity lock, so leaving the socket disconnected makes every app
+# process time out during attach. The narrow Rust endpoint drains process-score
+# updates and returns zero/success for synchronous commands, but never kills a
+# process. Production memory policy remains owned by the enclosing runtime.
+
+service lmkd /vendor/bin/droidloom-lmkd-compat
+    class core
+    user lmkd
+    group lmkd system readproc
+    capabilities DAC_OVERRIDE KILL IPC_LOCK SYS_NICE SYS_RESOURCE
+    socket lmkd seqpacket+passcred 0660 system system
+    task_profiles ServiceCapacityLow
+    stdio_to_kmsg
diff --git a/packaging/compat/netd.rc b/packaging/compat/netd.rc
new file mode 100644
index 0000000000000000000000000000000000000000..66e6b290c945ed74f3a1f8c2ecc43950b64decc9
--- /dev/null
+++ b/packaging/compat/netd.rc
@@ -0,0 +1,35 @@
+# Android normally relies on its device kernel policy when netd performs its
+# boot-time BPF map self-test. Droidloom deliberately leaves the shared host
+# kernel's unprivileged-BPF lock enabled, so netd must retain the dedicated
+# CAP_BPF capability instead. All network administration remains confined to
+# the cell's network namespace.
+service netd1shot /system/bin/netd oneshot
+    disabled
+    class main
+    capabilities CHOWN DAC_OVERRIDE DAC_READ_SEARCH FOWNER IPC_LOCK KILL NET_ADMIN NET_BIND_SERVICE NET_RAW SETUID SETGID BPF
+    user root
+    group root net_admin
+    rlimit memlock 1073741824 1073741824
+    updatable
+    oneshot
+    reboot_on_failure reboot,netd1shot-fail
+
+service netd /system/bin/netd
+    disabled
+    class main
+    capabilities CHOWN DAC_OVERRIDE DAC_READ_SEARCH FOWNER IPC_LOCK KILL NET_ADMIN NET_BIND_SERVICE NET_RAW SETUID SETGID BPF
+    user root
+    group root net_admin
+    rlimit memlock 1073741824 1073741824
+    socket dnsproxyd stream 0660 root inet
+    socket mdns stream 0660 root system
+    socket fwmarkd stream 0660 root inet
+    updatable
+    onrestart restart zygote
+    onrestart restart zygote_secondary
+
+on property:persist.vendor.net.doxlat=true
+    setprop net.464xlat.cellular.enabled true
+
+on property:persist.vendor.net.doxlat=false
+    setprop net.464xlat.cellular.enabled false
