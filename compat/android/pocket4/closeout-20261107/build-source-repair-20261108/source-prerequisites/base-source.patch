new file mode 100644
index 0000000000000000000000000000000000000000..ace98f4ebd04c595f5f160e399b0aeda0aa34220
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/apk.rs
@@ -0,0 +1,303 @@
+//! APK descriptor transport and bounded package-manager invocation.
+
+use std::fs::File;
+use std::io::{self, Seek, SeekFrom};
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::os::unix::fs::FileExt;
+use std::os::unix::net::UnixStream;
+use std::process::{Command, Stdio};
+
+use super::{ControlError, diagnostics, io_error};
+
+const MAX_APK_BYTES: u64 = 2 * 1024 * 1024 * 1024;
+
+pub(super) fn validate(file: &File) -> Result<u64, ControlError> {
+    let metadata = file.metadata().map_err(|e| io_error("inspect APK", e))?;
+    if !metadata.is_file() || !(4..=MAX_APK_BYTES).contains(&metadata.len()) {
+        return Err(ControlError::Invalid(
+            "APK must be a nonempty regular file no larger than 2 GiB".into(),
+        ));
+    }
+    let mut magic = [0; 4];
+    file.read_exact_at(&mut magic, 0)
+        .map_err(|e| io_error("read APK header", e))?;
+    if magic != *b"PK\x03\x04" {
+        return Err(ControlError::Invalid(
+            "file is not an APK (expected a ZIP archive); supply a standalone .apk".into(),
+        ));
+    }
+    Ok(metadata.len())
+}
+
+pub(super) fn install(pid: u32, user: u32, mut file: File) -> Result<(), ControlError> {
+    let bytes = validate(&file)?;
+    file.seek(SeekFrom::Start(0))
+        .map_err(|e| io_error("rewind APK", e))?;
+    let mut command = install_command(pid, user, bytes);
+    let output = diagnostics::capture_with_stdin(&mut command, Stdio::from(file))
+        .map_err(|error| ControlError::Invalid(format!("APK installation failed: {error}")))?;
+    check_result(&output)
+}
+
+fn install_command(pid: u32, user: u32, bytes: u64) -> Command {
+    let mut command = droidloom_cpu_placement::command("/usr/bin/timeout");
+    command
+        .args(["--kill-after=5s", "110s", "/usr/bin/nsenter", "--target"])
+        .arg(pid.to_string())
+        .args([
+            "--mount",
+            "--uts",
+            "--ipc",
+            "--net",
+            "--pid",
+            "--cgroup",
+            "--root",
+            "--wd",
+            "--env",
+            "--",
+            "/system/bin/cmd",
+            "package",
+            "install",
+            "-r",
+            "--user",
+        ])
+        .arg(user.to_string())
+        .arg("-S")
+        .arg(bytes.to_string());
+    // With -S and no path, PackageManagerShellCommand reads stdin. A bare
+    // trailing '-' is consumed by its option parser and rejected before install.
+    command
+}
+
+fn check_result(output: &str) -> Result<(), ControlError> {
+    if output.lines().any(|line| line.trim() == "Success") && !output.contains("Failure [") {
+        Ok(())
+    } else {
+        Err(ControlError::Invalid(format!(
+            "Android did not confirm APK installation: {}",
+            output.trim()
+        )))
+    }
+}
+
+// A cmsghdr-aligned buffer large enough to receive several descriptors, so
+// malformed clients' extra descriptors can be owned and closed on rejection.
+#[repr(C)]
+struct Ancillary {
+    header: libc::cmsghdr,
+    extra: [usize; 32],
+}
+
+pub(super) fn send_file(stream: &UnixStream, first: u8, file: &File) -> Result<(), ControlError> {
+    // SAFETY: zero is a valid initial representation for these C structs.
+    let mut control: Ancillary = unsafe { std::mem::zeroed() };
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    let mut byte = first;
+    let mut vector = libc::iovec {
+        iov_base: std::ptr::from_mut(&mut byte).cast(),
+        iov_len: 1,
+    };
+    message.msg_iov = &raw mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = std::ptr::from_mut(&mut control).cast();
+    // SAFETY: the buffer is aligned and larger than CMSG_SPACE for one fd;
+    // all referenced objects remain alive for the synchronous sendmsg call.
+    let result = unsafe {
+        message.msg_controllen = libc::CMSG_SPACE(size_of::<libc::c_int>() as u32) as usize;
+        let header = libc::CMSG_FIRSTHDR(&message);
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(size_of::<libc::c_int>() as u32) as usize;
+        libc::CMSG_DATA(header)
+            .cast::<libc::c_int>()
+            .write_unaligned(file.as_raw_fd());
+        libc::sendmsg(stream.as_raw_fd(), &message, libc::MSG_NOSIGNAL)
+    };
+    if result != 1 {
+        return Err(io_error("send APK descriptor", io::Error::last_os_error()));
+    }
+    Ok(())
+}
+
+pub(super) fn receive_file(stream: &UnixStream) -> Result<(u8, Option<File>), ControlError> {
+    // SAFETY: zero is a valid initial representation for these C structs.
+    let mut control: Ancillary = unsafe { std::mem::zeroed() };
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    let mut byte = 0_u8;
+    let mut vector = libc::iovec {
+        iov_base: std::ptr::from_mut(&mut byte).cast(),
+        iov_len: 1,
+    };
+    message.msg_iov = &raw mut vector;
+    message.msg_iovlen = 1;
+    message.msg_control = std::ptr::from_mut(&mut control).cast();
+    message.msg_controllen = size_of::<Ancillary>();
+    // SAFETY: the iovec and aligned control storage are writable and remain
+    // alive throughout the call. CLOEXEC prevents leaking received fds to children.
+    let result =
+        unsafe { libc::recvmsg(stream.as_raw_fd(), &raw mut message, libc::MSG_CMSG_CLOEXEC) };
+    if result < 0 {
+        return Err(io_error(
+            "receive lifecycle descriptor",
+            io::Error::last_os_error(),
+        ));
+    }
+    let mut files = Vec::new();
+    // SAFETY: recvmsg supplies valid kernel-checked cmsghdr records within our
+    // aligned buffer. Each SCM_RIGHTS fd is newly owned and wrapped exactly once,
+    // including extras that must be closed if the request is rejected.
+    unsafe {
+        let mut header = libc::CMSG_FIRSTHDR(&message);
+        while !header.is_null() {
+            if (*header).cmsg_level == libc::SOL_SOCKET && (*header).cmsg_type == libc::SCM_RIGHTS {
+                let count =
+                    ((*header).cmsg_len - libc::CMSG_LEN(0) as usize) / size_of::<libc::c_int>();
+                let data = libc::CMSG_DATA(header).cast::<libc::c_int>();
+                for index in 0..count {
+                    files.push(File::from_raw_fd(data.add(index).read_unaligned()));
+                }
+            }
+            header = libc::CMSG_NXTHDR(&message, header);
+        }
+    }
+    if result != 1 || message.msg_flags & libc::MSG_CTRUNC != 0 || files.len() > 1 {
+        return Err(ControlError::Invalid(
+            "expected a lifecycle message with at most one APK descriptor".into(),
+        ));
+    }
+    Ok((byte, files.pop()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::{Read, Write};
+
+    #[test]
+    fn stdin_install_ends_with_size_not_a_bare_dash_option() {
+        let command = install_command(1234, 10, 4567);
+        let args: Vec<_> = command.get_args().map(|s| s.to_str().unwrap()).collect();
+        let android = args
+            .iter()
+            .position(|arg| *arg == "/system/bin/cmd")
+            .unwrap();
+        assert_eq!(
+            &args[android..],
+            &[
+                "/system/bin/cmd",
+                "package",
+                "install",
+                "-r",
+                "--user",
+                "10",
+                "-S",
+                "4567"
+            ]
+        );
+    }
+
+    #[test]
+    fn descriptor_survives_unlink_and_is_close_on_exec() {
+        let mut original = tempfile::NamedTempFile::new().unwrap();
+        original.write_all(b"PK\x03\x04test payload").unwrap();
+        let (sender, receiver) = UnixStream::pair().unwrap();
+        send_file(&sender, b'{', original.as_file()).unwrap();
+        drop(original);
+        let (byte, file) = receive_file(&receiver).unwrap();
+        assert_eq!(byte, b'{');
+        let mut file = file.unwrap();
+        assert_eq!(validate(&file).unwrap(), 16);
+        // SAFETY: fcntl reads flags on the live descriptor and takes no pointer.
+        assert_ne!(
+            unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFD) } & libc::FD_CLOEXEC,
+            0
+        );
+        file.seek(SeekFrom::Start(0)).unwrap();
+        let mut bytes = Vec::new();
+        file.read_to_end(&mut bytes).unwrap();
+        assert_eq!(bytes, b"PK\x03\x04test payload");
+    }
+
+    #[test]
+    fn legacy_json_needs_no_descriptor() {
+        let (mut sender, receiver) = UnixStream::pair().unwrap();
+        sender.write_all(b"{").unwrap();
+        let (byte, file) = receive_file(&receiver).unwrap();
+        assert_eq!(byte, b'{');
+        assert!(file.is_none());
+    }
+
+    #[test]
+    fn rejects_multiple_and_truncated_descriptors() {
+        for count in [2_usize, 100] {
+            let file = tempfile::tempfile().unwrap();
+            let (sender, receiver) = UnixStream::pair().unwrap();
+            let mut byte = b'{';
+            let mut vector = libc::iovec {
+                iov_base: std::ptr::from_mut(&mut byte).cast(),
+                iov_len: 1,
+            };
+            // usize storage provides cmsghdr alignment and enough room for
+            // 100 descriptors, deliberately exceeding the receiver's buffer.
+            let mut storage = [0_usize; 128];
+            // SAFETY: the initialized C structures reference live, aligned
+            // buffers; every outgoing fd is borrowed from the same live file.
+            unsafe {
+                let mut message: libc::msghdr = std::mem::zeroed();
+                message.msg_iov = &raw mut vector;
+                message.msg_iovlen = 1;
+                message.msg_control = storage.as_mut_ptr().cast();
+                let bytes = (count * size_of::<libc::c_int>()) as u32;
+                message.msg_controllen = libc::CMSG_SPACE(bytes) as usize;
+                let header = libc::CMSG_FIRSTHDR(&message);
+                (*header).cmsg_level = libc::SOL_SOCKET;
+                (*header).cmsg_type = libc::SCM_RIGHTS;
+                (*header).cmsg_len = libc::CMSG_LEN(bytes) as usize;
+                let data = libc::CMSG_DATA(header).cast::<libc::c_int>();
+                for index in 0..count {
+                    data.add(index).write_unaligned(file.as_raw_fd());
+                }
+                assert_eq!(
+                    libc::sendmsg(sender.as_raw_fd(), &message, libc::MSG_NOSIGNAL),
+                    1
+                );
+            }
+            assert!(receive_file(&receiver).is_err());
+        }
+    }
+
+    #[test]
+    fn rejects_non_files_empty_oversized_and_non_zip_inputs() {
+        assert!(validate(&File::open("/dev/null").unwrap()).is_err());
+        let mut file = tempfile::tempfile().unwrap();
+        assert!(validate(&file).is_err());
+        file.write_all(b"not an apk").unwrap();
+        assert!(validate(&file).is_err());
+        file.set_len(MAX_APK_BYTES + 1).unwrap();
+        assert!(validate(&file).is_err());
+    }
+
+    #[test]
+    fn requires_explicit_package_manager_success() {
+        assert!(check_result("Success\n").is_ok());
+        for output in [
+            "",
+            "Failure [INSTALL_FAILED_NO_MATCHING_ABIS]",
+            "device is still booting",
+            "Success\nFailure [INSTALL_FAILED_INVALID_APK]",
+        ] {
+            assert!(check_result(output).is_err());
+        }
+    }
+
+    #[test]
+    fn package_command_receives_apk_on_standard_input() {
+        let mut file = tempfile::tempfile().unwrap();
+        file.write_all(b"PK\x03\x04test payload").unwrap();
+        file.seek(SeekFrom::Start(0)).unwrap();
+        let output =
+            diagnostics::capture_with_stdin(&mut droidloom_cpu_placement::command("/usr/bin/cat"), Stdio::from(file))
+                .unwrap();
+        assert_eq!(output.as_bytes(), b"PK\x03\x04test payload");
+    }
+}
diff --git a/runtime/droidloom-supervisor/src/apk_set.rs b/runtime/droidloom-supervisor/src/apk_set.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0d7c14920adb3b7fee934f7d310696086e394ba9
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/apk_set.rs
@@ -0,0 +1,449 @@
+//! Bounded, byte-preserving split APK transport and atomic Android sessions.
+//!
+//! Each original APK remains independently signed. This is an IPC payload, not
+//! a merged/repacked APK. `PackageManager` validates package/version/certificates.
+#![forbid(unsafe_code)]
+
+use super::{ControlError, apk, diagnostics, io_error};
+use std::fs::{File, OpenOptions};
+use std::io::{self, Read, Seek, SeekFrom};
+use std::os::unix::fs::{FileExt, OpenOptionsExt};
+use std::path::PathBuf;
+use std::process::{Command, Stdio};
+use std::time::{Duration, Instant};
+
+const MAX_SPLITS: usize = 32;
+const MAX_TOTAL_BYTES: u64 = 2 * 1024 * 1024 * 1024;
+const SESSION_BUDGET: Duration = Duration::from_secs(110);
+
+pub(super) fn prepare(paths: &[PathBuf]) -> Result<(File, Vec<u64>), ControlError> {
+    if !(2..=MAX_SPLITS).contains(&paths.len()) {
+        return Err(invalid("supply 2 through 32 original APK files"));
+    }
+    let mut inputs = Vec::with_capacity(paths.len());
+    let mut lengths = Vec::with_capacity(paths.len());
+    let mut total = 0_u64;
+    for path in paths {
+        let file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_NONBLOCK)
+            .open(path)
+            .map_err(|e| io_error("open split APK with caller permissions", e))?;
+        let length = apk::validate(&file)?;
+        total = total
+            .checked_add(length)
+            .filter(|v| *v <= MAX_TOTAL_BYTES)
+            .ok_or_else(|| invalid("split APK set exceeds 2 GiB"))?;
+        lengths.push(length);
+        inputs.push(file);
+    }
+    // Unlinked, private disk-backed temporary file: no root-side pathname open,
+    // archive extraction, path traversal, or 2-GiB in-memory allocation.
+    let mut payload = tempfile::tempfile().map_err(|e| io_error("create split payload", e))?;
+    for (file, length) in inputs.iter_mut().zip(&lengths) {
+        let copied = io::copy(&mut (&mut *file).take(*length), &mut payload)
+            .map_err(|e| io_error("copy original split bytes", e))?;
+        if copied != *length
+            || file
+                .metadata()
+                .map_err(|e| io_error("recheck split length", e))?
+                .len()
+                != *length
+        {
+            return Err(invalid("split APK length changed during preparation"));
+        }
+    }
+    validate(&payload, &lengths)?;
+    payload
+        .rewind()
+        .map_err(|e| io_error("rewind split payload", e))?;
+    Ok((payload, lengths))
+}
+
+pub(super) fn validate(file: &File, lengths: &[u64]) -> Result<u64, ControlError> {
+    if !(2..=MAX_SPLITS).contains(&lengths.len()) {
+        return Err(invalid("split descriptor requires 2 through 32 lengths"));
+    }
+    let metadata = file
+        .metadata()
+        .map_err(|e| io_error("inspect split payload", e))?;
+    if !metadata.is_file() {
+        return Err(invalid("split payload must be a regular file"));
+    }
+    let mut total = 0_u64;
+    for &length in lengths {
+        if length < 4 {
+            return Err(invalid("each split must contain an APK ZIP header"));
+        }
+        total = total
+            .checked_add(length)
+            .filter(|v| *v <= MAX_TOTAL_BYTES)
+            .ok_or_else(|| invalid("split APK set exceeds 2 GiB"))?;
+    }
+    if metadata.len() != total {
+        return Err(invalid(
+            "split payload size does not match declared lengths",
+        ));
+    }
+    let mut offset = 0;
+    for &length in lengths {
+        let mut magic = [0; 4];
+        file.read_exact_at(&mut magic, offset)
+            .map_err(|e| io_error("read split header", e))?;
+        if magic != *b"PK\x03\x04" {
+            return Err(invalid("a split is not an APK ZIP archive"));
+        }
+        offset += length;
+    }
+    Ok(total)
+}
+
+pub(super) fn install(
+    pid: u32,
+    user: u32,
+    file: File,
+    lengths: &[u64],
+) -> Result<(), ControlError> {
+    transact(file, lengths, user, |args, input, seconds| {
+        let mut command = session_command(pid, args, seconds);
+        diagnostics::capture_with_stdin(&mut command, input.map_or_else(Stdio::null, Stdio::from))
+            .map_err(|e| invalid(&format!("Android split session command failed: {e}")))
+    })
+}
+
+fn session_command(pid: u32, args: &[String], seconds: u64) -> Command {
+    let mut command = droidloom_cpu_placement::command("/usr/bin/timeout");
+    command
+        .args([
+            "--kill-after=5s",
+            &format!("{seconds}s"),
+            "/usr/bin/nsenter",
+            "--target",
+        ])
+        .arg(pid.to_string())
+        .args([
+            "--mount",
+            "--uts",
+            "--ipc",
+            "--net",
+            "--pid",
+            "--cgroup",
+            "--root",
+            "--wd",
+            "--env",
+            "--",
+            "/system/bin/cmd",
+            "package",
+        ])
+        .args(args);
+    command
+}
+
+fn transact<F>(mut file: File, lengths: &[u64], user: u32, mut call: F) -> Result<(), ControlError>
+where
+    F: FnMut(&[String], Option<File>, u64) -> Result<String, ControlError>,
+{
+    let total = validate(&file, lengths)?;
+    let started = Instant::now();
+    let budget = || {
+        SESSION_BUDGET
+            .checked_sub(started.elapsed())
+            .filter(|d| !d.is_zero())
+            .map(|d| d.as_secs().max(1))
+            .ok_or_else(|| invalid("split session overall deadline expired"))
+    };
+    let create = vec![
+        "install-create".into(),
+        "-r".into(),
+        "--user".into(),
+        user.to_string(),
+        "-S".into(),
+        total.to_string(),
+    ];
+    let response = call(&create, None, budget()?)?;
+    let session = parse_session(&response)?;
+    let mut commit_attempted = false;
+    let outcome = (|| {
+        let mut offset = 0;
+        for (index, &length) in lengths.iter().enumerate() {
+            // Explicitly reset the shared open-file-description offset. Android
+            // receives exactly -S bytes from each unchanged APK segment.
+            file.seek(SeekFrom::Start(offset))
+                .map_err(|e| io_error("seek split payload", e))?;
+            let input = file
+                .try_clone()
+                .map_err(|e| io_error("duplicate split payload", e))?;
+            let args = vec![
+                "install-write".into(),
+                "-S".into(),
+                length.to_string(),
+                session.to_string(),
+                format!("split-{index:04}.apk"),
+            ];
+            let output = call(&args, Some(input), budget()?)?;
+            confirm(&output, &format!("Success: streamed {length} bytes"))?;
+            offset += length;
+        }
+        let args = vec!["install-commit".into(), session.to_string()];
+        let seconds = budget()?;
+        commit_attempted = true;
+        confirm(&call(&args, None, seconds)?, "Success")
+    })();
+    if let Err(error) = outcome {
+        let abandon = vec!["install-abandon".into(), session.to_string()];
+        let cleanup = call(&abandon, None, 5).and_then(|output| confirm(&output, "Success"));
+        return Err(invalid(&format!(
+            "{error}; session {session} abandonment: {}; {}",
+            match cleanup {
+                Ok(()) => "confirmed".into(),
+                Err(e) => format!("NOT confirmed ({e})"),
+            },
+            if commit_attempted {
+                "commit was NOT confirmed: inspect installed version before any retry"
+            } else {
+                "commit was not attempted; existing installed app was not uninstalled"
+            }
+        )));
+    }
+    Ok(())
+}
+
+fn parse_session(output: &str) -> Result<u32, ControlError> {
+    let sessions: Vec<_> = output
+        .lines()
+        .filter_map(|line| {
+            line.trim()
+                .strip_prefix("Success: created install session [")
+                .and_then(|s| s.strip_suffix(']'))
+                .filter(|s| !s.is_empty() && s.bytes().all(|b| b.is_ascii_digit()))
+                .and_then(|s| s.parse::<u32>().ok())
+                .filter(|id| *id > 0 && i32::try_from(*id).is_ok())
+        })
+        .collect();
+    if sessions.len() != 1 || output.contains("Failure") || output.contains("Error:") {
+        return Err(invalid(
+            "Android did not identify exactly one created session; inspect outstanding sessions before retry",
+        ));
+    }
+    Ok(sessions[0])
+}
+
+fn confirm(output: &str, expected: &str) -> Result<(), ControlError> {
+    if output.lines().any(|line| line.trim() == expected)
+        && !output.contains("Failure")
+        && !output.contains("Error:")
+    {
+        Ok(())
+    } else {
+        Err(invalid(&format!(
+            "Android did not confirm {expected:?}: {}",
+            output.trim()
+        )))
+    }
+}
+
+fn invalid(message: &str) -> ControlError {
+    ControlError::Invalid(message.into())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::io::Write;
+    fn payload() -> File {
+        let mut file = tempfile::tempfile().unwrap();
+        file.write_all(b"PK\x03\x04basePK\x03\x04split").unwrap();
+        file
+    }
+    #[test]
+    fn validates_original_segment_headers_and_exact_total() {
+        let file = payload();
+        assert_eq!(validate(&file, &[8, 9]).unwrap(), 17);
+        for sizes in [
+            vec![],
+            vec![17],
+            vec![8, 8],
+            vec![9, 8],
+            vec![3, 14],
+            vec![4; 33],
+            vec![u64::MAX, 8],
+        ] {
+            assert!(validate(&file, &sizes).is_err(), "{sizes:?}");
+        }
+        assert!(validate(&File::open("/dev/null").unwrap(), &[8, 9]).is_err());
+    }
+    #[test]
+    fn requires_unambiguous_bounded_positive_session_identity() {
+        assert_eq!(
+            parse_session("Success: created install session [12]\n").unwrap(),
+            12
+        );
+        for value in [
+            "Success",
+            "Success: created install session [-1]",
+            "Success: created install session [0]",
+            "Success: created install session [2147483648]",
+            "Success: created install session [1]\nFailure [bad]",
+            "Success: created install session [1]\nSuccess: created install session [2]",
+        ] {
+            assert!(parse_session(value).is_err(), "{value}");
+        }
+    }
+    #[test]
+    fn success_is_exact_and_failure_cannot_be_hidden() {
+        assert!(confirm("Success: streamed 8 bytes\n", "Success: streamed 8 bytes").is_ok());
+        for s in [
+            "Success",
+            "Success: streamed 9 bytes",
+            "Success: streamed 8 bytes\nFailure [bad]",
+            "Success: streamed 8 bytes\nError: bad",
+        ] {
+            assert!(confirm(s, "Success: streamed 8 bytes").is_err());
+        }
+    }
+    #[test]
+    fn preserves_bytes_then_commits_once_without_uninstall_or_downgrade() {
+        let mut seen = Vec::new();
+        let mut bodies = Vec::new();
+        transact(payload(), &[8, 9], 10, |args, input, seconds| {
+            assert!((1..=110).contains(&seconds));
+            seen.push(args.to_vec());
+            match args[0].as_str() {
+                "install-create" => Ok("Success: created install session [23]".into()),
+                "install-write" => {
+                    let length = args[2].parse::<u64>().unwrap();
+                    let mut body = Vec::new();
+                    input.unwrap().take(length).read_to_end(&mut body).unwrap();
+                    bodies.push(body);
+                    Ok(format!("Success: streamed {length} bytes"))
+                }
+                "install-commit" => Ok("Success".into()),
+                _ => panic!("unexpected operation"),
+            }
+        })
+        .unwrap();
+        assert_eq!(
+            bodies,
+            vec![b"PK\x03\x04base".to_vec(), b"PK\x03\x04split".to_vec()]
+        );
+        assert_eq!(seen.len(), 4);
+        assert_eq!(
+            seen[0],
+            vec!["install-create", "-r", "--user", "10", "-S", "17"]
+        );
+        assert_eq!(
+            seen[1],
+            vec!["install-write", "-S", "8", "23", "split-0000.apk"]
+        );
+        assert_eq!(seen[3], vec!["install-commit", "23"]);
+        assert!(
+            !seen
+                .iter()
+                .flatten()
+                .any(|s| s == "uninstall" || s == "-d" || s == "-g")
+        );
+    }
+    #[test]
+    fn failed_write_abandons_and_never_commits() {
+        let mut calls = Vec::new();
+        let error = transact(payload(), &[8, 9], 0, |args, _, _| {
+            calls.push(args[0].clone());
+            Ok(match args[0].as_str() {
+                "install-create" => "Success: created install session [7]",
+                "install-abandon" => "Success",
+                _ => "Failure [INSTALL_FAILED_INVALID_APK]",
+            }
+            .into())
+        })
+        .unwrap_err()
+        .to_string();
+        assert_eq!(
+            calls,
+            vec!["install-create", "install-write", "install-abandon"]
+        );
+        assert!(error.contains("abandonment: confirmed"));
+        assert!(error.contains("commit was not attempted"));
+    }
+    #[test]
+    fn failed_commit_and_failed_cleanup_are_not_reported_as_success() {
+        let mut calls = Vec::new();
+        let error = transact(payload(), &[8, 9], 0, |args, _, _| {
+            calls.push(args[0].clone());
+            match args[0].as_str() {
+                "install-create" => Ok("Success: created install session [4]".into()),
+                "install-write" => Ok(format!("Success: streamed {} bytes", args[2])),
+                _ => Err(invalid("timeout")),
+            }
+        })
+        .unwrap_err()
+        .to_string();
+        assert_eq!(
+            calls
+                .iter()
+                .filter(|v| v.as_str() == "install-commit")
+                .count(),
+            1
+        );
+        assert_eq!(calls.last().unwrap(), "install-abandon");
+        assert!(error.contains("NOT confirmed"));
+        assert!(error.contains("before any retry"));
+    }
+    #[test]
+    fn invalid_payload_never_creates_a_session() {
+        assert!(
+            transact(payload(), &[8, 8], 0, |_, _, _| panic!(
+                "must not contact Android"
