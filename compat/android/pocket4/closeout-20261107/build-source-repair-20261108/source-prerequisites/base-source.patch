+    #[test]
+    fn task_receiver_rejects_point_regression_and_release_mismatch() {
+        let mut state = receiver();
+        state
+            .present(OBJECT, FrameId(1), BufferId(11), 5, 7, 8, Vec::new())
+            .unwrap();
+        assert_eq!(
