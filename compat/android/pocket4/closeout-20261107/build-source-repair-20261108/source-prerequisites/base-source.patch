+        final long eventTime = Math.max(gesture.downTimeMillis, record.timestampNanos / 1_000_000L);
+        final MotionEvent event = MotionEvent.obtain(
+                gesture.downTimeMillis,
+                eventTime,
+                action,
+                pointerCount,
+                properties,
+                coordinates,
+                0,
+                0,
+                1.0f,
+                1.0f,
+                0,
+                0,
+                InputDevice.SOURCE_TOUCHSCREEN,
