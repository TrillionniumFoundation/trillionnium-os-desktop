+        let damage = vec![Damage {
+            x: 0,
+            y: 0,
+            width: 1080,
+            height: 2400,
+        }];
+        let accepted = state
+            .present(OBJECT, FrameId(1), BufferId(11), 5, 7, 8, damage)
