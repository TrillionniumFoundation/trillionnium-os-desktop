+}
+
+fn install_multiple_reporting(
+    socket: &Path,
+    paths: &[PathBuf],
+    user: u32,
+    report: Option<&mut dyn FnMut(&str)>,
+) -> Result<ControlResponse, ControlError> {
+    validate_android_user(user)?;
+    let (file, lengths) = apk_set::prepare(paths)?;
+    progress::request(
+        socket,
+        &ControlRequest::InstallMultiple { user, lengths },
+        Some(&file),
+        report,
+    )
