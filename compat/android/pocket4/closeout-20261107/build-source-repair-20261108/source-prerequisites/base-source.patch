diff --git a/packaging/arch/PKGBUILD.in b/packaging/arch/PKGBUILD.in
new file mode 100644
index 0000000000000000000000000000000000000000..b786d6ab164b6f61c6df58ab5f29b09bb08968b9
--- /dev/null
+++ b/packaging/arch/PKGBUILD.in
@@ -0,0 +1,30 @@
+# All build and filesystem work is implemented by the Rust package command.
+pkgbase=droidloom
+pkgname=(droidloom-runtime droidloom-image)
+pkgver=@VERSION@
+pkgrel=@RELEASE@
+arch=(x86_64)
+pkgdesc='Android applications in native Wayland windows'
+url='https://github.com/denialwm/droidloom'
+license=(GPL-3.0-or-later)
+options=(!strip !debug !lto !purge)
+makedepends=(rustup git rsync curl unzip zip meson ninja pkgconf llvm clang glslang
+  spirv-llvm-translator bison flex android-tools erofs-utils e2fsprogs
+  python python-yaml python-mako ccache mesa libdrm wayland libxkbcommon)
+
+build() {
+  "$DROIDLOOM_PACKAGE_TOOL" compile --source "$DROIDLOOM_SOURCE" \
+    --work "$DROIDLOOM_WORK" --destination "$srcdir/payload" --jobs "$DROIDLOOM_JOBS"
+}
+
+package_droidloom-runtime() {
+  depends=("droidloom-image=$pkgver-$pkgrel" glibc gcc-libs mesa libdrm wayland
+    libxkbcommon systemd polkit util-linux e2fsprogs iproute2 nftables iptables)
+  "$DROIDLOOM_PACKAGE_TOOL" install-tree --source "$srcdir/payload/runtime" --destination "$pkgdir"
+}
+
+package_droidloom-image() {
+  pkgdesc='Android system and Droidloom Android components'
+  license=(GPL-3.0-or-later LicenseRef-Android LicenseRef-Mesa)
+  "$DROIDLOOM_PACKAGE_TOOL" install-tree --source "$srcdir/payload/image" --destination "$pkgdir"
+}
diff --git a/packaging/arch/README.md b/packaging/arch/README.md
new file mode 100644
index 0000000000000000000000000000000000000000..e3ae8a171fd8ba30971b27eb054fe764c42c1e9b
--- /dev/null
+++ b/packaging/arch/README.md
@@ -0,0 +1,25 @@
+# Droidloom pacman packaging
+
+User-facing instructions are maintained in:
+
+- [Installation and APKs](../../docs/INSTALL.md)
+- [Building packages](../../docs/BUILDING.md)
+- [Known issues](../../docs/KNOWN_ISSUES.md)
+
+`version.json` defines the matching package release. `PKGBUILD.in` calls the Rust
+builder, and `Containerfile` supplies its rootless Arch environment. The runtime
+and image packages must be installed together. Lifecycle hooks stop the runtime
+before replacement or removal and preserve Android data.
+
+Both packages include Droidloom's GPL notice and license text under
+`/usr/share/licenses/<package>/`. The runtime includes Cargo dependency notices;
+the image includes Android and Mesa notices. See [THIRD_PARTY.md](../../THIRD_PARTY.md)
+for license scope and corresponding-source requirements.
+
+`droidloom-gapps` is a separate, explicitly enabled optional package built from
+a locally supplied archive. See [optional Google apps](../../docs/BUILDING.md#optional-google-apps).
+Managed add-on packages depend on the exact runtime/image release and stop
+Droidloom before upgrade or removal. The standalone ARM developer package has
+no dependency on the x86_64 package workflow and requires an explicit stop
+before installation, replacement or removal. Neither form starts Android or
+changes its data automatically.
