+        let first = reconcile(&paths, &mut source).unwrap();
+        assert_eq!(first.applications, 1);
+        assert_eq!(first.launchers_updated, 1);
+        assert_eq!(first.icons_updated, 1);
+        assert_eq!(source.icon_requests, 1);
