+    private void inject(TouchRecord record) {
+        final long gestureIdentity = taskIdentity(record.displayId, record.taskId);
+        Gesture gesture = mGestures.get(gestureIdentity);
+        if (record.action == TOUCH_ACTION_DOWN) {
+            if (gesture == null) {
