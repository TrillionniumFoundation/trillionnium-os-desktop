+    #[test]
+    fn reconciliation_is_atomic_idempotent_and_removes_stale_entries() {
+        let temporary = tempfile::tempdir().unwrap();
+        let paths = fixture_paths(temporary.path());
+        let mut source = FixtureSource {
+            user: 0,
+            applications: vec![application(
+                "Firefox",
