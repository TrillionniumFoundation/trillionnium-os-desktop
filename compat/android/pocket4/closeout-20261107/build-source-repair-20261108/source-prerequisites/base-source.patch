+impl Drop for Projection {
+    fn drop(&mut self) {
+        if let Err(e) = self.restore() {
+            eprintln!(
+                "SOURCE RESTORE FAILED: {e}; retained {}",
+                self.journal.display()
+            );
+        }
+    }
