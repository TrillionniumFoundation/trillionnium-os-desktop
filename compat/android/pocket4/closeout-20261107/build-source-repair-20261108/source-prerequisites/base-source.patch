+/// failures (including uncertain commits) remain failures in the response.
+pub fn install_multiple_apks(
+    socket: &Path,
+    paths: &[PathBuf],
+    user: u32,
+) -> Result<ControlResponse, ControlError> {
+    install_multiple_reporting(socket, paths, user, None)
+}
