+        .filter(|filesystem| !filesystem_is_listed(view, filesystem))
+        .copied()
+        .collect();
+    let pass = missing.is_empty();
+    check(
+        "kernel.mount_filesystems",
+        "Synthetic cell filesystem support",
+        if pass {
+            CheckStatus::Pass
+        } else {
+            CheckStatus::Fail
+        },
+        true,
+        vec![format!(
+            "required filesystems missing: {}",
+            if missing.is_empty() {
+                "none".to_owned()
+            } else {
+                missing.join(", ")
