+ 
+     const uint32_t zero = 0;
+-    const uint32_t my_pid = getpid();
++    auto pid = netdBpfPid();
++    if (!pid.ok()) return pid.error();
++    const uint32_t my_pid = pid.value();
+     RETURN_IF_NOT_OK(mNetdPidMap.writeValue(zero, my_pid, BPF_ANY));
+ 
+     return {};
