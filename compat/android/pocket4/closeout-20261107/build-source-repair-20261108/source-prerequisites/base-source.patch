+fn qualified_defaults_mode(mode: SoongDependencyMode) -> bool {
+    matches!(mode, SoongDependencyMode::NativeEngineTargetClosure
+        | SoongDependencyMode::MinigbmTargetClosure | SoongDependencyMode::AudioApexTargetClosure)
