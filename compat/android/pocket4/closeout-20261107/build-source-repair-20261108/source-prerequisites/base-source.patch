+        assert_eq!(fs::metadata(&result).unwrap().modified().unwrap(), second_output_time);
+        assert_eq!(fs::read(&input).unwrap(), b"second!\n");
+        assert_eq!(fs::metadata(&input).unwrap().modified().unwrap(), different_old_time);
