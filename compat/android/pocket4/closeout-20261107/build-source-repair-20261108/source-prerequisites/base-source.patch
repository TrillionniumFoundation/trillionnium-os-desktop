+fn check(
+    id: &str,
+    title: &str,
+    status: CheckStatus,
+    blocking: bool,
+    evidence: Vec<String>,
+    remediation: Option<String>,
+) -> Check {
+    Check {
+        id: id.to_owned(),
+        title: title.to_owned(),
+        status,
+        blocking,
+        evidence,
+        remediation,
+    }
+}
