+/// Install original split APKs with progress and the existing bounded wait.
+///
+/// # Errors
+/// Returns invalid-file, transport, or protocol failures.
+pub fn install_multiple_apks_with_progress(
+    socket: &Path,
+    paths: &[PathBuf],
