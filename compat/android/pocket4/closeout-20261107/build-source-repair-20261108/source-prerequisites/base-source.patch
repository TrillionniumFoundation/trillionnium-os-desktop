+        assert_eq!(fs::read(&result).unwrap(), b"second!\n");
+        assert_eq!(fs::metadata(&input).unwrap().modified().unwrap(), old_time);
+
+        // An unrelated source timestamp change must not rewrite identical
+        // destination bytes or cause unnecessary compilation.
+        let second_output_time = fs::metadata(&result).unwrap().modified().unwrap();
+        let different_old_time = old_time + std::time::Duration::from_secs(1);
