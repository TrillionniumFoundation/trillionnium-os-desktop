+//
+// Compile the following entrypoint files as normal but don't link them yet. These are always
+// compiled as Arm64 even during host builds as they will later be transformed into x86_64 format
+// ELF files. See *_arm64_to_x86_64 rules for reference.
+//
+
+cc_defaults {
+    name: "cc_object_simulator_defaults",
+    host_supported: false,
+    defaults: [
+        "art_debug_defaults",
+        "libart_common_defaults",
+        "libartd-runtime_deps",
+    ],
+    // Disable this module if not building for the simulator. This module requires the use of the
+    // cc_device_for_host module which is only allowed to be used when building for the simulator.
+    enabled: select(soong_config_variable("art_module", "art_use_simulator"), {
+        true: true,
+        default: false,
+    }),
+}
+
+cc_object {
+    name: "cc_object_jni_entrypoints_arm64.S",
+    defaults: ["cc_object_simulator_defaults"],
+    srcs: ["arch/arm64/jni_entrypoints_arm64.S"],
+}
+
+cc_object {
+    name: "cc_object_quick_entrypoints_arm64.S",
+    defaults: ["cc_object_simulator_defaults"],
+    srcs: ["arch/arm64/quick_entrypoints_arm64.S"],
+}
+
+// Expose the device only entrypoints to the host build so they can be transformed into x86_64.
+cc_device_for_host {
+    name: "device_jni_entrypoints_arm64.S",
+    srcs: ["cc_object_jni_entrypoints_arm64.S"],
+    // Disable this module if not building for the simulator. This module is only allowed to be
+    // used when building for the simulator.
+    enabled: select(soong_config_variable("art_module", "art_use_simulator"), {
+        true: true,
+        default: false,
+    }),
