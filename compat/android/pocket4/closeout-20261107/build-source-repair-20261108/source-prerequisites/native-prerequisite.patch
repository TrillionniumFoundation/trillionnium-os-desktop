+        let previous: Value = serde_json::from_slice(&previous_raw).unwrap();
+        let expanded: Value = serde_json::from_slice(&fs::read(repo.join(SOURCE_LOCK)).unwrap()).unwrap();
+        validate_hal_provider_lock_extension(&previous, &expanded).unwrap();
+        assert_eq!(previous["projects"].as_array().unwrap().len(), 224);
