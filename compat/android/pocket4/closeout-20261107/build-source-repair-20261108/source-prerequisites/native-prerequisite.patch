+genrule_defaults {
+    name: "arm64_to_x86_64_defaults",
+    host_supported: true,
+    device_supported: false,
+    defaults: ["cc_object_simulator_defaults"],
+    tools: [
+        "transform_arm64_to_x86_64",
+        "llvm-objcopy",
