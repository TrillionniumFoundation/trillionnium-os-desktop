+        .read_to_string(&mut text)
+        .unwrap();
+    assert!(text.len() <= 8192);
+    let mut children: Vec<u32> = text
+        .split_whitespace()
+        .map(|part| {
+            assert!(part.bytes().all(|b| b.is_ascii_digit()));
+            let pid: u32 = part.parse().unwrap();
+            assert!(pid > 0);
+            pid
+        })
