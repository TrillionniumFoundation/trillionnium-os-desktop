+fn current_thread_children() -> Vec<u32> {
+    // SAFETY: gettid has no pointer arguments or side effects.
+    let tid = unsafe { libc::syscall(libc::SYS_gettid) };
+    assert!(tid > 0);
+    let path = format!("/proc/self/task/{tid}/children");
+    let mut text = String::new();
+    fs::File::open(path)
