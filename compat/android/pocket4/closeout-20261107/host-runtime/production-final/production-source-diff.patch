+#[test]
+fn status_and_readiness_use_distinct_single_requests_without_wait_fallback() {
+    use std::io::{Read, Write};
+    use std::os::unix::net::UnixListener;
+    use std::time::{Duration, Instant};
+
+    for (operation, message) in [
+        ("status", "cell u2000000000 is running; Android readiness has not been checked"),
+        ("readiness", "cell u2000000000 is running; waiting for Android to complete boot"),
+    ] {
+        let directory = socket_directory();
+        let socket = directory.path().join("control.sock");
+        let listener = UnixListener::bind(&socket).unwrap();
+        listener.set_nonblocking(true).unwrap();
+        let worker = std::thread::spawn(move || {
+            let deadline = Instant::now() + Duration::from_secs(3);
+            let mut stream = loop {
+                match listener.accept() {
+                    Ok((stream, _)) => break stream,
+                    Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                        assert!(Instant::now() < deadline, "CLI did not send its request");
+                        std::thread::sleep(Duration::from_millis(5));
+                    }
+                    Err(error) => panic!("accept failed: {error}"),
+                }
+            };
+            stream.set_read_timeout(Some(Duration::from_secs(3))).unwrap();
+            stream.set_write_timeout(Some(Duration::from_secs(3))).unwrap();
+            let mut bytes = Vec::new();
+            (&mut stream).take(4097).read_to_end(&mut bytes).unwrap();
+            assert!(bytes.len() <= 4096);
+            let request: serde_json::Value = serde_json::from_slice(&bytes).unwrap();
+            assert_eq!(request["request"], serde_json::json!({"command": operation}));
+            let response = serde_json::json!({
+                "ok": true, "state": "running", "message": message, "host_pid": 2000000001u32
+            });
+            let mut wire = serde_json::to_vec(&response).unwrap();
+            wire.push(b'\n');
+            stream.write_all(&wire).unwrap();
+            // This one-reply listener then closes. The CLI must not reinterpret
+            // an observation as Start or silently make a WaitReady request.
+            response
+        });
+        let output = Command::new(env!("CARGO_BIN_EXE_droidloomctl"))
+            .args(["--socket"]).arg(&socket)
+            .args([operation, "--json"])
+            .output().unwrap();
+        let expected = worker.join().unwrap();
+        assert!(output.status.success(), "{output:?}");
+        assert!(output.stderr.is_empty());
+        let actual: serde_json::Value = serde_json::from_slice(&output.stdout).unwrap();
+        assert_eq!(actual, expected);
+        assert!(!actual["message"].as_str().unwrap().contains("Android is ready"));
+    }
+}
