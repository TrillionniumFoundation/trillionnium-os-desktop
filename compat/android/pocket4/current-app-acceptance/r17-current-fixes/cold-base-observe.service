[Unit]
Description=Disposable original systemd endpoint observation
DefaultDependencies=no

[Service]
Type=oneshot
ExecStart=/fixture/systemd-observer --systemd-observer
TimeoutStartSec=20s
TimeoutStopSec=5s
KillMode=control-group
SendSIGKILL=yes
Restart=no
RemainAfterExit=no
UMask=0077
NoNewPrivileges=yes
StandardInput=null
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttyS1
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no
