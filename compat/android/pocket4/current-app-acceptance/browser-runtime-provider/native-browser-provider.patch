+fn send_browser_runtime_fds(
+    socket: RawFd,
+    packet: &Packet,
+    files: [BorrowedFd<'_>; 4],
+) -> Result<()> {
+    // The original two/three-FD senders remain unchanged. The only new shape
+    // is runtime/init/query/browser, selected by actual PreparedRuntime custody.
+    let mut iov = libc::iovec {
+        iov_base: (packet as *const Packet).cast_mut().cast(),
+        iov_len: std::mem::size_of::<Packet>(),
+    };
+    let mut control = [0_usize; 8];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iov;
+    message.msg_iovlen = 1;
+    message.msg_control = control.as_mut_ptr().cast();
+    message.msg_controllen = unsafe { libc::CMSG_SPACE(16) } as usize;
+    let header = unsafe { libc::CMSG_FIRSTHDR(&message) };
+    if header.is_null() {
+        return Err(NamespaceError::Rejected(
+            "browser runtime ancillary header absent",
+        ));
+    }
+    unsafe {
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(16) as usize;
+        let data = libc::CMSG_DATA(header).cast::<i32>();
+        for (i, file) in files.iter().enumerate() {
+            std::ptr::write_unaligned(data.add(i), file.as_raw_fd());
+        }
+    }
+    let sent = unsafe { libc::sendmsg(socket, &message, libc::MSG_NOSIGNAL | libc::MSG_DONTWAIT) };
+    if sent < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    if sent as usize != std::mem::size_of::<Packet>() {
+        return Err(NamespaceError::Rejected(
+            "incomplete fixed browser-runtime descriptor transfer",
+        ));
+    }
+    Ok(())
+}
