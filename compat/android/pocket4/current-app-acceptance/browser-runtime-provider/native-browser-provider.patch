+// source_path returns O_PATH. Reopen only a fixed held child and compare the
+// complete inode identity before performing xattr reads on the ordinary FD.
+fn browser_open(root: &File, name: &CStr, directory: bool) -> Result<File> {
+    let held = opened(root, name, directory)?;
+    let identity = ImmutableNode::of(&held)?;
+    if identity.mode & libc::S_IFMT
+        != if directory {
+            libc::S_IFDIR
+        } else {
+            libc::S_IFREG
+        }
+    {
+        return Err(NamespaceError::Rejected("browser fixed role type differs"));
+    }
+    let raw = unsafe {
+        libc::openat(
+            root.as_raw_fd(),
+            name.as_ptr(),
+            libc::O_RDONLY
+                | libc::O_NOFOLLOW
+                | libc::O_CLOEXEC
+                | libc::O_NONBLOCK
+                | if directory { libc::O_DIRECTORY } else { 0 },
+        )
+    };
+    if raw < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    let file = unsafe { File::from_raw_fd(raw) };
+    if ImmutableNode::of(&file)? != identity || ImmutableNode::of(&held)? != identity {
+        return Err(NamespaceError::Rejected(
+            "browser fixed role changed while reopening",
+        ));
+    }
+    Ok(file)
+}
