+    fn browser_provider_real_scm_rights_preserves_old_shapes_and_four_role_order() {
+        use std::os::unix::net::UnixDatagram;
+        let files = [
+            tempfile::tempfile().unwrap(),
+            tempfile::tempfile().unwrap(),
+            tempfile::tempfile().unwrap(),
+            tempfile::tempfile().unwrap(),
+        ];
+        let packet = Packet::new([7; 16], Phase::MountRuntime, 0, 123);
+        for count in [2, 3, 4] {
+            let (sender, receiver) = UnixDatagram::pair().unwrap();
+            match count {
+                2 => send_base_fds(
+                    sender.as_raw_fd(),
+                    &packet,
+                    [files[0].as_fd(), files[1].as_fd()],
+                )
+                .unwrap(),
+                3 => send_query_runtime_fds(
+                    sender.as_raw_fd(),
+                    &packet,
+                    [files[0].as_fd(), files[1].as_fd(), files[2].as_fd()],
+                )
+                .unwrap(),
+                4 => send_browser_runtime_fds(
+                    sender.as_raw_fd(),
+                    &packet,
+                    [
+                        files[0].as_fd(),
+                        files[1].as_fd(),
+                        files[2].as_fd(),
+                        files[3].as_fd(),
+                    ],
+                )
+                .unwrap(),
+                _ => unreachable!(),
+            }
+            let mut received = Packet::zeroed();
+            let mut iov = libc::iovec {
+                iov_base: (&mut received as *mut Packet).cast(),
+                iov_len: std::mem::size_of::<Packet>(),
+            };
+            let mut control = [0_usize; 16];
+            let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+            message.msg_iov = &mut iov;
+            message.msg_iovlen = 1;
+            message.msg_control = control.as_mut_ptr().cast();
+            message.msg_controllen = std::mem::size_of_val(&control);
+            assert_eq!(
+                unsafe {
+                    libc::recvmsg(
+                        receiver.as_raw_fd(),
+                        &mut message,
+                        libc::MSG_CMSG_CLOEXEC | libc::MSG_DONTWAIT,
+                    )
+                },
+                std::mem::size_of::<Packet>() as isize
+            );
+            assert_eq!(message.msg_flags & (libc::MSG_TRUNC | libc::MSG_CTRUNC), 0);
+            assert!(received.matches([7; 16], 123));
+            assert_eq!(received.phase, Phase::MountRuntime as u32);
+            let header = unsafe { libc::CMSG_FIRSTHDR(&message) };
+            assert!(!header.is_null());
+            let header_ref = unsafe { &*header };
+            assert_eq!(header_ref.cmsg_level, libc::SOL_SOCKET);
+            assert_eq!(header_ref.cmsg_type, libc::SCM_RIGHTS);
+            assert_eq!(
+                header_ref.cmsg_len,
+                unsafe { libc::CMSG_LEN((count * 4) as u32) } as usize
+            );
+            assert!(unsafe { libc::CMSG_NXTHDR(&message, header) }.is_null());
+            let data = unsafe { libc::CMSG_DATA(header).cast::<i32>() };
+            for (i, original) in files.iter().enumerate().take(count) {
+                let file = unsafe { File::from_raw_fd(std::ptr::read_unaligned(data.add(i))) };
+                assert_eq!(
+                    ImmutableNode::of(&file).unwrap(),
+                    ImmutableNode::of(original).unwrap()
+                );
+                assert_eq!(
+                    unsafe { libc::fcntl(file.as_raw_fd(), libc::F_GETFD) },
+                    libc::FD_CLOEXEC
+                );
+            }
+        }
+    }
