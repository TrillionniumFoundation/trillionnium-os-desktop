+mod tests {
+    use super::*;
+
+    #[test]
+    fn browser_provider_label_matches_frozen_contract_with_exact_nul() {
+        let mut label = droidloom_browser_action_contract::EXECUTABLE_CONTEXT
+            .as_bytes()
+            .to_vec();
+        label.push(0);
+        assert_eq!(BROWSER_EXEC.as_slice(), label.as_slice());
+        assert_ne!(
+            BROWSER_EXEC.as_slice(),
+            b"u:object_r:droidloom_query_exec:s0\0".as_slice()
+        );
+    }
+
+    #[test]
+    fn browser_provider_complete_digest_rejects_replaced_identity_and_short_body() {
+        let file = tempfile::tempfile().unwrap();
+        file.write_all_at(&[42; 128], 0).unwrap();
+        let identity = FileIdentity::of(&file.metadata().unwrap());
+        let original = full_digest(&file, identity).unwrap();
+        file.write_all_at(&[43; 128], 0).unwrap();
+        // Even if the host clock resolution preserves metadata, full bytes
+        // differ; the saved digest is checked independently by the caller.
+        match full_digest(&file, identity) {
+            Ok(changed) => assert_ne!(changed, original),
+            Err(_) => {}
+        }
+        file.set_len(1).unwrap();
+        assert!(full_digest(&file, identity).is_err());
+        let other = tempfile::tempfile().unwrap();
+        other.write_all_at(&[42; 128], 0).unwrap();
+        assert!(full_digest(&other, identity).is_err());
+    }
+}
