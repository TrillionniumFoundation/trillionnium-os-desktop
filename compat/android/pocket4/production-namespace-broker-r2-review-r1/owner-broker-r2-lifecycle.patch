+#[test]
+#[ignore = "requires separately approved private PID/mount namespace controls"]
+fn privileged_proc_pid_namespace_view_controls() {
+    assert_eq!(unsafe { libc::geteuid() }, 0);
+    if let Ok(case) = std::env::var("DROIDLOOM_REVIEW_PROC_CASE") {
+        if case == "pending" {
+            // Only this fresh-exec test thread changes its future-child PID
+            // namespace. No broker child or ID mapping is created.
+            assert_eq!(unsafe { libc::unshare(libc::CLONE_NEWPID) }, 0);
+        }
+        let root = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_DIRECTORY | libc::O_NOFOLLOW)
+            .open("/proc")
+            .unwrap();
+        match case.as_str() {
+            "matched" => {
+                bind_calling_thread_proc(&root).unwrap();
+            }
+            "ancestor" | "pending" => {
+                assert!(bind_calling_thread_proc(&root).is_err());
+            }
+            _ => panic!("unrecognized private proc case"),
+        }
+        println!("private proc view {case}: expected result observed; maps=0");
+        return;
+    }
+    let before = ["pid", "mnt"].map(|name| {
+        let metadata = fs::metadata(format!("/proc/self/ns/{name}")).unwrap();
+        (metadata.dev(), metadata.ino())
+    });
+    let executable = std::env::current_exe().unwrap();
+    for case in ["ancestor", "matched", "pending"] {
+        let mut command = std::process::Command::new("/usr/bin/unshare");
+        command.args(["--mount", "--propagation", "private"]);
+        if case != "pending" {
+            command.args(["--pid", "--fork", "--kill-child=KILL"]);
+        }
+        if case == "matched" {
+            command.arg("--mount-proc=/proc");
+        }
+        command.arg("--").arg(&executable).args([
+            "--exact",
+            "production_namespace::tests::privileged_proc_pid_namespace_view_controls",
+            "--ignored",
+            "--nocapture",
+            "--test-threads=1",
+        ]);
+        let output = command
+            .env_clear()
+            .env("PATH", "/usr/bin:/bin")
+            .env("LC_ALL", "C")
+            .env("DROIDLOOM_REVIEW_PROC_CASE", case)
+            .output()
+            .unwrap();
+        assert!(
+            output.status.success(),
+            "{case}: status={} stdout={} stderr={}",
+            output.status,
+            String::from_utf8_lossy(&output.stdout),
+            String::from_utf8_lossy(&output.stderr)
+        );
+        assert!(String::from_utf8_lossy(&output.stdout).contains("1 passed; 0 failed"));
+    }
+    let after = ["pid", "mnt"].map(|name| {
+        let metadata = fs::metadata(format!("/proc/self/ns/{name}")).unwrap();
+        (metadata.dev(), metadata.ino())
+    });
+    assert_eq!(before, after);
+    println!(
+        "private proc namespace controls: ancestor rejected; fresh proc accepted; pending PID namespace rejected; parent namespaces unchanged; maps=0"
+    );
+}
