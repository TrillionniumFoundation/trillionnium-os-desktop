+    fn reap(&mut self) -> Result<ChildExit> {
+        if self.reaped {
+            return Err(NamespaceError::Rejected("probe already reaped"));
+        }
+        if !wait_exited(&self.pidfd, Duration::from_secs(2))? {
+            signal_owned(&self.pidfd, libc::SIGKILL)?;
+            if !wait_exited(&self.pidfd, Duration::from_secs(2))? {
+                return Err(NamespaceError::RetirementUnproven);
