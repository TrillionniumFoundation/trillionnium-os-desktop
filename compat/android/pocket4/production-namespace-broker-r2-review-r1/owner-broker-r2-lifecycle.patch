+// A procfs mount reports PIDs in the namespace in which it was mounted.
+// Kernel thread-self resolves the actual caller even if a numeric PID lookup
+// would select a different task. A single NSpid/NStgid entry proves this mount
+// starts at the caller's active PID namespace (not an ancestor with coincident
+// PID numbers). Also reject a pending different PID namespace for new children.
+fn bind_calling_thread_proc(proc_root: &File) -> Result<File> {
+    check_fs(proc_root.as_raw_fd(), PROC_MAGIC)?;
+    let fd = unsafe {
+        libc::openat(
+            proc_root.as_raw_fd(),
+            c"thread-self".as_ptr(),
+            libc::O_RDONLY | libc::O_DIRECTORY | libc::O_CLOEXEC,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    // SAFETY: deliberately follow this kernel-owned procfs magic link only.
+    let caller = unsafe { File::from_raw_fd(fd) };
+    check_fs(caller.as_raw_fd(), PROC_MAGIC)?;
+    let pid = unsafe { libc::getpid() } as u32;
+    let tid = unsafe { libc::syscall(libc::SYS_gettid) } as u32;
+    let status = read_proc(&caller, "status")?;
+    require_proc_view_ids(&status, pid, tid)?;
+    read_identity(&caller, tid)?;
+    let active = open_pidns(&caller, c"pid")?;
+    let children = open_pidns(&caller, c"pid_for_children")?;
+    if Node::of(&active)? != Node::of(&children)? {
+        return Err(NamespaceError::Rejected(
+            "new children would enter a different PID namespace",
+        ));
+    }
+    Ok(caller)
+}
+
+fn require_proc_view_ids(status: &[u8], pid: u32, tid: u32) -> Result<()> {
+    for (field, expected) in [
+        ("Tgid:", pid),
+        ("Pid:", tid),
+        ("NStgid:", pid),
+        ("NSpid:", tid),
+    ] {
+        let value = status_field(status, field)?.trim();
+        if value.is_empty()
+            || !value.bytes().all(|byte| byte.is_ascii_digit())
+            || value.parse::<u32>().ok() != Some(expected)
+        {
+            return Err(NamespaceError::Rejected(
+                "procfs PID namespace does not identify this calling thread",
+            ));
+        }
+    }
+    Ok(())
+}
+
+fn open_pidns(proc_dir: &File, name: &std::ffi::CStr) -> Result<File> {
+    let ns_dir = open_proc_at(proc_dir, "ns", libc::O_RDONLY | libc::O_DIRECTORY)?;
+    let fd = unsafe {
+        libc::openat(
+            ns_dir.as_raw_fd(),
+            name.as_ptr(),
+            libc::O_RDONLY | libc::O_CLOEXEC,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    // SAFETY: only kernel pid/pid_for_children magic links are followed.
+    let file = unsafe { File::from_raw_fd(fd) };
+    check_fs(file.as_raw_fd(), NSFS_MAGIC)?;
+    if unsafe { libc::ioctl(file.as_raw_fd(), NS_GET_NSTYPE) } != libc::CLONE_NEWPID {
+        return Err(NamespaceError::Rejected(
+            "held namespace is not a PID namespace",
+        ));
+    }
+    Ok(file)
+}
