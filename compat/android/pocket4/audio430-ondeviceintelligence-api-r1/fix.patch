+    fn audio_ondeviceintelligence_original_api_guard_rejects_drift_missing_and_links() {
+        let d = tempfile::tempdir().unwrap();
+        let audio = SoongDependencyMode::AudioApexTargetClosure;
+        audio_ondeviceintelligence_fixture_tree(d.path());
+        validate_audio_ondeviceintelligence_original_providers(d.path(), audio).unwrap();
+        for (relative, _, _) in AUDIO_ONDEVICEINTELLIGENCE_ORIGINAL_PROVIDERS {
+            let path = d.path().join(relative);
+            let original = fs::read(&path).unwrap();
+            let mut changed = original.clone();
+            changed[0] ^= 1;
+            write(&path, &changed).unwrap();
+            assert!(validate_audio_ondeviceintelligence_original_providers(d.path(), audio).is_err(), "{relative}");
+            fs::remove_file(&path).unwrap();
+            assert!(validate_audio_ondeviceintelligence_original_providers(d.path(), audio).is_err(), "{relative}");
