+// The original java_sdk_library consumer needs both historical system-server
+// API files. The pinned SDK's normal prebuilt_apis module and Soong generator
+// turn these original API-36 inputs into the combined latest API providers.
+// Keep their signature headers and complete generator/consumer metadata intact.
+const AUDIO_ONDEVICEINTELLIGENCE_ORIGINAL_PROVIDERS: &[(&str, u64, &str)] = &[
+    ("prebuilts/sdk/Android.bp", 6333,
+        "78d50e1dd41ad06e0c716faee8e8f3ddd823f3d482c3f484466e846953f735e0"),
+    ("build/soong/java/prebuilt_apis.go", 16590,
