+    ("packages/modules/NeuralNetworks/service/Android.bp", 2758,
+        "50b264a5e8650135ce4893a47952a40f382ee129a93d6cfc96152dd350f87a18"),
+    ("prebuilts/sdk/36/system-server/api/service-ondeviceintelligence.txt", 25,
+        "39824f8c9fee1582598de5aa8cfa9653e84fbd69bd8aeb92c4a78c861faad552"),
+    ("prebuilts/sdk/36/system-server/api/service-ondeviceintelligence-removed.txt", 25,
+        "39824f8c9fee1582598de5aa8cfa9653e84fbd69bd8aeb92c4a78c861faad552"),
+];
+
+fn validate_audio_ondeviceintelligence_original_providers(
+    source: &Path, mode: SoongDependencyMode,
+) -> Result<()> {
+    if mode != SoongDependencyMode::AudioApexTargetClosure {
+        return Ok(());
+    }
+    for (relative, bytes, expected) in AUDIO_ONDEVICEINTELLIGENCE_ORIGINAL_PROVIDERS {
+        let path = source.join(relative);
+        let metadata = fs::symlink_metadata(&path)?;
+        if !metadata.file_type().is_file() || metadata.len() != *bytes
+            || hash(&path)? != *expected
+        {
+            return fail(format!(
+                "audio ondeviceintelligence requires its complete original API provider: {relative}"));
+        }
+    }
+    Ok(())
+}
