package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

java_library_static {
    name: "device_diagnostics_protos-lite",
    srcs: ["proto/*.proto"],
    sdk_version: "system_current",
    proto: {
        type: "lite",
    },
    min_sdk_version: "33",
}

android_library {
    name: "DeviceDiagnosticsLib",
    visibility: [
        "//packages/apps/DeviceDiagnostics/app/src/main",
        "//packages/apps/DeviceDiagnostics/DeviceDiagnosticsLib/src/androidTest",
    ],
    platform_apis: true,
    srcs: ["java/**/*.kt"],
    static_libs: [
        "SettingsLib",
        "android-key-attestation",
        "device_diagnostics_protos-lite",
        "gson",
        "kotlin-reflect",
        "zxing-core-1.7",
        "aconfig_trade_in_mode_flags_java_lib",
        "tradeinmode_attestation_lib",
    ],
}
