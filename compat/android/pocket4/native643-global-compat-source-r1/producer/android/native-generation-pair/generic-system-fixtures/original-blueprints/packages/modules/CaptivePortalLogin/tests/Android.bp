package {
    default_team: "trendy_team_fwk_core_networking",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

android_library {
    name: "CaptivePortalLoginTestsLib",
    defaults: ["framework-connectivity-test-defaults"],
    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    min_sdk_version: "31",
    static_libs: [
        "androidx.test.rules",
        "androidx.test.uiautomator_uiautomator",
        "mockito-target-minus-junit4",
        "CaptivePortalLoginLib",
        "android.test.runner-minus-junit",
        "androidx.test.core",
        "androidx.test.espresso.intents",
        "androidx.test.espresso.web",
        "androidx.test.ext.junit",
        "collector-device-lib",
        "kotlin-test",
        "libnanohttpd",
        "net-tests-utils",
    ],
    libs: [
        "android.test.runner.stubs",
        "android.test.base.stubs",
        "android.test.mock.stubs",
    ],
    visibility: ["//visibility:private"],
}

android_test {
    name: "CaptivePortalLoginTests",
    defaults: ["framework-connectivity-test-defaults"],
    platform_apis: true,
    compile_multilib: "both",
    min_sdk_version: "31",
    target_sdk_version: "37", // Keep in sync with CaptivePortalLogin
    test_suites: [
        "general-tests",
        "mts-networking",
    ],
    test_config: "AndroidTest.xml",
    static_libs: [
        "CaptivePortalLoginTestsLib",
    ],
    jarjar_rules: ":CaptivePortalLoginTestsJarJarRules",
}

java_genrule {
    name: "CaptivePortalLoginTestsJarJarRules",
    tool_files: [
        ":CaptivePortalLoginTestsLib{.jar}",
        ":CaptivePortalLoginJarJarExcludes",
        "test-jarjar-excludes.txt",
    ],
    tools: [
        "jarjar-rules-generator",
    ],
    out: ["CaptivePortalLoginJarJarRules.txt"],
    cmd: "$(location jarjar-rules-generator) " +
        "$(location :CaptivePortalLoginTestsLib{.jar}) " +
        "--excludes $(location :CaptivePortalLoginJarJarExcludes) " +
        "--excludes $(location test-jarjar-excludes.txt) " +
        "--prefix com.android.captiveportallogin " +
        "--output $(out)",
    visibility: [
        "//packages/modules/CaptivePortalLogin:__subpackages__",
    ],
}
