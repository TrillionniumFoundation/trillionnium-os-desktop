+// A missing module-valued src must produce a failing build rule, including
+// when another module consumes the prebuilt's output. Metadata collection must
+// not panic or turn the missing source into a successful producer.
+func TestPrebuiltEtcAllowMissingSourceModule(t *testing.T) {
+	result := android.GroupFixturePreparers(
+		prepareForPrebuiltEtcTest,
+		android.PrepareForTestDisallowNonExistentPaths,
+		android.PrepareForTestWithAllowMissingDependencies,
+	).RunTestWithBp(t, `
+		prebuilt_etc {
+			name: "missing-source.conf",
+			src: ":missing_source",
+			filename: "missing-source.conf",
+		}
+		prebuilt_etc {
+			name: "consumer.conf",
+			src: ":missing-source.conf",
+			filename: "consumer.conf",
+		}
+	`)
+
+	missing := result.ModuleForTests(t, "missing-source.conf", "android_arm64_armv8-a").Output("missing-source.conf")
+	android.AssertStringEquals(t, "missing source must retain its failing rule", "android/soong/android.Error", missing.Rule.String())
+	if got := missing.Args["error"]; !strings.Contains(got, "missing_source") {
+		t.Errorf("error rule must name missing_source, got %q", got)
+	}
+
+	consumer := result.ModuleForTests(t, "consumer.conf", "android_arm64_armv8-a").Output("consumer.conf")
+	android.AssertStringEquals(t, "consumer must retain the normal copy rule", android.CpRule.String(), consumer.Rule.String())
+	android.AssertStringEquals(t, "consumer must depend on the failing producer", missing.Output.String(), consumer.Input.String())
+}
