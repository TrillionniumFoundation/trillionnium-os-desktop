 /**
+ * security_secid_to_secctx_lsm() - Convert a secid with its captured provider
+ * @secid: security ID returned by the supplying LSM
+ * @lsmid: full ID of the LSM which supplied @secid
+ * @cp: the resulting LSM context
+ *
+ * A bare or unknown security ID must not be interpreted by another provider.
+ * Unlike the legacy untyped interface, an undefined @lsmid is rejected.
+ *
+ * Return: Nonnegative on success, a negative error on failure.
+ */
+int security_secid_to_secctx_lsm(u32 secid, u64 lsmid, struct lsm_context *cp)
+{
+	struct lsm_static_call *scall, *release;
+	int rc;
+
+	if (cp)
+		memset(cp, 0, sizeof(*cp));
+	if (lsmid == LSM_ID_UNDEF)
+		return -EOPNOTSUPP;
+	lsm_for_each_hook(scall, secid_to_secctx) {
+		if (lsmid != scall->hl->lsmid->id)
+			continue;
+		rc = scall->hl->hook.secid_to_secctx(secid, cp);
+		if (!cp)
+			return rc;
+		if (rc > 0 && cp->id == lsmid && cp->context && cp->len == rc)
+			return rc;
+
+		/* Only the supplying hook owns this allocation, even on mismatch. */
+		if (cp->context) {
+			cp->id = lsmid;
+			lsm_for_each_hook(release, release_secctx) {
+				if (release->hl->lsmid->id != lsmid)
+					continue;
+				release->hl->hook.release_secctx(cp);
+				break;
+			}
+		}
+		memset(cp, 0, sizeof(*cp));
+		return rc < 0 ? rc : -EOPNOTSUPP;
+	}
+	return -EOPNOTSUPP;
+}
+EXPORT_SYMBOL(security_secid_to_secctx_lsm);
