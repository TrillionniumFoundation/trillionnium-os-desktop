  * transfer the apparmor data to a blank set of creds
  */
 static void apparmor_cred_transfer(struct cred *new, const struct cred *old)
 {
 	set_cred_label(new, aa_get_newest_label(cred_label(old)));
+}
+
+/*
+ * Binder retains the credentials used to open the device.  Read their label,
+ * not current_cred(): the calling task may since have changed its profile.
+ * The caller's credential reference pins this label and its allocated secid.
+ * A blank credential has no label; preserve the invalid secid in that case.
+ */
+static void apparmor_cred_getsecid(const struct cred *cred, u32 *secid)
+{
+	const struct aa_label *label = cred_label(cred);
+
+	*secid = label ? label->secid : 0;
 }
 
