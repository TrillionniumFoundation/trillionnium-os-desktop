abi <abi/4.0>,

# Isolated QEMU initramfs controls only; never load these on the host.
# Neither profile permits /p4-denied-credential-control, which is root-owned
# and world-readable so the control distinguishes MAC denial from file DAC.
profile p4-binder-cred-a {
  /dev/binderfs/** rw,
  /proc/[0-9]*/attr/current rw,
  /proc/[0-9]*/attr/apparmor/current rw,
  change_profile -> p4-binder-cred-b,
  capability setuid,
  capability setgid,
  signal (receive) peer=unconfined,
}

profile p4-binder-cred-b {
  /dev/binderfs/** rw,
  /proc/[0-9]*/attr/current rw,
  /proc/[0-9]*/attr/apparmor/current rw,
  capability setuid,
  capability setgid,
  signal (receive) peer=unconfined,
}
