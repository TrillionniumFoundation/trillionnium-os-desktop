+fn verify_materialized_project(checkout: &Path, project: &PlannedProject) -> Result<(), SourceError> {
+    verify_project(checkout, project)?;
+    let tree = run_git_output(checkout, &[
+        OsStr::new("ls-tree"), OsStr::new("-r"), OsStr::new("-z"),
+        OsStr::new("--full-tree"), OsStr::new(&project.commit),
+    ])?;
+    let mut checked_directories = BTreeSet::new();
+    for record in tree.stdout.split(|byte| *byte == 0).filter(|record| !record.is_empty()) {
+        let separator = record.iter().position(|byte| *byte == b'\t')
+            .ok_or_else(|| SourceError::Invalid(vec!["malformed tracked-tree record".into()]))?;
+        let header = std::str::from_utf8(&record[..separator])
+            .map_err(|_| SourceError::Invalid(vec!["non-ASCII tracked-tree header".into()]))?;
+        let mut fields = header.split_whitespace();
+        let mode = fields.next().unwrap_or("");
+        let kind = fields.next().unwrap_or("");
+        if !is_commit(fields.next().unwrap_or("")) || fields.next().is_some() {
+            return Err(SourceError::Invalid(vec!["malformed tracked-tree identity".into()]));
+        }
+        let path = Path::new(OsStr::from_bytes(&record[separator + 1..]));
+        if !is_normal_relative(path) {
+            return Err(SourceError::Invalid(vec!["non-relative tracked-tree path".into()]));
+        }
+        // Ordinary checkout does not recursively populate submodule gitlinks.
+        // Their identity remains in the pinned tree, not a required blob body.
+        if mode == "160000" && kind == "commit" {
+            continue;
+        }
+        let is_link = match (mode, kind) {
+            ("100644" | "100755", "blob") => false,
+            ("120000", "blob") => true,
+            _ => return Err(SourceError::Invalid(vec![format!(
+                "unsupported tracked-tree entry {} in project {}",
+                path.display(), project.path.display()
+            )])),
+        };
+        if !required_by_cone(path, &project.sparse_paths) {
+            continue;
+        }
+        let mut directory = PathBuf::new();
+        for component in path.parent().unwrap_or_else(|| Path::new("")).components() {
+            directory.push(component);
+            if checked_directories.insert(directory.clone()) {
+                let info = fs::symlink_metadata(checkout.join(&directory)).map_err(|error| io_error(
+                    &format!("stat required tracked directory {} in project {}",
+                        directory.display(), project.path.display()), error))?;
+                if !info.is_dir() {
+                    return Err(SourceError::Invalid(vec![format!(
+                        "required tracked directory {} in project {} is not a directory",
+                        directory.display(), project.path.display()
+                    )]));
+                }
+            }
+        }
+        let info = fs::symlink_metadata(checkout.join(path)).map_err(|error| io_error(
+            &format!("stat required tracked entry {} in project {}",
+                path.display(), project.path.display()), error))?;
+        let correct_type = if is_link { info.file_type().is_symlink() } else { info.is_file() };
+        if !correct_type {
+            return Err(SourceError::Invalid(vec![format!(
+                "required tracked entry {} in project {} has the wrong file type",
+                path.display(), project.path.display()
+            )]));
+        }
     }
     Ok(())
 }
