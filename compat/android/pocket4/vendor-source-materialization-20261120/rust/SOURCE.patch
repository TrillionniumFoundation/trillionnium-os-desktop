+fn required_by_cone(path: &Path, sparse_paths: &[PathBuf]) -> bool {
+    // Cone mode includes every root file and the immediate files in each
+    // ancestor of a selected directory, as well as its complete subtree.
+    // --skip-checks also permits a selected file; its siblings in the parent
+    // remain included by the same Git cone rules.
+    let parent = path.parent().unwrap_or_else(|| Path::new(""));
+    sparse_paths.is_empty()
+        || sparse_paths.iter().any(|cone| path.starts_with(cone) || cone.starts_with(parent))
+}
