+      .renderArea =
+          {
+              .offset =
+                  {
+                      .x = 0,
+                      .y = 0,
+                  },
+              .extent = swapchainObjects.extent,
+          },
+      .clearValueCount =
+          static_cast<uint32_t>(renderPassBeginClearValues.size()),
+      .pClearValues = renderPassBeginClearValues.data(),
+  };
