+      .offset =
+          {
+              .x = 0,
+              .y = 0,
+          },
+      .extent = swapchainObjects.extent,
+  };
+  commandBuffer.setScissor(0, {scissor});
+
+  commandBuffer.draw(4, 1, 0, 0);
+
+  commandBuffer.endRenderPass();
+
+  return Ok{};
+}
