+Result<Ok> SampleBase::SetWindow(ANativeWindow* window) {
+  mDevice->waitIdle();
+
+  VK_EXPECT(DestroySwapchain());
+  VK_EXPECT(DestroySurface());
+
+  mWindow = window;
+
+  if (mWindow != nullptr) {
+    VK_EXPECT(CreateSurface());
+    VK_EXPECT(CreateSwapchain());
+  }
+
+  return Ok{};
+}
+
+Result<Ok> SampleBase::RecreateSwapchain() {
+  mDevice->waitIdle();
+
+  VK_EXPECT(DestroySwapchain());
+  VK_EXPECT(CreateSwapchain());
+  return Ok{};
+}
