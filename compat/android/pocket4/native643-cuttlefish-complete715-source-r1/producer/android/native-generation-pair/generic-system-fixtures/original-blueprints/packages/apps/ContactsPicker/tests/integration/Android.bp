package {
    default_team: "trendy_team_android_data_aegis",
    default_applicable_licenses: ["packages_apps_ContactsPicker_license"],
}

android_test {
    name: "ContactsPickerIntegrationTests",
    certificate: "platform",
    platform_apis: true,
    srcs: [
        "src/**/*.kt",
    ],
    manifest: "AndroidManifest.xml",
    static_libs: [
        "Nene",
        "android.content.flags-aconfig-java",
        "androidx.compose.ui_ui-test-junit4",
        "androidx.test.core",
        "androidx.test.espresso.intents",
        "androidx.test.ext.junit",
        "androidx.test.ext.truth",
        "androidx.test.rules",
        "androidx.test.runner",
        "ContactsPickerLib",
        "flag-junit",
        "hilt_android",
        "hilt_android_testing",
        "kotlin-test",
        "mockito-kotlin2",
        "mockito-target-minus-junit4",
        "platform-test-annotations",
    ],
    test_suites: [
        "general-tests",
    ],
    associates: [
        "ContactsPickerLib",
    ],
}
