+// A single output stream owns this object, and only its AIDL worker calls it.
+// One shared-memory block is in flight at a time: it is never overwritten before
+// an acknowledgement. ACK means accepted by the host audio stream, not played
+// by a physical speaker. The caller must not infer a presentation position.
+class DroidloomPcmBridge {
+  public:
+    static constexpr uint32_t kMagic = 0x31415544;  // "DUA1", little endian.
+    static constexpr uint32_t kCapacity = 65536;
+    static constexpr uint32_t kRate = 48000;
+    static constexpr uint32_t kChannels = 2;
+    static constexpr uint32_t kFormatS16Le = 1;
+    static constexpr size_t kFrameBytes = 4;
+    static constexpr uint32_t kLatencyUnknown = UINT32_MAX;
+    enum class Op : uint32_t { Hello = 1, Start = 2, Write = 3, Pause = 4,
+                              Flush = 5, Drain = 6, Standby = 7, Status = 8 };
+
+    explicit DroidloomPcmBridge(std::string socketPath) : mPath(std::move(socketPath)) {}
+    ~DroidloomPcmBridge() { closeDescriptors(); }
+    DroidloomPcmBridge(const DroidloomPcmBridge&) = delete;
+    DroidloomPcmBridge& operator=(const DroidloomPcmBridge&) = delete;
+
+    int start() {
+        int status = connectIfNeeded();
+        return status == 0 ? command(Op::Start) : status;
+    }
+    int pause() { return command(Op::Pause); }
+    int flush() { return command(Op::Flush); }
+    int drain() { return command(Op::Drain); }
+
+    int standby() {
+        if (mFailed) return -EPIPE;
+        if (mSocket < 0) return 0;
+        const int status = command(Op::Standby);
+        closeDescriptors();
+        return status;
+    }
+
+    int transfer(const void* source, size_t frames, size_t* accepted, int32_t* latencyMs) {
+        *accepted = 0;
+        *latencyMs = -1;
+        if (frames == 0) return mFailed ? -EPIPE : 0;
+        if (source == nullptr || frames > std::numeric_limits<size_t>::max() / kFrameBytes) {
+            return -EINVAL;
+        }
+        // AIDL permits pre-filling a stream before START. HELLO creates a corked
+        // host stream; only START uncorks it. Paused transfers may be partial.
+        int status = connectIfNeeded();
+        if (status != 0) return status;
+        const auto* bytes = static_cast<const uint8_t*>(source);
+        while (*accepted < frames) {
+            const uint32_t chunk = static_cast<uint32_t>(
+                    std::min(frames - *accepted, static_cast<size_t>(kCapacity / kFrameBytes)));
+            std::memcpy(mMemory, bytes + *accepted * kFrameBytes, chunk * kFrameBytes);
+            uint32_t consumed = 0;
+            status = exchange(Op::Write, chunk, -1, &consumed);
+            if (status != 0) return status;  // Never replay an unacknowledged chunk.
