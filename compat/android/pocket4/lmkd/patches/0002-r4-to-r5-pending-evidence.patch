+bool MonotonicNanos(int64_t* now_ns) {
+    struct timespec now{};
+    if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) return false;
+    if (now.tv_sec < 0 || now.tv_nsec < 0 || now.tv_nsec >= 1000000000 ||
+        static_cast<uint64_t>(now.tv_sec) >
+            static_cast<uint64_t>(INT64_MAX - now.tv_nsec) / 1000000000) {
+        errno = ERANGE;
+        return false;
+    }
+    *now_ns = now.tv_sec * 1000000000 + now.tv_nsec;
+    return true;
