+            .arg(&base)
+            .arg(&split)
+            .output()
+            .unwrap();
+        assert!(!output.status.success());
+        let error = String::from_utf8_lossy(&output.stderr);
+        assert!(error.contains("APK"), "{error}");
+        assert!(!error.contains("connect to droidloomd"), "{error}");
+    }
+}
