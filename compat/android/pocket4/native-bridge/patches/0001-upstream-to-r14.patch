+// Copyright (C) 2026 Droidloom contributors
+// SPDX-License-Identifier: Apache-2.0
+
+#if !defined(NATIVE_BRIDGE_GUEST_ARCH_ARM64) || defined(NATIVE_BRIDGE_GUEST_ARCH_RISCV64)
+#error "CPUinfo profile tests require the isolated ARM64 test-library compile contract"
