+TEST(GuestStackTest, SuppliedStackRetainedWithoutTakingMappingOwnership) {
+  const size_t guard_sizes[] = {0, kPageSize};
+  for (size_t guard_size : guard_sizes) {
+    SCOPED_TRACE(guard_size);
+    ScopedMmap stack(4 * kPageSize);
+    auto* bytes = static_cast<unsigned char*>(stack.data());
+    bytes[0] = 0x5a;
+    bytes[stack.size() - 1] = 0xa5;
+
+    std::unique_ptr<GuestThread, decltype(&GuestThread::Destroy)> thread(
+        GuestThread::CreatePthread(stack.data(), stack.size(), guard_size), GuestThread::Destroy);
+    ASSERT_NE(thread.get(), nullptr);
+
+    GuestAddr stack_base = 0;
+    size_t actual_stack_size = 0;
+    size_t actual_guard_size = 0;
+    thread->GetAttr(&stack_base, &actual_stack_size, &actual_guard_size);
+    EXPECT_EQ(stack_base, ToGuestAddr(stack.data()));
+    EXPECT_EQ(actual_stack_size, stack.size());
+    EXPECT_EQ(actual_guard_size, guard_size);
+    EXPECT_EQ(thread->GetStackTop(), ToGuestAddr(stack.data()) + stack.size());
+
+    thread.reset();
+
+    // Check the entire caller-owned mapping before accessing it. An erroneous
+    // Destroy unmap must produce a test failure rather than a sentinel read fault.
+    ASSERT_EQ(mprotect(stack.data(), stack.size(), PROT_READ | PROT_WRITE), 0) << errno;
+    EXPECT_EQ(bytes[0], 0x5a);
+    EXPECT_EQ(bytes[stack.size() - 1], 0xa5);
+  }
+}
