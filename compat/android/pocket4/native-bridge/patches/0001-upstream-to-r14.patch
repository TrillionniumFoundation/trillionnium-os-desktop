+
+namespace berberis {
+namespace {
+
+std::set<std::string> Features(const std::string& cpuinfo) {
+  const std::string key = "Features\t: ";
+  const auto begin = cpuinfo.find(key);
+  if (begin == std::string::npos) return {};
+  std::istringstream stream(cpuinfo.substr(begin + key.size(),
+      cpuinfo.find('\n', begin) - begin - key.size()));
+  std::set<std::string> features;
+  for (std::string feature; stream >> feature;) features.insert(feature);
+  return features;
+}
+
+TEST(Arm64GuestCpuinfo, FeaturesMatchConservativeAuxvProfile) {
+  // Linux arm64 HWCAP bit positions; matches guest_loader_arch.cc and the
+  // observed guest AT_HWCAP. This tests advertisement, not instruction support.
+  const std::map<std::string, uint64_t> bits = {
+      {"fp", 1ULL << 0}, {"asimd", 1ULL << 1}, {"aes", 1ULL << 3},
+      {"pmull", 1ULL << 4}, {"sha1", 1ULL << 5}, {"sha2", 1ULL << 6},
+      {"crc32", 1ULL << 7}, {"atomics", 1ULL << 8},
+  };
+  uint64_t mask = 0;
+  const auto features = Features(FormatGuestCpuinfo(8));
+  ASSERT_EQ(features.size(), bits.size());
+  for (const auto& feature : features) {
+    const auto bit = bits.find(feature);
+    ASSERT_NE(bit, bits.end()) << feature;
+    mask |= bit->second;
+  }
+  EXPECT_EQ(mask, 0x1fbULL);
+}
+
+TEST(Arm64GuestCpuinfo, PreservesRequestedCountAndClamp) {
+  for (int count : {-1, 0, 1, 8, 64}) {
+    const auto cpuinfo = FormatGuestCpuinfo(count);
+    const int expected = count < 1 ? 1 : count;
+    size_t position = 0;
+    for (int cpu = 0; cpu < expected; ++cpu) {
+      const auto line = "processor\t: " + std::to_string(cpu) + "\n";
+      const auto at = cpuinfo.find(line, position);
+      ASSERT_NE(at, std::string::npos);
+      position = at + line.size();
+    }
+    EXPECT_EQ(cpuinfo.find("processor\t: ", position), std::string::npos);
+  }
+}
+
+TEST(Arm64GuestCpuinfo, PreservesExistingNonFeatureFields) {
+  const auto cpuinfo = FormatGuestCpuinfo(1);
+  for (const char* line : {"BogoMIPS\t: 38.40\n", "CPU implementer\t: 0x41\n",
+      "CPU architecture: 8\n", "CPU variant\t: 0x1\n", "CPU part\t: 0xd05\n",
+      "CPU revision\t: 0\n"}) {
+    EXPECT_NE(cpuinfo.find(line), std::string::npos);
+  }
+}
