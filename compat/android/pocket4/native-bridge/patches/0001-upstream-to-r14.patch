+TEST(Arm64UndefinedSignalTransport, GenuineHostIllegalInstructionStillTakesFatalPath) {
+  SharedCapture data; ASSERT_NE(data.get(), nullptr);
+  pid_t child = fork(); ASSERT_GE(child, 0);
+  if (!child) {
+    ChildLimits(); InitBerberis();
+    alignas(16) uint8_t stack[65536];
+    auto handler = CopyHandler(true);
+    GuestMapShadow::GetInstance()->SetExecutable(ToGuestAddr(handler.data()), handler.size() * 4);
+    Guest_sigaction action{}; action.sa_flags = SA_SIGINFO;
+    action.guest_sa_sigaction = ToGuestAddr(handler.data());
+    int error = 0;
+    if (!SetGuestSignalHandler(SIGILL, &action, nullptr, &error)) _exit(95);
+    auto* thread = GetCurrentGuestThread();
+    thread->state()->cpu.sp = ToGuestAddr(stack + sizeof(stack));
+    thread->state()->cpu.x[19] = ToGuestAddr(data.get());
+    thread->state()->cpu.insn_addr = ToGuestAddr(&kInvalidWord);
+    thread->TestAndEnablePendingSignals();
+    asm volatile("ud2");
+    _exit(96);
+  }
+  OwnedChild cleanup(child);
+  int status; ASSERT_EQ(waitpid(child, &status, 0), child);
+  if (WIFEXITED(status) || WIFSIGNALED(status)) cleanup.Reaped();
+  ASSERT_TRUE(WIFSIGNALED(status)) << status;
+  EXPECT_EQ(WTERMSIG(status), SIGILL);
+  EXPECT_EQ(data.get()->count, 0U);
