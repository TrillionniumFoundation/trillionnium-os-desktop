+namespace berberis {
+namespace {
+
+TEST(SignalQueue, SynchronousFaultPrecedesOrdinaryPriorityAndReusedNodeDoesNotKeepIt) {
+  SignalQueue q;
+  siginfo_t* ordinary = q.AllocSignal();
+  ordinary->si_signo = SIGINT;
+  q.EnqueueSignal(ordinary);
+  siginfo_t* fault = q.AllocSignal();
+  fault->si_signo = SIGILL;
+  q.EnqueueSynchronousSignal(fault);
+  EXPECT_EQ(q.DequeueSignalUnsafe(), fault);
+  EXPECT_EQ(q.DequeueSignalUnsafe(), ordinary);
+  q.FreeSignal(ordinary);
+  q.FreeSignal(fault);
+
+  siginfo_t* reused = q.AllocSignal();
+  reused->si_signo = SIGILL;
+  q.EnqueueSignal(reused);
+  siginfo_t* lower = q.AllocSignal();
+  lower->si_signo = SIGINT;
+  q.EnqueueSignal(lower);
+  EXPECT_EQ(q.DequeueSignalUnsafe(), lower);
+  EXPECT_EQ(q.DequeueSignalUnsafe(), reused);
+  EXPECT_EQ(q.DequeueSignalUnsafe(), nullptr);
+  q.FreeSignal(lower);
+  q.FreeSignal(reused);
+}
+
+constexpr uint32_t kInvalid = 0x337aabe9U;
+constexpr uint64_t SignalBit(int signal) { return uint64_t{1} << (signal - 1); }
+
+// These are real ARM64 instructions, not host callbacks standing in for a
+// guest handler. The syscall number is the actual guest-architecture constant.
+constexpr uint32_t MovX(unsigned rd, unsigned rm) {
+  return 0xaa0003e0U | (rm << 16) | rd;
+}
+constexpr uint32_t MovZ(unsigned rd, unsigned value) {
+  return 0xd2800000U | (value << 5) | rd;
+}
+constexpr uint32_t AddX(unsigned rd, unsigned rn, unsigned value) {
+  return 0x91000000U | (value << 10) | (rn << 5) | rd;
+}
+constexpr uint32_t LdrX(unsigned rt, unsigned rn, unsigned offset) {
+  return 0xf9400000U | ((offset / 8) << 10) | (rn << 5) | rt;
+}
+constexpr uint32_t StrX(unsigned rt, unsigned rn, unsigned offset) {
+  return 0xf9000000U | ((offset / 8) << 10) | (rn << 5) | rt;
+}
+constexpr uint32_t LdpX(unsigned rt, unsigned rt2, unsigned rn, unsigned offset) {
+  return 0xa9400000U | ((offset / 8) << 15) | (rt2 << 10) | (rn << 5) | rt;
+}
+constexpr uint32_t StpX(unsigned rt, unsigned rt2, unsigned rn, unsigned offset) {
+  return 0xa9000000U | ((offset / 8) << 15) | (rt2 << 10) | (rn << 5) | rt;
+}
+constexpr uint32_t CmpXOne(unsigned rn) { return 0xf100041fU | (rn << 5); }
+constexpr uint32_t BranchCond(unsigned distance_in_words, unsigned condition) {
+  return 0x54000000U | (distance_in_words << 5) | condition;
+}
+static_assert(LdpX(3, 4, 1, 0) == 0xa9401023U);
+static_assert(StpX(3, 4, 19, 0) == 0xa9001263U);
+static_assert(LdrX(3, 2, 440) == 0xf940dc43U);
+static_assert(AddX(3, 3, 4) == 0x91001063U);
+static_assert(GUEST_NR_rt_sigprocmask == 135);
+static_assert(MovZ(8, GUEST_NR_rt_sigprocmask) == 0xd28010e8U);
+
+struct alignas(16) SignalRecord {
+  siginfo_t info;
+  uint64_t pc;
+  uint64_t mask;
+  uint64_t mask_syscall_result;
+  uint64_t reserved;
+};
+static_assert(sizeof(siginfo_t) == 128);
+static_assert(sizeof(SignalRecord) == 160);
+static_assert(offsetof(SignalRecord, pc) == 128);
+static_assert(offsetof(SignalRecord, mask) == 136);
+static_assert(offsetof(SignalRecord, mask_syscall_result) == 144);
+
+// Shared only between the test process and its freshly forked child. It proves
+// the first guest handler ran even when a nested fault must terminate the child.
+struct alignas(16) Capture {
+  SignalRecord records[2];
+  uint64_t count;
+  uint64_t fault_pc;
+  uint64_t nested_fault_pc;
+  uint64_t stop_pc;
+  uint64_t final_pc;
+  uint64_t initial_sp;
+  uint64_t final_sp;
+  uint64_t initial_flags;
+  uint64_t final_flags;
+  uint64_t host_mask_before;
+  uint64_t host_mask_after;
+  uint64_t pending_count;
+  uint64_t pending_saw_sync_count;
+  uint64_t pending_redirect_pc;
+  std::array<uint64_t, 31> initial_gprs;
+  std::array<uint64_t, 31> final_gprs;
+};
+static_assert(offsetof(Capture, count) == 320);
+
+class SharedCapture {
+ public:
+  SharedCapture() {
+    void* memory = mmap(nullptr, sizeof(Capture), PROT_READ | PROT_WRITE,
+                        MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    if (memory != MAP_FAILED) capture_ = new (memory) Capture{};
+  }
+  ~SharedCapture() { if (capture_) munmap(capture_, sizeof(Capture)); }
+  Capture* get() const { return capture_; }
+ private:
+  Capture* capture_ = nullptr;
+};
+
+std::vector<uint32_t> MakeHandler(bool nested, bool advance_pc, size_t* nested_index) {
+  std::vector<uint32_t> words {
+      LdrX(3, 19, offsetof(Capture, count)),
+      AddX(3, 3, 1),
+      StrX(3, 19, offsetof(Capture, count)),
+      MovX(22, 3),  // Remember this invocation number across a nested handler.
+      MovX(21, 19),
+      CmpXOne(3),
+      BranchCond(2, 0),  // b.eq first_record (skip the next add).
+      AddX(21, 21, sizeof(SignalRecord)),
+  };
+  for (unsigned offset = 0; offset != sizeof(siginfo_t); offset += 16) {
+    words.push_back(LdpX(3, 4, 1, offset));
+    words.push_back(StpX(3, 4, 21, offset));
+  }
+  words.insert(words.end(), {
+      LdrX(3, 2, 440),  // Linux ARM64 ucontext.uc_mcontext.pc.
+      StrX(3, 21, offsetof(SignalRecord, pc)),
+      MovX(20, 2),      // Keep the ucontext pointer while making a real syscall.
+      MovZ(0, SIG_BLOCK),
+      MovX(1, 31),      // set=nullptr: query only.
+      AddX(2, 21, offsetof(SignalRecord, mask)),
+      MovZ(3, sizeof(Guest_sigset_t)),
+      MovZ(8, GUEST_NR_rt_sigprocmask),
+      0xd4000001U,      // svc #0, through the real guest syscall implementation.
+      StrX(0, 21, offsetof(SignalRecord, mask_syscall_result)),
+  });
+  if (nested) {
+    words.push_back(CmpXOne(22));
+    words.push_back(BranchCond(2, 1));  // b.ne after_invalid.
+    *nested_index = words.size();
+    words.push_back(kInvalid);
+  }
+  if (advance_pc) {
+    words.insert(words.end(), {
+        LdrX(3, 20, 440),
+        AddX(3, 3, 4),
+        StrX(3, 20, 440),  // Only the guest handler authorizes resumption.
+    });
+  }
+  words.push_back(0xd65f03c0U);  // ret
+  return words;
+}
+
+uint64_t HostMask() {
+  sigset_t current {};
+  EXPECT_EQ(pthread_sigmask(SIG_SETMASK, nullptr, &current), 0);
+  uint64_t result = 0;
+  memcpy(&result, &current, sizeof(result));
+  return result;
+}
+
+bool SetAction(int signal, GuestAddr handler, unsigned long flags, uint64_t mask = 0) {
+  Guest_sigaction action {};
+  action.guest_sa_sigaction = handler;
+  action.sa_flags = flags;
+  action.sa_mask.__bits[0] = mask;
+  int error = 0;
+  bool result = SetGuestSignalHandler(signal, &action, nullptr, &error);
+  EXPECT_EQ(error, 0);
+  return result;
+}
+
+enum class Mode {
+  kHandler,
+  kNoPcEdit,
+  kDefault,
+  kIgnored,
+  kBlockedCustom,
+  kNestedMasked,
+  kNestedNodefer,
+  kPendingLower,
+};
+
+void RunGuestFixture(Capture* capture, Mode mode, bool nodefer) {
+  InitBerberis();
+  GuestThread* thread = GetCurrentGuestThread();
+  ASSERT_NE(thread, nullptr);
+  auto& cpu = thread->state()->cpu;
+  alignas(16) uint8_t stack[65536];
+  alignas(4) const uint32_t code[] = {kInvalid, 0x14000001U};  // invalid; b stop.
+  bool nested = mode == Mode::kNestedMasked || mode == Mode::kNestedNodefer;
+  size_t nested_index = 0;
+  auto handler = MakeHandler(nested, mode != Mode::kNoPcEdit, &nested_index);
+  auto* shadow = GuestMapShadow::GetInstance();
+  shadow->SetExecutable(ToGuestAddr(code), sizeof(code));
+  shadow->SetExecutable(ToGuestAddr(handler.data()), handler.size() * sizeof(uint32_t));
+  InvalidateGuestRange(ToGuestAddr(code), ToGuestAddr(code) + sizeof(code));
+  InvalidateGuestRange(ToGuestAddr(handler.data()),
+                       ToGuestAddr(handler.data()) + handler.size() * sizeof(uint32_t));
+  capture->fault_pc = ToGuestAddr(code);
+  capture->nested_fault_pc = nested ? ToGuestAddr(handler.data() + nested_index) : 0;
+  capture->stop_pc = ToGuestAddr(code + 2);
+  capture->pending_redirect_pc = capture->stop_pc;
+  TranslationCache::GetInstance()->SetStop(capture->stop_pc);
+
+  // A controlled child-only mask: the caller's signal environment is untouched.
+  sigset_t initial_mask {};
+  sigemptyset(&initial_mask);
+  sigaddset(&initial_mask, SIGUSR2);
+  ASSERT_EQ(pthread_sigmask(SIG_SETMASK, &initial_mask, nullptr), 0);
+  capture->host_mask_before = HostMask();
+  ASSERT_TRUE(SetAction(SIGILL, Guest_SIG_DFL, 0));
+  if (mode == Mode::kIgnored) {
+    ASSERT_TRUE(SetAction(SIGILL, Guest_SIG_IGN, 0));
+  } else if (mode != Mode::kDefault) {
+    unsigned long flags = SA_SIGINFO;
+    if (nodefer || mode == Mode::kNestedNodefer) flags |= SA_NODEFER;
+    ASSERT_TRUE(SetAction(SIGILL, ToGuestAddr(handler.data()), flags, SignalBit(SIGUSR1)));
+  }
+  if (mode == Mode::kBlockedCustom) {
+    sigset_t block {};
+    sigemptyset(&block);
+    sigaddset(&block, SIGILL);
+    ASSERT_EQ(pthread_sigmask(SIG_BLOCK, &block, nullptr), 0);
+  }
+
+  for (unsigned i = 0; i != 31; ++i) cpu.x[i] = 0x1234567800000000ULL + i;
+  cpu.x[19] = ToGuestAddr(capture);
+  cpu.sp = ToGuestAddr(stack + sizeof(stack));
+  cpu.flags = CPUState::kFlagNegative | CPUState::kFlagCarry;
+  cpu.insn_addr = capture->fault_pc;
+  memcpy(capture->initial_gprs.data(), cpu.x, sizeof(cpu.x));
+  capture->initial_sp = cpu.sp;
+  capture->initial_flags = cpu.flags;
+  thread->TestAndEnablePendingSignals();
+
+  // A lower-numbered already-pending signal must not replace the precise fault
+  // context before the synchronous handler sees it. InterpretInsn deliberately
+  // enters one real Decoder/SemanticsPlayer/Interpreter instruction without the
+  // outer ExecuteGuest pending check; all other resumable cases use ExecuteGuest.
+  std::vector<uint32_t> pending_handler;
+  if (mode == Mode::kPendingLower) {
+    pending_handler = {
+        LdrX(3, 19, offsetof(Capture, count)),
+        StrX(3, 19, offsetof(Capture, pending_saw_sync_count)),
+        MovZ(3, 1),
+        StrX(3, 19, offsetof(Capture, pending_count)),
+        LdrX(3, 19, offsetof(Capture, pending_redirect_pc)),
+        StrX(3, 2, 440),  // This separate guest handler deliberately edits PC.
+        0xd65f03c0U,
+    };
+    shadow->SetExecutable(ToGuestAddr(pending_handler.data()),
+                          pending_handler.size() * sizeof(uint32_t));
+    InvalidateGuestRange(ToGuestAddr(pending_handler.data()),
+                         ToGuestAddr(pending_handler.data()) +
+                             pending_handler.size() * sizeof(uint32_t));
+    ASSERT_TRUE(SetAction(SIGINT, ToGuestAddr(pending_handler.data()), SA_SIGINFO));
+    siginfo_t info {};
+    info.si_signo = SIGINT;
+    info.si_code = SI_QUEUE;
+    info.si_pid = getpid();
+    info.si_uid = getuid();
+    info.si_value.sival_ptr = reinterpret_cast<void*>(0x12345678);
+    thread->SetSignalFromHost(info);
+    InterpretInsn(thread->state());
+    if (ArePendingSignalsPresent(*thread->state())) thread->ProcessPendingSignals();
+  } else if (mode == Mode::kNoPcEdit) {
+    InterpretInsn(thread->state());
+  } else {
+    ExecuteGuest(thread->state());
+  }
+  capture->final_pc = cpu.insn_addr;
+  capture->final_sp = cpu.sp;
+  capture->final_flags = cpu.flags;
+  memcpy(capture->final_gprs.data(), cpu.x, sizeof(cpu.x));
+  capture->host_mask_after = HostMask();
+}
+
+int RunOwnedChild(Capture* capture, Mode mode, bool nodefer = false) {
+  pid_t child = fork();
+  if (child < 0) {
+    ADD_FAILURE() << "fork failed: " << errno;
+    return -1;
+  }
+  if (child == 0) {
+    prctl(PR_SET_PDEATHSIG, SIGKILL);
+    rlimit core {0, 0};
+    setrlimit(RLIMIT_CORE, &core);
+    struct sigaction deadline {};
+    deadline.sa_handler = SIG_DFL;
+    sigaction(SIGALRM, &deadline, nullptr);
+    sigset_t deadline_mask {};
+    sigemptyset(&deadline_mask);
+    sigaddset(&deadline_mask, SIGALRM);
+    pthread_sigmask(SIG_UNBLOCK, &deadline_mask, nullptr);
+    alarm(10);
+    RunGuestFixture(capture, mode, nodefer);
+    _exit(testing::Test::HasFailure() ? 1 : 0);
+  }
+  int status = -1;
+  pid_t waited;
+  do { waited = waitpid(child, &status, 0); } while (waited < 0 && errno == EINTR);
+  if (waited != child) {
+    ADD_FAILURE() << "waitpid for owned child failed: " << errno;
+    return -1;
+  }
+  return status;
+}
+
+void ExpectArchitecturalInfo(const SignalRecord& record, uint64_t pc) {
+  siginfo_t expected {};
+  expected.si_signo = SIGILL;
+  expected.si_code = ILL_ILLOPC;
+  expected.si_errno = 0;
+  expected.si_addr = reinterpret_cast<void*>(pc);
+  EXPECT_EQ(record.info.si_signo, SIGILL);
+  EXPECT_EQ(record.info.si_code, ILL_ILLOPC);
+  EXPECT_EQ(record.info.si_errno, 0);
+  EXPECT_EQ(record.info.si_addr, reinterpret_cast<void*>(pc));
+  EXPECT_EQ(record.pc, pc);
+  EXPECT_EQ(memcmp(&record.info, &expected, sizeof(expected)), 0);
+}
+
+void ExpectSuccessfulRegisters(const Capture& capture) {
+  EXPECT_EQ(capture.final_gprs, capture.initial_gprs);
+  EXPECT_EQ(capture.final_sp, capture.initial_sp);
+  EXPECT_EQ(capture.final_flags, capture.initial_flags);
+  EXPECT_EQ(capture.host_mask_after, capture.host_mask_before);
+}
