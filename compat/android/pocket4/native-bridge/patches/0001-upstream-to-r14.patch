+
+// The signal ABI exposes architectural NZCV, independently of the host flag
+// storage layout. Explicit values keep the expected matrix separate from the
+// production conversion implementation.
+constexpr std::array<uint16_t, 16> kPstateHostFlags {
+    0, CPUState::kFlagOverflow, CPUState::kFlagCarry,
+    CPUState::kFlagCarry | CPUState::kFlagOverflow,
+    CPUState::kFlagZero, CPUState::kFlagZero | CPUState::kFlagOverflow,
+    CPUState::kFlagZero | CPUState::kFlagCarry,
+    CPUState::kFlagZero | CPUState::kFlagCarry | CPUState::kFlagOverflow,
+    CPUState::kFlagNegative, CPUState::kFlagNegative | CPUState::kFlagOverflow,
+    CPUState::kFlagNegative | CPUState::kFlagCarry,
+    CPUState::kFlagNegative | CPUState::kFlagCarry | CPUState::kFlagOverflow,
+    CPUState::kFlagNegative | CPUState::kFlagZero,
+    CPUState::kFlagNegative | CPUState::kFlagZero | CPUState::kFlagOverflow,
+    CPUState::kFlagNegative | CPUState::kFlagZero | CPUState::kFlagCarry,
+    CPUState::kFlagNegative | CPUState::kFlagZero | CPUState::kFlagCarry |
+        CPUState::kFlagOverflow,
+};
+
+CPUState SeedPstateCpu(unsigned nzcv) {
+  CPUState cpu {};
+  for (unsigned i = 0; i != 31; ++i) cpu.x[i] = 0x123456789abc0000ULL + i;
+  auto* v = reinterpret_cast<unsigned char*>(cpu.v);
+  for (size_t i = 0; i != sizeof(cpu.v); ++i) v[i] = static_cast<unsigned char>(11 + i * 37);
+  cpu.sp = 0x1234567800001000ULL;
+  cpu.insn_addr = 0x1234567800002000ULL;
+  cpu.flags = static_cast<uint16_t>(kPstateHostFlags[nzcv] | ~kFlagsNZCVMask);
+  cpu.cached_fpcr = 0x00400000U;
+  cpu.emulated_fpsr = 0x08000000U;
+  return cpu;
+}
+
+uint64_t ReadContextPstate(GuestContext* context) {
+  uint64_t pstate;
+  // Actual Linux/Bionic ARM64 ucontext: mcontext@176 + pstate@272 = 448.
+  memcpy(&pstate, static_cast<unsigned char*>(context->ptr()) + 448, sizeof(pstate));
+  return pstate;
+}
+void WriteContextPstate(GuestContext* context, uint64_t pstate) {
+  memcpy(static_cast<unsigned char*>(context->ptr()) + 448, &pstate, sizeof(pstate));
+}
+void ExpectPstateCpu(const CPUState& actual, const CPUState& expected) {
+  for (unsigned i = 0; i != 31; ++i) EXPECT_EQ(actual.x[i], expected.x[i]) << i;
+  EXPECT_EQ(actual.sp, expected.sp);
+  EXPECT_EQ(actual.insn_addr, expected.insn_addr);
+  EXPECT_EQ(actual.flags, expected.flags);
+  EXPECT_EQ(memcmp(actual.v, expected.v, sizeof(actual.v)), 0);
+  EXPECT_EQ(actual.cached_fpcr, expected.cached_fpcr);
+  EXPECT_EQ(actual.emulated_fpsr, expected.emulated_fpsr);
+}
+
+TEST(Arm64GuestContextPstate, AllNzcvSaveAndRoundTripWithoutHostBitLeak) {
+  for (unsigned flags = 0; flags != 16; ++flags) {
+    SCOPED_TRACE(flags);
+    CPUState before = SeedPstateCpu(flags);
+    GuestContext context;
+    context.Save(&before);
+    EXPECT_EQ(ReadContextPstate(&context), uint64_t{flags} << 28);
+    CPUState after {};
+    context.Restore(&after);
+    ExpectPstateCpu(after, before);
+  }
+}
+
+TEST(Arm64GuestContextPstate, AllArchitecturalEditsPreserveSavedNonNzcvState) {
+  const std::array<uint16_t, 3> bookkeeping {
+      0, static_cast<uint16_t>(~kFlagsNZCVMask),
+      static_cast<uint16_t>(0x1234U & ~kFlagsNZCVMask)};
+  for (unsigned saved = 0; saved != 16; ++saved) {
+    for (unsigned edited = 0; edited != 16; ++edited) {
+      SCOPED_TRACE(saved * 16 + edited);
+      for (uint16_t internal : bookkeeping) {
+        CPUState before = SeedPstateCpu(saved);
+        before.flags = static_cast<uint16_t>(kPstateHostFlags[saved] | internal);
+        for (uint64_t unsupported : {uint64_t{0}, ~uint64_t{0xf0000000}}) {
+          GuestContext context;
+          context.Save(&before);
+          WriteContextPstate(&context, (uint64_t{edited} << 28) | unsupported);
+          CPUState expected = before;
+          expected.flags = static_cast<uint16_t>(internal | kPstateHostFlags[edited]);
+          CPUState after {};
+          after.flags = 0xffff;  // Restore must use saved bookkeeping, not this.
+          context.Restore(&after);
+          ExpectPstateCpu(after, expected);
+        }
+      }
+    }
+  }
+}
+
+struct alignas(16) PstateCapture {
+  uint64_t seen_pstate, edited_pstate, seen_pc, fault_pc, count, observed_nzcv;
+  uint64_t branch_results[14];
+  uint64_t stop_pc, final_pc, initial_sp, final_sp;
+  std::array<uint64_t, 31> initial_gprs, final_gprs;
+  alignas(16) unsigned char initial_v[512], final_v[512];
+  uint32_t final_fpcr, final_fpsr;
+};
+static_assert(sizeof(CPUState{}.v) == 512);
+static_assert(LdrX(3, 2, 448) == 0xf940e043U);
+static_assert(StrX(3, 2, 448) == 0xf900e043U);
+
+bool ExpectedPstateCondition(unsigned nzcv, unsigned condition) {
+  bool n = nzcv & 8, z = nzcv & 4, c = nzcv & 2, v = nzcv & 1;
+  switch (condition) {
+    case 0: return z; case 1: return !z;
+    case 2: return c; case 3: return !c;
+    case 4: return n; case 5: return !n;
+    case 6: return v; case 7: return !v;
+    case 8: return c && !z; case 9: return !c || z;
+    case 10: return n == v; case 11: return n != v;
+    case 12: return !z && n == v; case 13: return z || n != v;
+    default: return false;
+  }
+}
+
+void RunPstateGuest(PstateCapture* capture, unsigned initial) {
+  InitBerberis();
+  GuestThread* thread = GetCurrentGuestThread();
+  ASSERT_NE(thread, nullptr);
+  auto& cpu = thread->state()->cpu;
+  alignas(16) uint8_t stack[65536];
+  std::vector<uint32_t> code {kInvalid, 0xd53b4203U,  // mrs x3,NZCV after sigreturn.
+      StrX(3, 19, offsetof(PstateCapture, observed_nzcv))};
+  for (unsigned condition = 0; condition != 14; ++condition) {
+    code.insert(code.end(), {MovZ(3, 1), BranchCond(2, condition), MovZ(3, 0),
+        StrX(3, 19, offsetof(PstateCapture, branch_results) + condition * 8)});
+  }
+  code.push_back(0x14000001U);  // b stop, no flag-setting instruction after return.
+  const std::vector<uint32_t> handler {
+      LdrX(3, 2, 448), StrX(3, 19, offsetof(PstateCapture, seen_pstate)),
+      LdrX(3, 19, offsetof(PstateCapture, edited_pstate)), StrX(3, 2, 448),
+      LdrX(3, 2, 440), StrX(3, 19, offsetof(PstateCapture, seen_pc)),
+      AddX(3, 3, 4), StrX(3, 2, 440),  // Only the handler edits the fault PC.
+      LdrX(3, 19, offsetof(PstateCapture, count)), AddX(3, 3, 1),
+      StrX(3, 19, offsetof(PstateCapture, count)), 0xd65f03c0U,
+  };
+  auto* shadow = GuestMapShadow::GetInstance();
+  shadow->SetExecutable(ToGuestAddr(code.data()), code.size() * 4);
+  shadow->SetExecutable(ToGuestAddr(handler.data()), handler.size() * 4);
+  InvalidateGuestRange(ToGuestAddr(code.data()), ToGuestAddr(code.data()) + code.size() * 4);
+  InvalidateGuestRange(ToGuestAddr(handler.data()), ToGuestAddr(handler.data()) + handler.size() * 4);
+  capture->fault_pc = ToGuestAddr(code.data());
+  capture->stop_pc = ToGuestAddr(code.data() + code.size());
+  TranslationCache::GetInstance()->SetStop(capture->stop_pc);
+  sigset_t mask {};
+  sigemptyset(&mask);
+  ASSERT_EQ(pthread_sigmask(SIG_SETMASK, &mask, nullptr), 0);
+  ASSERT_TRUE(SetAction(SIGILL, ToGuestAddr(handler.data()), SA_SIGINFO));
+  CPUState seed = SeedPstateCpu(initial);
+  cpu = seed;
+  cpu.flags = kPstateHostFlags[initial];
+  // Real execution uses ordinary valid FP control; direct tests above also
+  // cover preservation of nonzero FPCR/FPSR and non-NZCV host bookkeeping.
+  cpu.cached_fpcr = 0;
+  cpu.emulated_fpsr = 0;
+  cpu.x[19] = ToGuestAddr(capture);
+  cpu.sp = ToGuestAddr(stack + sizeof(stack));
+  cpu.insn_addr = capture->fault_pc;
+  memcpy(capture->initial_gprs.data(), cpu.x, sizeof(cpu.x));
+  memcpy(capture->initial_v, cpu.v, sizeof(cpu.v));
+  capture->initial_sp = cpu.sp;
+  thread->TestAndEnablePendingSignals();
+  ExecuteGuest(thread->state());
+  capture->final_pc = cpu.insn_addr;
+  capture->final_sp = cpu.sp;
+  memcpy(capture->final_gprs.data(), cpu.x, sizeof(cpu.x));
+  memcpy(capture->final_v, cpu.v, sizeof(cpu.v));
+  capture->final_fpcr = cpu.cached_fpcr;
+  capture->final_fpsr = cpu.emulated_fpsr;
+}
+
+TEST(Arm64UndefinedSignal, HandlerPstateEditsControlNzcvAndConditionalExecution) {
+  for (unsigned initial = 0; initial != 16; ++initial) {
+    SCOPED_TRACE(initial);
+    unsigned edited = initial ^ 15U;
+    void* memory = mmap(nullptr, sizeof(PstateCapture), PROT_READ | PROT_WRITE,
+                        MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    ASSERT_NE(memory, MAP_FAILED);
+    auto* capture = new (memory) PstateCapture {};
+    capture->edited_pstate = uint64_t{edited} << 28;
+    pid_t child = fork();
+    ASSERT_GE(child, 0);
+    if (child == 0) {
+      prctl(PR_SET_PDEATHSIG, SIGKILL);
+      rlimit core {0, 0};
+      setrlimit(RLIMIT_CORE, &core);
+      struct sigaction deadline {};
+      deadline.sa_handler = SIG_DFL;
+      sigaction(SIGALRM, &deadline, nullptr);
+      sigset_t deadline_mask {};
+      sigemptyset(&deadline_mask);
+      sigaddset(&deadline_mask, SIGALRM);
+      pthread_sigmask(SIG_UNBLOCK, &deadline_mask, nullptr);
+      alarm(10);
+      // Parent expectations from earlier matrix iterations may already have
+      // failed in the baseline negative run. Count only new child assertions;
+      // never reset or hide either the parent's or this child's failures.
+      const auto* result = testing::UnitTest::GetInstance()->current_test_info()->result();
+      int before_parts = result->total_part_count();
+      RunPstateGuest(capture, initial);
+      _exit(result->total_part_count() == before_parts ? 0 : 1);
+    }
+    int status = -1;
+    pid_t waited;
+    do { waited = waitpid(child, &status, 0); } while (waited < 0 && errno == EINTR);
+    EXPECT_EQ(waited, child);
+    EXPECT_TRUE(WIFEXITED(status)) << status;
+    if (WIFEXITED(status)) EXPECT_EQ(WEXITSTATUS(status), 0);
+    printf("OWNED_PSTATE_RECEIPT {\"initial_nzcv\":%u,\"edited_nzcv\":%u,"
+           "\"seen_pstate\":%llu,\"edited_pstate\":%llu,\"observed_nzcv\":%llu,"
+           "\"count\":%llu,\"child_wait_status\":%d,\"branch_results\":[",
+           initial, edited, static_cast<unsigned long long>(capture->seen_pstate),
+           static_cast<unsigned long long>(capture->edited_pstate),
+           static_cast<unsigned long long>(capture->observed_nzcv),
+           static_cast<unsigned long long>(capture->count), status);
+    for (unsigned condition = 0; condition != 14; ++condition)
+      printf("%s%llu", condition ? "," : "",
+             static_cast<unsigned long long>(capture->branch_results[condition]));
+    printf("],\"sp_preserved\":%s,\"fpsimd_preserved\":%s}\n",
+           capture->initial_sp == capture->final_sp ? "true" : "false",
+           memcmp(capture->initial_v, capture->final_v, sizeof(capture->initial_v)) == 0
+               ? "true" : "false");
+    EXPECT_EQ(capture->count, 1U);
+    EXPECT_EQ(capture->seen_pstate, uint64_t{initial} << 28);
+    EXPECT_EQ(capture->seen_pc, capture->fault_pc);
+    EXPECT_EQ(capture->observed_nzcv, uint64_t{edited} << 28);
+    for (unsigned condition = 0; condition != 14; ++condition)
+      EXPECT_EQ(capture->branch_results[condition], ExpectedPstateCondition(edited, condition)) << condition;
+    EXPECT_EQ(capture->final_pc, capture->stop_pc);
+    EXPECT_EQ(capture->final_sp, capture->initial_sp);
+    for (unsigned i = 0; i != 31; ++i)
+      if (i != 3) EXPECT_EQ(capture->final_gprs[i], capture->initial_gprs[i]) << i;
+    EXPECT_EQ(memcmp(capture->initial_v, capture->final_v, sizeof(capture->initial_v)), 0);
+    EXPECT_EQ(capture->final_fpcr, 0U);
+    EXPECT_EQ(capture->final_fpsr, 0U);
+    EXPECT_EQ(munmap(memory, sizeof(PstateCapture)), 0);
+  }
+}
