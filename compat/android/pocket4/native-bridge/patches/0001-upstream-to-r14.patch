+alignas(4) const uint32_t kInvalidWord = 0x337aabe9U;
+alignas(4) const uint32_t kOwnedReplacement = 0xd503201fU;
+constexpr uintptr_t kPayload = 0x123456789abcdef0ULL;
+struct alignas(16) Capture {
+  siginfo_t info{};
+  uint64_t pc = 0;
+  uint64_t count = 0;
+  uint64_t fault_pc = 0;
+  uint64_t after_pc = 0;
+  uint64_t stop_pc = 0;
+};
+static_assert(sizeof(siginfo_t) == 128);
+static_assert(offsetof(Capture, pc) == 128 && offsetof(Capture, count) == 136);
+Capture* g_native_capture = nullptr;
+void CaptureNative(int, siginfo_t* info, void*) {
+  g_native_capture->info = *info;
+  ++g_native_capture->count;
+}
+class SharedCapture {
+ public:
+  SharedCapture() {
+    void* p = mmap(nullptr, sizeof(Capture), PROT_READ | PROT_WRITE,
+                   MAP_SHARED | MAP_ANONYMOUS, -1, 0);
+    if (p != MAP_FAILED) capture_ = new (p) Capture{};
+  }
+  ~SharedCapture() { if (capture_) munmap(capture_, sizeof(Capture)); }
+  Capture* get() { return capture_; }
+ private:
+  Capture* capture_ = nullptr;
+};
+class OwnedChild {
+ public:
+  explicit OwnedChild(pid_t pid) : pid_(pid) {}
+  ~OwnedChild() {
+    if (pid_ <= 0) return;
+    kill(pid_, SIGKILL);
+    ptrace(PTRACE_CONT, pid_, nullptr, nullptr);
+    int status;
+    for (;;) {
+      pid_t p = waitpid(pid_, &status, 0);
+      if (p < 0 && errno == EINTR) continue;
+      if (p < 0 || WIFEXITED(status) || WIFSIGNALED(status)) break;
+      ptrace(PTRACE_CONT, pid_, nullptr, reinterpret_cast<void*>(SIGKILL));
+    }
+  }
+  void Reaped() { pid_ = -1; }
+ private:
+  pid_t pid_;
+};
+void ChildLimits() {
+  prctl(PR_SET_PDEATHSIG, SIGKILL);
+  rlimit core{0, 0};
+  setrlimit(RLIMIT_CORE, &core);
+  struct sigaction action{};
+  action.sa_handler = SIG_DFL;
+  sigaction(SIGALRM, &action, nullptr);
+  sigset_t unblocked{};
+  sigemptyset(&unblocked);
+  sigaddset(&unblocked, SIGALRM);
+  pthread_sigmask(SIG_UNBLOCK, &unblocked, nullptr);
+  alarm(10);
+}
+std::vector<uint32_t> CopyHandler(bool advance) {
+  std::vector<uint32_t> code;
+  for (uint32_t offset = 0; offset < 128; offset += 16) {
+    code.push_back(0xa9401023U | ((offset / 8) << 15)); // ldp x3,x4,[x1,#offset]
+    code.push_back(0xa9001263U | ((offset / 8) << 15)); // stp x3,x4,[x19,#offset]
+  }
+  for (uint32_t word : {0xf940dc43U, // ldr x3,[x2,#440] (saved PC)
+                         0xf9004263U, // str x3,[x19,#128]
+                         0xf9404663U, // ldr x3,[x19,#136]
+                         0x91000463U, // add x3,x3,#1
+                         0xf9004663U}) code.push_back(word);
+  if (advance) {
+    for (uint32_t word : {0xf940dc43U, 0x91001063U, 0xf900dc43U}) code.push_back(word);
+  }
+  code.push_back(0xd65f03c0U);
+  return code;
+}
+enum class Mode { kNative, kUser, kTkill, kQueue, kUndefined, kRecovery };
+enum class TraceAction { kDeliver, kSuppress, kReplaceFault, kReplaceQueue };
+void ChildRun(Mode mode, Capture* capture) {
+  ChildLimits();
+  alignas(16) uint8_t stack[65536];
+  alignas(4) const uint32_t code[] = {
+      mode == Mode::kRecovery ? 0xf9400020U : kInvalidWord, 0x14000001U};
+  auto handler = CopyHandler(mode == Mode::kUndefined || mode == Mode::kRecovery);
+  GuestThread* thread = nullptr;
+  if (mode == Mode::kNative) {
+    g_native_capture = capture;
+    struct sigaction action{};
+    action.sa_sigaction = CaptureNative;
+    action.sa_flags = SA_SIGINFO;
+    sigemptyset(&action.sa_mask);
+    if (sigaction(SIGILL, &action, nullptr)) _exit(90);
+    capture->fault_pc = ToGuestAddr(&kInvalidWord);
+  } else {
+    InitBerberis();
+    thread = GetCurrentGuestThread();
+    if (!thread) _exit(91);
+    auto* shadow = GuestMapShadow::GetInstance();
+    shadow->SetExecutable(ToGuestAddr(handler.data()), handler.size() * 4);
+    shadow->SetExecutable(ToGuestAddr(code), sizeof(code));
+    Guest_sigaction action{};
+    action.guest_sa_sigaction = ToGuestAddr(handler.data());
+    action.sa_flags = SA_SIGINFO;
+    int error = 0;
+    if (!SetGuestSignalHandler(mode == Mode::kRecovery ? SIGSEGV : SIGILL,
+                               &action, nullptr, &error)) _exit(92);
+    auto& cpu = thread->state()->cpu;
+    cpu.sp = ToGuestAddr(stack + sizeof(stack));
+    cpu.x[19] = ToGuestAddr(capture);
+    cpu.x[1] = 0;
+    cpu.insn_addr = ToGuestAddr(code);
+    capture->fault_pc = cpu.insn_addr;
+    capture->stop_pc = ToGuestAddr(code + 2);
+    TranslationCache::GetInstance()->SetStop(capture->stop_pc);
+    thread->ProcessAndDisablePendingSignals();
+    if (mode == Mode::kUndefined || mode == Mode::kRecovery) thread->TestAndEnablePendingSignals();
+  }
+  if (ptrace(PTRACE_TRACEME, 0, nullptr, nullptr)) _exit(93);
+  raise(SIGSTOP);
+  long result = 0;
+  switch (mode) {
+    case Mode::kNative: UndefinedInsn(ToGuestAddr(&kInvalidWord)); break;
+    case Mode::kUser: result = kill(getpid(), SIGILL); break;
+    case Mode::kTkill: result = syscall(SYS_tgkill, getpid(), syscall(SYS_gettid), SIGILL); break;
+    case Mode::kQueue: {
+      sigval value{};
+      value.sival_ptr = reinterpret_cast<void*>(kPayload);
+      result = sigqueue(getpid(), SIGILL, value);
+      break;
+    }
+    case Mode::kUndefined: InterpretInsn(thread->state()); break;
+    case Mode::kRecovery: ExecuteGuest(thread->state()); break;
+  }
+  if (result) _exit(94);
+  if (thread) capture->after_pc = thread->state()->cpu.insn_addr;
+  _exit(0);
+}
+struct TraceResult {
+  siginfo_t original{};
+  siginfo_t delivered{};
+  pid_t child = 0;
+  int status = -1;
+  bool complete = false;
+};
+void TraceOwned(Mode mode, TraceAction action, Capture* capture, TraceResult* result) {
+  pid_t child = fork();
+  ASSERT_GE(child, 0);
+  if (!child) ChildRun(mode, capture);
+  OwnedChild cleanup(child);
+  result->child = child;
+  int status;
+  ASSERT_EQ(waitpid(child, &status, 0), child);
+  if (WIFEXITED(status) || WIFSIGNALED(status)) cleanup.Reaped();
+  ASSERT_TRUE(WIFSTOPPED(status) && WSTOPSIG(status) == SIGSTOP) << status;
+  ASSERT_EQ(ptrace(PTRACE_CONT, child, nullptr, nullptr), 0);
+  ASSERT_EQ(waitpid(child, &status, 0), child);
+  if (WIFEXITED(status) || WIFSIGNALED(status)) cleanup.Reaped();
+  ASSERT_TRUE(WIFSTOPPED(status)) << status;
+  const int signal = mode == Mode::kRecovery ? SIGSEGV : SIGILL;
+  ASSERT_EQ(WSTOPSIG(status), signal);
+  ASSERT_EQ(ptrace(PTRACE_GETSIGINFO, child, nullptr, &result->original), 0);
+  result->delivered = result->original;
+  if (action == TraceAction::kReplaceFault || action == TraceAction::kReplaceQueue) {
+    siginfo_t replacement{};
+    replacement.si_signo = SIGILL;
+    if (action == TraceAction::kReplaceFault) {
+      replacement.si_code = ILL_ILLOPC;
+      replacement.si_errno = EIO;
+      replacement.si_addr = const_cast<uint32_t*>(&kOwnedReplacement);
+    } else {
+      // Deliberate tracer modification in its own child; the sender is this
+      // actual tracer, not a fabricated application/process identity.
+      replacement.si_code = SI_QUEUE;
+      replacement.si_pid = getpid();
+      replacement.si_uid = getuid();
+      replacement.si_value.sival_ptr = reinterpret_cast<void*>(kPayload);
+    }
+    ASSERT_EQ(ptrace(PTRACE_SETSIGINFO, child, nullptr, &replacement), 0);
+    ASSERT_EQ(ptrace(PTRACE_GETSIGINFO, child, nullptr, &result->delivered), 0);
+    ASSERT_EQ(memcmp(&result->delivered, &replacement, sizeof(replacement)), 0);
+  }
+  ASSERT_EQ(ptrace(PTRACE_CONT, child, nullptr,
+                  reinterpret_cast<void*>(action == TraceAction::kSuppress ? 0 : signal)), 0);
+  ASSERT_EQ(waitpid(child, &status, 0), child);
+  if (WIFEXITED(status) || WIFSIGNALED(status)) cleanup.Reaped();
+  ASSERT_TRUE(WIFEXITED(status)) << status;
+  ASSERT_EQ(WEXITSTATUS(status), 0);
+  result->status = status;
+  result->complete = true;
+}
+void ExpectOriginalFault(const TraceResult& result, const Capture& capture) {
+  EXPECT_EQ(result.original.si_signo, SIGILL);
+  EXPECT_EQ(result.original.si_code, ILL_ILLOPC);
+  EXPECT_EQ(result.original.si_errno, 0);
+  EXPECT_EQ(result.original.si_addr, reinterpret_cast<void*>(capture.fault_pc));
+}
+void PrintRawReceipt(const char* name, const char* consumer,
+                     const TraceResult& result, const Capture& capture) {
+  printf("OWNED_SIGNAL_RECEIPT {\"case\":\"%s\",\"consumer\":\"%s\","
+         "\"original_code\":%d,\"delivered_code\":%d,\"count\":%llu,"
+         "\"fault_pc\":\"0x%llx\",\"saved_pc\":\"0x%llx\",\"after_pc\":\"0x%llx\",",
+         name, consumer, result.original.si_code, result.delivered.si_code,
+         static_cast<unsigned long long>(capture.count),
+         static_cast<unsigned long long>(capture.fault_pc),
+         static_cast<unsigned long long>(capture.pc),
+         static_cast<unsigned long long>(capture.after_pc));
+  auto bytes = [](const char* key, const siginfo_t& info) {
+    printf("\"%s\":\"", key);
+    for (size_t i = 0; i < sizeof(info); ++i)
+      printf("%02x", reinterpret_cast<const unsigned char*>(&info)[i]);
+    printf("\"");
+  };
+  bytes("kernel_original_hex", result.original); printf(",");
+  bytes("kernel_delivered_hex", result.delivered); printf(",");
+  bytes("consumer_record_hex", capture.info); printf("}\n");
+  fflush(stdout);
+}
+TEST(Arm64UndefinedSignalTransport, NativeSiginfoAndPtraceSeeArchitecturalFault) {
+  SharedCapture data; ASSERT_NE(data.get(), nullptr);
+  TraceResult result; TraceOwned(Mode::kNative, TraceAction::kDeliver, data.get(), &result);
+  ASSERT_TRUE(result.complete);
+  ExpectOriginalFault(result, *data.get());
+  EXPECT_EQ(data.get()->count, 1U);
+  EXPECT_EQ(memcmp(&result.original, &data.get()->info, 128), 0);
+  PrintRawReceipt("native_undefined", "native-SA_SIGINFO", result, *data.get());
+}
+TEST(Arm64UndefinedSignalTransport, RealSoftwareSigillPreservesEntireKernelRecord) {
+  for (Mode mode : {Mode::kUser, Mode::kTkill, Mode::kQueue}) {
+    SharedCapture data; ASSERT_NE(data.get(), nullptr);
+    TraceResult result; TraceOwned(mode, TraceAction::kDeliver, data.get(), &result);
+    ASSERT_TRUE(result.complete);
+    EXPECT_EQ(result.original.si_code, mode == Mode::kUser ? SI_USER :
+              mode == Mode::kTkill ? SI_TKILL : SI_QUEUE);
+    EXPECT_EQ(result.original.si_pid, result.child);
+    EXPECT_EQ(result.original.si_uid, getuid());
+    if (mode == Mode::kQueue) EXPECT_EQ(result.original.si_value.sival_ptr,
+                                      reinterpret_cast<void*>(kPayload));
+    EXPECT_EQ(data.get()->count, 1U);
+    EXPECT_EQ(data.get()->pc, data.get()->fault_pc);
+    EXPECT_EQ(data.get()->after_pc, data.get()->fault_pc);
+    EXPECT_EQ(memcmp(&result.original, &data.get()->info, 128), 0);
+    PrintRawReceipt(mode == Mode::kUser ? "SI_USER" : mode == Mode::kTkill ?
+                    "SI_TKILL" : "SI_QUEUE", "real-guest-handler", result, *data.get());
+  }
+}
