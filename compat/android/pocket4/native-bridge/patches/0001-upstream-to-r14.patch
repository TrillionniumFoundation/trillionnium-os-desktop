+extern "C" __attribute__((used, __visibility__("hidden"))) void berberis_HandleUndefinedInsn(
+    ThreadState* state) {
+  CHECK(state);
+#if defined(__x86_64__)
+  GuestThread* thread = GetGuestThread(*state);
+  ThreadState* precise_state = nullptr;
+  if (thread) {
+    CHECK_EQ(thread->state(), state);
+    CHECK_EQ(GetResidence(*state), kOutsideGeneratedCode);
+    thread->PrepareSynchronousSignal(SIGILL);
+    // Keep precision valid if another thread changes the action before the
+    // emission. Native handlers do not consume this marker; every subsequent
+    // emitter overwrites it, including null for the naked native helper.
+    precise_state = state;
+  }
+  UndefinedInsnWithContext(GetInsnAddr(GetCPUState(*state)), precise_state);
+#else
+  UndefinedInsn(GetInsnAddr(GetCPUState(*state)));
+#endif
+}
