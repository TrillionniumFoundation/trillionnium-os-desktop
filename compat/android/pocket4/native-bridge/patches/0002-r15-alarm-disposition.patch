diff --git a/guest_os_primitives/arm64/host_fault_signal_disposition_test.cc b/guest_os_primitives/arm64/host_fault_signal_disposition_test.cc
new file mode 100644
index 0000000..381e5a2
--- /dev/null
+++ b/guest_os_primitives/arm64/host_fault_signal_disposition_test.cc
@@ -0,0 +1,182 @@
+// Copyright (C) 2026 The Android Open Source Project
+// SPDX-License-Identifier: Apache-2.0
+
+#include <gtest/gtest.h>
+
+#include <sys/time.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <csignal>
+#include <cstdint>
+
+#include "berberis/guest_os_primitives/guest_signal.h"
+
+namespace berberis {
+namespace {
+volatile sig_atomic_t g_count = 0;
+volatile sig_atomic_t g_signo = 0;
+volatile sig_atomic_t g_code = 0;
+volatile sig_atomic_t g_sender = 0;
+
+void Handler(int signo) {
+  g_signo = signo;
+  g_count = g_count + 1;
+}
+
+void InfoHandler(int signo, siginfo_t* info, void*) {
+  g_signo = signo;
+  g_code = info->si_code;
+  g_sender = info->si_pid;
+  g_count = g_count + 1;
+}
+
+void ResetAlarm() {
+  struct itimerval timer {};
+  if (setitimer(ITIMER_REAL, &timer, nullptr) != 0) _exit(80);
+  struct sigaction action {};
+  action.sa_handler = SIG_DFL;
+  sigemptyset(&action.sa_mask);
+  if (sigaction(SIGALRM, &action, nullptr) != 0) _exit(81);
+  sigset_t clear;
+  sigemptyset(&clear);
+  if (sigprocmask(SIG_SETMASK, &clear, nullptr) != 0) _exit(82);
+  g_count = 0;
+  g_signo = 0;
+  g_code = 0;
+  g_sender = 0;
+}
+
+int ChildStatus(void (*body)()) {
+  const pid_t pid = fork();
+  if (pid == 0) {
+    ResetAlarm();
+    body();
+    _exit(0);
+  }
+  if (pid < 0) return -1;
+  int status;
+  while (waitpid(pid, &status, 0) < 0) {
+    if (errno != EINTR) return -1;
+  }
+  return status;
+}
+
+void ExpectExitZero(int status) {
+  ASSERT_NE(status, -1);
+  ASSERT_TRUE(WIFEXITED(status)) << status;
+  EXPECT_EQ(WEXITSTATUS(status), 0);
+}
+
+void ExpectAlarmDeath(int status) {
+  ASSERT_NE(status, -1);
+  ASSERT_TRUE(WIFSIGNALED(status)) << status;
+  EXPECT_EQ(WTERMSIG(status), SIGALRM);
+}
+
+TEST(HostFaultSignalDisposition, DefaultAlarmStillTerminates) {
+  ExpectAlarmDeath(ChildStatus([] {
+    ClaimHostFaultSignals();
+    raise(SIGALRM);
+    _exit(91);
+  }));
+}
+
+TEST(HostFaultSignalDisposition, ArmedDeadlineStillTerminates) {
+  ExpectAlarmDeath(ChildStatus([] {
+    struct itimerval timer {};
+    timer.it_value.tv_usec = 20000;
+    if (setitimer(ITIMER_REAL, &timer, nullptr) != 0) _exit(83);
+    ClaimHostFaultSignals();
+    usleep(100000);
+    _exit(92);
+  }));
+}
+
+TEST(HostFaultSignalDisposition, BlockedPendingAlarmIsNotDiscarded) {
+  ExpectAlarmDeath(ChildStatus([] {
+    sigset_t block, pending;
+    sigemptyset(&block);
+    sigaddset(&block, SIGALRM);
+    if (sigprocmask(SIG_BLOCK, &block, nullptr) != 0) _exit(84);
+    raise(SIGALRM);
+    if (sigpending(&pending) != 0 || sigismember(&pending, SIGALRM) != 1) _exit(85);
+    ClaimHostFaultSignals();
+    if (sigpending(&pending) != 0 || sigismember(&pending, SIGALRM) != 1) _exit(93);
+    if (sigprocmask(SIG_UNBLOCK, &block, nullptr) != 0) _exit(86);
+    _exit(94);
+  }));
+}
+
+TEST(HostFaultSignalDisposition, ExistingPlainHandlerIsPreserved) {
+  ExpectExitZero(ChildStatus([] {
+    struct sigaction action {}, actual {};
+    action.sa_handler = Handler;
+    sigemptyset(&action.sa_mask);
+    if (sigaction(SIGALRM, &action, nullptr) != 0) _exit(87);
+    ClaimHostFaultSignals();
+    if (sigaction(SIGALRM, nullptr, &actual) != 0 || actual.sa_handler != Handler) _exit(95);
+    raise(SIGALRM);
+    if (g_count != 1 || g_signo != SIGALRM) _exit(96);
+  }));
+}
+
+TEST(HostFaultSignalDisposition, UserSignalCauseAndSenderArePreserved) {
+  ExpectExitZero(ChildStatus([] {
+    struct sigaction action {}, actual {};
+    action.sa_sigaction = InfoHandler;
+    action.sa_flags = SA_SIGINFO;
+    sigemptyset(&action.sa_mask);
+    if (sigaction(SIGALRM, &action, nullptr) != 0) _exit(87);
+    ClaimHostFaultSignals();
+    if (sigaction(SIGALRM, nullptr, &actual) != 0 ||
+        !(actual.sa_flags & SA_SIGINFO) || actual.sa_sigaction != InfoHandler) _exit(97);
+    if (kill(getpid(), SIGALRM) != 0) _exit(88);
+    if (g_count != 1 || g_signo != SIGALRM || g_code != SI_USER || g_sender != getpid()) _exit(98);
+  }));
+}
+
+TEST(HostFaultSignalDisposition, ExplicitIgnoreIsPreserved) {
+  ExpectExitZero(ChildStatus([] {
+    struct sigaction action {}, actual {};
+    action.sa_handler = SIG_IGN;
+    sigemptyset(&action.sa_mask);
+    if (sigaction(SIGALRM, &action, nullptr) != 0) _exit(87);
+    ClaimHostFaultSignals();
+    if (sigaction(SIGALRM, nullptr, &actual) != 0 || actual.sa_handler != SIG_IGN) _exit(99);
+    if (raise(SIGALRM) != 0) _exit(88);
+  }));
+}
+
+TEST(HostFaultSignalDisposition, ExistingMaskIsPreserved) {
+  ExpectExitZero(ChildStatus([] {
+    sigset_t block, actual;
+    sigemptyset(&block);
+    sigaddset(&block, SIGALRM);
+    sigaddset(&block, SIGUSR2);
+    if (sigprocmask(SIG_SETMASK, &block, nullptr) != 0) _exit(84);
+    ClaimHostFaultSignals();
+    if (sigprocmask(SIG_SETMASK, nullptr, &actual) != 0) _exit(86);
+    for (int signo = 1; signo < NSIG; ++signo) {
+      if (sigismember(&block, signo) != sigismember(&actual, signo)) _exit(100);
+    }
+  }));
+}
+
+TEST(HostFaultSignalDisposition, OtherSignalDispositionsArePreserved) {
+  ExpectExitZero(ChildStatus([] {
+    struct sigaction dfl {}, custom {}, actual {};
+    dfl.sa_handler = SIG_DFL; custom.sa_handler = Handler;
+    sigemptyset(&dfl.sa_mask); sigemptyset(&custom.sa_mask);
+    if (sigaction(SIGUSR1, &dfl, nullptr) != 0 ||
+        sigaction(SIGUSR2, &custom, nullptr) != 0) _exit(87);
+    ClaimHostFaultSignals();
+    if (sigaction(SIGUSR1, nullptr, &actual) != 0 || actual.sa_handler != SIG_DFL) _exit(101);
+    if (sigaction(SIGUSR2, nullptr, &actual) != 0 || actual.sa_handler != Handler) _exit(102);
+    raise(SIGUSR2);
+    if (g_count != 1 || g_signo != SIGUSR2) _exit(103);
+  }));
+}
+}  // namespace
+}  // namespace berberis
diff --git a/guest_os_primitives/guest_signal_handling.cc b/guest_os_primitives/guest_signal_handling.cc
index 4d39269..72b76dc 100644
--- a/guest_os_primitives/guest_signal_handling.cc
+++ b/guest_os_primitives/guest_signal_handling.cc
@@ -698,42 +698,9 @@ void ClaimHostFaultSignals() {
     sigaction(sig, &sa, nullptr);
   }
 
-  // Neutralize a handler-less SIGALRM deadman watchdog.
-  //
-  // Anti-tamper SDKs (e.g. com.kuaishou.weapon / libweapon982.so) arm an
-  // ITIMER_REAL / alarm() / timer_create(SIGALRM) "deadman" timer and expect
-  // their integrity check to clear it before it fires; they deliberately leave
-  // SIGALRM with no handler so a missed deadline default-terminates the process
-  // (a check for debuggers / slow execution). Guest setitimer/timer_create
-  // forward straight to the host kernel, which raises a REAL host SIGALRM.
-  // Berberis installs no host handler for SIGALRM, so the host default action
-  // (Term) kills the process before any guest code runs ("exited due to signal
-  // 14 (Alarm clock)"). Under translation the integrity check runs slower than
-  // on bare metal, loses the race, and the app dies a few seconds after the SDK
-  // loads; on a fast host it passes.
-  //
-  // Set the baseline host disposition for SIGALRM to SIG_IGN so a handler-less
-  // deadman fire is discarded harmlessly. This only changes the UNHANDLED
-  // default from Term to Ignore: the moment the guest installs its own SIGALRM
-  // action, SetGuestSignalHandler -> GuestSignalAction::Change -> DoSigaction
-  // calls host sigaction(SIGALRM, ...) and replaces this SIG_IGN with the
-  // claimed guest wrapper (SIGALRM is not an IsReservedSignal), so a guest that
-  // legitimately uses alarm()/SIGALRM with a handler is unaffected. We only
-  // override when the disposition is still the untouched SIG_DFL. Covers every
-  // SIGALRM source (setitimer/alarm/timer_create) uniformly because it acts on
-  // the terminal disposition, not the arming syscall. arm64-guest only (this
-  // whole function is arm64-only).
-  {
-    struct sigaction old_sa = {};
-    if (sigaction(SIGALRM, nullptr, &old_sa) == 0 && (old_sa.sa_flags & SA_SIGINFO) == 0 &&
-        old_sa.sa_handler == SIG_DFL) {
-      struct sigaction sa = {};
-      sa.sa_handler = SIG_IGN;
-      sigemptyset(&sa.sa_mask);
-      sigaction(SIGALRM, &sa, nullptr);
-      TRACE("Berberis: host SIGALRM default set to SIG_IGN (deadman-watchdog guard)");
-    }
-  }
+  // Preserve every unrelated signal disposition, including SIGALRM.
+  // Translator initialization must not suppress an unhandled deadline signal.
+
 }
 #endif
 // endregion
