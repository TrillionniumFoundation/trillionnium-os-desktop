@@ -182,6 +182,23 @@ int OpenatProcSelfMapsForGuest(int dirfd, int flags, mode_t mode) {
     }
 #endif
     // endregion
+    // File offsets describe the first byte of each VMA. Splitting a host VMA
+    // at guest execute boundaries must advance that offset for file-backed
+    // mappings; anonymous mappings retain the kernel's zero offset.
+    uint64_t file_offset;
+    uint64_t inode;
+    int offset_begin;
+    int offset_end;
+    if (sscanf(cur_line.c_str() + prot_offset,
+               "%*4s %n%" SCNx64 "%n %*s %" SCNu64,
+               &offset_begin, &file_offset, &offset_end, &inode) != 2) {
+      TRACE("Cannot parse " PROC_SELF_MAPS " offset: %s", cur_line.c_str());
+      guest_maps.append(cur_line + "\n");
+      continue;
+    }
+    offset_begin += prot_offset;
+    offset_end += prot_offset;
+
     // Split the line into guest exec / no-exec chunks.
     uintptr_t original_start = start;
     while (start < end) {
@@ -208,8 +225,16 @@ int OpenatProcSelfMapsForGuest(int dirfd, int flags, mode_t mode) {
                                start + region_size);
       CHECK_LT(static_cast<size_t>(chars_num), sizeof(addr_range_buf));
       guest_maps.append(addr_range_buf);
-      // Append the rest of the line starting from protections and including the front space.
-      guest_maps.append(cur_line.data() + prot_offset - 1);
+      // Preserve protection, device, inode and path fields, adjusting only the
+      // file offset for this chunk's start address.
+      guest_maps.append(cur_line.data() + prot_offset - 1,
+                        offset_begin - (prot_offset - 1));
+      char offset_buf[32];
+      const uint64_t chunk_offset = inode ? file_offset + (start - original_start) : file_offset;
+      chars_num = snprintf(offset_buf, sizeof(offset_buf), "%08" PRIx64, chunk_offset);
+      CHECK_LT(static_cast<size_t>(chars_num), sizeof(offset_buf));
+      guest_maps.append(offset_buf);
+      guest_maps.append(cur_line.data() + offset_end);
       guest_maps.append("\n");
       start += region_size;
     }
