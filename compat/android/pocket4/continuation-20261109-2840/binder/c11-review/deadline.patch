 #[cfg(test)]
 mod tests {
     use super::*;
+    #[test]
+    fn late_success_is_rejected_without_repeating_the_completed_operation() {
+        let mut calls = 0;
+        let completed_output = {
+            calls += 1;
+            17
+        };
+        let expired = now_ns().saturating_sub(1);
+        assert_eq!(
+            completed_before_deadline(completed_output, expired),
+            Err(libc::ETIMEDOUT)
+        );
+        assert_eq!(calls, 1);
+    }
+
+    #[test]
+    fn completed_work_and_owned_retirement_keep_distinct_budgets() {
+        let now = now_ns();
+        assert!(now > 0);
+        let work_deadline = now.saturating_sub(1);
+        let cleanup_deadline = now.saturating_add(250_000_000);
+        assert!(completed_before_deadline((), work_deadline).is_err());
+        assert_eq!(completed_before_deadline((), cleanup_deadline), Ok(()));
+        assert_eq!(completed_before_deadline((), -1), Err(libc::ETIMEDOUT));
+    }
