+// Completion and retirement have separate deadlines. A successful kernel
+// return or already-exited child is still rejected if observed too late; this
+// check never retries the completed Binder command.
+fn completed_before_deadline<T>(value: T, deadline: i64) -> Result<T, i32> {
+    let observed = now_ns();
+    if observed < 0 || observed >= deadline {
+        Err(libc::ETIMEDOUT)
+    } else {
+        Ok(value)
+    }
+}
