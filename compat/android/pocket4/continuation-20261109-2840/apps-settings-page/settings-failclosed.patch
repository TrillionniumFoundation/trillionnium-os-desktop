+#[cfg(test)]
+fn observation_task_ids(listing: &str) -> Result<BTreeSet<u64>, LaunchError> {
+    let mut roots = BTreeSet::new();
+    let mut tasks = BTreeSet::new();
+    for line in listing.lines() {
+        let line = line.trim();
+        let (identity, set) = if let Some(rest) = line.strip_prefix("RootTask id=") {
+            (rest.split_whitespace().next().unwrap_or(""), &mut roots)
+        } else if let Some(rest) = line.strip_prefix("taskId=") {
+            (rest.split_once(':').map(|s| s.0).unwrap_or(""), &mut tasks)
+        } else if line.starts_with("RootTask") || line.starts_with("taskId") {
+            return Err(LaunchError::Discovery(
+                "unparsed Settings prelaunch task identity".into(),
+            ));
+        } else {
+            continue;
+        };
+        let value = identity
+            .parse::<u64>()
+            .map_err(|_| LaunchError::Discovery("invalid prelaunch task ID".into()))?;
+        if value == 0 || !set.insert(value) {
+            return Err(LaunchError::Discovery(
+                "duplicate or zero prelaunch task ID".into(),
+            ));
+        }
+    }
+    if roots.is_empty() || tasks.is_empty() {
+        return Err(LaunchError::Discovery(
+            "empty prelaunch task identity snapshot".into(),
+        ));
+    }
+    roots.extend(tasks);
+    Ok(roots)
+}
