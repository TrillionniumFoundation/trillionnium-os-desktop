+// Candidate protocol preparation only. The production entry above cannot call
+// this function; pure differences/ACKs are not a task-creation authority.
+#[cfg(test)]
+fn launch_settings_observation_with_paths(
+    request: &LaunchRequest,
+    action: &str,
+    control_socket: &Path,
+    command: &Path,
+) -> Result<TaskBinding, LaunchError> {
+    validate_settings_observation(request, action)?;
+    let resolution = command_as_android_shell(command)
+        .args([
+            "package",
+            "resolve-activity",
+            "--brief",
+            "--user",
+            "0",
+            "-a",
+            action,
+        ])
+        .output()?;
+    let resolution = checked_activity_output(&resolution, "resolve fixed Settings page")?;
+    if resolution
+        .lines()
+        .filter(|line| !line.trim().is_empty())
+        .count()
+        != 1
+        || normalized_component(resolution.trim())
+            != request.component.as_deref().and_then(normalized_component)
+    {
+        return Err(LaunchError::InvalidRequest(
+            "Settings component differs from this fixed page's current PM resolution".into(),
+        ));
+    }
+    let mut control = TaskControlClient::connect(control_socket)?;
+    let before = command_as_android_shell(command)
+        .args(["activity", "stack", "list"])
+        .output()?;
+    let before = checked_activity_output(&before, "Settings task precondition")?;
+    let before_ids = observation_task_ids(&before)?;
+    if !matching_tasks_with(&before, 0, &request.package, Some(0), |_| true)?.is_empty() {
+        return Err(LaunchError::Discovery(
+            "Settings observation cannot adopt a preexisting task".into(),
+        ));
+    }
+    let completed = start_settings_activity_once(request, action, command)?;
+    let alias = resolve_launch_alias(request, command, &completed)?;
+    for _ in 0..ACTIVITY_DISCOVERY_ATTEMPTS {
+        let output = command_as_android_shell(command)
+            .args(["activity", "stack", "list"])
+            .output()?;
+        let listing = checked_activity_output(&output, "Settings task discovery")?;
+        // Only reads may repeat. There is exactly one activity-start call above.
+        let candidates =
+            matching_launch_tasks(&listing, 0, request, &completed, alias.as_deref(), None)?;
+        match candidates.as_slice() {
+            [task] if !before_ids.contains(task) => {
+                return control.register_direct(&request.package, *task, 0);
+            }
+            [_] => {
+                return Err(LaunchError::Discovery(
+                    "Settings observation cannot bind a preexisting root or task ID".into(),
+                ));
+            }
+            [] => thread::sleep(DISCOVERY_INTERVAL),
+            _ => {
+                return Err(LaunchError::Discovery(
+                    "Settings observation created ambiguous tasks".into(),
+                ));
+            }
+        }
+    }
+    Err(LaunchError::Discovery(
+        "Settings observation has no completed new task; outcome unknown".into(),
+    ))
+}
