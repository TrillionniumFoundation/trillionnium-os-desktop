+            || !meta.snapshot_complete
+            || !meta.semantic_controls_available
+            || meta.truncated
+            || meta.null_child_count != 0
+            || meta.tree_status != "available"
+            || meta.visible_count == 0
+            || meta.visited_count < meta.visible_count
+            || nodes.len() != meta.visible_count as usize
+            || nodes.len() > 2048
+            || window.display_id != 0
+            || !window.focused
+            || window.kind != 1
+            || window.window_id < 0
+            || !owned.bounds.contains(window.bounds)
+        {
+            return Err(
+                "native Settings observation is incomplete or outside the owned task".into(),
+            );
+        }
+        for root in [window.root, meta.root] {
+            if !root.present
+                || !root.visible
+                || root.package != SETTINGS
+                || root.window_id != window.window_id
+                || !window.bounds.contains(root.bounds)
+            {
+                return Err("native root is outside the owned Settings window".into());
+            }
+        }
+        if nodes.iter().any(|n| {
+            !n.visible
+                || n.package != SETTINGS
+                || n.window_id != window.window_id
+                || n.source != "native_accessibility"
+                || !window.bounds.contains(n.bounds_array)
+        }) {
+            return Err("native node is outside the one observed Settings window".into());
+        }
+        Ok(WindowObservation {
+            focus,
+            accessibility_window_id: window.window_id,
+            bounds: window.bounds,
+            visible_nodes: nodes.len(),
+            native_json: raw,
+            pixel_observation_verified: false,
+        })
+    }
+}
+
+#[derive(Deserialize)]
+#[cfg(test)]
+pub(super) struct NativeOutcome {
+    pub ok: bool,
+    pub accessibility_mode_restoration_verified: bool,
+}
+
+#[cfg(test)]
+pub(super) fn validate_dump(
+    raw: String,
+    owned: &TaskCandidate,
+    focus: Focus,
+) -> Result<WindowObservation, String> {
+    let dump: NativeDump =
+        serde_json::from_str(&raw).map_err(|e| format!("invalid native tree: {e}"))?;
+    dump.validate(owned, focus, raw)
+}
+
+#[cfg(test)]
+pub(super) fn native_dump(raw: &str) -> Result<(NativeOutcome, String), String> {
+    bounded(raw)?;
+    const PREFIX: &str = "INSTRUMENTATION_RESULT: sidecar_result_base64=";
+    let values: Vec<_> = raw.lines().filter_map(|s| s.strip_prefix(PREFIX)).collect();
+    let [value] = values.as_slice() else {
+        return Err("native instrumentation result absent or repeated".into());
+    };
+    let decoded = decode_base64(value)?;
+    let text = String::from_utf8(decoded).map_err(|_| "native JSON is not UTF-8")?;
+    let value = serde_json::from_str(&text).map_err(|e| format!("invalid native JSON: {e}"))?;
+    Ok((value, text))
+}
+
+// Strict padded RFC4648 alphabet and canonical low bits; no whitespace fallback.
+#[cfg(test)]
+fn decode_base64(raw: &str) -> Result<Vec<u8>, String> {
+    if raw.is_empty() || raw.len() > LIMIT || raw.len() % 4 != 0 {
+        return Err("invalid bounded base64 length".into());
+    }
+    fn digit(b: u8) -> Option<u8> {
+        match b {
+            b'A'..=b'Z' => Some(b - b'A'),
+            b'a'..=b'z' => Some(b - b'a' + 26),
+            b'0'..=b'9' => Some(b - b'0' + 52),
+            b'+' => Some(62),
+            b'/' => Some(63),
+            _ => None,
+        }
+    }
+    let mut out = Vec::with_capacity(raw.len() / 4 * 3);
+    for (i, c) in raw.as_bytes().chunks_exact(4).enumerate() {
+        let a = digit(c[0]).ok_or("invalid base64 digit")?;
+        let b = digit(c[1]).ok_or("invalid base64 digit")?;
+        let last = (i + 1) * 4 == raw.len();
+        out.push((a << 2) | (b >> 4));
+        if c[2] == b'=' {
+            if !last || c[3] != b'=' || b & 15 != 0 {
+                return Err("noncanonical base64 padding".into());
+            }
+            continue;
+        }
+        let d = digit(c[2]).ok_or("invalid base64 digit")?;
+        out.push((b << 4) | (d >> 2));
+        if c[3] == b'=' {
+            if !last || d & 3 != 0 {
+                return Err("noncanonical base64 padding".into());
+            }
+        } else {
+            out.push((d << 6) | digit(c[3]).ok_or("invalid base64 digit")?);
+        }
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn strict_base64_accepts_canonical_vectors_and_rejects_aliases() {
+        for (raw, expected) in [
+            ("Zg==", "f"),
+            ("Zm8=", "fo"),
+            ("Zm9v", "foo"),
+            ("Zm9vYg==", "foob"),
+            ("Zm9vYmE=", "fooba"),
+            ("Zm9vYmFy", "foobar"),
+        ] {
+            assert_eq!(decode_base64(raw).unwrap(), expected.as_bytes());
+        }
+        for raw in [
+            "", "Zg", "Zh==", "Zm9=", "Zg==AAAA", "Zg=\n", "Zg-_", "====", "Zm=v",
+        ] {
+            assert!(decode_base64(raw).is_err(), "{raw:?}");
+        }
+        assert!(decode_base64(&"A".repeat(LIMIT + 4)).is_err());
+    }
+    #[test]
+    fn malformed_or_repeated_native_ack_never_yields_a_task_id() {
+        for raw in [
+            "object=1 composer_display=2 android_display=0 task=42\nobject=1 composer_display=2 android_display=0 task=42",
+            "object=1 composer_display=2 android_display=1 task=42",
+            "object=1 composer_display=2 android_display=0 task=0",
+            "object=1 composer_display=2 android_display=0 task=2147483648",
+            "object=1 object=2 android_display=0 task=42",
+        ] {
+            assert!(launch_task(raw).is_err());
+        }
+        assert_eq!(
+            launch_task("object=1 composer_display=2 android_display=0 task=42").unwrap(),
+            42
+        );
+    }
+    #[test]
+    fn task_parser_rejects_duplicated_unparsed_and_ambiguous_roots() {
+        let raw = "RootTask id=1 bounds=[0,0][800,600] displayId=0 userId=0\n configuration={mWindowingMode=fullscreen}\n taskId=1: com.example/.Main userId=0 visible=true topActivity=ComponentInfo{com.example/.Main}\n";
+        assert!(Tasks::parse(raw).is_ok());
+        for wrong in [
+            format!("{raw}{raw}"),
+            raw.replace("taskId=1:", "taskId=?"),
+            raw.replace("userId=0 visible", "userId=0 userId=0 visible"),
+            raw.replace("bounds=[0,0]", "bounds=[text,0]"),
+            raw.replace("RootTask id=1", "RootTask id=?"),
+        ] {
+            assert!(Tasks::parse(&wrong).is_err(), "{wrong}");
+        }
+    }
+    #[test]
+    fn focus_cannot_be_a_foreign_user_component_or_ambiguous_window() {
+        let owned = TaskCandidate {
+            id: 42,
+            component: "com.android.settings/com.android.settings.Settings".into(),
+            top_activity: "com.android.settings/com.android.settings.Settings".into(),
+            bounds: Bounds([0, 0, 800, 600]),
+        };
+        let raw = "mCurrentFocus=Window{ab12 u0 com.android.settings/.Settings}";
+        assert!(focus(raw, &owned).is_ok());
+        for bad in [
+            raw.replace("u0", "u10"),
+            raw.replace("/.Settings", "/.Other"),
+            format!("{raw}\n{raw}"),
+            raw.replace("ab12", "../../bad"),
+        ] {
+            assert!(focus(&bad, &owned).is_err());
+        }
+    }
+}
diff --git a/runtime/droidloom-supervisor/src/application_action_scope.rs b/runtime/droidloom-supervisor/src/application_action_scope.rs
new file mode 100644
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/application_action_scope.rs
@@ -0,0 +1,292 @@
+//! Persistent pending-state admission, shared with daemon mutations and the UI
+//! consumer. No lock re-acquisition is needed by a caller already holding flock.
+//! The preparatory writer/retention lifecycle is test-only until real framework
+//! task-creation authority exists; production never clears a pending intent.
+use std::ffi::CStr;
+use std::fs::{File, OpenOptions};
+use std::io;
+#[cfg(test)]
+use std::io::Write;
+use std::os::fd::{AsRawFd, FromRawFd};
+use std::os::unix::fs::{MetadataExt, OpenOptionsExt};
+use std::path::Path;
+#[cfg(test)]
+use std::sync::Mutex;
+
+#[cfg(test)]
+const LOCK: &CStr = c"android-digitalis-actions.lock";
+const MARKER: &CStr = c"droidloom-settings-observation.pending.json";
+
+pub(super) fn ensure_no_pending() -> io::Result<()> {
+    ensure_no_pending_in(Path::new("/run/lock"), 0)
+}
+
+pub(super) fn ensure_no_pending_in(path: &Path, expected_owner: u32) -> io::Result<()> {
+    let directory = OpenOptions::new()
+        .read(true)
+        .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+        .open(path)?;
+    if directory.metadata()?.uid() != expected_owner {
+        return Err(fail(
+            "pending action directory owner differs; mutation blocked",
+        ));
+    }
+    match open(&directory, MARKER, libc::O_PATH) {
+        Ok(_) => Err(fail(
+            "unreconciled Settings action pending; mutation blocked without retry",
+        )),
+        Err(e) if e.kind() == io::ErrorKind::NotFound => Ok(()),
+        Err(e) => Err(e),
+    }
+}
+
+fn fail(message: &str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn open(directory: &File, name: &CStr, flags: i32) -> io::Result<File> {
+    // SAFETY: held directory and NUL-terminated fixed basename; only new FD is owned.
+    let fd = unsafe {
+        libc::openat(
+            directory.as_raw_fd(),
+            name.as_ptr(),
+            flags | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+            0o600,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    // SAFETY: successful openat allocated this owned FD.
+    Ok(unsafe { File::from_raw_fd(fd) })
+}
+
+#[cfg(test)]
+fn private_regular(file: &File) -> io::Result<()> {
+    let m = file.metadata()?;
+    // SAFETY: geteuid has no pointer or ownership preconditions.
+    let uid = unsafe { libc::geteuid() };
+    if !m.is_file() || m.uid() != uid || m.nlink() != 1 || m.mode() & 0o7777 != 0o600 {
+        return Err(fail(
+            "action scope file is not an owned private regular inode",
+        ));
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+pub(super) struct ActionScope<'a> {
+    directory: File,
+    lock: Option<File>,
+    marker: Option<File>,
+    retained: &'a Mutex<Option<File>>,
+}
+
+#[cfg(test)]
+impl<'a> ActionScope<'a> {
+    pub(super) fn acquire_in(path: &Path, retained: &'a Mutex<Option<File>>) -> io::Result<Self> {
+        if retained
+            .lock()
+            .map_err(|_| fail("action custody mutex is poisoned"))?
+            .is_some()
+        {
+            return Err(fail(
+                "an unresolved Settings action still holds the shared action lock",
+            ));
+        }
+        let directory = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_DIRECTORY | libc::O_NOFOLLOW | libc::O_CLOEXEC)
+            .open(path)?;
+        let metadata = directory.metadata()?;
+        // SAFETY: geteuid has no pointer or ownership preconditions.
+        if metadata.uid() != unsafe { libc::geteuid() } {
+            return Err(fail("action lock directory owner differs"));
+        }
+        let lock = open(
+            &directory,
+            LOCK,
+            libc::O_CREAT | libc::O_RDWR | libc::O_NONBLOCK,
+        )?;
+        private_regular(&lock)?;
+        // SAFETY: this is a live owned FD; LOCK_NB prevents an unbounded wait.
+        if unsafe { libc::flock(lock.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        match open(&directory, MARKER, libc::O_PATH) {
+            Ok(_) => {
+                return Err(fail(
+                    "unreconciled Settings intent exists; no automatic retry or adoption",
+                ));
+            }
+            Err(e) if e.kind() == io::ErrorKind::NotFound => {}
+            Err(e) => return Err(e),
+        }
+        Ok(Self {
+            directory,
+            lock: Some(lock),
+            marker: None,
+            retained,
+        })
+    }
+
+    pub fn before_start(&mut self, intent: &[u8]) -> io::Result<()> {
+        if intent.is_empty() || intent.len() > 8192 || self.marker.is_some() {
+            return Err(fail("invalid or repeated Settings intent"));
+        }
+        let marker = open(
+            &self.directory,
+            MARKER,
+            libc::O_CREAT | libc::O_EXCL | libc::O_WRONLY,
+        )?;
+        // From this point a write/fsync error also preserves custody. No start
+        // can be sent until both the marker and its directory are durable.
+        self.marker = Some(marker);
+        let file = self.marker.as_mut().expect("inserted above");
+        private_regular(file)?;
+        file.write_all(intent)?;
+        file.sync_all()?;
+        self.directory.sync_all()?;
+        Ok(())
+    }
+
+    pub fn finish_after_verified_cleanup(&mut self) -> io::Result<()> {
+        let marker = self
+            .marker
+            .as_ref()
+            .ok_or_else(|| fail("Settings intent missing"))?;
+        private_regular(marker)?;
+        let current = open(&self.directory, MARKER, libc::O_RDONLY | libc::O_NONBLOCK)?;
+        private_regular(&current)?;
+        let a = marker.metadata()?;
+        let b = current.metadata()?;
+        if a.dev() != b.dev() || a.ino() != b.ino() {
+            return Err(fail("Settings intent pathname changed; custody retained"));
+        }
+        // SAFETY: the directory is held; the exact private inode was checked
+        // above while holding the shared action flock. No foreign path is used.
+        if unsafe { libc::unlinkat(self.directory.as_raw_fd(), MARKER.as_ptr(), 0) } != 0 {
+            return Err(io::Error::last_os_error());
+        }
+        self.directory.sync_all()?;
+        self.marker = None;
+        Ok(())
+    }
+
+    pub fn pending(&self) -> bool {
+        self.marker.is_some()
+    }
+}
+
+#[cfg(test)]
+impl Drop for ActionScope<'_> {
+    fn drop(&mut self) {
+        if self.marker.is_none() {
+            return;
+        }
+        if let Some(file) = self.lock.take() {
+            match self.retained.lock() {
+                Ok(mut retained) if retained.is_none() => *retained = Some(file),
+                // Poisoning or an impossible second retained scope must not
+                // silently release an unresolved global action flock.
+                _ => std::mem::forget(file),
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn pending_reader_survives_writer_exit_and_rejects_unknown_path_states() {
+        let d = tempfile::tempdir().unwrap();
+        let uid = d.path().metadata().unwrap().uid();
+        ensure_no_pending_in(d.path(), uid).unwrap();
+        let marker = d.path().join(MARKER.to_str().unwrap());
+        std::os::unix::fs::symlink(d.path().join("absent-target"), &marker).unwrap();
+        assert!(ensure_no_pending_in(d.path(), uid).is_err());
+        assert!(marker.symlink_metadata().unwrap().file_type().is_symlink());
+        std::fs::remove_file(&marker).unwrap();
+        std::fs::write(&marker, b"unresolved").unwrap();
+        assert!(
+            ensure_no_pending_in(d.path(), uid)
+                .unwrap_err()
+                .to_string()
+                .contains("pending")
+        );
+        assert!(ensure_no_pending_in(d.path(), uid.wrapping_add(1)).is_err());
+        assert!(ensure_no_pending_in(&d.path().join("missing"), uid).is_err());
+        assert_eq!(std::fs::read(marker).unwrap(), b"unresolved");
+    }
+    #[test]
+    fn shared_flock_excludes_a_separate_open_file_description() {
+        let d = tempfile::tempdir().unwrap();
+        let r = Mutex::new(None);
+        let scope = ActionScope::acquire_in(d.path(), &r).unwrap();
+        let other = OpenOptions::new()
+            .read(true)
+            .write(true)
+            .open(d.path().join(LOCK.to_str().unwrap()))
+            .unwrap();
+        // SAFETY: valid separately opened FD; no blocking lock requested.
+        assert_ne!(
+            unsafe { libc::flock(other.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+            0
+        );
+        drop(scope);
+        // SAFETY: same valid FD, now no competing open description remains.
+        assert_eq!(
+            unsafe { libc::flock(other.as_raw_fd(), libc::LOCK_EX | libc::LOCK_NB) },
+            0
+        );
+    }
+    #[test]
+    fn uncertain_intent_survives_lock_release_and_blocks_daemon_restart() {
+        let d = tempfile::tempdir().unwrap();
+        let r = Mutex::new(None);
+        let mut scope = ActionScope::acquire_in(d.path(), &r).unwrap();
+        scope.before_start(b"{\"fixture_only\":true}").unwrap();
+        drop(scope);
+        assert!(r.lock().unwrap().is_some());
+        assert!(ActionScope::acquire_in(d.path(), &r).is_err());
+        r.lock().unwrap().take(); // model daemon death, not a production recovery API
+        assert!(
+            ActionScope::acquire_in(d.path(), &r)
+                .err()
+                .unwrap()
+                .to_string()
+                .contains("unreconciled")
+        );
+    }
+    #[test]
+    fn verified_cleanup_removes_only_its_held_marker_and_releases_flock() {
+        let d = tempfile::tempdir().unwrap();
+        let r = Mutex::new(None);
+        let mut scope = ActionScope::acquire_in(d.path(), &r).unwrap();
+        scope.before_start(b"{}").unwrap();
+        scope.finish_after_verified_cleanup().unwrap();
+        drop(scope);
+        assert!(!d.path().join(MARKER.to_str().unwrap()).exists());
+        assert!(ActionScope::acquire_in(d.path(), &r).is_ok());
+    }
+    #[test]
+    fn replaced_marker_or_lock_symlink_is_not_followed_or_deleted() {
+        let d = tempfile::tempdir().unwrap();
+        let r = Mutex::new(None);
+        let outside = d.path().join("outside");
+        std::fs::write(&outside, b"keep").unwrap();
+        std::os::unix::fs::symlink(&outside, d.path().join(LOCK.to_str().unwrap())).unwrap();
+        assert!(ActionScope::acquire_in(d.path(), &r).is_err());
+        std::fs::remove_file(d.path().join(LOCK.to_str().unwrap())).unwrap();
+        let mut scope = ActionScope::acquire_in(d.path(), &r).unwrap();
+        scope.before_start(b"{}").unwrap();
+        let marker = d.path().join(MARKER.to_str().unwrap());
+        std::fs::remove_file(&marker).unwrap();
+        std::os::unix::fs::symlink(&outside, &marker).unwrap();
+        assert!(scope.finish_after_verified_cleanup().is_err());
+        drop(scope);
+        assert_eq!(std::fs::read(&outside).unwrap(), b"keep");
+        assert!(r.lock().unwrap().is_some());
+    }
+}
