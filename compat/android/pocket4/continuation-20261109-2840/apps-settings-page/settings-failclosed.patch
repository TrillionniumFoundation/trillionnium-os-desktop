+/// Read-only feature negotiation for the fixed Settings observation entry.
+pub const SETTINGS_OBSERVATION_PROTOCOL: &str =
+    "droidloom-settings-observation-v2:blocked-no-framework-created-task-authority";
+
+/// Reject Settings observation until a verified framework-created-task provider exists.
+/// Neither a successful shell start nor task-list differences prove creation by
+/// this request. No production launch, registration or cleanup is authorized.
+///
+/// # Errors
+/// Always returns an explicit missing-authority precondition after validating
+/// the fixed request shape. No Android command or task-control connection runs.
+pub fn launch_settings_observation(
+    request: &LaunchRequest,
+    action: &str,
+) -> Result<TaskBinding, LaunchError> {
+    validate_settings_observation(request, action)?;
+    Err(LaunchError::InvalidRequest("Settings framework created-task authority unavailable; no launch or registration authorized".into()))
+}
