@@ -128,6 +129,27 @@
 def require(condition,code,**details):
     if not condition: raise ControlError(code,**details)
 
+def _check_pending_settings_at(path,expected_owner):
+    # Hold the directory; any marker inode, including a dangling symlink,
+    # blocks admission. Only ENOENT is clear. Never read, clear or retry it.
+    details={'action_taken':False,'outcome_unknown':True,'automatic_retry':False}
+    directory=None
+    try:
+        directory=os.open(path,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_CLOEXEC)
+        require(os.fstat(directory).st_uid==expected_owner,'SETTINGS_PENDING_DIRECTORY_UNTRUSTED',**details)
+        try:os.stat('droidloom-settings-observation.pending.json',dir_fd=directory,follow_symlinks=False)
+        except FileNotFoundError:return
+        raise ControlError('SETTINGS_ACTION_PENDING_NO_ACTION_TAKEN',**details)
+    except OSError:
+        raise ControlError('SETTINGS_PENDING_STATE_UNAVAILABLE',**details) from None
+    finally:
+        if directory is not None:os.close(directory)
+
+def require_no_pending_settings():
+    # The CLI helper already holds the shared flock while calling droidloomctl.
+    # Re-locking here would deadlock; the durable marker check is independent.
+    _check_pending_settings_at('/run/lock',0)
+
