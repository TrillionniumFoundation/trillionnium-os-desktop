+    #[test]
+    fn host_admission_sssd_proc_exit_requires_a_complete_replacement_scan() {
+        let mut attempts = 0;
+        let deadline = Instant::now() + Duration::from_secs(1);
+        complete_sssd_process_scan(deadline, || {
+            attempts += 1;
+            match attempts {
+                1 => Err(HostAdmissionError::Changed),
+                2 => Err(io::Error::from_raw_os_error(libc::ENOENT).into()),
+                3 => Err(io::Error::from_raw_os_error(libc::ESRCH).into()),
+                _ => Ok(()),
+            }
+        })
+        .unwrap();
+        assert_eq!(attempts, 4);
+    }
+
+    #[test]
+    fn host_admission_sssd_proc_retries_do_not_hide_policy_or_retirement_errors() {
+        for original in [
+            reject("SSSD service identity has a live host task"),
+            HostAdmissionError::RetirementUnproven,
+            io::Error::from_raw_os_error(libc::EACCES).into(),
+            io::Error::from_raw_os_error(libc::EINVAL).into(),
+            io::Error::new(io::ErrorKind::NotFound, "unclassified read").into(),
+        ] {
+            let expected = original.to_string();
+            let mut pending = Some(original);
+            let mut attempts = 0;
+            let got = complete_sssd_process_scan(Instant::now() + Duration::from_secs(1), || {
+                attempts += 1;
+                Err(pending
+                    .take()
+                    .expect("permanent failure must not be retried"))
+            })
+            .unwrap_err();
+            assert_eq!(got.to_string(), expected);
+            assert_eq!(attempts, 1);
+        }
+    }
+
+    #[test]
+    fn host_admission_sssd_proc_churn_cannot_exhaust_into_success() {
+        let mut attempts = 0;
+        let got = complete_sssd_process_scan(Instant::now() + Duration::from_secs(1), || {
+            attempts += 1;
+            Err(HostAdmissionError::Changed)
+        });
+        assert!(matches!(got, Err(HostAdmissionError::Changed)));
+        assert_eq!(attempts, SSSD_PROC_SCAN_ATTEMPTS);
+    }
+
+    #[test]
+    fn host_admission_sssd_proc_deadline_is_shared_and_checked_after_completion() {
+        let expired = Instant::now() - Duration::from_millis(1);
+        assert!(
+            complete_sssd_process_scan(expired, || panic!("expired scan must not start")).is_err()
+        );
+        let deadline = Instant::now() + Duration::from_millis(2);
+        assert!(
+            complete_sssd_process_scan(deadline, || {
+                std::thread::sleep(Duration::from_millis(4));
+                Ok(())
+            })
+            .is_err()
