+    #[test]
+    fn ordinary_pair_flags_rejects_the_exact_failed_r12_lock() {
+        let base: Value = serde_json::from_slice(include_bytes!(
+            "../../../android/manifest/m2-role-ingress-hal-provider-source-lock.json")).unwrap();
+        let good: Value = serde_json::from_slice(include_bytes!(
+            "../../../android/native-generation-pair/source-lock.json")).unwrap();
+        validate_source_extension(&base, &good).unwrap();
+        let mut failed_r12 = good.clone();
+        remove_later_flags_inputs(&mut failed_r12);
+        let failed_raw = format!("{}\n", serde_json::to_string_pretty(&failed_r12).unwrap());
+        assert_eq!(failed_raw.len(), 354876);
+        assert_eq!(digest(failed_raw.as_bytes()), "34aa4c635fd8700c641641c5dbdf4ded4cd6a94b0a3ad369232fe1f287b691f0");
+        let generic: droidloom_source::SparseSourceLock =
+            serde_json::from_value(failed_r12.clone()).unwrap();
+        assert!(droidloom_source::build_plan(&generic).is_ok());
+        assert!(validate_source_extension(&base, &failed_r12).is_err());
+        assert_eq!(good["projects"].as_array().unwrap().len(), 601);
+        for (before, after) in failed_r12["projects"].as_array().unwrap().iter()
+            .zip(good["projects"].as_array().unwrap()) {
+            assert_eq!(before["path"], after["path"]);
+            assert_eq!(before["name"], after["name"]);
+            assert_eq!(before["commit"], after["commit"]);
+        }
+        assert_eq!(TARGETS, &["libberberis_arm64", "com.android.art"]);
+    }
