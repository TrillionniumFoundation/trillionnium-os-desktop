+    #[test]
+    fn ordinary_pair_flags_requires_complete_cones_and_original_fake_device_config() {
+        let base: Value = serde_json::from_slice(include_bytes!(
+            "../../../android/manifest/m2-role-ingress-hal-provider-source-lock.json")).unwrap();
+        let good: Value = serde_json::from_slice(include_bytes!(
+            "../../../android/native-generation-pair/source-lock.json")).unwrap();
+        validate_source_extension(&base, &good).unwrap();
+        for (path, revision, declaration) in [
+            ("packages/services/Telecomm", "2353977dc28ff88d3cdc1ec636fa9c3251d2ff86", "telecom_api_flags.aconfig"),
+            ("system/update_engine", "4591637f51644f5429f9e2fe589ab22b92f61842", "update_engine_flags.aconfig"),
+        ] {
+            let index = good["projects"].as_array().unwrap().iter()
+                .position(|p| p["path"] == path).unwrap();
+            assert_eq!(good["projects"][index]["commit"], revision);
+            assert_eq!(good["projects"][index]["sparse_paths"].as_array().unwrap()
+                .iter().filter(|p| *p == "flags").count(), 1);
+            // A blueprint without its declarations, one declaration alone, or
+            // an unrequested parent is not the complete original provider.
+            for replacement in [None, Some("flags/Android.bp".to_owned()),
+                                Some(format!("flags/{declaration}")), Some(".".to_owned())] {
+                let mut partial = good.clone();
+                let paths = partial["projects"][index]["sparse_paths"].as_array_mut().unwrap();
+                paths.retain(|p| p != "flags");
+                if let Some(value) = replacement { paths.push(json!(value)); }
+                assert!(validate_source_extension(&base, &partial).is_err());
+            }
+            let mut wrong_revision = good.clone();
+            wrong_revision["projects"][index]["commit"] = json!("0000000000000000000000000000000000000000");
+            assert!(validate_source_extension(&base, &wrong_revision).is_err());
+        }
+        // update_engine's original java_aconfig_library depends on the real
+        // fake_device_config module. Its BP and all seven Java sources are in
+        // the existing full build/make project; do not replace that project
+        // with a BP-only or another-revision synthetic provider selection.
+        let build_index = good["projects"].as_array().unwrap().iter()
+            .position(|p| p["path"] == "build/make").unwrap();
+        assert_eq!(good["projects"][build_index]["name"], "platform/build");
+        assert_eq!(good["projects"][build_index]["commit"], "5ce6f787337d0223710bf7d4a16dbe6d2a35f777");
+        assert!(good["projects"][build_index].get("sparse_paths").is_none());
+        for selection in ["tools/aconfig/fake_device_config/Android.bp",
+                          "tools/aconfig/fake_device_config/src", "tools/aconfig/fake_device_config"] {
+            let mut narrowed = good.clone();
+            narrowed["projects"][build_index]["sparse_paths"] = json!([selection]);
+            assert!(validate_source_extension(&base, &narrowed).is_err());
+        }
+        let mut wrong_build_revision = good.clone();
+        wrong_build_revision["projects"][build_index]["commit"] = json!("0000000000000000000000000000000000000000");
+        assert!(validate_source_extension(&base, &wrong_build_revision).is_err());
+        assert_eq!(TARGETS, &["libberberis_arm64", "com.android.art"]);
+    }
