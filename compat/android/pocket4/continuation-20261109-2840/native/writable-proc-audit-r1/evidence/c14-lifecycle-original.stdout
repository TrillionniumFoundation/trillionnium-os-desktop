{"path": "/home/alex/work/pocket4-android-final/qualification/production-namespace-broker-source-20261109-8b88-r14/source/runtime/droidloom-supervisor/src/production_namespace_child.rs", "bytes": 27915, "sha256": "af77e882eba8e32d13657e29b363b07c4de68fce5e4e3efedb055c5ab700eda2", "excerpts": [{"start": 14, "end": 76, "text": "14: \n15: #[path = \"production_namespace_mount_child.rs\"]\n16: mod empty_root;\n17: #[path = \"production_namespace_binder_child.rs\"]\n18: mod private_binder;\n19: #[cfg(test)]\n20: #[path = \"production_namespace_binder_ipc_child.rs\"]\n21: mod private_binder_ipc;\n22: #[path = \"production_namespace_device_child.rs\"]\n23: mod private_dev;\n24: #[path = \"production_namespace_processfs_child.rs\"]\n25: mod process_filesystems;\n26: #[path = \"production_namespace_writable_proc_child.rs\"]\n27: mod writable_proc;\n28: \n29: #[derive(Clone, Copy)]\n30: #[repr(u32)]\n31: pub(super) enum Phase {\n32:     Created = 1,\n33:     Enter = 2,\n34:     Ready = 3,\n35:     Go = 4,\n36:     Mapped = 5,\n37:     Stop = 6,\n38:     PrepareTree = 13,\n39:     TreeSpawned = 14,\n40:     TreeReady = 15,\n41:     MountEmptyBase = 16,\n42:     EmptyRootReady = 17,\n43:     MountPrivateDev = 20,\n44:     PrivateDevReady = 21,\n45:     PrepareProcessFilesystems = 24,\n46:     ProcessFilesystemsReady = 25,\n47:     PrepareBinder = 28,\n48:     BinderReady = 29,\n49:     #[cfg(test)]\n50:     ProbeBinder = 32,\n51:     #[cfg(test)]\n52:     BinderChecked = 33,\n53:     ProcContextReady = 30,\n54:     ProcMountReady = 31,\n55:     PrepareWritableProc = 38,\n56:     WritableProcReady = 39,\n57:     #[cfg(test)]\n58:     ProbeWritableProc = 40,\n59:     #[cfg(test)]\n60:     WritableProcChecked = 41,\n61:     #[cfg(test)]\n62:     ProbeProcessFilesystems = 26,\n63:     #[cfg(test)]\n64:     ProcessFilesystemsChecked = 27,\n65:     #[cfg(test)]\n66:     ProbePrivateDev = 22,\n67:     #[cfg(test)]\n68:     PrivateDevChecked = 23,\n69:     #[cfg(test)]\n70:     ProbeEmptyRoot = 18,\n71:     #[cfg(test)]\n72:     EmptyRootChecked = 19,\n73:     Failed = 7,\n74:     #[cfg(test)]\n75:     Parked = 8,\n76:     #[cfg(test)]"}, {"start": 251, "end": 312, "text": "251:     }\n252:     let mask = SignalMask::block()?;\n253:     let mut pidfd = -1_i32;\n254:     let args = CloneArgs {\n255:         flags: libc::CLONE_PIDFD as u64,\n256:         pidfd: (&mut pidfd as *mut i32) as u64,\n257:         exit_signal: libc::SIGCHLD as u64,\n258:         ..CloneArgs::default()\n259:     };\n260:     // SAFETY: clone3 copies the process without CLONE_VM/FILES/THREAD. The\n261:     // child branches immediately into a fixed ! function with no destructors.\n262:     // CLONE_PIDFD returns ownership atomically; there is no pidfd_open fallback.\n263:     let pid = unsafe { libc::syscall(libc::SYS_clone3, &args, std::mem::size_of::<CloneArgs>()) };\n264:     if pid == 0 {\n265:         // SAFETY: only the newly cloned child reaches this no-return function.\n266:         unsafe {\n267:             child_main(child.as_raw_fd(), parent_pid as u32, nonce, mode);\n268:         }\n269:     }\n270:     if pid < 0 {\n271:         return Err(io::Error::last_os_error().into());\n272:     }\n273:     // Successful CLONE_PIDFD guarantees this descriptor. No separate PID\n274:     // lookup is ever used to acquire lifecycle authority.\n275:     if pidfd < 0 || pid > i32::MAX as libc::c_long {\n276:         // Closing both socket endpoints makes the fixed child exit. Do not\n277:         // signal an unbound numeric PID, even on a broken syscall contract.\n278:         return Err(NamespaceError::Rejected(\n279:             \"clone3 did not return its promised pidfd\",\n280:         ));\n281:     }\n282:     // SAFETY: newly acquired atomic clone3 pidfd.\n283:     let owned_pidfd = unsafe { OwnedFd::from_raw_fd(pidfd) };\n284:     drop(child);\n285:     drop(mask); // restore only this parent thread's original signal mask\n286:     Ok((\n287:         pid as u32,\n288:         owned_pidfd,\n289:         parent,\n290:         parent_pid as u32,\n291:         creator_tid,\n292:         nonce,\n293:     ))\n294: }\n295: \n296: struct SignalMask {\n297:     previous: u64,\n298: }\n299: \n300: impl SignalMask {\n301:     fn block() -> Result<Self> {\n302:         // Linux's kernel rt_sigprocmask ABI has 64 signal bits. This is the\n303:         // raw kernel mask, not libc's larger userspace sigset_t.\n304:         let all = u64::MAX;\n305:         let mut previous = 0_u64;\n306:         // SAFETY: fixed 8-byte kernel masks; only the calling thread changes.\n307:         if unsafe {\n308:             libc::syscall(\n309:                 libc::SYS_rt_sigprocmask,\n310:                 libc::SIG_SETMASK,\n311:                 &all,\n312:                 &mut previous,"}, {"start": 501, "end": 570, "text": "501:         }\n502:         // Clear supplementary host groups before unshare. Afterwards gid_map\n503:         // is empty, so setgroups would fail until the privileged parent writes it.\n504:         // Preserve allow: Android must subsequently set its mapped groups.\n505:         if libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0\n506:             && libc::syscall(libc::SYS_setgroups, 0, std::ptr::null::<libc::gid_t>()) != 0\n507:         {\n508:             fail(nonce, pid);\n509:         }\n510:         if libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0 {\n511:             fail(nonce, pid);\n512:         }\n513:         if libc::syscall(libc::SYS_unshare, libc::CLONE_NEWUSER) != 0 {\n514:             fail(nonce, pid);\n515:         }\n516:         send(nonce, Phase::Ready, 0, pid);\n517:         receive(nonce, parent_pid, Phase::Go);\n518:         if libc::syscall(libc::SYS_setresgid, 0, 0, 0) != 0 {\n519:             fail(nonce, pid);\n520:         }\n521:         if libc::syscall(libc::SYS_setresuid, 0, 0, 0) != 0 {\n522:             fail(nonce, pid);\n523:         }\n524:         // Linux clears PDEATHSIG on credential changes; re-arm and re-check.\n525:         parent_death(parent_pid, nonce, pid);\n526:         if libc::syscall(libc::SYS_prctl, libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0 {\n527:             fail(nonce, pid);\n528:         }\n529:         if libc::syscall(libc::SYS_getuid) != 0\n530:             || libc::syscall(libc::SYS_geteuid) != 0\n531:             || libc::syscall(libc::SYS_getgid) != 0\n532:             || libc::syscall(libc::SYS_getegid) != 0\n533:             || libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0\n534:         {\n535:             finish(126);\n536:         }\n537:         send(nonce, Phase::Mapped, 0, pid);\n538:         #[cfg(test)]\n539:         if matches!(_mode, Mode::GroupControl) {\n540:             receive(nonce, parent_pid, Phase::ProbeGroups);\n541:             let groups: [libc::gid_t; 2] = [1, 99999];\n542:             let mut observed: [libc::gid_t; 2] = [0, 0];\n543:             if libc::syscall(libc::SYS_setgroups, 2, groups.as_ptr()) != 0\n544:                 || libc::syscall(libc::SYS_getgroups, 2, observed.as_mut_ptr()) != 2\n545:                 || observed != groups\n546:             {\n547:                 fail(nonce, pid);\n548:             }\n549:             send(nonce, Phase::GroupsSet, 0, pid);\n550:             receive(nonce, parent_pid, Phase::ClearGroups);\n551:             if libc::syscall(libc::SYS_setgroups, 0, std::ptr::null::<libc::gid_t>()) != 0\n552:                 || libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0\n553:             {\n554:                 fail(nonce, pid);\n555:             }\n556:             send(nonce, Phase::GroupsCleared, 0, pid);\n557:         }\n558:         let parent_thread = receive_tree_request(nonce, parent_pid);\n559:         create_isolated_child(parent_pid, nonce, pid, parent_thread, _mode);\n560:         finish(0);\n561:     }\n562: }\n563: \n564: // Fixed namespace-tree branch. The request is possible only over the already\n565: // nonce-bound private socket. The sole supplied FD is the broker's actual\n566: // creating-thread pidfd, used read-only for the parent-death race.\n567: unsafe fn receive_tree_request(nonce: [u8; 16], parent_pid: u32) -> RawFd {\n568:     let mut packet = Packet::zeroed();\n569:     let mut iov = libc::iovec {\n570:         iov_base: (&mut packet as *mut Packet).cast(),"}, {"start": 697, "end": 816, "text": "697:         )\n698:     } != std::mem::size_of::<Packet>() as libc::c_long\n699:     {\n700:         // Closing the untransferred control endpoint makes the fixed PID 1\n701:         // exit. The broker still quarantines the reservation unless it has a\n702:         // bound pidfd and proves that exact reap.\n703:         unsafe {\n704:             finish(121);\n705:         }\n706:     }\n707: }\n708: \n709: unsafe fn create_isolated_child(\n710:     parent_pid: u32,\n711:     nonce: [u8; 16],\n712:     creator_pid: u32,\n713:     parent_thread: RawFd,\n714:     mode: Mode,\n715: ) {\n716:     unsafe {\n717:         check_parent_thread(parent_thread);\n718:     }\n719:     let mut sockets = [-1_i32; 2];\n720:     if unsafe {\n721:         libc::syscall(\n722:             libc::SYS_socketpair,\n723:             libc::AF_UNIX,\n724:             libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC,\n725:             0,\n726:             sockets.as_mut_ptr(),\n727:         )\n728:     } != 0\n729:     {\n730:         unsafe {\n731:             fail(nonce, creator_pid);\n732:         }\n733:     }\n734:     let one = 1_i32;\n735:     if unsafe {\n736:         libc::syscall(\n737:             libc::SYS_setsockopt,\n738:             sockets[0],\n739:             libc::SOL_SOCKET,\n740:             libc::SO_PASSCRED,\n741:             &one,\n742:             std::mem::size_of::<i32>(),\n743:         )\n744:     } != 0\n745:     {\n746:         unsafe {\n747:             fail(nonce, creator_pid);\n748:         }\n749:     }\n750:     let mut inner_pidfd = -1_i32;\n751:     // No NEWUSER here: all six namespaces are owned by the already-admitted\n752:     // mapped userns. CLONE_PARENT inherits this creator's SIGCHLD parent\n753:     // relationship. clone3 explicitly requires exit_signal=0 with that flag.\n754:     let args = CloneArgs {\n755:         flags: (libc::CLONE_PARENT\n756:             | libc::CLONE_PIDFD\n757:             | libc::CLONE_NEWPID\n758:             | libc::CLONE_NEWNS\n759:             | libc::CLONE_NEWIPC\n760:             | libc::CLONE_NEWUTS\n761:             | libc::CLONE_NEWNET\n762:             | libc::CLONE_NEWCGROUP) as u64,\n763:         pidfd: (&mut inner_pidfd as *mut i32) as u64,\n764:         exit_signal: 0,\n765:         ..CloneArgs::default()\n766:     };\n767:     let pid = unsafe { libc::syscall(libc::SYS_clone3, &args, std::mem::size_of::<CloneArgs>()) };\n768:     if pid == 0 {\n769:         unsafe {\n770:             isolated_child_main(sockets[1], parent_thread, parent_pid, nonce, mode);\n771:         }\n772:     }\n773:     if pid < 0 {\n774:         unsafe {\n775:             fail(nonce, creator_pid);\n776:         }\n777:     }\n778:     if inner_pidfd < 0 || pid > i32::MAX as libc::c_long {\n779:         unsafe {\n780:             finish(127);\n781:         }\n782:     }\n783:     unsafe {\n784:         send_created_fds(nonce, creator_pid, inner_pidfd, sockets[0]);\n785:         libc::syscall(libc::SYS_close, inner_pidfd);\n786:         libc::syscall(libc::SYS_close, sockets[0]);\n787:         libc::syscall(libc::SYS_close, sockets[1]);\n788:         libc::syscall(libc::SYS_close, parent_thread);\n789:         // The creator keeps only FD 3 and can never create a second child.\n790:         receive(nonce, parent_pid, Phase::Stop);\n791:         finish(0);\n792:     }\n793: }\n794: \n795: unsafe fn isolated_child_main(\n796:     control: RawFd,\n797:     parent_thread: RawFd,\n798:     parent_pid: u32,\n799:     nonce: [u8; 16],\n800:     _mode: Mode,\n801: ) -> ! {\n802:     unsafe {\n803:         if control != CHILD_FD\n804:             && libc::syscall(libc::SYS_dup3, control, CHILD_FD, libc::O_CLOEXEC)\n805:                 != libc::c_long::from(CHILD_FD)\n806:         {\n807:             finish(120);\n808:         }\n809:         // The creator supplied only these two descriptors. No reservation,\n810:         // host service, namespace-administration or data FD crosses this barrier.\n811:         if parent_thread != 4 || libc::syscall(libc::SYS_close_range, 5_u32, u32::MAX, 0) != 0 {\n812:             finish(120);\n813:         }\n814:         libc::syscall(libc::SYS_close, 0);\n815:         libc::syscall(libc::SYS_close, 1);\n816:         libc::syscall(libc::SYS_close, 2);"}, {"start": 874, "end": 888, "text": "874: \n875: #[cfg(test)]\n876: pub(super) fn processfs_private_failure(value: i32) -> Option<(u32, u32, i32)> {\n877:     process_filesystems::decode_private_failure(value)\n878: }\n879: \n880: #[cfg(test)]\n881: pub(super) fn binder_private_failure(value: i32) -> Option<(u32, u32, i32)> {\n882:     private_binder::decode_private_failure(value)\n883: }\n884: \n885: #[cfg(test)]\n886: pub(super) fn writable_proc_private_failure(value: i32) -> Option<(u32, u32, i32)> {\n887:     writable_proc::decode_private_failure(value)\n888: }"}], "latest_source_dirs": [{"path": "/home/alex/work/pocket4-android-final/qualification/production-namespace-broker-source-20261109-8b88-r10", "mtime_ns": 1794240031893418889}, {"path": "/home/alex/work/pocket4-android-final/qualification/production-namespace-broker-source-20261109-8b88-r11", "mtime_ns": 1794241549262198149}, {"path": "/home/alex/work/pocket4-android-final/qualification/production-namespace-broker-source-20261109-8b88-r12", "mtime_ns": 1794246525180123300}, {"path": "/home/alex/work/pocket4-android-final/qualification/production-namespace-broker-source-20261109-8b88-r13", "mtime_ns": 1794248160745516540}, {"path": "/home/alex/work/poc