      "text": "package {\n    // See: http://go/android-license-faq\n    default_applicable_licenses: [\"Android-Apache-2.0\"],\n    default_team: \"trendy_team_arc_next\",\n}\n\nandroid_library {\n    name: \"EyeDropperLib\",\n    srcs: [\"src/**/*.kt\"],\n    resource_dirs: [\"res\"],\n    platform_apis: true,\n    static_libs: [\n        \"androidx.activity_activity\", // ComponentActivity\n        \"androidx.activity_activity-compose\", // setContent\n        \"androidx.appcompat_appcompat\", // AppCompatResources\n        \"hilt_android\",\n\n        // Jetpack Compose & runtime\n        \"androidx.compose.runtime_runtime\",\n        \"androidx.compose.ui_ui\", // ComposeView\n        \"androidx.compose.ui_ui-graphics\",\n        \"androidx.compose.ui_ui-geometry\",\n        \"androidx.compose.ui_ui-unit\",\n        \"androidx.compose.material_material-icons-core\",\n        \"androidx.compose.material_material-icons-extended\",\n        \"androidx.compose.foundation_foundation\",\n        \"androidx.compose.foundation_foundation-layout\",\n\n        \"androidx.compose.material3_material3\",\n\n        // Lifecycle, ViewModel, SavedState for ComposeView\n        \"androidx.lifecycle_lifecycle-service\",\n        \"androidx.lifecycle_lifecycle-common\",\n        \"androidx.lifecycle_lifecycle-runtime\", // Provides setViewTreeLifecycleOwner\n        \"androidx.lifecycle_lifecycle-viewmodel\", // Provides setViewTreeViewModelStoreOwner\n        \"androidx.savedstate_savedstate\", // Provides setViewTreeSavedStateRegistryOwner\n        \"androidx.lifecycle_lifecycle-viewmodel-compose\",\n    ],\n}\n\nandroid_app {\n    name: \"EyeDropper\",\n    platform_apis: true,\n    certificate: \"platform\",\n    privileged: true,\n    static_libs: [\n        \"EyeDropperLib\",\n    ],\n    optimize: {\n        optimize: true,\n        shrink_resources: true,\n    },\n}\n\naconfig_declarations {\n    name: \"com.android.eyedropper.flags-aconfig\",\n    package: \"com.android.eyedropper\",\n    container: \"system\",\n    exportable: true,\n    srcs: [\n        \"flags/eye_dropper_flags.aconfig\",\n    ],\n}\n\njava_aconfig_library {\n    name: \"com.android.eyedropper.flags-aconfig-java\",\n    aconfig_declarations: \"com.android.eyedropper.flags-aconfig\",\n    defaults: [\"framework-minus-apex-aconfig-java-defaults\"],\n}\n"
    },
