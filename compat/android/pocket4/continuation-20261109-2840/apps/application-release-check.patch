+    #[test]
+    fn exact_version_split_signer_uid_and_engine_are_required() {
+        for field in 0..7 {
+            let (root, manifest, mut results) = fixture(1);
+            let id = &mut results.apps[0].identity;
+            match field {
+                0 => id.version_code += 1,
