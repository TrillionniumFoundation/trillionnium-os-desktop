+                sub_state: self.string(&path, u, c"SubState")?,
+                fragment_path: self.string(&path, u, c"FragmentPath")?,
+                unit_file_state: self.string(&path, u, c"UnitFileState")?,
+                condition_result: self.boolean(&path, c"ConditionResult")?,
