+            (self.get_trivial)(
+                self.bus,
+                c"org.freedesktop.systemd1".as_ptr(),
+                path.as_ptr(),
+                interface.as_ptr(),
+                property.as_ptr(),
+                std::ptr::null_mut(),
+                b'u' as libc::c_char,
+                (&mut value as *mut u32).cast(),
+            )
