+    // chmod an existing base directory: it remains an immutable lower mount.
+    if created && unsafe { libc::syscall(libc::SYS_fchmod, fd, 0o755_u32) } != 0 {
+        unsafe { syscall_failure(nonce, line!()) }
+    }
