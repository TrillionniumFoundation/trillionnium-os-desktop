+        bus_rc(unsafe {
+            (self.get_trivial)(
+                self.bus,
+                c"org.freedesktop.systemd1".as_ptr(),
+                path.as_ptr(),
+                c"org.freedesktop.systemd1.Unit".as_ptr(),
+                property.as_ptr(),
+                std::ptr::null_mut(),
+                b'b' as libc::c_char,
+                (&mut value as *mut libc::c_int).cast(),
+            )
