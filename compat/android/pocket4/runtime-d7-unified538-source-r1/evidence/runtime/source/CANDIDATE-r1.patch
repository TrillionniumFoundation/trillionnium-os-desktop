+        let (root, lease) = broker_fixture();
+        let path = root.path().join("registry/u1000.json");
+        let mut bytes = fs::read(&path).unwrap();
+        bytes.push(b' ');
+        fs::write(&path, &bytes).unwrap();
+        assert!(lease.revalidate_for_broker().is_err());
+    }
+
+    #[test]
+    fn broker_revalidation_rejects_replaced_lock_inode() {
+        let (root, lease) = broker_fixture();
+        let path = root.path().join("registry/u1000.lease");
+        fs::rename(&path, path.with_extension("saved")).unwrap();
+        fs::write(&path, []).unwrap();
+        fs::set_permissions(&path, fs::Permissions::from_mode(0o600)).unwrap();
+        assert!(lease.revalidate_for_broker().is_err());
+    }
+
+    #[test]
+    fn broker_revalidation_rejects_replaced_registry_directory() {
+        let (root, lease) = broker_fixture();
+        fs::rename(root.path().join("registry"), root.path().join("saved")).unwrap();
+        fs::create_dir(root.path().join("registry")).unwrap();
+        fs::set_permissions(
+            root.path().join("registry"),
+            fs::Permissions::from_mode(0o700),
+        )
+        .unwrap();
