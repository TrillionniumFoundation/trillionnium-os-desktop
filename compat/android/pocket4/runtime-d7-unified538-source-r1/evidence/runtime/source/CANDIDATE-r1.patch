+                || libc::setuid(1000) != 0
+            {
+                return Err(io::Error::last_os_error());
+            }
+            Ok(())
+        });
+    }
+    let mut owned = OwnedChild(command.spawn().unwrap());
+    assert!(wait_owned(&mut owned.0).success());
