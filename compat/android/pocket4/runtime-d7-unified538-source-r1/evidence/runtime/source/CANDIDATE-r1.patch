+            waitid_code: terminal.0,
+            waitid_status: terminal.1,
+            reaped: worker.reaped,
+            executable_device: before.dev,
+            executable_inode: before.ino,
+            executable_bytes: before.size,
+            executable_sha256: source_sha256,
