+}
+
+unsafe fn attach(context: RawFd, target: RawFd, flags: u32, nonce: [u8; 16]) {
+    unsafe {
+        create_context(context, nonce);
+    }
+    let mount = unsafe { libc::syscall(libc::SYS_fsmount, context, 1_u32, flags) };
+    if mount < 0 || mount > i32::MAX as libc::c_long {
