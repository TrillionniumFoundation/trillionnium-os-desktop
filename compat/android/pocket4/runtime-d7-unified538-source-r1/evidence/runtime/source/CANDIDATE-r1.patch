+#[derive(Clone, Copy)]
+#[repr(C)]
+pub(super) struct Packet {
+    magic: u64,
+    nonce: [u8; 16],
+    pub(super) phase: u32,
+    pub(super) errno: i32,
+    pid: u32,
+    reserved: u32,
+}
+
+const _: () = assert!(std::mem::size_of::<Packet>() == 40);
+
+impl Packet {
+    pub(super) const fn new(nonce: [u8; 16], phase: Phase, errno: i32, pid: u32) -> Self {
+        Self {
+            magic: MAGIC,
+            nonce,
+            phase: phase as u32,
+            errno,
+            pid,
+            reserved: 0,
+        }
+    }
+    pub(super) const fn zeroed() -> Self {
+        Self {
+            magic: 0,
+            nonce: [0; 16],
+            phase: 0,
+            errno: 0,
+            pid: 0,
+            reserved: 0,
+        }
+    }
+    pub(super) fn matches(&self, nonce: [u8; 16], pid: u32) -> bool {
+        self.magic == MAGIC && self.nonce == nonce && self.pid == pid && self.reserved == 0
+    }
+}
+
+#[repr(C)]
+#[derive(Default)]
+struct CloneArgs {
+    flags: u64,
+    pidfd: u64,
+    child_tid: u64,
+    parent_tid: u64,
+    exit_signal: u64,
+    stack: u64,
+    stack_size: u64,
+    tls: u64,
+    set_tid: u64,
+    set_tid_size: u64,
+    cgroup: u64,
+}
+
+type Spawned = (u32, OwnedFd, OwnedFd, u32, libc::pid_t, [u8; 16]);
+
+#[cfg(test)]
+pub(super) fn spawn(mode: Mode) -> Result<Spawned> {
+    spawn_with_cgroup(mode, None)
+}
+
+pub(super) fn spawn_with_cgroup(mode: Mode, target: Option<BorrowedFd<'_>>) -> Result<Spawned> {
+    // Do not permit inherited SIGCHLD auto-reaping: exit must be observed and
+    // reaped through the exact held pidfd, not inferred from missing proc paths.
+    let mut action: libc::sigaction = unsafe { std::mem::zeroed() };
+    // SAFETY: read-only query, writable initialized action.
+    if unsafe { libc::sigaction(libc::SIGCHLD, std::ptr::null(), &mut action) } != 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    if action.sa_sigaction != libc::SIG_DFL || action.sa_flags & libc::SA_NOCLDWAIT != 0 {
+        return Err(NamespaceError::Rejected(
+            "SIGCHLD auto-reaping prevents owned exit proof",
+        ));
+    }
+    let mut sockets = [-1_i32; 2];
+    // SAFETY: two writable fd slots; no external socket/address is contacted.
+    if unsafe {
+        libc::socketpair(
+            libc::AF_UNIX,
+            libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC,
+            0,
+            sockets.as_mut_ptr(),
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error().into());
+    }
+    // SAFETY: successful socketpair transfers both newly owned descriptors.
+    let parent = unsafe { OwnedFd::from_raw_fd(sockets[0]) };
+    let child = unsafe { OwnedFd::from_raw_fd(sockets[1]) };
+    let passcred: libc::c_int = 1;
+    // SAFETY: a scalar SO_PASSCRED value on the private parent endpoint.
+    if unsafe {
+        libc::setsockopt(
+            parent.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PASSCRED,
+            (&passcred as *const libc::c_int).cast(),
+            std::mem::size_of_val(&passcred) as libc::socklen_t,
+        )
+    } != 0
+    {
+        return Err(io::Error::last_os_error().into());
+    }
+    let mut nonce = [0_u8; 16];
+    let mut got = 0;
+    while got < nonce.len() {
+        // SAFETY: remaining writable nonce slice; no user-provided pointer.
+        let rc = unsafe {
+            libc::syscall(
+                libc::SYS_getrandom,
+                nonce.as_mut_ptr().add(got),
+                nonce.len() - got,
+                0,
+            )
+        };
+        if rc < 0 {
+            let e = io::Error::last_os_error();
+            if e.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return Err(e.into());
+        }
+        if rc == 0 {
+            return Err(NamespaceError::Rejected(
+                "getrandom returned no nonce bytes",
+            ));
+        }
+        got += rc as usize;
+    }
+    // SAFETY: read-only identity syscalls.
+    let parent_pid = unsafe { libc::getpid() };
+    let creator_tid = unsafe { libc::syscall(libc::SYS_gettid) } as libc::pid_t;
+    if parent_pid <= 1 || creator_tid <= 1 {
+        return Err(NamespaceError::Rejected(
+            "namespace broker cannot be host PID 1",
+        ));
+    }
+    let mask = SignalMask::block()?;
+    let mut pidfd = -1_i32;
+    let args = CloneArgs {
+        flags: libc::CLONE_PIDFD as u64 | if target.is_some() { 0x2_0000_0000 } else { 0 },
+        cgroup: target.map(|fd| fd.as_raw_fd() as u64).unwrap_or(0),
+        pidfd: (&mut pidfd as *mut i32) as u64,
+        exit_signal: libc::SIGCHLD as u64,
+        ..CloneArgs::default()
+    };
+    // SAFETY: clone3 copies the process without CLONE_VM/FILES/THREAD. The
+    // child branches immediately into a fixed ! function with no destructors.
+    // CLONE_PIDFD returns ownership atomically; there is no pidfd_open fallback.
+    let pid = unsafe { libc::syscall(libc::SYS_clone3, &args, std::mem::size_of::<CloneArgs>()) };
+    if pid == 0 {
+        // SAFETY: only the newly cloned child reaches this no-return function.
+        unsafe {
+            child_main(child.as_raw_fd(), parent_pid as u32, nonce, mode);
+        }
+    }
+    if pid < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    // Successful CLONE_PIDFD guarantees this descriptor. No separate PID
+    // lookup is ever used to acquire lifecycle authority.
+    if pidfd < 0 || pid > i32::MAX as libc::c_long {
+        // Closing both socket endpoints makes the fixed child exit. Do not
+        // signal an unbound numeric PID, even on a broken syscall contract.
+        return Err(NamespaceError::Rejected(
+            "clone3 did not return its promised pidfd",
+        ));
+    }
+    // SAFETY: newly acquired atomic clone3 pidfd.
+    let owned_pidfd = unsafe { OwnedFd::from_raw_fd(pidfd) };
+    drop(child);
+    drop(mask); // restore only this parent thread's original signal mask
+    Ok((
+        pid as u32,
+        owned_pidfd,
+        parent,
+        parent_pid as u32,
+        creator_tid,
+        nonce,
+    ))
+}
+
+struct SignalMask {
+    previous: u64,
+}
+
+impl SignalMask {
+    fn block() -> Result<Self> {
+        // Linux's kernel rt_sigprocmask ABI has 64 signal bits. This is the
+        // raw kernel mask, not libc's larger userspace sigset_t.
+        let all = u64::MAX;
+        let mut previous = 0_u64;
+        // SAFETY: fixed 8-byte kernel masks; only the calling thread changes.
+        if unsafe {
+            libc::syscall(
+                libc::SYS_rt_sigprocmask,
+                libc::SIG_SETMASK,
+                &all,
+                &mut previous,
+                8,
+            )
+        } != 0
+        {
+            return Err(io::Error::last_os_error().into());
+        }
+        Ok(Self { previous })
+    }
+}
+impl Drop for SignalMask {
+    fn drop(&mut self) {
+        // SAFETY: same valid fixed ABI and saved mask as the successful block.
+        let rc = unsafe {
+            libc::syscall(
+                libc::SYS_rt_sigprocmask,
+                libc::SIG_SETMASK,
+                &self.previous,
+                std::ptr::null::<u64>(),
+                8,
+            )
+        };
+        debug_assert_eq!(rc, 0, "restoring the creating thread signal mask failed");
+    }
+}
+
+// These functions are child-only. Their unsafe bodies contain no heap-backed
+// state, formatting, libstd, callback, lock, panic path or Rust unwinding.
+unsafe fn finish(status: i32) -> ! {
+    unsafe {
+        libc::syscall(libc::SYS_exit_group, status);
+        // SYS_exit_group cannot return. Keep a syscall-only terminal fallback.
+        loop {
+            libc::syscall(libc::SYS_exit, status);
+        }
+    }
+}
+
+unsafe fn send(nonce: [u8; 16], phase: Phase, errno: i32, pid: u32) {
+    let packet = Packet::new(nonce, phase, errno, pid);
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_sendto,
+            CHILD_FD,
+            &packet,
+            std::mem::size_of::<Packet>(),
+            libc::MSG_NOSIGNAL | libc::MSG_DONTWAIT,
+            std::ptr::null::<libc::sockaddr>(),
+            0,
+        )
+    };
+    if rc != std::mem::size_of::<Packet>() as libc::c_long {
+        unsafe {
+            finish(121);
+        }
+    }
+}
+
+unsafe fn fail(nonce: [u8; 16], pid: u32) -> ! {
+    // The errno TLS belongs to this cloned child; no allocation/lock is used.
+    let errno = unsafe { *libc::__errno_location() };
+    unsafe {
+        send(
+            nonce,
+            Phase::Failed,
+            if errno > 0 { errno } else { libc::EIO },
+            pid,
+        );
+    }
+    unsafe {
+        finish(122);
+    }
+}
+
+unsafe fn receive(nonce: [u8; 16], parent_pid: u32, wanted: Phase) {
+    let mut packet = Packet::zeroed();
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_recvfrom,
+            CHILD_FD,
+            &mut packet,
+            std::mem::size_of::<Packet>(),
+            libc::MSG_TRUNC,
+            std::ptr::null_mut::<libc::sockaddr>(),
+            std::ptr::null_mut::<libc::socklen_t>(),
+        )
+    };
+    if rc == 0 {
+        unsafe {
+            finish(0);
+        }
+    }
+    if rc != std::mem::size_of::<Packet>() as libc::c_long
+        || !packet.matches(nonce, parent_pid)
+        || packet.errno != 0
+    {
+        unsafe {
+            finish(123);
+        }
+    }
+    if packet.phase == Phase::Stop as u32 {
+        unsafe {
+            finish(0);
+        }
+    }
+    if packet.phase != wanted as u32 {
+        unsafe {
+            finish(124);
+        }
+    }
+}
+
+unsafe fn parent_death(parent_pid: u32, nonce: [u8; 16], pid: u32) {
+    if unsafe {
+        libc::syscall(
+            libc::SYS_prctl,
+            libc::PR_SET_PDEATHSIG,
+            libc::SIGKILL,
+            0,
+            0,
+            0,
+        )
+    } != 0
+    {
+        unsafe {
+            fail(nonce, pid);
+        }
+    }
+    if unsafe { libc::syscall(libc::SYS_getppid) } != libc::c_long::from(parent_pid) {
+        unsafe {
+            finish(125);
+        }
+    }
+}
+
+unsafe fn child_main(fd: RawFd, parent_pid: u32, nonce: [u8; 16], _mode: Mode) -> ! {
+    unsafe {
+        // Only the private control FD survives. Inherited reservation/data/
+        // service descriptors cannot leak into the parked namespace child.
+        if fd != CHILD_FD
+            && libc::syscall(libc::SYS_dup3, fd, CHILD_FD, libc::O_CLOEXEC)
+                != libc::c_long::from(CHILD_FD)
+        {
+            finish(120);
+        }
+        if libc::syscall(libc::SYS_close_range, 4_u32, u32::MAX, 0) != 0 {
+            finish(120);
+        }
+        libc::syscall(libc::SYS_close, 0);
+        libc::syscall(libc::SYS_close, 1);
+        libc::syscall(libc::SYS_close, 2);
+        if libc::syscall(libc::SYS_chdir, c"/".as_ptr()) != 0 {
+            finish(120);
+        }
+        let pid = libc::syscall(libc::SYS_getpid) as u32;
+        parent_death(parent_pid, nonce, pid);
+        #[cfg(test)]
+        if matches!(_mode, Mode::ExitWithPrivateDiagnostic) {
+            // Ordinary owned-child queue/retirement control; no namespace or
+            // mount operation. The production build contains no such branch.
+            let code = 0x1000_0000_u32 | (1 << 24) | (123 << 12) | libc::EPROTO as u32;
+            send(nonce, Phase::Failed, code as i32, pid);
+            finish(127);
+        }
+        #[cfg(test)]
+        if matches!(_mode, Mode::ExitBeforeCreated) {
+            finish(42);
+        }
+        #[cfg(test)]
+        if matches!(_mode, Mode::WrongNonce) {
+            let mut wrong = nonce;
+            wrong[0] ^= 1;
+            send(wrong, Phase::Created, 0, pid);
+            receive(nonce, parent_pid, Phase::Stop);
+            finish(0);
+        }
+        send(nonce, Phase::Created, 0, pid);
+        receive(nonce, parent_pid, Phase::Enter);
+        #[cfg(test)]
+        if matches!(_mode, Mode::WithholdReady) {
+            loop {
+                libc::syscall(libc::SYS_pause);
+            }
+        }
+        #[cfg(test)]
+        if matches!(_mode, Mode::ParkOnly) {
+            send(nonce, Phase::Parked, 0, pid);
+            receive(nonce, parent_pid, Phase::Stop);
+            finish(0);
+        }
+        // Clear supplementary host groups before unshare. Afterwards gid_map
+        // is empty, so setgroups would fail until the privileged parent writes it.
+        // Preserve allow: Android must subsequently set its mapped groups.
+        if libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0
+            && libc::syscall(libc::SYS_setgroups, 0, std::ptr::null::<libc::gid_t>()) != 0
+        {
+            fail(nonce, pid);
+        }
+        if libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0 {
+            fail(nonce, pid);
+        }
+        if libc::syscall(libc::SYS_unshare, libc::CLONE_NEWUSER) != 0 {
+            fail(nonce, pid);
+        }
+        send(nonce, Phase::Ready, 0, pid);
+        receive(nonce, parent_pid, Phase::Go);
+        if libc::syscall(libc::SYS_setresgid, 0, 0, 0) != 0 {
+            fail(nonce, pid);
+        }
+        if libc::syscall(libc::SYS_setresuid, 0, 0, 0) != 0 {
+            fail(nonce, pid);
+        }
+        // Linux clears PDEATHSIG on credential changes; re-arm and re-check.
+        parent_death(parent_pid, nonce, pid);
+        if libc::syscall(libc::SYS_prctl, libc::PR_SET_NO_NEW_PRIVS, 1, 0, 0, 0) != 0 {
+            fail(nonce, pid);
+        }
+        if libc::syscall(libc::SYS_getuid) != 0
+            || libc::syscall(libc::SYS_geteuid) != 0
+            || libc::syscall(libc::SYS_getgid) != 0
+            || libc::syscall(libc::SYS_getegid) != 0
+            || libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0
+        {
+            finish(126);
+        }
+        send(nonce, Phase::Mapped, 0, pid);
+        #[cfg(test)]
+        if matches!(_mode, Mode::GroupControl) {
+            receive(nonce, parent_pid, Phase::ProbeGroups);
+            let groups: [libc::gid_t; 2] = [1, 99999];
+            let mut observed: [libc::gid_t; 2] = [0, 0];
+            if libc::syscall(libc::SYS_setgroups, 2, groups.as_ptr()) != 0
+                || libc::syscall(libc::SYS_getgroups, 2, observed.as_mut_ptr()) != 2
+                || observed != groups
+            {
+                fail(nonce, pid);
+            }
+            send(nonce, Phase::GroupsSet, 0, pid);
+            receive(nonce, parent_pid, Phase::ClearGroups);
+            if libc::syscall(libc::SYS_setgroups, 0, std::ptr::null::<libc::gid_t>()) != 0
+                || libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0
+            {
+                fail(nonce, pid);
+            }
+            send(nonce, Phase::GroupsCleared, 0, pid);
+        }
+        let parent_thread = receive_tree_request(nonce, parent_pid);
+        create_isolated_child(parent_pid, nonce, pid, parent_thread, _mode);
+        finish(0);
+    }
+}
+
+// Fixed namespace-tree branch. The request is possible only over the already
+// nonce-bound private socket. The sole supplied FD is the broker's actual
+// creating-thread pidfd, used read-only for the parent-death race.
+unsafe fn receive_tree_request(nonce: [u8; 16], parent_pid: u32) -> RawFd {
+    let mut packet = Packet::zeroed();
+    let mut iov = libc::iovec {
+        iov_base: (&mut packet as *mut Packet).cast(),
+        iov_len: std::mem::size_of::<Packet>(),
+    };
+    let mut ancillary = [0_usize; 16];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iov;
+    message.msg_iovlen = 1;
+    message.msg_control = ancillary.as_mut_ptr().cast();
+    message.msg_controllen = std::mem::size_of_val(&ancillary);
+    let rc = unsafe {
+        libc::syscall(
+            libc::SYS_recvmsg,
+            CHILD_FD,
+            &mut message,
+            libc::MSG_CMSG_CLOEXEC,
+        )
+    };
+    if rc == 0 {
+        unsafe {
+            finish(0);
+        }
+    }
+    if rc != std::mem::size_of::<Packet>() as libc::c_long
+        || message.msg_flags & (libc::MSG_TRUNC | libc::MSG_CTRUNC) != 0
+        || !packet.matches(nonce, parent_pid)
+        || packet.errno != 0
+    {
+        unsafe {
+            finish(123);
+        }
+    }
+    let first = unsafe { libc::CMSG_FIRSTHDR(&message) };
+    if packet.phase == Phase::Stop as u32 {
+        if !first.is_null() {
+            unsafe {
+                finish(123);
+            }
+        }
+        unsafe {
+            finish(0);
+        }
+    }
+    if packet.phase != Phase::PrepareTree as u32 || first.is_null() {
+        unsafe {
+            finish(124);
+        }
+    }
+    let header = unsafe { &*first };
+    if header.cmsg_level != libc::SOL_SOCKET
+        || header.cmsg_type != libc::SCM_RIGHTS
+        || header.cmsg_len != unsafe { libc::CMSG_LEN(std::mem::size_of::<i32>() as u32) } as usize
+        || !unsafe { libc::CMSG_NXTHDR(&message, first) }.is_null()
+    {
+        unsafe {
+            finish(123);
+        }
+    }
+    let parent = unsafe { std::ptr::read_unaligned(libc::CMSG_DATA(first).cast::<i32>()) };
+    if parent < 0 || parent == CHILD_FD {
+        unsafe {
+            finish(123);
+        }
+    }
+    let mut kind: libc::statfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::syscall(libc::SYS_fstatfs, parent, &mut kind) } != 0
+        || kind.f_type != 0x5049_4446
+    // Linux PID_FS_MAGIC, not a pathname
+    {
+        unsafe {
+            finish(123);
+        }
+    }
+    // FD 3 remains the old creator-control socket, FD 4 is a read-only pidfd.
+    if parent != 4 && unsafe { libc::syscall(libc::SYS_dup3, parent, 4, libc::O_CLOEXEC) } != 4 {
+        unsafe {
+            finish(120);
+        }
+    }
+    if parent != 4 {
+        unsafe {
+            libc::syscall(libc::SYS_close, parent);
+        }
+    }
+    4
+}
+
+unsafe fn check_parent_thread(pidfd: RawFd) {
+    let mut event = libc::pollfd {
+        fd: pidfd,
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    if unsafe { libc::syscall(libc::SYS_poll, &mut event, 1, 0) } != 0 || event.revents != 0 {
+        unsafe {
+            finish(125);
+        }
+    }
+}
+
+unsafe fn send_created_fds(nonce: [u8; 16], creator_pid: u32, pidfd: RawFd, control: RawFd) {
+    let packet = Packet::new(nonce, Phase::TreeSpawned, 0, creator_pid);
+    let mut iov = libc::iovec {
+        iov_base: (&packet as *const Packet).cast_mut().cast(),
+        iov_len: std::mem::size_of::<Packet>(),
+    };
+    let mut ancillary = [0_usize; 8];
+    let mut message: libc::msghdr = unsafe { std::mem::zeroed() };
+    message.msg_iov = &mut iov;
+    message.msg_iovlen = 1;
+    message.msg_control = ancillary.as_mut_ptr().cast();
+    message.msg_controllen =
+        unsafe { libc::CMSG_SPACE(2 * std::mem::size_of::<i32>() as u32) } as usize;
+    let header = unsafe { libc::CMSG_FIRSTHDR(&message) };
+    unsafe {
+        (*header).cmsg_level = libc::SOL_SOCKET;
+        (*header).cmsg_type = libc::SCM_RIGHTS;
+        (*header).cmsg_len = libc::CMSG_LEN(2 * std::mem::size_of::<i32>() as u32) as usize;
+        let values = libc::CMSG_DATA(header).cast::<i32>();
+        std::ptr::write_unaligned(values, pidfd);
+        std::ptr::write_unaligned(values.add(1), control);
+    }
+    if unsafe {
+        libc::syscall(
+            libc::SYS_sendmsg,
+            CHILD_FD,
+            &message,
+            libc::MSG_DONTWAIT | libc::MSG_NOSIGNAL,
+        )
+    } != std::mem::size_of::<Packet>() as libc::c_long
+    {
+        // Closing the untransferred control endpoint makes the fixed PID 1
+        // exit. The broker still quarantines the reservation unless it has a
+        // bound pidfd and proves that exact reap.
+        unsafe {
+            finish(121);
+        }
+    }
+}
+
+unsafe fn create_isolated_child(
+    parent_pid: u32,
+    nonce: [u8; 16],
+    creator_pid: u32,
+    parent_thread: RawFd,
+    mode: Mode,
+) {
+    unsafe {
+        check_parent_thread(parent_thread);
+    }
+    let mut sockets = [-1_i32; 2];
+    if unsafe {
+        libc::syscall(
+            libc::SYS_socketpair,
+            libc::AF_UNIX,
+            libc::SOCK_SEQPACKET | libc::SOCK_CLOEXEC,
+            0,
+            sockets.as_mut_ptr(),
+        )
+    } != 0
+    {
+        unsafe {
+            fail(nonce, creator_pid);
+        }
+    }
+    let one = 1_i32;
+    if unsafe {
+        libc::syscall(
+            libc::SYS_setsockopt,
+            sockets[0],
+            libc::SOL_SOCKET,
+            libc::SO_PASSCRED,
+            &one,
+            std::mem::size_of::<i32>(),
+        )
+    } != 0
+    {
+        unsafe {
+            fail(nonce, creator_pid);
+        }
+    }
+    let mut inner_pidfd = -1_i32;
+    // No NEWUSER here: all six namespaces are owned by the already-admitted
+    // mapped userns. CLONE_PARENT inherits this creator's SIGCHLD parent
+    // relationship. clone3 explicitly requires exit_signal=0 with that flag.
+    let args = CloneArgs {
+        flags: (libc::CLONE_PARENT
+            | libc::CLONE_PIDFD
+            | libc::CLONE_NEWPID
+            | libc::CLONE_NEWNS
+            | libc::CLONE_NEWIPC
+            | libc::CLONE_NEWUTS
+            | libc::CLONE_NEWNET
+            | libc::CLONE_NEWCGROUP) as u64,
+        pidfd: (&mut inner_pidfd as *mut i32) as u64,
+        exit_signal: 0,
+        ..CloneArgs::default()
+    };
+    let pid = unsafe { libc::syscall(libc::SYS_clone3, &args, std::mem::size_of::<CloneArgs>()) };
+    if pid == 0 {
+        unsafe {
+            isolated_child_main(sockets[1], parent_thread, parent_pid, nonce, mode);
+        }
+    }
+    if pid < 0 {
+        unsafe {
+            fail(nonce, creator_pid);
+        }
+    }
+    if inner_pidfd < 0 || pid > i32::MAX as libc::c_long {
+        unsafe {
+            finish(127);
+        }
+    }
+    unsafe {
+        send_created_fds(nonce, creator_pid, inner_pidfd, sockets[0]);
+        libc::syscall(libc::SYS_close, inner_pidfd);
+        libc::syscall(libc::SYS_close, sockets[0]);
+        libc::syscall(libc::SYS_close, sockets[1]);
+        libc::syscall(libc::SYS_close, parent_thread);
+        // The creator keeps only FD 3 and can never create a second child.
+        receive(nonce, parent_pid, Phase::Stop);
+        finish(0);
+    }
+}
+
+unsafe fn isolated_child_main(
+    control: RawFd,
+    parent_thread: RawFd,
+    parent_pid: u32,
+    nonce: [u8; 16],
+    _mode: Mode,
+) -> ! {
+    unsafe {
+        if control != CHILD_FD
+            && libc::syscall(libc::SYS_dup3, control, CHILD_FD, libc::O_CLOEXEC)
+                != libc::c_long::from(CHILD_FD)
+        {
+            finish(120);
+        }
+        // The creator supplied only these two descriptors. No reservation,
+        // host service, namespace-administration or data FD crosses this barrier.
+        if parent_thread != 4 || libc::syscall(libc::SYS_close_range, 5_u32, u32::MAX, 0) != 0 {
+            finish(120);
+        }
+        libc::syscall(libc::SYS_close, 0);
+        libc::syscall(libc::SYS_close, 1);
+        libc::syscall(libc::SYS_close, 2);
+        if libc::syscall(libc::SYS_getpid) != 1 || libc::syscall(libc::SYS_getppid) != 0 {
+            finish(126);
+        }
+        // Its actual parent is the broker thread in the ancestor PID ns, so
+        // getppid() is legitimately 0. The inherited, actual thread pidfd closes
+        // the race after setting PDEATHSIG without inventing a numeric parent.
+        if libc::syscall(
+            libc::SYS_prctl,
+            libc::PR_SET_PDEATHSIG,
+            libc::SIGKILL,
+            0,
+            0,
+            0,
+        ) != 0
+        {
+            fail(nonce, 1);
+        }
+        check_parent_thread(parent_thread);
+        libc::syscall(libc::SYS_close, parent_thread);
+        if libc::syscall(libc::SYS_getuid) != 0
+            || libc::syscall(libc::SYS_geteuid) != 0
+            || libc::syscall(libc::SYS_getgid) != 0
+            || libc::syscall(libc::SYS_getegid) != 0
+            || libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<libc::gid_t>()) != 0
+            || libc::syscall(libc::SYS_prctl, libc::PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0) != 1
+        {
+            finish(126);
+        }
+        // Change only this new namespace's propagation, before any image mount.
+        if libc::syscall(
+            libc::SYS_mount,
+            std::ptr::null::<u8>(),
+            c"/".as_ptr(),
+            std::ptr::null::<u8>(),
+            libc::MS_REC | libc::MS_PRIVATE,
+            std::ptr::null::<u8>(),
+        ) != 0
+        {
+            fail(nonce, 1);
+        }
+        if libc::syscall(libc::SYS_sethostname, c"droidloom".as_ptr(), 9) != 0 {
+            fail(nonce, 1);
+        }
+        #[cfg(test)]
+        if matches!(_mode, Mode::TreeWrongReady) {
+            let mut wrong = nonce;
+            wrong[0] ^= 1;
+            send(wrong, Phase::TreeReady, 0, 1);
+            receive(nonce, parent_pid, Phase::Stop);
+            finish(0);
+        }
+        send(nonce, Phase::TreeReady, 0, 1);
+        // Only a fixed, admitted pair of base mount descriptors can enter the
+        // empty-data assembler. It has no runtime/dev/APEX or exec authority.
+        empty_root::run(nonce, parent_pid, _mode);
+    }
+}
+
+#[cfg(test)]
+pub(super) fn processfs_private_failure(value: i32) -> Option<(u32, u32, i32)> {
+    process_filesystems::decode_private_failure(value)
+}
+
+#[cfg(test)]
+pub(super) fn binder_private_failure(value: i32) -> Option<(u32, u32, i32)> {
+    private_binder::decode_private_failure(value)
+}
+
+#[cfg(test)]
+pub(super) fn writable_proc_private_failure(value: i32) -> Option<(u32, u32, i32)> {
+    writable_proc::decode_private_failure(value)
+}
+
+#[cfg(test)]
+pub(super) fn runtime_private_failure(value: i32) -> Option<(u32, u32, i32)> {
+    runtime::decode_private_failure(value)
+}
+
+#[cfg(test)]
+pub(super) fn postexec_private_failure(value: i32) -> Option<(u32, u32, i32)> {
+    private_postexec::decode_private_failure(value)
+}
diff --git a/runtime/droidloom-supervisor/src/production_namespace_device_child.rs b/runtime/droidloom-supervisor/src/production_namespace_device_child.rs
new file mode 100644
index 0000000..47bdc35
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/production_namespace_device_child.rs
@@ -0,0 +1,353 @@
+//! Fixed syscall-only consumer of one opaque private /dev mount.
+//!
+//! This is a distinct barrier after the immutable bases and empty data root.
+//! No device pathname on the host is opened and no Android exec is available.
+
+use super::empty_root::{KernelStatfs, entry_record};
+use super::{CHILD_FD, Mode, Packet, Phase, fail, finish, receive, send};
+use std::ffi::CStr;
+use std::os::fd::RawFd;
+
+const TMPFS_MAGIC: libc::c_long = 0x0102_1994;
+const ATTR_RDONLY: u64 = 1;
+const ATTR_NOSUID: u64 = 2;
+const ATTR_NODEV: u64 = 4;
+const ATTR_NOEXEC: u64 = 8;
+const MOVE_EMPTY: u32 = 0x04 | 0x40;
+
+#[derive(Clone, Copy)]
+struct DeviceSpec {
+    name: &'static CStr,
+    major: u32,
+    minor: u32,
+}
+const DEVICES: [DeviceSpec; 7] = [
+    DeviceSpec {
+        name: c"null",
+        major: 1,
+        minor: 3,
+    },
+    DeviceSpec {
+        name: c"zero",
+        major: 1,
+        minor: 5,
+    },
+    DeviceSpec {
+        name: c"full",
+        major: 1,
+        minor: 7,
+    },
+    DeviceSpec {
+        name: c"random",
+        major: 1,
+        minor: 8,
+    },
+    DeviceSpec {
+        name: c"urandom",
+        major: 1,
+        minor: 9,
+    },
+    DeviceSpec {
+        name: c"tty",
+        major: 5,
+        minor: 0,
+    },
+    DeviceSpec {
+        name: c"fuse",
+        major: 10,
+        minor: 229,
+    },
+];
+
+unsafe fn protocol_failure(nonce: [u8; 16]) -> ! {
+    unsafe {
+        *libc::__errno_location() = libc::EPROTO;
+        fail(nonce, 1)
+    }
+}
+
+/// An exact one-FD message from the same private, nonce-bound creator endpoint.
+/// Extra rights, other ancillary records, truncated messages and wrong phases
+/// cannot become a mount input. Failure exits this owned child, closing all FDs.
+unsafe fn receive_device(nonce: [u8; 16], parent_pid: u32) -> RawFd {
+    let mut packet = Packet::zeroed();
+    let mut iov = libc::iovec {
+        iov_base: (&mut packet as *mut Packet).cast(),
+        iov_len: std::mem::size_of::<Packet>(),
+    };
+    let mut ancillary = [0_usize; 16];
+    let mut msg: libc::msghdr = unsafe { std::mem::zeroed() };
+    msg.msg_iov = &mut iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = ancillary.as_mut_ptr().cast();
+    msg.msg_controllen = std::mem::size_of_val(&ancillary);
+    let n = unsafe {
+        libc::syscall(
+            libc::SYS_recvmsg,
+            CHILD_FD,
+            &mut msg,
+            libc::MSG_CMSG_CLOEXEC,
+        )
+    };
+    if n == 0 {
+        unsafe { finish(0) }
+    }
+    if n != std::mem::size_of::<Packet>() as libc::c_long
+        || msg.msg_flags & (libc::MSG_TRUNC | libc::MSG_CTRUNC) != 0
+        || !packet.matches(nonce, parent_pid)
+        || packet.errno != 0
+    {
+        unsafe { protocol_failure(nonce) }
+    }
+    let header = unsafe { libc::CMSG_FIRSTHDR(&msg) };
+    if packet.phase == Phase::Stop as u32 {
+        if !header.is_null() {
+            unsafe { protocol_failure(nonce) }
+        }
+        unsafe { finish(0) }
+    }
+    if packet.phase != Phase::MountPrivateDev as u32 || header.is_null() {
+        unsafe { protocol_failure(nonce) }
+    }
+    let h = unsafe { &*header };
+    if h.cmsg_level != libc::SOL_SOCKET
+        || h.cmsg_type != libc::SCM_RIGHTS
+        || h.cmsg_len != unsafe { libc::CMSG_LEN(4) } as usize
+        || !unsafe { libc::CMSG_NXTHDR(&msg, header) }.is_null()
+    {
+        unsafe { protocol_failure(nonce) }
+    }
+    let raw = unsafe { std::ptr::read_unaligned(libc::CMSG_DATA(header).cast::<i32>()) };
+    if raw < 0 || raw == CHILD_FD {
+        unsafe { protocol_failure(nonce) }
+    }
+    // Stdio is closed. Relocate a received 0/1/2 without touching the sole
+    // control descriptor, then close the original descriptor exactly once.
+    let fd = unsafe { libc::syscall(libc::SYS_fcntl, raw, libc::F_DUPFD_CLOEXEC, 4) };
+    if fd < 4 || fd > i32::MAX as libc::c_long {
+        unsafe { fail(nonce, 1) }
+    }
+    unsafe {
+        libc::syscall(libc::SYS_close, raw);
+    }
+    fd as RawFd
+}
+
+unsafe fn opened_directory(parent: RawFd, name: &CStr, nonce: [u8; 16]) -> RawFd {
+    let fd = unsafe {
+        libc::syscall(
+            libc::SYS_openat,
+            parent,
+            name.as_ptr(),
+            libc::O_RDONLY
+                | libc::O_DIRECTORY
+                | libc::O_NOFOLLOW
+                | libc::O_CLOEXEC
+                | libc::O_NONBLOCK,
+            0,
+        )
+    };
+    if fd < 0 || fd > i32::MAX as libc::c_long {
+        unsafe { fail(nonce, 1) }
+    }
+    fd as RawFd
+}
+
+unsafe fn require_private_devices(fd: RawFd, nonce: [u8; 16]) {
+    let mut fs: KernelStatfs = unsafe { std::mem::zeroed() };
+    let mut meta: libc::stat = unsafe { std::mem::zeroed() };
+    if unsafe { libc::syscall(libc::SYS_fstatfs, fd, &mut fs) } != 0
+        || unsafe { libc::syscall(libc::SYS_fstat, fd, &mut meta) } != 0
+    {
+        unsafe { fail(nonce, 1) }
+    }
+    let flags = fs.f_flags as u64;
+    if fs.f_type != TMPFS_MAGIC
+        || flags & (ATTR_NOSUID | ATTR_NOEXEC) != ATTR_NOSUID | ATTR_NOEXEC
+        || flags & (ATTR_RDONLY | ATTR_NODEV) != 0
+        || fs.f_blocks < 0
+        || fs.f_frsize <= 0
+        || (fs.f_blocks as u64).checked_mul(fs.f_frsize as u64) != Some(64 * 1024 * 1024)
+        || fs.f_files != 16_384
+        || meta.st_mode != (libc::S_IFDIR | 0o755)
+        || meta.st_uid != 0
+        || meta.st_gid != 0
+    {
+        unsafe { protocol_failure(nonce) }
+    }
+    let entries = unsafe { opened_directory(fd, c".", nonce) };
+    let mut seen = 0_u8;
+    let mut buffer = [0_u8; 4096];
+    loop {
+        let n = unsafe {
+            libc::syscall(
+                libc::SYS_getdents64,
+                entries,
+                buffer.as_mut_ptr(),
+                buffer.len(),
+            )
+        };
+        if n < 0 {
+            unsafe { fail(nonce, 1) }
+        }
+        if n == 0 {
+            break;
+        }
+        if n as usize > buffer.len() {
+            unsafe { protocol_failure(nonce) }
+        }
+        let mut at = 0_usize;
+        while at < n as usize {
+            let (length, name) = match entry_record(&buffer[at..n as usize]) {
+                Some(value) => value,
+                None => unsafe { protocol_failure(nonce) },
+            };
+            at += length;
+            if name == b"." || name == b".." {
+                continue;
+            }
+            let index = match DEVICES.iter().position(|s| s.name.to_bytes() == name) {
+                Some(value) => value,
+                None => unsafe { protocol_failure(nonce) },
+            };
+            let bit = 1_u8 << index;
+            if seen & bit != 0 {
+                unsafe { protocol_failure(nonce) }
+            }
+            seen |= bit;
+            let spec = DEVICES[index];
+            // O_PATH checks the inode without opening a device driver.
+            let node = unsafe {
+                libc::syscall(
+                    libc::SYS_openat,
+                    fd,
+                    spec.name.as_ptr(),
+                    libc::O_PATH | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+                    0,
+                )
+            };
+            if node < 0 || node > i32::MAX as libc::c_long {
+                unsafe { fail(nonce, 1) }
+            }
+            let mut got: libc::stat = unsafe { std::mem::zeroed() };
+            if unsafe { libc::syscall(libc::SYS_fstat, node, &mut got) } != 0 {
+                unsafe { fail(nonce, 1) }
+            }
+            if got.st_dev != meta.st_dev
+                || got.st_mode != (libc::S_IFCHR | 0o666)
+                || got.st_uid != 0
+                || got.st_gid != 0
+                || got.st_nlink != 1
+                || got.st_rdev != libc::makedev(spec.major, spec.minor)
+            {
+                unsafe { protocol_failure(nonce) }
+            }
+            unsafe {
+                libc::syscall(libc::SYS_close, node);
+            }
+        }
+    }
+    unsafe {
+        libc::syscall(libc::SYS_close, entries);
+    }
+    if seen != 0x7f {
+        unsafe { protocol_failure(nonce) }
+    }
+}
+
+/// Runs only after EmptyRootReady. The existing root belongs exclusively to
+/// this PID 1; creating its /dev placeholder cannot mutate an inherited host
+/// mount. Neither the bases nor protected original account images are written.
+pub(super) unsafe fn run(nonce: [u8; 16], parent_pid: u32, _mode: Mode) -> ! {
+    unsafe {
+        let devices = receive_device(nonce, parent_pid);
+        require_private_devices(devices, nonce);
+        let root = opened_directory(libc::AT_FDCWD, c"/", nonce);
+        let mut fs: KernelStatfs = std::mem::zeroed();
+        if libc::syscall(libc::SYS_fstatfs, root, &mut fs) != 0 || fs.f_type != TMPFS_MAGIC {
+            protocol_failure(nonce);
+        }
+        if libc::syscall(libc::SYS_mkdirat, root, c"dev".as_ptr(), 0o755_u32) != 0
+            && *libc::__errno_location() != libc::EEXIST
+        {
+            fail(nonce, 1);
+        }
+        // A symlink or non-directory placeholder is rejected even inside this
+        // private root. Do not follow a base-provided link to another mount.
+        let target = opened_directory(root, c"dev", nonce);
+        if libc::syscall(
+            libc::SYS_move_mount,
+            devices,
+            c"".as_ptr(),
+            target,
+            c"".as_ptr(),
+            MOVE_EMPTY,
+        ) != 0
+        {
+            fail(nonce, 1);
+        }
+        libc::syscall(libc::SYS_close, target);
+        let attached = opened_directory(root, c"dev", nonce);
+        require_private_devices(attached, nonce);
+        // No source mount, root-directory or device descriptor escapes this
+        // barrier; the sole descriptor is the original private control socket.
+        if libc::syscall(libc::SYS_close_range, 4_u32, u32::MAX, 0) != 0 {
+            fail(nonce, 1);
+        }
+        libc::syscall(libc::SYS_close, 0);
+        libc::syscall(libc::SYS_close, 1);
+        libc::syscall(libc::SYS_close, 2);
+        send(nonce, Phase::PrivateDevReady, 0, 1);
+        #[cfg(test)]
+        if matches!(
+            _mode,
+            Mode::DeviceRootControl | Mode::ProcessFilesystemsControl | Mode::BinderControl
+        ) {
+            receive(nonce, parent_pid, Phase::ProbePrivateDev);
+            harmless_device_control(nonce);
+            send(nonce, Phase::PrivateDevChecked, 0, 1);
+        }
+        #[cfg(test)]
+        if matches!(_mode, Mode::DeviceRootControl) {
+            receive(nonce, parent_pid, Phase::Stop);
+            finish(0);
+        }
+        super::process_filesystems::run(nonce, parent_pid, _mode);
+    }
+}
+
+#[cfg(test)]
+unsafe fn harmless_device_control(nonce: [u8; 16]) {
+    for (path, write) in [(c"/dev/null", true), (c"/dev/zero", false)] {
+        let fd = unsafe {
+            libc::syscall(
+                libc::SYS_openat,
+                libc::AT_FDCWD,
+                path.as_ptr(),
+                (if write {
+                    libc::O_WRONLY
+                } else {
+                    libc::O_RDONLY
+                }) | libc::O_CLOEXEC
+                    | libc::O_NOFOLLOW
+                    | libc::O_NONBLOCK,
+                0,
+            )
+        };
+        if fd < 0 || fd > i32::MAX as libc::c_long {
+            unsafe { fail(nonce, 1) }
+        }
+        let mut bytes = [0x5a_u8; 16];
+        let n = if write {
+            unsafe { libc::syscall(libc::SYS_write, fd, bytes.as_ptr(), bytes.len()) }
+        } else {
+            unsafe { libc::syscall(libc::SYS_read, fd, bytes.as_mut_ptr(), bytes.len()) }
+        };
+        if n != bytes.len() as libc::c_long || (!write && bytes != [0; 16]) {
+            unsafe { protocol_failure(nonce) }
+        }
+        unsafe {
+            libc::syscall(libc::SYS_close, fd);
+        }
+    }
+}
diff --git a/runtime/droidloom-supervisor/src/production_namespace_exec_child.rs b/runtime/droidloom-supervisor/src/production_namespace_exec_child.rs
new file mode 100644
index 0000000..971faa0
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/production_namespace_exec_child.rs
@@ -0,0 +1,184 @@
+//! Final raw execution boundary shared by the fixed private probe and the
+//! future Android entry. A private zero-capability profile does not select an
+//! Android capability contract. The latter remains explicitly unqualified.
+use std::os::fd::RawFd;
+
+#[derive(Clone, Copy)]
+pub(super) enum FinalCapabilityProfile {
+    AndroidUnqualified,
+    #[cfg(test)]
+    PrivateZero,
+}
+
+// Linux capability ABI v3 consists of two 32-bit records, including the
+// inheritable set. No caller-supplied bitset or serialized profile is accepted.
+#[repr(C)]
+struct CapHeader {
+    version: u32,
+    pid: i32,
+}
+#[repr(C)]
+#[derive(Clone, Copy, Default, Eq, PartialEq)]
+struct CapData {
+    effective: u32,
+    permitted: u32,
+    inheritable: u32,
+}
+const _: () = assert!(std::mem::size_of::<CapHeader>() == 8);
+const _: () = assert!(std::mem::size_of::<CapData>() == 12);
+const CAP_VERSION_3: u32 = 0x2008_0522;
+const CAP_LAST: u32 = 40;
+const PR_CAP_AMBIENT: i32 = 47;
+const AMBIENT_IS_SET: i32 = 1;
+const AMBIENT_CLEAR_ALL: i32 = 4;
+// NOROOT + locked; NO_SETUID_FIXUP + locked; KEEP_CAPS off + locked;
+// NO_CAP_AMBIENT_RAISE + locked. KEEP_CAPS itself is deliberately absent.
+const ZERO_SECUREBITS: u32 = 1 | 2 | 4 | 8 | 32 | 64 | 128;
+
+fn selected_zero(profile: FinalCapabilityProfile) -> bool {
+    match profile {
+        FinalCapabilityProfile::AndroidUnqualified => false,
+        #[cfg(test)]
+        FinalCapabilityProfile::PrivateZero => true,
+    }
+}
+
+unsafe fn errno() -> i32 {
+    unsafe { *libc::__errno_location() }
+}
+
+/// Raw child only, before exec. This function never changes UID/GID, raises
+/// dumpability, adopts a PID, or acquires an executable by pathname. Returns
+/// zero only after the actual kernel has read back the entire zero profile.
+pub(super) unsafe fn prepare(profile: FinalCapabilityProfile) -> i32 {
+    if !selected_zero(profile) {
+        return libc::EOPNOTSUPP;
+    }
+    unsafe {
+        if libc::syscall(libc::SYS_getpid) != 1
+            || libc::syscall(libc::SYS_getppid) != 0
+            || libc::syscall(libc::SYS_getuid) != 0
+            || libc::syscall(libc::SYS_geteuid) != 0
+            || libc::syscall(libc::SYS_getgid) != 0
+            || libc::syscall(libc::SYS_getegid) != 0
+            || libc::syscall(libc::SYS_getgroups, 0, std::ptr::null::<u32>()) != 0
+            || libc::syscall(libc::SYS_prctl, libc::PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0) != 1
+        {
+            return libc::EPERM;
+        }
+        let mut death = 0_i32;
+        if libc::syscall(libc::SYS_prctl, libc::PR_GET_PDEATHSIG, &mut death, 0, 0, 0) != 0 {
+            return errno();
+        }
+        if death != libc::SIGKILL {
+            return libc::EPROTO;
+        }
+        // A different capability ABI must receive a separate reviewed profile.
+        // Do not silently omit a newly introduced bounding capability.
+        if libc::syscall(
+            libc::SYS_prctl,
+            libc::PR_CAPBSET_READ,
+            CAP_LAST + 1,
+            0,
+            0,
+            0,
+        ) != -1
+            || errno() != libc::EINVAL
+        {
+            return libc::EOPNOTSUPP;
+        }
+        for cap in 0..=CAP_LAST {
+            let value = libc::syscall(libc::SYS_prctl, libc::PR_CAPBSET_READ, cap, 0, 0, 0);
+            if value != 0 && value != 1 {
+                return if value == -1 { errno() } else { libc::EPROTO };
+            }
+        }
+        if libc::syscall(libc::SYS_prctl, PR_CAP_AMBIENT, AMBIENT_CLEAR_ALL, 0, 0, 0) != 0 {
+            return errno();
+        }
+        if libc::syscall(
+            libc::SYS_prctl,
+            libc::PR_SET_SECUREBITS,
+            ZERO_SECUREBITS,
+            0,
+            0,
+            0,
+        ) != 0
+        {
+            return errno();
+        }
+        for cap in 0..=CAP_LAST {
+            if libc::syscall(libc::SYS_prctl, libc::PR_CAPBSET_DROP, cap, 0, 0, 0) != 0 {
+                return errno();
+            }
+        }
+        let header = CapHeader {
+            version: CAP_VERSION_3,
+            pid: 0,
+        };
+        let zero = [CapData::default(); 2];
+        if libc::syscall(libc::SYS_capset, &header, zero.as_ptr()) != 0 {
+            return errno();
+        }
+        let mut observed = [CapData::default(); 2];
+        if libc::syscall(libc::SYS_capget, &header, observed.as_mut_ptr()) != 0 {
+            return errno();
+        }
+        if observed != zero
+            || libc::syscall(libc::SYS_prctl, libc::PR_GET_SECUREBITS, 0, 0, 0, 0)
+                != ZERO_SECUREBITS as libc::c_long
+            || libc::syscall(libc::SYS_prctl, libc::PR_GET_NO_NEW_PRIVS, 0, 0, 0, 0) != 1
+        {
+            return libc::EPROTO;
+        }
+        for cap in 0..=CAP_LAST {
+            if libc::syscall(libc::SYS_prctl, libc::PR_CAPBSET_READ, cap, 0, 0, 0) != 0
+                || libc::syscall(libc::SYS_prctl, PR_CAP_AMBIENT, AMBIENT_IS_SET, cap, 0, 0) != 0
+            {
+                return libc::EPROTO;
+            }
+        }
+        // Credential transitions must not silently discard the original
+        // actually-parented death signal. We do not re-arm it without the
+        // original parent-thread PIDFD race proof; a mismatch fails closed.
+        death = 0;
+        if libc::syscall(libc::SYS_prctl, libc::PR_GET_PDEATHSIG, &mut death, 0, 0, 0) != 0 {
+            return errno();
+        }
+        if death != libc::SIGKILL {
+            return libc::EPROTO;
+        }
+        0
+    }
+}
+
+/// Both callers hold the same previously authenticated executable descriptor.
+/// The fixed call sites supply their compile-time argv/env layout; no packet
+/// carries a pathname, command string, environment, or exec flags.
+pub(super) unsafe fn exec_held(
+    fd: RawFd,
+    argv: *const *const libc::c_char,
+    env: *const *const libc::c_char,
+) -> i32 {
+    unsafe {
+        libc::syscall(libc::SYS_execveat, fd, c"".as_ptr(), argv, env, 0x1000_u32);
+        errno()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn production_final_exec_does_not_infer_android_capabilities_from_private_profile() {
+        assert!(!selected_zero(FinalCapabilityProfile::AndroidUnqualified));
+        assert!(selected_zero(FinalCapabilityProfile::PrivateZero));
+        // Rejection occurs before any syscall or mutation for this profile.
+        assert_eq!(
+            unsafe { prepare(FinalCapabilityProfile::AndroidUnqualified) },
+            libc::EOPNOTSUPP
+        );
+        assert_eq!(ZERO_SECUREBITS, 0xef);
+        assert_eq!(ZERO_SECUREBITS & 16, 0);
+    }
+}
diff --git a/runtime/droidloom-supervisor/src/production_namespace_execution_parent.rs b/runtime/droidloom-supervisor/src/production_namespace_execution_parent.rs
new file mode 100644
index 0000000..23e3218
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/production_namespace_execution_parent.rs
@@ -0,0 +1,344 @@
+//! Parent-side Android exec and readiness observation. Preparation does not
+//! construct this type: the same owned child must pass the final admission,
+//! authenticated ExecArmed, control CLOEXEC and actual executable checks.
+use super::*;
+use crate::production_execution::ExecutionAdmission;
+use crate::production_readiness::{BootProperty, ReadinessError, read_boot_complete};
+use crate::production_selection::ProductionSelection;
+use std::ffi::CStr;
+
+const BOOT_PROPERTY: &CStr = c"u:object_r:boot_status_prop:s0";
+const TMPFS_MAGIC: libc::c_long = 0x0102_1994;
+
+pub(crate) struct ExecutedNamespaces {
+    tree: IsolatedNamespaces,
+}
+
+/// A borrow of one actually executed, live and ready tree. No caller can
+/// construct it from a PID, a property value, a digest or a test declaration.
+pub(crate) struct ReadyTreeWitness<'a> {
+    owner: &'a ExecutedNamespaces,
+}
+
+impl ReadyTreeWitness<'_> {
+    pub(crate) fn host_uid(&self) -> Result<u32> {
+        Ok(self.owner.tree.witness()?.identity_lease()?.host_uid())
+    }
+}
+
+fn fixed_at(parent: &File, name: &CStr, directory: bool, body: bool) -> Result<File> {
+    let flags = libc::O_CLOEXEC
+        | libc::O_NOFOLLOW
+        | libc::O_NONBLOCK
+        | if body { libc::O_RDONLY } else { libc::O_PATH }
+        | if directory { libc::O_DIRECTORY } else { 0 };
+    let fd = unsafe { libc::openat(parent.as_raw_fd(), name.as_ptr(), flags) };
+    if fd < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    let file = unsafe { File::from_raw_fd(fd) };
+    if file.metadata()?.mode() & libc::S_IFMT == libc::S_IFLNK {
+        return Err(NamespaceError::Rejected(
+            "production property path is a symlink",
+        ));
+    }
+    Ok(file)
+}
+
+fn executable(child: &TreeChild) -> Result<File> {
+    child.verify()?;
+    // The sole intentional proc magic-link follow. It is relative to the
+    // original held proc directory, then compared to the already held init
+    // inode. O_NOFOLLOW here would incorrectly inspect the proc symlink itself.
+    let fd = unsafe {
+        libc::openat(
+            child.proc_dir.as_raw_fd(),
+            c"exe".as_ptr(),
+            libc::O_PATH | libc::O_CLOEXEC | libc::O_NONBLOCK,
+        )
+    };
+    if fd < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    let file = unsafe { File::from_raw_fd(fd) };
+    child.verify()?;
+    Ok(file)
+}
+
+fn exec_failed_record(child: &TreeChild) -> Result<()> {
+    let (packet, peer) = receive_packet(child.control.as_raw_fd())?;
+    if !packet.matches(child.nonce, 1)
+        || peer.pid != child.identity.pid as i32
+        || peer.uid != child.uids.start
+        || peer.gid != child.gids.start
+    {
+        return Err(NamespaceError::Rejected(
+            "exec failure original nonce/SCM peer differs",
+        ));
+    }
+    if packet.phase == Phase::Failed as u32 && packet.errno > 0 {
+        return Err(io::Error::from_raw_os_error(packet.errno).into());
+    }
+    Err(NamespaceError::Rejected(
+        "unexpected record after ExecArmed",
+    ))
+}
+
+fn wait_exec_cloexec(child: &TreeChild) -> Result<()> {
+    let deadline = Instant::now() + PROTOCOL_TIMEOUT;
+    loop {
+        if pidfd_exited(&child.pidfd)? {
+            // A real EOF caused by process death is not evidence of exec.
+            return Err(NamespaceError::Rejected(
+                "owned init exited before exec observation",
+            ));
+        }
+        let remaining = deadline.saturating_duration_since(Instant::now());
+        if remaining.is_zero() {
+            return Err(NamespaceError::Rejected("owned exec CLOEXEC deadline"));
+        }
+        let mut fds = [
+            libc::pollfd {
+                fd: child.control.as_raw_fd(),
+                events: libc::POLLIN,
+                revents: 0,
+            },
+            libc::pollfd {
+                fd: child.pidfd.as_raw_fd(),
+                events: libc::POLLIN,
+                revents: 0,
+            },
+        ];
+        let ms = remaining.as_millis().max(1).min(i32::MAX as u128) as i32;
+        let rc = unsafe { libc::poll(fds.as_mut_ptr(), fds.len() as libc::nfds_t, ms) };
+        if rc < 0 {
+            let error = io::Error::last_os_error();
+            if error.kind() == io::ErrorKind::Interrupted {
+                continue;
+            }
+            return Err(error.into());
+        }
+        if rc == 0 {
+            continue;
+        }
+        if fds.iter().any(|fd| fd.revents & libc::POLLNVAL != 0) {
+            return Err(NamespaceError::Rejected(
+                "owned exec descriptor became invalid",
+            ));
+        }
+        if fds[0].revents & (libc::POLLIN | libc::POLLHUP | libc::POLLERR) != 0 {
+            let mut byte = [0_u8; 1];
+            let n = unsafe {
+                libc::recv(
+                    child.control.as_raw_fd(),
+                    byte.as_mut_ptr().cast(),
+                    1,
+                    libc::MSG_PEEK | libc::MSG_DONTWAIT,
+                )
+            };
+            if n == 0 {
+                child.verify()?;
+                return Ok(());
+            }
+            if n > 0 {
+                return exec_failed_record(child);
+            }
+            let error = io::Error::last_os_error();
+            if matches!(error.raw_os_error(), Some(libc::EINTR | libc::EAGAIN)) {
+                continue;
+            }
+            return Err(error.into());
+        }
+    }
+}
+
+impl IsolatedNamespaces {
+    pub(crate) fn execute_runtime(
+        mut self,
+        selection: &ProductionSelection,
+        admission: &ExecutionAdmission,
+    ) -> Result<ExecutedNamespaces> {
+        admission
+            .revalidate_tree(selection, &self.witness()?)
+            .map_err(|error| NamespaceError::RuntimeResource(error.to_string()))?;
+        self.verify_live_admission()?;
+        let child = self
+            .init
+            .as_ref()
+            .ok_or(NamespaceError::RetirementUnproven)?;
+        self.runtime_observation
+            .as_mut()
+            .ok_or(NamespaceError::Rejected("no prepared same-cohort runtime"))?
+            .verify(child)?;
+        send_packet(
+            child.control.as_raw_fd(),
+            &Packet::new(child.nonce, Phase::ExecInit, 0, child.parent_pid),
+        )?;
+        child.receive_phase(Phase::ExecArmed)?;
+        wait_exec_cloexec(child)?;
+        let target = executable(child)?;
+        self.runtime_observation
+            .as_ref()
+            .unwrap()
+            .verify_executable_target(&target)?;
+        drop(target);
+        admission
+            .revalidate_tree(selection, &self.witness()?)
+            .map_err(|error| NamespaceError::RuntimeResource(error.to_string()))?;
+        // No additional mount/root/namespace FD is held outside the tree's
+        // existing retirement machinery. The observation above is transient.
+        Ok(ExecutedNamespaces { tree: self })
+    }
+}
+
+impl ExecutedNamespaces {
+    pub(crate) fn host_pid(&self) -> u32 {
+        // Display only. This value is never fed back to a constructor, signal,
+        // map write, namespace entry or Android command implementation.
+        self.tree
+            .init
+            .as_ref()
+            .expect("executed owner holds init")
+            .identity
+            .pid
+    }
+
+    pub(crate) fn termination_observed(&self) -> Result<bool> {
+        let keeper = self
+            .tree
+            .keeper
+            .as_ref()
+            .ok_or(NamespaceError::RetirementUnproven)?;
+        let resources = keeper.owner.held()?;
+        if unsafe { libc::syscall(libc::SYS_gettid) } != libc::c_long::from(resources.creator_tid) {
+            return Err(NamespaceError::Rejected("executed owner moved threads"));
+        }
+        let init = self
+            .tree
+            .init
+            .as_ref()
+            .ok_or(NamespaceError::RetirementUnproven)?;
+        Ok(pidfd_exited(&init.pidfd)? || pidfd_exited(&resources.pidfd)?)
+    }
+
+    fn verify_exec(
+        &mut self,
+        selection: &ProductionSelection,
+        admission: &ExecutionAdmission,
+    ) -> Result<()> {
+        admission
+            .revalidate_tree(selection, &self.tree.witness()?)
+            .map_err(|error| NamespaceError::RuntimeResource(error.to_string()))?;
+        let child = self
+            .tree
+            .init
+            .as_ref()
+            .ok_or(NamespaceError::RetirementUnproven)?;
+        child.verify()?;
+        let target = executable(child)?;
+        let runtime = self
+            .tree
+            .runtime_observation
+            .as_mut()
+            .ok_or(NamespaceError::Rejected("executed runtime custody absent"))?;
+        runtime.verify_executable_target(&target)?;
+        drop(target);
+        // An unexpected namespace or mount transition is rejected. Stock
+        // init's required transitions need their own reviewed typed adapter;
+        // this observer does not adopt a new numeric PID or namespace FD.
+        runtime.verify(child)
+    }
+
+    pub(crate) fn readiness(
+        &mut self,
+        selection: &ProductionSelection,
+        admission: &ExecutionAdmission,
+    ) -> Result<BootProperty> {
+        self.verify_exec(selection, admission)?;
+        let child = self
+            .tree
+            .init
+            .as_ref()
+            .ok_or(NamespaceError::RetirementUnproven)?;
+        let value = (|| -> Result<BootProperty> {
+            let root = held_child_root(child)?;
+            let dev = fixed_at(&root, c"dev", true, false)?;
+            if Some(Node::of(&dev)?) != self.tree.device_node
+                || filesystem_kind(&dev)? != TMPFS_MAGIC
+            {
+                return Err(NamespaceError::Rejected(
+                    "property DEV differs from owned private mount",
+                ));
+            }
+            let property_dir = fixed_at(&dev, c"__properties__", true, false)?;
+            let metadata = property_dir.metadata()?;
+            if metadata.uid() != child.uids.start
+                || metadata.gid() != child.gids.start
+                || metadata.mode() & 0o6022 != 0
+                || filesystem_kind(&property_dir)? != TMPFS_MAGIC
+            {
+                return Err(NamespaceError::Rejected(
+                    "private property directory custody",
+                ));
+            }
+            let file = fixed_at(&property_dir, BOOT_PROPERTY, false, true)?;
+            if filesystem_kind(&file)? != TMPFS_MAGIC {
+                return Err(NamespaceError::Rejected("property area filesystem differs"));
+            }
+            match read_boot_complete(&file, child.uids.start, child.gids.start) {
+                Ok(value) => Ok(value),
+                Err(ReadinessError::Changed) => Ok(BootProperty::Updating),
+                Err(error) => Err(NamespaceError::RuntimeResource(error.to_string())),
+            }
+        })();
+        let value = match value {
+            Err(NamespaceError::Io(error)) if error.kind() == io::ErrorKind::NotFound => {
+                BootProperty::Absent
+            }
+            other => other?,
+        };
+        self.verify_exec(selection, admission)?;
+        Ok(value)
+    }
+
+    pub(crate) fn ready_witness<'a>(
+        &'a mut self,
+        selection: &ProductionSelection,
+        admission: &ExecutionAdmission,
+    ) -> Result<Option<ReadyTreeWitness<'a>>> {
+        if self.readiness(selection, admission)? == BootProperty::Complete {
+            Ok(Some(ReadyTreeWitness { owner: self }))
+        } else {
+            Ok(None)
+        }
+    }
+
+    pub(crate) fn retire(self) -> Result<TreeExit> {
+        self.tree.retire()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn production_exec_property_walk_rejects_actual_directory_and_leaf_symlinks() {
+        let temp = tempfile::tempdir().unwrap();
+        std::fs::create_dir(temp.path().join("real")).unwrap();
+        std::fs::write(temp.path().join("real/value"), b"property").unwrap();
+        std::os::unix::fs::symlink("real", temp.path().join("alias")).unwrap();
+        std::os::unix::fs::symlink("value", temp.path().join("real/alias")).unwrap();
+        let root = File::open(temp.path()).unwrap();
+        assert!(fixed_at(&root, c"alias", true, false).is_err());
+        let real = fixed_at(&root, c"real", true, false).unwrap();
+        assert!(fixed_at(&real, c"alias", false, true).is_err());
+        assert_eq!(
+            fixed_at(&real, c"value", false, true)
+                .unwrap()
+                .metadata()
+                .unwrap()
+                .len(),
+            8
+        );
+    }
+}
diff --git a/runtime/droidloom-supervisor/src/production_namespace_mount_child.rs b/runtime/droidloom-supervisor/src/production_namespace_mount_child.rs
new file mode 100644
index 0000000..408b5f3
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/production_namespace_mount_child.rs
@@ -0,0 +1,728 @@
+//! Fixed, syscall-only consumer of the two admitted base mount descriptors.
+//!
+//! This is not an Android exec path. It builds an isolated empty-data root,
+//! pivots away from every inherited host mount and parks at a second barrier.
+//! Runtime, device and APEX authority are separate prerequisites.
+
+use super::{CHILD_FD, Mode, Packet, Phase, fail, finish, receive, send};
+use std::os::fd::RawFd;
+
+const OPEN_TREE_CLONE: u32 = 1;
+const MOVE_EMPTY: u32 = 0x04 | 0x40;
+const AT_EMPTY_PATH: u32 = 0x1000;
+const ATTR_RDONLY: u64 = 1;
+const ATTR_NOSUID: u64 = 2;
+const ATTR_NODEV: u64 = 4;
+const TMPFS_MAGIC: libc::c_long = 0x0102_1994;
+const EXT4_MAGIC: libc::c_long = 0xef53;
+const EROFS_MAGIC: libc::c_long = 0xe0f5_e1e2_u32 as libc::c_long;
+const MAX_ROOT_ENTRIES: usize = 128;
+const MAX_NAME: usize = 255;
+const MAX_LINK: usize = 4096;
+
+// Linux LP64 SYS_fstatfs UAPI, from asm-generic/statfs.h. The Rust libc
+// type intentionally does not expose f_flags on every GNU target. Keep the
+// raw syscall output complete instead of omitting the mount-flag checks.
+#[repr(C)]
+pub(super) struct KernelStatfs {
+    pub(super) f_type: libc::c_long,
+    pub(super) f_bsize: libc::c_long,
+    pub(super) f_blocks: libc::c_long,
+    pub(super) f_bfree: libc::c_long,
+    pub(super) f_bavail: libc::c_long,
+    pub(super) f_files: libc::c_long,
+    pub(super) f_ffree: libc::c_long,
+    pub(super) f_fsid: [i32; 2],
+    pub(super) f_namelen: libc::c_long,
+    pub(super) f_frsize: libc::c_long,
+    pub(super) f_flags: libc::c_long,
+    pub(super) f_spare: [libc::c_long; 4],
+}
+const _: () = {
+    assert!(std::mem::size_of::<libc::c_long>() == 8);
+    assert!(std::mem::size_of::<KernelStatfs>() == 120);
+    assert!(std::mem::align_of::<KernelStatfs>() == 8);
+    assert!(std::mem::offset_of!(KernelStatfs, f_fsid) == 56);
+    assert!(std::mem::offset_of!(KernelStatfs, f_flags) == 80);
+    assert!(std::mem::offset_of!(KernelStatfs, f_spare) == 88);
+    assert!(std::mem::size_of::<KernelStatfs>() == std::mem::size_of::<libc::statfs>());
+    assert!(std::mem::align_of::<KernelStatfs>() == std::mem::align_of::<libc::statfs>());
+};
