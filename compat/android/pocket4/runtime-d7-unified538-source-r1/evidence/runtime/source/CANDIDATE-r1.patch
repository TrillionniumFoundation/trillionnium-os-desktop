+            .unwrap();
+            assert_eq!(
+                record(
+                    r.as_raw_fd(),
+                    n,
+                    pid,
+                    uid,
+                    gid,
+                    Phase::PostExecChecked,
+                    || Ok(())
+                )
+                .unwrap(),
+                errno
+            );
+        }
+    }
