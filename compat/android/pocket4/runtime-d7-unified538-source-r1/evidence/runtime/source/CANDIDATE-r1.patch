+    fn empty_dropins(&self, path: &CStr) -> Result<Vec<String>> {
+        let mut raw: *mut *mut libc::c_char = std::ptr::null_mut();
+        bus_rc(unsafe {
+            (self.get_strv)(
+                self.bus,
+                c"org.freedesktop.systemd1".as_ptr(),
+                path.as_ptr(),
+                c"org.freedesktop.systemd1.Unit".as_ptr(),
+                c"DropInPaths".as_ptr(),
+                std::ptr::null_mut(),
