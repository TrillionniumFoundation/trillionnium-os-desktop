+            (self.get_string)(
+                self.bus,
+                c"org.freedesktop.systemd1".as_ptr(),
+                path.as_ptr(),
+                interface.as_ptr(),
+                property.as_ptr(),
+                std::ptr::null_mut(),
+                &mut raw,
+            )
+        };
