new file mode 100644
index 0000000..08a9b35
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/production_namespace_postexec_child.rs
@@ -0,0 +1,275 @@
+//! Test-only fixed executable handoff. The production runtime uses the same
+//! final-capability and execveat functions, with an unqualified profile gate.
+use super::empty_root::KernelStatfs;
+use super::{CHILD_FD, Packet, Phase, finish, send};
+use std::os::fd::RawFd;
+
+pub(super) fn decode_private_failure(value: i32) -> Option<(u32, u32, i32)> {
+    let v = value as u32;
+    let stage = (v >> 24) & 15;
+    let line = (v >> 12) & 4095;
+    let errno = (v & 4095) as i32;
+    (v >> 28 == 5 && (1..=8).contains(&stage) && line != 0 && errno != 0)
+        .then_some((stage, line, errno))
+}
+unsafe fn failed(nonce: [u8; 16], line: u32) -> ! {
+    unsafe {
+        let e = *libc::__errno_location();
+        let e = if (1..4096).contains(&e) {
+            e as u32
+        } else {
+            libc::EIO as u32
+        };
+        send(
+            nonce,
+            Phase::Failed,
+            (0x5800_0000 | line << 12 | e) as i32,
+            1,
+        );
+        finish(127)
+    }
+}
+unsafe fn rejected(nonce: [u8; 16]) -> ! {
+    unsafe {
+        *libc::__errno_location() = libc::EPROTO;
+        failed(nonce, line!())
+    }
+}
+unsafe fn metadata(fd: RawFd, nonce: [u8; 16]) -> libc::stat {
+    let mut out = unsafe { std::mem::zeroed() };
+    if unsafe { libc::syscall(libc::SYS_fstat, fd, &mut out) } != 0 {
+        unsafe { failed(nonce, line!()) }
+    }
+    out
+}
+fn same(a: &libc::stat, b: &libc::stat) -> bool {
+    (
+        a.st_dev,
+        a.st_ino,
+        a.st_mode,
+        a.st_uid,
+        a.st_gid,
+        a.st_nlink,
+        a.st_size,
+        a.st_mtime,
+        a.st_mtime_nsec,
+        a.st_ctime,
+        a.st_ctime_nsec,
+    ) == (
+        b.st_dev,
+        b.st_ino,
+        b.st_mode,
+        b.st_uid,
+        b.st_gid,
+        b.st_nlink,
+        b.st_size,
+        b.st_mtime,
+        b.st_mtime_nsec,
+        b.st_ctime,
+        b.st_ctime_nsec,
+    )
+}
+unsafe fn received(nonce: [u8; 16], parent_pid: u32) -> RawFd {
+    let mut packet = Packet::zeroed();
+    let mut v = libc::iovec {
+        iov_base: (&mut packet as *mut Packet).cast(),
+        iov_len: std::mem::size_of::<Packet>(),
+    };
+    let mut ancillary = [0_usize; 16];
+    let mut m: libc::msghdr = unsafe { std::mem::zeroed() };
+    m.msg_iov = &mut v;
+    m.msg_iovlen = 1;
+    m.msg_control = ancillary.as_mut_ptr().cast();
+    m.msg_controllen = std::mem::size_of_val(&ancillary);
+    let n = unsafe { libc::syscall(libc::SYS_recvmsg, CHILD_FD, &mut m, libc::MSG_CMSG_CLOEXEC) };
+    if n == 0 {
+        unsafe { finish(0) }
+    }
+    if n != std::mem::size_of::<Packet>() as libc::c_long
+        || m.msg_flags & (libc::MSG_TRUNC | libc::MSG_CTRUNC) != 0
+        || !packet.matches(nonce, parent_pid)
+        || packet.errno != 0
+    {
+        unsafe { rejected(nonce) }
+    }
+    let h = unsafe { libc::CMSG_FIRSTHDR(&m) };
+    if packet.phase == Phase::Stop as u32 && h.is_null() {
+        unsafe { finish(0) }
+    }
+    if packet.phase != Phase::PreparePostExecProbe as u32 || h.is_null() {
+        unsafe { rejected(nonce) }
+    }
+    if unsafe { (*h).cmsg_level } != libc::SOL_SOCKET
+        || unsafe { (*h).cmsg_type } != libc::SCM_RIGHTS
+        || unsafe { (*h).cmsg_len } != unsafe { libc::CMSG_LEN(4) } as usize
+        || !unsafe { libc::CMSG_NXTHDR(&m, h) }.is_null()
+    {
+        unsafe { rejected(nonce) }
+    }
+    let fd = unsafe { std::ptr::read_unaligned(libc::CMSG_DATA(h).cast::<i32>()) };
+    if fd < 0 || fd == CHILD_FD {
+        unsafe { rejected(nonce) }
+    }
+    if fd != 4 && unsafe { libc::syscall(libc::SYS_dup3, fd, 4, libc::O_CLOEXEC) } != 4 {
+        unsafe { failed(nonce, line!()) }
+    }
+    if fd != 4 {
+        unsafe {
+            libc::syscall(libc::SYS_close, fd);
+        }
+    }
+    if unsafe { libc::syscall(libc::SYS_close_range, 5_u32, u32::MAX, 0) } != 0 {
+        unsafe { failed(nonce, line!()) }
+    }
+    4
+}
+unsafe fn executable(fd: RawFd, nonce: [u8; 16]) -> libc::stat {
+    let st = unsafe { metadata(fd, nonce) };
+    // The initial-root owner and exact full-body hash are checked by the
+    // opaque test input before transmission. In the guest this host UID is
+    // deliberately unmapped; no fake idmap or ownership rewrite is applied.
+    if st.st_mode != libc::S_IFREG | 0o555
+        || st.st_nlink != 1
+        || !(64..=1_048_576).contains(&st.st_size)
+    {
+        unsafe { rejected(nonce) }
+    }
+    let mut fs: KernelStatfs = unsafe { std::mem::zeroed() };
+    if unsafe { libc::syscall(libc::SYS_fstatfs, fd, &mut fs) } != 0 {
+        unsafe { failed(nonce, line!()) }
+    }
+    if fs.f_flags as u64 & 8 != 0 {
+        unsafe { rejected(nonce) }
+    }
+    let mut h = [0_u8; 64];
+    if unsafe { libc::syscall(libc::SYS_pread64, fd, h.as_mut_ptr(), h.len(), 0) } != 64 {
+        unsafe { failed(nonce, line!()) }
+    }
+    if &h[..7] != b"\x7fELF\x02\x01\x01"
+        || u16::from_le_bytes([h[16], h[17]]) != 2
+        || u16::from_le_bytes([h[18], h[19]]) != 62
+    {
+        unsafe { rejected(nonce) }
+    }
+    let x = unsafe {
+        libc::syscall(
+            libc::SYS_fgetxattr,
+            fd,
+            c"security.capability".as_ptr(),
+            std::ptr::null::<u8>(),
+            0,
+        )
+    };
+    if x != -1 || ![libc::ENODATA, libc::EOPNOTSUPP].contains(&unsafe { *libc::__errno_location() })
+    {
+        unsafe { rejected(nonce) }
+    }
+    st
+}
+unsafe fn stdio(nonce: [u8; 16]) {
+    for fd in 0..3 {
+        unsafe {
+            libc::syscall(libc::SYS_close, fd);
+        }
+    }
+    let raw = unsafe {
+        libc::syscall(
+            libc::SYS_openat,
+            libc::AT_FDCWD,
+            c"/dev/null".as_ptr(),
+            libc::O_RDWR | libc::O_CLOEXEC | libc::O_NOFOLLOW,
+            0,
+        )
+    };
+    if raw != 0 {
+        unsafe { failed(nonce, line!()) }
+    }
+    let st = unsafe { metadata(0, nonce) };
+    if st.st_mode & libc::S_IFMT != libc::S_IFCHR || st.st_rdev != libc::makedev(1, 3) {
+        unsafe { rejected(nonce) }
+    }
+    for fd in 0..3 {
+        if fd != 0 && unsafe { libc::syscall(libc::SYS_dup3, 0, fd, 0) } != fd as libc::c_long {
+            unsafe { failed(nonce, line!()) }
+        }
+        if unsafe { libc::syscall(libc::SYS_fcntl, fd, libc::F_SETFD, 0) } != 0
+            || unsafe { libc::syscall(libc::SYS_fcntl, fd, libc::F_GETFD) } != 0
+        {
+            unsafe { failed(nonce, line!()) }
+        }
+    }
+}
+
+pub(super) unsafe fn run(nonce: [u8; 16], parent_pid: u32) -> ! {
+    unsafe {
+        let fd = received(nonce, parent_pid);
+        let initial = executable(fd, nonce);
+        stdio(nonce);
+        if libc::syscall(libc::SYS_fcntl, CHILD_FD, libc::F_GETFD)
+            != libc::FD_CLOEXEC as libc::c_long
+            || libc::syscall(libc::SYS_fcntl, fd, libc::F_GETFD) != libc::FD_CLOEXEC as libc::c_long
+        {
+            rejected(nonce)
+        }
+        // Only this fixed test image retains the inherited authenticated
+        // endpoint across exec. The Android runtime endpoint remains CLOEXEC.
+        if libc::syscall(libc::SYS_fcntl, CHILD_FD, libc::F_SETFD, 0) != 0 {
+            failed(nonce, line!())
+        }
+        let error =
+            super::final_exec::prepare(super::final_exec::FinalCapabilityProfile::PrivateZero);
+        if error != 0 {
+            *libc::__errno_location() = error;
+            failed(nonce, line!())
+        }
+        let error = crate::production_runtime_seccomp::install();
+        if error != 0 {
+            *libc::__errno_location() = error;
+            failed(nonce, line!())
+        }
+        if !same(&initial, &metadata(fd, nonce)) {
+            rejected(nonce)
+        }
+        let mut hex = [0_u8; 33];
+        let alphabet = b"0123456789abcdef";
+        for i in 0..16 {
+            hex[2 * i] = alphabet[(nonce[i] >> 4) as usize];
+            hex[2 * i + 1] = alphabet[(nonce[i] & 15) as usize];
+        }
+        let mut parent = [0_u8; 11];
+        let mut pos = 10;
+        let mut value = parent_pid;
+        if value <= 1 || value > i32::MAX as u32 {
+            rejected(nonce)
+        }
+        while value != 0 {
+            pos -= 1;
+            parent[pos] = b'0' + (value % 10) as u8;
+            value /= 10;
+        }
+        let argv = [
+            c"droidloom-private-proc-postexec-v1".as_ptr(),
+            hex.as_ptr().cast(),
+            parent.as_ptr().add(pos).cast(),
+            std::ptr::null(),
+        ];
+        let env = [std::ptr::null::<libc::c_char>()];
+        *libc::__errno_location() = super::final_exec::exec_held(fd, argv.as_ptr(), env.as_ptr());
+        failed(nonce, line!())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn production_postexec_failure_encoding_does_not_overlap_runtime_or_xattr_errno() {
+        assert_eq!(
+            decode_private_failure((0x5800_0000u32 | (120 << 12) | libc::EACCES as u32) as i32),
+            Some((8, 120, 13))
+        );
+        for v in [0, 1, 4095, -1, 0x45001001, 0x59001001, 0x58000001] {
+            assert_eq!(decode_private_failure(v), None);
+        }
+    }
+}
diff --git a/runtime/droidloom-supervisor/src/production_namespace_postexec_parent.rs b/runtime/droidloom-supervisor/src/production_namespace_postexec_parent.rs
new file mode 100644
index 0000000..1092cda
--- /dev/null
+++ b/runtime/droidloom-supervisor/src/production_namespace_postexec_parent.rs
@@ -0,0 +1,495 @@
+//! Test-only same-PIDFD post-exec observation. This is not Android execution
+//! admission, a namespace constructor, or a public command interface.
+use super::*;
+use sha2::{Digest, Sha256};
+use std::os::unix::fs::FileExt;
+
+include!("production_postexec_probe_identity.rs");
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct Identity {
+    dev: u64,
+    ino: u64,
+    mode: u32,
+    uid: u32,
+    gid: u32,
+    nlink: u64,
+    size: u64,
+    mtime: i64,
+    mtime_ns: i64,
+    ctime: i64,
+    ctime_ns: i64,
+}
+impl Identity {
+    fn of(file: &File) -> Result<Self> {
+        let m = file.metadata()?;
+        Ok(Self {
+            dev: m.dev(),
+            ino: m.ino(),
+            mode: m.mode(),
+            uid: m.uid(),
+            gid: m.gid(),
+            nlink: m.nlink(),
+            size: m.size(),
+            mtime: m.mtime(),
+            mtime_ns: m.mtime_nsec(),
+            ctime: m.ctime(),
+            ctime_ns: m.ctime_nsec(),
+        })
+    }
+}
+struct SealedProbe {
+    file: File,
+    path: std::path::PathBuf,
+    identity: Identity,
+}
+
+fn bounded_elf(bytes: &[u8]) -> Result<()> {
+    let reject = || NamespaceError::Rejected("fixed static post-exec ELF layout");
+    if bytes.len() < 64
+        || &bytes[..7] != b"\x7fELF\x02\x01\x01"
+        || bytes[7] != 0
+        || u16::from_le_bytes(bytes[16..18].try_into().unwrap()) != 2
+        || u16::from_le_bytes(bytes[18..20].try_into().unwrap()) != 62
+        || u16::from_le_bytes(bytes[52..54].try_into().unwrap()) != 64
+    {
+        return Err(reject());
+    }
+    let u64at = |at| u64::from_le_bytes(bytes[at..at + 8].try_into().unwrap());
+    let entry = u64at(24);
+    let ph = u64at(32);
+    let count = u16::from_le_bytes(bytes[56..58].try_into().unwrap()) as u64;
+    if u16::from_le_bytes(bytes[54..56].try_into().unwrap()) != 56
+        || !(1..=32).contains(&count)
+        || ph < 64
+        || ph
+            .checked_add(count * 56)
+            .is_none_or(|end| end > bytes.len() as u64)
+    {
+        return Err(reject());
+    }
+    let mut executable_entry = false;
+    let mut safe_stack = false;
+    for i in 0..count {
+        let p = (ph + i * 56) as usize;
+        let kind = u32::from_le_bytes(bytes[p..p + 4].try_into().unwrap());
+        let flags = u32::from_le_bytes(bytes[p + 4..p + 8].try_into().unwrap());
+        if kind == 2 || kind == 3 {
+            return Err(reject());
+        }
+        if kind == 1 {
+            let offset = u64at(p + 8);
+            let address = u64at(p + 16);
+            let file = u64at(p + 32);
+            let memory = u64at(p + 40);
+            if flags & 3 == 3
+                || flags & !7 != 0
+                || memory < file
+                || offset
+                    .checked_add(file)
+                    .is_none_or(|x| x > bytes.len() as u64)
+                || address.checked_add(memory).is_none()
+            {
+                return Err(reject());
+            }
+            if flags & 1 != 0 && entry >= address && entry < address + memory {
+                executable_entry = true;
+            }
+        }
+        if kind == 0x6474_e551 {
+            if flags & 1 != 0 || safe_stack {
+                return Err(reject());
+            }
+            safe_stack = true;
+        }
+    }
+    if !executable_entry || !safe_stack {
+        return Err(reject());
+    }
+    Ok(())
+}
+fn public_sealed(file: &File) -> Result<Identity> {
+    let node = Identity::of(file)?;
+    if node.mode != libc::S_IFREG | 0o555
+        || node.uid != 0
+        || node.gid != 0
+        || node.nlink != 1
+        || node.size != PRIVATE_PROBE_BYTES
+        || !(64..=1_048_576).contains(&node.size)
+    {
+        return Err(NamespaceError::Rejected(
+            "root-sealed static post-exec input",
+        ));
+    }
+    let cap = unsafe {
+        libc::fgetxattr(
+            file.as_raw_fd(),
+            c"security.capability".as_ptr(),
+            std::ptr::null_mut(),
+            0,
+        )
+    };
+    if cap != -1
+        || !matches!(
+            io::Error::last_os_error().raw_os_error(),
+            Some(libc::ENODATA) | Some(libc::EOPNOTSUPP)
+        )
+    {
+        return Err(NamespaceError::Rejected(
+            "post-exec input has file capability or is unobservable",
+        ));
+    }
+    let mut bytes = vec![0; node.size as usize];
+    file.read_exact_at(&mut bytes, 0)?;
+    if format!("{:x}", Sha256::digest(&bytes)) != PRIVATE_PROBE_SHA256
+        || Identity::of(file)? != node
+    {
+        return Err(NamespaceError::Rejected(
+            "post-exec input changed or hash differs",
+        ));
+    }
+    bounded_elf(&bytes)?;
+    Ok(node)
+}
+impl SealedProbe {
+    fn load() -> Result<Self> {
+        let me = std::env::current_exe()?;
+        let parent = me.parent().ok_or(NamespaceError::Rejected(
+            "sealed test executable parent absent",
+        ))?;
+        // Exact sibling of the actually executing root-sealed test binary.
+        // No CLI, JSON or environment variable supplies this filename/path.
+        let path = parent.join("private-proc-postexec-probe");
+        let file = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(&path)?;
+        let identity = public_sealed(&file)?;
+        let value = Self {
+            file,
+            path,
+            identity,
+        };
+        value.revalidate()?;
+        Ok(value)
+    }
+    fn revalidate(&self) -> Result<()> {
+        let named = OpenOptions::new()
+            .read(true)
+            .custom_flags(libc::O_CLOEXEC | libc::O_NOFOLLOW | libc::O_NONBLOCK)
+            .open(&self.path)?;
+        if Identity::of(&named)? != self.identity || public_sealed(&self.file)? != self.identity {
+            return Err(NamespaceError::Rejected(
+                "sealed probe path/held descriptor differ",
+            ));
+        }
+        Ok(())
+    }
+}
+
+fn record(
+    control: RawFd,
+    nonce: [u8; 16],
+    pid: u32,
+    uid: u32,
+    gid: u32,
+    wanted: Phase,
+    live: impl FnOnce() -> Result<()>,
+) -> Result<i32> {
+    let (packet, creds) = receive_packet(control)?;
+    if !packet.matches(nonce, 1) || creds.pid != pid as i32 || creds.uid != uid || creds.gid != gid
+    {
+        return Err(NamespaceError::Rejected(
+            "post-exec original nonce/SCM peer differs",
+        ));
+    }
+    if packet.phase == Phase::Failed as u32 {
+        let (stage, line, errno) = child::postexec_private_failure(packet.errno)
+            .ok_or(NamespaceError::Rejected("post-exec failure encoding"))?;
+        return Err(io::Error::other(format!(
+            "authenticated fixed post-exec Failed: stage={stage} source-line={line} errno={errno}"
+        ))
+        .into());
+    }
+    if packet.phase != wanted as u32
+        || (wanted as u32 == Phase::PostExecReady as u32 && packet.errno != 0)
+        || (wanted as u32 == Phase::PostExecChecked as u32 && !(0..4096).contains(&packet.errno))
+    {
+        return Err(NamespaceError::Rejected(
+            "fixed post-exec phase or xattr errno differs",
+        ));
+    }
+    live()?;
+    Ok(packet.errno)
+}
+
+fn score_node(
+    child: &TreeChild,
+    expected_uid: u32,
+    expected_gid: u32,
+) -> Result<serde_json::Value> {
+    child.verify()?;
+    let root = held_child_root(child)?;
+    let file = writable_proc::target_from_root(&root, "/proc/1/oom_score_adj")?;
+    let node = Identity::of(&file)?;
+    let proc = writable_proc::target_from_root(&root, "/proc")?;
+    if node.mode != libc::S_IFREG | 0o644
+        || node.uid != expected_uid
+        || node.gid != expected_gid
+        || node.dev != proc.metadata()?.dev()
+        || filesystem_kind(&file)? != 0x9fa0
+        || writable_proc::held_mount_id(&file)? != writable_proc::held_mount_id(&proc)?
+    {
+        return Err(NamespaceError::Rejected(
+            "actual owned proc inode/mm ownership differs",
+        ));
+    }
+    let value = serde_json::json!({"identity":format!("{node:?}"),"mount_id":writable_proc::held_mount_id(&file)?,"host_uid":node.uid,"host_gid":node.gid,"body_read":false});
+    child.verify()?;
+    Ok(value)
+}
+fn actual_postexec(child: &TreeChild, probe: &SealedProbe) -> Result<serde_json::Value> {
+    child.verify()?;
+    probe.revalidate()?;
+    // This is the one deliberate proc magic-link follow: open the actual
+    // executable target from the already held exact proc-directory FD.
+    // O_NOFOLLOW would return the symlink inode and cannot establish exec.
+    let raw = unsafe {
+        libc::openat(
+            child.proc_dir.as_raw_fd(),
+            c"exe".as_ptr(),
+            libc::O_PATH | libc::O_CLOEXEC,
+        )
+    };
+    if raw < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    let executable = unsafe { File::from_raw_fd(raw) };
+    if Identity::of(&executable)? != probe.identity {
+        return Err(NamespaceError::Rejected(
+            "same PIDFD executable is not sealed probe inode",
+        ));
+    }
+    let raw = read_proc(&child.proc_dir, "status")?;
+    let status = writable_proc::private_status_fields(&raw, child.uids.start, child.gids.start)?;
+    if status["Seccomp"] != "2"
+        || ["CapInh", "CapPrm", "CapEff", "CapBnd", "CapAmb"]
+            .iter()
+            .any(|name| status[*name] != "0000000000000000")
+    {
+        return Err(NamespaceError::Rejected(
+            "post-exec actual capabilities/filter differ",
+        ));
+    }
+    let score = score_node(child, child.uids.start, child.gids.start)?;
+    child.verify()?;
+    Ok(
+        serde_json::json!({"actual_host_pid":child.identity.pid,"actual_start_ticks":child.identity.start_ticks,"exe_identity":format!("{:?}",Identity::of(&executable)?),"score":score,"status":status,"same_pidfd":true,"same_namespaces":true,"executed_android":false}),
+    )
+}
+
+pub(super) fn run_private(tree: &mut IsolatedNamespaces) -> Result<i32> {
+    let probe = SealedProbe::load()?;
+    let child = tree
+        .init
+        .as_ref()
+        .ok_or(NamespaceError::Rejected("owned PID1 absent"))?;
+    tree.writable_proc
+        .as_mut()
+        .ok_or(NamespaceError::Rejected("private writable proc absent"))?
+        .verify(child)?;
+    let before = score_node(child, 0, 0)?;
+    writable_proc::trace_private_proc_authority(child)?;
+    probe.revalidate()?;
+    send_one_fd(
+        child.control.as_raw_fd(),
+        &Packet::new(
+            child.nonce,
+            Phase::PreparePostExecProbe,
+            0,
+            child.parent_pid,
+        ),
+        probe.file.as_fd(),
+    )?;
+    wait_readable(&child.control, &child.pidfd)?;
+    record(
+        child.control.as_raw_fd(),
+        child.nonce,
+        child.identity.pid,
+        child.uids.start,
+        child.gids.start,
+        Phase::PostExecReady,
+        || child.verify(),
+    )?;
+    let after = actual_postexec(child, &probe)?;
+    eprintln!(
+        "private fixed post-exec ready: {}",
+        serde_json::json!({"preexec_score":before,"postexec":after,"dumpable_zero_report_from_sealed_image":true,"private_zero_profile_only":true})
+    );
+    send_packet(
+        child.control.as_raw_fd(),
+        &Packet::new(child.nonce, Phase::CheckPostExecProbe, 0, child.parent_pid),
+    )?;
+    wait_readable(&child.control, &child.pidfd)?;
+    let observed = record(
+        child.control.as_raw_fd(),
+        child.nonce,
+        child.identity.pid,
+        child.uids.start,
+        child.gids.start,
+        Phase::PostExecChecked,
+        || child.verify(),
+    )?;
+    let checked = actual_postexec(child, &probe)?;
+    tree.writable_proc.as_mut().unwrap().verify(child)?;
+    let root = held_child_root(child)?;
+    let dev = root_subdirectory(&root, c"dev")?;
+    let raw = unsafe {
+        libc::openat(
+            dev.as_raw_fd(),
+            c"selinux-xattr-private-observation".as_ptr(),
+            libc::O_PATH | libc::O_NOFOLLOW | libc::O_CLOEXEC,
+        )
+    };
+    if raw >= 0 {
+        drop(unsafe { File::from_raw_fd(raw) });
+        return Err(NamespaceError::Rejected(
+            "private xattr observation file retained",
+        ));
+    }
+    if io::Error::last_os_error().raw_os_error() != Some(libc::ENOENT) {
+        return Err(io::Error::last_os_error().into());
+    }
+    if filesystem_kind(&dev)? != 0x0102_1994 {
+        return Err(NamespaceError::Rejected(
+            "xattr observation filesystem differs",
+        ));
+    }
+    eprintln!(
+        "private fixed post-exec checked: {}",
+        serde_json::json!({"actual":checked,"own_oom_original_value_restored":true,"global_write_opens_denied_without_writes":true,"private_filesystem":"tmpfs","security_selinux_set_get_errno":observed,"mac_qualified":false,"production_admission":false,"Android":0})
+    );
+    probe.revalidate()?;
+    Ok(observed)
+}
