+fn send_persistent_base_fds(socket: RawFd, packet: &Packet, fds: [BorrowedFd<'_>; 4]) -> Result<()> {
+    let mut iov = libc::iovec {
+        iov_base: (packet as *const Packet).cast_mut().cast(),
+        iov_len: std::mem::size_of::<Packet>(),
+    };
+    let mut control = [0_usize; 8];
+    let mut msg: libc::msghdr = unsafe { std::mem::zeroed() };
+    msg.msg_iov = &mut iov;
+    msg.msg_iovlen = 1;
+    msg.msg_control = control.as_mut_ptr().cast();
+    msg.msg_controllen = unsafe { libc::CMSG_SPACE(16) } as usize;
+    let h = unsafe { libc::CMSG_FIRSTHDR(&msg) };
+    unsafe {
+        (*h).cmsg_level = libc::SOL_SOCKET;
+        (*h).cmsg_type = libc::SCM_RIGHTS;
+        (*h).cmsg_len = libc::CMSG_LEN(16) as usize;
+        let data = libc::CMSG_DATA(h).cast::<i32>();
+        for (index, descriptor) in fds.iter().enumerate() {
+            std::ptr::write_unaligned(data.add(index), descriptor.as_raw_fd());
+        }
+    }
+    let n = unsafe { libc::sendmsg(socket, &msg, libc::MSG_NOSIGNAL | libc::MSG_DONTWAIT) };
+    if n < 0 {
+        return Err(io::Error::last_os_error().into());
+    }
+    if n as usize != std::mem::size_of::<Packet>() {
+        return Err(NamespaceError::Rejected(
+            "incomplete fixed persistent base descriptor transfer",
+        ));
+    }
+    Ok(())
+}
