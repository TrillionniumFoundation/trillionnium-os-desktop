+    /// Transfer the two immutable bases and the two original mutable roots
+    /// through a distinct authenticated four-FD phase for this same live owner.
+    pub(crate) fn attach_persistent_base(
+        mut self,
+        bases: PreparedMounts,
+        mut data: PreparedPersistentData,
+        selection: &ProductionSelection,
+        prepared: &PreparedExecution,
+    ) -> Result<Self> {
+        self.verify_live_admission()?;
+        if self.bases.is_some() || self.persistent_data.is_some()
+            || self.retirement.prepared.bases.is_some()
+            || self.retirement.prepared.persistent_data.is_some() || self.base_root_ready
+        {
+            return Err(NamespaceError::Rejected("base or persistent descriptors already transferred"));
+        }
+        let mut bases = BaseMounts::Admitted(bases);
+        let transfer: Result<([u64; 2], [PersistentRootObservation; 2])> = (|| {
+            let witness = self.witness()?;
+            let base_fds = bases.descriptors(&witness)?;
+            let devices = [descriptor_device(base_fds[0])?, descriptor_device(base_fds[1])?];
+            let (data_fds, observed) = data.descriptors_for_transfer(&witness, selection, prepared)
+                .map_err(|error| NamespaceError::MountResource(error.to_string()))?;
+            if observed[0].device == observed[1].device
+                || observed.iter().any(|row| devices.contains(&row.device))
+            {
+                return Err(NamespaceError::Rejected("persistent and immutable mount roles overlap"));
+            }
+            let child = self.init.as_ref().ok_or(NamespaceError::Rejected("PID 1 absent"))?;
+            let packet = Packet::new(child.nonce, Phase::MountPersistentBase, 0, child.parent_pid);
+            send_persistent_base_fds(child.control.as_raw_fd(), &packet,
+                [base_fds[0], base_fds[1], data_fds[0], data_fds[1]])?;
+            Ok((devices, observed))
+        })();
+        // Both owners stay with the original tree even if an attempted send
+        // failed or its acknowledgement is unknown. No pre-export shortcut.
+        self.retirement.prepared.bases = Some(ResourcePreparation::Admitted);
+        self.retirement.prepared.persistent_data = Some(ResourcePreparation::Admitted);
+        self.bases = Some(bases);
+        self.persistent_data = Some(data);
+        let (devices, observed) = transfer?;
+        let child = self.init.as_mut().ok_or(NamespaceError::Rejected("PID 1 absent"))?;
+        child.persistent_roots = Some(observed);
+        child.receive_phase(Phase::PersistentRootReady)?;
+        child.verify_empty_root_mounts(devices, None, None)?;
+        self.base_devices = Some(devices);
+        self.base_root_ready = true;
+        self.verify_live_admission()?;
+        Ok(self)
+    }
