+    // Exercise the real private wire protocol. These fixtures retain timing
+    // identities only; no GPU buffer or synchronization primitive is fabricated.
+    fn presentation_timing_pair() -> (ProtocolSocket, DenialEndpoint) {
+        let (android, mut denial) = pair();
+        android.send_android(&AndroidMessage::ClientHello {
+            min_major: 1, max_major: 1, capabilities: capability::REQUIRED_V1,
+        }, &[]).unwrap();
+        denial.receive_action().unwrap();
+        android.receive_denial().unwrap();
+        for value in [1, 2] {
+            android.send_android(&AndroidMessage::CreateTask {
+                object: TaskObjectId(value), display: AndroidDisplayId(value),
+                package: format!("org.example.presentation{value}"),
+            }, &[]).unwrap();
+            denial.receive_action().unwrap();
+        }
+        android.socket().set_nonblocking(true).unwrap();
+        (android, denial)
+    }
+
+    fn offer_presentation_timing(denial: &mut DenialEndpoint, object: u64, frame: u64, timestamp: u64) {
+        let object = TaskObjectId(object);
+        let frame = droidloom_denial_protocol::FrameId(frame);
+        assert!(denial.tasks.get_mut(&object).unwrap().presentation_frames.insert(frame));
+        denial.send_presented(object, frame, timestamp, 16_666_666, frame.0,
+            droidloom_denial_protocol::presentation_flag::DISPLAYED
+                | droidloom_denial_protocol::presentation_flag::COMPOSITED).unwrap();
+    }
+
+    fn read_presentation_timing(android: &ProtocolSocket) -> (u64, u64) {
+        match android.receive_denial().unwrap().message {
+            DenialMessage::Presented { object, timestamp_nanos, .. } => (object.0, timestamp_nanos),
+            other => panic!("unexpected feedback: {other:?}"),
+        }
+    }
+
+    fn no_presentation_timing(android: &ProtocolSocket) {
+        assert!(matches!(android.receive_denial(),
+            Err(droidloom_denial_ipc::IpcError::Io(ref error))
+                if error.kind() == io::ErrorKind::WouldBlock),
+            "invalid presentation timing crossed the Android wire");
+    }
+
+    #[test]
+    fn presentation_zero_timing_never_reaches_android_and_valid_feedback_recovers() {
+        let (android, mut denial) = presentation_timing_pair();
+        let last_valid = 796_749_643_838_000;
+        offer_presentation_timing(&mut denial, 1, 1, last_valid);
+        assert_eq!(read_presentation_timing(&android), (1, last_valid));
+        offer_presentation_timing(&mut denial, 1, 2, 0);
+        no_presentation_timing(&android);
+        assert!(denial.tasks[&TaskObjectId(1)].presentation_frames.is_empty());
+        assert!(denial.tasks[&TaskObjectId(1)].pending.is_empty());
+        assert!(denial.tasks[&TaskObjectId(1)].timelines.is_none());
+        offer_presentation_timing(&mut denial, 1, 3, last_valid + 16_666_666);
+        assert_eq!(read_presentation_timing(&android), (1, last_valid + 16_666_666));
+    }
+
+
+    #[test]
+    fn presentation_initial_zero_is_unavailable_not_a_clock_sample() {
+        let (android, mut denial) = presentation_timing_pair();
+        offer_presentation_timing(&mut denial, 1, 1, 0);
+        no_presentation_timing(&android);
+        assert_eq!(denial.tasks[&TaskObjectId(1)].last_presentation_nanos, None);
+        offer_presentation_timing(&mut denial, 1, 2, 1);
+        assert_eq!(read_presentation_timing(&android), (1, 1));
+    }
+
+    #[test]
+    fn presentation_regression_is_suppressed_and_equal_samples_remain_legal() {
+        let (android, mut denial) = presentation_timing_pair();
+        offer_presentation_timing(&mut denial, 1, 3, 300);
+        assert_eq!(read_presentation_timing(&android), (1, 300));
+        offer_presentation_timing(&mut denial, 1, 2, 200);
+        no_presentation_timing(&android);
+        assert_eq!(denial.tasks[&TaskObjectId(1)].last_presentation_nanos, Some(300));
+        offer_presentation_timing(&mut denial, 1, 4, 300);
+        assert_eq!(read_presentation_timing(&android), (1, 300));
+        offer_presentation_timing(&mut denial, 1, 5, 400);
+        assert_eq!(read_presentation_timing(&android), (1, 400));
+    }
+
+    #[test]
+    fn presentation_clocks_are_independent_per_task() {
+        let (android, mut denial) = presentation_timing_pair();
+        offer_presentation_timing(&mut denial, 1, 1, 300);
+        offer_presentation_timing(&mut denial, 2, 1, 100);
+        assert_eq!(read_presentation_timing(&android), (1, 300));
+        assert_eq!(read_presentation_timing(&android), (2, 100));
+        offer_presentation_timing(&mut denial, 1, 2, 200);
+        no_presentation_timing(&android);
+        offer_presentation_timing(&mut denial, 2, 2, 200);
+        assert_eq!(read_presentation_timing(&android), (2, 200));
+    }
+
+    #[test]
+    fn presentation_destroy_recreate_does_not_inherit_previous_clock() {
+        let (android, mut denial) = presentation_timing_pair();
+        offer_presentation_timing(&mut denial, 1, 1, 300);
+        assert_eq!(read_presentation_timing(&android), (1, 300));
+        android.send_android(&AndroidMessage::DestroyTask { object: TaskObjectId(1) }, &[]).unwrap();
+        assert!(matches!(denial.receive_action().unwrap(), EndpointAction::DestroyTask { .. }));
+        android.send_android(&AndroidMessage::CreateTask {
+            object: TaskObjectId(1), display: AndroidDisplayId(1),
+            package: "org.example.recreated".into(),
+        }, &[]).unwrap();
+        denial.receive_action().unwrap();
+        offer_presentation_timing(&mut denial, 1, 1, 100);
+        assert_eq!(read_presentation_timing(&android), (1, 100));
+    }
+
+    #[test]
+    fn presentation_invalid_identity_is_rejected_even_when_timestamp_is_zero() {
+        use droidloom_denial_protocol::FrameId;
+        let (android, mut denial) = presentation_timing_pair();
+        assert!(matches!(denial.send_presented(TaskObjectId(9), FrameId(1), 0, 1, 1, 0),
+            Err(EndpointError::UnknownObject(TaskObjectId(9)))));
+        assert!(matches!(denial.send_presented(TaskObjectId(1), FrameId(99), 0, 1, 1, 0),
+            Err(EndpointError::UnknownFrame { .. })));
+        no_presentation_timing(&android);
+        offer_presentation_timing(&mut denial, 1, 1, 100);
+        assert_eq!(read_presentation_timing(&android), (1, 100));
+    }
+
+    #[test]
+    fn presentation_failed_send_does_not_advance_clock() {
+        use droidloom_denial_protocol::{FrameId, presentation_flag};
+        let (android, mut denial) = presentation_timing_pair();
+        drop(android);
+        denial.tasks.get_mut(&TaskObjectId(1)).unwrap().presentation_frames.insert(FrameId(1));
+        assert!(denial.send_presented(TaskObjectId(1), FrameId(1), 100, 1, 1,
+            presentation_flag::DISPLAYED | presentation_flag::COMPOSITED).is_err());
+        assert_eq!(denial.tasks[&TaskObjectId(1)].last_presentation_nanos, None);
+    }
+
+    #[test]
+    fn presentation_retired_task_consumes_only_optional_timing_metadata() {
+        use droidloom_denial_protocol::FrameId;
+        let (android, mut denial) = presentation_timing_pair();
+        let task = denial.tasks.get_mut(&TaskObjectId(1)).unwrap();
+        task.retiring = true;
+        task.presentation_frames.insert(FrameId(1));
+        assert_eq!(denial.send_presented(TaskObjectId(1), FrameId(1), 100, 1, 1, 0).unwrap(),
+            super::PresentationFeedbackOutcome::Retired);
+        no_presentation_timing(&android);
+        let task = &denial.tasks[&TaskObjectId(1)];
+        assert!(task.presentation_frames.is_empty());
+        assert_eq!(task.last_presentation_nanos, None);
+        assert!(task.pending.is_empty());
+        assert!(task.timelines.is_none());
+    }
+
 }
