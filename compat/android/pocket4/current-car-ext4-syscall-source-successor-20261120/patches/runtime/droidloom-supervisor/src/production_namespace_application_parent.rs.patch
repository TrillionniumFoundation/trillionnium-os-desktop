+#[cfg(test)]
+mod pre_ready_identity_tests {
+    use super::*;
+
+    #[test]
+    fn original_init_zygote_system_server_lineage_rejects_reparenting_and_reuse() {
+        let init = ProcessIdentity {
+            pid: 200,
+            parent: 1,
+            start_ticks: 10,
+        };
+        let zygote = ProcessIdentity {
+            pid: 201,
+            parent: 200,
+            start_ticks: 20,
+        };
+        let system_server = ProcessIdentity {
+            pid: 202,
+            parent: 201,
+            start_ticks: 30,
+        };
+        assert!(valid_original_chain(init, zygote, system_server));
+        assert!(!valid_original_chain(
+            init,
+            ProcessIdentity {
+                parent: 1,
+                ..zygote
+            },
+            system_server,
+        ));
+        assert!(!valid_original_chain(
+            init,
+            zygote,
+            ProcessIdentity {
+                parent: 200,
+                ..system_server
+            },
+        ));
+        assert!(!valid_original_chain(
+            init,
+            ProcessIdentity {
+                start_ticks: 31,
+                ..zygote
+            },
+            system_server,
+        ));
+        assert!(!valid_original_chain(
+            init,
+            ProcessIdentity {
+                start_ticks: 9,
+                ..zygote
+            },
+            system_server,
+        ));
+        assert!(!valid_original_chain(
+            init,
+            zygote,
+            ProcessIdentity {
+                pid: 201,
+                ..system_server
+            },
+        ));
+        assert!(!valid_original_chain(
+            init,
+            zygote,
+            ProcessIdentity {
+                start_ticks: 20,
+                ..system_server
+            },
+        ));
+    }
