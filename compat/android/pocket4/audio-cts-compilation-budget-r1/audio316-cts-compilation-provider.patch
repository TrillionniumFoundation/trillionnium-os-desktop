index 0000000000000000000000000000000000000000..e5f6862942dd630d071faaa9408dfde86dbeb6a3
--- /dev/null
+++ b/tools/droidloom-update/tests/fixtures/audio-resources/bootstrap-command.go
@@ -0,0 +1,256 @@
